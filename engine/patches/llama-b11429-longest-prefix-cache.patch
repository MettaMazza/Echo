+def test_completion_longer_shared_prefix():
+    global server
+    server.n_slots = 2
+    server.n_ctx = 32768
+    server.cache_ram = 512
+    server.start()
+
+    short = "Cache selection preserves the original matching prefix. " * 60
+    long = short + "The shared cache holds a longer prefix than this idle slot. " * 500
+
+    def complete(slot, prompt):
+        res = server.make_request("POST", "/completion", data={
+            "prompt": prompt, "id_slot": slot, "n_predict": 1, "cache_prompt": True,
+        })
+        assert res.status_code == 200
+        return res.body["timings"]
+
+    first = complete(0, short)
+    complete(1, long)
+    reused = complete(0, long + " Different final instruction.")
+    assert reused["cache_n"] > first["cache_n"] + first["prompt_n"] + 1000
