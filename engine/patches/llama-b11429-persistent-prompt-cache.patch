+// Disk IO never blocks the inference loop. A completion notification wakes
+// deferred requests after the immutable snapshot is ready for GPU restoration.
+bool server_prompt_cache::prepare_disk(const server_tokens & tokens, size_t base_prefix) {
+    if (!disk) { return true; }
+    if (disk_read.valid() && disk_read.wait_for(std::chrono::seconds(0)) == std::future_status::ready) {
+        auto restored = disk_read.get();
+        if (disk_reader.joinable()) { disk_reader.join(); }
+        if (restored) { states.push_back(std::move(restored)); update(); }
+    }
+    for (const auto & state : states) { base_prefix = std::max(base_prefix, state->prompt.tokens.get_common_prefix(tokens)); }
+    if (!disk->has_better(tokens, base_prefix, limit_size)) { return true; }
+    if (disk_read.valid()) { return false; }
+    std::promise<std::shared_ptr<server_prompt_cache_state>> promise;
+    disk_read = promise.get_future();
+    auto store = disk;
+    auto notify = disk_ready;
+    const size_t maximum = limit_size;
+    disk_reader = std::thread([store, notify, maximum, base_prefix, wanted = tokens.clone(), p = std::move(promise)]() mutable {
+        std::shared_ptr<server_prompt_cache_state> result;
+        try { result = store->load_best(wanted, base_prefix, {}, maximum); }
+        catch (const std::exception & e) { fprintf(stderr, "persistent cache read skipped: %s\n", e.what()); }
+        p.set_value(std::move(result));
+        if (notify) { notify(); }
+    });
+    return false;
+}
