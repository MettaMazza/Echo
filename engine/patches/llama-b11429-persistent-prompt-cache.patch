+#pragma once
+// Disposable, bounded inference cache. Never a conversation archive.
+// The writer owns immutable shared snapshots, not a model context. No model
+// calls or filesystem writes run on the inference thread.
+#include <algorithm>
+#define XXH_INLINE_ALL
+#include "vendor/hash/xxhash/xxhash.h"
+#include <condition_variable>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <thread>
+#include <iomanip>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+
+class server_prompt_disk {
+    struct entry {
+        std::string name;
+        server_tokens tokens;
+        uint64_t bytes;
+    };
+    std::filesystem::path root;
+    std::string identity;
+    std::vector<entry> entries;
+    std::mutex mutex;
+    std::condition_variable wake;
+    std::shared_ptr<server_prompt_cache_state> pending;
+    std::thread worker;
+    bool stopping = false;
+    int lock_fd = -1;
+    static constexpr uint64_t gib = 1024ULL*1024*1024;
+    uint64_t budget;
+    uint64_t reserve;
+    static constexpr size_t max_entries = 16;
+    static constexpr uint64_t max_tokens_bytes = 64ULL*1024*1024;
+    static constexpr size_t max_checkpoints = 4096;
+
+    static uint64_t checksum(const void * ptr, size_t n, uint64_t h = 14695981039346656037ULL) {
+        return XXH3_64bits_withSeed(ptr, n, h);
+    }
+    struct stream {
+        int fd;
+        uint64_t remaining;
+        uint64_t hash = 14695981039346656037ULL;
+        bool writing;
+        uint64_t free_reserve;
+        stream(const std::filesystem::path & path, bool write_mode, uint64_t max_bytes, uint64_t reserved = 0) : remaining(max_bytes), writing(write_mode), free_reserve(reserved) {
+            fd = ::open(path.c_str(), (writing ? O_WRONLY|O_CREAT|O_EXCL : O_RDONLY) | O_NOFOLLOW | O_CLOEXEC, 0600);
+            if (fd < 0) { throw std::runtime_error("cache file open failed"); }
+            struct stat s{};
+            if (fstat(fd, &s) || !S_ISREG(s.st_mode) || s.st_uid != geteuid() || (s.st_mode & 0077) || s.st_nlink != 1) {
+                close(fd); throw std::runtime_error("unsafe cache file");
+            }
+            if (!writing) { remaining = std::min<uint64_t>(remaining, s.st_size); }
+        }
+        ~stream() { close(fd); }
+        void bytes(void * data, size_t n, bool hashed = true) {
+            if (n > remaining) { throw std::runtime_error("cache length exceeded"); }
+            size_t done = 0;
+            while (done < n) {
+                const size_t chunk = std::min<size_t>(n-done, 8*1024*1024);
+                if (writing && free_reserve) {
+                    struct statvfs space{};
+                    if (fstatvfs(fd, &space) || (uint64_t)space.f_bavail*space.f_frsize < free_reserve+chunk) { throw std::runtime_error("cache free-space reserve reached"); }
+                }
+                ssize_t count = writing ? ::write(fd, static_cast<char *>(data)+done, chunk) : ::read(fd, static_cast<char *>(data)+done, chunk);
+                if (count < 0 && errno == EINTR) { continue; }
+                if (count <= 0) { throw std::runtime_error("incomplete cache IO"); }
+                done += count;
+            }
+            if (hashed) { hash = checksum(data, n, hash); }
+            remaining -= n;
+        }
+        template<class T> void number(T & value) { bytes(&value, sizeof(value)); }
+        template<class T> void vector(std::vector<T> & value, uint64_t maximum) {
+            uint64_t n = value.size(); number(n);
+            if (n > maximum/sizeof(T) || n > remaining/sizeof(T)) { throw std::runtime_error("invalid cache vector"); }
+            if (!writing) { value.resize(n); }
+            bytes(value.data(), value.size()*sizeof(T));
+        }
+        void finish() {
+            uint64_t expected = hash;
+            bytes(&expected, sizeof(expected), false);
+            if (expected != hash) { throw std::runtime_error("cache checksum mismatch"); }
+            if (writing && fsync(fd)) { throw std::runtime_error("cache flush failed"); }
+            if (!writing && remaining != 0) { throw std::runtime_error("cache trailing bytes"); }
+        }
+    };
+    void header(stream & io) {
+        std::string magic = "ECHO-KV-0001:" + identity;
+        std::string actual = magic;
+        io.bytes(&actual[0], actual.size());
+        if (actual != magic) { throw std::runtime_error("incompatible cache identity"); }
+    }
+    void token_data(stream & io, server_tokens & tokens) {
+        std::vector<llama_token> packed;
+        if (io.writing) {
+            auto raw = tokens.serialize();
+            if (raw.size() % sizeof(llama_token)) { throw std::runtime_error("invalid serialized tokens"); }
+            packed.resize(raw.size()/sizeof(llama_token));
+            memcpy(packed.data(), raw.data(), raw.size());
+        }
+        io.vector(packed, max_tokens_bytes);
+        if (!io.writing) { tokens = server_tokens::deserialize(packed, true); }
+    }
+    uint64_t estimated_size(const server_prompt_cache_state & state) const {
+        uint64_t n = state.data.size() + max_tokens_bytes;
+        size_t i = 0, stride = 1;
+        for (const auto & c : state.prompt.checkpoints) {
+            if (++i % stride == 0 || i == state.prompt.checkpoints.size()) { n += c.size()+128; }
+        }
+        return n + 4096;
+    }
+    void state_data(stream & io, server_prompt_cache_state & state) {
+        token_data(io, state.prompt.tokens);
+        io.vector(state.data.main, budget);
+        io.vector(state.data.drft, budget);
+        uint64_t count = 0;
+        size_t i = 0, stride = 1;
+        if (io.writing) {
+            for (const auto & c : state.prompt.checkpoints) { (void)c; if (++i % stride == 0 || i == state.prompt.checkpoints.size()) { ++count; } }
+        }
+        io.number(count);
+        if (count > max_checkpoints+1) { throw std::runtime_error("invalid checkpoint count"); }
+        auto checkpoint = [&](common_prompt_checkpoint & c) {
+            io.number(c.n_tokens); io.number(c.pos_min); io.number(c.pos_max);
+            io.vector(c.data_tgt, budget); io.vector(c.data_dft, budget); io.vector(c.data_spec, budget);
+            if (c.n_tokens < 0 || c.n_tokens > state.prompt.n_tokens() || c.pos_min > c.pos_max) { throw std::runtime_error("invalid checkpoint boundary"); }
+        };
+        if (io.writing) {
+            i = 0;
+            for (auto & c : state.prompt.checkpoints) { if (++i % stride == 0 || i == state.prompt.checkpoints.size()) { checkpoint(c); } }
+        } else {
+            for (uint64_t j = 0; j < count; ++j) { state.prompt.checkpoints.emplace_back(); checkpoint(state.prompt.checkpoints.back()); }
+        }
+    }
+    void remove_entry(size_t i) {
+        std::error_code ec;
+        std::filesystem::remove(root/(entries[i].name+".meta"), ec);
+        std::filesystem::remove(root/(entries[i].name+".kv"), ec);
+        if (ec) { throw std::runtime_error("cache eviction failed"); }
+        entries.erase(entries.begin()+i);
+    }
+    void save(const std::shared_ptr<server_prompt_cache_state> & state) {
+        const uint64_t required = estimated_size(*state);
+        if (required > budget || state->prompt.checkpoints.size() > max_checkpoints) { return; }
+        auto packed = state->prompt.tokens.serialize();
+        std::ostringstream key;
+        key << std::hex << std::setw(16) << std::setfill('0') << checksum(packed.data(), packed.size());
+        const std::string name = key.str();
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            // Replace prefixes rather than accumulating one snapshot per turn.
+            for (size_t i = 0; i < entries.size();) {
+                if (entries[i].name == name || entries[i].tokens.get_common_prefix(state->prompt.tokens) == entries[i].tokens.size()) { remove_entry(i); }
+                else { ++i; }
+            }
+            auto usage = [&]() { uint64_t n=0; for (const auto & e : entries) { n += e.bytes; } return n; };
+            while (!entries.empty() && (usage()+required > budget || entries.size() >= max_entries)) { remove_entry(0); }
+            if (std::filesystem::space(root).available < reserve+required) { return; }
+        }
+        const auto data_tmp = root/(name+".kv.tmp"), meta_tmp = root/(name+".meta.tmp");
+        try {
+            {
+                stream out(data_tmp, true, required, reserve); header(out); state_data(out, *state); out.finish();
+            }
+            const uint64_t size = std::filesystem::file_size(data_tmp);
+            {
+                stream out(meta_tmp, true, max_tokens_bytes+4096, reserve); header(out); token_data(out, state->prompt.tokens);
+                auto n = size; out.number(n); out.finish();
+            }
+            std::lock_guard<std::mutex> guard(mutex);
+            std::filesystem::rename(data_tmp, root/(name+".kv"));
+            std::filesystem::rename(meta_tmp, root/(name+".meta"));
+            entries.push_back({name, state->prompt.tokens.clone(), size+std::filesystem::file_size(root/(name+".meta"))});
+            fprintf(stderr, "persistent prompt cache saved: %d tokens, %llu bytes\n", state->prompt.n_tokens(), (unsigned long long)size);
+        } catch (...) {
+            std::error_code ec; std::filesystem::remove(data_tmp, ec); std::filesystem::remove(meta_tmp, ec); throw;
+        }
+    }
+    void run() {
+        for (;;) {
+            std::shared_ptr<server_prompt_cache_state> next;
+            {
+                std::unique_lock<std::mutex> guard(mutex);
+                wake.wait(guard, [&] { return stopping || pending; });
+                if (!pending) { return; }
+                next = std::move(pending);
+            }
+            try { save(next); } catch (const std::exception & e) { fprintf(stderr, "persistent prompt cache save skipped: %s\n", e.what()); }
+        }
+    }
+public:
+    explicit server_prompt_disk(const std::string & directory, const std::string & id, uint64_t max_bytes = 128*gib, uint64_t free_reserve = 64*gib)
+      : root(directory), identity(id), budget(max_bytes), reserve(free_reserve) {
+        if (id.size() != 64 || id.find_first_not_of("0123456789abcdef") != std::string::npos || !root.is_absolute()) { throw std::runtime_error("invalid cache configuration"); }
+        struct stat s{};
+        if (lstat(root.c_str(), &s) || !S_ISDIR(s.st_mode) || s.st_uid != geteuid() || (s.st_mode & 0077)) { throw std::runtime_error("cache directory must be owned, private and precreated"); }
+        lock_fd = ::open((root/"cache.lock").c_str(), O_CREAT|O_RDWR|O_NOFOLLOW|O_CLOEXEC, 0600);
+        if (lock_fd < 0 || flock(lock_fd, LOCK_EX|LOCK_NB)) { if (lock_fd >= 0) close(lock_fd); throw std::runtime_error("cache already owned"); }
+        try {
+            // Only this store's hex-named artifacts are managed. A failed save
+            // leaves no usable metadata and is safely discarded on restart.
+            for (const auto & item : std::filesystem::directory_iterator(root)) {
+                const auto name = item.path().filename().string();
+                if (name.size() < 19 || name.substr(0,16).find_first_not_of("0123456789abcdef") != std::string::npos) { continue; }
+                if (name.substr(16) == ".kv.tmp" || name.substr(16) == ".meta.tmp") { std::filesystem::remove(item.path()); continue; }
+                if (name.substr(16) != ".meta") { continue; }
+                try {
+                    server_tokens tokens; uint64_t bytes=0;
+                    stream in(item.path(), false, max_tokens_bytes+4096); header(in); token_data(in, tokens); in.number(bytes); in.finish();
+                    const auto data = root/(name.substr(0,16)+".kv");
+                    if (bytes > budget || bytes != std::filesystem::file_size(data) || std::filesystem::is_symlink(data)) { throw std::runtime_error("invalid data file"); }
+                    entries.push_back({name.substr(0,16), std::move(tokens), bytes+std::filesystem::file_size(item.path())});
+                } catch (...) { std::filesystem::remove(item.path()); std::filesystem::remove(root/(name.substr(0,16)+".kv")); }
+            }
+            for (const auto & item : std::filesystem::directory_iterator(root)) {
+                const auto name = item.path().filename().string();
+                if (name.size() == 19 && name.substr(16) == ".kv" && name.substr(0,16).find_first_not_of("0123456789abcdef") == std::string::npos && !std::filesystem::exists(root/(name.substr(0,16)+".meta"))) { std::filesystem::remove(item.path()); }
+            }
+            std::sort(entries.begin(), entries.end(), [&](const entry & a, const entry & b) { return std::filesystem::last_write_time(root/(a.name+".meta")) < std::filesystem::last_write_time(root/(b.name+".meta")); });
+            uint64_t used=0; for (const auto & e : entries) { used+=e.bytes; }
+            while (!entries.empty() && (used > budget || entries.size() > max_entries)) { used-=entries.front().bytes; remove_entry(0); }
+            worker = std::thread([this] { run(); });
+        } catch (...) { close(lock_fd); throw; }
+    }
+    ~server_prompt_disk() {
+        { std::lock_guard<std::mutex> guard(mutex); stopping = true; }
+        wake.notify_one(); if (worker.joinable()) { worker.join(); } close(lock_fd);
+    }
+    void submit(const std::shared_ptr<server_prompt_cache_state> & state) {
+        // One writer and one replaceable pending snapshot: bounded memory and IO.
+        std::lock_guard<std::mutex> guard(mutex); pending = state; wake.notify_one();
+    }
+    bool has_better(const server_tokens & tokens, size_t best, uint64_t memory_budget) {
+        std::lock_guard<std::mutex> guard(mutex);
+        for (const auto & e : entries) {
+            size_t prefix = e.tokens.get_common_prefix(tokens);
+            if (prefix > best && prefix >= e.tokens.size()/4 && (!memory_budget || e.bytes <= memory_budget)) { return true; }
+        }
+        return false;
+    }
+    std::shared_ptr<server_prompt_cache_state> load_best(const server_tokens & tokens, size_t best, const std::list<std::shared_ptr<server_prompt_cache_state>> & memory, uint64_t memory_budget) {
+        for (const auto & s : memory) { best = std::max(best, s->prompt.tokens.get_common_prefix(tokens)); }
+        std::unique_lock<std::mutex> guard(mutex);
+        size_t selected=entries.size();
+        for (size_t i=0; i<entries.size(); ++i) {
+            size_t prefix = entries[i].tokens.get_common_prefix(tokens);
+            if (prefix > best && prefix >= entries[i].tokens.size()/4 && (!memory_budget || entries[i].bytes <= memory_budget)) { best=prefix; selected=i; }
+        }
+        if (selected == entries.size()) { return nullptr; }
+        const std::string selected_name = entries[selected].name;
+        try {
+            auto result = std::make_shared<server_prompt_cache_state>();
+            stream in(root/(selected_name+".kv"), false, budget);
+            guard.unlock();
+            header(in); state_data(in, *result); in.finish();
+            guard.lock();
+            if (result->prompt.tokens.get_common_prefix(tokens) != best) { throw std::runtime_error("cache index mismatch"); }
+            for (size_t i=0; i<entries.size(); ++i) {
+                if (entries[i].name == selected_name) { auto e = std::move(entries[i]); entries.erase(entries.begin()+i); entries.push_back(std::move(e)); break; }
+            }
+            fprintf(stderr, "persistent prompt cache restored: %d tokens, %zu checkpoints\n", result->prompt.n_tokens(), result->prompt.checkpoints.size());
+            return result;
+        } catch (const std::exception & e) {
+            fprintf(stderr, "persistent prompt cache restore skipped: %s\n", e.what());
+            if (!guard.owns_lock()) { guard.lock(); }
+            for (size_t i=0; i<entries.size(); ++i) { if (entries[i].name == selected_name) { try { remove_entry(i); } catch (...) {} break; } }
+            return nullptr;
+        }
+    }
+};
