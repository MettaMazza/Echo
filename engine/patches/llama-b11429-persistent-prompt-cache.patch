+#undef NDEBUG
+#include "server-task.h"
+#include "server-prompt-disk.h"
+#include <cassert>
+#include <iostream>
+
+int main() {
+    char pattern[] = "/tmp/echo-prompt-cache-test-XXXXXX";
+    const auto dir = std::filesystem::path(mkdtemp(pattern));
+    const std::string identity(64, 'a');
+    const uint64_t cap = 70*1024*1024;
+    auto sample = std::make_shared<server_prompt_cache_state>();
+    sample->prompt.tokens = server_tokens(llama_tokens{1,2,3,4,5}, false);
+    sample->data.main = {10,20,30,40}; sample->data.drft = {50,60};
+    common_prompt_checkpoint ck{};
+    ck.n_tokens=3; ck.pos_min=0; ck.pos_max=2; ck.data_tgt={70,80}; ck.data_dft={90}; ck.data_spec={100};
+    sample->prompt.checkpoints.push_back(ck);
+    {
+        server_prompt_disk store(dir, identity, cap, 0);
+        bool locked=false;
+        try { server_prompt_disk second(dir, identity, cap, 0); } catch (...) { locked=true; }
+        assert(locked);
+        store.submit(sample);
+    }
+    const server_tokens continuation(llama_tokens{1,2,3,4,5,6}, false);
+    std::list<std::shared_ptr<server_prompt_cache_state>> empty;
+    {
+        server_prompt_disk store(dir, identity, cap, 0);
+        auto got=store.load_best(continuation, 0, empty, cap);
+        assert(got && got->data.main == sample->data.main && got->data.drft == sample->data.drft);
+        assert(got->prompt.tokens.get_common_prefix(continuation)==5);
+        assert(got->prompt.checkpoints.size()==1 && got->prompt.checkpoints.front().data_spec==ck.data_spec);
+        assert(!store.load_best(continuation, 5, empty, cap));
+        assert(!store.load_best(server_tokens(llama_tokens{9,9,9},false),0,empty,cap));
+        empty.push_back(got);
+        assert(!store.load_best(continuation,0,empty,cap));
+        empty.clear();
+    }
+    // Corruption must become a miss, never feed bad state to llama.
+    for (const auto & file : std::filesystem::directory_iterator(dir)) {
+        if (file.path().extension()==".kv") {
+            std::fstream io(file.path(),std::ios::in|std::ios::out|std::ios::binary);
+            io.seekp(-1,std::ios::end); char damaged=0; io.write(&damaged,1);
+        }
+    }
+    {
+        server_prompt_disk store(dir,identity,cap,0);
+        assert(!store.load_best(continuation,0,empty,cap));
+        store.submit(sample);
+    }
+    {
+        server_prompt_disk store(dir,std::string(64,'b'),cap,0);
+        assert(!store.load_best(continuation,0,empty,cap));
+    }
+    // Free-space guard: no snapshot may be written if reserve cannot fit.
+    {
+        server_prompt_disk store(dir,identity,cap,UINT64_MAX/2);
+        store.submit(sample);
+    }
+    size_t files=0;
+    for (const auto & file:std::filesystem::directory_iterator(dir)) { if(file.path().extension()==".kv") ++files; }
+    assert(files==0);
+    // All recurrent checkpoints survive persistence; no context is truncated.
+    for (int i=0;i<127;++i) sample->prompt.checkpoints.push_back(ck);
+    {
+        server_prompt_disk store(dir,identity,cap,0); store.submit(sample);
+    }
+    {
+        server_prompt_disk store(dir,identity,cap,0);
+        auto got=store.load_best(continuation,0,empty,cap);
+        assert(got && got->prompt.n_tokens()==5 && got->prompt.checkpoints.size()==128);
+    }
+    std::filesystem::remove_all(dir);
+    std::cout << "PASS: restart roundtrip, checkpoints, draft state, locking, exact-prefix selection, warm-cache preference, corruption rejection, identity invalidation, disk reserve, full checkpoint retention\n";
+}
