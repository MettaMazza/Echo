+static std::string prompt_disk_identity(const std::string & configured) {
+    std::string binding = configured + ":" + __DATE__ + ":" + __TIME__;
+#if defined(__APPLE__)
+    auto bind_file = [&](const std::string & path) {
+        struct stat st{};
+        if (stat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode)) {
+            binding += path + ":" + std::to_string(st.st_dev) + ":" + std::to_string(st.st_ino) + ":" + std::to_string(st.st_size) + ":" + std::to_string(st.st_mtimespec.tv_sec) + ":" + std::to_string(st.st_mtimespec.tv_nsec) + ":" + std::to_string(st.st_ctimespec.tv_sec) + ":" + std::to_string(st.st_ctimespec.tv_nsec);
+        }
+    };
+    auto bind_glob = [&](const std::string & pattern) {
+        glob_t matches{};
+        if (glob(pattern.c_str(), 0, nullptr, &matches) == 0) {
+            for (size_t i=0; i<matches.gl_pathc; ++i) { bind_file(matches.gl_pathv[i]); }
+        }
+        globfree(&matches);
+    };
+    for (int i=0; i<*_NSGetArgc(); ++i) {
+        const std::string arg = (*_NSGetArgv())[i];
+        binding += ":arg:" + std::to_string(arg.size()) + ":" + arg;
+        const auto equal = arg.find('=');
+        const std::string file = equal == std::string::npos ? arg : arg.substr(equal+1);
+        bind_file(file);
+        auto shard = file.find("-00001-of-");
+        if (shard != std::string::npos) { bind_glob(file.substr(0, shard) + "-*-of-*.gguf"); }
+    }
+    Dl_info loaded{};
+    if (dladdr(reinterpret_cast<void *>(&llama_state_seq_set_data_ext), &loaded) && loaded.dli_fname) {
+        bind_glob((std::filesystem::path(loaded.dli_fname).parent_path()/"*.dylib").string());
+    }
+#endif
+    std::ostringstream out;
+    for (uint64_t seed=0; seed<4; ++seed) { out << std::hex << std::setw(16) << std::setfill('0') << XXH3_64bits_withSeed(binding.data(), binding.size(), seed); }
+    return out.str();
+}
