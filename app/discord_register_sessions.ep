import "discord/command_registration"

# Host maintenance only: curl, secret file, connector journal, bot, guild,
# private response spool. Run only after the deployed executor is qualified.
define main returning Int:
    if get_argument_count() is not equal to 8:
        return 1
    if not (get_argument(7) equals "history" or else get_argument(7) equals "resume" or else get_argument(7) equals "search" or else get_argument(7) equals "export" or else get_argument(7) equals "project" or else get_argument(7) equals "share" or else get_argument(7) equals "hud" or else get_argument(7) equals "attachments" or else get_argument(7) equals "cancel" or else get_argument(7) equals "branch" or else get_argument(7) equals "edit" or else get_argument(7) equals "regenerate" or else get_argument(7) equals "retry"):
        return 1
    set library to ep_dlopen(get_argument(1))
    set credential to read_file(get_argument(2))
    if library equals 0 or else credential equals 0 or else not file_exists(get_argument(3)):
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(4))
    if journal equals 0:
        return 3
    set result to discord_control_command_register(get_argument(7) and get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and get_argument(5) and get_argument(6))
    display result
    set closed to sql_close(journal)
    set unloaded to ep_dlclose(library)
    if not (result equals "registered") or else closed is not equal to 0 or else unloaded is not equal to 0:
        return 4
    return 0
