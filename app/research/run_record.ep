import "../archive/file_publication"
import "vector_controls"
import "../providers/archived_stream"

# Publish a flushed JSON record under an exclusive per-path reservation.
# Every Echo publisher reserves first; a crash preserves the reservation and
# partial file for investigation, never permits an implicit overwrite/retry.
define research_record_write with system as Int and path as Str and text as Str returning Int:
    if provider_json_tokens(text) equals 0:
        return 1
    if file_publication_reserve(system and path) is not equal to 0:
        return 1
    set temporary to concat(path and ".partial")
    set descriptor to file_stage_open(system and temporary)
    if descriptor is less than 0:
        return 1
    set written to file_stage_write(system and descriptor and str_to_ptr(text) and string_length(text))
    set closed to file_stage_finish(system and descriptor)
    if written is not equal to 0 or else closed is not equal to 0:
        return 1
    return file_publication_finish(system and temporary and path)

define research_file_record with path as Str returning Str:
    set checked to file_digest(path and 65536)
    if not (ptr_to_str(get_list(checked and 0)) equals "verified"):
        return ""
    set record to concat("{\"path\":" and provider_quote(path))
    set record to concat(record and concat(",\"sha256\":" and provider_quote(ptr_to_str(get_list(checked and 1)))))
    return concat(record and concat(",\"bytes\":" and concat(int_to_string(get_list(checked and 2)) and "}")))
