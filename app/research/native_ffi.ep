# Darwin arm64 ABI adapter, based on the installed SDK ffi.h/ffitarget_arm64.h.
# These are native structure layouts, not model/context limits. libffi computes
# engine structure sizes and offsets from their actual member type lists.
# Keep returned structure objects alive while signatures using them are live.
define research_native_words with count as Int returning List:
    set words to create_list()
    set index to 0
    repeat while index is less than count:
        set added to append_list(words and 0)
        set index to index + 1
    return words

define research_native_word with pointer as Int returning Int:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set copy to ep_dlsym(system and "memcpy")
    set value to research_native_words(1)
    set ignored to ep_dlcall3(copy and get_list_data_ptr(value) and pointer and 8)
    set closed to ep_dlclose(system)
    return get_list(value and 0)

define research_ffi_open returning Int:
    return ep_dlopen("/usr/lib/libffi.dylib")

define research_ffi_type with library as Int and name as Str returning Int:
    return ep_dlsym(library and concat("ffi_type_" and name))

define research_ffi_structure with members as List returning List:
    set elements to create_list()
    set index to 0
    repeat while index is less than length_list(members):
        if get_list(members and index) equals 0:
            return 0
        set added to append_list(elements and get_list(members and index))
        set index to index + 1
    set added to append_list(elements and 0)
    # ffi_type: size_t, alignment ushort, type ushort, padding, elements ptr.
    set descriptor to [0, 851968, get_list_data_ptr(elements)]
    return [descriptor, elements]

define research_ffi_pointer with structure as List returning Int:
    return get_list_data_ptr(get_list(structure and 0))

define research_ffi_offsets with library as Int and structure as List returning List:
    set count to length_list(get_list(structure and 1)) - 1
    set offsets to research_native_words(count)
    set function to ep_dlsym(library and "ffi_get_struct_offsets")
    if function equals 0 or else ep_dlcall3(function and 1 and research_ffi_pointer(structure) and get_list_data_ptr(offsets)) is not equal to 0:
        return 0
    return offsets

define research_ffi_invoke with library as Int and function as Int and result_type as Int and argument_types as List and argument_values as List returning List:
    if library equals 0 or else function equals 0 or else result_type equals 0 or else length_list(argument_types) is not equal to length_list(argument_values):
        return 0
    set prepare to ep_dlsym(library and "ffi_prep_cif")
    set invoke to ep_dlsym(library and "ffi_call")
    if prepare equals 0 or else invoke equals 0:
        return 0
    # Darwin arm64 ffi_cif has the extra unsigned aarch64_nfixedargs field,
    # making its aligned size40 bytes. FFI_SYSV is1 on this platform.
    set cif to research_native_words(5)
    if ep_dlcall5(prepare and get_list_data_ptr(cif) and 1 and length_list(argument_types) and result_type and get_list_data_ptr(argument_types)) is not equal to 0:
        return 0
    set bytes to research_native_word(result_type)
    set words to (bytes + 7) / 8
    if words is less than 1:
        set words to 1
    set result to research_native_words(words)
    set ignored to ep_dlcall4(invoke and get_list_data_ptr(cif) and function and get_list_data_ptr(result) and get_list_data_ptr(argument_values))
    return result
