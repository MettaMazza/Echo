import "capture_activation"

# Validate the actual IEEE754 float32 payload without converting its values.
# The pinned ABI is little endian; each four-byte word is zero-extended.
define research_f32_finite with system as Int and pointer as Int and count as Int returning Int:
    set word to [0]
    set copy to ep_dlsym(system and "memcpy")
    set index to 0
    repeat while index is less than count:
        set ignored to ep_dlcall3(copy and get_list_data_ptr(word) and pointer + index * 4 and 4)
        set bits to get_list(word and 0)
        set exponent to bits / 8388608 - (bits / 2147483648) * 256
        if exponent equals 255:
            return 0
        set index to index + 1
    return 1

# Host-only experiment callback. The baseline captures a reusable native-width
# vector from its final source token. This is an activation-derived direction,
# not a claim of a trained semantic/personality direction.
# State extends capture state with mode, vector, byte count, scale bits and vDSP.
define research_intervention_callback with tensor as Int and ask as Int and state as List returning Int:
    set library to get_list(state and 0)
    set system to get_list(state and 1)
    set name to ptr_to_str(ep_dlcall1(ep_dlsym(library and "ggml_get_name") and tensor))
    if not (name equals ptr_to_str(get_list(state and 2))):
        if ask is not equal to 0:
            return 0
        return 1
    if ask is not equal to 0:
        return 1
    set mode to get_list(state and 8)
    if mode equals 0:
        if research_capture_callback(tensor and 0 and state) equals 0:
            return 0
        set dimensions to get_list(state and 6)
        set bytes to get_list(dimensions and 0) * get_list(dimensions and 1) * 4
        if bytes is less than 1 or else get_list(dimensions and 3) is not equal to 1:
            set changed to set_list(state and 5 and 1)
            return 0
        if get_list(state and 9) is not equal to 0:
            if get_list(state and 10) is not equal to bytes:
                set changed to set_list(state and 5 and 1)
                return 0
            return 1
        set vector to ep_dlcall1(ep_dlsym(system and "malloc") and bytes)
        if vector equals 0:
            set changed to set_list(state and 5 and 1)
            return 0
        set ignored to ep_dlcall4(ep_dlsym(library and "ggml_backend_tensor_get") and tensor and vector and get_list(state and 7) - bytes and bytes)
        set changed to set_list(state and 9 and vector)
        set changed to set_list(state and 10 and bytes)
        return 1
    set changed to set_list(state and 4 and get_list(state and 4) + 1)
    if mode equals 2:
        return 1
    set bytes to ep_dlcall1(ep_dlsym(library and "ggml_nbytes") and tensor)
    if bytes is not equal to get_list(state and 7):
        set changed to set_list(state and 5 and 1)
        return 0
    set storage to ep_dlcall1(ep_dlsym(system and "malloc") and bytes)
    if storage equals 0:
        set changed to set_list(state and 5 and 1)
        return 0
    set ignored to ep_dlcall4(ep_dlsym(library and "ggml_backend_tensor_get") and tensor and storage and 0 and bytes)
    set scale to [get_list(state and 11)]
    set row_bytes to get_list(state and 10)
    set offset to 0
    repeat while offset is less than bytes:
        set row to storage + offset
        set ignored to ep_dlcall8(get_list(state and 12) and get_list(state and 9) and 1 and get_list_data_ptr(scale) and row and 1 and row and 1 and row_bytes / 4)
        set offset to offset + row_bytes
    set finite to research_f32_finite(system and storage and bytes / 4)
    if finite equals 1:
        # Scheduler synchronizes this selected node before invoking us and
        # evaluates downstream graph nodes only after this callback returns.
        set ignored to ep_dlcall4(ep_dlsym(library and "ggml_backend_tensor_set") and tensor and storage and 0 and bytes)
    set ignored to ep_dlcall1(ep_dlsym(system and "free") and storage)
    if finite is not equal to 1:
        set changed to set_list(state and 5 and 1)
        return 0
    return 1
