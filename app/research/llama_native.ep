import "native_ffi"

# Version-specific native ABI. Portable chat does not depend on these layouts.
# Field order is llama.cpp b11429 llama.h; libffi supplies actual offsets.
define research_llama_model_type with ffi as Int returning List:
    set p to research_ffi_type(ffi and "pointer")
    set i to research_ffi_type(ffi and "sint32")
    set b to research_ffi_type(ffi and "uint8")
    return research_ffi_structure([p, p, i, i, i, i, i, p, p, p, p, b, b, b, b, b, b])

define research_llama_context_type with ffi as Int returning List:
    set p to research_ffi_type(ffi and "pointer")
    set i to research_ffi_type(ffi and "uint32")
    set b to research_ffi_type(ffi and "uint8")
    set f to research_ffi_type(ffi and "float")
    set size to research_ffi_type(ffi and "uint64")
    return research_ffi_structure([i, i, i, i, i, i, i, i, i, i, i, i, i, i, f, f, f, f, f, f, i, f, p, p, i, i, p, p, b, b, b, b, b, b, p, size, p])

define research_llama_batch_type with ffi as Int returning List:
    set p to research_ffi_type(ffi and "pointer")
    return research_ffi_structure([research_ffi_type(ffi and "sint32"), p, p, p, p, p, p])

define research_native_write with system as Int and pointer as Int and value as Int and bytes as Int returning Int:
    set storage to [value]
    set copy to ep_dlsym(system and "memcpy")
    if copy equals 0 or else (bytes is not equal to 4 and bytes is not equal to 8):
        return 1
    set ignored to ep_dlcall3(copy and pointer and get_list_data_ptr(storage) and bytes)
    return 0
