import "lifecycle/controller_autonomous"

define main returning Int:
    if get_argument_count() is not equal to 12:
        display "Usage: autonomous_controller CONFIG PROPOSAL OPERATION DIRECTORY TARGET STAGE RECOVERY AUDIT WORKSPACE RUNTIME OUTPUT_DIRECTORY"
        return 1
    set result to controller_autonomous_host(get_argument(1) and get_argument(2) and get_argument(3) and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(7) and get_argument(8) and get_argument(9) and get_argument(10) and get_argument(11))
    display result
    if result equals "activated-and-verified":
        return 0
    return 1
