import "discord/worker_delivery"
import "archive/runtime_lock"
import "archive/snapshot"
import "discord/process"
import "string"

# Host-only isolated worker. Arguments: curl, secret file, journal, agent DB,
# private REST spool, stop file, bot, guild IDs, admin IDs, model, port,
# canonical snapshot directory. Gateway runs in its own heartbeat process.
define main returning Int:
    if get_argument_count() is not equal to 13 and get_argument_count() is not equal to 15:
        return 1
    if get_argument_count() equals 15 and not (get_argument(13) equals "--turn"):
        return 1
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set token to string_trim(ptr_to_str(credential))
    set bot to get_argument(7)
    set guilds to string_split(get_argument(8) and ",")
    set admins to string_split(get_argument(9) and ",")
    for each value in guilds:
        if discord_snowflake(ptr_to_str(value)) equals 0:
            return 3
    for each value in admins:
        if discord_snowflake(ptr_to_str(value)) equals 0:
            return 3
    set journal to discord_store_open(get_argument(3) and bot)
    set database to discord_agent_open(get_argument(4) and bot)
    if journal equals 0 or else database equals 0:
        return 4
    set profile to provider_llama_profile(get_argument(10) and http_decimal(get_argument(11)))
    if get_argument_count() equals 15:
        return discord_agent_child(journal and database and token and bot and guilds and admins and profile and get_argument(14))
    set properties to local_json_request(http_decimal(get_argument(11)) and "GET" and "/props" and "" and -1 and 65536)
    if not (archive_list_text(properties and 0) equals "ready"):
        return 7
    set properties_json to provider_json_tokens(archive_list_text(properties and 2))
    set slots to http_decimal(provider_value(properties_json and provider_member(properties_json and 0 and "total_slots")))
    if slots < 1:
        return 7
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to archive_runtime_lock(database and system)
    if lock < 0:
        return 5
    if discord_worker_schema(journal) is not equal to 0 or else discord_delivery_schema(journal) is not equal to 0:
        return 6
    set idle to channel
    set rooted_literal_1 to create_list()
    set retained_value_added to append_list(rooted_literal_1 and idle)
    set waits to rooted_literal_1
    set status to 1
    set children to create_list()
    repeat while not file_exists(get_argument(6)):
        set remaining to create_list()
        set child_failure to 0
        for each process in children:
            set result to discord_process_poll(process)
            if result equals 0:
                set added to append_list(remaining and process)
            else if result is not equal to 1:
                set child_failure to 1
        set children to remaining
        if child_failure is not equal to 0:
            display "Turn child requires recovery; no implicit replay."
            break
        if discord_worker_reconcile(journal) is not equal to 0:
            display "Delivery observation requires recovery."
            break
        set now_text to int_to_string(ep_time_now_ms())
        set rooted_literal_2 to create_list()
        set retained_value_added to append_list(rooted_literal_2 and now_text)
        set pending to history_collect_one(checkpoint_prepare(journal and "SELECT o.identity FROM discord_outbox o LEFT JOIN discord_delivery_retry_clock c ON c.identity=o.identity WHERE o.state='pending' AND COALESCE(c.next_ms,0)<=CAST(? AS INTEGER) ORDER BY o.rowid LIMIT 1;" and rooted_literal_2))
        if archive_list_text(pending and 0) equals "found":
            set delivered to discord_worker_deliver(get_argument(1) and token and journal and archive_list_text(pending and 1) and bot and admins and get_argument(5) and get_argument(6))
            display concat("delivery: " and delivered)
            # Retry only fresh read checks on a held pending intent. Actual POST
            # retry remains governed by delivery.ep's rate/uncertainty rules.
            set pending_identity to archive_list_text(pending and 1)
            set retry_time to int_to_string(ep_time_now_ms() + 30000)
            set rooted_literal_3 to create_list()
            set retained_value_added to append_list(rooted_literal_3 and pending_identity)
            set retained_value_added to append_list(rooted_literal_3 and retry_time)
            if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_delivery_retry_clock VALUES(?1,CAST(?2 AS INTEGER)) ON CONFLICT(identity) DO UPDATE SET next_ms=excluded.next_ms;" and rooted_literal_3) and 101) is not equal to 0:
                break
        # Use the current provider's reported independent inference slots.
        # Different conversations may progress concurrently; a durable claim
        # serializes each user-in-channel/DM conversation.
        if length_list(children) >= slots:
            set waited to select(waits and 100)
            continue
        set claimed to discord_worker_claim(journal)
        if archive_list_text(claimed and 0) equals "claimed":
            set inbox to archive_list_text(claimed and 1)
            set arguments to create_list()
            set index to 1
            repeat while index <= 12:
                set added to append_list(arguments and get_argument(index))
                set index to index + 1
            set added to append_list(arguments and "--turn")
            set added to append_list(arguments and inbox)
            set process to discord_process_start(arguments and -1)
            if process < 0:
                display "Turn process launch failed; claim retained."
                break
            set added to append_list(children and process)
        else if not (archive_list_text(claimed and 0) equals "end" or else archive_list_text(claimed and 0) equals "busy"):
            display "Intake claim requires recovery."
            break
        set waited to select(waits and 500)
    if file_exists(get_argument(6)):
        set status to 0
    # Retain ownership until every child observes the stop file or finishes.
    for each process in children:
        repeat while discord_process_poll(process) equals 0:
            set waited to select(waits and 100)
    set closed to net_close(lock)
    set closed to ep_dlclose(system)
    set closed to sql_close(database)
    set closed to sql_close(journal)
    return status

define discord_agent_child with journal as Int and database as Int and token as Str and bot as Str and guilds as List and admins as List and profile as Str and inbox as Str returning Int:
    set result to "not-admitted"
    if string_index_of(inbox and "message:redirect:") equals 0:
        set result to discord_redirect_enqueue(journal and inbox)
    else:
        set result to discord_agent_turn(get_argument(1) and token and journal and get_argument(3) and database and inbox and bot and guilds and admins and get_argument(5) and get_argument(6) and profile)
    if not (discord_worker_finish(journal and inbox and result) equals "recorded"):
        display "Turn receipt requires recovery."
        return 1
    display concat(inbox and concat(": " and result))
    set snapshot to concat(get_argument(12) and concat("/agent-" and concat(ptr_to_str(ep_uuid_v4()) and ".sqlite")))
    if archive_snapshot(database and snapshot) is not equal to 0:
        display "Canonical snapshot failed."
        return 2
    return 0
