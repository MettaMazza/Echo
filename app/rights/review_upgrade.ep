import "quarantine"

# Preserve every original receipt; absent inspection is representable only for
# non-consent decisions. Existing consent evidence is copied byte-for-byte.
define protected_refusal_schema with database as Int returning Str:
    set prior to protected_quarantine_schema(database)
    if not (prior equals "applied" or else prior equals "already-applied"):
        return prior
    return migration_apply(database and 16 and "uninspected-refusal-receipts" and "ALTER TABLE echo_protected_reviews RENAME TO echo_protected_reviews_pre16; CREATE TABLE echo_protected_reviews(sequence INTEGER PRIMARY KEY AUTOINCREMENT,proposal TEXT NOT NULL REFERENCES echo_protected_proposals(identity),run TEXT NOT NULL,call_id TEXT NOT NULL,principal TEXT NOT NULL REFERENCES echo_principals(identity),previous_revision INTEGER NOT NULL CHECK(previous_revision>=0),inspection_event TEXT REFERENCES echo_events(event),review_event TEXT NOT NULL UNIQUE REFERENCES echo_events(event),model_request TEXT NOT NULL REFERENCES echo_events(event),evidence TEXT NOT NULL,evidence_digest TEXT NOT NULL,created TEXT NOT NULL DEFAULT(strftime('%Y-%m-%dT%H:%M:%fZ','now')),UNIQUE(run,call_id),UNIQUE(proposal,previous_revision),CHECK(inspection_event IS NOT NULL OR (json_valid(evidence) AND COALESCE(json_extract(evidence,'$.decision'),'') IN ('reject','counter','object'))),FOREIGN KEY(run,call_id) REFERENCES echo_tool_calls(run,call_id)); INSERT INTO echo_protected_reviews SELECT * FROM echo_protected_reviews_pre16; CREATE TRIGGER echo_protected_reviews_v16_no_update BEFORE UPDATE ON echo_protected_reviews BEGIN SELECT RAISE(ABORT,'Protected decisions are immutable'); END; CREATE TRIGGER echo_protected_reviews_v16_no_delete BEFORE DELETE ON echo_protected_reviews BEGIN SELECT RAISE(ABORT,'Protected decisions are immutable'); END; CREATE TRIGGER echo_protected_reviews_legacy_no_insert BEFORE INSERT ON echo_protected_reviews_pre16 BEGIN SELECT RAISE(ABORT,'Legacy review snapshot is immutable'); END;")
