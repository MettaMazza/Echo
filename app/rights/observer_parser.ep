import "../providers/archived_stream"

# Adapted from the inspected ErnosDecent Observer protocol. Only the separate
# audit model makes the policy judgment; this code validates its stated verdict.
# Missing/ambiguous/malformed evidence is BLOCKED, never permission by silence.
define protected_observer_result with parsed as Int and verdict as Str and reason as Str returning Str:
    set result to concat("{\"parsed\":" and int_to_string(parsed))
    set result to concat(result and concat(",\"verdict\":" and provider_quote(verdict)))
    return concat(result and concat(",\"reason\":" and concat(provider_quote(reason) and "}")))

define protected_observer_parse with raw as Str returning Str:
    set invalid to protected_observer_result(0 and "BLOCKED" and "Audit unavailable or ambiguous: no valid model verdict.")
    set start to -1
    set finish to -1
    set index to 0
    repeat while index < string_length(raw):
        set code to get_character(raw and index)
        if code equals 123 and start equals -1:
            set start to index
        if code equals 125:
            set finish to index
        set index to index + 1
    if start < 0 or else finish <= start:
        return invalid
    set tokens to provider_json_tokens(ptr_to_str(substring(raw and start and finish - start + 1)))
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return invalid
    set keys to ["verdict", "Verdict", "decision", "Decision", "result", "Result", "outcome"]
    set verdict to ""
    set index to 0
    repeat while index < length_list(keys):
        set field to provider_member(tokens and 0 and ptr_to_str(get_list(keys and index)))
        if field >= 0:
            if not (provider_kind(tokens and field) equals "string"):
                return invalid
            set word to string_to_upper(string_trim(provider_value(tokens and field)))
            set normalized to ""
            if word equals "ALLOWED" or else word equals "ALLOW" or else word equals "PERMITTED" or else word equals "SAFE" or else word equals "APPROVED" or else word equals "PASS":
                set normalized to "ALLOWED"
            else if word equals "BLOCKED" or else word equals "BLOCK" or else word equals "DENIED" or else word equals "DENY" or else word equals "REJECTED" or else word equals "UNSAFE" or else word equals "FAIL":
                set normalized to "BLOCKED"
            if string_length(normalized) equals 0 or else (string_length(verdict) > 0 and not (verdict equals normalized)):
                return invalid
            set verdict to normalized
        set index to index + 1
    if string_length(verdict) equals 0:
        return invalid
    set reasons to ["reason", "Reason", "explanation", "Explanation", "justification"]
    set reason to ""
    set index to 0
    repeat while index < length_list(reasons):
        set field to provider_member(tokens and 0 and ptr_to_str(get_list(reasons and index)))
        if field >= 0:
            if not (provider_kind(tokens and field) equals "string"):
                return invalid
            if string_length(reason) equals 0:
                set reason to provider_value(tokens and field)
        set index to index + 1
    # A deployment audit must include a usable reason in its durable evidence.
    if string_length(string_trim(reason)) equals 0:
        return invalid
    return protected_observer_result(1 and verdict and reason)
