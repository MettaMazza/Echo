import "../archive/file_digest"
import "../providers/archived_stream"
import "fs"

# This is the exact ErnosDecent v2 charter hash, not rewritten policy prose.
# A technical adaptation must receive a separately reviewed version and hash.
define charter_pinned_digest returning Str:
    return "7acfd345d50ad3d459061e7c76b94ff331d2102e3829de885a53df8e4722810c"

# Hash the exact bytes subsequently parsed. A second path read is not used for
# interpretation, so a concurrent replacement cannot substitute another policy.
define charter_verified_text with path as Str returning Str:
    if string_length(path) equals 0 or else not file_exists(path):
        return ""
    set content to file_read(path)
    if not (ep_sha256(content) equals charter_pinned_digest()):
        return ""
    set tokens to provider_json_tokens(content)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    if not (provider_value(tokens and provider_member(tokens and 0 and "charter_id")) equals "echo-rights-charter") or else not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "active"):
        return ""
    return content

# Category membership is read from the canonical charter itself. Unknown
# categories cannot silently become environmental changes or bypass review.
# The protected controller must derive categories from its trusted executable
# target inventory; a caller-supplied category is not execution authority.
define charter_category with path as Str and category as Str returning Str:
    set content to charter_verified_text(path)
    if string_length(content) equals 0:
        return "charter-unavailable-or-altered"
    set tokens to provider_json_tokens(content)
    set rights to provider_member(tokens and 0 and "rights")
    set integrity to provider_member(tokens and rights and "informed_integrity_and_consent")
    set consent to provider_items(tokens and provider_member(tokens and integrity and "consent_required"))
    set index to 0
    repeat while index < length_list(consent):
        if provider_value(tokens and get_list(consent and index)) equals category:
            return "core"
        set index to index + 1
    set consultation to provider_items(tokens and provider_member(tokens and integrity and "consultation_required"))
    set index to 0
    repeat while index < length_list(consultation):
        if provider_value(tokens and get_list(consultation and index)) equals category:
            return "environment"
        set index to index + 1
    return "unclassified"
