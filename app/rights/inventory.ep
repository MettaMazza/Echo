import "proposals"
import "../workspace/files"

# The controller supplies these inventory bytes and their independently pinned
# digest. Model arguments are never the source of the trusted inventory pin.
# Inventory changes themselves require protected-definition review.
define protected_inventory_category with charter as Str and inventory as Str and expected_digest as Str and target as Str returning Str:
    if protected_digest_valid(expected_digest) equals 0 or else not (ep_sha256(inventory) equals expected_digest):
        return ""
    set tokens to provider_json_tokens(inventory)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "version")) equals "1"):
        return ""
    set entries to provider_items(tokens and provider_member(tokens and 0 and "targets"))
    if entries equals 0:
        return ""
    set paths to create_list()
    set selected to ""
    set index to 0
    repeat while index < length_list(entries):
        set entry to get_list(entries and index)
        set path_field to provider_member(tokens and entry and "path")
        set category_field to provider_member(tokens and entry and "category")
        if not (provider_kind(tokens and path_field) equals "string") or else not (provider_kind(tokens and category_field) equals "string"):
            return ""
        set path to provider_value(tokens and path_field)
        set category to provider_value(tokens and category_field)
        if string_length(path) < 2 or else get_character(path and 0) is not equal to 47:
            return ""
        if workspace_path_parts(ptr_to_str(substring(path and 1 and string_length(path) - 1))) equals 0:
            return ""
        set classification to charter_category(charter and category)
        if not (classification equals "core" or else classification equals "environment"):
            return ""
        set prior to 0
        repeat while prior < length_list(paths):
            if archive_list_text(paths and prior) equals path:
                return ""
            set prior to prior + 1
        set added to append_list(paths and path)
        if path equals target:
            set selected to category
        set index to index + 1
    return selected

# Produce an exact manifest that includes the trusted inventory digest. Legacy
# proposal records remain readable but cannot pass the inventory-bound gate.
define protected_inventory_manifest with charter as Str and inventory as Str and inventory_digest as Str and target as Str and before_hash as Str and after_hash as Str and payload as Str returning Str:
    set category to protected_inventory_category(charter and inventory and inventory_digest and target)
    if string_length(category) equals 0:
        return ""
    return protected_manifest_pinned(charter and category and target and before_hash and after_hash and payload and inventory_digest)

# Re-derive rather than trusting the proposal's category, classification or pin.
# This does not grant consent, prove current target bytes or authorize execution.
define protected_inventory_matches with charter as Str and inventory as Str and inventory_digest as Str and manifest as Str returning Int:
    set tokens to provider_json_tokens(manifest)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 0
    set expected to protected_inventory_manifest(charter and inventory and inventory_digest and provider_value(tokens and provider_member(tokens and 0 and "target")) and provider_value(tokens and provider_member(tokens and 0 and "before_sha256")) and provider_value(tokens and provider_member(tokens and 0 and "proposed_sha256")) and provider_value(tokens and provider_member(tokens and 0 and "proposal_payload")))
    if string_length(expected) equals 0:
        return 0
    return expected equals manifest
