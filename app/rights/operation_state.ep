import "operation_prepare"

# Original preparation and every transition share an independently verifiable
# operation chain. Caller keeps a writer transaction while acting on this state.
define protected_operation_read with database as Int and identity as Str returning List:
    set schema to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='index' AND name='echo_one_operation_per_proposal';"))
    if not (archive_list_text(schema and 0) equals "found"):
        return history_status("operation-schema-required")
    set session to protected_operation_session(identity)
    if archive_verify(database and session) is not equal to 0:
        return history_status("operation-integrity-failed")
    set prepared to archive_read_event(database and concat(session and ":prepared"))
    if prepared equals 0 or else not (archive_list_text(prepared and 0) equals session) or else not (archive_list_text(prepared and 2) equals "protected_operation_prepared"):
        return history_status("operation-missing")
    set payload to archive_list_text(prepared and 3)
    set parsed to provider_json_tokens(payload)
    if parsed equals 0 or else provider_unique_objects(parsed) equals 0 or else not (provider_value(parsed and provider_member(parsed and 0 and "identity")) equals identity):
        return history_status("operation-invalid")
    set values to create_list()
    set added to append_list(values and session)
    set statement to checkpoint_prepare(database and "SELECT event,kind,payload FROM echo_events WHERE session=? ORDER BY sequence;" and values)
    if statement equals 0:
        return history_status("operation-read-failed")
    set state to "initial"
    set ordinal to 0
    set head to ""
    repeat while 1 equals 1:
        set row to ep_sqlite3_step(statement)
        if row equals 101:
            break
        if row is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return history_status("operation-read-failed")
        set event to ptr_to_str(ep_sqlite3_column_text(statement and 0))
        set kind to ptr_to_str(ep_sqlite3_column_text(statement and 1))
        set transition to provider_json_tokens(ptr_to_str(ep_sqlite3_column_text(statement and 2)))
        set next to ""
        if state equals "initial" and kind equals "protected_operation_prepared" and event equals concat(session and ":prepared"):
            set next to "prepared"
        else:
            set phase to provider_value(transition and provider_member(transition and 0 and "phase"))
            if kind equals "protected_operation_transition" and (event equals concat(session and concat(":" and phase)) or else event equals concat(session and concat(":transition:" and int_to_string(ordinal)))) and provider_value(transition and provider_member(transition and 0 and "prepared_digest")) equals ep_sha256(payload):
                if state equals "prepared" and phase equals "applying":
                    set next to phase
                else if (state equals "applying" or else state equals "uncertain") and (phase equals "applied" or else phase equals "not-applied" or else phase equals "uncertain"):
                    set next to phase
                else if (state equals "applied" or else state equals "rollback-not-applied") and phase equals "rolling-back":
                    set next to phase
                else if (state equals "rolling-back" or else state equals "rollback-uncertain") and (phase equals "rolled-back" or else phase equals "rollback-not-applied" or else phase equals "rollback-uncertain"):
                    set next to phase
        if transition equals 0 or else provider_unique_objects(transition) equals 0 or else string_length(next) equals 0:
            set closed to ep_sqlite3_finalize(statement)
            return history_status("operation-transition-invalid")
        set state to next
        set ordinal to ordinal + 1
        set head to concat(event and "")
    if ep_sqlite3_finalize(statement) is not equal to 0:
        return history_status("operation-read-failed")
    set result to history_status(state)
    set added to append_list(result and payload)
    set added to append_list(result and head)
    return result

# Internal transition writer; caller owns the transaction and has validated
# state and physical effects. This primitive grants no execution authority.
define protected_operation_record with database as Int and identity as Str and prepared as Str and phase as Str and detail as Str returning Int:
    if sqlite3_get_autocommit(database) is not equal to 0:
        return 1
    set payload to concat("{\"prepared_digest\":" and provider_quote(ep_sha256(prepared)))
    set payload to concat(payload and concat(",\"phase\":" and provider_quote(phase)))
    set payload to concat(payload and concat(",\"detail\":" and concat(provider_quote(detail) and "}")))
    set session to protected_operation_session(identity)
    set values to create_list()
    set added to append_list(values and session)
    set count to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE session=?;" and values))
    if not (archive_list_text(count and 0) equals "found"):
        return 1
    set event to concat(session and concat(":transition:" and archive_list_text(count and 1)))
    return archive_append_pending(database and session and event and "protected_operation_transition" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms())))

# Empty credentials are reserved for the authenticated OS host entry. Service
# dispatch rejects them. A service actor must be a current controller steward
# belonging to this operation's recorded stewardship, not merely any admin.
define protected_operation_actor_stamp with database as Int and identity as Str and credential as Str returning Str:
    if string_length(credential) equals 0:
        return "host-entry"
    set actor to protected_steward_actor(database and credential)
    if not (archive_list_text(actor and 0) equals "found"):
        return ""
    set operation to protected_operation_read(database and identity)
    if length_list(operation) < 2:
        return ""
    set tokens to provider_json_tokens(archive_list_text(operation and 1))
    set proposal to provider_value(tokens and provider_member(tokens and 0 and "proposal"))
    if protected_steward_integrity(database and proposal) equals 0:
        return ""
    set owner to history_collect_one(checkpoint_prepare(database and "SELECT principal FROM echo_protected_steward WHERE proposal=? ORDER BY previous_revision DESC LIMIT 1;" and [proposal]))
    if not (archive_list_text(owner and 0) equals "found") or else not (archive_list_text(owner and 1) equals archive_list_text(actor and 2)):
        return ""
    set text to "controller-actor:"
    set index to 1
    repeat while index < length_list(actor):
        set text to concat(text and archive_hash_field(archive_list_text(actor and index)))
        set index to index + 1
    return ep_sha256(text)
