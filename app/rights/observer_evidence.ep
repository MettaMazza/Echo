import "observer_audit"
import "../providers/restored_stream"

# Reconstruct the answer from original stream events, not a trusted-looking
# receipt alone. Caller must still apply all independent publication gates.
define protected_observer_evidence with database as Int and run as Str and proposal as Str and request as Str and policy as Str and policy_digest as Str returning Str:
    if string_length(string_trim(policy)) equals 0 or else not (ep_sha256(policy) equals policy_digest):
        return "invalid-policy"
    set input to protected_observer_input(database and run and proposal)
    if string_length(input) equals 0:
        return "invalid-review-input"
    set original to archive_read_event(database and request)
    set audit to archive_read_event(database and concat(request and ":audit"))
    if original equals 0 or else audit equals 0:
        return "audit-missing"
    set values to create_list()
    set added to append_list(values and run)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_runs WHERE run=?;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "missing-run"
    set session to archive_list_text(row and 1)
    if not (archive_list_text(original and 0) equals session) or else not (archive_list_text(audit and 0) equals session) or else not (archive_list_text(original and 2) equals "model_request") or else not (archive_list_text(audit and 2) equals "protected_observer_audit") or else archive_verify(database and session) is not equal to 0:
        return "audit-integrity-failed"
    set source to provider_json_tokens(archive_list_text(original and 3))
    set receipt to provider_json_tokens(archive_list_text(audit and 3))
    if source equals 0 or else receipt equals 0 or else provider_unique_objects(source) equals 0 or else provider_unique_objects(receipt) equals 0:
        return "invalid-audit"
    if not (provider_value(source and provider_member(source and 0 and "purpose")) equals "protected-observer") or else not (provider_value(source and provider_member(source and 0 and "policy_digest")) equals policy_digest) or else not (provider_value(receipt and provider_member(receipt and 0 and "policy_digest")) equals policy_digest) or else not (provider_value(receipt and provider_member(receipt and 0 and "input_digest")) equals ep_sha256(input)) or else not (provider_value(receipt and provider_member(receipt and 0 and "request_event")) equals request) or else not (provider_value(receipt and provider_member(receipt and 0 and "transport_status")) equals "complete"):
        return "audit-binding-failed"
    set body to provider_value(source and provider_member(source and 0 and "request_body"))
    set tokens to provider_json_tokens(body)
    set model to provider_value(tokens and provider_member(tokens and 0 and "model"))
    if not (body equals protected_observer_body(model and policy and input)):
        return "audit-request-mismatch"
    set restored to provider_restore_stream(database and session and request)
    if not (archive_list_text(restored and 0) equals "complete"):
        return "audit-stream-incomplete"
    set state to get_list(restored and 1)
    set choice to chat_find(get_list(state and 0) and "0")
    if choice equals 0 or else length_list(get_list(choice and 3)) is not equal to 0:
        return "audit-response-invalid"
    set raw to archive_list_text(choice and 1)
    if not (provider_value(receipt and provider_member(receipt and 0 and "raw")) equals raw):
        return "audit-response-mismatch"
    set verdict to provider_json_tokens(protected_observer_parse(raw))
    if not (provider_value(verdict and provider_member(verdict and 0 and "parsed")) equals "1"):
        return "invalid-verdict"
    if not (protected_observer_input(database and run and proposal) equals input):
        return "audit-input-changed"
    return provider_value(verdict and provider_member(verdict and 0 and "verdict"))
