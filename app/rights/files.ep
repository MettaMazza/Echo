import "inventory"

# Read-only preflight. These hashes describe complete observed binary streams,
# not an atomic deployment or authority to write. The protected executor must
# hold its publication lock, verify snapshots and recheck at actual publication.
define protected_file_check with charter as Str and inventory as Str and inventory_digest as Str and manifest as Str and candidate as Str returning Str:
    if protected_inventory_matches(charter and inventory and inventory_digest and manifest) equals 0:
        return "inventory-or-manifest-mismatch"
    set tokens to provider_json_tokens(manifest)
    set target to provider_value(tokens and provider_member(tokens and 0 and "target"))
    set before_hash to provider_value(tokens and provider_member(tokens and 0 and "before_sha256"))
    set after_hash to provider_value(tokens and provider_member(tokens and 0 and "proposed_sha256"))
    if candidate equals target or else string_length(candidate) < 2 or else get_character(candidate and 0) is not equal to 47:
        return "invalid-candidate-path"
    if workspace_path_parts(ptr_to_str(substring(candidate and 1 and string_length(candidate) - 1))) equals 0:
        return "invalid-candidate-path"
    # No-follow-any and nonblocking open reject symlink components and FIFOs.
    # The batch is read granularity; it never limits the total candidate size.
    set original to file_digest_durable(target and 65536)
    if not (archive_list_text(original and 0) equals "verified"):
        return "target-unreadable"
    if not (archive_list_text(original and 1) equals before_hash):
        return "target-changed"
    set proposed to file_digest_durable(candidate and 65536)
    if not (archive_list_text(proposed and 0) equals "verified"):
        return "candidate-unreadable"
    if not (archive_list_text(proposed and 1) equals after_hash):
        return "candidate-mismatch"
    set checked_again to file_digest_durable(target and 65536)
    if not (archive_list_text(checked_again and 0) equals "verified") or else not (archive_list_text(checked_again and 1) equals before_hash):
        return "target-changed-during-check"
    return "bytes-match"
