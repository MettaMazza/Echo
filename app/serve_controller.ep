import "lifecycle/controller_service"

define main returning Int:
    if get_argument_count() equals 2:
        return controller_service_run(get_argument(1) and "")
    if get_argument_count() equals 4 and get_argument(2) equals "--connection" and protected_digest_valid(get_argument(3)) equals 1:
        return controller_service_run(get_argument(1) and get_argument(3))
    if get_argument_count() equals 5 and get_argument(2) equals "--review" and protected_digest_valid(get_argument(4)) equals 1:
        return controller_review_host(get_argument(1) and get_argument(3) and get_argument(4))
    display "Usage: serve_controller ROOT_OWNED_CONFIGURATION. Requires completed, matching controller bootstrap."
    return 1
