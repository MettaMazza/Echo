define discord_voice_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"discord_voice\",\"description\":\"Send only the fields for the selected operation; omit unused fields entirely, never empty placeholders. Join accepts exactly operation and channel. Leave/record accept exactly operation and intent. Play adds attachment. Status accepts intent, optionally job OR recording; only recording status accepts after/limit. Stop requires intent and recording. Configured Discord admin only. Join an authorised voice channel in the current guild, inspect a returned intent, request leave, or play a selected audio attachment (including locally generated TTS) in that voice channel. Join queues an independently checked connection and initially stays muted/deafened. Queued/sent does not mean connected or audible. No recording, transcription or playback is enabled by joining. Use the returned intent for status/leave/play. For playback status also supply the returned job ID; completed means the local sender finished, not proof anyone heard it. Play requires attachment ID from this conversation and the same actor/origin as the join. It queues independent source, audience and SPEAK checks; queued does not mean heard. Never use private-host audio or a filesystem path. Record requests a separate, explicitly enabled transcription workflow for this intent: visible notice and individual current-session consent are required before capture. Use the returned recording ID with intent and status or stop. Active means the notice is active, not proof audio is captured or transcribed. Stop ends this recording; it does not leave voice or erase retained records. Recording runtime must be qualified and enabled by the operator. Runtime must be configured by the operator; do not blindly retry uncertain actions. Recording status returns processing counts and scoped audio/transcript attachment IDs. Page with after (next_after from the previous result) and limit (1\\u2013100, default 20). Follow has_more to retrieve every segment. After processing_complete becomes true, restart from after=0 to refresh transcript IDs on earlier pages. Capture stopped does not imply processing complete.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"join\",\"status\",\"leave\",\"play\",\"record\",\"stop\"]},\"channel\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required only for join. Omit for every other operation.\",\"pattern\":\"^[1-9][0-9]{0,19}$\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128},\"attachment\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required only for play; omit otherwise.\",\"maxLength\":512},\"job\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Playback status only; omit otherwise.\",\"maxLength\":128},\"recording\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for stop and recording status; omit for join/leave/play/record and other status.\",\"maxLength\":64},\"after\":{\"type\":\"string\",\"description\":\"Recording-status cursor; use next_after or 0 to start.\",\"minLength\":1,\"pattern\":\"^(0|[1-9][0-9]*)$\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":100,\"description\":\"Recording-status page size.\"}},\"required\":[\"operation\"],\"additionalProperties\":false,\"allOf\":[{\"oneOf\":[{\"properties\":{\"operation\":{\"enum\":[\"join\"],\"type\":\"string\"},\"channel\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required only for join. Omit for every other operation.\",\"pattern\":\"^[1-9][0-9]{0,19}$\"}},\"required\":[\"operation\",\"channel\"],\"additionalProperties\":false},{\"properties\":{\"operation\":{\"enum\":[\"leave\",\"record\"],\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128}},\"required\":[\"operation\",\"intent\"],\"additionalProperties\":false},{\"properties\":{\"operation\":{\"enum\":[\"play\"],\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128},\"attachment\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required only for play; omit otherwise.\",\"maxLength\":512}},\"required\":[\"operation\",\"intent\",\"attachment\"],\"additionalProperties\":false},{\"properties\":{\"operation\":{\"enum\":[\"status\"],\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128}},\"required\":[\"operation\",\"intent\"],\"additionalProperties\":false},{\"properties\":{\"operation\":{\"enum\":[\"status\"],\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128},\"job\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Playback status only; omit otherwise.\",\"maxLength\":128}},\"required\":[\"operation\",\"intent\",\"job\"],\"additionalProperties\":false},{\"properties\":{\"operation\":{\"enum\":[\"stop\"],\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128},\"recording\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for stop and recording status; omit for join/leave/play/record and other status.\",\"maxLength\":64}},\"required\":[\"operation\",\"intent\",\"recording\"],\"additionalProperties\":false},{\"properties\":{\"operation\":{\"enum\":[\"status\"],\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for every operation except join; omit for join.\",\"maxLength\":128},\"recording\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Required for stop and recording status; omit for join/leave/play/record and other status.\",\"maxLength\":64},\"after\":{\"type\":\"string\",\"description\":\"Recording-status cursor; use next_after or 0 to start.\",\"minLength\":1,\"pattern\":\"^(0|[1-9][0-9]*)$\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":100,\"description\":\"Recording-status page size.\"}},\"required\":[\"operation\",\"intent\",\"recording\"],\"additionalProperties\":false}]}]}}}"
