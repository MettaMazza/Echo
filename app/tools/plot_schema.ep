define workspace_plot_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"workspace_plot\",\"description\":\"Create a reproducible SVG line/scatter plot at a new relative workspace path. Pass numeric [x,y] pairs, series names, title and axis labels. Linear axes scale across all supplied series; line points connect in input order. Uses finite binary64 coordinates and preserves exact supplied JSON in inert SVG metadata. Existing files are preserved. Returns file SHA256; use attach_file with image/svg+xml to show the saved plot in chat. No scripts or external resources.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"plot\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"x_label\":{\"type\":\"string\"},\"y_label\":{\"type\":\"string\"},\"series\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"enum\":[\"line\",\"scatter\"]},\"points\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"array\",\"items\":{\"type\":\"number\"},\"minItems\":2,\"maxItems\":2}}},\"required\":[\"name\",\"kind\",\"points\"],\"additionalProperties\":false}}},\"required\":[\"title\",\"x_label\",\"y_label\",\"series\"],\"additionalProperties\":false}},\"required\":[\"path\",\"plot\"],\"additionalProperties\":false}}}"
