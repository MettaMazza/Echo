define workspace_database_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"workspace_database\",\"description\":\"Run SQLite SQL against a relative database path in your isolated workspace, creating it if absent. Supports schema, queries, updates and multi-statement scripts. No host database access, network or extension loading. Output is retained JSON Lines: statement column names, typed rows, statement-complete and final complete/error records. Read it with workspace_output_next. Integers/reals are exact SQLite text with a storage-type label; ordinary text is UTF-8, blobs or binary text are hex. Statements autocommit unless you use BEGIN/COMMIT; any transaction left open rolls back and returns failure. Earlier committed changes can remain after an error or cancellation; inspect before retry. Raw wait_status 0 plus final complete proves script completion, not merely process capture status complete.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"sql\":{\"type\":\"string\"}},\"required\":[\"path\",\"sql\"],\"additionalProperties\":false}}}"
