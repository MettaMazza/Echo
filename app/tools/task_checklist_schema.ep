define task_checklist_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"task_checklist\",\"description\":\"Save the durable checklist for your current task, whether working directly for the user or as a delegated agent. Ordinary conversation and read-only lookups need no checklist. First list only the explicit assigned requirements. Send the complete items array on every update; stable IDs and requirements cannot be dropped or changed unless new user or parent guidance was applied. Mark done with observed evidence of work already performed, not a claim that an unsent reply was delivered. For a final-answer requirement, record that the answer is prepared and deliver it next; delivery is archived separately. Mark unresolved with the concrete limitation allowed by the assignment. Keep evidence and completed reads so you do not repeat them. When no items remain pending, your next response is the final report to your requester; no optional research or additional interests.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"items\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"requirement\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"done\",\"unresolved\"]},\"evidence\":{\"type\":\"string\"}},\"required\":[\"id\",\"requirement\",\"status\",\"evidence\"],\"additionalProperties\":false}}},\"required\":[\"items\"],\"additionalProperties\":false}}}"
