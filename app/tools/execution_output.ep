import "../providers/local_json"
import "../security/group_gate"
import "../security/principals"
import "../retained_text"
import "history_tools"

# Traverse only original output records, excluding model requests and later
# search/read copies. Session comes from the current run, never from arguments.
define execution_output_execute_snapshot with database as Int and session as Str and arguments as Str returning Str:
    if group_history_allows(database and session) equals 0:
        return "{\"status\":\"audience-history-unavailable\"}"
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "{\"status\":\"invalid-arguments\"}"
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "run_id" or else key equals "call_id" or else key equals "stream" or else key equals "after"):
            return "{\"status\":\"invalid-arguments\"}"
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set run_field to provider_member(tokens and 0 and "run_id")
    set call_field to provider_member(tokens and 0 and "call_id")
    set stream_field to provider_member(tokens and 0 and "stream")
    set after to history_tool_integer(tokens and "after")
    if not (provider_kind(tokens and run_field) equals "string") or else not (provider_kind(tokens and call_field) equals "string") or else not (provider_kind(tokens and stream_field) equals "string") or else after is less than 0:
        return "{\"status\":\"invalid-arguments\"}"
    set stream to provider_value(tokens and stream_field)
    if not (stream equals "stdout" or else stream equals "stderr"):
        return "{\"status\":\"invalid-arguments\"}"
    set values to create_list()
    set added to append_list(values and session)
    set added to append_list(values and provider_value(tokens and run_field))
    set added to append_list(values and provider_value(tokens and call_field))
    set owner to history_collect_one(checkpoint_prepare(database and concat("SELECT t.request_event FROM echo_tool_calls t JOIN echo_runs r ON r.run=t.run AND r.session=t.session JOIN echo_session_owners o ON o.session=r.session JOIN echo_devices d ON d.device=o.device WHERE " and concat(principal_session_sql(database and "o.session" and "o.device") and " AND r.session=?1 AND t.run=?2 AND t.call_id=?3 AND d.revoked=0;")) and values))
    if group_run_session_allows(database and provider_value(tokens and run_field) and session) equals 1:
        set owner to history_collect_one(checkpoint_prepare(database and "SELECT t.request_event FROM echo_tool_calls t JOIN echo_runs r ON r.run=t.run AND r.session=t.session WHERE r.session=?1 AND t.run=?2 AND t.call_id=?3;" and values))
    if not (archive_list_text(owner and 0) equals "found"):
        return "{\"status\":\"not-authorized\"}"
    set added to append_list(values and stream)
    set added to append_list(values and int_to_string(after))
    set query to "SELECT event,CAST(sequence AS TEXT),json_extract(payload,'$.offset'),json_extract(payload,'$.bytes'),CAST(json_extract(payload,'$.eof') AS TEXT),digest FROM echo_events WHERE session=?1 AND kind='process_output' AND json_extract(payload,'$.run_id')=?2 AND json_extract(payload,'$.call_id')=?3 AND json_extract(payload,'$.stream')=?4 AND sequence>CAST(?5 AS INTEGER) ORDER BY sequence LIMIT 1;"
    set row to history_collect_one(checkpoint_prepare(database and query and values))
    if archive_list_text(row and 0) equals "end":
        set ended to history_collect_one(checkpoint_prepare(database and "SELECT event FROM echo_events WHERE session=?1 AND kind='process_output' AND json_extract(payload,'$.run_id')=?2 AND json_extract(payload,'$.call_id')=?3 AND json_extract(payload,'$.stream')=?4 AND json_extract(payload,'$.eof')=1 AND sequence<=CAST(?5 AS INTEGER) LIMIT 1;" and values))
        if archive_list_text(ended and 0) equals "found":
            return "{\"status\":\"end\"}"
        if archive_list_text(ended and 0) equals "end":
            return "{\"status\":\"pending-or-incomplete\"}"
        return "{\"status\":\"error\"}"
    set keys to create_list()
    set added to append_list(keys and "event")
    set added to append_list(keys and "sequence")
    set added to append_list(keys and "byte_offset")
    set added to append_list(keys and "bytes")
    set added to append_list(keys and "eof")
    set added to append_list(keys and "digest")
    set output to history_tool_row(row and keys)
    if not (archive_list_text(row and 0) equals "found"):
        return output
    set original to archive_read_event(database and archive_list_text(row and 1))
    set payload to provider_json_tokens(archive_list_text(original and 3))
    set encoded to provider_value(payload and provider_member(payload and 0 and "data"))
    set text to execution_decode_hex(database and encoded)
    set output to concat(substring(output and 0 and string_length(output) - 1) and concat(",\"next_after\":" and archive_list_text(row and 2)))
    set output to concat(output and concat(",\"text\":" and provider_quote(text)))
    if string_length(text) equals 0 and string_length(encoded) > 0:
        set output to concat(output and concat(",\"encoding\":\"binary-or-split-utf8\",\"hex\":" and provider_quote(encoded)))
    else:
        set output to concat(output and ",\"encoding\":\"utf-8\"")
    return concat(output and "}")

# Hex is validated before use as a SQLite blob literal. NUL or incomplete
# Unicode stays explicit binary; original bytes and cursor remain available.
define execution_decode_hex with database as Int and encoded as Str returning Str:
    set size to string_length(encoded)
    set pointer to str_to_ptr(encoded)
    if size modulo 2 is not equal to 0:
        return ""
    set index to 0
    repeat while index < size:
        set high to json_hex_val(peek_byte(pointer and index))
        set low to json_hex_val(peek_byte(pointer and index + 1))
        if high < 0 or else low < 0 or else high * 16 + low equals 0:
            return ""
        set index to index + 2
    set row to history_collect_one(archive_prepare(database and concat("SELECT CAST(X'" and concat(encoded and "' AS TEXT);"))))
    set text to archive_list_text(row and 1)
    if not (archive_list_text(row and 0) equals "found") or else provider_valid_utf8(text) equals 0:
        return ""
    return text

define execution_output_execute with database as Int and session as Str and arguments as Str returning Str:
    if sql_execute(database and "SAVEPOINT echo_output_read;") is not equal to 0:
        return "{\"status\":\"archive-error\"}"
    set result to execution_output_execute_snapshot(database and session and arguments)
    if sql_execute(database and "RELEASE echo_output_read;") is not equal to 0:
        set ignored to sql_execute(database and "ROLLBACK TO echo_output_read;")
        set ignored to sql_execute(database and "RELEASE echo_output_read;")
        return "{\"status\":\"archive-error\"}"
    return result

# Inline bounded output from this exact invocation, joining pipe chunks before
# UTF-8 validation. Original bytes remain archived; incomplete previews expose
# their cursor and never pretend to be the complete output.
define execution_output_preview with database as Int and run as Str and call_id as Str and stream as Str returning Str:
    set values to create_list()
    set added to append_list(values and run)
    set added to append_list(values and call_id)
    set added to append_list(values and stream)
    set query to "SELECT COALESCE(group_concat(part,''),''),COALESCE(MAX(sequence),0) FROM (SELECT sequence,substr(json_extract(payload,'$.data'),1,(8192-CAST(json_extract(payload,'$.offset') AS INTEGER))*2) AS part FROM echo_events WHERE kind='process_output' AND json_extract(payload,'$.run_id')=?1 AND json_extract(payload,'$.call_id')=?2 AND json_extract(payload,'$.stream')=?3 AND CAST(json_extract(payload,'$.offset') AS INTEGER)<8192 ORDER BY sequence);"
    set row to history_collect_one(checkpoint_prepare(database and query and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "{\"status\":\"unavailable\"}"
    set encoded to archive_list_text(row and 1)
    set text to execution_decode_hex(database and encoded)
    set ending_row to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(payload,'$.offset') FROM echo_events WHERE kind='process_output' AND json_extract(payload,'$.run_id')=?1 AND json_extract(payload,'$.call_id')=?2 AND json_extract(payload,'$.stream')=?3 AND json_extract(payload,'$.eof')=1 ORDER BY sequence DESC LIMIT 1;" and values))
    set preview_complete to 0
    if archive_list_text(ending_row and 0) equals "found" and string_to_int(archive_list_text(ending_row and 1)) equals string_length(encoded) / 2:
        set preview_complete to 1
    set result to concat("{\"complete\":" and int_to_string(preview_complete))
    set result to concat(result and concat(",\"bytes\":" and int_to_string(string_length(encoded) / 2)))
    set result to concat(result and concat(",\"text\":" and provider_quote(text)))
    if string_length(text) equals 0 and string_length(encoded) > 0:
        set result to concat(result and concat(",\"encoding\":\"binary-or-split-utf8\",\"hex\":" and provider_quote(encoded)))
    else:
        set result to concat(result and ",\"encoding\":\"utf-8\"")
    # Restart the original cursor if a preview ended inside a capture chunk.
    return concat(result and ",\"continuation_after\":0}")
