define workspace_build_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"workspace_build\",\"description\":\"Build or check a plain-English Ernos source in this session workspace with the installed pinned compiler. mode compile builds its executable; check performs compiler checking; test-harness builds the Ernos test harness but does not run it. Read workspace_output_next for compiler diagnostics: check mode must report Check passed: no errors.; compile and test-harness must report Self-hosted compilation successful!; process exit alone is insufficient. Run produced executables separately with workspace_execute. Existing compiler output files may be replaced. Source basename must contain only letters, digits or underscore before .ep.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"enum\":[\"compile\",\"check\",\"test-harness\"]}},\"required\":[\"path\",\"mode\"],\"additionalProperties\":false}}}"
