import "../workspace/plot_svg"
import "../security/tool_policy"
import "../security/principals"
import "../retained_text"
import "../workspace/sessions"
import "../workspace/read_text"
import "../workspace/directories"
import "../workspace/create_text"
import "../workspace/list_directory"
import "../workspace/search_text"
import "../workspace/edit_text"
import "../workspace/diff_text"
import "../workspace/read_table"
import "../workspace/read_json"
import "../workspace/workbook_read"
import "../workspace/workbook_create"
import "../workspace/workbook_edit"
import "../workspace/list_archive"
import "../workspace/create_archive"
import "os"

# The run supplies the session. Device ownership is resolved from the archive;
# neither ownership nor the host root can be selected by tool arguments.
define workspace_tool_execute with database as Int and session as Str and arguments as Str and operation as Str returning Str:
    return workspace_tool_execute_device(database and "" and session and arguments and operation)

# Explicit device is accepted only from the authenticated dispatcher wrapper.
define workspace_tool_execute_device with database as Int and trusted_device as Str and session as Str and arguments as Str and operation as Str returning Str:
    if not (operation equals "read" or else operation equals "directory" or else operation equals "create" or else operation equals "list" or else operation equals "search" or else operation equals "edit" or else operation equals "diff" or else operation equals "table" or else operation equals "workbook-edit" or else operation equals "workbook-create" or else operation equals "workbook" or else operation equals "json" or else operation equals "archive" or else operation equals "extract" or else operation equals "pack" or else operation equals "plot"):
        return "{\"status\":\"unknown-tool\"}"
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "{\"status\":\"invalid-arguments\"}"
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "path" or else (operation equals "plot" and key equals "plot") or else (operation equals "pack" and (key equals "sources" or else key equals "format")) or else (operation equals "extract" and (key equals "entry" or else key equals "destination" or else key equals "source_sha256")) or else (operation equals "workbook-edit" and (key equals "destination" or else key equals "expected_sha256" or else key equals "replacements")) or else (operation equals "workbook-create" and key equals "sheets") or else (operation equals "workbook" and (key equals "sheet" or else key equals "offset" or else key equals "cells")) or else (operation equals "json" and key equals "segments") or else (operation equals "table" and (key equals "delimiter" or else key equals "offset" or else key equals "rows")) or else (operation equals "diff" and key equals "other_path") or else (operation equals "read" and (key equals "offset" or else key equals "characters")) or else ((operation equals "list" or else operation equals "archive") and (key equals "offset" or else key equals "entries")) or else ((operation equals "create" or else operation equals "edit") and key equals "text") or else (operation equals "edit" and key equals "expected_sha256") or else (operation equals "search" and (key equals "query" or else key equals "offset" or else key equals "matches"))):
            return "{\"status\":\"invalid-arguments\"}"
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set field to provider_member(tokens and 0 and "path")
    set offset to history_tool_integer(tokens and "offset")
    set characters to history_tool_integer(tokens and "characters")
    if not (provider_kind(tokens and field) equals "string") or else (operation equals "read" and (offset is less than 0 or else characters is less than 1)):
        return "{\"status\":\"invalid-arguments\"}"
    set path to provider_value(tokens and field)
    if workspace_path_parts(path) equals 0 and also not (operation equals "list" and path equals "."):
        return "{\"status\":\"invalid-arguments\"}"
    set entries to history_tool_integer(tokens and "entries")
    if (operation equals "list" or else operation equals "archive") and (offset < 0 or else entries < 1):
        return "{\"status\":\"invalid-arguments\"}"
    set text to ""
    if operation equals "create" or else operation equals "edit":
        set text_field to provider_member(tokens and 0 and "text")
        if not (provider_kind(tokens and text_field) equals "string"):
            return "{\"status\":\"invalid-arguments\"}"
        set text to provider_value(tokens and text_field)
    if operation equals "plot":
        set plot_field to provider_member(tokens and 0 and "plot")
        if not (provider_kind(tokens and plot_field) equals "{"):
            return "{\"status\":\"invalid-arguments\"}"
        set plot_after to provider_after(tokens and plot_field)
        set plot_start to get_list(get_list(tokens and plot_field) and 1)
        set plot_finish to get_list(get_list(tokens and plot_after - 1) and 2)
        set plot_library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        if plot_library equals 0:
            return "{\"status\":\"unavailable\"}"
        set rendered to workspace_plot_svg(plot_library and substring(arguments and plot_start and plot_finish - plot_start))
        set closed to ep_dlclose(plot_library)
        if not (archive_list_text(rendered and 0) equals "rendered"):
            return concat("{\"status\":" and concat(provider_quote(archive_list_text(rendered and 0)) and "}"))
        set text to archive_list_text(rendered and 1)
    set query to provider_value(tokens and provider_member(tokens and 0 and "query"))
    set matches to history_tool_integer(tokens and "matches")
    set expected to provider_value(tokens and provider_member(tokens and 0 and "expected_sha256"))
    if operation equals "search" and (not (provider_kind(tokens and provider_member(tokens and 0 and "query")) equals "string") or else string_length(query) equals 0 or else offset < 0 or else matches < 1):
        return "{\"status\":\"invalid-arguments\"}"
    if operation equals "edit" and (not (provider_kind(tokens and provider_member(tokens and 0 and "expected_sha256")) equals "string") or else string_length(expected) is not equal to 64):
        return "{\"status\":\"invalid-arguments\"}"
    set other_path to provider_value(tokens and provider_member(tokens and 0 and "other_path"))
    if operation equals "diff" and (not (provider_kind(tokens and provider_member(tokens and 0 and "other_path")) equals "string") or else workspace_path_parts(other_path) equals 0):
        return "{\"status\":\"invalid-arguments\"}"
    set delimiter to provider_value(tokens and provider_member(tokens and 0 and "delimiter"))
    set rows to history_tool_integer(tokens and "rows")
    if operation equals "table" and (not (provider_kind(tokens and provider_member(tokens and 0 and "delimiter")) equals "string") or else string_length(delimiter) is not equal to 1 or else rows < 1 or else offset < 0):
        return "{\"status\":\"invalid-arguments\"}"
    set sources to create_list()
    set archive_format to provider_value(tokens and provider_member(tokens and 0 and "format"))
    if operation equals "pack":
        set source_items to provider_items(tokens and provider_member(tokens and 0 and "sources"))
        if source_items equals 0 or else length_list(source_items) equals 0 or else not (provider_kind(tokens and provider_member(tokens and 0 and "format")) equals "string"):
            return "{\"status\":\"invalid-arguments\"}"
        for each source in source_items:
            if not (provider_kind(tokens and source) equals "string"):
                return "{\"status\":\"invalid-arguments\"}"
            set added to append_list(sources and provider_value(tokens and source))
    set selected_entry to history_tool_integer(tokens and "entry")
    set destination to provider_value(tokens and provider_member(tokens and 0 and "destination"))
    set source_digest to provider_value(tokens and provider_member(tokens and 0 and "source_sha256"))
    if operation equals "extract" and (selected_entry < 0 or else not (provider_kind(tokens and provider_member(tokens and 0 and "destination")) equals "string") or else workspace_path_parts(destination) equals 0 or else not (provider_kind(tokens and provider_member(tokens and 0 and "source_sha256")) equals "string") or else string_length(source_digest) equals 0):
        return "{\"status\":\"invalid-arguments\"}"
    set workbook_input to ""
    if operation equals "workbook-create" or else operation equals "workbook-edit":
        set selected to provider_member(tokens and 0 and "sheets")
        if operation equals "workbook-edit":
            if not (provider_kind(tokens and provider_member(tokens and 0 and "destination")) equals "string") or else workspace_path_parts(destination) equals 0 or else string_length(expected) is not equal to 64:
                return "{\"status\":\"invalid-arguments\"}"
            set selected to provider_member(tokens and 0 and "replacements")
        if not (provider_kind(tokens and selected) equals "["):
            return "{\"status\":\"invalid-arguments\"}"
        set after to provider_after(tokens and selected)
        set start to get_list(get_list(tokens and selected) and 1)
        set finish to get_list(get_list(tokens and after - 1) and 2)
        set workbook_input to substring(arguments and start and finish - start)
    set sheet to provider_value(tokens and provider_member(tokens and 0 and "sheet"))
    set cells to history_tool_integer(tokens and "cells")
    if operation equals "workbook" and (not (provider_kind(tokens and provider_member(tokens and 0 and "sheet")) equals "string") or else offset < 0 or else cells < 1):
        return "{\"status\":\"invalid-arguments\"}"
    set segments to create_list()
    if operation equals "json":
        set segment_tokens to provider_items(tokens and provider_member(tokens and 0 and "segments"))
        if segment_tokens equals 0:
            return "{\"status\":\"invalid-arguments\"}"
        for each segment in segment_tokens:
            if not (provider_kind(tokens and segment) equals "string"):
                return "{\"status\":\"invalid-arguments\"}"
            set added to append_list(segments and provider_value(tokens and segment))
    set restored to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_attachment_restore_receipt';"))
    if not (archive_list_text(restored and 0) equals "end"):
        return "{\"status\":\"review-required\"}"
    set root_path to get_env("ECHO_WORKSPACE_ROOT")
    if string_length(root_path) equals 0:
        return "{\"status\":\"not-configured\"}"
    set values to create_list()
    set added to append_list(values and session)
    set device to trusted_device
    if string_length(device) equals 0:
        set owner to history_collect_one(checkpoint_prepare(database and concat("SELECT o.device FROM echo_session_owners o JOIN echo_devices d ON d.device=o.device WHERE " and concat(principal_session_sql(database and "o.session" and "o.device") and " AND o.session=?1 AND d.revoked=0;")) and values))
        if not (archive_list_text(owner and 0) equals "found"):
            return "{\"status\":\"not-authorized\"}"
        set device to archive_list_text(owner and 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return "{\"status\":\"unavailable\"}"
    set root to workspace_session_open(database and library and device and session and root_path)
    if root is less than 0:
        set closed to ep_dlclose(library)
        return "{\"status\":\"workspace-unavailable\"}"
    if operation equals "search" or else operation equals "edit" or else operation equals "diff" or else operation equals "table" or else operation equals "json" or else operation equals "archive" or else operation equals "extract" or else operation equals "pack" or else operation equals "workbook" or else operation equals "workbook-create" or else operation equals "workbook-edit":
        set result to ""
        if operation equals "search":
            set result to workspace_search_text(library and root and path and query and offset and matches)
        else if operation equals "pack":
            set result to workspace_create_archive(library and root and sources and path and archive_format)
        else if operation equals "extract":
            set result to workspace_archive_operation(library and root and path and selected_entry and 1 and destination and source_digest)
        else if operation equals "archive":
            set result to workspace_list_archive(library and root and path and offset and entries)
        else if operation equals "workbook-edit":
            set result to workspace_edit_workbook(library and root and path and destination and expected and workbook_input)
        else if operation equals "workbook-create":
            set result to workspace_create_workbook(library and root and path and workbook_input)
        else if operation equals "workbook":
            set result to workspace_read_workbook(library and root and path and sheet and offset and cells)
        else if operation equals "json":
            set result to workspace_read_json(library and root and path and segments)
        else if operation equals "table":
            set result to workspace_read_table(library and root and path and delimiter and offset and rows)
        else if operation equals "diff":
            set result to workspace_diff_text(library and root and path and other_path)
        else:
            set result to workspace_edit_text(library and root and path and expected and text)
        set closed to net_close(root)
        set closed to ep_dlclose(library)
        if workspace_session_allowed(database and device and session) is not equal to 1:
            return "{\"status\":\"authorization-changed\",\"effect\":\"inspect-workspace-before-retrying\"}"
        return result
    if operation equals "list":
        set result to workspace_list_directory(library and root and path and offset and entries)
        set closed to net_close(root)
        set closed to ep_dlclose(library)
        if workspace_session_allowed(database and device and session) is not equal to 1:
            return "{\"status\":\"not-authorized\"}"
        return result
    if operation equals "create" or else operation equals "plot":
        set status to workspace_create_text(library and root and path and text)
        set closed to net_close(root)
        set closed to ep_dlclose(library)
        if workspace_session_allowed(database and device and session) is not equal to 1:
            return "{\"status\":\"authorization-changed\",\"effect\":\"file-may-exist\"}"
        set payload to concat("{\"status\":" and concat(provider_quote(status) and concat(",\"path\":" and provider_quote(path))))
        if status equals "created":
            set payload to concat(payload and concat(",\"sha256\":" and provider_quote(ep_sha256(text))))
            set payload to concat(payload and concat(",\"bytes\":" and provider_quote(int_to_string(string_length(text)))))
        return concat(payload and "}")
    if operation equals "directory":
        set directory to workspace_directory_open(library and root and path and 1)
        set status to "available"
        if directory is less than 0:
            set status to "directory-failed"
        else:
            if net_close(directory) is not equal to 0:
                set status to "close-failed"
        set closed to net_close(root)
        set closed to ep_dlclose(library)
        if workspace_session_allowed(database and device and session) is not equal to 1:
            return "{\"status\":\"authorization-changed\",\"effect\":\"directory-may-exist\"}"
        return concat("{\"status\":" and concat(provider_quote(status) and concat(",\"path\":" and concat(provider_quote(path) and "}"))))
    set read to workspace_read_text(library and root and path and 65536 and offset and characters)
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    if workspace_session_allowed(database and device and session) is not equal to 1:
        return "{\"status\":\"not-authorized\"}"
    if not (archive_list_text(read and 0) equals "read"):
        return concat("{\"status\":" and concat(provider_quote(archive_list_text(read and 0)) and "}"))
    set payload to concat("{\"status\":\"found\",\"path\":" and provider_quote(path))
    set payload to concat(payload and concat(",\"sha256\":" and provider_quote(archive_list_text(read and 3))))
    set payload to concat(payload and concat(",\"bytes\":" and provider_quote(int_to_string(get_list(read and 4)))))
    set payload to concat(payload and concat(",\"offset\":" and provider_quote(int_to_string(offset))))
    set payload to concat(payload and concat(",\"characters\":" and provider_quote(int_to_string(get_list(read and 2)))))
    return concat(payload and concat(",\"text\":" and concat(provider_quote(archive_list_text(read and 1)) and "}")))

define workspace_text_execute with database as Int and session as Str and arguments as Str returning Str:
    return workspace_tool_execute(database and session and arguments and "read")

# Resolve the exact queued arguments and initiating speaker. No model-supplied
# device or session is accepted. Recheck authority before returning file data.
define workspace_tool_execute_owned with database as Int and run as Str and call_id as Str returning Str:
    set values to [run,call_id]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT t.session,a.device,e.payload FROM echo_tool_calls t JOIN echo_tool_authority a ON a.run=t.run AND a.call_id=t.call_id JOIN echo_events e ON e.event=t.request_event AND e.session=t.session WHERE t.run=?1 AND t.call_id=?2 AND t.state='running' AND e.kind='tool_call';" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "{\"status\":\"not-authorized\"}"
    set tokens to provider_json_tokens(archive_list_text(row and 3))
    set name to provider_value(tokens and provider_member(tokens and 0 and "name"))
    set operation to ""
    if name equals "workspace_plot":
        set operation to "plot"
    else if name equals "workspace_edit_workbook":
        set operation to "workbook-edit"
    else if name equals "workspace_create_workbook":
        set operation to "workbook-create"
    else if name equals "workspace_read_workbook":
        set operation to "workbook"
    else if name equals "workspace_archive_create":
        set operation to "pack"
    else if name equals "workspace_archive_extract":
        set operation to "extract"
    else if name equals "workspace_archive_list":
        set operation to "archive"
    else if name equals "workspace_read_json":
        set operation to "json"
    else if name equals "workspace_read_table":
        set operation to "table"
    else if name equals "workspace_diff":
        set operation to "diff"
    else if name equals "workspace_search":
        set operation to "search"
    else if name equals "workspace_edit_text":
        set operation to "edit"
    else if name equals "workspace_list":
        set operation to "list"
    else if name equals "workspace_read_text":
        set operation to "read"
    else if name equals "workspace_create_text":
        set operation to "create"
    else if name equals "workspace_make_directory":
        set operation to "directory"
    if string_length(operation) equals 0 or else tool_policy_allows(database and run and call_id and name) equals 0:
        return "{\"status\":\"not-authorized\"}"
    set result to workspace_tool_execute_device(database and archive_list_text(row and 2) and archive_list_text(row and 1) and provider_value(tokens and provider_member(tokens and 0 and "arguments")) and operation)
    if tool_policy_allows(database and run and call_id and name) equals 0:
        return "{\"status\":\"authorization-changed\",\"effects\":\"operation-may-have-completed\",\"recovery\":\"inspect-retained-workspace-after-authorized-review\"}"
    return result
