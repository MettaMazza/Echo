import "tool_registry"
import "../rights/proposals"
import "../workspace/files"

# A registry document is data, never authorization. Only an independently
# qualified protected-controller operation may publish it to the installed
# root-owned registry. Runtime callers must verify that provenance before use.
define tool_version_fields returning List:
    return ["principal", "session", "manifest_text", "manifest_sha256", "source_path", "artifact_path", "artifact_sha256", "qualification_path", "qualification_sha256", "state"]

define tool_version_entry_valid with tokens as List and entry as Int returning Int:
    if not (provider_kind(tokens and entry) equals "{"):
        return 0
    set fields to tool_version_fields()
    set index to entry + 1
    set count to 0
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        set known to 0
        for each field in fields:
            if key equals ptr_to_str(field):
                set known to 1
        if known equals 0 or else not (provider_kind(tokens and index + 2) equals "string"):
            return 0
        set count to count + 1
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    if count is not equal to length_list(fields):
        return 0
    if string_length(provider_value(tokens and provider_member(tokens and entry and "principal"))) equals 0:
        return 0
    set manifest to provider_value(tokens and provider_member(tokens and entry and "manifest_text"))
    if tool_candidate_manifest_valid(manifest) equals 0 or else not (ep_sha256(manifest) equals provider_value(tokens and provider_member(tokens and entry and "manifest_sha256"))):
        return 0
    for each field in ["artifact_sha256", "qualification_sha256"]:
        if protected_digest_valid(provider_value(tokens and provider_member(tokens and entry and ptr_to_str(field)))) equals 0:
            return 0
    for each field in ["source_path", "artifact_path", "qualification_path"]:
        set path to provider_value(tokens and provider_member(tokens and entry and ptr_to_str(field)))
        if string_length(path) < 2 or else get_character(path and 0) is not equal to 47 or else workspace_path_parts(substring(path and 1 and string_length(path) - 1)) equals 0:
            return 0
    set state to provider_value(tokens and provider_member(tokens and entry and "state"))
    return state equals "dormant" or else state equals "active" or else state equals "quarantined" or else state equals "retired"

define tool_version_same_scope with tokens as List and left as Int and right as Int returning Int:
    for each field in ["principal", "session"]:
        set key to ptr_to_str(field)
        if not (provider_value(tokens and provider_member(tokens and left and key)) equals provider_value(tokens and provider_member(tokens and right and key))):
            return 0
    return 1

define tool_versions_valid with document as Str returning Int:
    set tokens to provider_json_tokens(document)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return 0
    set index to 1
    set count to 0
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "format" or else key equals "revision" or else key equals "entries"):
            return 0
        set count to count + 1
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    if count is not equal to 3 or else not (provider_index(tokens and provider_member(tokens and 0 and "format")) equals "1"):
        return 0
    set revision to provider_index(tokens and provider_member(tokens and 0 and "revision"))
    if string_to_int(revision) < 0 or else not (int_to_string(string_to_int(revision)) equals revision):
        return 0
    set entries to provider_items(tokens and provider_member(tokens and 0 and "entries"))
    if entries equals 0:
        return 0
    set index to 0
    repeat while index < length_list(entries):
        set entry to get_list(entries and index)
        if tool_version_entry_valid(tokens and entry) equals 0:
            return 0
        set manifest to provider_json_tokens(provider_value(tokens and provider_member(tokens and entry and "manifest_text")))
        set name to provider_value(manifest and provider_member(manifest and 0 and "name"))
        set version to provider_index(manifest and provider_member(manifest and 0 and "version"))
        set prior to 0
        repeat while prior < index:
            set other to get_list(entries and prior)
            if tool_version_same_scope(tokens and entry and other) equals 1:
                set previous to provider_json_tokens(provider_value(tokens and provider_member(tokens and other and "manifest_text")))
                if name equals provider_value(previous and provider_member(previous and 0 and "name")):
                    if version equals provider_index(previous and provider_member(previous and 0 and "version")):
                        return 0
                    if provider_value(tokens and provider_member(tokens and entry and "state")) equals "active" and provider_value(tokens and provider_member(tokens and other and "state")) equals "active":
                        return 0
            set prior to prior + 1
        set index to index + 1
    return 1

# Preserve exact candidate text while serializing only the known registry fields.
define tool_version_encode with tokens as List and entry as Int and state as Str returning Str:
    set output to "{"
    for each field in tool_version_fields():
        set key to ptr_to_str(field)
        if string_length(output) > 1:
            set output to concat(output and ",")
        set value to provider_value(tokens and provider_member(tokens and entry and key))
        if key equals "state":
            set value to state
        set output to concat(output and concat(provider_quote(key) and concat(":" and provider_quote(value))))
    return concat(output and "}")

# Pure preparation for protected publication. The expected digest binds the
# whole prior registry; the protected exchange must enforce that preimage again.
# Activating an older accepted version is explicit rollback, not a new build.
define tool_versions_select with document as Str and expected as Str and principal as Str and session as Str and digest as Str and action as Str returning Str:
    if not (ep_sha256(document) equals expected) or else tool_versions_valid(document) equals 0:
        return ""
    if not (action equals "active" or else action equals "dormant" or else action equals "quarantined" or else action equals "retired"):
        return ""
    set tokens to provider_json_tokens(document)
    set revision to string_to_int(provider_index(tokens and provider_member(tokens and 0 and "revision")))
    if revision equals 9223372036854775807:
        return ""
    set entries to provider_items(tokens and provider_member(tokens and 0 and "entries"))
    set chosen to -1
    for each entry in entries:
        if provider_value(tokens and provider_member(tokens and entry and "principal")) equals principal and provider_value(tokens and provider_member(tokens and entry and "session")) equals session and provider_value(tokens and provider_member(tokens and entry and "manifest_sha256")) equals digest:
            set chosen to entry
    if chosen < 0:
        return ""
    set selected_manifest to provider_json_tokens(provider_value(tokens and provider_member(tokens and chosen and "manifest_text")))
    set selected_name to provider_value(selected_manifest and provider_member(selected_manifest and 0 and "name"))
    set output to concat("{\"format\":1,\"revision\":" and concat(int_to_string(revision + 1) and ",\"entries\":["))
    set index to 0
    repeat while index < length_list(entries):
        set entry to get_list(entries and index)
        set state to provider_value(tokens and provider_member(tokens and entry and "state"))
        if entry equals chosen:
            set state to action
        else if action equals "active" and state equals "active" and tool_version_same_scope(tokens and entry and chosen) equals 1:
            set manifest to provider_json_tokens(provider_value(tokens and provider_member(tokens and entry and "manifest_text")))
            if provider_value(manifest and provider_member(manifest and 0 and "name")) equals selected_name:
                set state to "dormant"
        if index > 0:
            set output to concat(output and ",")
        set output to concat(output and tool_version_encode(tokens and entry and state))
        set index to index + 1
    set output to concat(output and "]}")
    if tool_versions_valid(output) equals 0:
        return ""
    return output

# New accepted versions enter the dormant catalog; activation is a separate,
# reviewable selection. A failed insertion leaves the original document intact.
define tool_versions_append with document as Str and expected as Str and entry_text as Str returning Str:
    if not (ep_sha256(document) equals expected) or else tool_versions_valid(document) equals 0:
        return ""
    set entry_tokens to provider_json_tokens(entry_text)
    if entry_tokens equals 0 or else provider_unique_objects(entry_tokens) equals 0 or else tool_version_entry_valid(entry_tokens and 0) equals 0:
        return ""
    set tokens to provider_json_tokens(document)
    set revision to string_to_int(provider_index(tokens and provider_member(tokens and 0 and "revision")))
    if revision equals 9223372036854775807:
        return ""
    set entries to provider_items(tokens and provider_member(tokens and 0 and "entries"))
    set output to concat("{\"format\":1,\"revision\":" and concat(int_to_string(revision + 1) and ",\"entries\":["))
    for each entry in entries:
        set output to concat(output and tool_version_encode(tokens and entry and provider_value(tokens and provider_member(tokens and entry and "state"))))
        set output to concat(output and ",")
    set output to concat(output and tool_version_encode(entry_tokens and 0 and "dormant"))
    set output to concat(output and "]}")
    if tool_versions_valid(output) equals 0:
        return ""
    return output
