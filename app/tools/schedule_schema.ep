define schedule_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"schedule\",\"description\":\"Create, inspect or cancel a durable scoped schedule. create requires the complete instruction, first_due (UTC Unix milliseconds), interval_ms (0 for once), and missed_policy (catch-up runs each missed interval; coalesce runs the latest and records skipped intervals). list starts after=0 and returns next_after; occurrences also requires identity and pages reserved occurrences with run state. inspect/cancel require identity. Cancellation stops future reservations, not already reserved/running work; use job_control for those. Authority remains that of the original run/call.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"create\",\"list\",\"inspect\",\"occurrences\",\"cancel\"]},\"instruction\":{\"type\":\"string\"},\"first_due\":{\"type\":\"integer\",\"minimum\":0},\"interval_ms\":{\"type\":\"integer\",\"minimum\":0},\"missed_policy\":{\"type\":\"string\",\"enum\":[\"catch-up\",\"coalesce\"]},\"identity\":{\"type\":\"string\"},\"after\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
