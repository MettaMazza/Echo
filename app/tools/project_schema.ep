define project_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"project\",\"description\":\"Persistent scoped projects. create requires manifest and returns project/revision IDs. update requires project, expected_revision from read and complete replacement manifest; preserves every earlier revision. read requires project. list requires after=0, then next_after until end; concurrent edits may change pagination, so restart to refresh. select requires project; empty string clears selection for this conversation. Selection supplies current project context on following model requests and future turns. To resume in another conversation, list/read and select the same project. Files reference existing authorized attachments and exact SHA256 values; use attachment tools to read original files. Task status is authored planning state, not verified execution evidence. Private projects cannot be selected in shared conversations.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"create\",\"update\",\"read\",\"list\",\"select\"]},\"project\":{\"type\":\"string\"},\"expected_revision\":{\"type\":\"string\"},\"manifest\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"instructions\":{\"type\":\"string\"},\"tasks\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"todo\",\"doing\",\"done\",\"blocked\"]}},\"required\":[\"id\",\"title\",\"status\"],\"additionalProperties\":false}},\"files\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"attachment\":{\"type\":\"string\"},\"sha256\":{\"type\":\"string\"},\"label\":{\"type\":\"string\"}},\"required\":[\"attachment\",\"sha256\",\"label\"],\"additionalProperties\":false}}},\"required\":[\"name\",\"instructions\",\"tasks\",\"files\"],\"additionalProperties\":false},\"after\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
