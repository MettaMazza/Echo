import "../security/tool_policy"
import "../providers/archived_stream"

# Describes existing implementations; this never grants execution permission.
# Schema versions and contract versions are distinct from binary provenance.
define tool_contract with name as Str and schema as Str returning Str:
    set capability to tool_capability(name)
    set role to capability_role(capability)
    if string_length(capability) equals 0 or else string_length(role) equals 0:
        return ""
    set effects to "Reads authorized data; the invocation and result are still archived."
    set recovery to "Inspect the archived tool result and status; repeat a read only while its scope remains authorized."
    set dependencies to "archive and current run/call authority"
    if capability equals "memory.procedure":
        set effects to "Reads scoped workflow versions or appends immutable proposals with exact execution evidence; never executes a stored workflow."
        set recovery to "Inspect current assessment and source receipts. Revalidate stale contracts before use; past demonstration does not grant current permission."
        set dependencies to "source archive, observed tool ledger, discovery contracts and current audience authority"
    else if capability equals "projects.manage":
        set effects to "Reads scoped projects or appends immutable project revisions/conversation selections; referenced files retain their own access controls."
        set recovery to "Reread the current revision before an update; a stale revision is not overwritten. Retry an uncertain archived request with its original call identity. Selection does not grant access to another audience."
        set dependencies to "archive, frozen run/tool authority, project scope, source attachment records and saved conversation context"
    else if capability equals "network.public-read":
        set effects to "Contacts public HTTP(S) servers without host credentials; saves full response bodies, headers and URL/peer provenance as scoped sources."
        set recovery to "Inspect the transfer receipt, HTTP status and retained sources. Failed or cancelled requests may have reached the remote server; inspect partial originals before retrying."
        set dependencies to "archive, current run/call authority, configured research helper and source storage, public DNS and network"
    else if capability equals "tool.candidate-read":
        set effects to "Reads scoped saved manifests; no code is loaded and no execution permission is granted."
        set recovery to "Inspect the immutable manifest digest and qualification state. A saved candidate must still pass registration and activation before use."
        set dependencies to "candidate registry, current admin authority and frozen conversation audience"
    else if capability equals "jobs.delegate":
        set effects to "Creates an isolated durable child run, sends idempotent mid-turn guidance, or reads progress and complete terminal results. Child execution can use the initiating authority's available tools."
        set recovery to "Inspect the returned child run. Exact archived-call retries retain one child. Use job_control for cancellation; never infer completion or undone effects from a disconnected caller."
        set dependencies to "delegation schema, frozen user/group authority, scheduler and ordinary isolated workers"
    else if capability equals "jobs.schedule":
        set effects to "Creates durable scheduled instructions, reads schedules/occurrences or cancels future reservations. Reserved work remains separately inspectable and cancellable."
        set recovery to "Inspect the schedule identity and occurrence receipts. Exact create retries retain the same definition; inspect job state rather than assuming a reminder ran."
        set dependencies to "schedule archive, frozen initiating authority, due worker and ordinary agent workers"
    else if capability equals "jobs.scoped-control":
        set effects to "Reads scoped run state or durably requests cancellation; requesting cancellation does not undo effects or prove worker completion."
        set recovery to "Inspect the target run and cancellation_requested state until the worker records a terminal event. Cancellation retries retain their original receipt."
        set dependencies to "archive, initiating run/call authority, scoped run queue and cancellation monitor"
    else if capability equals "host.execute":
        set effects to "Executes host processes with the authorized host profile; commands may change files, services or network state."
        set recovery to "Read process reservations, output and exit receipts. Reconcile running or uncertain effects before retry; a failed reply does not prove the command had no effect."
        set dependencies to "archive, frozen admin audience, host execution profile and execution guardian"
    else if capability equals "workspace.execute-isolated":
        set effects to "Executes processes inside the authorized workspace sandbox; files in that workspace may change."
        set recovery to "Read process reservations, output and exit receipts. Reconcile running or uncertain effects before retry; do not infer nonexecution from a missing reply."
        set dependencies to "archive, workspace sandbox, execution profile and execution guardian"
    else if capability equals "workspace.edit":
        set effects to "Replaces file text while retaining the displaced original at a sibling path; optimistic digest checking does not lock external writers."
        set recovery to "Inspect current path, retained sibling and archived status before retrying uncertain edits. Never delete the preserved original automatically."
        set dependencies to "archive, scoped workspace, current authority and atomic file-swap support"
    else if capability equals "workspace.create":
        set effects to "Creates workspace files/directories or registers a scoped attachment, depending on the selected tool."
        set recovery to "Inspect saved paths, attachment identities and archived results before retrying; preserve existing content on conflicts."
        set dependencies to "archive, scoped workspace and attachment storage"
    else if capability equals "memory.private-record":
        set effects to "Writes scoped memory or scratchpad state; visibility changes may alter who can retrieve a record. Scratchpad deletion affects the selected note."
        set recovery to "Read the current scoped record and original result before repeating a write, deletion or visibility change."
        set dependencies to "archive, principal or shared scratchpad scope, and memory schema"
    else if capability equals "session.recap":
        set effects to "Runs model-backed recap work and records derived context while retaining original events."
        set recovery to "Inspect the recap job and retained source evidence; resume or retry according to its recorded status."
        set dependencies to "archive, session scope, recap jobs and configured inference provider"
    else if capability equals "media.local":
        set effects to "Runs the configured local media worker and may save generated media or transcription artifacts."
        set recovery to "Inspect worker status and saved artifact/result identities before retry; preserve original media and report an unavailable worker."
        set dependencies to "archive, scoped attachments/workspace and the configured media model worker"
    else if name equals "protected_change_review":
        set effects to "Records Echo's exact proposal review decision; this grants no human authorization or deployment permission."
        set recovery to "Reread the exact manifest and recorded review revision. Preserve an already recorded decision when recovering an interrupted tool result."
        set dependencies to "archive, frozen admin authority, pinned charter, exact observed inspection and protected proposal"
    else if capability equals "rights.review":
        set dependencies to "archive, frozen admin authority, pinned charter and exact protected proposal"
    else if capability equals "host.read":
        set dependencies to "archive, frozen admin audience and authorized host path"
    if capability equals "workspace.read":
        set dependencies to "archive, current authority, scoped workspace and descriptor-based file access"
    if name equals "workspace_archive_list" or else name equals "workspace_archive_extract" or else name equals "workspace_archive_create":
        set dependencies to "archive, current authority, scoped workspace, macOS libarchive and native file hashing"
        if not (name equals "workspace_archive_list"):
            set recovery to "Inspect archived status, source/output hashes and destination. Existing destinations are preserved; inspect any publication-uncertain destination before retry. An interrupted process can leave a .echo-pending stage."
    if name equals "workspace_read_workbook" or else name equals "workspace_create_workbook" or else name equals "workspace_edit_workbook":
        set dependencies to "archive, current authority, scoped workspace, macOS libarchive, libxml2 and native file hashing"
        if name equals "workspace_read_workbook":
            set effects to "Reads the complete workbook XML parts and returns the selected catalogue/cell page with source digest; formulas are not executed and cached results can be stale."
            set recovery to "Inspect parser/status evidence and source digest; retry only while authorized. Unsupported encoding or package names require an explicit conversion, never silent truncation."
        else if name equals "workspace_create_workbook":
            set effects to "Creates a new XLSX with typed cells and explicitly supplied formula caches; does not calculate formulas or overwrite an existing path."
            set recovery to "Inspect the destination, output hash and archived status before retry. Publication-uncertain requires reading the destination; an interrupted process can leave a .echo-pending stage."
        else:
            set effects to "Creates a new workbook from explicit existing XML-part replacements, preserving the source and unselected entry payloads. Formula dependencies/calculation are the caller's responsibility."
            set recovery to "On source-changed, reread the source before preparing new edits. Existing destinations are preserved. Inspect destination/hash on publication-uncertain. Signed, ambiguous or unsupported packages fail without replacing the source."
    if name equals "host_git":
        set dependencies to "archive, frozen admin audience, host execution profile, execution guardian and /usr/bin/git; remote operations also require their configured transport and authentication"
        set effects to "Runs native Git with separate argv elements. Depending on the subcommand it can modify worktrees, index, refs or remote repositories; hooks and helpers inherit the host sandbox."
        set recovery to "Inspect status, diff, refs, output and exit receipts before retry. Preserve unrelated work; reconcile uncertain commits or pushes against local and remote refs. Never infer rollback from cancellation."
    if name equals "workspace_build":
        set dependencies to "archive, scoped workspace, execution guardian, pinned Ernos compiler and standard library, Apple command-line toolchain"
        set effects to "Checks source or writes compiled program/test-harness artifacts in the workspace. Building a test harness does not run its tests."
        set recovery to "Read compiler output and exit receipts; confirm the requested artifact exists. A built harness needs a separate execution result. Preserve source and earlier artifacts after a failed build."
    if name equals "workspace_database":
        set dependencies to "archive, scoped workspace, execution guardian, workspace_database helper and system SQLite"
        set effects to "Executes SQL statements in a workspace database and records typed results. Explicit committed statements can persist even if a later statement fails or execution is cancelled."
        set recovery to "Read statement and transaction receipts, then inspect database state before retrying writes. An open transaction at script end is rolled back; earlier committed work is not implicitly undone."
    if name equals "workspace_plot":
        set dependencies to "archive, scoped workspace, native finite-number conversion, SVG generation and native file hashing"
        set effects to "Creates a new SVG plot with exact source data in inert metadata; preserves an existing destination and reports the published digest."
        set recovery to "Inspect the saved destination and digest after an uncertain publication. Use attach_file to publish the result into the conversation."
    set body to "{\"contract_version\":1,\"source\":\"builtin\",\"name\":"
    set body to concat(body and provider_quote(name))
    set fields to [["runtime_build_sha256",ptr_to_str(get_env("ECHO_RUNTIME_BUILD_SHA256"))],["schema_sha256",ep_sha256(schema)],["capability",capability],["minimum_role",role],["operation_side_effects",effects],["recovery",recovery],["runtime_dependencies",dependencies],["availability","Advertised for this run; current authority and runtime dependencies are rechecked at invocation."]]
    for each field in fields:
        set body to concat(body and ",")
        set body to concat(body and provider_quote(archive_list_text(field and 0)))
        set body to concat(body and ":")
        set body to concat(body and provider_quote(archive_list_text(field and 1)))
    return concat(body and "}")

# Hash exactly what discovery can return, including effect/recovery contracts.
# Catalog cursors invalidate if either schemas or their contracts change.
define tool_contract_catalog_digest with schemas as Str returning Str:
    set tokens to provider_json_tokens(schemas)
    set items to provider_items(tokens and 0)
    if items equals 0:
        return ""
    set content to schemas
    for each entry in items:
        set function to provider_member(tokens and entry and "function")
        set name to provider_value(tokens and provider_member(tokens and function and "name"))
        set schema to agent_json_source(schemas and tokens and entry)
        set contract to tool_contract(name and schema)
        if string_length(contract) equals 0:
            return ""
        set content to concat(content and contract)
    return ep_sha256(content)
