define candidate_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"tool_candidates\",\"description\":\"Search your scoped saved tool candidates before authoring another tool. These are not qualified, activated or runnable tools. Search name/purpose with query (empty lists all), starting after=0; continue with next_after until end. Inspect returned exact manifest, dependencies, schemas and provenance for potential reuse or composition. This does not load code or grant permission.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"after\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"query\",\"after\"],\"additionalProperties\":false}}}"
