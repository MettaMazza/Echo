define candidate_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"tool_candidates\",\"description\":\"Search your scoped saved tool candidates before authoring another tool. These are not qualified, activated or runnable tools. Search name/purpose with query (empty lists all), starting after=0; continue with next_after until end. Inspect returned exact manifest, dependencies, schemas and provenance for potential reuse or composition. This does not load code or grant permission.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"after\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"query\",\"after\"],\"additionalProperties\":false}}}"

define candidate_save_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"tool_candidate_save\",\"description\":\"Admin: save an immutable Ernos tool candidate after searching loaded tools and dormant candidates and recording why reuse/composition is insufficient. Supply manifest_text as exact JSON text with name, positive version, purpose, source/artifact relative paths and SHA256 hashes, input_schema/output_schema objects, capabilities/dependencies/tests/side_effects/discovery_receipts arrays, failure_policy, gap and composition_decision. Discovery receipts must include observed tool_search and tool_candidates results from this run, plus tool_library when the installed registry is configured. For independent qualification, tests contains JSON case strings with name, input object, exact stdout string and integer exit code; include a successful JSON-output case. The executable receives the input object as one JSON argument. Saving records a candidate only; it does not qualify, register, execute or grant capabilities. Exact retries are idempotent; changed bytes require a new version.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"manifest_text\":{\"type\":\"string\"}},\"required\":[\"manifest_text\"],\"additionalProperties\":false}}}"
