import "attachment_text"
import "../network/public_url"

# Resolve a link from a digest-verified document in this conversation's normal
# attachment scope. The chosen URL is still revalidated by the fetch worker.
define web_navigation_resolve with database as Int and session as Str and attachment as Str and selected as Int returning List:
    if selected < 0:
        return ["invalid-link-index"]
    set arguments to concat("{\"attachment\":" and concat(provider_quote(attachment) and ",\"offset\":0,\"characters\":9223372036854775807}"))
    set read to provider_json_tokens(attachment_text_execute(database and session and arguments))
    if not (provider_value(read and provider_member(read and 0 and "status")) equals "found"):
        return ["source-unavailable"]
    set document to provider_json_tokens(provider_value(read and provider_member(read and 0 and "text")))
    if document equals 0 or else provider_unique_objects(document) equals 0 or else not (provider_value(document and provider_member(document and 0 and "representation")) equals "libxml2-static-html" or else provider_value(document and provider_member(document and 0 and "representation")) equals "brave-search-api"):
        return ["invalid-document"]
    set links to provider_member(document and 0 and "links")
    if not (provider_kind(document and links) equals "["):
        return ["invalid-document"]
    set cursor to links + 1
    set index to 0
    repeat while provider_kind(document and cursor) equals "{":
        if index equals selected:
            set target to provider_member(document and cursor and "url")
            if not (provider_kind(document and target) equals "string"):
                return ["invalid-document"]
            set url to provider_value(document and target)
            if not (archive_list_text(network_url_parse(url and "") and 0) equals "parsed"):
                return ["unsupported-link"]
            return ["found",url,provider_value(read and provider_member(read and 0 and "event")),provider_value(read and provider_member(read and 0 and "sha256"))]
        set index to index + 1
        set cursor to provider_after(document and cursor)
        if provider_kind(document and cursor) equals ",":
            set cursor to cursor + 1
    return ["link-not-found"]
