define job_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"job_control\",\"description\":\"Inspect your scoped run queue and request cancellation. list pages one run using after=0 then next_after until end; inspect and cancel require run. A cancellation request is not completion: inspect until the worker records a terminal state. Results identify original objective and last evidence events; read them with scoped history tools. Shared conversations can inspect that conversation and their direct delegated tasks; control remains with its initiating user.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"list\",\"inspect\",\"cancel\"]},\"after\":{\"type\":\"integer\",\"minimum\":0},\"run\":{\"type\":\"string\"}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
