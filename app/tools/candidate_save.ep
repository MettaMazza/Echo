import "tool_registry"

# Dispatch owns the call identity; persistence independently rechecks the run's
# authority under its writer lock. No model-supplied principal or approval.
define candidate_save_execute with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    if tool_policy_allows(database and run and call_id and "tool_candidate_save") equals 0:
        return "{\"status\":\"not-authorized\"}"
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "{\"status\":\"invalid-arguments\"}"
    set field to provider_member(tokens and 0 and "manifest_text")
    if not (provider_kind(tokens and field) equals "string") or else not (provider_value(tokens and 1) equals "manifest_text") or else not (provider_kind(tokens and provider_after(tokens and field)) equals "}"):
        return "{\"status\":\"invalid-arguments\"}"
    set manifest to provider_value(tokens and field)
    set outcome to tool_candidate_save(database and run and manifest)
    set result to concat("{\"status\":" and provider_quote(outcome))
    if outcome equals "candidate-saved-not-activated" or else outcome equals "candidate-already-saved-not-activated":
        set result to concat(result and concat(",\"digest\":" and provider_quote(ep_sha256(manifest))))
        set result to concat(result and ",\"runnable\":false")
    return concat(result and "}")
