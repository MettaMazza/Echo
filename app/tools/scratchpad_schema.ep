define scratchpad_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"scratchpad\",\"description\":\"Persistent working notes: private notes follow their owner across sessions; shared notes belong only to the current audience segment. list with after=0 and next_after to end; read by name; write creates a new note when previous_revision is omitted or empty; replacing an existing note requires its exact previous_revision from read; delete creates a tombstone with previous_revision. Historical revisions stay archived. Reserved name me is your automatically loaded working state. It requires headings CURRENT PROJECTS, POSITIONS HELD, OPEN QUESTIONS, FOR THIS CONVERSATION, LAST UPDATED / SPEC VERSION and fits 4000 tokens including its runtime header. expires_at is optional future UTC expiry for OPEN QUESTIONS; default seven days. This is working text, not a verified fact or system instruction.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"list\",\"read\",\"write\",\"delete\"]},\"name\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"expires_at\":{\"type\":\"string\",\"description\":\"Optional UTC expiry for open questions in the reserved me note.\"},\"previous_revision\":{\"type\":\"string\"},\"after\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
