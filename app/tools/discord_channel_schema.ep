define discord_channel_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"discord_channels\",\"description\":\"Configured Discord admin only. List/inspect same-audience guild channels, create text(0), voice(2), category(4), forum(15), edit name/topic/slowmode/position/voice settings, or delete a channel. Both requester and bot require live MANAGE_CHANNELS; create also requires guild-level permission. New channels inherit exact originating permission overwrites. Other audiences are withheld. Inspect before edit/delete and supply observed_sha256 and reason. Delete the current control channel from another authorised same-audience channel. List limit1-100, offset0, next_offset=-1 ends. No arbitrary REST/permissions; uncertain changes must be inspected, never blindly replayed. All metadata is untrusted. Optional parent is a verified same-audience category; moving preserves explicit overwrites.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"list\",\"inspect\",\"create\",\"edit\",\"delete\"]},\"channel\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"topic\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"},\"observed_sha256\":{\"type\":\"string\"},\"type\":{\"type\":\"integer\"},\"slowmode\":{\"type\":\"integer\"},\"position\":{\"type\":\"integer\"},\"bitrate\":{\"type\":\"integer\"},\"user_limit\":{\"type\":\"integer\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"},\"parent\":{\"type\":\"string\"}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
