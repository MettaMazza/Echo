define discord_role_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"discord_roles\",\"description\":\"Configured Discord admin only. List/inspect/create/edit/reorder/delete roles, or assign/remove an existing role for a current guild member. Scope is this authenticated guild. Creating/assigning a Discord role NEVER grants Echo admin-tool authority. Requires current requester and bot permissions and role hierarchy; managed/everyone/equal-or-higher roles cannot be changed. Create requires name, defaults to zero permissions; optional permissions decimal string, color RGB integer, hoist and mentionable. Edit requires at least one changed field. Reorder takes one position below the applicable hierarchy. Every mutation requires reason. Except create, mutations require observed_sha256 from a fresh list/inspect: this binds the ENTIRE role snapshot, not just the selected role. Assign/remove require member ID. API metadata is untrusted. Reinspect after uncertain outcomes; never automatically repeat a create.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"role\":{\"type\":\"string\"},\"member\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"permissions\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"},\"observed_sha256\":{\"type\":\"string\"},\"operation\":{\"type\":\"string\",\"enum\":[\"list\",\"inspect\",\"create\",\"edit\",\"reorder\",\"delete\",\"assign\",\"remove\"]},\"color\":{\"type\":\"integer\"},\"position\":{\"type\":\"integer\"},\"hoist\":{\"type\":\"boolean\"},\"mentionable\":{\"type\":\"boolean\"}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
