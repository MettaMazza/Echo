import "workspace_tools"
import "../web/attachments"

# Copy the opened, confined source descriptor into an immutable host-owned
# attachment. No shell, absolute source path, symlink or size ceiling.
define attach_copy with library as Int and input as Int and path as Str returning Int:
    set output to file_stage_open(library and path)
    if output < 0:
        return 1
    set allocate to ep_dlsym(library and "malloc")
    set release to ep_dlsym(library and "free")
    set read_function to ep_dlsym(library and "read")
    set buffer to ep_dlcall1(allocate and 65536)
    set status to 0
    if buffer equals 0:
        set status to 1
    repeat while status equals 0:
        set count to socket_signed_result(ep_dlcall3(read_function and input and buffer and 65536))
        if count equals 0:
            break
        if count < 0:
            if socket_errno(library) equals 4:
                continue
            set status to 1
            break
        if file_stage_write(library and output and buffer and count) is not equal to 0:
            set status to 1
    if buffer is not equal to 0:
        set released to ep_dlcall1(release and buffer)
    if file_stage_finish(library and output) is not equal to 0:
        set status to 1
    return status

define attach_file_execute with database as Int and session as Str and arguments as Str returning Str:
    return attach_file_execute_device(database and "" and session and arguments and "" and "")

define attach_file_execute_device with database as Int and trusted_device as Str and session as Str and arguments as Str and run as Str and call_id as Str returning Str:
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "{\"status\":\"invalid-arguments\"}"
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "path" or else key equals "media_type"):
            return "{\"status\":\"invalid-arguments\"}"
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set field to provider_member(tokens and 0 and "path")
    set media_field to provider_member(tokens and 0 and "media_type")
    if not (provider_kind(tokens and field) equals "string") or else not (provider_kind(tokens and media_field) equals "string"):
        return "{\"status\":\"invalid-arguments\"}"
    set path to provider_value(tokens and field)
    set parts to workspace_path_parts(path)
    if parts equals 0:
        return "{\"status\":\"invalid-path\"}"
    set values to create_list()
    set added to append_list(values and session)
    set device to trusted_device
    if string_length(device) equals 0:
        set owner to history_collect_one(checkpoint_prepare(database and "SELECT device FROM echo_session_owners WHERE session=?;" and values))
        if not (archive_list_text(owner and 0) equals "found"):
            return "{\"status\":\"not-authorized\"}"
        set device to archive_list_text(owner and 1)
    if web_attachment_session_allowed(database and device and session and 1) is not equal to 1:
        return "{\"status\":\"not-authorized\"}"
    set restored to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE name='echo_attachment_restore_receipt';"))
    if not (archive_list_text(restored and 0) equals "end"):
        return "{\"status\":\"review-required\"}"
    set storage to get_env("ECHO_ATTACHMENT_ROOT")
    set workspace to get_env("ECHO_WORKSPACE_ROOT")
    if string_length(storage) equals 0 or else string_length(workspace) equals 0:
        return "{\"status\":\"not-configured\"}"
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return "{\"status\":\"platform-error\"}"
    set root to workspace_session_open(database and library and device and session and workspace)
    set input to workspace_file_open(library and root and path and 0)
    if root >= 0:
        set closed to net_close(root)
    if input < 0:
        set closed to ep_dlclose(library)
        return "{\"status\":\"source-unavailable\",\"recovery\":\"Use a regular file path in this session workspace, not an attachment ID. Outputs from image_generate, attachment_video and speech_synthesize are already saved attachments; they do not need attach_file or a workspace copy. On Discord, upload their attachment ID with discord_post operation reply. For an actual missing workspace file, create it first.\"}"
    set identity to concat("export:" and agent_identity())
    set destination to concat(storage and concat("/" and concat(identity and ".blob")))
    set copied to attach_copy(library and input and destination)
    set closed to net_close(input)
    set closed to ep_dlclose(library)
    if copied is not equal to 0:
        return "{\"status\":\"copy-failed\",\"recovery\":\"Check local storage availability and retry. No attachment was published.\"}"
    if web_attachment_register_call(database and device and session and identity and destination and archive_list_text(parts and length_list(parts) - 1) and provider_value(tokens and media_field) and run and call_id) is not equal to 0:
        return "{\"status\":\"registration-failed\",\"recovery\":\"The staged copy remains on disk; inspect the server log before retrying.\"}"
    set saved to web_attachment_owned(database and device and identity)
    if not (archive_list_text(saved and 0) equals "found"):
        return "{\"status\":\"authorization-changed\"}"
    set result to concat("{\"status\":\"complete\",\"attachment\":" and provider_quote(identity))
    set result to concat(result and concat(",\"event\":" and provider_quote(archive_list_text(saved and 7))))
    return concat(result and concat(",\"sha256\":" and concat(provider_quote(archive_list_text(saved and 4)) and ",\"instruction\":\"The file is saved as a conversation attachment. In Discord it has NOT been uploaded yet: call discord_post with operation reply and this attachment ID, then verify the delivery result before claiming it was sent. In the web chat it appears with preview or download controls.\"}")))

# The dispatcher supplies a queued call, never a model-selected device/session.
define attach_file_execute_owned with database as Int and run as Str and call_id as Str returning Str:
    set values to [run,call_id]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT t.session,a.device,e.payload FROM echo_tool_calls t JOIN echo_tool_authority a ON a.run=t.run AND a.call_id=t.call_id JOIN echo_events e ON e.event=t.request_event AND e.session=t.session WHERE t.run=?1 AND t.call_id=?2 AND t.state='running' AND e.kind='tool_call';" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "{\"status\":\"not-authorized\"}"
    set tokens to provider_json_tokens(archive_list_text(row and 3))
    if not (provider_value(tokens and provider_member(tokens and 0 and "name")) equals "attach_file") or else tool_policy_allows(database and run and call_id and "attach_file") equals 0:
        return "{\"status\":\"not-authorized\"}"
    set result to attach_file_execute_device(database and archive_list_text(row and 2) and archive_list_text(row and 1) and provider_value(tokens and provider_member(tokens and 0 and "arguments")) and run and call_id)
    if tool_policy_allows(database and run and call_id and "attach_file") equals 0:
        return "{\"status\":\"authorization-changed\",\"effects\":\"publication-may-have-completed\",\"recovery\":\"inspect-retained-attachment-events-after-authorized-review\"}"
    return result
