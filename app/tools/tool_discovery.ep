import "../memory/procedures"
import "tool_contract"
import "../context/session_messages"

# Discovery observes the same authority-filtered schemas used for inference.
# A cursor is bound to the exact catalog; changed permissions never silently
# splice pages from two different tool sets. Dispatch still rechecks each call.
define tool_discovery_snapshot with database as Int and run as Str and arguments as Str returning Str:
    if agent_run_read(database and run) equals 0 or else run_authority_allows(database and run and "user") equals 0:
        return "{\"status\":\"not-authorized\"}"
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "{\"status\":\"invalid-arguments\"}"
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "query" or else key equals "after" or else key equals "catalog_digest"):
            return "{\"status\":\"invalid-arguments\"}"
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set query_field to provider_member(tokens and 0 and "query")
    set digest_field to provider_member(tokens and 0 and "catalog_digest")
    set after to history_tool_integer(tokens and "after")
    if not (provider_kind(tokens and query_field) equals "string") or else not (provider_kind(tokens and digest_field) equals "string") or else after < 0:
        return "{\"status\":\"invalid-arguments\"}"
    set schemas to session_tool_schemas_owned(database and run)
    set digest to tool_contract_catalog_digest(schemas)
    if string_length(digest) equals 0:
        return "{\"status\":\"catalog-unavailable\"}"
    set requested_digest to provider_value(tokens and digest_field)
    if (after > 0 or else string_length(requested_digest) > 0) and not (requested_digest equals digest):
        return "{\"status\":\"catalog-changed\",\"recovery\":\"Restart discovery at after=0 with an empty catalog_digest.\"}"
    set catalog to provider_json_tokens(schemas)
    set items to provider_items(catalog and 0)
    if items equals 0:
        return "{\"status\":\"catalog-unavailable\"}"
    set query to ptr_to_str(string_to_lower(provider_value(tokens and query_field)))
    # An exact available tool name is a lookup, not a description search.
    # Scan only the authority-filtered catalog and keep catalog offsets stable.
    set exact_index to -1
    set scan to 0
    repeat while scan < length_list(items):
        set entry to get_list(items and scan)
        set function to provider_member(catalog and entry and "function")
        set candidate_name to provider_value(catalog and provider_member(catalog and function and "name"))
        set lower_name to ptr_to_str(string_to_lower(candidate_name))
        if lower_name equals query:
            set exact_index to scan
            break
        set scan to scan + 1
    set index to after
    repeat while index < length_list(items):
        set entry to get_list(items and index)
        set function to provider_member(catalog and entry and "function")
        set name to provider_value(catalog and provider_member(catalog and function and "name"))
        set description to provider_value(catalog and provider_member(catalog and function and "description"))
        set searchable to concat(name and concat(" " and description))
        set lower_searchable to ptr_to_str(string_to_lower(searchable))
        if (exact_index >= 0 and index equals exact_index) or else (exact_index < 0 and (string_length(query) equals 0 or else string_contains(lower_searchable and query) equals 1)):
            set schema to agent_json_source(schemas and catalog and entry)
            set output to concat("{\"status\":\"found\",\"catalog\":\"loaded-builtins\",\"catalog_digest\":" and provider_quote(digest))
            set output to concat(output and concat(",\"next_after\":" and int_to_string(index + 1)))
            set output to concat(output and concat(",\"capability\":" and provider_quote(tool_capability(name))))
            set output to concat(output and concat(",\"schema_digest\":" and provider_quote(ep_sha256(schema))))
            set contract to tool_contract(name and schema)
            set output to concat(output and concat(",\"contract_sha256\":" and provider_quote(ep_sha256(contract))))
            set output to concat(output and ",\"contract\":")
            set output to concat(output and contract)
            set output to concat(output and concat(",\"saved_procedures\":" and procedure_search(database and run and provider_value(tokens and query_field) and 0 and schemas)))
            return concat(output and concat(",\"schema\":" and concat(schema and "}")))
        set index to index + 1
    set output to concat("{\"status\":\"end\",\"catalog\":\"loaded-builtins\",\"catalog_digest\":" and provider_quote(digest))
    return concat(output and concat(",\"saved_procedures\":" and concat(procedure_search(database and run and provider_value(tokens and query_field) and 0 and schemas) and "}")))

define tool_discovery_execute with database as Int and run as Str and arguments as Str returning Str:
    if sql_execute(database and "BEGIN;") is not equal to 0:
        return "{\"status\":\"database-busy\"}"
    set result to tool_discovery_snapshot(database and run and arguments)
    if sql_execute(database and "COMMIT;") is not equal to 0:
        set ignored to sql_execute(database and "ROLLBACK;")
        return "{\"status\":\"database-error\"}"
    set fields to provider_json_tokens(result)
    set digest to provider_value(fields and provider_member(fields and 0 and "catalog_digest"))
    if string_length(digest) > 0:
        if run_authority_allows(database and run and "user") equals 0 or else not (tool_contract_catalog_digest(session_tool_schemas_owned(database and run)) equals digest):
            return "{\"status\":\"authorization-changed\"}"
    return result
