define discord_post_schema_text returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"discord_post\",\"description\":\"Create an explicit reply to the current request with text, text embeds or a native poll; inspect/edit/delete your tool post for this requester in this channel. At least one payload is required for reply. Embeds have a combined 6000 UTF-16 unit limit; text has 2000. Live requester and bot permissions are checked, including EMBED_LINKS and SEND_POLLS. Poll duration defaults to 24 hours; polls cannot be edited. Rich content is reply-only. Status reads the actual owned message, embeds and poll results. Edit changes text only. Allowed mentions are disabled. Retains original delivery records and returns a post ID. Retry dispatches only a known pending post after fresh checks. After uncertain delivery inspect status; never create a replacement blindly. Does not edit ordinary replies, activity/status messages or other users posts. Ordinary conversation still uses the normal reply channel.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"reply\",\"status\",\"retry\",\"edit\",\"delete\"]},\"post\":{\"type\":\"string\"},\"text\":{\"type\":\"string\",\"maxLength\":2000},\"embeds\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":10,\"items\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\",\"maxLength\":256},\"description\":{\"type\":\"string\",\"maxLength\":4096},\"color\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777215},\"fields\":{\"type\":\"array\",\"maxItems\":25,\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"maxLength\":256},\"value\":{\"type\":\"string\",\"maxLength\":1024},\"inline\":{\"type\":\"boolean\"}},\"required\":[\"name\",\"value\"],\"additionalProperties\":false}},\"footer\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"maxLength\":2048}},\"required\":[\"text\"],\"additionalProperties\":false}},\"required\":[],\"additionalProperties\":false}},\"poll\":{\"type\":\"object\",\"properties\":{\"question\":{\"type\":\"string\",\"maxLength\":300},\"answers\":{\"type\":\"array\",\"minItems\":2,\"maxItems\":10,\"items\":{\"type\":\"string\",\"maxLength\":55}},\"duration_hours\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":768},\"multiselect\":{\"type\":\"boolean\"}},\"required\":[\"question\",\"answers\"],\"additionalProperties\":false}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
