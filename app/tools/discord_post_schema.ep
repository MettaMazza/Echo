define discord_post_schema_text returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"discord_post\",\"description\":\"Create an explicit text reply to the current request, or inspect/edit/delete a post created by this tool for this requester in this channel. Retains original delivery records and returns a post ID for follow-up. Does not edit ordinary final replies, activity/status messages or other users posts. Text supports up to 2000 UTF-16 units per Discord post. Allowed mentions are disabled. Retry only dispatches a known pending post. After uncertain delivery inspect status; do not create a replacement blindly. Ordinary conversation replies still use the normal reply channel.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\",\"enum\":[\"reply\",\"status\",\"retry\",\"edit\",\"delete\"]},\"post\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"operation\"],\"additionalProperties\":false}}}"
