import "public_address"

# Installed curl URL API owns parsing, relative redirects and numeric aliases.
define network_url_part with library as Int and url as Int and part as Int and flags as Int returning List:
    set value to [0]
    set status to ep_dlcall4(ep_dlsym(library and "curl_url_get") and url and part and get_list_data_ptr(value) and flags)
    if status is not equal to 0:
        return ["missing",""]
    set text to concat(ptr_to_str(get_list(value and 0)) and "")
    set freed to ep_dlcall1(ep_dlsym(library and "curl_free") and get_list(value and 0))
    return ["found",text]

define network_url_parts with library as Int and url as Int returning List:
    set scheme_part to network_url_part(library and url and 1 and 0)
    set scheme to ptr_to_str(string_to_lower(archive_list_text(scheme_part and 1)))
    if not (scheme equals "http" or else scheme equals "https"):
        return ["unsupported-scheme"]
    for each part in [2,3,4,10]:
        set value to network_url_part(library and url and part and 0)
        if archive_list_text(value and 0) equals "found":
            return ["credentials-or-zone-not-allowed"]
    set host_part to network_url_part(library and url and 5 and 0)
    set port_part to network_url_part(library and url and 6 and 1)
    set host to archive_list_text(host_part and 1)
    set port to archive_list_text(port_part and 1)
    if string_length(host) equals 0 or else string_to_int(port) <= 0:
        return ["invalid-host-or-port"]
    if get_character(host and 0) equals 91:
        set host to ptr_to_str(substring(host and 1 and string_length(host) - 2))
    set removed to ep_dlcall4(ep_dlsym(library and "curl_url_set") and url and 9 and 0 and 0)
    if removed is not equal to 0:
        return ["url-normalization-failed"]
    set normalized to network_url_part(library and url and 0 and 0)
    if not (archive_list_text(normalized and 0) equals "found"):
        return ["url-normalization-failed"]
    return ["parsed",archive_list_text(normalized and 1),host,port,scheme]

define network_url_parse with text as Str and base as Str returning List:
    if string_length(text) equals 0:
        return ["empty-url"]
    set index to 0
    repeat while index < string_length(text):
        set byte to peek_byte(str_to_ptr(text) and index)
        if byte <= 32 or else byte equals 127:
            return ["invalid-url-character"]
        set index to index + 1
    set library to ep_dlopen("/usr/lib/libcurl.4.dylib")
    if library equals 0:
        return ["url-parser-unavailable"]
    set url to ep_dlcall0(ep_dlsym(library and "curl_url"))
    if url equals 0:
        set closed to ep_dlclose(library)
        return ["url-parser-unavailable"]
    set status to 0
    if string_length(base) > 0:
        set status to ep_dlcall4(ep_dlsym(library and "curl_url_set") and url and 0 and str_to_ptr(base) and 32)
    if status equals 0:
        set status to ep_dlcall4(ep_dlsym(library and "curl_url_set") and url and 0 and str_to_ptr(text) and 32)
    set result to ["invalid-url"]
    if status equals 0:
        set result to network_url_parts(library and url)
    set cleaned to ep_dlcall1(ep_dlsym(library and "curl_url_cleanup") and url)
    set closed to ep_dlclose(library)
    return result
