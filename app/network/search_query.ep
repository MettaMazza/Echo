import "public_url"

# Encode the original UTF-8 bytes, preserving punctuation and non-ASCII input.
# No credentials, provider-imposed count override or hidden query rewriting.
define network_query_encode with query as Str returning Str:
    set builder to create_builder()
    set index to 0
    repeat while index < string_length(query):
        set byte to peek_byte(str_to_ptr(query) and index)
        if (byte >= 48 and byte <= 57) or else (byte >= 65 and byte <= 90) or else (byte >= 97 and byte <= 122) or else byte equals 45 or else byte equals 46 or else byte equals 95 or else byte equals 126:
            set added to builder_append(builder and ptr_to_str(substring(query and index and 1)))
        else:
            set added to builder_append(builder and "%")
            set added to builder_append(builder and ptr_to_str(substring("0123456789ABCDEF" and byte / 16 and 1)))
            set added to builder_append(builder and ptr_to_str(substring("0123456789ABCDEF" and byte modulo 16 and 1)))
        set index to index + 1
    return ptr_to_str(builder_to_string(builder))

define network_search_url with query as Str returning Str:
    return concat("https://html.duckduckgo.com/html/?q=" and network_query_encode(query))
