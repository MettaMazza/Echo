import "public_url"

# Encode the original UTF-8 bytes, preserving punctuation and non-ASCII input.
# No credentials, provider-imposed count override or hidden query rewriting.
define network_query_encode with query as Str returning Str:
    set builder to create_builder()
    set index to 0
    repeat while index < string_length(query):
        set byte to peek_byte(str_to_ptr(query) and index)
        if (byte >= 48 and byte <= 57) or else (byte >= 65 and byte <= 90) or else (byte >= 97 and byte <= 122) or else byte equals 45 or else byte equals 46 or else byte equals 95 or else byte equals 126:
            set added to builder_append(builder and ptr_to_str(substring(query and index and 1)))
        else:
            set added to builder_append(builder and "%")
            set added to builder_append(builder and ptr_to_str(substring("0123456789ABCDEF" and byte / 16 and 1)))
            set added to builder_append(builder and ptr_to_str(substring("0123456789ABCDEF" and byte modulo 16 and 1)))
        set index to index + 1
    return ptr_to_str(builder_to_string(builder))

define network_search_url with query as Str returning Str:
    return concat("https://html.duckduckgo.com/html/?q=" and network_query_encode(query))

# A credential is confined to the fixed HTTPS API endpoint, never redirects.
define network_brave_endpoint with url as Str returning Int:
    return string_index_of(url and "https://api.search.brave.com/res/v1/web/search?q=") equals 0

define network_brave_url with query as Str returning Str:
    return concat("https://api.search.brave.com/res/v1/web/search?q=" and network_query_encode(query))

# Preserve the API response separately; this deterministic view exposes every
# returned result and its source URL directly, without a second model/tool turn.
define network_brave_document with text as Str returning Str:
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "{\"status\":\"parse-failed\"}"
    set web to provider_member(tokens and 0 and "web")
    set results to provider_member(tokens and web and "results")
    set count to 0
    set content to create_builder()
    set links to "["
    if provider_kind(tokens and results) equals "[":
        set cursor to results + 1
        repeat while not (provider_kind(tokens and cursor) equals "]"):
            set title to provider_value(tokens and provider_member(tokens and cursor and "title"))
            set url to provider_value(tokens and provider_member(tokens and cursor and "url"))
            set description to provider_value(tokens and provider_member(tokens and cursor and "description"))
            if count > 0:
                set links to concat(links and ",")
            set links to concat(links and concat("{\"index\":" and int_to_string(count)))
            set links to concat(links and concat(",\"text\":" and provider_quote(title)))
            set links to concat(links and concat(",\"url\":" and concat(provider_quote(url) and "}")))
            set added to builder_append(content and concat(concat("[" and concat(int_to_string(count) and concat("] " and title))) and concat("\n" and concat(url and concat("\n" and concat(description and "\n\n"))))))
            set count to count + 1
            set cursor to provider_after(tokens and cursor)
            if provider_kind(tokens and cursor) equals ",":
                set cursor to cursor + 1
    set result to concat("{\"status\":\"extracted\",\"representation\":\"brave-search-api\",\"title\":\"Brave Search results\",\"search_result_count\":" and provider_quote(int_to_string(count)))
    set result to concat(result and concat(",\"text\":" and provider_quote(ptr_to_str(builder_to_string(content)))))
    return concat(result and concat(",\"links\":" and concat(links and "]}")))
