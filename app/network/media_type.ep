import "../retained_text"
import "string"

# Retain the server's declared MIME type, without parameters or control bytes.
# This is metadata, not validation of the body or permission to execute it.
define network_media_type with declared as Str returning Str:
    set parts to create_list()
    set split_count to retained_text_split(parts and declared and ";")
    if length_list(parts) equals 0:
        return "application/octet-stream"
    set media to ptr_to_str(string_to_lower(string_trim(archive_list_text(parts and 0))))
    set slash to -1
    set index to 0
    repeat while index < string_length(media):
        set byte to get_character(media and index)
        if byte equals 47:
            if slash >= 0:
                return "application/octet-stream"
            set slash to index
        else if not ((byte >= 97 and byte <= 122) or else (byte >= 48 and byte <= 57) or else byte equals 33 or else byte equals 35 or else byte equals 36 or else byte equals 38 or else byte equals 94 or else byte equals 95 or else byte equals 46 or else byte equals 43 or else byte equals 45):
            return "application/octet-stream"
        set index to index + 1
    if slash <= 0 or else slash >= string_length(media) - 1:
        return "application/octet-stream"
    return media
