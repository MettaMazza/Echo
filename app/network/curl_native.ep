import "public_url"
import "../workspace/files"
import "../providers/archived_stream"

# Installed Darwin arm64 libcurl variadic ABI: CURL pointer, option int, value.
# The value is either a pointer or native long. No shell or curl configuration.
define network_curl_call with library as Int and name as Str and easy as Int and option as Int and value as Int and pointer as Int returning Int:
    set ffi to research_ffi_open()
    if ffi equals 0:
        return -1
    set integer to research_ffi_type(ffi and "sint32")
    set address to research_ffi_type(ffi and "pointer")
    set value_type to research_ffi_type(ffi and "sint64")
    if pointer equals 1:
        set value_type to address
    set types to [address,integer,value_type]
    set values to [easy,option,value]
    set pointers to create_list()
    set index to 0
    repeat while index < 3:
        set added to append_list(pointers and get_list_data_ptr(values) + index * 8)
        set index to index + 1
    set interface to research_native_words(5)
    set result to [0]
    set prepare to ep_dlsym(ffi and "ffi_prep_cif_var")
    set function to ep_dlsym(library and name)
    set status to -1
    if prepare is not equal to 0 and function is not equal to 0:
        if ep_dlcall6(prepare and get_list_data_ptr(interface) and 1 and 2 and 3 and integer and get_list_data_ptr(types)) equals 0:
            set called to ep_dlcall4(ep_dlsym(ffi and "ffi_call") and get_list_data_ptr(interface) and function and get_list_data_ptr(result) and get_list_data_ptr(pointers))
            set status to get_list(result and 0)
    set closed to ep_dlclose(ffi)
    return status

define network_curl_info with library as Int and easy as Int and option as Int returning Str:
    set value to [0]
    if network_curl_call(library and "curl_easy_getinfo" and easy and option and get_list_data_ptr(value) and 1) is not equal to 0:
        return ""
    if option equals 2097154:
        return int_to_string(get_list(value and 0))
    if get_list(value and 0) equals 0:
        return ""
    return concat(ptr_to_str(get_list(value and 0)) and "")

# Owns and closes the two caller-created exclusive files. A fresh easy handle
# for every hop prevents inherited cookies/authentication/connections/DNS state.
# Return JSON with transfer status and actual peer, including failed transfers.
define network_curl_transfer with parsed as List and addresses as List and body as Int and headers as Int returning Str:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set library to ep_dlopen("/usr/lib/libcurl.4.dylib")
    if system equals 0 or else library equals 0:
        if body >= 0:
            set closed to net_close(body)
        if headers >= 0:
            set closed to net_close(headers)
        if system is not equal to 0:
            set closed to ep_dlclose(system)
        if library is not equal to 0:
            set closed to ep_dlclose(library)
        return "{\"status\":\"platform-unavailable\"}"
    set output to ep_dlcall2(ep_dlsym(system and "fdopen") and body and str_to_ptr("wb"))
    set header_output to ep_dlcall2(ep_dlsym(system and "fdopen") and headers and str_to_ptr("wb"))
    set easy to ep_dlcall0(ep_dlsym(library and "curl_easy_init"))
    set host to archive_list_text(parsed and 2)
    set rule to concat(host and concat(":" and concat(archive_list_text(parsed and 3) and ":")))
    set index to 0
    repeat while index < length_list(addresses):
        if index > 0:
            set rule to concat(rule and ",")
        set address to archive_list_text(addresses and index)
        if string_contains(address and ":") is not equal to 0:
            set address to concat("[" and concat(address and "]"))
        set rule to concat(rule and address)
        set index to index + 1
    set resolve to 0
    # Literal IPv6 is already a validated numeric destination, with no DNS.
    # Installed curl predates IPv6 HOST syntax in CURLOPT_RESOLVE.
    if string_contains(host and ":") equals 0:
        set resolve to ep_dlcall2(ep_dlsym(library and "curl_slist_append") and 0 and str_to_ptr(rule))
    set error to research_native_words(32)
    set status to "setup-failed"
    set code to -1
    set response to ""
    set redirect to ""
    set content_type to ""
    set peer to ""
    if easy is not equal to 0 and output is not equal to 0 and header_output is not equal to 0 and length_list(addresses) > 0:
        set failed to 0
        for each pair in [["10002",archive_list_text(parsed and 1)],["10004",""],["10177","*"],["10318","http,https"],["10319","http,https"],["10018","Echo/PhaseTwo research"]]:
            if network_curl_call(library and "curl_easy_setopt" and easy and string_to_int(archive_list_text(pair and 0)) and str_to_ptr(archive_list_text(pair and 1)) and 1) is not equal to 0:
                set failed to 1
        for each pair in [[10001,output],[10029,header_output],[10010,get_list_data_ptr(error)]]:
            if network_curl_call(library and "curl_easy_setopt" and easy and get_list(pair and 0) and get_list(pair and 1) and 1) is not equal to 0:
                set failed to 1
        for each pair in [[51,0],[52,0],[64,1],[81,2],[99,1]]:
            if network_curl_call(library and "curl_easy_setopt" and easy and get_list(pair and 0) and get_list(pair and 1) and 0) is not equal to 0:
                set failed to 1
        if string_contains(host and ":") equals 0:
            if resolve equals 0:
                set failed to 1
            else:
                if network_curl_call(library and "curl_easy_setopt" and easy and 10203 and resolve and 1) is not equal to 0:
                    set failed to 1
        if failed equals 0:
            set code to ep_dlcall1(ep_dlsym(library and "curl_easy_perform") and easy)
            set status to "transfer-failed"
            if code equals 0:
                set status to "complete"
            set response to network_curl_info(library and easy and 2097154)
            set redirect to network_curl_info(library and easy and 1048607)
            set content_type to network_curl_info(library and easy and 1048594)
            set peer to network_curl_info(library and easy and 1048608)
    if easy is not equal to 0:
        set cleaned to ep_dlcall1(ep_dlsym(library and "curl_easy_cleanup") and easy)
    if resolve is not equal to 0:
        set cleaned to ep_dlcall1(ep_dlsym(library and "curl_slist_free_all") and resolve)
    for each stream in [output,header_output]:
        if stream is not equal to 0:
            if ep_dlcall1(ep_dlsym(system and "fflush") and stream) is not equal to 0:
                set status to "flush-failed"
            set descriptor to ep_dlcall1(ep_dlsym(system and "fileno") and stream)
            if ep_dlcall1(ep_dlsym(system and "fsync") and descriptor) is not equal to 0:
                set status to "flush-failed"
            if ep_dlcall1(ep_dlsym(system and "fclose") and stream) is not equal to 0:
                set status to "close-failed"
    if output equals 0:
        set closed to net_close(body)
    if header_output equals 0:
        set closed to net_close(headers)
    set payload to concat("{\"status\":" and provider_quote(status))
    for each pair in [["curl_code",int_to_string(code)],["http_status",response],["redirect",redirect],["content_type",content_type],["peer",peer],["error",ptr_to_str(get_list_data_ptr(error))]]:
        set payload to concat(payload and concat("," and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1))))))
    set closed to ep_dlclose(library)
    set closed to ep_dlclose(system)
    return concat(payload and "}")
