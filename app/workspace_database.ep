import "workspace/database_engine"

# Launched only through the normal workspace sandbox and execution guardian.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set relative to get_argument(1)
    set script to get_argument(2)
    if workspace_path_parts(relative) equals 0 or else string_length(script) equals 0:
        display "{\"kind\":\"error\",\"stage\":\"invalid-arguments\"}"
        return 2
    set temporary to ptr_to_str(get_env("TMPDIR"))
    if string_length(temporary) < 10 or else not (substring(temporary and string_length(temporary) - 10 and 10) equals "/.echo-tmp"):
        display "{\"kind\":\"error\",\"stage\":\"workspace-environment-missing\"}"
        return 3
    set path to concat(substring(temporary and 0 and string_length(temporary) - 10) and concat("/" and relative))
    set library to ep_dlopen("/usr/lib/libsqlite3.dylib")
    if library equals 0:
        return 4
    set connection to [0]
    # READWRITE | CREATE | NOFOLLOW; URI parsing and extension loading stay off.
    set opened to ep_dlcall4(ep_dlsym(library and "sqlite3_open_v2") and str_to_ptr(path) and get_list_data_ptr(connection) and 16777222 and 0)
    set database to get_list(connection and 0)
    set status to 0
    if opened is not equal to 0:
        set status to workspace_database_error(library and database and "open" and opened)
    else:
        set status to workspace_database_script(library and database and script)
    if database is not equal to 0:
        set closed to ep_dlcall1(ep_dlsym(library and "sqlite3_close") and database)
        if closed is not equal to 0:
            set status to 1
    set closed to ep_dlclose(library)
    return status
