import "discord/job_provision"

# Operator-only preparation: existing Discord archive, expected bot identity,
# and a new recovery snapshot path. Never silently adopt a Host archive.
define main returning Int:
    if get_argument_count() is not equal to 4 or else not file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set result to discord_job_provision(database and get_argument(2) and get_argument(3))
    display result
    set closed to sql_close(database)
    if not (result equals "provisioned") or else closed is not equal to 0:
        return 3
    return 0
