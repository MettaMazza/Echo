import "mail/compose_tool"
import "mail/policy"

# Setup preparation only. Record an exact outbound capability proposal for
# genuine Echo review; never manufacture inspection, consent or authorization.
# Args: authority archive, mailbox root, run, account, intent, charter, proposal.
define main returning Int:
    if get_argument_count() is not equal to 8:
        display "Expected Echo archive, mailbox root, run, account, intent, charter and proposal identity."
        return 1
    set authority to archive_open(get_argument(1))
    set database to archive_open(concat(get_argument(2) and "/mailbox.sqlite"))
    set run to get_argument(3)
    set account to get_argument(4)
    set intent to get_argument(5)
    set owner to protected_proposal_principal(authority and run)
    if string_length(owner) equals 0 or else gmail_owner_active(authority and database and account and owner) equals 0 or else not (private_bridge_identity(authority and run) equals owner):
        display "Private mailbox owner authorization required."
        return 2
    set prepared to gmail_prepared_payload(database and account and intent)
    set preview to history_collect_one(checkpoint_prepare(database and "SELECT preview FROM echo_mail_compositions WHERE account=?1 AND identity=?2;" and [account,intent]))
    if not (archive_list_text(prepared and 0) equals "ready") or else not (archive_list_text(preview and 0) equals "found"):
        return 3
    set body to archive_list_text(prepared and 1)
    set policy to concat("{\"owner\":" and provider_quote(owner))
    set policy to concat(policy and concat(",\"account\":" and provider_quote(account)))
    set policy to concat(policy and concat(",\"disclosure\":" and archive_list_text(preview and 1)))
    set policy to concat(policy and concat(",\"actions\":[{\"intent\":" and provider_quote(intent)))
    set policy to concat(policy and ",\"operation\":\"messages.send\",\"parameters\":\"{}\",\"body\":")
    set policy to concat(policy and provider_quote(body))
    set policy to concat(policy and concat(",\"sha256\":" and concat(provider_quote(gmail_action_digest("messages.send" and "{}" and body)) and "}]}")))
    set manifest to protected_manifest(get_argument(6) and "fundamental tool access" and concat("mailbox:" and account) and ep_sha256("") and ep_sha256(policy) and policy)
    if string_length(manifest) equals 0 or else not (protected_proposal_schema(authority) equals "applied" or else protected_proposal_schema(authority) equals "already-applied"):
        return 4
    set status to protected_proposal_store(authority and get_argument(6) and run and get_argument(7) and manifest)
    set closed to sql_close(database)
    set closed to sql_close(authority)
    display status
    if not (status equals "recorded" or else status equals "already-recorded"):
        return 5
    display "Proposal prepared for real inspection/review. No mail sent or policy activated."
    return 0
