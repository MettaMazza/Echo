import "lifecycle/rsi_source_manifest"
import "lifecycle/service_profile"

# Immutable release integrity gate; live readiness is separately checked by
# the installed activation policy after launchd restarts the selected release.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set release to provider_json_tokens(file_read(get_argument(1)))
    if release equals 0 or else provider_unique_objects(release) equals 0:
        return 2
    set source to provider_value(release and provider_member(release and 0 and "source_root"))
    set manifest to file_read(provider_value(release and provider_member(release and 0 and "source_manifest")))
    if not (ep_sha256(manifest) equals provider_value(release and provider_member(release and 0 and "source_manifest_sha256"))):
        return 3
    set fields to provider_json_tokens(manifest)
    set files to provider_items(fields and provider_member(fields and 0 and "files"))
    if files equals 0 or else length_list(files) equals 0:
        return 4
    for each file in files:
        set path to provider_value(fields and provider_member(fields and file and "path"))
        if workspace_path_parts(path) equals 0 or else string_index_of(path and "app/") is not equal to 0:
            return 5
        set observed to file_digest_durable(concat(source and concat("/" and path)) and 65536)
        if not (archive_list_text(observed and 0) equals "verified") or else not (archive_list_text(observed and 1) equals provider_value(fields and provider_member(fields and file and "sha256"))):
            return 6
    set services to provider_items(release and provider_member(release and 0 and "services"))
    if services equals 0 or else length_list(services) equals 0:
        return 7
    for each service in services:
        set profile to file_read(provider_value(release and provider_member(release and service and "profile")))
        if not (ep_sha256(profile) equals provider_value(release and provider_member(release and service and "profile_sha256"))):
            return 8
        set parsed to provider_json_tokens(profile)
        if service_profile_valid(parsed) equals 0:
            return 9
        set observed to file_digest_durable(provider_value(parsed and provider_member(parsed and 0 and "executable")) and 65536)
        if not (archive_list_text(observed and 0) equals "verified") or else not (archive_list_text(observed and 1) equals provider_value(release and provider_member(release and service and "executable_sha256"))):
            return 10
    return 0
