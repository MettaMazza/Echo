import "lifecycle/service_profile"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 and get_argument_count() is not equal to 3:
        display "Supply a host service profile, optionally followed by check."
        return 1
    set check_only to 0
    if get_argument_count() equals 3:
        if not (get_argument(2) equals "check"):
            return 1
        set check_only to 1
    if not file_exists(get_argument(1)):
        display "Service profile is unavailable."
        return 1
    return service_profile_run(ptr_to_str(read_file(get_argument(1))) and check_only)
