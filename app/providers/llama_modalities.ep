import "local_json"

# Inspected against pinned llama.cpp b11429: /props.modalities describes the
# loaded projector's image/audio/video input support. No model-name guesses.
define llama_modalities_check with body as Str and properties as Str returning Str:
    set tokens to provider_json_tokens(body)
    set props to provider_json_tokens(properties)
    if tokens equals 0 or else props equals 0 or else provider_unique_objects(tokens) equals 0 or else provider_unique_objects(props) equals 0:
        return "invalid-metadata"
    set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
    if messages equals 0:
        return "invalid-request"
    set modalities to provider_member(props and 0 and "modalities")
    set index to 0
    repeat while index is less than length_list(messages):
        set message to get_list(messages and index)
        set content to provider_member(tokens and message and "content")
        set kind to provider_kind(tokens and content)
        if kind equals "[":
            set parts to provider_items(tokens and content)
            set part_index to 0
            repeat while part_index is less than length_list(parts):
                set part to get_list(parts and part_index)
                set type to provider_value(tokens and provider_member(tokens and part and "type"))
                set modality to ""
                if type equals "image_url":
                    set modality to "vision"
                else if type equals "input_audio":
                    set modality to "audio"
                else if type equals "input_video" or else type equals "video_url":
                    set modality to "video"
                else if not (type equals "text"):
                    return "unsupported-content-part"
                if string_length(modality) is greater than 0:
                    set supported to provider_kind(props and provider_member(props and modalities and modality))
                    if supported equals "false":
                        return concat("unsupported-input-" and modality)
                    if not (supported equals "true"):
                        return "modality-metadata-required"
                set part_index to part_index + 1
        else if not (kind equals "string" or else kind equals "null" or else kind equals "missing"):
            return "invalid-request"
        set index to index + 1
    return "ready"

# Preserve archive originals. Only the provider wire view replaces explicitly
# unsupported media with an honest limitation, never a fabricated perception.
# Unknown metadata remains fail-closed in llama_modalities_check.
define llama_modalities_notice with body as Str and properties as Str returning Str:
    set tokens to provider_json_tokens(body)
    set props to provider_json_tokens(properties)
    if tokens equals 0 or else props equals 0 or else provider_unique_objects(tokens) equals 0 or else provider_unique_objects(props) equals 0:
        return body
    set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
    if messages equals 0:
        return body
    set modalities to provider_member(props and 0 and "modalities")
    set builder to create_builder()
    set cursor to 0
    set index to 0
    repeat while index is less than length_list(messages):
        set message to get_list(messages and index)
        set content to provider_member(tokens and message and "content")
        if provider_kind(tokens and content) equals "[":
            set parts to provider_items(tokens and content)
            set part_index to 0
            repeat while part_index is less than length_list(parts):
                set part to get_list(parts and part_index)
                set type to provider_value(tokens and provider_member(tokens and part and "type"))
                set modality to ""
                if type equals "input_audio":
                    set modality to "audio"
                else if type equals "image_url":
                    set modality to "vision"
                else if type equals "input_video" or else type equals "video_url":
                    set modality to "video"
                if string_length(modality) > 0 and provider_kind(props and provider_member(props and modalities and modality)) equals "false":
                    set start to get_list(get_list(tokens and part) and 1)
                    set finish to get_list(get_list(tokens and provider_after(tokens and part) - 1) and 2)
                    set added to builder_append(builder and substring(body and cursor and start - cursor))
                    set notice to concat("Media unavailable to the selected model: unsupported-input-" and modality)
                    set notice to concat(notice and ". The original attachment is saved, but was NOT supplied to or perceived by this model. A ready retrieval receipt confirms saved bytes only. Explain this limitation and continue the conversation. Do not claim to have heard or seen it; a transcript is not hearing. Do not retry this modality on the same model.")
                    set added to builder_append(builder and concat("{\"type\":\"text\",\"text\":" and concat(provider_quote(notice) and "}")))
                    set cursor to finish
                set part_index to part_index + 1
        set index to index + 1
    if cursor equals 0:
        return body
    set added to builder_append(builder and substring(body and cursor and string_length(body) - cursor))
    return ptr_to_str(builder_to_string(builder))

# A concrete wire-level observation, only for native audio actually present on
# an endpoint reporting audio support. Textual filenames/receipts cannot trigger it.
# This runs before preflight so the exact augmented request is counted and archived.
define llama_native_audio_context with body as Str and properties as Str returning Str:
    set tokens to provider_json_tokens(body)
    set props to provider_json_tokens(properties)
    if tokens equals 0 or else props equals 0 or else provider_unique_objects(tokens) equals 0 or else provider_unique_objects(props) equals 0:
        return body
    set modalities to provider_member(props and 0 and "modalities")
    if not (provider_kind(props and provider_member(props and modalities and "audio")) equals "true"):
        return body
    set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
    if messages equals 0:
        return body
    set found to 0
    set system_field to -1
    set index to 0
    repeat while index < length_list(messages):
        set message to get_list(messages and index)
        set content to provider_member(tokens and message and "content")
        if provider_value(tokens and provider_member(tokens and message and "role")) equals "system" and provider_kind(tokens and content) equals "string" and system_field equals -1:
            set system_field to content
        if provider_kind(tokens and content) equals "[":
            set parts to provider_items(tokens and content)
            set part_index to 0
            repeat while part_index < length_list(parts):
                set part to get_list(parts and part_index)
                set audio to provider_member(tokens and part and "input_audio")
                if provider_value(tokens and provider_member(tokens and part and "type")) equals "input_audio" and provider_kind(tokens and audio) equals "{":
                    set data to provider_member(tokens and audio and "data")
                    if provider_kind(tokens and data) equals "string" and string_length(provider_value(tokens and data)) > 0:
                        set found to 1
                set part_index to part_index + 1
        set index to index + 1
    if found equals 0 or else system_field equals -1:
        return body
    set notice to "[CURRENT INPUT CAPABILITIES] This model receives native audio waveform input and can listen to the audio supplied in user messages. Audio perception does not require a transcription, playback, or frequency-analysis tool. Tools are additional operations, not the complete set of perceptual inputs. Interpret historical capability descriptions in the identity below using these current runtime facts.\n\n"
    set original to provider_value(tokens and system_field)
    if string_length(original) >= string_length(notice):
        if ptr_to_str(substring(original and 0 and string_length(notice))) equals notice:
            return body
    set start to get_list(get_list(tokens and system_field) and 1)
    set finish to get_list(get_list(tokens and system_field) and 2)
    # Keep each allocated string rooted across subsequent allocations. Real
    # multimodal bodies are large enough to trigger collection mid-expression.
    set leading to ptr_to_str(substring(body and 0 and start))
    set augmented to concat(notice and original)
    set replacement to provider_quote(augmented)
    set trailing to ptr_to_str(substring(body and finish and string_length(body) - finish))
    set prefix to concat(leading and replacement)
    return concat(prefix and trailing)
