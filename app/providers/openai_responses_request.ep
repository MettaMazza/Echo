import "anthropic_request"
import "openai_responses_replay"

# Convert canonical text/image parts without reducing unsupported media to text.
define responses_input_content with tokens as List and index as Int and images as Int returning List:
    set result to create_list()
    set kind to provider_kind(tokens and index)
    if kind equals "null" or else kind equals "missing":
        return result
    if kind equals "string":
        if string_length(provider_value(tokens and index)) > 0:
            set added to append_list(result and concat("{\"type\":\"input_text\",\"text\":" and concat(provider_quote(provider_value(tokens and index)) and "}")))
        return result
    set parts to provider_items(tokens and index)
    if parts equals 0:
        return 0
    for each part in parts:
        set kind to provider_value(tokens and provider_member(tokens and part and "type"))
        if kind equals "text":
            set text to provider_member(tokens and part and "text")
            if anthropic_fields(tokens and part and ["type","text"]) equals 0 or else not (provider_kind(tokens and text) equals "string"):
                return 0
            set added to append_list(result and concat("{\"type\":\"input_text\",\"text\":" and concat(provider_quote(provider_value(tokens and text)) and "}")))
        else if kind equals "image_url" and images equals 1:
            set image to provider_member(tokens and part and "image_url")
            if anthropic_fields(tokens and part and ["type","image_url"]) equals 0 or else anthropic_fields(tokens and image and ["url","detail"]) equals 0:
                return 0
            set url_field to provider_member(tokens and image and "url")
            set url to provider_value(tokens and url_field)
            set allowed to string_index_of(url and "https://") equals 0
            for each media in ["image/png","image/jpeg","image/gif","image/webp"]:
                set prefix to concat("data:" and concat(media and ";base64,"))
                if string_index_of(url and prefix) equals 0 and string_length(url) > string_length(prefix):
                    set allowed to 1
            if not (provider_kind(tokens and url_field) equals "string") or else allowed equals 0:
                return 0
            set converted to concat("{\"type\":\"input_image\",\"image_url\":" and provider_quote(url))
            set detail to provider_member(tokens and image and "detail")
            if detail >= 0:
                set value to provider_value(tokens and detail)
                if not (provider_kind(tokens and detail) equals "string") or else not (value equals "auto" or else value equals "low" or else value equals "high" or else value equals "original"):
                    return 0
                set converted to concat(converted and concat(",\"detail\":" and provider_quote(value)))
            set added to append_list(result and concat(converted and "}"))
        else:
            return 0
    return result

# Native replay records are host-loaded and bound to the normalized accepted
# assistant turn. No reasoning text is substituted for encrypted native state.
define responses_messages_translate with source as Str and replays as List returning List:
    set tokens to provider_json_tokens(source)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ["invalid-messages",""]
    set messages to provider_items(tokens and 0)
    if messages equals 0 or else length_list(messages) equals 0:
        return ["invalid-messages",""]
    for each binding in replays:
        if length_list(binding) is not equal to 2 or else get_list(binding and 0) < 0 or else get_list(binding and 0) >= length_list(messages):
            return ["invalid-native-replay-binding",""]
    set output to create_list()
    set pending to create_list()
    set seen to create_list()
    set position to 0
    for each message in messages:
        if anthropic_fields(tokens and message and ["role","content","tool_calls","tool_call_id","reasoning_content"]) equals 0:
            return ["unsupported-message-field",""]
        set role to provider_value(tokens and provider_member(tokens and message and "role"))
        set replay to 0
        for each binding in replays:
            if get_list(binding and 0) equals position:
                if replay is not equal to 0:
                    return ["duplicate-native-replay-binding",""]
                set replay to get_list(binding and 1)
                if anthropic_replay_matches(replay and tokens and message) equals 0:
                    return ["native-history-mismatch",""]
        set reasoning to provider_member(tokens and message and "reasoning_content")
        if replay equals 0 and reasoning >= 0 and not (provider_kind(tokens and reasoning) equals "string" and string_length(provider_value(tokens and reasoning)) equals 0):
            return ["native-thinking-history-required",""]
        set calls_field to provider_member(tokens and message and "tool_calls")
        set result_field to provider_member(tokens and message and "tool_call_id")
        if (calls_field >= 0 and not (role equals "assistant")) or else (result_field >= 0 and not (role equals "tool")):
            return ["invalid-tool-role",""]
        set parts to responses_input_content(tokens and provider_member(tokens and message and "content") and (role equals "user" or else role equals "tool"))
        if parts equals 0:
            return ["unsupported-message-content",""]
        set turn to create_list()
        if role equals "tool":
            set identity to provider_value(tokens and result_field)
            set found to -1
            set cursor to 0
            for each prior in pending:
                if identity equals prior and string_length(identity) > 0:
                    set found to cursor
                set cursor to cursor + 1
            if not (provider_kind(tokens and result_field) equals "string") or else found < 0:
                return ["unmatched-tool-result",""]
            set changed to set_list(pending and found and "")
            set content to anthropic_array(parts)
            set field to provider_member(tokens and message and "content")
            if provider_kind(tokens and field) equals "string":
                set content to provider_quote(provider_value(tokens and field))
            set item to concat("{\"type\":\"function_call_output\",\"call_id\":" and provider_quote(identity))
            set added to append_list(turn and concat(item and concat(",\"output\":" and concat(content and "}"))))
        else:
            for each prior in pending:
                if string_length(prior) > 0:
                    return ["missing-tool-result",""]
            set pending to create_list()
            if not (role equals "system" or else role equals "developer" or else role equals "user" or else role equals "assistant"):
                return ["unsupported-message-role",""]
            if length_list(parts) > 0:
                set item to concat("{\"role\":" and provider_quote(role))
                set added to append_list(turn and concat(item and concat(",\"content\":" and concat(anthropic_array(parts) and "}"))))
            if calls_field >= 0:
                set calls to provider_items(tokens and calls_field)
                if calls equals 0 or else length_list(calls) equals 0:
                    return ["invalid-tool-calls",""]
                for each call in calls:
                    set function to provider_member(tokens and call and "function")
                    if anthropic_fields(tokens and call and ["id","type","function"]) equals 0 or else anthropic_fields(tokens and function and ["name","arguments"]) equals 0 or else not (provider_value(tokens and provider_member(tokens and call and "type")) equals "function"):
                        return ["unsupported-tool-call",""]
                    set id_field to provider_member(tokens and call and "id")
                    set name_field to provider_member(tokens and function and "name")
                    set args_field to provider_member(tokens and function and "arguments")
                    set identity to provider_value(tokens and id_field)
                    set name to provider_value(tokens and name_field)
                    set arguments to provider_value(tokens and args_field)
                    set args to provider_json_tokens(arguments)
                    if not (provider_kind(tokens and id_field) equals "string") or else not (provider_kind(tokens and name_field) equals "string") or else not (provider_kind(tokens and args_field) equals "string") or else string_length(identity) equals 0 or else string_length(name) equals 0 or else args equals 0 or else provider_unique_objects(args) equals 0 or else not (provider_kind(args and 0) equals "{"):
                        return ["invalid-tool-call",""]
                    for each prior in seen:
                        if identity equals prior:
                            return ["duplicate-tool-call",""]
                    set added to append_list(seen and identity)
                    set added to append_list(pending and identity)
                    set item to concat("{\"type\":\"function_call\",\"call_id\":" and provider_quote(identity))
                    set item to concat(item and concat(",\"name\":" and provider_quote(name)))
                    set added to append_list(turn and concat(item and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}"))))
            if length_list(turn) equals 0 and replay equals 0:
                return ["empty-message",""]
        if replay is not equal to 0:
            set original to archive_list_text(replay and 1)
            set native to provider_json_tokens(original)
            set items to provider_items(native and 0)
            if items equals 0:
                return ["invalid-native-content",""]
            set turn to create_list()
            for each item in items:
                set added to append_list(turn and anthropic_json_source(original and native and item))
        for each item in turn:
            set added to append_list(output and item)
        set position to position + 1
    for each prior in pending:
        if string_length(prior) > 0:
            return ["missing-tool-result",""]
    return ["ready",anthropic_array(output)]

define responses_request_create with model as Str and messages as Str and tools as Str and options as Str and replays as List returning List:
    set config to provider_json_tokens(options)
    if string_length(model) equals 0 or else config equals 0 or else provider_unique_objects(config) equals 0 or else anthropic_fields(config and 0 and ["max_output_tokens","reasoning","text","parallel_tool_calls"]) equals 0:
        return ["invalid-native-options",""]
    set maximum to provider_index(config and provider_member(config and 0 and "max_output_tokens"))
    if string_length(maximum) equals 0 or else http_decimal(maximum) <= 0:
        return ["invalid-output-budget",""]
    set translated to responses_messages_translate(messages and replays)
    if not (archive_list_text(translated and 0) equals "ready"):
        return translated
    set definitions to provider_json_tokens(tools)
    if definitions equals 0 or else provider_unique_objects(definitions) equals 0:
        return ["invalid-tools",""]
    set items to provider_items(definitions and 0)
    if items equals 0:
        return ["invalid-tools",""]
    set native_tools to create_list()
    set names to create_list()
    for each item in items:
        set function to provider_member(definitions and item and "function")
        if anthropic_fields(definitions and item and ["type","function"]) equals 0 or else anthropic_fields(definitions and function and ["name","description","parameters","strict"]) equals 0 or else not (provider_value(definitions and provider_member(definitions and item and "type")) equals "function"):
            return ["unsupported-tool-definition",""]
        set name_field to provider_member(definitions and function and "name")
        set name to provider_value(definitions and name_field)
        if not (provider_kind(definitions and name_field) equals "string") or else string_length(name) equals 0 or else not (provider_kind(definitions and provider_member(definitions and function and "parameters")) equals "{"):
            return ["invalid-tool-definition",""]
        for each prior in names:
            if name equals prior:
                return ["duplicate-tool-name",""]
        set added to append_list(names and name)
        for each field in ["description","strict"]:
            set value to provider_member(definitions and function and field)
            if value >= 0:
                if field equals "description" and not (provider_kind(definitions and value) equals "string"):
                    return ["invalid-tool-definition",""]
                if field equals "strict" and not (provider_kind(definitions and value) equals "true" or else provider_kind(definitions and value) equals "false"):
                    return ["invalid-tool-definition",""]
        set native to anthropic_json_source(tools and definitions and function)
        # Responses may normalize omitted strict into strict mode.
        # Keep the canonical schema semantics rather than silently tightening it.
        if provider_member(definitions and function and "strict") < 0:
            set native to anthropic_json_replace(native and "strict" and "false")
        set added to append_list(native_tools and anthropic_json_replace(native and "type" and "\"function\""))
    set body to concat("{\"model\":" and provider_quote(model))
    set body to concat(body and concat(",\"stream\":true,\"store\":false,\"truncation\":\"disabled\",\"include\":[\"reasoning.encrypted_content\"],\"input\":" and archive_list_text(translated and 1)))
    if length_list(native_tools) > 0:
        set body to concat(body and concat(",\"tools\":" and anthropic_array(native_tools)))
    for each key in ["max_output_tokens","reasoning","text","parallel_tool_calls"]:
        set value to provider_member(config and 0 and key)
        if value >= 0:
            set body to concat(body and concat("," and concat(provider_quote(key) and ":")))
            set body to concat(body and anthropic_json_source(options and config and value))
    return ["ready",concat(body and "}")]

# Bind native replay to both the model and the settings of an ongoing tool turn.
define responses_request_create_archived with database as Int and session as Str and model as Str and messages as Str and tools as Str and options as Str and bindings as List returning List:
    set source to provider_json_tokens(messages)
    set turns to provider_items(source and 0)
    set selected to provider_json_tokens(options)
    if turns equals 0 or else selected equals 0:
        return ["invalid-request",""]
    set active to -1
    if length_list(turns) > 0 and provider_value(source and provider_member(source and get_list(turns and length_list(turns) - 1) and "role")) equals "tool":
        set cursor to length_list(turns) - 1
        repeat while cursor >= 0:
            if provider_value(source and provider_member(source and get_list(turns and cursor) and "role")) equals "assistant":
                set active to cursor
                break
            set cursor to cursor - 1
    set replays to create_list()
    for each binding in bindings:
        if length_list(binding) is not equal to 2:
            return ["invalid-native-replay-binding",""]
        set request to archive_list_text(binding and 1)
        set replay to openai_responses_replay_read(database and session and request)
        if not (archive_list_text(replay and 0) equals "ready"):
            return replay
        set original to anthropic_replay_event(database and request)
        set envelope to provider_json_tokens(archive_list_text(original and 3))
        set raw to provider_value(envelope and provider_member(envelope and 0 and "request_body"))
        set native to provider_json_tokens(raw)
        if native equals 0 or else not (provider_value(native and provider_member(native and 0 and "model")) equals model):
            return ["native-history-model-mismatch",""]
        if get_list(binding and 0) equals active:
            if not (anthropic_json_source(raw and native and provider_member(native and 0 and "reasoning")) equals anthropic_json_source(options and selected and provider_member(selected and 0 and "reasoning"))):
                return ["native-turn-settings-mismatch",""]
        set retained to create_list()
        set added to append_list(retained and get_list(binding and 0))
        set added to append_list(retained and replay)
        set added to append_list(replays and retained)
    return responses_request_create(model and messages and tools and options and replays)
