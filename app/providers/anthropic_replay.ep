import "external_replay_scope"
import "anthropic_json"

# Verify each consumed immutable record without rescanning unrelated history.
define anthropic_replay_event with database as Int and identity as Str returning List:
    set row to archive_read_event(database and identity)
    if row equals 0:
        return 0
    set digest to archive_digest(archive_list_text(row and 0) and archive_list_text(row and 1) and archive_list_text(row and 2) and archive_list_text(row and 3) and archive_list_text(row and 4) and archive_list_text(row and 5))
    if not (digest equals archive_list_text(row and 6)):
        return 0
    return row

# Replace only the streamed field. Unknown block fields and exact numeric
# spelling remain intact; signatures/redacted content are never synthesized.
define anthropic_json_replace with source as Str and name as Str and value as Str returning Str:
    set tokens to provider_json_tokens(source)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return ""
    set fields to create_list()
    set found to 0
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        set content to anthropic_json_source(source and tokens and index + 2)
        if key equals name:
            set content to value
            set found to 1
        set added to append_list(fields and concat(provider_quote(key) and concat(":" and content)))
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    if found equals 0:
        set added to append_list(fields and concat(provider_quote(name) and concat(":" and value)))
    set array to anthropic_array(fields)
    return concat("{" and concat(ptr_to_str(substring(array and 1 and string_length(array) - 2)) and "}"))

# Internal archive reader, not a model tool or authorization grant. The caller
# must authorize this session/profile. Reads only same-session complete external
# attempts. Returns [status, native content JSON, normalized chat state].
define anthropic_replay_read with database as Int and requested_session as Str and request as Str returning List:
    set failed to create_list()
    set added to append_list(failed and "unavailable-native-history")
    set added to append_list(failed and "")
    set added to append_list(failed and 0)
    set session to external_replay_source(database and requested_session and request)
    if string_length(session) equals 0:
        return failed
    set original to anthropic_replay_event(database and request)
    set terminal to anthropic_replay_event(database and concat(request and ":transport-end"))
    if original equals 0 or else terminal equals 0:
        return failed
    if not (archive_list_text(original and 0) equals session) or else not (archive_list_text(original and 2) equals "model_request") or else not (archive_list_text(terminal and 0) equals session) or else not (archive_list_text(terminal and 2) equals "provider_transport_end"):
        return failed
    set finish to provider_json_tokens(archive_list_text(terminal and 3))
    if finish equals 0 or else provider_unique_objects(finish) equals 0 or else not (provider_value(finish and provider_member(finish and 0 and "request_event")) equals request) or else not (provider_value(finish and provider_member(finish and 0 and "status")) equals "complete"):
        return failed
    set state to anthropic_stream_create()
    set blocks to create_list()
    set active to ""
    set input to create_builder()
    set input_count to 0
    set text_buffer to create_builder()
    set signature_buffer to create_builder()
    set text_field to ""
    set text_count to 0
    set signature_count to 0
    set sequence to 0
    repeat while 1 equals 1:
        set event to anthropic_replay_event(database and concat(request and concat(":provider:" and int_to_string(sequence))))
        if event equals 0 or else not (archive_list_text(event and 0) equals session):
            return failed
        set envelope to provider_json_tokens(archive_list_text(event and 3))
        if envelope equals 0 or else provider_unique_objects(envelope) equals 0 or else not (provider_value(envelope and provider_member(envelope and 0 and "request_event")) equals request):
            return failed
        if archive_list_text(event and 2) equals "provider_stream_end":
            if anthropic_stream_finish(state and provider_value(envelope and provider_member(envelope and 0 and "transport"))) is not equal to 0:
                return failed
            set result to create_list()
            set added to append_list(result and "ready")
            set added to append_list(result and anthropic_array(blocks))
            set added to append_list(result and get_list(state and 0))
            return result
        if not (archive_list_text(event and 2) equals "provider_event"):
            return failed
        set data to provider_value(envelope and provider_member(envelope and 0 and "data"))
        set tokens to provider_json_tokens(data)
        if tokens equals 0 or else not (provider_value(envelope and provider_member(envelope and 0 and "event_type")) equals provider_value(tokens and provider_member(tokens and 0 and "type"))) or else anthropic_stream_accept(state and data) is not equal to 0:
            return failed
        set kind to provider_value(tokens and provider_member(tokens and 0 and "type"))
        if kind equals "content_block_start":
            set active to anthropic_json_source(data and tokens and provider_member(tokens and 0 and "content_block"))
            set input to create_builder()
            set input_count to 0
            set text_buffer to create_builder()
            set signature_buffer to create_builder()
            set text_count to 0
            set signature_count to 0
            set text_field to ""
            set block to provider_member(tokens and 0 and "content_block")
            set block_type to provider_value(tokens and provider_member(tokens and block and "type"))
            if block_type equals "text":
                set text_field to "text"
            else if block_type equals "thinking":
                set text_field to "thinking"
            set added to builder_append(text_buffer and provider_value(tokens and provider_member(tokens and block and text_field)))
            set added to builder_append(signature_buffer and provider_value(tokens and provider_member(tokens and block and "signature")))
        else if kind equals "content_block_delta":
            set delta to provider_member(tokens and 0 and "delta")
            set delta_type to provider_value(tokens and provider_member(tokens and delta and "type"))
            if delta_type equals "input_json_delta":
                set added to builder_append(input and provider_value(tokens and provider_member(tokens and delta and "partial_json")))
                set input_count to input_count + 1
            else if delta_type equals "signature_delta":
                set added to builder_append(signature_buffer and provider_value(tokens and provider_member(tokens and delta and "signature")))
                set signature_count to signature_count + 1
            else if delta_type equals "text_delta" or else delta_type equals "thinking_delta":
                set added to builder_append(text_buffer and provider_value(tokens and provider_member(tokens and delta and text_field)))
                set text_count to text_count + 1
            else:
                return failed
        else if kind equals "content_block_stop":
            # Assemble once per block, not a growing string rewrite per token.
            if text_count > 0:
                set active to anthropic_json_replace(active and text_field and provider_quote(ptr_to_str(builder_to_string(text_buffer))))
            if signature_count > 0:
                set active to anthropic_json_replace(active and "signature" and provider_quote(ptr_to_str(builder_to_string(signature_buffer))))
            if input_count > 0:
                set active to anthropic_json_replace(active and "input" and ptr_to_str(builder_to_string(input)))
            set current to provider_json_tokens(active)
            if current equals 0 or else provider_unique_objects(current) equals 0:
                return failed
            if provider_value(current and provider_member(current and 0 and "type")) equals "thinking":
                if not (provider_kind(current and provider_member(current and 0 and "signature")) equals "string") or else string_length(provider_value(current and provider_member(current and 0 and "signature"))) equals 0:
                    return failed
            if provider_value(current and provider_member(current and 0 and "type")) equals "redacted_thinking":
                if not (provider_kind(current and provider_member(current and 0 and "data")) equals "string"):
                    return failed
            set added to append_list(blocks and active)
        set sequence to sequence + 1
    return failed

# Bind normalized text/tool IDs/arguments to the exact archived native response
# before replacing a message's content. A caller cannot attach somebody else's
# signed thinking to a different assistant turn merely by supplying a reference.
define anthropic_replay_matches with replay as List and tokens as List and message as Int returning Int:
    if not (archive_list_text(replay and 0) equals "ready") or else not (provider_value(tokens and provider_member(tokens and message and "role")) equals "assistant"):
        return 0
    set state to get_list(replay and 2)
    set choice to get_list(get_list(state and 0) and 0)
    set content to provider_member(tokens and message and "content")
    if not (provider_kind(tokens and content) equals "string" or else provider_kind(tokens and content) equals "null" or else provider_kind(tokens and content) equals "missing"):
        return 0
    set text to ""
    if provider_kind(tokens and content) equals "string":
        set text to provider_value(tokens and content)
    if not (text equals archive_list_text(choice and 1)):
        return 0
    set reasoning to provider_member(tokens and message and "reasoning_content")
    if reasoning >= 0 and not (provider_kind(tokens and reasoning) equals "string" and provider_value(tokens and reasoning) equals archive_list_text(choice and 2)):
        return 0
    set calls to provider_items(tokens and provider_member(tokens and message and "tool_calls"))
    set native_calls to get_list(choice and 3)
    if calls equals 0:
        return length_list(native_calls) equals 0
    if length_list(calls) is not equal to length_list(native_calls):
        return 0
    set index to 0
    repeat while index < length_list(calls):
        set call to get_list(calls and index)
        set native to get_list(native_calls and index)
        set function to provider_member(tokens and call and "function")
        if not (provider_value(tokens and provider_member(tokens and call and "id")) equals archive_list_text(native and 1)) or else not (provider_value(tokens and provider_member(tokens and function and "name")) equals archive_list_text(native and 2)) or else not (provider_value(tokens and provider_member(tokens and function and "arguments")) equals archive_list_text(native and 3)):
            return 0
        set index to index + 1
    return 1
