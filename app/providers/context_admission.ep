import "../context/budget"

# Adapters supply verified effective limits and the exact token count for the
# assembled request. A finite output ceiling here must be a genuine provider
# capability, not a configurable generation default. Unknown values fail.
# Result: status, loaded context, supported context, input tokens, output room.
define provider_context_admission with loaded as Int and supported as Int and input as Int and ceiling as Int and reserve as Int returning List:
    set result to create_list()
    set added to append_list(result and "invalid-metadata")
    if loaded is less than 1 or else supported is less than 1 or else input is less than 0 or else reserve is less than 1:
        return result
    if ceiling is not equal to -1 and ceiling is less than 1:
        return result
    set available to context_output_allowance(loaded and input and ceiling)
    set added to append_list(result and loaded)
    set added to append_list(result and supported)
    set added to append_list(result and input)
    set added to append_list(result and available)
    if context_loaded_at_maximum(supported and loaded) is not equal to 1:
        set changed to set_list(result and 0 and "context-configuration-required")
        return result
    # Compaction cannot increase a separate generation ceiling. Surface this
    # distinction so callers do not repeatedly compact an impossible workload.
    if ceiling is greater than 0 and reserve is greater than ceiling:
        set changed to set_list(result and 0 and "output-capacity-exceeded")
        return result
    if input >= loaded or else available is less than reserve:
        set changed to set_list(result and 0 and "compaction-required")
        return result
    set changed to set_list(result and 0 and "ready")
    return result
