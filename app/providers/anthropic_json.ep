import "archived_stream"

# Preserve schema/input numeric spelling and key order from original JSON.
define anthropic_json_source with source as Str and tokens as List and index as Int returning Str:
    set after to provider_after(tokens and index)
    if after < 1:
        return ""
    set start to get_list(get_list(tokens and index) and 1)
    set finish to get_list(get_list(tokens and after - 1) and 2)
    return ptr_to_str(substring(source and start and finish - start))

define anthropic_fields with tokens as List and object as Int and allowed as List returning Int:
    if not (provider_kind(tokens and object) equals "{"):
        return 0
    set index to object + 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set known to 0
        for each name in allowed:
            if provider_value(tokens and index) equals name:
                set known to 1
        if known equals 0:
            return 0
        set index to provider_after(tokens and index + 2)
        if index < 0:
            return 0
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    return 1

define anthropic_array with items as List returning Str:
    set output to create_builder()
    set added to builder_append(output and "[")
    set index to 0
    repeat while index < length_list(items):
        if index > 0:
            set added to builder_append(output and ",")
        set added to builder_append(output and archive_list_text(items and index))
        set index to index + 1
    set added to builder_append(output and "]")
    return ptr_to_str(builder_to_string(output))

