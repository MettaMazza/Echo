import "anthropic_json"
import "../transport/http_response"

# Responses counting accepts native Responses input, not Chat Completions.
# Stateless requests retain all replay items locally and forbid truncation.
define openai_responses_count_request with body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else anthropic_fields(tokens and 0 and ["model","input","instructions","tools","tool_choice","parallel_tool_calls","reasoning","text","truncation","store","stream","max_output_tokens","include"]) equals 0:
        return ""
    if not (provider_kind(tokens and provider_member(tokens and 0 and "model")) equals "string") or else string_length(provider_value(tokens and provider_member(tokens and 0 and "model"))) equals 0:
        return ""
    if not (provider_kind(tokens and provider_member(tokens and 0 and "input")) equals "[") or else not (provider_kind(tokens and provider_member(tokens and 0 and "store")) equals "false") or else not (provider_value(tokens and provider_member(tokens and 0 and "truncation")) equals "disabled"):
        return ""
    set output to create_builder()
    set added to builder_append(output and "{")
    set separator to ""
    for each name in ["model","input","instructions","tools","tool_choice","parallel_tool_calls","reasoning","text","truncation"]:
        set value to provider_member(tokens and 0 and name)
        if value >= 0:
            set added to builder_append(output and concat(separator and concat(provider_quote(name) and ":")))
            set added to builder_append(output and anthropic_json_source(body and tokens and value))
            set separator to ","
    set added to builder_append(output and "}")
    return ptr_to_str(builder_to_string(output))

define openai_responses_count_value with body as Str returning Int:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "object")) equals "response.input_tokens"):
        return -1
    set field to provider_member(tokens and 0 and "input_tokens")
    if not (provider_kind(tokens and field) equals "number"):
        return -1
    return http_decimal(provider_index(tokens and field))

define openai_responses_count_arguments with path as Str returning List:
    if string_length(path) equals 0 or else get_character(path and 0) is not equal to 47:
        return 0
    return ["--disable","--silent","--show-error","--no-buffer","--raw","--include","--http1.1","--proto","=https","--proto-redir","=https","--max-redirs","0","--retry","0","--proxy","","--request","POST","--header","@/dev/stdin","--header","Content-Type: application/json","--header","Accept: application/json","--header","Accept-Encoding: identity","--header","Expect:","--data-binary",concat("@" and path),"--url","https://api.openai.com/v1/responses/input_tokens"]
