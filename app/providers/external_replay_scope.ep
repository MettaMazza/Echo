import "../context/checkpoint"
import "../archive/session_scope"

# Resolve only the immutable prefix already included by a same-owner external
# branch. A shared account or principal alone never authorizes other sessions.
# Native readers additionally verify every event hash and transport completion.
define external_replay_source with database as Int and session as Str and request as Str returning Str:
    set event to archive_read_event(database and request)
    if event equals 0:
        return ""
    set source to archive_list_text(event and 0)
    if source equals session:
        return source
    set query to concat(session_scope_sql() and "SELECT s.session FROM scopes s JOIN echo_events e ON e.session=s.session AND e.event=?2 AND e.sequence<=s.boundary JOIN echo_events t ON t.session=s.session AND t.event=?2||':transport-end' AND t.sequence<=s.boundary JOIN echo_external_scopes target ON target.session=?1 JOIN echo_external_scopes origin ON origin.session=s.session AND origin.principal=target.principal AND origin.profile_digest=target.profile_digest WHERE s.session<>?1 AND NOT EXISTS(SELECT 1 FROM echo_external_revocations r WHERE r.session IN (target.session,origin.session));")
    set row to history_collect_one(checkpoint_prepare(database and query and [session,request]))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    return archive_list_text(row and 1)
