import "external_transport"
import "response_stream"

# Consume one already-authorized, durably claimed transfer. Native stream
# completion alone cannot authorize tool execution: curl must also exit zero.
# Persist the combined terminal result for restart/recovery, including errors.
# A third result field retains ownership if OS cleanup needs supervision.
define external_response_collect with database as Int and session as Str and request as Str and family as Str and transfer as List and read_size as Int returning List:
    if not (archive_list_text(transfer and 0) equals "streaming"):
        return provider_collected(archive_list_text(transfer and 0) and chat_stream_create())
    set response to provider_http_collect(get_list(transfer and 2) and database and session and request and read_size and family)
    set stream_status to archive_list_text(response and 0)
    set process_status to external_transport_finish(database and session and request and transfer and (stream_status equals "complete"))
    set status to stream_status
    if process_status equals "cleanup-pending" or else process_status equals "cleanup-error":
        set status to process_status
    else if stream_status equals "complete" and not (process_status equals "complete"):
        set status to process_status
    set payload to concat("{\"request_event\":" and provider_quote(request))
    set payload to concat(payload and concat(",\"stream_status\":" and provider_quote(stream_status)))
    set payload to concat(payload and concat(",\"process_status\":" and provider_quote(process_status)))
    set payload to concat(payload and concat(",\"status\":" and provider_quote(status)))
    set payload to concat(payload and "}")
    if archive_append(database and session and concat(request and ":transport-end") and "provider_transport_end" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        set status to "archive-error"
    set result to provider_collected(status and get_list(response and 1))
    set ownership to 0
    if get_list(transfer and 1) is not equal to 0:
        set ownership to transfer
    set added to append_list(result and ownership)
    return result
