import "local_json"
import "../context/budget"

# Native llama.cpp metadata; unknown values fail instead of receiving defaults.
# Result: status, model id, loaded context, training context, output ceiling.
define llama_metadata_parse with models as Str and props as Str and model as Str returning List:
    set result to create_list()
    set added to append_list(result and "invalid-metadata")
    set model_tokens to provider_json_tokens(models)
    set prop_tokens to provider_json_tokens(props)
    if model_tokens equals 0 or else prop_tokens equals 0:
        return result
    if provider_unique_objects(model_tokens) equals 0 or else provider_unique_objects(prop_tokens) equals 0:
        return result
    set entries to provider_items(model_tokens and provider_member(model_tokens and 0 and "data"))
    if entries equals 0:
        return result
    set selected to -1
    set index to 0
    repeat while index is less than length_list(entries):
        set entry to get_list(entries and index)
        if provider_value(model_tokens and provider_member(model_tokens and entry and "id")) equals model:
            if selected is not equal to -1:
                return result
            set selected to entry
        set index to index + 1
    if selected equals -1:
        return result
    set meta to provider_member(model_tokens and selected and "meta")
    set loaded to http_decimal(provider_index(model_tokens and provider_member(model_tokens and meta and "n_ctx")))
    set trained to http_decimal(provider_index(model_tokens and provider_member(model_tokens and meta and "n_ctx_train")))
    set defaults to provider_member(prop_tokens and 0 and "default_generation_settings")
    set slot to http_decimal(provider_index(prop_tokens and provider_member(prop_tokens and defaults and "n_ctx")))
    set params to provider_member(prop_tokens and defaults and "params")
    set limit_field to provider_member(prop_tokens and params and "n_predict")
    if not (provider_kind(prop_tokens and limit_field) equals "number"):
        return result
    set output_limit to provider_value(prop_tokens and limit_field)
    set ceiling to -1
    if not (output_limit equals "-1"):
        set ceiling to http_decimal(output_limit)
        if ceiling is less than 1:
            return result
    if loaded is less than 1 or else trained is less than 1 or else slot is not equal to loaded:
        return result
    set changed to set_list(result and 0 and "ready")
    set added to append_list(result and model)
    set added to append_list(result and loaded)
    set added to append_list(result and trained)
    set added to append_list(result and ceiling)
    return result

define llama_input_count with response as Str returning Int:
    set tokens to provider_json_tokens(response)
    if tokens equals 0:
        return -1
    if provider_unique_objects(tokens) equals 0:
        return -1
    return http_decimal(provider_index(tokens and provider_member(tokens and 0 and "input_tokens")))
