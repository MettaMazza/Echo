import "native_python"

define python_scope_import with scope as List and library as Int and name as Str returning Int:
    set result to native_python_import(library and name)
    if result is not equal to 0:
        set added to append_list(scope and result)
    return result

define python_scope_attribute with scope as List and library as Int and object as Int and name as Str returning Int:
    set result to native_python_attribute(library and object and name)
    if result is not equal to 0:
        set added to append_list(scope and result)
    return result

define python_scope_string with scope as List and library as Int and text as Str returning Int:
    set result to native_python_string(library and text)
    if result is not equal to 0:
        set added to append_list(scope and result)
    return result

define python_scope_json with scope as List and library as Int and text as Str returning Int:
    set result to native_python_json(library and text)
    if result is not equal to 0:
        set added to append_list(scope and result)
    return result

define python_scope_member with scope as List and library as Int and object as Int and name as Str returning Int:
    set result to native_python_member(library and object and name)
    if result is not equal to 0:
        set added to append_list(scope and result)
    return result

define python_scope_call with scope as List and library as Int and function as Int and arguments as List and keywords as Int returning Int:
    set result to native_python_call(library and function and arguments and keywords)
    if result is not equal to 0:
        set added to append_list(scope and result)
    return result

define python_scope_close with scope as List and library as Int returning Int:
    set index to length_list(scope) - 1
    repeat while index >= 0:
        set released to native_python_release(library and get_list(scope and index))
        set index to index - 1
    return 0
