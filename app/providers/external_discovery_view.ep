import "external_model_info"

# Reduce the UI view to provider metadata while keeping the full response in
# the owner-only discovery record. Unknown budgeting is displayed as null.
define external_discovery_model_view with family as Str and body as Str returning Str:
    set info to external_model_info(family and body)
    if archive_list_text(info and 0) equals "invalid-model-metadata":
        return ""
    set tokens to provider_json_tokens(body)
    set label to archive_list_text(info and 1)
    set named to provider_member(tokens and 0 and "display_name")
    if provider_kind(tokens and named) equals "string":
        set label to provider_value(tokens and named)
    set output to concat("{\"id\":" and provider_quote(archive_list_text(info and 1)))
    set output to concat(output and concat(",\"label\":" and provider_quote(label)))
    set output to concat(output and concat(",\"accounting\":" and provider_quote(archive_list_text(info and 0))))
    set input to "null"
    set maximum to "null"
    if get_list(info and 2) > 0:
        set input to int_to_string(get_list(info and 2))
    if get_list(info and 3) > 0:
        set maximum to int_to_string(get_list(info and 3))
    set output to concat(output and concat(",\"input_limit\":" and input))
    set output to concat(output and concat(",\"output_limit\":" and maximum))
    return concat(output and concat(",\"capabilities\":" and concat(archive_list_text(info and 4) and "}")))

define external_discovery_view with family as Str and model as Str and body as Str returning Str:
    set tokens to provider_json_tokens(body)
    set invalid to "{\"status\":\"invalid-model-metadata\"}"
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return invalid
    set models to create_list()
    set cursor to ""
    if string_length(model) > 0:
        set item to external_discovery_model_view(family and body)
        if string_length(item) equals 0:
            return invalid
        set added to append_list(models and item)
    else:
        set data to provider_member(tokens and 0 and "data")
        if not (provider_kind(tokens and data) equals "["):
            return invalid
        if family equals "anthropic-messages":
            set more to provider_kind(tokens and provider_member(tokens and 0 and "has_more"))
            if not (more equals "true" or else more equals "false"):
                return invalid
            if more equals "true":
                set last to provider_member(tokens and 0 and "last_id")
                if not (provider_kind(tokens and last) equals "string") or else string_length(provider_value(tokens and last)) equals 0:
                    return invalid
                set cursor to provider_value(tokens and last)
        else if family equals "openai-chat":
            if not (provider_value(tokens and provider_member(tokens and 0 and "object")) equals "list"):
                return invalid
        else:
            return invalid
        set items to provider_items(tokens and data)
        for each index in items:
            set item to external_discovery_model_view(family and anthropic_json_source(body and tokens and index))
            if string_length(item) equals 0:
                return invalid
            set added to append_list(models and item)
    return concat("{\"status\":\"found\",\"models\":" and concat(anthropic_array(models) and concat(",\"next_cursor\":" and concat(provider_quote(cursor) and "}"))))
