import "../retained_text"
import "archived_stream"
import "../transport/local_connect"

# Validate before connecting. The exact outgoing JSON must already be durable.
# Localhost is deliberate for this adapter, not a provider-wide restriction.
define local_chat_request_valid with database as Int and session as Str and request as Str and body as Str and path as Str returning Int:
    if string_length(path) equals 0:
        return 0
    if get_character(path and 0) is not equal to 47:
        return 0
    set position to 0
    repeat while position is less than string_length(path):
        set code to get_character(path and position)
        if code is less than 33 or else code is greater than 126 or else code equals 35:
            return 0
        set position to position + 1
    set row to archive_read_event(database and request)
    if row equals 0:
        return 0
    if not (archive_list_text(row and 0) equals session) or else not (archive_list_text(row and 2) equals "model_request"):
        return 0
    set original to provider_json_tokens(archive_list_text(row and 3))
    if original equals 0:
        return 0
    set field to provider_member(original and 0 and "request_body")
    if not (provider_kind(original and field) equals "string") or else not (provider_value(original and field) equals body):
        return 0
    set tokens to provider_json_tokens(body)
    if tokens equals 0:
        return 0
    if provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return 0
    set streaming to provider_member(tokens and 0 and "stream")
    if not (provider_kind(tokens and streaming) equals "true"):
        return 0
    return 1

define local_chat_exchange with reader as List and database as Int and session as Str and request as Str and port as Int and path as Str and body as Str and read_size as Int returning List:
    set state to chat_stream_create()
    set wire to concat("POST " and concat(path and " HTTP/1.1\r\nHost: 127.0.0.1:"))
    set wire to concat(wire and int_to_string(port))
    set wire to concat(wire and "\r\nContent-Type: application/json\r\nAccept: text/event-stream\r\nAccept-Encoding: identity\r\nConnection: close\r\nContent-Length: ")
    set wire to concat(wire and concat(int_to_string(string_length(body)) and "\r\n\r\n"))
    set sent to socket_write_all(get_list(reader and 0) and get_list(reader and 1) and get_list(reader and 2) and str_to_ptr(wire) and string_length(wire))
    if not (archive_list_text(sent and 0) equals "sent"):
        return provider_collected(archive_list_text(sent and 0) and state)
    set sent to socket_write_all(get_list(reader and 0) and get_list(reader and 1) and get_list(reader and 2) and str_to_ptr(body) and string_length(body))
    if not (archive_list_text(sent and 0) equals "sent"):
        return provider_collected(archive_list_text(sent and 0) and state)
    set head to http_response_head(reader and "POST")
    repeat while archive_list_text(head and 0) equals "ready":
        if get_list(head and 1) >= 200:
            break
        set head to http_response_head(reader and "POST")
    if not (archive_list_text(head and 0) equals "ready"):
        return provider_collected(archive_list_text(head and 0) and state)
    set payload to concat("{\"request_event\":" and provider_quote(request))
    set payload to concat(payload and concat(",\"status\":" and int_to_string(get_list(head and 1))))
    set payload to concat(payload and ",\"headers\":[")
    set headers to get_list(head and 4)
    set index to 0
    set content_type to ""
    repeat while index is less than length_list(headers):
        set pair to get_list(headers and index)
        set name to archive_list_text(pair and 0)
        set value to archive_list_text(pair and 1)
        if index is greater than 0:
            set payload to concat(payload and ",")
        set payload to concat(payload and concat("[" and provider_quote(name)))
        set payload to concat(payload and concat("," and provider_quote(value)))
        set payload to concat(payload and "]")
        if name equals "content-type":
            if string_length(content_type) is greater than 0:
                return provider_collected("ambiguous-content-type" and state)
            set content_type to ptr_to_str(string_to_lower(value))
        set index to index + 1
    set payload to concat(payload and "]}")
    if archive_append(database and session and concat(request and ":http") and "provider_response_head" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return provider_collected("archive-error" and state)
    if get_list(head and 1) is not equal to 200:
        return provider_collected("http-error" and state)
    set semicolon to string_index_of(content_type and ";")
    if semicolon >= 0:
        set content_type to ptr_to_str(string_trim(substring(content_type and 0 and semicolon)))
    if not (content_type equals "text/event-stream"):
        return provider_collected("unsupported-content-type" and state)
    set framed_body to http_body_create(archive_list_text(head and 2) and get_list(head and 3))
    return provider_collect_events(reader and framed_body and database and session and request and read_size)

define local_chat_generate with database as Int and session as Str and request as Str and port as Int and path as Str and body as Str and cancellation_reader as Int and read_size as Int returning List:
    set empty to chat_stream_create()
    if local_chat_request_valid(database and session and request and body and path) equals 0:
        return provider_collected("invalid-request" and empty)
    set dispatch to concat("{\"request_event\":" and provider_quote(request))
    set dispatch to concat(dispatch and concat(",\"port\":" and int_to_string(port)))
    set dispatch to concat(dispatch and concat(",\"path\":" and provider_quote(path)))
    set dispatch to concat(dispatch and "}")
    # Claim the attempt durably before any network action. A crash after this
    # point requires recovery/new attempt identity, never automatic POST replay.
    if archive_append(database and session and concat(request and ":dispatch") and "provider_dispatch" and dispatch and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return provider_collected("archive-error" and empty)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return provider_collected("platform-error" and empty)
    set connection to local_socket_connect(library and port and cancellation_reader)
    if not (archive_list_text(connection and 0) equals "connected"):
        set closed to ep_dlclose(library)
        return provider_collected(archive_list_text(connection and 0) and empty)
    set descriptor to get_list(connection and 1)
    set reader to http_stream_create(library and descriptor and cancellation_reader)
    set result to local_chat_exchange(reader and database and session and request and port and path and body and read_size)
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    set unloaded to ep_dlclose(library)
    if released is not equal to 0 or else closed is not equal to 0 or else unloaded is not equal to 0:
        return provider_collected("cleanup-error" and get_list(result and 1))
    return result
