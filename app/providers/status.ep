import "../retained_text"
import "prepare"

# Display metadata separately from admission. Available models are not proof
# that weights are loaded; an unknown loaded capacity remains JSON null.
define provider_status_read with profile as Str returning Str:
    set valid to provider_profile_status(profile)
    if not (valid equals "ready"):
        return concat("{\"status\":" and concat(provider_quote(valid) and "}"))
    set config to provider_json_tokens(profile)
    set model to provider_value(config and provider_member(config and 0 and "model"))
    set adapter to provider_value(config and provider_member(config and 0 and "adapter"))
    set port to http_decimal(provider_index(config and provider_member(config and 0 and "port")))
    set status to "unavailable"
    set supported to "null"
    set loaded to "null"
    set vision to "null"
    set video to "null"
    set audio to "null"
    set health to local_json_request(port and "GET" and "/health" and "" and -1 and 65536)
    if archive_list_text(health and 0) equals "ready":
        set models to local_json_request(port and "GET" and "/v1/models" and "" and -1 and 65536)
        if archive_list_text(models and 0) equals "ready":
            if adapter equals "mlx-lm":
                set status to mlx_discovery_check(archive_list_text(health and 2) and archive_list_text(models and 2) and model)
                if status equals "ready":
                    set capacity to mlx_context_capacity(ptr_to_str(read_file(concat(model and "/config.json"))))
                    if capacity is greater than 0:
                        set supported to int_to_string(capacity)
                    set status to "available"
                    set vision to "false"
                    set video to "false"
                    set audio to "false"
            else:
                set props to local_json_request(port and "GET" and "/props" and "" and -1 and 65536)
                if archive_list_text(props and 0) equals "ready":
                    set metadata to llama_metadata_parse(archive_list_text(models and 2) and archive_list_text(props and 2) and model)
                    set status to archive_list_text(metadata and 0)
                    if status equals "ready":
                        set loaded to int_to_string(get_list(metadata and 2))
                        set supported to int_to_string(get_list(metadata and 3))
                        set properties to provider_json_tokens(archive_list_text(props and 2))
                        set modalities to provider_member(properties and 0 and "modalities")
                        set reported to provider_kind(properties and provider_member(properties and modalities and "vision"))
                        if reported equals "true" or else reported equals "false":
                            set vision to reported
                        set reported to provider_kind(properties and provider_member(properties and modalities and "video"))
                        if reported equals "true" or else reported equals "false":
                            set video to reported
                        set reported to provider_kind(properties and provider_member(properties and modalities and "audio"))
                        if reported equals "true" or else reported equals "false":
                            set audio to reported
    set payload to concat("{\"status\":" and provider_quote(status))
    set payload to concat(payload and concat(",\"adapter\":" and provider_quote(adapter)))
    set payload to concat(payload and concat(",\"supported_context\":" and supported))
    set payload to concat(payload and concat(",\"loaded_context\":" and loaded))
    set payload to concat(payload and concat(",\"vision\":" and vision))
    set payload to concat(payload and concat(",\"video\":" and video))
    set payload to concat(payload and concat(",\"audio\":" and audio))
    set research to "Not configured"
    if string_length(ptr_to_str(get_env("ECHO_RESEARCH_RUNTIME"))) > 0 and also string_length(ptr_to_str(get_env("ECHO_RESEARCH_ROOT"))) > 0:
        set research to "Public web search, fetch and static link navigation configured"
    set payload to concat(payload and concat(",\"research\":" and provider_quote(research)))
    return concat(payload and ",\"output_policy\":\"Available context after exact input counting\"}")
