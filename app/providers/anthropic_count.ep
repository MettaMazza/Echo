import "anthropic_json"

# Count the native Messages input, not a separately approximated chat prompt.
# The endpoint excludes generation-only stream/max_tokens settings. Preserve
# every included subtree exactly, including signed thinking and tool schemas.
define anthropic_count_request with body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else anthropic_fields(tokens and 0 and ["model","stream","system","messages","tools","max_tokens","thinking","output_config","tool_choice"]) equals 0:
        return ""
    if not (provider_kind(tokens and provider_member(tokens and 0 and "model")) equals "string") or else not (provider_kind(tokens and provider_member(tokens and 0 and "messages")) equals "["):
        return ""
    set output to create_builder()
    set added to builder_append(output and "{")
    set separator to ""
    for each key in ["model","system","messages","tools","thinking","output_config","tool_choice"]:
        set member to provider_member(tokens and 0 and key)
        if member >= 0:
            set added to builder_append(output and concat(separator and concat(provider_quote(key) and ":")))
            set added to builder_append(output and anthropic_json_source(body and tokens and member))
            set separator to ","
    set added to builder_append(output and "}")
    return ptr_to_str(builder_to_string(output))

define anthropic_count_value with body as Str returning Int:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return -1
    set field to provider_member(tokens and 0 and "input_tokens")
    if not (provider_kind(tokens and field) equals "number"):
        return -1
    return http_decimal(provider_index(tokens and field))

define anthropic_count_arguments with path as Str returning List:
    if string_length(path) equals 0 or else get_character(path and 0) is not equal to 47:
        return 0
    return ["--disable","--silent","--show-error","--no-buffer","--raw","--include","--http1.1","--proto","=https","--proto-redir","=https","--max-redirs","0","--retry","0","--proxy","","--request","POST","--header","@/dev/stdin","--header","Content-Type: application/json","--header","Accept: application/json","--header","Accept-Encoding: identity","--header","Expect:","--data-binary",concat("@" and path),"--url","https://api.anthropic.com/v1/messages/count_tokens"]
