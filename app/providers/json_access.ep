import "../retained_text"
import "json_tokens"

define provider_kind with tokens as List and index as Int returning Str:
    if index is less than 0 or else index >= length_list(tokens):
        return "missing"
    return ptr_to_str(get_list(get_list(tokens and index) and 0))

define provider_value with tokens as List and index as Int returning Str:
    if index is less than 0 or else index >= length_list(tokens):
        return ""
    return ptr_to_str(get_list(get_list(tokens and index) and 3))

define provider_after with tokens as List and index as Int returning Int:
    set kind to provider_kind(tokens and index)
    if kind equals "missing":
        return -1
    if not (kind equals "{" or else kind equals "["):
        return index + 1
    set depth to 1
    set index to index + 1
    repeat while index is less than length_list(tokens):
        set kind to provider_kind(tokens and index)
        if kind equals "{" or else kind equals "[":
            set depth to depth + 1
        if kind equals "}" or else kind equals "]":
            set depth to depth - 1
        set index to index + 1
        if depth equals 0:
            return index
    return -1

# Missing is -1; wrong type or ambiguous duplicate members is -2.
# Check every member, including fields an adapter does not currently use.
define provider_member with tokens as List and object as Int and name as Str returning Int:
    if not (provider_kind(tokens and object) equals "{"):
        return -2
    set keys to create_list()
    set found to -1
    set index to object + 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        if not (provider_kind(tokens and index) equals "string"):
            return -2
        set key to provider_value(tokens and index)
        set previous to 0
        repeat while previous is less than length_list(keys):
            if archive_list_text(keys and previous) equals key:
                return -2
            set previous to previous + 1
        set added to append_list(keys and key)
        if key equals name:
            set found to index + 2
        set index to provider_after(tokens and index + 2)
        if index is less than 0:
            return -2
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    return found

define provider_items with tokens as List and array as Int returning List:
    if not (provider_kind(tokens and array) equals "["):
        return 0
    set items to create_list()
    set index to array + 1
    repeat while not (provider_kind(tokens and index) equals "]"):
        set added to append_list(items and index)
        set index to provider_after(tokens and index)
        if index is less than 0:
            return 0
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    return items

define provider_index with tokens as List and index as Int returning Str:
    if not (provider_kind(tokens and index) equals "number"):
        return ""
    set value to provider_value(tokens and index)
    set position to 0
    repeat while position is less than string_length(value):
        if provider_digit(value and position) equals 0:
            return ""
        set position to position + 1
    return value

define provider_unique_objects with tokens as List returning Int:
    set index to 0
    repeat while index is less than length_list(tokens):
        if provider_kind(tokens and index) equals "{":
            if provider_member(tokens and index and "") equals -2:
                return 0
        set index to index + 1
    return 1
