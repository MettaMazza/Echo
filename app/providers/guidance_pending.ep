import "../archive/history"

# Durable guidance belongs to a run. Application receipts prevent replay.
define guidance_pending with database as Int and run as Str returning List:
    set statement to archive_prepare(database and "SELECT e.event,json_extract(e.payload,'$.message') FROM echo_events e WHERE e.kind='guidance_received' AND json_extract(e.payload,'$.run_id')=?1 AND NOT EXISTS(SELECT 1 FROM echo_events a WHERE a.kind='user_guidance' AND json_extract(a.payload,'$.source_event')=e.event) ORDER BY e.sequence LIMIT 1;")
    if statement equals 0:
        return history_status("error")
    if archive_bind(statement and 1 and run) is not equal to 0:
        set finished to ep_sqlite3_finalize(statement)
        return history_status("error")
    return history_collect_one(statement)
