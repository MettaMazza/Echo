import "external_profiles"

# Resolve a session's explicit consent, never the host default. Call inside the
# submission transaction so ownership/revocation cannot change before binding.
# An omitted identity means the profile already consented for this session.
define external_session_profile with database as Int and device as Str and session as Str and identity as Str returning List:
    set principal to principal_for_device(database and device)
    if string_length(principal) equals 0:
        return history_status("not-authorized")
    set row to history_collect_one(checkpoint_prepare(database and "SELECT p.identity,p.label,p.profile,p.digest,q.body,q.digest FROM echo_external_scopes s JOIN echo_external_profiles p ON p.principal=s.principal AND p.digest=s.profile_digest JOIN echo_external_accounts a ON a.identity=p.account AND a.principal=p.principal JOIN echo_external_discovery d ON d.identity=p.discovery AND d.account=p.account AND d.principal=p.principal AND d.family=a.family JOIN echo_external_discovery_results q ON q.identity=d.identity AND q.status='ready' WHERE s.session=?1 AND s.principal=?2 AND NOT EXISTS(SELECT 1 FROM echo_external_revocations v WHERE v.session=s.session) AND NOT EXISTS(SELECT 1 FROM echo_external_account_revocations v WHERE v.identity=a.identity);" and [session,principal]))
    if not (archive_list_text(row and 0) equals "found"):
        return history_status("external-profile-unavailable")
    if string_length(identity) > 0 and also not (archive_list_text(row and 1) equals identity):
        return history_status("external-profile-consent-mismatch")
    set profile to archive_list_text(row and 3)
    set tokens to provider_json_tokens(profile)
    if not (ep_sha256(profile) equals archive_list_text(row and 4)) or else not (ep_sha256(archive_list_text(row and 5)) equals archive_list_text(row and 6)) or else not (provider_value(tokens and provider_member(tokens and 0 and "metadata_digest")) equals archive_list_text(row and 6)):
        return history_status("external-profile-integrity-error")
    return ["found",archive_list_text(row and 2),profile]
