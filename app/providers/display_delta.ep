import "chat_stream"

# Display-only native text and public reasoning summaries. Encrypted reasoning,
# signatures, function arguments and terminal copies never become draft text.
define provider_display_delta with tokens as List and reasoning as Int returning Str:
    set kind to provider_value(tokens and provider_member(tokens and 0 and "type"))
    set text to -1
    if kind equals "response.output_text.delta" and reasoning equals 0:
        set text to provider_member(tokens and 0 and "delta")
    else if kind equals "response.reasoning_summary_text.delta" and reasoning equals 1:
        set text to provider_member(tokens and 0 and "delta")
    else if kind equals "content_block_start":
        set block to provider_member(tokens and 0 and "content_block")
        set block_type to provider_value(tokens and provider_member(tokens and block and "type"))
        if block_type equals "text" and reasoning equals 0:
            set text to provider_member(tokens and block and "text")
        else if block_type equals "thinking" and reasoning equals 1:
            set text to provider_member(tokens and block and "thinking")
    else if kind equals "content_block_delta":
        set delta to provider_member(tokens and 0 and "delta")
        set delta_type to provider_value(tokens and provider_member(tokens and delta and "type"))
        if delta_type equals "text_delta" and reasoning equals 0:
            set text to provider_member(tokens and delta and "text")
        else if delta_type equals "thinking_delta" and reasoning equals 1:
            set text to provider_member(tokens and delta and "thinking")
    if provider_kind(tokens and text) equals "string":
        return provider_value(tokens and text)
    return ""
