import "../archive/attachment_scope"
import "../archive/attachment_visibility"
import "../security/principals"
import "../retained_text"
import "../archive/file_base64"
import "../tools/history_tools"

# The caller supplies a trusted run session, never an arbitrary host path.
# Returns status, typed content part, original source event and original digest.
# Decoding and token cost belong to the loaded provider, not this serializer.
define attachment_image_original_part with database as Int and session as Str and attachment as Str returning List:
    return attachment_media_original_part(database and session and attachment and "image")

# Share the same source authority, original-byte verification and provenance for
# native sound. The provider decodes the waveform; no transcript is substituted.
define attachment_audio_original_part with database as Int and session as Str and attachment as Str returning List:
    return attachment_media_original_part(database and session and attachment and "audio")

define attachment_media_original_part with database as Int and session as Str and attachment as Str and modality as Str returning List:
    set result to create_list()
    set added to append_list(result and "not-found")
    set added to append_list(result and "")
    set added to append_list(result and "")
    set added to append_list(result and "")
    set values to create_list()
    set added to append_list(values and session)
    set added to append_list(values and attachment)
    set row to history_collect_one(checkpoint_prepare(database and concat(session_scope_sql() and concat("SELECT a.path,a.media_type,a.digest,CAST(a.bytes AS TEXT),a.event FROM scopes s JOIN echo_attachments a ON a.session=s.session JOIN echo_events e ON e.event=a.event AND e.sequence<=s.boundary JOIN echo_session_owners o ON o.session=a.session JOIN echo_devices d ON d.device=o.device WHERE " and concat(principal_session_sql(database and "o.session" and "o.device") and " AND a.attachment=?2 AND d.revoked=0 AND d.device=(SELECT device FROM echo_session_owners WHERE session=?1);"))) and values))
    if archive_list_text(row and 0) equals "end" and attachment_shared_session(database and session) equals 1:
        set row to history_collect_one(checkpoint_prepare(database and "SELECT a.path,a.media_type,a.digest,CAST(a.bytes AS TEXT),a.event FROM echo_attachments a WHERE a.session=?1 AND a.attachment=?2;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        if archive_list_text(row and 0) equals "error":
            set changed to set_list(result and 0 and "archive-error")
        return result
    set media to archive_list_text(row and 2)
    # MIME spelling is metadata only. The provider validates actual image bytes.
    set audio_format to ""
    if modality equals "audio":
        if media equals "audio/wav" or else media equals "audio/x-wav" or else media equals "audio/wave":
            set audio_format to "wav"
        else if media equals "audio/mpeg" or else media equals "audio/mp3":
            set audio_format to "mp3"
        else:
            set changed to set_list(result and 0 and "unsupported-audio-format")
            return result
    else if modality equals "video":
        if not (media equals "video/mp4"):
            set changed to set_list(result and 0 and "unsupported-video-format")
            return result
    else:
        if not (media equals "image/png" or else media equals "image/jpeg" or else media equals "image/webp" or else media equals "image/gif"):
            set changed to set_list(result and 0 and "unsupported-image-format")
            return result
    set encoded to file_base64_verified(archive_list_text(row and 1) and archive_list_text(row and 3) and string_to_int(archive_list_text(row and 4)) and 65536)
    if not (archive_list_text(encoded and 0) equals "verified"):
        set changed to set_list(result and 0 and archive_list_text(encoded and 0))
        return result
    set uri to concat("data:" and concat(media and concat(";base64," and archive_list_text(encoded and 1))))
    set part to concat("{\"type\":\"image_url\",\"image_url\":{\"url\":" and concat(provider_quote(uri) and "}}"))
    if modality equals "audio":
        set data to provider_quote(archive_list_text(encoded and 1))
        set part to concat("{\"type\":\"input_audio\",\"input_audio\":{\"data\":" and data)
        set format to provider_quote(audio_format)
        set suffix to concat(",\"format\":" and format)
        set part to concat(part and suffix)
        set part to concat(part and "}}")
    else if modality equals "video":
        set part to concat("{\"type\":\"input_video\",\"input_video\":{\"data\":" and concat(provider_quote(archive_list_text(encoded and 1)) and "}}"))
    set changed to set_list(result and 0 and "ready")
    set changed to set_list(result and 1 and part)
    set changed to set_list(result and 2 and archive_list_text(row and 5))
    set changed to set_list(result and 3 and archive_list_text(row and 3))
    return result

# Automatic replay obeys exclusion; explicit scoped tool reads use the original.
define attachment_image_part with database as Int and session as Str and attachment as Str returning List:
    if attachment_context_included(database and attachment) equals 0:
        return ["excluded-from-context", "", "", ""]
    return attachment_image_original_part(database and session and attachment)

define attachment_audio_part with database as Int and session as Str and attachment as Str returning List:
    if attachment_context_included(database and attachment) equals 0:
        return ["excluded-from-context", "", "", ""]
    return attachment_audio_original_part(database and session and attachment)
