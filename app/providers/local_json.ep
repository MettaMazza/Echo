import "../retained_text"
import "local_chat"

# Reject malformed UTF-8 and NUL rather than corrupting metadata or JSON keys.
define provider_valid_utf8 with text as Str returning Int:
    set remaining to 0
    set minimum to 128
    set maximum to 191
    set index to 0
    repeat while index is less than string_length(text):
        set code to get_character(text and index)
        if remaining is greater than 0:
            if code is less than minimum or else code is greater than maximum:
                return 0
            set remaining to remaining - 1
            set minimum to 128
            set maximum to 191
        else if code is greater than 127:
            if code is greater than 193 and code is less than 224:
                set remaining to 1
            else if code is greater than 223 and code is less than 240:
                set remaining to 2
                if code equals 224:
                    set minimum to 160
                if code equals 237:
                    set maximum to 159
            else if code is greater than 239 and code is less than 245:
                set remaining to 3
                if code equals 240:
                    set minimum to 144
                if code equals 244:
                    set maximum to 143
            else:
                return 0
        set index to index + 1
    if remaining is not equal to 0:
        return 0
    return 1

define local_json_result with status as Str and code as Int and text as Str returning List:
    set result to create_list()
    set added to append_list(result and status)
    set added to append_list(result and code)
    set added to append_list(result and text)
    return result

# This request path is for local discovery/token-count endpoints. It never
# retries, modifies global properties, or invokes generation implicitly.
define local_json_exchange with reader as List and method as Str and port as Int and path as Str and body as Str and read_size as Int returning List:
    set wire to concat(method and concat(" " and concat(path and " HTTP/1.1\r\nHost: 127.0.0.1:")))
    set wire to concat(wire and int_to_string(port))
    set wire to concat(wire and "\r\nAccept: application/json\r\nContent-Type: application/json\r\nAccept-Encoding: identity\r\nConnection: close\r\nContent-Length: ")
    set wire to concat(wire and concat(int_to_string(string_length(body)) and concat("\r\n\r\n" and body)))
    set sent to socket_write_all(get_list(reader and 0) and get_list(reader and 1) and get_list(reader and 2) and str_to_ptr(wire) and string_length(wire))
    if not (archive_list_text(sent and 0) equals "sent"):
        return local_json_result(archive_list_text(sent and 0) and 0 and "")
    set head to http_response_head(reader and method)
    repeat while archive_list_text(head and 0) equals "ready":
        if get_list(head and 1) >= 200:
            break
        set head to http_response_head(reader and method)
    if not (archive_list_text(head and 0) equals "ready"):
        return local_json_result(archive_list_text(head and 0) and 0 and "")
    set code to get_list(head and 1)
    set framed to http_body_create(archive_list_text(head and 2) and get_list(head and 3))
    set builder to create_builder()
    set copy to ep_dlsym(get_list(reader and 0) and "memcpy")
    set byte to create_list()
    set added to append_list(byte and 0)
    if copy equals 0:
        return local_json_result("error" and code and "")
    repeat while 1 equals 1:
        set piece to http_body_next(reader and framed and read_size)
        set status to archive_list_text(piece and 0)
        if status equals "done":
            break
        if not (status equals "data"):
            return local_json_result(status and code and ptr_to_str(builder_to_string(builder)))
        set index to 0
        repeat while index is less than get_list(piece and 2):
            set cleared to set_list(byte and 0 and 0)
            set copied to ep_dlcall3(copy and get_list_data_ptr(byte) and get_list(piece and 1) + index and 1)
            if get_list(byte and 0) equals 0:
                return local_json_result("invalid-json" and code and ptr_to_str(builder_to_string(builder)))
            set added to builder_append(builder and ptr_to_str(get_list_data_ptr(byte)))
            set index to index + 1
    set text to ptr_to_str(builder_to_string(builder))
    if code is not equal to 200:
        return local_json_result("http-error" and code and text)
    if provider_valid_utf8(text) equals 0:
        return local_json_result("invalid-json" and code and text)
    set tokens to provider_json_tokens(text)
    if tokens equals 0:
        return local_json_result("invalid-json" and code and text)
    if provider_unique_objects(tokens) equals 0:
        return local_json_result("invalid-json" and code and text)
    return local_json_result("ready" and code and text)

define local_json_request with port as Int and method as Str and path as Str and body as Str and cancellation_reader as Int and read_size as Int returning List:
    set allowed to 0
    if method equals "GET" and (path equals "/props" or else path equals "/v1/models" or else path equals "/health"):
        set allowed to 1
    if method equals "POST" and (path equals "/v1/chat/completions/input_tokens" or else path equals "/v1/embeddings"):
        set allowed to 1
    if allowed equals 0 or else read_size is less than 1:
        return local_json_result("unsupported-operation" and 0 and "")
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return local_json_result("platform-error" and 0 and "")
    set connection to local_socket_connect(library and port and cancellation_reader)
    if not (archive_list_text(connection and 0) equals "connected"):
        set closed to ep_dlclose(library)
        return local_json_result(archive_list_text(connection and 0) and 0 and "")
    set descriptor to get_list(connection and 1)
    set reader to http_stream_create(library and descriptor and cancellation_reader)
    set result to local_json_exchange(reader and method and port and path and body and read_size)
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    set unloaded to ep_dlclose(library)
    if released is not equal to 0 or else closed is not equal to 0 or else unloaded is not equal to 0:
        return local_json_result("cleanup-error" and get_list(result and 1) and archive_list_text(result and 2))
    return result
