import "../retained_text"
import "llama_preflight"
import "mlx_discovery"

# Stable adapter result: status, loaded context, supported context, exact input,
# output room, wire body, endpoint, port, retained helper handle.
define provider_prepared_error with status as Str returning List:
    set result to create_list()
    set added to append_list(result and status)
    set added to append_list(result and -1)
    set added to append_list(result and -1)
    set added to append_list(result and -1)
    set added to append_list(result and -1)
    set added to append_list(result and "")
    set added to append_list(result and "/v1/chat/completions")
    set added to append_list(result and -1)
    set added to append_list(result and 0)
    return result

# Compatibility constructor for the existing host launch configuration.
define provider_llama_profile with model as Str and port as Int returning Str:
    set profile to concat("{\"adapter\":\"llama.cpp\",\"model\":" and provider_quote(model))
    return concat(profile and concat(",\"port\":" and concat(int_to_string(port) and "}")))

# Host-authorized profile is an input, never selected by model/tool text.
# Archive its exact value for this attempt. Unsupported adapters fail explicitly.
define provider_profile_status with profile as Str returning Str:
    set config to provider_json_tokens(profile)
    if config equals 0:
        return "invalid-provider-profile"
    if provider_unique_objects(config) equals 0 or else not (provider_kind(config and 0) equals "{"):
        return "invalid-provider-profile"
    set retained_list_1 to create_list()
    set retained_item_1_0 to "adapter"
    set retained_added to append_list(retained_list_1 and retained_item_1_0)
    set retained_item_1_1 to "model"
    set retained_added to append_list(retained_list_1 and retained_item_1_1)
    set names to retained_list_1
    set index to 0
    repeat while index is less than length_list(names):
        set field to provider_member(config and 0 and archive_list_text(names and index))
        if not (provider_kind(config and field) equals "string") or else string_length(provider_value(config and field)) equals 0:
            return "invalid-provider-profile"
        set index to index + 1
    set port_field to provider_member(config and 0 and "port")
    set port to http_decimal(provider_index(config and port_field))
    if not (provider_kind(config and port_field) equals "number") or else port is less than 1 or else port is greater than 65535:
        return "invalid-provider-profile"
    set adapter to provider_value(config and provider_member(config and 0 and "adapter"))
    if adapter equals "llama.cpp":
        return "ready"
    if not (adapter equals "mlx-lm"):
        return "unsupported-provider-adapter"
    set retained_list_2 to create_list()
    set retained_item_2_0 to "tokenizer_helper"
    set retained_added to append_list(retained_list_2 and retained_item_2_0)
    set retained_item_2_1 to "interpreter_library"
    set retained_added to append_list(retained_list_2 and retained_item_2_1)
    set retained_item_2_2 to "environment_executable"
    set retained_added to append_list(retained_list_2 and retained_item_2_2)
    set retained_item_2_3 to "spool"
    set retained_added to append_list(retained_list_2 and retained_item_2_3)
    set names to retained_list_2
    set index to 0
    repeat while index is less than length_list(names):
        set field to provider_member(config and 0 and archive_list_text(names and index))
        if not (provider_kind(config and field) equals "string") or else string_length(provider_value(config and field)) equals 0:
            return "invalid-provider-profile"
        set index to index + 1
    return "ready"

define provider_prepare with database as Int and session as Str and identity as Str and profile as Str and body as Str and reserve as Int and cancellation as Int and batch as Int returning List:
    set profile_status to provider_profile_status(profile)
    if not (profile_status equals "ready"):
        return provider_prepared_error(profile_status)
    set config to provider_json_tokens(profile)
    set request to provider_json_tokens(body)
    if config equals 0 or else request equals 0:
        return provider_prepared_error("invalid-provider-profile")
    if provider_unique_objects(config) equals 0 or else provider_unique_objects(request) equals 0:
        return provider_prepared_error("invalid-provider-profile")
    set model to provider_value(config and provider_member(config and 0 and "model"))
    set port to http_decimal(provider_index(config and provider_member(config and 0 and "port")))
    set adapter to provider_value(config and provider_member(config and 0 and "adapter"))
    if string_length(model) equals 0 or else port is less than 1 or else port is greater than 65535:
        return provider_prepared_error("invalid-provider-profile")
    if not (provider_value(request and provider_member(request and 0 and "model")) equals model):
        return provider_prepared_error("request-model-mismatch")
    if not (adapter equals "llama.cpp" or else adapter equals "mlx-lm"):
        return provider_prepared_error("unsupported-provider-adapter")
    # Keep the validated routing decision as a value across archive allocation;
    # do not depend on a borrowed token string after that call.
    set use_llama to adapter equals "llama.cpp"
    if archive_append(database and session and concat(identity and ":profile") and "provider_profile" and profile and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return provider_prepared_error("archive-error")
    set result to provider_prepared_error("invalid-provider-profile")
    set changed to set_list(result and 7 and port)
    if use_llama:
        set body to provider_scheduled_body(session and identity and body)
        set decision to llama_preflight(database and session and identity and port and body and reserve and cancellation and batch)
        set changed to set_list(result and 0 and get_list(decision and 0))
        if length_list(decision) >= 5:
            set index to 1
            repeat while index is less than 5:
                set changed to set_list(result and index and get_list(decision and index))
                set index to index + 1
        if archive_list_text(result and 0) equals "ready":
            set changed to set_list(result and 5 and body)
        return result
    set modality to llama_modalities_check(body and "{\"modalities\":{\"vision\":false,\"audio\":false,\"video\":false}}")
    if not (modality equals "ready"):
        return provider_prepared_error(modality)
    set helper to provider_value(config and provider_member(config and 0 and "tokenizer_helper"))
    set interpreter to provider_value(config and provider_member(config and 0 and "interpreter_library"))
    set program to provider_value(config and provider_member(config and 0 and "environment_executable"))
    set spool to provider_value(config and provider_member(config and 0 and "spool"))
    if string_length(helper) equals 0 or else string_length(interpreter) equals 0 or else string_length(program) equals 0 or else string_length(spool) equals 0:
        return result
    set decision to mlx_preflight(database and session and identity and body and port and helper and interpreter and program and model and spool and reserve and cancellation and batch)
    set changed to set_list(result and 0 and get_list(decision and 0))
    set changed to set_list(result and 8 and get_list(decision and 5))
    if archive_list_text(result and 0) equals "ready":
        set changed to set_list(result and 1 and get_list(decision and 2))
        set changed to set_list(result and 2 and get_list(decision and 2))
        set changed to set_list(result and 3 and get_list(decision and 3))
        set changed to set_list(result and 4 and get_list(decision and 4))
        set changed to set_list(result and 5 and get_list(decision and 1))
    return result

# Local inference admission only; remote adapters retain their original request.
define provider_scheduled_body with session as Str and identity as Str and body as Str returning Str:
    if string_index_of(session and "task:") equals 0 or else string_index_of(identity and "memory:") equals 0 or else string_index_of(identity and "compaction:") equals 0:
        set scheduled to provider_json_tokens(body)
        if provider_member(scheduled and 0 and "echo_background") >= 0:
            return body
        return concat(substring(body and 0 and string_length(body) - 1) and ",\"echo_background\":true}")
    return body
