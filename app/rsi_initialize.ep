import "lifecycle/controller_service"
import "web/devices"

# OS-authenticated bootstrap only. Creates the controller's own review identity,
# not an approval, and never imports runtime roles or conversation history.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set loaded to controller_configuration_load(get_argument(1))
    if not (archive_list_text(loaded and 0) equals "ready"):
        display archive_list_text(loaded and 0)
        return 2
    set database to controller_ledger_open(archive_list_text(loaded and 6) and archive_list_text(loaded and 7))
    if database equals 0:
        return 3
    set initialized to controller_schema_initialize(database and ep_sha256(archive_list_text(loaded and 1)))
    if not (initialized equals "initialized" or else initialized equals "already-initialized"):
        display initialized
        return 4
    set device to get_argument(2)
    set existing to history_collect_one(checkpoint_prepare(database and "SELECT device FROM echo_devices WHERE device=?;" and [device]))
    if archive_list_text(existing and 0) equals "end":
        set invitation to ptr_to_str(ep_uuid_v4())
        set credential to ptr_to_str(ep_uuid_v4())
        if web_pairing_invite(database and invitation) is not equal to 0 or else web_device_pair(database and invitation and device and "Installed RSI review worker" and credential) is not equal to 0:
            return 5
        set principal to concat("device:" and device)
        set granted to principal_host_role(database and "rsi-review-worker-enrollment" and principal and "admin" and "OS-authenticated controller setup; review-only dispatcher")
        if not (granted equals "recorded"):
            return 6
    else if not (archive_list_text(existing and 0) equals "found"):
        return 7
    display "initialized-review-worker-no-approval-recorded"
    return sql_close(database)
