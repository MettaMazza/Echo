import "archive/snapshot"

define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Supply backup or restore, the source database, and a new destination database."
        return 1
    if not file_exists(get_argument(2)) or else file_exists(get_argument(3)):
        display "Source must exist; destination must be new."
        return 1
    if get_argument(1) equals "restore":
        if archive_restore(get_argument(2) and get_argument(3)) is not equal to 0:
            return 1
    else if get_argument(1) equals "backup":
        set database to sql_open(get_argument(2))
        if database equals 0:
            return 1
        set result to archive_snapshot(database and get_argument(3))
        set closed to sql_close(database)
        if result is not equal to 0 or else closed is not equal to 0:
            return 1
    else:
        return 1
    display "Database snapshot verified. Includes stored device credentials and application state; external files and model weights are not included."
    return 0
