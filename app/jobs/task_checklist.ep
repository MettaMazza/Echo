import "delegation_run"

# The checklist is an immutable archive snapshot scoped to this run.
# A newer authenticated user or parent guidance event makes the old plan revisable.
define task_checklist_child with database as Int and run as Str returning Int:
    set schema to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE name='echo_delegations';"))
    if not (archive_list_text(schema and 0) equals "found"):
        return 0
    set row to history_collect_one(checkpoint_prepare(database and "SELECT child FROM echo_delegations WHERE child=?;" and [run]))
    return archive_list_text(row and 0) equals "found"

define task_checklist_read with database as Int and run as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT event FROM echo_events WHERE kind='task_checklist' AND json_extract(payload,'$.run_id')=? ORDER BY sequence DESC LIMIT 1;" and [run]))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    set event to archive_read_event(database and archive_list_text(row and 1))
    if event equals 0:
        return ""
    return archive_list_text(event and 3)

define task_checklist_state with database as Int and run as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT CASE WHEN EXISTS(SELECT 1 FROM echo_events g WHERE g.kind='user_guidance' AND json_extract(g.payload,'$.run_id')=?1 AND g.sequence>e.sequence) THEN 'revise' WHEN EXISTS(SELECT 1 FROM json_each(e.payload,'$.items') i WHERE json_extract(i.value,'$.status')='pending') THEN 'pending' ELSE 'complete' END FROM echo_events e WHERE e.kind='task_checklist' AND json_extract(e.payload,'$.run_id')=?1 ORDER BY e.sequence DESC LIMIT 1;" and [run]))
    if archive_list_text(row and 0) equals "found":
        return archive_list_text(row and 1)
    if task_checklist_child(database and run):
        return "missing"
    return "available"

# Full snapshots preserve item identity and collected evidence across restart and
# compaction. A retry uses the original tool call identity, not a second write.
define task_checklist_save with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    if run_authority_allows(database and run and "user") equals 0:
        return "{\"status\":\"not-authorized\"}"
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "{\"status\":\"invalid-arguments\"}"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "{\"status\":\"database-busy\"}"
    set identity to concat(run and concat(":checklist:" and call_id))
    set existing to history_collect_one(checkpoint_prepare(database and "SELECT event FROM echo_events WHERE event=?;" and [identity]))
    if archive_list_text(existing and 0) equals "found":
        set ignored to sql_execute(database and "ROLLBACK;")
        return "{\"status\":\"already-saved\"}"
    set prior to task_checklist_read(database and run)
    set state to task_checklist_state(database and run)
    set final_field to provider_member(tokens and 0 and "final_response")
    set final_text to ""
    if final_field >= 0:
        if not (provider_kind(tokens and final_field) equals "string") or else string_length(string_trim(provider_value(tokens and final_field))) equals 0:
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"invalid-final-response\"}"
        set final_text to provider_value(tokens and final_field)
        set stripped to history_collect_one(checkpoint_prepare(database and "SELECT json_remove(?1,'$.final_response');" and [arguments]))
        if not (archive_list_text(stripped and 0) equals "found"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"database-error\"}"
        set arguments to archive_list_text(stripped and 1)
    if provider_member(tokens and 0 and "updates") >= 0:
        # Merge under the same writer fence as validation and append. Omitted
        # IDs keep their exact saved requirement, status and evidence.
        set valid_updates to history_collect_one(checkpoint_prepare(database and "SELECT CASE WHEN json_type(?1,'$.updates')='array' AND json_array_length(?1,'$.updates')>0 AND NOT EXISTS(SELECT 1 FROM json_each(?1) WHERE key<>'updates') AND NOT EXISTS(SELECT 1 FROM json_each(?1,'$.updates') u WHERE json_type(u.value)<>'object' OR COALESCE(json_type(u.value,'$.id'),'')<>'text' OR COALESCE(json_extract(u.value,'$.status'),'') NOT IN ('pending','done','unresolved') OR COALESCE(json_type(u.value,'$.evidence'),'')<>'text' OR EXISTS(SELECT 1 FROM json_each(u.value) WHERE key NOT IN ('id','status','evidence')) OR NOT EXISTS(SELECT 1 FROM json_each(?2,'$.items') old WHERE json_extract(old.value,'$.id')=json_extract(u.value,'$.id'))) AND (SELECT COUNT(*) FROM json_each(?1,'$.updates'))=(SELECT COUNT(DISTINCT json_extract(value,'$.id')) FROM json_each(?1,'$.updates')) THEN 'valid' ELSE 'invalid' END;" and [arguments,prior]))
        if string_length(prior) equals 0 or else not (archive_list_text(valid_updates and 1) equals "valid"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"invalid-checklist-update\",\"recovery\":\"Create items first; updates accept unique existing IDs, status and evidence only. Use a full items snapshot for an authorized scope revision.\"}"
        set merged to history_collect_one(checkpoint_prepare(database and "SELECT json_object('items',json_group_array(json(CASE WHEN u.value IS NULL THEN old.value ELSE json_set(old.value,'$.status',json_extract(u.value,'$.status'),'$.evidence',json_extract(u.value,'$.evidence')) END))) FROM json_each(?1,'$.items') old LEFT JOIN json_each(?2,'$.updates') u ON json_extract(old.value,'$.id')=json_extract(u.value,'$.id');" and [prior,arguments]))
        if not (archive_list_text(merged and 0) equals "found"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"database-error\"}"
        set arguments to archive_list_text(merged and 1)
    set valid to history_collect_one(checkpoint_prepare(database and "SELECT CASE WHEN json_type(?1)='object' AND json_type(?1,'$.items')='array' AND json_array_length(?1,'$.items')>0 AND NOT EXISTS(SELECT 1 FROM json_each(?1) WHERE key<>'items') AND NOT EXISTS(SELECT 1 FROM json_each(?1,'$.items') i WHERE json_type(i.value)<>'object' OR COALESCE(json_type(i.value,'$.id'),'')<>'text' OR length(trim(json_extract(i.value,'$.id')))=0 OR COALESCE(json_type(i.value,'$.requirement'),'')<>'text' OR length(trim(json_extract(i.value,'$.requirement')))=0 OR COALESCE(json_extract(i.value,'$.status'),'') NOT IN ('pending','done','unresolved') OR COALESCE(json_type(i.value,'$.evidence'),'')<>'text' OR (json_extract(i.value,'$.status')<>'pending' AND length(trim(json_extract(i.value,'$.evidence')))=0) OR EXISTS(SELECT 1 FROM json_each(i.value) WHERE key NOT IN ('id','requirement','status','evidence'))) AND (SELECT COUNT(*) FROM json_each(?1,'$.items'))=(SELECT COUNT(DISTINCT json_extract(value,'$.id')) FROM json_each(?1,'$.items')) THEN 'valid' ELSE 'invalid' END;" and [arguments]))
    if not (archive_list_text(valid and 1) equals "valid"):
        set ignored to sql_execute(database and "ROLLBACK;")
        return "{\"status\":\"invalid-checklist\",\"recovery\":\"Provide nonempty items with unique id, requirement, pending/done/unresolved status and evidence. Resolved items need observed evidence or an explicit limitation.\"}"
    if string_length(prior) > 0 and not (state equals "revise"):
        set removed to history_collect_one(checkpoint_prepare(database and "SELECT (SELECT abs(json_array_length(?1,'$.items')-json_array_length(?2,'$.items'))) + COUNT(*) FROM json_each(?1,'$.items') old WHERE NOT EXISTS(SELECT 1 FROM json_each(?2,'$.items') new WHERE json_extract(new.value,'$.id')=json_extract(old.value,'$.id'));" and [prior,arguments]))
        if not (archive_list_text(removed and 1) equals "0"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return concat("{\"status\":\"requirements-must-be-preserved\",\"effects\":\"none\",\"current_checklist\":" and concat(prior and ",\"recovery\":\"The proposed snapshot omitted or added an assigned requirement. Use current_checklist below, preserve its IDs and exact requirement text, and update status/evidence only. New authenticated guidance permits scope revisions; unchanged wording avoids inventing scope. No update was saved.\"}"))
    if string_length(prior) > 0 and not (state equals "revise"):
        set retained to history_collect_one(checkpoint_prepare(database and "SELECT json_object('items',json_group_array(json_set(new.value,'$.requirement',json_extract(old.value,'$.requirement')))) FROM json_each(?1,'$.items') new JOIN json_each(?2,'$.items') old ON json_extract(new.value,'$.id')=json_extract(old.value,'$.id');" and [arguments,prior]))
        if not (archive_list_text(retained and 0) equals "found"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"database-error\"}"
        set arguments to archive_list_text(retained and 1)
    if string_length(final_text) > 0:
        set pending to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM json_each(?1,'$.items') WHERE json_extract(value,'$.status')='pending';" and [arguments]))
        if not (archive_list_text(pending and 1) equals "0"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"requirements-still-pending\",\"recovery\":\"Resolve the assigned requirements before submitting a final response.\"}"
    set row to agent_run_read(database and run)
    if row equals 0:
        set ignored to sql_execute(database and "ROLLBACK;")
        return "{\"status\":\"run-unavailable\"}"
    set canonical to history_collect_one(checkpoint_prepare(database and "SELECT json_set(?1,'$.run_id',?2);" and [arguments,run]))
    set payload to archive_list_text(canonical and 1)
    if string_length(final_text) > 0:
        set with_reply to history_collect_one(checkpoint_prepare(database and "SELECT json_set(?1,'$.final_response',?2);" and [payload,final_text]))
        if not (archive_list_text(with_reply and 0) equals "found"):
            set ignored to sql_execute(database and "ROLLBACK;")
            return "{\"status\":\"database-error\"}"
        set payload to archive_list_text(with_reply and 1)

    if archive_append_pending(database and archive_list_text(row and 0) and identity and "task_checklist" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        set ignored to sql_execute(database and "ROLLBACK;")
        return "{\"status\":\"write-failed\"}"
    if sql_execute(database and "COMMIT;") is not equal to 0:
        set ignored to sql_execute(database and "ROLLBACK;")
        return "{\"status\":\"commit-failed\"}"
    return concat("{\"status\":\"saved\",\"checklist_state\":" and concat(provider_quote(task_checklist_state(database and run)) and "}"))
