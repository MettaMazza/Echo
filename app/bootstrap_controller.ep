import "lifecycle/controller_bootstrap"

define main returning Int:
    if get_argument_count() is not equal to 9:
        display "Usage: bootstrap_controller INPUT_MANIFEST INPUT_SHA256 SERVICE_MANIFEST SERVICE_SHA256 ROOT_PARENT DEVICE LABEL REASON. Installs and enrolls; does not activate a service or print credentials."
        return 1
    set result to controller_bootstrap_host(file_read(get_argument(1)) and get_argument(2) and file_read(get_argument(3)) and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(7) and get_argument(8))
    display result
    if result equals "installed-enrollment-recorded-not-activated":
        return 0
    return 1
