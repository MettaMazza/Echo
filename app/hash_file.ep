import "archive/file_digest"

define main returning Int:
    if get_argument_count() is not equal to 2:
        display "Supply a local file path."
        return 1
    set result to file_digest(get_argument(1) and 65536)
    if not (ptr_to_str(get_list(result and 0)) equals "verified"):
        display ptr_to_str(get_list(result and 0))
        return 1
    display ptr_to_str(get_list(result and 1))
    display int_to_string(get_list(result and 2))
    return 0
