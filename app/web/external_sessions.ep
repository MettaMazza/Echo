import "../providers/external_profiles"

# Render this exact disclosure before the owner explicitly agrees. Bind consent
# to its digest and immutable profile; never accept caller-authored disclosures.
define web_external_disclosure with profile as Str returning Str:
    set tokens to provider_json_tokens(profile)
    set family to provider_value(tokens and provider_member(tokens and 0 and "adapter"))
    set model to provider_value(tokens and provider_member(tokens and 0 and "model"))
    set text to concat("External inference: " and concat(family and concat(" / " and model)))
    return concat(text and ". This new conversation sends its messages, selected attachments and permitted tool results to this provider using your API account. Provider charges and data policies apply. Private local memories and other conversations are not automatically included. External-origin data and derived artifacts remain excluded from community/network sharing after disconnection. This choice does not change the local default or authorize other users to access your account.")

define web_external_session with database as Int and device as Str and tokens as List returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return external_discovery_error("invalid-arguments")
    set action to provider_value(tokens and provider_member(tokens and 0 and "action"))
    set fields to ["action","profile"]
    if action equals "grant":
        set fields to ["action","profile","session","disclosure_digest"]
    else if action equals "revoke":
        set fields to ["action","session"]
    else if not (action equals "preview"):
        return external_discovery_error("invalid-action")
    if anthropic_fields(tokens and 0 and fields) equals 0:
        return external_discovery_error("invalid-arguments")
    for each field in fields:
        if not (provider_kind(tokens and provider_member(tokens and 0 and field)) equals "string"):
            return external_discovery_error("invalid-arguments")
    if string_length(principal_for_device(database and device)) equals 0:
        return external_discovery_error("not-authorized")
    if external_profile_schema(database) is not equal to 0 or else external_scope_schema(database) is not equal to 0:
        return external_discovery_error("database-error")
    set session to provider_value(tokens and provider_member(tokens and 0 and "session"))
    if action equals "revoke":
        return external_discovery_error(external_scope_revoke(database and device and session))
    set identity to provider_value(tokens and provider_member(tokens and 0 and "profile"))
    set saved to external_profile_read(database and device and identity)
    if not (archive_list_text(saved and 0) equals "found"):
        return external_discovery_error("profile-unavailable")
    set profile to archive_list_text(saved and 2)
    set disclosure to web_external_disclosure(profile)
    set digest to ep_sha256(disclosure)
    if action equals "grant":
        if not (provider_value(tokens and provider_member(tokens and 0 and "disclosure_digest")) equals digest):
            return external_discovery_error("disclosure-mismatch")
        return external_discovery_error(external_scope_grant(database and device and session and ep_sha256(profile) and disclosure))
    set result to concat("{\"status\":\"preview\",\"profile\":" and provider_quote(identity))
    set result to concat(result and concat(",\"profile_digest\":" and provider_quote(ep_sha256(profile))))
    set result to concat(result and concat(",\"disclosure_digest\":" and provider_quote(digest)))
    return concat(result and concat(",\"disclosure\":" and concat(provider_quote(disclosure) and "}")))
