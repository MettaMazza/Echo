import "attachments"

# Private ownership stays unchanged. Shared observation uses membership in the
# recorded audience; controlling a run additionally requires its exact sender.
define web_shared_run_read_allowed with database as Int and device as Str and run as Str returning Int:
    if web_device_run_allowed(database and device and run) equals 1:
        return 1
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_run_origins';"))
    if not (archive_list_text(installed and 0) equals "found"):
        return 0
    set values to [run]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_group_run_origins WHERE run=?;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return 0
    return web_attachment_session_allowed(database and device and archive_list_text(row and 1) and 0)

define web_shared_run_control_allowed with database as Int and device as Str and run as Str returning Int:
    if web_device_run_allowed(database and device and run) equals 1:
        return 1
    if web_shared_run_read_allowed(database and device and run) equals 0 or else run_authority_allows(database and run and "user") equals 0:
        return 0
    set values to [run,device]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_group_run_origins WHERE run=?1 AND device=?2;" and values))
    return archive_list_text(row and 0) equals "found"
