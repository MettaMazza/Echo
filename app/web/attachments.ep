import "../archive/attachment_visibility"
import "../security/group_history"
import "../retained_text"
import "run_store"
import "../archive/file_digest"

define web_attachment_schema with database as Int returning Int:
    return sql_execute(database and "CREATE TABLE IF NOT EXISTS echo_attachments(attachment TEXT PRIMARY KEY,session TEXT NOT NULL REFERENCES echo_sessions(session),path TEXT NOT NULL UNIQUE,name TEXT NOT NULL,media_type TEXT NOT NULL,digest TEXT NOT NULL,bytes INTEGER NOT NULL CHECK(bytes>=0),event TEXT NOT NULL UNIQUE REFERENCES echo_events(event)); CREATE TRIGGER IF NOT EXISTS echo_attachment_no_update BEFORE UPDATE ON echo_attachments BEGIN SELECT RAISE(ABORT,'Attachment originals are immutable'); END; CREATE TRIGGER IF NOT EXISTS echo_attachment_no_delete BEFORE DELETE ON echo_attachments BEGIN SELECT RAISE(ABORT,'Attachment originals are immutable'); END; CREATE TABLE IF NOT EXISTS echo_attachment_derivations(attachment TEXT PRIMARY KEY REFERENCES echo_attachments(attachment),parent TEXT NOT NULL REFERENCES echo_attachments(attachment),event TEXT NOT NULL UNIQUE REFERENCES echo_events(event),CHECK(attachment<>parent)); CREATE TRIGGER IF NOT EXISTS echo_attachment_derivation_no_update BEFORE UPDATE ON echo_attachment_derivations BEGIN SELECT RAISE(ABORT,'Attachment lineage is immutable'); END; CREATE TRIGGER IF NOT EXISTS echo_attachment_derivation_no_delete BEFORE DELETE ON echo_attachment_derivations BEGIN SELECT RAISE(ABORT,'Attachment lineage is immutable'); END;")


# Session IDs are opaque references, not authority. Shared reads require this
# authenticated principal in the recorded audience and still joined now;
# publication additionally requires the current audience revision.
define web_attachment_session_allowed with database as Int and device as Str and session as Str and writing as Int returning Int:
    if web_device_session_allowed(database and device and session) equals 1:
        return 1
    if not (writing equals 0 or else writing equals 1) or else principal_device_active(database and device) equals 0:
        return 0
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_sessions';"))
    if not (archive_list_text(installed and 0) equals "found") or else group_history_allows(database and session) equals 0:
        return 0
    set values to [device,session,int_to_string(writing)]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT s.session FROM echo_group_sessions s JOIN echo_group_audiences a ON a.group_id=s.group_id AND a.revision=s.revision JOIN echo_principal_devices d ON d.principal=a.principal WHERE d.device=?1 AND s.session=?2 AND (SELECT state FROM echo_group_membership WHERE group_id=s.group_id AND principal=a.principal ORDER BY revision DESC LIMIT 1)='joined' AND (?3='0' OR s.revision=(SELECT MAX(revision) FROM echo_group_membership WHERE group_id=s.group_id));" and values))
    return archive_list_text(row and 0) equals "found"

# Host-only storage primitive. Path must be a closed, exclusively owned staging
# file; browser names are metadata, never filesystem paths. Publication and
# ownership recheck commit with the original attachment event.
define web_attachment_register with database as Int and device as Str and session as Str and attachment as Str and path as Str and name as Str and media_type as Str returning Int:
    return web_attachment_register_call(database and device and session and attachment and path and name and media_type and "" and "")

# Tool-generated publication can bind the exact running call. The check shares
# the writer transaction with registration, so changed authority cannot publish
# a staged file merely because the device still belongs to the session.
define web_attachment_register_call with database as Int and device as Str and session as Str and attachment as Str and path as Str and name as Str and media_type as Str and run as Str and call_id as Str returning Int:
    return web_attachment_register_derived_call(database and device and session and attachment and path and name and media_type and run and call_id and "")

# Exact derived-source lineage and publication share one transaction. Failed
# lineage persistence cannot leave a published unlabelled video sample.
define web_attachment_register_derived_call with database as Int and device as Str and session as Str and attachment as Str and path as Str and name as Str and media_type as Str and run as Str and call_id as Str and parent as Str returning Int:
    return web_attachment_publish(database and device and session and attachment and path and name and media_type and run and call_id and parent and 0)

# Host transport decoder only: cannot cross session boundaries. The original
# remains immutable; decoded waveform and its exact parent are committed together.
define web_attachment_register_decoded_import with database as Int and device as Str and session as Str and attachment as Str and path as Str and name as Str and parent as Str returning Int:
    if string_length(parent) equals 0:
        return 1
    return web_attachment_publish(database and device and session and attachment and path and name and "audio/wav" and "" and "" and parent and 1)

define web_attachment_publish with database as Int and device as Str and session as Str and attachment as Str and path as Str and name as Str and media_type as Str and run as Str and call_id as Str and parent as Str and imported as Int returning Int:
    if string_length(attachment) equals 0 or else string_length(name) equals 0 or else string_length(path) equals 0:
        return 1
    if get_character(path and 0) is not equal to 47 or else web_attachment_session_allowed(database and device and session and 1) is not equal to 1:
        return 1
    set verified to file_digest(path and 65536)
    if not (archive_list_text(verified and 0) equals "verified"):
        return 1
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if web_attachment_session_allowed(database and device and session and 1) is not equal to 1:
        return archive_rollback(database)
    if string_length(run) > 0:
        set scope to [run,call_id,device,session]
        set call to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(e.payload,'$.name') FROM echo_tool_calls t JOIN echo_tool_authority a ON a.run=t.run AND a.call_id=t.call_id JOIN echo_events e ON e.event=t.request_event AND e.session=t.session WHERE t.run=?1 AND t.call_id=?2 AND a.device=?3 AND t.session=?4 AND t.state='running' AND e.kind='tool_call';" and scope))
        if not (archive_list_text(call and 0) equals "found") or else tool_policy_allows(database and run and call_id and archive_list_text(call and 1)) equals 0:
            return archive_rollback(database)
    if string_length(parent) > 0:
        set source to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_attachments WHERE attachment=?;" and [parent]))
        if (string_length(run) equals 0 and imported equals 0) or else not (archive_list_text(source and 0) equals "found") or else web_attachment_session_allowed(database and device and archive_list_text(source and 1) and 0) equals 0:
            return archive_rollback(database)
        if (imported equals 1 or else principal_session_active(database and session) equals 0) and not (archive_list_text(source and 1) equals session):
            return archive_rollback(database)
    set event to concat(attachment and ":attachment")
    set digest to archive_list_text(verified and 1)
    set bytes to int_to_string(get_list(verified and 2))
    set payload to concat("{\"attachment\":" and provider_quote(attachment))
    set payload to concat(payload and concat(",\"name\":" and provider_quote(name)))
    set payload to concat(payload and concat(",\"media_type\":" and provider_quote(media_type)))
    set payload to concat(payload and concat(",\"sha256\":" and provider_quote(digest)))
    set payload to concat(payload and concat(",\"bytes\":" and concat(provider_quote(bytes) and "}")))
    if archive_append_pending(database and session and event and "attachment" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return archive_rollback(database)
    set values to create_list()
    set added to append_list(values and attachment)
    set added to append_list(values and session)
    set added to append_list(values and path)
    set added to append_list(values and name)
    set added to append_list(values and media_type)
    set added to append_list(values and digest)
    set added to append_list(values and bytes)
    set added to append_list(values and event)
    if web_device_write(database and "INSERT INTO echo_attachments(attachment,session,path,name,media_type,digest,bytes,event) VALUES(?,?,?,?,?,?,?,?);" and values) is not equal to 0:
        return archive_rollback(database)
    if string_length(parent) > 0:
        set lineage to concat("{\"attachment\":" and concat(provider_quote(attachment) and concat(",\"parent\":" and concat(provider_quote(parent) and "}"))))
        set lineage_event to concat(event and ":derived")
        if archive_append_pending(database and session and lineage_event and "attachment_derivation" and lineage and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0 or else web_device_write(database and "INSERT INTO echo_attachment_derivations(attachment,parent,event) VALUES(?,?,?);" and [attachment,parent,lineage_event]) is not equal to 0:
            return archive_rollback(database)
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    return 0

# Resolve only through ownership joins; never expose host paths over HTTP.
define web_attachment_owned_snapshot with database as Int and device as Str and attachment as Str returning List:
    set values to [attachment]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT path,name,media_type,digest,CAST(bytes AS TEXT),session,event FROM echo_attachments WHERE attachment=?;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return row
    if web_attachment_session_allowed(database and device and archive_list_text(row and 6) and 0) is not equal to 1:
        return history_status("end")
    return row

define web_attachment_owned with database as Int and device as Str and attachment as Str returning List:
    if sql_execute(database and "SAVEPOINT echo_attachment_read;") is not equal to 0:
        return history_status("error")
    set result to web_attachment_owned_snapshot(database and device and attachment)
    if sql_execute(database and "RELEASE echo_attachment_read;") is not equal to 0:
        set ignored to sql_execute(database and "ROLLBACK TO echo_attachment_read;")
        set ignored to sql_execute(database and "RELEASE echo_attachment_read;")
        return history_status("error")
    return result

define web_attachment_list_snapshot with database as Int and device as Str and session as Str returning Str:
    if web_attachment_session_allowed(database and device and session and 0) is not equal to 1:
        return "{\"status\":\"not-found\"}"
    set values to create_list()
    set added to append_list(values and session)
    set added to append_list(values and device)
    set query to concat(session_scope_sql() and concat("SELECT json_object('attachment',a.attachment,'name',a.name,'media_type',a.media_type,'bytes',CAST(a.bytes AS TEXT),'sha256',a.digest,'event',a.event) FROM scopes s JOIN echo_attachments a ON a.session=s.session JOIN echo_session_owners o ON o.session=a.session JOIN echo_devices d ON d.device=o.device JOIN echo_events e ON e.event=a.event AND e.sequence<=s.boundary WHERE " and concat(principal_session_sql(database and "a.session" and "d.device") and " AND d.device=?2 AND d.revoked=0 ORDER BY e.sequence;")))
    if web_device_session_allowed(database and device and session) equals 0:
        set query to concat(attachment_shared_scope_sql() and "SELECT json_object('attachment',a.attachment,'name',a.name,'media_type',a.media_type,'bytes',CAST(a.bytes AS TEXT),'sha256',a.digest,'event',a.event) FROM shared_scopes s JOIN echo_attachments a ON a.session=s.session JOIN echo_events e ON e.event=a.event AND e.sequence<=s.boundary WHERE ?2<>'' ORDER BY e.sequence;")
    set statement to checkpoint_prepare(database and query and values)
    if statement equals 0:
        return "{\"status\":\"database-error\"}"
    set builder to create_builder()
    set added to builder_append(builder and "{\"status\":\"found\",\"attachments\":[")
    set count to 0
    repeat while 1 equals 1:
        set step to ep_sqlite3_step(statement)
        if step equals 101:
            break
        if step is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return "{\"status\":\"database-error\"}"
        if count is greater than 0:
            set added to builder_append(builder and ",")
        set item to ptr_to_str(ep_sqlite3_column_text(statement and 0))
        set fields to provider_json_tokens(item)
        set state to attachment_lifecycle_state(database and provider_value(fields and provider_member(fields and 0 and "attachment")))
        if not (archive_list_text(state and 0) equals "found"):
            set closed to ep_sqlite3_finalize(statement)
            return "{\"status\":\"database-error\"}"
        set item to substring(item and 0 and string_length(item) - 1)
        set item to concat(item and concat(",\"lifecycle\":{\"state\":" and concat(provider_quote(archive_list_text(state and 2)) and concat(",\"revision\":" and concat(provider_quote(archive_list_text(state and 1)) and "}}")))))
        set visibility to attachment_visibility_state(database and provider_value(fields and provider_member(fields and 0 and "attachment")))
        if not (archive_list_text(visibility and 0) equals "found"):
            set closed to ep_sqlite3_finalize(statement)
            return "{\"status\":\"database-error\"}"
        set item to substring(item and 0 and string_length(item) - 1)
        set item to concat(item and concat(",\"visibility\":{\"state\":" and concat(provider_quote(archive_list_text(visibility and 2)) and concat(",\"revision\":" and concat(provider_quote(archive_list_text(visibility and 1)) and "}}")))))
        set inherited to 0
        if archive_list_text(visibility and 2) equals "included" and attachment_context_included(database and provider_value(fields and provider_member(fields and 0 and "attachment"))) equals 0:
            set inherited to 1
        set item to concat(substring(item and 0 and string_length(item) - 1) and concat(",\"inherited_exclusion\":" and concat(int_to_string(inherited) and "}")))
        set added to builder_append(builder and item)
        set count to count + 1
    if ep_sqlite3_finalize(statement) is not equal to 0:
        return "{\"status\":\"database-error\"}"
    set added to builder_append(builder and "]}")
    return ptr_to_str(builder_to_string(builder))

define web_attachment_list with database as Int and device as Str and session as Str returning Str:
    if sql_execute(database and "SAVEPOINT echo_attachment_list;") is not equal to 0:
        return "{\"status\":\"database-error\"}"
    set result to web_attachment_list_snapshot(database and device and session)
    if sql_execute(database and "RELEASE echo_attachment_list;") is not equal to 0:
        set ignored to sql_execute(database and "ROLLBACK TO echo_attachment_list;")
        set ignored to sql_execute(database and "RELEASE echo_attachment_list;")
        return "{\"status\":\"database-error\"}"
    return result
