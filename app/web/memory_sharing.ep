import "../memory/sharing"

# Device comes from bearer authentication, never the JSON body. This route is
# intentionally absent from model tool discovery and dispatch.
define web_memory_share with database as Int and device as Str and tokens as List returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "{\"status\":\"invalid-arguments\"}"
    for each key in ["action","source_event","destination"]:
        if not (provider_kind(tokens and provider_member(tokens and 0 and key)) equals "string"):
            return "{\"status\":\"invalid-arguments\"}"
    set action to provider_value(tokens and provider_member(tokens and 0 and "action"))
    set source to provider_value(tokens and provider_member(tokens and 0 and "source_event"))
    set destination to provider_value(tokens and provider_member(tokens and 0 and "destination"))
    if action equals "preview":
        return memory_share_preview(database and device and source and destination)
    if not (action equals "commit"):
        return "{\"status\":\"invalid-action\"}"
    for each key in ["identity","review_digest"]:
        if not (provider_kind(tokens and provider_member(tokens and 0 and key)) equals "string"):
            return "{\"status\":\"review-required\"}"
    set identity to provider_value(tokens and provider_member(tokens and 0 and "identity"))
    set result to memory_share_commit(database and device and identity and source and destination and provider_value(tokens and provider_member(tokens and 0 and "review_digest")))
    set output to concat("{\"status\":" and provider_quote(result))
    if result equals "recorded" or else result equals "already-recorded":
        set output to concat(output and concat(",\"event\":" and provider_quote(concat("shared-source:" and identity))))
    return concat(output and "}")
