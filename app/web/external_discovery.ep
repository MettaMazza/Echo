import "external_accounts"
import "../providers/external_discovery_store"

# This endpoint is authenticated settings, never a conversation/model tool.
# No message, prompt, header, URL, executable or filesystem path is accepted.
define web_external_discovery with database as Int and device as Str and tokens as List and cancellation as Int and batch as Int returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else anthropic_fields(tokens and 0 and ["identity","account","model","cursor"]) equals 0:
        return external_discovery_error("invalid-arguments")
    for each field in ["identity","account","model","cursor"]:
        if not (provider_kind(tokens and provider_member(tokens and 0 and field)) equals "string"):
            return external_discovery_error("invalid-arguments")
    if string_length(principal_for_device(database and device)) equals 0:
        return external_discovery_error("not-authorized")
    set vault to web_external_vault()
    if not (archive_list_text(vault and 0) equals "ready"):
        return external_discovery_error("credential-storage-unavailable")
    set system to get_list(vault and 1)
    set directory to get_list(vault and 2)
    set errors to native_open_mode(system and "/dev/null" and 1 and 0)
    set response to external_discovery_error("transport-unavailable")
    if errors >= 0:
        set account to provider_value(tokens and provider_member(tokens and 0 and "account"))
        set identity to provider_value(tokens and provider_member(tokens and 0 and "identity"))
        set result to external_account_discover(database and device and account and identity and provider_value(tokens and provider_member(tokens and 0 and "model")) and provider_value(tokens and provider_member(tokens and 0 and "cursor")) and system and directory and errors and cancellation and batch)
        set response to archive_list_text(result and 0)
        # Never drop a live process owner when returning an HTTP error. On OS
        # cleanup failure retain supervision until the child is actually reaped.
        set transfer to get_list(result and 1)
        if transfer is not equal to 0:
            set idle to channel
            set waits to [idle]
            repeat while get_list(transfer and 1) is not equal to 0:
                set finished to external_transport_finish(database and concat("external-account:" and account) and identity and transfer and 0)
                if get_list(transfer and 1) is not equal to 0:
                    set waited to select(waits and 100)
        set closed to net_close(errors)
    set closed to net_close(directory)
    set unloaded to ep_dlclose(system)
    return response
