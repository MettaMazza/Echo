import "attachments"
import "device_links"
import "../archive/attachment_visibility"

# Reversible context visibility receipt; no originals are erased.
# HTTP callers use the same visibility receipt and scoped authority checks.
# Shared changes require the current audience; linked private devices resolve
# the original owner while preserving the actual actor in the receipt.
define web_attachment_visibility with database as Int and device as Str and tokens as List returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "invalid-arguments"
    for each key in ["action","attachment","identity","previous"]:
        if not (provider_kind(tokens and provider_member(tokens and 0 and key)) equals "string"):
            return "invalid-arguments"
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "action" or else key equals "attachment" or else key equals "identity" or else key equals "previous"):
            return "invalid-arguments"
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set action to provider_value(tokens and provider_member(tokens and 0 and "action"))
    if not (action equals "exclude" or else action equals "restore"):
        return "invalid-action"
    set attachment to provider_value(tokens and provider_member(tokens and 0 and "attachment"))
    set identity to provider_value(tokens and provider_member(tokens and 0 and "identity"))
    set previous to provider_value(tokens and provider_member(tokens and 0 and "previous"))
    if string_length(identity) equals 0 or else string_length(attachment) equals 0:
        return "invalid-identity"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "database-busy"
    set source to history_collect_one(checkpoint_prepare(database and "SELECT session,digest,event FROM echo_attachments WHERE attachment=?;" and [attachment]))
    set session to archive_list_text(source and 1)
    set owner to web_account_resource_device(database and device and "session" and session)
    if not (archive_list_text(source and 0) equals "found") or else principal_device_active(database and device) equals 0 or else web_attachment_session_allowed(database and owner and session and 1) equals 0:
        return migration_fail(database and "not-authorized")
    set state to "excluded"
    if action equals "restore":
        set state to "included"
    set event to concat("attachment-visibility:" and concat(device and concat(":" and identity)))
    set payload to concat("{\"attachment\":" and provider_quote(attachment))
    for each pair in [["state",state],["previous",previous],["actor",principal_for_device(database and device)],["device",device],["source_event",archive_list_text(source and 3)],["source_sha256",archive_list_text(source and 2)]]:
        set payload to concat(payload and concat("," and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1))))))
    set payload to concat(payload and ",\"effect\":\"The recorded state controls future use of this attachment and its identified source-derived context. Originals and audit receipts remain available for explicit human inspection and restoration. No deletion of backups, external copies or weights.\"}")
    set prior to history_collect_one(checkpoint_prepare(database and "SELECT session,kind,payload FROM echo_events WHERE event=?;" and [event]))
    if archive_list_text(prior and 0) equals "found":
        if archive_list_text(prior and 1) equals session and archive_list_text(prior and 2) equals "attachment_visibility" and archive_list_text(prior and 3) equals payload:
            if sql_execute(database and "COMMIT;") equals 0:
                return "already-recorded"
            return migration_fail(database and "commit-failed")
        return migration_fail(database and "identity-conflict")
    if not (archive_list_text(prior and 0) equals "end"):
        return migration_fail(database and "database-error")
    set current to attachment_visibility_state(database and attachment)
    if not (archive_list_text(current and 0) equals "found") or else not (archive_list_text(current and 1) equals previous):
        return migration_fail(database and "revision-conflict")
    if archive_append_pending(database and session and event and "attachment_visibility" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return migration_fail(database and "write-failed")
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "commit-failed")
    return "recorded"
