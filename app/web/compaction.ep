import "attachments"
import "devices"
import "../tools/compaction_tools"

define web_compaction_read with database as Int and device as Str and session as Str and arguments as Str returning Str:
    if web_attachment_session_allowed(database and device and session and 0) is not equal to 1:
        return "{\"status\":\"not-found\"}"
    return compaction_tool_read(database and session and arguments)
