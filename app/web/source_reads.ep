import "../retained_text"
import "../tools/history_tools"

# These are recorded reads, not an assertion that every answer claim is
# supported. Only successful observed attachment reads with matching provenance
# are exposed; model-written citation strings never create these references.
define web_run_source_reads with database as Int and session as Str and run as Str returning Str:
    set values to create_list()
    set added to append_list(values and session)
    set added to append_list(values and run)
    set statement to checkpoint_prepare(database and "SELECT a.attachment,a.event,a.digest,CAST(a.bytes AS TEXT),a.name,a.media_type,json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.offset'),json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.characters'),COALESCE(json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.page'),''),COALESCE(json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.representation'),'original-utf8'),e.event FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event AND e.session=t.session JOIN echo_events q ON q.event=t.request_event AND q.session=t.session JOIN echo_attachments a ON a.session=t.session AND a.attachment=json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.attachment') AND a.event=json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.event') AND a.digest=json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.sha256') WHERE t.session=?1 AND t.run=?2 AND t.state='observed' AND json_extract(CASE WHEN json_valid(q.payload) THEN q.payload ELSE '{}' END,'$.name')='attachment_read_text' AND json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.status')='found' AND CAST(json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.result.characters') AS INTEGER)>0 ORDER BY e.sequence;" and values)
    if statement equals 0:
        return ""
    set keys to create_list()
    set added to append_list(keys and "attachment")
    set added to append_list(keys and "event")
    set added to append_list(keys and "sha256")
    set added to append_list(keys and "bytes")
    set added to append_list(keys and "name")
    set added to append_list(keys and "media_type")
    set added to append_list(keys and "offset")
    set added to append_list(keys and "characters")
    set added to append_list(keys and "page")
    set added to append_list(keys and "representation")
    set added to append_list(keys and "observation")
    set builder to create_builder()
    set added to builder_append(builder and "[")
    set count to 0
    repeat while 1 equals 1:
        set step to ep_sqlite3_step(statement)
        if step equals 101:
            break
        if step is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return ""
        if count is greater than 0:
            set added to builder_append(builder and ",")
        set added to builder_append(builder and "{")
        set index to 0
        repeat while index is less than length_list(keys):
            if index is greater than 0:
                set added to builder_append(builder and ",")
            set added to builder_append(builder and concat(provider_quote(archive_list_text(keys and index)) and ":"))
            set added to builder_append(builder and provider_quote(ptr_to_str(ep_sqlite3_column_text(statement and index))))
            set index to index + 1
        set added to builder_append(builder and "}")
        set count to count + 1
    if ep_sqlite3_finalize(statement) is not equal to 0:
        return ""
    set added to builder_append(builder and "]")
    return ptr_to_str(builder_to_string(builder))


define web_message_audio with database as Int and session as Str and run as Str and source as Str returning Str:
    set retained_list_1 to create_list()
    set retained_item_1_0 to session
    set retained_added to append_list(retained_list_1 and retained_item_1_0)
    set retained_item_1_1 to run
    set retained_added to append_list(retained_list_1 and retained_item_1_1)
    set retained_item_1_2 to source
    set retained_added to append_list(retained_list_1 and retained_item_1_2)
    set values to retained_list_1
    set statement to checkpoint_prepare(database and "SELECT json_object('attachment',a.attachment,'event',a.event,'sha256',a.digest,'bytes',CAST(a.bytes AS TEXT),'name',a.name,'media_type',a.media_type) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event JOIN echo_attachments a ON a.attachment=json_extract(e.payload,'$.result.attachment') AND a.session=t.session WHERE t.session=?1 AND t.state='observed' AND json_extract(q.payload,'$.name') IN ('speech_synthesize','image_generate','attach_file','attachment_video') AND json_extract(e.payload,'$.result.status')='complete' AND (t.run=?2 OR json_extract(q.payload,'$.speech_source')=?3) ORDER BY e.sequence;" and values)
    if statement equals 0:
        return "[]"
    set builder to create_builder()
    set added to builder_append(builder and "[")
    set count to 0
    repeat while ep_sqlite3_step(statement) equals 100:
        if count > 0:
            set added to builder_append(builder and ",")
        set added to builder_append(builder and ptr_to_str(ep_sqlite3_column_text(statement and 0)))
        set count to count + 1
    set closed to ep_sqlite3_finalize(statement)
    set added to builder_append(builder and "]")
    return ptr_to_str(builder_to_string(builder))

# Fetched web sources are not read receipts or verified claims. The surrounding
# transcript route authorizes the conversation; every join remains in that
# session, with original body digest and archived fetch receipt bound exactly.
define web_run_research_sources with database as Int and session as Str and run as Str returning Str:
    set statement to checkpoint_prepare(database and "SELECT json_object('url',json_extract(s.value,'$.url'),'status',json_extract(e.payload,'$.result.status'),'observation',e.event,'receipt',z.event,'attachment',a.attachment,'event',a.event,'sha256',a.digest,'bytes',CAST(a.bytes AS TEXT),'name',a.name,'media_type',a.media_type) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event AND q.session=t.session AND q.kind='tool_call' JOIN echo_events e ON e.event=t.result_event AND e.session=t.session AND e.kind='tool_result' JOIN echo_events z ON z.event=json_extract(e.payload,'$.result.receipt') AND z.session=t.session AND z.kind='web_fetch_receipt' JOIN json_each(e.payload,'$.result.sources') s JOIN echo_attachments a ON a.session=t.session AND a.attachment=json_extract(s.value,'$.body') AND a.digest=json_extract(s.value,'$.body_sha256') WHERE t.session=?1 AND t.run=?2 AND t.state='observed' AND json_extract(q.payload,'$.name') IN ('web_fetch','web_search','web_follow') ORDER BY e.sequence,CAST(s.key AS INTEGER);" and [session,run])
    if statement equals 0:
        return ""
    set builder to create_builder()
    set added to builder_append(builder and "[")
    set count to 0
    repeat while 1 equals 1:
        set step to ep_sqlite3_step(statement)
        if step equals 101:
            break
        if step is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return ""
        if count > 0:
            set added to builder_append(builder and ",")
        set added to builder_append(builder and ptr_to_str(ep_sqlite3_column_text(statement and 0)))
        set count to count + 1
    if ep_sqlite3_finalize(statement) is not equal to 0:
        return ""
    set added to builder_append(builder and "]")
    return ptr_to_str(builder_to_string(builder))
