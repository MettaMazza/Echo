import "../retained_text"
import "http_api"
import "../archive/file_stage"

# Call only after device/session authorization. This consumes framed binary
# bytes directly; it never buffers the complete file or converts it to text.
define web_upload_stage with reader as List and request as List and path as Str and batch as Int returning List:
    set headers to get_list(request and 5)
    set content_type to web_header(headers and "content-type")
    set expect to web_header(headers and "expect")
    if not (archive_list_text(content_type and 0) equals "found") or else not (archive_list_text(content_type and 1) equals "application/octet-stream") or else not (archive_list_text(expect and 0) equals "missing"):
        return file_digest_result("unsupported-upload" and "" and 0)
    set library to get_list(reader and 0)
    set descriptor to file_stage_open(library and path)
    if descriptor is less than 0:
        return file_digest_result("staging-unavailable" and "" and 0)
    set body to http_body_create(archive_list_text(request and 3) and get_list(request and 4))
    set total to 0
    repeat while 1 equals 1:
        set piece to http_body_next(reader and body and batch)
        set status to archive_list_text(piece and 0)
        if status equals "done":
            break
        if not (status equals "data"):
            set closed to net_close(descriptor)
            return file_digest_result(status and "" and total)
        set bytes to get_list(piece and 2)
        if total is greater than 9223372036854775807 - bytes or else file_stage_write(library and descriptor and get_list(piece and 1) and bytes) is not equal to 0:
            set closed to net_close(descriptor)
            return file_digest_result("storage-failed" and "" and total)
        set total to total + bytes
    if file_stage_finish(library and descriptor) is not equal to 0:
        return file_digest_result("flush-failed" and "" and total)
    set checked to file_digest(path and batch)
    if not (archive_list_text(checked and 0) equals "verified") or else get_list(checked and 2) is not equal to total:
        return file_digest_result("verification-failed" and "" and total)
    return checked
