import "../providers/external_profiles"
import "../providers/external_profile_list"

# Authenticated settings only. Registration never grants session consent or
# selects a model implicitly; the stored profile contains no credentials.
define web_external_profile with database as Int and device as Str and tokens as List returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return external_discovery_error("invalid-arguments")
    set action to provider_value(tokens and provider_member(tokens and 0 and "action"))
    set fields to ["action","identity"]
    if action equals "list":
        set fields to ["action","account"]
    else if action equals "register":
        set fields to ["action","identity","label","account","discovery","model","options"]
    if anthropic_fields(tokens and 0 and fields) equals 0:
        return external_discovery_error("invalid-arguments")
    for each field in fields:
        if not (provider_kind(tokens and provider_member(tokens and 0 and field)) equals "string"):
            return external_discovery_error("invalid-arguments")
    if string_length(principal_for_device(database and device)) equals 0:
        return external_discovery_error("not-authorized")
    if external_profile_schema(database) is not equal to 0:
        return external_discovery_error("database-error")
    if action equals "list":
        return external_profile_list(database and device and provider_value(tokens and provider_member(tokens and 0 and "account")))
    set identity to provider_value(tokens and provider_member(tokens and 0 and "identity"))
    if action equals "register":
        set status to external_profile_register(database and device and identity and provider_value(tokens and provider_member(tokens and 0 and "label")) and provider_value(tokens and provider_member(tokens and 0 and "account")) and provider_value(tokens and provider_member(tokens and 0 and "discovery")) and provider_value(tokens and provider_member(tokens and 0 and "model")) and provider_value(tokens and provider_member(tokens and 0 and "options")))
        return external_discovery_error(status)
    if not (action equals "read"):
        return external_discovery_error("invalid-action")
    set saved to external_profile_read(database and device and identity)
    if not (archive_list_text(saved and 0) equals "found"):
        if archive_list_text(saved and 0) equals "error":
            return external_discovery_error("database-error")
        return external_discovery_error("profile-unavailable")
    set output to concat("{\"status\":\"found\",\"identity\":" and provider_quote(identity))
    set output to concat(output and concat(",\"label\":" and provider_quote(archive_list_text(saved and 1))))
    set output to concat(output and concat(",\"digest\":" and provider_quote(archive_list_text(saved and 3))))
    return concat(output and concat(",\"profile\":" and concat(archive_list_text(saved and 2) and "}")))
