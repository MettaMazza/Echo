import "../retained_text"
import "run_store"

# Read-only status derived from committed work belonging to this run and its
# current head. Do not infer progress percentages, expose model draft recaps,
# or attribute another conversation's activity to the requesting device.
define web_run_activity with database as Int and run as Str returning Str:
    set row to agent_run_read(database and run)
    if row equals 0:
        return "Run unavailable"
    set state to archive_list_text(row and 2)
    if state equals "completed":
        return "Completed"
    if state equals "cancelled":
        return "Stopped"
    if state equals "failed":
        return "Needs attention"
    if state equals "generating":
        return "Generating a reply"
    if state equals "tools":
        set retained_list_1 to create_list()
        set retained_item_1_0 to run
        set retained_added to append_list(retained_list_1 and retained_item_1_0)
        set values to retained_list_1
        set tool to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(e.payload,'$.name') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event AND e.session=t.session WHERE t.run=? AND t.state='running' ORDER BY e.sequence LIMIT 1;" and values))
        if archive_list_text(tool and 0) equals "found":
            set name to archive_list_text(tool and 1)
            if name equals "attachment_video":
                return "Inspecting video locally; sampled frames are recorded separately"
            if name equals "image_generate":
                return "Generating an image locally"
            if name equals "attachment_transcribe":
                return "Transcribing audio locally"
            if name equals "speech_synthesize":
                return "Creating a spoken reply locally"
            if name equals "workspace_execute":
                return "Running a workspace command"
            if name equals "session_get_compaction":
                return "Reading the saved recap"
            if name equals "session_rebuild_recap":
                return "Saving the recap rebuild request"
        return "Working through tool results"
    if not (state equals "ready"):
        return "Waiting for the run to continue"
    set retained_list_2 to create_list()
    set retained_item_2_0 to run
    set retained_added to append_list(retained_list_2 and retained_item_2_0)
    set values to retained_list_2
    set memory to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(e.payload,'$.stage') FROM echo_events e JOIN echo_runs r ON r.session=e.session WHERE r.run=? AND e.kind='memory_stage' AND json_extract(e.payload,'$.run_id')=r.run ORDER BY e.sequence DESC LIMIT 1;" and values))
    if archive_list_text(memory and 0) equals "found" and archive_list_text(memory and 1) equals "reading":
        return "Recalling earlier conversations and saving cross-session memories. The first import can take longer; original messages remain saved."
    set binding to history_collect_one(checkpoint_prepare(database and "SELECT b.session,json_extract(b.payload,'$.job') FROM echo_runs r JOIN echo_events b ON b.session=r.session AND b.kind='compaction_binding' AND json_extract(b.payload,'$.run_id')=r.run AND json_extract(b.payload,'$.parent_event')=r.last_event WHERE r.run=? ORDER BY b.sequence DESC LIMIT 1;" and values))
    if not (archive_list_text(binding and 0) equals "found"):
        return "Preparing context for the next step"
    set job to archive_list_text(binding and 2)
    set prefix to concat(job and ":")
    set retained_list_3 to create_list()
    set retained_item_3_0 to archive_list_text(binding and 1)
    set retained_added to append_list(retained_list_3 and retained_item_3_0)
    set retained_item_3_1 to prefix
    set retained_added to append_list(retained_list_3 and retained_item_3_1)
    set values to retained_list_3
    set activated to history_collect_one(checkpoint_prepare(database and "SELECT checkpoint FROM echo_active_context WHERE session=?1 AND substr(checkpoint,1,length(?2))=?2;" and values))
    if archive_list_text(activated and 0) equals "found":
        return "Recap saved; preparing to continue"
    set stage to history_collect_one(checkpoint_prepare(database and "SELECT event FROM echo_events WHERE session=?1 AND substr(event,1,length(?2))=?2 ORDER BY sequence DESC LIMIT 1;" and values))
    if not (archive_list_text(stage and 0) equals "found"):
        return "Preparing the conversation recap"
    set event to archive_list_text(stage and 1)
    set suffix to substring(event and string_length(prefix) and string_length(event) - string_length(prefix))
    if string_index_of(suffix and "candidate:") equals 0:
        return "Writing a detailed recap from original records"
    if string_index_of(suffix and "notes:") equals 0:
        return "Reading original history in parts"
    if string_index_of(suffix and "merge:") equals 0:
        return "Combining the saved recap notes"
    if string_index_of(suffix and "fragment-review:") equals 0 or else string_index_of(suffix and "review:") equals 0:
        return "Checking the recap against original records"
    if string_index_of(suffix and "synthesis:") equals 0:
        return "Checking the combined recap reviews"
    if string_index_of(suffix and "repair:") equals 0:
        return "Revising the recap from review findings"
    if string_index_of(suffix and "checkpoint:") equals 0:
        return "Verifying files and saving the reviewed recap"
    return "Preparing the conversation recap"

# A machine-readable observation of the current head only. Pending means saved
# work exists, not that a worker is alive; callers must also check worker status.
define web_run_compaction with database as Int and run as Str returning Str:
    set values to create_list()
    set added to append_list(values and run)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT b.session,json_extract(b.payload,'$.job'),CASE WHEN EXISTS(SELECT 1 FROM echo_active_context a WHERE a.session=r.session AND substr(a.checkpoint,1,length(json_extract(b.payload,'$.job'))+1)=json_extract(b.payload,'$.job')||':') THEN 'saved' ELSE 'pending' END FROM echo_runs r JOIN echo_events b ON b.session=r.session AND b.kind='compaction_binding' AND json_extract(b.payload,'$.run_id')=r.run AND json_extract(b.payload,'$.parent_event')=r.last_event WHERE r.run=? AND r.state='ready' ORDER BY b.sequence DESC LIMIT 1;" and values))
    if archive_list_text(row and 0) equals "error":
        return "{\"state\":\"unknown\"}"
    if not (archive_list_text(row and 0) equals "found"):
        return "{\"state\":\"inactive\"}"
    set result to concat("{\"state\":" and provider_quote(archive_list_text(row and 3)))
    set result to concat(result and concat(",\"session\":" and provider_quote(archive_list_text(row and 1))))
    set result to concat(result and concat(",\"job\":" and provider_quote(archive_list_text(row and 2))))
    return concat(result and "}")
