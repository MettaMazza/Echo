import "../interaction/autonomy"
import "shared_access"
import "../retained_text"
import "http_api"
import "select"

define web_cancel_schema with database as Int returning Int:
    return sql_execute(database and "CREATE TABLE IF NOT EXISTS echo_cancel_requests(run TEXT PRIMARY KEY REFERENCES echo_runs(run),device TEXT NOT NULL REFERENCES echo_devices(device));")

# A durable request is distinct from completion. Only the owning active device
# may request it; the worker records the actual terminal transition.
define web_cancel_request with database as Int and device as Str and run as Str returning Int:
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if web_shared_run_control_allowed(database and device and run) equals 0:
        return archive_rollback(database)
    if autonomy_enabled(database and run) and autonomy_record_pending(database and run and concat(run and ":auto-user-stop") and 0 and "User pressed Stop") is not equal to 0:
        return archive_rollback(database)
    set values to [run,device]
    if tool_ledger_change(database and "INSERT INTO echo_cancel_requests(run,device) VALUES(?1,?2) ON CONFLICT(run) DO UPDATE SET device=excluded.device RETURNING run;" and values) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    return 0

# The monitor owns the cancellation writer. Closing it wakes a blocked native
# provider read/write/connect. A separate stop pipe ends the monitor when normal
# work finishes. Database failure also wakes the worker rather than leaving an
# uncancellable inference request running indefinitely.
define web_cancel_monitor with database_path as Str and run as Str and stop_reader as Int and cancellation_writer as Int and completed as Int returning Int:
    set database to archive_open(database_path)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set status to 0
    set idle to channel
    set waits to create_list()
    set added to append_list(waits and idle)
    if database equals 0 or else library equals 0:
        set status to 1
    else:
        repeat while 1 equals 1:
            if agent_cancellation_pending(library and stop_reader) is not equal to 0:
                break
            set node_status to node_run_status(database and run)
            if node_status < 0:
                # A transient read lock is not a Stop request or revocation.
                # Retry observation; dispatch still performs its own checks.
                set code to sqlite3_extended_errcode(database) modulo 256
                if code equals 5 or else code equals 6:
                    set waited to select(waits and 100)
                    continue
                set status to 1
                break
            if node_status equals 0:
                break
            set values to create_list()
            set added to append_list(values and run)
            set row to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_cancel_requests WHERE run=?;" and values))
            set found to archive_list_text(row and 0)
            if found equals "found":
                break
            if found equals "error":
                set code to sqlite3_extended_errcode(database) modulo 256
                if code equals 5 or else code equals 6:
                    set waited to select(waits and 100)
                    continue
                set status to 1
                break
            # Responsiveness cadence, not an inference deadline or token cap.
            # Use the existing channel wait so this idle monitor cooperates
            # with allocation on the active inference worker.
            set waited to select(waits and 100)
    if database is not equal to 0:
        set status to status + sql_close(database)
    if library is not equal to 0:
        set status to status + ep_dlclose(library)
    set status to status + net_close(cancellation_writer)
    set status to status + net_close(stop_reader)
    send status to completed
    return status

# Idempotent guidance intake. No cancellation and no new run are created.
define web_guidance_request with database as Int and device as Str and run as Str and identity as Str and message as Str returning Int:
    if string_length(identity) equals 0 or else string_length(message) equals 0:
        return 1
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if web_shared_run_control_allowed(database and device and run) equals 0:
        return archive_rollback(database)
    set row to agent_run_read(database and run)
    if row equals 0:
        return archive_rollback(database)
    set event to concat(run and concat(":guidance:" and identity))
    set payload to concat(agent_event_envelope(run and archive_list_text(row and 1)) and concat(",\"message\":" and concat(provider_quote(message) and "}")))
    set existing to archive_read_event(database and event)
    if existing is not equal to 0:
        if not (archive_list_text(existing and 3) equals payload):
            return archive_rollback(database)
    else:
        set state to archive_list_text(row and 2)
        if not (state equals "ready" or else state equals "generating" or else state equals "tools"):
            return archive_rollback(database)
        if archive_append_pending(database and archive_list_text(row and 0) and event and "guidance_received" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
            return archive_rollback(database)
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    return 0
