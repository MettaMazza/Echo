# Only committed stage receipts are presented here. Recap draft contents stay
# in their original archive, not in a status explanation or progress estimate.
define web_compaction_trace_text with kind as Str returning Str:
    if kind equals "compaction_binding":
        return "Preparing a reviewed conversation recap so this turn can continue. Original messages and source records remain saved."
    if kind equals "recap_fragment_notes":
        return "Saved notes from a portion of the original history."
    if kind equals "recap_merge_progress":
        return "Saved progress combining the history notes."
    if kind equals "recap_candidate":
        return "Recap draft recorded; review is still required."
    if kind equals "recap_fragment_review" or else kind equals "recap_review":
        return "Recorded a recap review against the original sources. This does not by itself establish acceptance."
    if kind equals "recap_review_synthesis":
        return "Combined the recap review findings."
    if kind equals "compaction_attachment_verification":
        return "Reviewed recap saved with attachment originals verified. Original messages remain available."
    return ""
