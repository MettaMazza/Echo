import "lifecycle/controller_bundle"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 5 or else not (get_argument(1) equals "check" or else get_argument(1) equals "stage" or else get_argument(1) equals "verify"):
        display "Usage: stage_controller check|stage|verify MANIFEST EXPECTED_SHA256 EXISTING_ROOT_OWNED_PARENT. Staging never activates a service."
        return 1
    if not file_exists(get_argument(2)):
        display "manifest-missing"
        return 1
    set manifest to file_read(get_argument(2))
    set result to controller_bundle_preflight(manifest and get_argument(3))
    if get_argument(1) equals "stage" and result equals "bytes-verified":
        set result to controller_bundle_stage(manifest and get_argument(3) and get_argument(4))
    if get_argument(1) equals "verify":
        set result to controller_bundle_verify(manifest and get_argument(3) and get_argument(4))
    display result
    if result equals "bytes-verified" or else result equals "staged-not-activated" or else result equals "verified-not-authorized-for-activation":
        return 0
    return 1
