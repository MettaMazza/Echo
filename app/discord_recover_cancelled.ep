import "discord/worker_store"
import "archive/runtime_lock"

# Host-only recovery of an interrupted claim invalidated by a retained source
# edit/deletion. Requires exclusive archive ownership; never reruns inference.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set journal to discord_store_open(get_argument(1) and get_argument(3))
    set database to discord_agent_open(get_argument(2) and get_argument(3))
    if journal equals 0 or else database equals 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to archive_runtime_lock(database and system)
    if lock < 0:
        return 3
    set values to create_list()
    set added to append_list(values and get_argument(4))
    set job to history_collect_one(checkpoint_prepare(journal and "SELECT j.cursor,i.payload FROM discord_agent_jobs j JOIN discord_inbox i ON i.identity=j.inbox WHERE j.inbox=? AND j.state='claimed';" and values))
    if not (archive_list_text(job and 0) equals "found"):
        return 4
    set source to provider_json_tokens(archive_list_text(job and 2))
    set message to provider_value(source and provider_member(source and 0 and "id"))
    set room to provider_value(source and provider_member(source and 0 and "channel_id"))
    set guild_id to provider_value(source and provider_member(source and 0 and "guild_id"))
    if discord_turn_barrier(journal and http_decimal(archive_list_text(job and 1)) and message and room and guild_id) is not equal to 1:
        return 5
    set run to concat("discord-message:" and message)
    set calls to create_list()
    set added to append_list(calls and run)
    set uncertain to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls WHERE run=? AND state='running';" and calls))
    if not (archive_list_text(uncertain and 0) equals "found") or else not (archive_list_text(uncertain and 1) equals "0"):
        return 6
    if agent_cancel_run(database and run) is not equal to 0:
        return 7
    if not (discord_worker_finish(journal and get_argument(4) and "cancelled-after-interruption-source-invalidated") equals "recorded"):
        return 8
    display "Recovered cancelled claim without inference or delivery."
    return 0
