import "lifecycle/controller_operations"

define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Usage: control_protected ROOT_OWNED_CONFIGURATION initialize|inspect|apply|reconcile|rollback|rollback-reconcile OPERATION_ID_OR_CONFIG_SHA256"
        return 1
    set result to controller_operation_host(get_argument(1) and get_argument(2) and get_argument(3))
    display result
    if result equals "initialized" or else result equals "already-initialized" or else result equals "applied" or else result equals "rolled-back" or else result equals "prepared" or else result equals "not-applied":
        return 0
    return 1
