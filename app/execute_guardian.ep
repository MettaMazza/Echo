import "tools/execution_tool"
import "context/compaction_lock"

# fd 3 is the exclusive owner pipe, inherited only by this guardian. The
# sandboxed command does not inherit it or gain access to the host archive.
define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set run to get_argument(2)
    set call_id to get_argument(3)
    set lock to compaction_lock_acquire(database and concat("execution-guardian:" and run) and library)
    if lock < 0:
        return 3
    set result to workspace_guardian_receipt(database and run and call_id)
    set status to 0
    if string_length(result) equals 0:
        set result to execution_tool_execute_local(database and run and call_id and 3)
        if string_length(result) equals 0 or else workspace_guardian_save(database and run and call_id and result) is not equal to 0:
            set status to 4
    set closed to net_close(lock)
    set closed to sql_close(database)
    set closed to ep_dlclose(library)
    return status
