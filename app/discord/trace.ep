import "job_origin"
import "../web/trace"

# The transport supplies the retained intake and bound run, never a destination
# proposed by the model. Reuse the browser's original-event reader so Discord
# shows the same reasoning deltas and tool receipts, including resumed parents.
# This projection grants no network access: delivery must separately refresh
# the source audience and bind a thread to that exact source message.
define discord_run_trace with journal as Int and database as Int and inbox as Str and run as Str and after as Int and events as Int returning Str:
    if string_length(inbox) equals 0 or else not (discord_job_origin(journal and database and run) equals inbox):
        return "{\"status\":\"scope-denied\"}"
    return web_run_trace(database and run and after and events)

# Discord's limit is characters; a UTF-8 byte bound below it is conservative.
# The caller persists page cursor and chunk offset independently, advancing
# only after confirmed delivery. Original archived text is never truncated.
define discord_trace_chunk with text as Str and offset as Int returning Str:
    if offset < 0 or else offset >= string_length(text) or else provider_valid_utf8(text) equals 0:
        return ""
    # Refuse a cursor inside a multi-byte code point.
    if provider_valid_utf8(substring(text and 0 and offset)) equals 0:
        return ""
    set count to string_length(text) - offset
    if count > 1800:
        set count to 1800
    repeat while count > 0 and also provider_valid_utf8(substring(text and offset and count)) equals 0:
        set count to count - 1
    return substring(text and offset and count)
