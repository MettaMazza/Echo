import "question_delivery"
import "question_sync"

# Discover actual pending archive requests, including delegated descendants.
# Every candidate must resolve through the same admitted Discord lineage;
# a run name, question text or requested destination never supplies authority.
define discord_question_scheduler_schema with journal as Int returning Int:
    if discord_question_pages_schema(journal) is not equal to 0 or else discord_worker_schema(journal) is not equal to 0 or else discord_delivery_schema(journal) is not equal to 0:
        return 1
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_question_schedule(run TEXT PRIMARY KEY,request TEXT NOT NULL,next_ms INTEGER NOT NULL DEFAULT 0,active INTEGER NOT NULL DEFAULT 1 CHECK(active IN (0,1)),status TEXT NOT NULL DEFAULT 'discovered');")

define discord_question_discover with journal as Int and database as Int returning Int:
    if web_cancel_schema(database) is not equal to 0:
        return 1
    set candidates to history_collect_one(archive_prepare(database and "SELECT json_group_array(json_object('run',r.run,'request',e.event)) FROM echo_events e JOIN echo_runs r ON r.run=json_extract(e.payload,'$.run_id') WHERE e.kind='user_input_requested' AND r.state IN ('ready','tools','generating') AND NOT EXISTS(SELECT 1 FROM echo_cancel_requests c WHERE c.run=r.run) AND NOT EXISTS(SELECT 1 FROM echo_events a WHERE a.sequence>e.sequence AND json_extract(a.payload,'$.run_id')=r.run AND a.kind IN ('guidance_received','user_guidance','user_input_answered'));"))
    if not (archive_list_text(candidates and 0) equals "found"):
        return 1
    set tokens to provider_json_tokens(archive_list_text(candidates and 1))
    if tokens equals 0:
        return 1
    for each candidate in provider_items(tokens and 0):
        set run to provider_value(tokens and provider_member(tokens and candidate and "run"))
        set request to provider_value(tokens and provider_member(tokens and candidate and "request"))
        if string_length(discord_job_origin(journal and database and run)) > 0:
            if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_question_schedule(run,request) VALUES(?1,?2) ON CONFLICT(run) DO UPDATE SET request=excluded.request,next_ms=0,active=1,status='discovered' WHERE discord_question_schedule.request<>excluded.request;" and [run,request]) and 101) is not equal to 0:
                return 1
    return 0

define discord_questions_tick with library as Str and token as Str and journal as Int and database as Int and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    if discord_question_scheduler_schema(journal) is not equal to 0 or else discord_question_discover(journal and database) is not equal to 0:
        return "question-discovery-failed"
    set now to ep_time_now_ms()
    set target to history_collect_one(checkpoint_prepare(journal and "SELECT run,request FROM discord_question_schedule WHERE active=1 AND next_ms<=CAST(?1 AS INTEGER) ORDER BY next_ms,rowid LIMIT 1;" and [int_to_string(now)]))
    set prepared to "questions-idle"
    if archive_list_text(target and 0) equals "found":
        set prepared to discord_question_page_prepare(journal and database and archive_list_text(target and 1))
        set active to "1"
        set delay to 1500
        if prepared equals "question-page-prepared":
            set delay to 500
        else if prepared equals "question-pages-ready":
            # Delivery has its own due queue; stop rerendering an unchanged batch.
            set active to "0"
        else if prepared equals "questions-not-pending" or else prepared equals "question-no-longer-pending" or else prepared equals "question-authority-denied":
            set active to "0"
        else if not (prepared equals "question-pages-ready"):
            set delay to 30000
        if archive_finish(checkpoint_prepare(journal and "UPDATE discord_question_schedule SET next_ms=CAST(?3 AS INTEGER),active=CAST(?4 AS INTEGER),status=?5 WHERE run=?1 AND request=?2;" and [archive_list_text(target and 1),archive_list_text(target and 2),int_to_string(now + delay),active,prepared]) and 101) is not equal to 0:
            return "store-failed"
    else if not (archive_list_text(target and 0) equals "end"):
        return "store-failed"
    if discord_worker_reconcile(journal) is not equal to 0:
        return "question-reconcile-held"
    set updated to discord_question_views_tick(library and token and journal and database and bot and guilds and admins and directory_path and stop_file)
    set due to discord_question_page_due(journal and ep_time_now_ms())
    if archive_list_text(due and 0) equals "end":
        return prepared
    if not (archive_list_text(due and 0) equals "found"):
        return "store-failed"
    return discord_question_page_deliver(library and token and journal and database and archive_list_text(due and 1) and bot and guilds and admins and directory_path and stop_file)
