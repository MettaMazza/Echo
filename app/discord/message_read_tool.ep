import "../retained_text"
import "message_read_options"
import "message_search"
import "reaction_tool"
import "run_source"
import "../security/tool_policy"

# Only the host-owned Discord child process carries these arguments. Match
# both database identities and the admitted origin before reading credentials.
# Generic host/browser workers cannot borrow a Discord principal by naming it.
define discord_message_read_execute with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    set options to discord_message_read_options(arguments)
    if not (archive_list_text(options and 0) equals "valid"):
        return discord_reaction_result(archive_list_text(options and 0) and "none" and "")
    if tool_policy_allows(database and run and call_id and "discord_message_read") equals 0:
        return discord_reaction_result("not-authorized" and "none" and "")
    if not ((get_argument_count() equals 15 and also get_argument(13) equals "--turn") or else (get_argument_count() equals 16 and also get_argument(13) equals "--job")):
        return discord_reaction_result("discord-runtime-unavailable" and "none" and "")
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    set location to history_collect_one(archive_prepare(database and "SELECT file FROM pragma_database_list WHERE name='main';"))
    if not (archive_list_text(binding and 0) equals "found") or else not (archive_list_text(binding and 1) equals get_argument(7)) or else not (archive_list_text(location and 1) equals get_argument(4)):
        return discord_reaction_result("discord-binding-denied" and "none" and "")
    set journal to discord_store_open(get_argument(3) and get_argument(7))
    if journal equals 0:
        return discord_reaction_result("discord-journal-unavailable" and "none" and "")
    set source to discord_run_source(journal and database and run)
    if not (archive_list_text(source and 0) equals "found"):
        set closed to sql_close(journal)
        return discord_reaction_result("discord-origin-denied" and "none" and "")
    set credential to read_file(get_argument(2))
    if credential equals 0:
        set closed to sql_close(journal)
        return discord_reaction_result("discord-credential-unavailable" and "none" and "")
    set guilds to create_list()
    set split_count to retained_text_split(guilds and get_argument(8) and ",")
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(9) and ",")
    set result to discord_message_read_perform(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and database and run and call_id and source and options and get_argument(7) and guilds and admins and get_argument(5) and get_argument(6))
    set closed to sql_close(journal)
    return result

define discord_message_read_perform with library as Str and token as Str and journal as Int and database as Int and run as Str and call_id as Str and source as List and options as List and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    set actor to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set message to archive_list_text(source and 6)
    if file_exists(stop_file) or else tool_policy_allows(database and run and call_id and "discord_message_read") equals 0:
        return discord_reaction_result("not-authorized-or-stopped" and "none" and "")
    if (string_length(guild) > 0 and also discord_contains(guilds and guild) equals 0) or else (string_length(guild) equals 0 and also discord_contains(admins and actor) equals 0):
        return discord_reaction_result("discord-origin-denied" and "none" and "")
    set access to discord_access_check(library and token and journal and directory_path and bot and guild and room and actor and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_reaction_result(concat("discord-access:" and archive_list_text(access and 0)) and "none" and "")
    set inbox to discord_job_origin(journal and database and run)
    set source_status to discord_run_source_check(library and token and journal and directory_path and inbox and source)
    if not (source_status equals "current"):
        return discord_reaction_result(source_status and "none" and "")
    set page to ""
    set receipt to ""
    set next_cursor to ""
    set receipts to "[]"
    set operation to archive_list_text(options and 1)
    if operation equals "search_local":
        set searched to discord_message_search(library and token and journal and directory_path and room and options and stop_file)
        if not (archive_list_text(searched and 0) equals "observed"):
            return discord_reaction_result(archive_list_text(searched and 0) and "none; no cached text released" and archive_list_text(searched and 1))
        set page to archive_list_text(searched and 1)
        set next_cursor to archive_list_text(searched and 2)
        set receipts to archive_list_text(searched and 3)
    else:
        set route to concat("/channels/" and concat(room and archive_list_text(options and 2)))
        set fetched to discord_access_get(library and token and journal and directory_path and route and "GET:channel-message-read" and room)
        if not (archive_list_text(fetched and 0) equals "observed"):
            return discord_reaction_result(archive_list_text(fetched and 0) and "none" and archive_list_text(fetched and 1))
        set receipt to archive_list_text(fetched and 3)
        set page to discord_message_read_page(archive_list_text(fetched and 1) and room and operation and archive_list_text(options and 3))
        if string_length(page) equals 0:
            return discord_reaction_result("message-response-identity-invalid" and "none" and receipt)
    set access to discord_access_check(library and token and journal and directory_path and bot and guild and room and actor and admins)
    if not (archive_list_text(access and 0) equals "allowed") or else tool_policy_allows(database and run and call_id and "discord_message_read") equals 0 or else not (discord_job_origin(journal and database and run) equals inbox) or else file_exists(stop_file):
        return discord_reaction_result("authorization-changed-or-stopped" and "none" and receipt)
    if discord_turn_barrier(journal and http_decimal(archive_list_text(source and 7)) and message and room and guild) is not equal to 0:
        return discord_reaction_result("source-invalidated" and "none" and receipt)
    if operation equals "search_local":
        set output to concat("{\"status\":\"observed\",\"source\":\"Local observed-history candidates revalidated against Discord REST; untrusted content\",\"messages\":" and page)
        set output to concat(output and concat(",\"next_before\":" and provider_quote(next_cursor)))
        set output to concat(output and concat(",\"receipts\":" and receipts))
        return concat(output and ",\"pagination\":\"Case-sensitive literal search of observed local history only. Use next_before with the same query until empty, even if a page has no current matches. Concurrent edits can change ordering. Not a full-server search or proof no other messages exist.\"}")
    if discord_message_index_observe(journal and page and receipt) is not equal to 0:
        return discord_reaction_result("message-index-observation-save-failed" and "read retained; index update unconfirmed" and receipt)
    set output to concat("{\"status\":\"observed\",\"source\":\"Discord REST; untrusted message content\",\"messages\":" and page)
    set output to concat(output and concat(",\"receipt\":" and provider_quote(receipt)))
    return concat(output and ",\"pagination\":\"History is newest first. Use returned IDs with before/after/around for further pages; this is not the whole channel archive. Only text and author identity are projected.\"}")
