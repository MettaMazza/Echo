import "steering_reaction"
import "steering_recovery"
import "run_barrier"

# Fixed host operation: the Gateway observation identifies a previously offered
# target. Live authorization and both source snapshots precede reservation.
# No UI confirmation is emitted here; only confirmed guidance permits a tick.
define discord_steering_reaction_tick with library as Str and token as Str and journal as Int and database as Int and identity as Str and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    set binding to discord_steering_reaction(journal and identity)
    if not (archive_list_text(binding and 0) equals "steering-intent"):
        return archive_list_text(binding and 0)
    set source to archive_list_text(binding and 1)
    set target to archive_list_text(binding and 2)
    set actor to archive_list_text(binding and 3)
    set room to archive_list_text(binding and 4)
    set guild to archive_list_text(binding and 5)
    if string_length(guild) > 0 and discord_contains(guilds and guild) equals 0:
        return "steering-guild-denied"
    if string_length(guild) equals 0 and discord_contains(admins and actor) equals 0:
        return "steering-dm-denied"
    set original to discord_intake_source(journal and source)
    set destination to discord_intake_source(journal and target)
    if not (archive_list_text(original and 0) equals "found") or else not (archive_list_text(destination and 0) equals "found") or else not (archive_list_text(destination and 3) equals actor) or else not (archive_list_text(destination and 4) equals room) or else not (archive_list_text(destination and 5) equals guild):
        return "steering-source-denied"
    set run to concat("discord-message:" and archive_list_text(destination and 6))
    if archive_list_text(destination and 1) equals "INTERACTION_CREATE":
        if discord_contains(admins and actor) equals 0:
            return "admin-required"
        set run to concat("discord-command:" and target)
    set recovered to discord_steering_release_invalidated(journal and database and source and run)
    if recovered equals "returned-to-queue":
        return recovered
    if not (discord_job_origin(journal and database and run) equals target):
        return "steering-run-unavailable"
    # Until media guidance preserves attachment provenance, leave such messages
    # in the ordinary queue. Never strip their media and submit only the words.
    if not (discord_attachment_manifest(archive_list_text(original and 2)) equals "[]"):
        return "steering-media-import-required"
    set access to discord_access_check(library and token and journal and directory_path and bot and guild and room and actor and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return concat("steering-access:" and archive_list_text(access and 0))
    set fresh to discord_run_source_check(library and token and journal and directory_path and source and original)
    if not (fresh equals "current"):
        return concat("steering-source:" and fresh)
    set fresh to discord_run_source_check(library and token and journal and directory_path and target and destination)
    if not (fresh equals "current"):
        return concat("steering-target:" and fresh)
    if file_exists(stop_file):
        return "stopped"
    if discord_run_barrier(journal and source and string_to_int(archive_list_text(original and 7)) and archive_list_text(original and 6) and room and guild) is not equal to 0 or else discord_run_barrier(journal and target and string_to_int(archive_list_text(destination and 7)) and archive_list_text(destination and 6) and room and guild) is not equal to 0:
        return "steering-source-invalidated"
    set reserved to discord_queue_offer_reserve(journal and source and actor)
    if not (reserved equals "reserved" or else reserved equals "already-reserved"):
        return reserved
    set applied to discord_steering_apply(journal and database and source and run and actor)
    if applied equals "guidance-not-accepted":
        set recovered to discord_steering_release_terminal(journal and database and source and run)
        if recovered equals "returned-to-queue":
            return recovered
    return applied
