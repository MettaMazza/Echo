import "attachment_control"

# The original interaction supplies identity; user options cannot impersonate
# a previous receipt. A listed conversation must own the selected attachment.
define discord_attachment_editor with database as Int and device as Str and guild as Str and room as Str and identity as Str and options as Str returning Str:
    set fields to provider_json_tokens(options)
    set action to provider_value(fields and provider_member(fields and 0 and "action"))
    set session to provider_value(fields and provider_member(fields and 0 and "session"))
    if action equals "list":
        return discord_attachment_list(database and device and guild and room and session)
    set attachment to provider_value(fields and provider_member(fields and 0 and "attachment"))
    set previous to provider_value(fields and provider_member(fields and 0 and "revision"))
    if string_length(attachment) equals 0:
        return "{\"status\":\"attachment-required\"}"
    set owner to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_attachments WHERE attachment=?;" and [attachment]))
    if not (archive_list_text(owner and 0) equals "found") or else not (archive_list_text(owner and 1) equals session):
        return "{\"status\":\"not-authorized\"}"
    set family to "lifecycle"
    set operation to "trash"
    set effect to "Removed from future attachment selection. Historical messages, original bytes, project references and recall remain preserved."
    if action equals "restore-selection":
        set operation to "restore"
        set effect to "Available for new attachment selection again. Context visibility is unchanged."
    else if action equals "exclude-context":
        set family to "visibility"
        set operation to "exclude"
        set effect to "Excluded from future attachment and identified source-derived context use. Originals and audit receipts remain for explicit inspection and restoration; backups, external copies and weights are not erased."
    else if action equals "restore-context":
        set family to "visibility"
        set operation to "restore"
        set effect to "Direct context inclusion restored. Any parent-source exclusion still applies. Selection state is unchanged."
    else if not (action equals "trash"):
        return "{\"status\":\"invalid-action\"}"
    set arguments to "{"
    for each pair in [["action",operation],["attachment",attachment],["identity",identity],["previous",previous]]:
        if string_length(arguments) > 1:
            set arguments to concat(arguments and ",")
        set arguments to concat(arguments and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1)))))
    set result to discord_attachment_request(database and device and guild and room and family and concat(arguments and "}"))
    set payload to concat("{\"status\":" and provider_quote(result))
    if result equals "recorded" or else result equals "already-recorded":
        set revision to concat("attachment-" and concat(family and concat(":" and concat(device and concat(":" and identity)))))
        for each pair in [["attachment",attachment],["action",action],["revision",revision],["effect",effect]]:
            set payload to concat(payload and concat("," and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1))))))
    return concat(payload and "}")
