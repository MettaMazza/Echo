import "rich_post"
import "routing"

# Structural limits come from Discord's machine-readable rule schemas. Values
# remain untrusted data; regular expressions are never executed on this host.
define discord_automod_text_array with fields as List and field as Int and maximum_items as Int and maximum_units as Int returning Int:
    if field < 0 or else provider_kind(fields and field) equals "null":
        return 1
    if not (provider_kind(fields and field) equals "["):
        return 0
    set index to field + 1
    set count to 0
    repeat while not (provider_kind(fields and index) equals "]"):
        set units to discord_rich_units(provider_value(fields and index))
        if not (provider_kind(fields and index) equals "string") or else units < 1 or else units > maximum_units:
            return 0
        set count to count + 1
        if count > maximum_items:
            return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return 1

define discord_automod_ids with fields as List and field as Int and maximum as Int returning Int:
    if field < 0 or else provider_kind(fields and field) equals "null":
        return 1
    if not (provider_kind(fields and field) equals "["):
        return 0
    set index to field + 1
    set count to 0
    set seen to create_list()
    repeat while not (provider_kind(fields and index) equals "]"):
        set identity to provider_value(fields and index)
        if not (provider_kind(fields and index) equals "string") or else discord_snowflake(identity) equals 0 or else discord_contains(seen and identity) equals 1:
            return 0
        set added to append_list(seen and identity)
        set count to count + 1
        if count > maximum:
            return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return 1

define discord_automod_metadata with fields as List and field as Int and trigger as Str returning Int:
    if field < 0 or else provider_kind(fields and field) equals "null":
        return trigger equals "1" or else trigger equals "3" or else trigger equals "5"
    set allowed to "|"
    if trigger equals "1" or else trigger equals "6":
        set allowed to "|keyword_filter|regex_patterns|allow_list|"
    else if trigger equals "4":
        set allowed to "|presets|allow_list|"
    else if trigger equals "5":
        set allowed to "|mention_total_limit|mention_raid_protection_enabled|"
    else if not (trigger equals "3"):
        return 0
    if discord_rich_keys(fields and field and allowed) equals 0:
        return 0
    set maximum_allow to 100
    if trigger equals "4":
        set maximum_allow to 1000
    if discord_automod_text_array(fields and provider_member(fields and field and "keyword_filter") and 1000 and 60) equals 0 or else discord_automod_text_array(fields and provider_member(fields and field and "regex_patterns") and 10 and 260) equals 0 or else discord_automod_text_array(fields and provider_member(fields and field and "allow_list") and maximum_allow and 60) equals 0:
        return 0
    set limit to provider_member(fields and field and "mention_total_limit")
    if limit >= 0 and also not (provider_kind(fields and limit) equals "null") and also discord_rich_integer(fields and limit and 0 and 50) equals 0:
        return 0
    set raid to provider_member(fields and field and "mention_raid_protection_enabled")
    if raid >= 0 and also not (provider_kind(fields and raid) equals "true" or else provider_kind(fields and raid) equals "false" or else provider_kind(fields and raid) equals "null"):
        return 0
    set presets to provider_member(fields and field and "presets")
    if presets >= 0 and also not (provider_kind(fields and presets) equals "null"):
        if not (provider_kind(fields and presets) equals "["):
            return 0
        set seen to create_list()
        set index to presets + 1
        repeat while not (provider_kind(fields and index) equals "]"):
            set value to provider_value(fields and index)
            if discord_rich_integer(fields and index and 1 and 3) equals 0 or else discord_contains(seen and value) equals 1:
                return 0
            set added to append_list(seen and value)
            set index to provider_after(fields and index)
            if index < 0:
                return 0
            if provider_kind(fields and index) equals ",":
                set index to index + 1
    return 1

define discord_automod_actions with fields as List and field as Int returning Int:
    if field < 0 or else provider_kind(fields and field) equals "null":
        return 1
    if not (provider_kind(fields and field) equals "["):
        return 0
    set index to field + 1
    set count to 0
    repeat while not (provider_kind(fields and index) equals "]"):
        if discord_rich_keys(fields and index and "|type|metadata|") equals 0:
            return 0
        set kind_field to provider_member(fields and index and "type")
        if discord_rich_integer(fields and kind_field and 1 and 4) equals 0:
            return 0
        set kind to provider_value(fields and kind_field)
        set metadata to provider_member(fields and index and "metadata")
        if metadata < 0 or else provider_kind(fields and metadata) equals "null":
            if kind equals "2" or else kind equals "3":
                return 0
        else:
            set allowed to "|"
            if kind equals "1":
                set allowed to "|custom_message|"
            else if kind equals "2":
                set allowed to "|channel_id|"
            else if kind equals "3":
                set allowed to "|duration_seconds|"
            if discord_rich_keys(fields and metadata and allowed) equals 0:
                return 0
            if kind equals "1":
                set custom to provider_member(fields and metadata and "custom_message")
                if custom >= 0 and also not (provider_kind(fields and custom) equals "null"):
                    set units to discord_rich_units(provider_value(fields and custom))
                    if not (provider_kind(fields and custom) equals "string") or else units < 0 or else units > 300:
                        return 0
            else if kind equals "2":
                set destination to provider_member(fields and metadata and "channel_id")
                if not (provider_kind(fields and destination) equals "string") or else discord_snowflake(provider_value(fields and destination)) equals 0:
                    return 0
            else if kind equals "3":
                set duration to provider_member(fields and metadata and "duration_seconds")
                if duration >= 0 and also not (provider_kind(fields and duration) equals "null") and also discord_rich_integer(fields and duration and 0 and 2419200) equals 0:
                    return 0
        set count to count + 1
        if count > 5:
            return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return count > 0
