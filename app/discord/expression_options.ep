import "expression_changes"
import "audit_reason"

# Flat fields avoid optional nested argument ordering in native tool grammars.
# Attachment is a retained scoped identifier, not a filesystem path or URL.
define discord_expression_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|kind|operation|resource|reason|observed_sha256|attachment|name|roles|description|tags|") equals 0:
        return history_status("invalid-expression-arguments")
    set strings to ["kind","operation","resource","reason","observed_sha256","attachment"]
    for each item in strings:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and also not (provider_kind(fields and field) equals "string"):
            return history_status("invalid-expression-string")
    set kind to provider_value(fields and provider_member(fields and 0 and "kind"))
    set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
    if not (kind equals "emoji" or else kind equals "sticker"):
        return history_status("invalid-expression-kind")
    if not (operation equals "list" or else operation equals "inspect" or else operation equals "create" or else operation equals "edit" or else operation equals "delete"):
        return history_status("invalid-expression-operation")
    set resource to provider_value(fields and provider_member(fields and 0 and "resource"))
    if operation equals "inspect" or else operation equals "edit" or else operation equals "delete":
        if discord_snowflake(resource) equals 0:
            return history_status("expression-resource-required")
    else if provider_member(fields and 0 and "resource") >= 0:
        return history_status("unused-expression-resource")
    set reason to provider_value(fields and provider_member(fields and 0 and "reason"))
    if operation equals "create" or else operation equals "edit" or else operation equals "delete":
        if string_length(discord_audit_reason(reason)) equals 0:
            return history_status("expression-reason-required")
    else if provider_member(fields and 0 and "reason") >= 0:
        return history_status("unused-expression-reason")
    set digest to provider_value(fields and provider_member(fields and 0 and "observed_sha256"))
    if operation equals "edit" or else operation equals "delete":
        if string_length(digest) is not equal to 64:
            return history_status("expression-observed-sha256-required")
        set index to 0
        repeat while index < 64:
            if string_contains("0123456789abcdef" and substring(digest and index and 1)) equals 0:
                return history_status("invalid-expression-sha256")
            set index to index + 1
    else if provider_member(fields and 0 and "observed_sha256") >= 0:
        return history_status("unused-expression-sha256")
    set attachment to provider_value(fields and provider_member(fields and 0 and "attachment"))
    if operation equals "create":
        if string_length(attachment) equals 0:
            return history_status("expression-attachment-required")
    else if provider_member(fields and 0 and "attachment") >= 0:
        return history_status("unused-expression-attachment")
    set keys to ["name","roles","description","tags"]
    set body to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            if count > 0:
                set body to concat(body and ",")
            set value to agent_json_source(arguments and fields and field)
            set body to concat(body and concat(provider_quote(key) and concat(":" and value)))
            set count to count + 1
    set body to concat(body and "}")
    if operation equals "create" or else operation equals "edit":
        set creating to 0
        if operation equals "create":
            set creating to 1
        if discord_expression_changes(body and kind and creating) equals 0:
            return history_status("invalid-expression-fields")
    else if count > 0:
        return history_status("unused-expression-fields")
    return ["valid",kind,operation,resource,reason,digest,body,attachment]
