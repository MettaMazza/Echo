import "gateway_journal"
import "gateway_protocol"

define discord_gateway_runtime_schema with database as Int returning Int:
    if discord_gateway_schema(database) is not equal to 0 or else discord_interaction_schema(database) is not equal to 0:
        return 1
    return sql_execute(database and "CREATE TABLE IF NOT EXISTS discord_resume(singleton INTEGER PRIMARY KEY CHECK(singleton=1),session TEXT NOT NULL,url TEXT NOT NULL,enabled INTEGER NOT NULL CHECK(enabled IN (0,1)));")

define discord_json_original with body as Str and tokens as List and index as Int returning Str:
    if index < 0:
        return ""
    set after to provider_after(tokens and index)
    if after <= index:
        return ""
    set start to get_list(get_list(tokens and index) and 1)
    set finish to get_list(get_list(tokens and after - 1) and 2)
    return substring(body and start and finish - start)

# READY establishes resumable state and its dispatch cursor in one transaction.
# A restart cannot pair a new session with an old sequence or resume endpoint.
define discord_gateway_ready_record with database as Int and generation as Str and bot as Str and body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "invalid-ready"
    set data to provider_member(tokens and 0 and "d")
    set user to provider_member(tokens and data and "user")
    set session to provider_value(tokens and provider_member(tokens and data and "session_id"))
    set url to provider_value(tokens and provider_member(tokens and data and "resume_gateway_url"))
    set sequence to provider_index(tokens and provider_member(tokens and 0 and "s"))
    if not (provider_index(tokens and provider_member(tokens and 0 and "op")) equals "0") or else not (provider_value(tokens and provider_member(tokens and 0 and "t")) equals "READY") or else not (provider_value(tokens and provider_member(tokens and user and "id")) equals bot) or else string_length(session) equals 0 or else string_length(sequence) equals 0 or else string_length(discord_gateway_endpoint(url)) equals 0 or else string_length(generation) equals 0:
        return "invalid-ready"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-unavailable"
    set previous to history_collect_one(archive_prepare(database and "SELECT generation FROM discord_gateway WHERE singleton=1;"))
    if archive_list_text(previous and 0) equals "found" and archive_list_text(previous and 1) equals generation:
        return migration_fail(database and "duplicate-ready")
    if not (archive_list_text(previous and 0) equals "found" or else archive_list_text(previous and 0) equals "end"):
        return migration_fail(database and "read-failed")
    set rooted_literal_1 to create_list()
    set retained_value_added to append_list(rooted_literal_1 and generation)
    set retained_value_added to append_list(rooted_literal_1 and session)
    set retained_value_added to append_list(rooted_literal_1 and sequence)
    if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_gateway(singleton,generation,session,sequence) VALUES(1,?,?,CAST(? AS INTEGER)) ON CONFLICT(singleton) DO UPDATE SET generation=excluded.generation,session=excluded.session,sequence=excluded.sequence;" and rooted_literal_1) and 101) is not equal to 0:
        return migration_fail(database and "bind-failed")
    set rooted_literal_2 to create_list()
    set retained_value_added to append_list(rooted_literal_2 and session)
    set retained_value_added to append_list(rooted_literal_2 and url)
    if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_resume(singleton,session,url,enabled) VALUES(1,?,?,1) ON CONFLICT(singleton) DO UPDATE SET session=excluded.session,url=excluded.url,enabled=1;" and rooted_literal_2) and 101) is not equal to 0:
        return migration_fail(database and "resume-write-failed")
    set retained_values_1 to create_list()
    set retained_value_added to append_list(retained_values_1 and session)
    set retained_value_added to append_list(retained_values_1 and sequence)
    set retained_value_added to append_list(retained_values_1 and ep_sha256(body))
    if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_dispatch(session,sequence,kind,digest) VALUES(?,CAST(? AS INTEGER),'READY',?);" and retained_values_1) and 101) is not equal to 0:
        return migration_fail(database and "receipt-failed")
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "commit-failed")
    return "recorded"

define discord_gateway_resume_read with database as Int returning List:
    return history_collect_one(archive_prepare(database and "SELECT g.session,r.url,g.sequence FROM discord_gateway g JOIN discord_resume r ON r.singleton=g.singleton AND r.session=g.session WHERE g.singleton=1 AND r.enabled=1;"))

# Resolve an edit/delete against the immutable admitted original. A partial
# event cannot invent its author, move channels or expose a foreign scope.
define discord_message_origin with database as Int and message as Str and room as Str and guilds as List and admins as List returning Str:
    if discord_snowflake(message) equals 0 or else discord_snowflake(room) equals 0:
        return ""
    set retained_values_2 to create_list()
    set retained_value_added to append_list(retained_values_2 and concat("message:create:" and message))
    set row to history_collect_one(checkpoint_prepare(database and "SELECT payload FROM discord_inbox WHERE identity=? AND kind='MESSAGE_CREATE';" and retained_values_2))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    set tokens to provider_json_tokens(archive_list_text(row and 1))
    set saved_room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set guild to provider_value(tokens and provider_member(tokens and 0 and "guild_id"))
    if provider_kind(tokens and provider_member(tokens and 0 and "guild_id")) equals "null":
        set guild to ""
    set author to provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "author") and "id"))
    if not (saved_room equals room):
        return ""
    if string_length(guild) > 0:
        if discord_contains(guilds and guild) equals 0:
            return ""
    else if discord_contains(admins and author) equals 0:
        return ""
    return archive_list_text(row and 1)

define discord_message_revision with database as Int and kind as Str and original as Str and guilds as List and admins as List returning Str:
    set tokens to provider_json_tokens(original)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set message to provider_value(tokens and provider_member(tokens and 0 and "id"))
    set prior to discord_message_origin(database and message and room and guilds and admins)
    if string_length(prior) equals 0:
        return ""
    set saved to provider_json_tokens(prior)
    set guild_index to provider_member(tokens and 0 and "guild_id")
    if guild_index >= 0 and not (provider_value(tokens and guild_index) equals provider_value(saved and provider_member(saved and 0 and "guild_id"))):
        return ""
    set author_index to provider_member(tokens and 0 and "author")
    if author_index >= 0:
        if not (provider_value(tokens and provider_member(tokens and author_index and "id")) equals provider_value(saved and provider_member(saved and provider_member(saved and 0 and "author") and "id"))):
            return ""
    if kind equals "MESSAGE_DELETE":
        return concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and "}"))))
    # An edit is retained as a patch, never mistaken for a complete message.
    # Consumer must preserve absent fields and keep every prior revision.
    return original

# Reactions are transport observations, never permission grants. Retain only
# reactions to admitted source messages, excluding the bot's own UI markers.
# The control worker must still bind the intended run and recheck live access.
define discord_reaction_observation with database as Int and bot as Str and original as Str and guilds as List and admins as List returning Str:
    set tokens to provider_json_tokens(original)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set message to provider_value(tokens and provider_member(tokens and 0 and "message_id"))
    set actor to provider_value(tokens and provider_member(tokens and 0 and "user_id"))
    if discord_snowflake(actor) equals 0 or else actor equals bot:
        return ""
    set prior to discord_message_origin(database and message and room and guilds and admins)
    if string_length(prior) equals 0:
        return ""
    set saved to provider_json_tokens(prior)
    set source_guild to provider_value(saved and provider_member(saved and 0 and "guild_id"))
    set guild to provider_value(tokens and provider_member(tokens and 0 and "guild_id"))
    if provider_kind(saved and provider_member(saved and 0 and "guild_id")) equals "null":
        set source_guild to ""
    if provider_kind(tokens and provider_member(tokens and 0 and "guild_id")) equals "null":
        set guild to ""
    if not (source_guild equals guild):
        return ""
    set author to provider_value(saved and provider_member(saved and provider_member(saved and 0 and "author") and "id"))
    if string_length(guild) equals 0:
        if not (actor equals author) or else discord_contains(admins and actor) equals 0:
            return ""
    else if not (actor equals author) and discord_contains(admins and actor) equals 0:
        return ""
    set emoji to provider_member(tokens and 0 and "emoji")
    set emoji_id to provider_value(tokens and provider_member(tokens and emoji and "id"))
    if provider_kind(tokens and provider_member(tokens and emoji and "id")) equals "null":
        set emoji_id to ""
    set name to provider_value(tokens and provider_member(tokens and emoji and "name"))
    if string_length(emoji_id) > 0 and discord_snowflake(emoji_id) equals 0:
        return ""
    if string_length(name) equals 0 or else string_length(name) > 128:
        return ""
    set result to concat("{\"channel_id\":" and provider_quote(room))
    set result to concat(result and concat(",\"message_id\":" and provider_quote(message)))
    set result to concat(result and concat(",\"user_id\":" and provider_quote(actor)))
    set result to concat(result and concat(",\"guild_id\":" and provider_quote(guild)))
    set result to concat(result and concat(",\"emoji_id\":" and provider_quote(emoji_id)))
    return concat(result and concat(",\"emoji_name\":" and concat(provider_quote(name) and "}")))

# Intake does not invoke the model. A separate scoped worker claims admitted
# messages and rechecks current channel permissions before inference/delivery.
# Ignored events advance the resume cursor without retaining their text.
define discord_gateway_intake with database as Int and generation as Str and bot as Str and guilds as List and admins as List and body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "invalid-dispatch"
    set sequence to provider_index(tokens and provider_member(tokens and 0 and "s"))
    set kind to provider_value(tokens and provider_member(tokens and 0 and "t"))
    if not (provider_index(tokens and provider_member(tokens and 0 and "op")) equals "0") or else string_length(sequence) equals 0 or else string_length(kind) equals 0:
        return "invalid-dispatch"
    set current to history_collect_one(archive_prepare(database and "SELECT session FROM discord_gateway WHERE singleton=1;"))
    if not (archive_list_text(current and 0) equals "found"):
        return "session-unavailable"
    set identity to ""
    set payload to ""
    if kind equals "INTERACTION_CREATE":
        set data to provider_member(tokens and 0 and "d")
        set original to discord_json_original(body and tokens and data)
        set identity to discord_interaction_admit(original and bot and guilds and admins)
        if string_length(identity) > 0:
            set payload to original
    else if kind equals "MESSAGE_CREATE":
        set data to provider_member(tokens and 0 and "d")
        set original to discord_json_original(body and tokens and data)
        set room to provider_value(tokens and provider_member(tokens and data and "channel_id"))
        set reference to provider_member(tokens and data and "message_reference")
        set target to provider_value(tokens and provider_member(tokens and reference and "message_id"))
        set known to discord_reply_channel(database and target and room)
        set route to discord_message_route(original and bot and guilds and admins and known)
        set author to provider_value(tokens and provider_member(tokens and provider_member(tokens and data and "author") and "id"))
        set nonce to provider_value(tokens and provider_member(tokens and data and "nonce"))
        if author equals bot and string_length(nonce) > 0:
            set rooted_literal_3 to create_list()
            set retained_value_added to append_list(rooted_literal_3 and room)
            set retained_value_added to append_list(rooted_literal_3 and nonce)
            set delivery to history_collect_one(checkpoint_prepare(database and "SELECT identity FROM discord_outbox WHERE channel=?1 AND nonce=?2 AND state IN ('sending','uncertain','sent');" and rooted_literal_3))
            if archive_list_text(delivery and 0) equals "found":
                # This is delivery evidence, never an incoming user turn.
                # The worker resolves the nonce-bound outbox before inference.
                set identity to concat("delivery:observed:" and provider_value(tokens and provider_member(tokens and data and "id")))
                set payload to original
            else if not (archive_list_text(delivery and 0) equals "end"):
                return "delivery-observation-read-failed"
        else if archive_list_text(route and 0) equals "accepted":
            set identity to concat("message:create:" and archive_list_text(route and 4))
            set payload to original
        else if archive_list_text(route and 0) equals "redirect-dm":
            set identity to concat("message:redirect:" and archive_list_text(route and 4))
            set payload to concat("{\"admission\":\"redirect-dm\",\"id\":" and provider_quote(archive_list_text(route and 4)))
            set payload to concat(payload and concat(",\"channel_id\":" and provider_quote(room)))
            set payload to concat(payload and concat(",\"author_id\":" and concat(provider_quote(archive_list_text(route and 3)) and "}")))
    else if kind equals "MESSAGE_REACTION_ADD" or else kind equals "MESSAGE_REACTION_REMOVE":
        set data to provider_member(tokens and 0 and "d")
        set payload to discord_reaction_observation(database and bot and discord_json_original(body and tokens and data) and guilds and admins)
        if string_length(payload) > 0:
            set identity to concat("reaction:" and concat(ep_sha256(archive_list_text(current and 1)) and concat(":" and sequence)))
    else if kind equals "MESSAGE_UPDATE" or else kind equals "MESSAGE_DELETE":
        set data to provider_member(tokens and 0 and "d")
        set payload to discord_message_revision(database and kind and discord_json_original(body and tokens and data) and guilds and admins)
        if string_length(payload) > 0:
            set identity to concat("revision:" and concat(ep_sha256(archive_list_text(current and 1)) and concat(":" and sequence)))
    else if kind equals "MESSAGE_DELETE_BULK":
        set data to provider_member(tokens and 0 and "d")
        set room to provider_value(tokens and provider_member(tokens and data and "channel_id"))
        set ids to provider_items(tokens and provider_member(tokens and data and "ids"))
        set admitted to ""
        for each entry in ids:
            set message to provider_value(tokens and entry)
            set deletion to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and "}"))))
            set guild_index to provider_member(tokens and data and "guild_id")
            if guild_index >= 0:
                set deletion to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":" and concat(provider_quote(provider_value(tokens and guild_index)) and "}"))))))
            if string_length(discord_message_revision(database and "MESSAGE_DELETE" and deletion and guilds and admins)) > 0:
                if string_length(admitted) > 0:
                    set admitted to concat(admitted and ",")
                set admitted to concat(admitted and provider_quote(message))
        if string_length(admitted) > 0:
            set identity to concat("revision:" and concat(ep_sha256(archive_list_text(current and 1)) and concat(":" and sequence)))
            set payload to concat("{\"channel_id\":" and concat(provider_quote(room) and concat(",\"ids\":[" and concat(admitted and "]}"))))
    else if kind equals "GUILD_DELETE" or else kind equals "GUILD_UPDATE" or else kind equals "GUILD_ROLE_CREATE" or else kind equals "GUILD_ROLE_UPDATE" or else kind equals "GUILD_ROLE_DELETE" or else kind equals "CHANNEL_UPDATE" or else kind equals "CHANNEL_DELETE" or else kind equals "THREAD_UPDATE" or else kind equals "THREAD_DELETE":
        set data to provider_member(tokens and 0 and "d")
        set guild to provider_value(tokens and provider_member(tokens and data and "guild_id"))
        if kind equals "GUILD_DELETE" or else kind equals "GUILD_UPDATE":
            set guild to provider_value(tokens and provider_member(tokens and data and "id"))
        if discord_snowflake(guild) equals 1 and discord_contains(guilds and guild) equals 1:
            set identity to concat("audience:" and concat(ep_sha256(archive_list_text(current and 1)) and concat(":" and sequence)))
            # A scope invalidation barrier, not a grant inferred from names.
            # Worker must refresh actual permissions before continuing work.
            set payload to concat("{\"guild_id\":" and concat(provider_quote(guild) and "}"))
            if kind equals "CHANNEL_UPDATE" or else kind equals "CHANNEL_DELETE":
                set room to provider_value(tokens and provider_member(tokens and data and "id"))
                if discord_snowflake(room) equals 1:
                    set payload to concat("{\"guild_id\":" and concat(provider_quote(guild) and concat(",\"channel_id\":" and concat(provider_quote(room) and "}"))))
            if kind equals "THREAD_UPDATE" or else kind equals "THREAD_DELETE":
                set thread to provider_value(tokens and provider_member(tokens and data and "id"))
                if discord_snowflake(thread) equals 1:
                    set payload to concat("{\"guild_id\":" and concat(provider_quote(guild) and concat(",\"thread_id\":" and concat(provider_quote(thread) and "}"))))

    return discord_gateway_dispatch(database and generation and archive_list_text(current and 1) and string_to_int(sequence) and kind and ep_sha256(body) and identity and payload)
