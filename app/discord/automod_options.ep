import "automod_changes"
import "audit_reason"

define discord_automod_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|guild|operation|rule|reason|observed_sha256|name|event_type|trigger_type|trigger_metadata|actions|enabled|exempt_roles|exempt_channels|") equals 0:
        return history_status("invalid-automod-arguments")
    set strings to create_list()
    set strings to ["guild","operation","rule","reason","observed_sha256"]
    for each item in strings:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and also not (provider_kind(fields and field) equals "string"):
            return history_status("invalid-automod-string")
    set guild to provider_value(fields and provider_member(fields and 0 and "guild"))
    if discord_snowflake(guild) equals 0:
        return history_status("automod-guild-required")
    set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
    if not (operation equals "list" or else operation equals "inspect" or else operation equals "create" or else operation equals "edit" or else operation equals "delete"):
        return history_status("invalid-automod-operation")
    set rule to provider_value(fields and provider_member(fields and 0 and "rule"))
    if operation equals "inspect" or else operation equals "edit" or else operation equals "delete":
        if discord_snowflake(rule) equals 0:
            return history_status("automod-rule-required")
    else if provider_member(fields and 0 and "rule") >= 0:
        return history_status("unused-automod-rule")
    set reason to provider_value(fields and provider_member(fields and 0 and "reason"))
    if operation equals "create" or else operation equals "edit" or else operation equals "delete":
        if string_length(discord_audit_reason(reason)) equals 0:
            return history_status("automod-reason-required")
    else if provider_member(fields and 0 and "reason") >= 0:
        return history_status("unused-automod-reason")
    set digest to provider_value(fields and provider_member(fields and 0 and "observed_sha256"))
    if operation equals "edit" or else operation equals "delete":
        if string_length(digest) is not equal to 64:
            return history_status("automod-observed-sha256-required")
        set index to 0
        repeat while index < 64:
            if string_contains("0123456789abcdef" and substring(digest and index and 1)) equals 0:
                return history_status("invalid-automod-sha256")
            set index to index + 1
    else if provider_member(fields and 0 and "observed_sha256") >= 0:
        return history_status("unused-automod-sha256")
    set keys to create_list()
    set keys to ["name","event_type","trigger_type","trigger_metadata","actions","enabled","exempt_roles","exempt_channels"]
    set changes to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            if count > 0:
                set changes to concat(changes and ",")
            set changes to concat(changes and concat(provider_quote(key) and concat(":" and agent_json_source(arguments and fields and field))))
            set count to count + 1
    set changes to concat(changes and "}")
    if operation equals "create":
        set candidate to discord_automod_effective(changes and "{}" and 1)
        if not (archive_list_text(candidate and 0) equals "valid"):
            return candidate
    else if operation equals "edit":
        if count equals 0:
            return history_status("empty-automod-edit")
    else if count > 0:
        return history_status("unused-automod-fields")
    return ["valid",guild,operation,rule,reason,digest,changes]
