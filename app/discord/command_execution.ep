# Internal application step, invoked only after the live Discord access check.
# The group writer rechecks database authority under its transaction lock.
define discord_command_new_apply with journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List returning Str:
    if discord_command_acknowledged(journal and identity and body) equals 0:
        return "command-not-acknowledged"
    set command to discord_command_resolve(journal and body and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access"):
        return archive_list_text(command and 0)
    if not (archive_list_text(command and 1) equals "new" or else archive_list_text(command and 1) equals "history" or else archive_list_text(command and 1) equals "resume" or else archive_list_text(command and 1) equals "search" or else archive_list_text(command and 1) equals "branch"):
        return "not-new-command"
    set ready to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_session_choices';"))
    if not (archive_list_text(ready and 0) equals "found"):
        return "session-migration-required"
    set actor to archive_list_text(command and 2)
    set room to archive_list_text(command and 3)
    set guild to discord_command_server(command and bot)
    set device to discord_agent_principal(database and actor and admins)
    if string_length(device) equals 0:
        return "principal-unavailable"
    if archive_list_text(command and 1) equals "branch":
        return discord_branch_apply(journal and database and device and identity and archive_list_text(command and 5) and guild and room)
    set audience_choice to discord_joined_target(database and device and guild and room and "")
    if not (archive_list_text(audience_choice and 0) equals "selected"):
        return archive_list_text(audience_choice and 0)
    set group_id to archive_list_text(audience_choice and 1)
    set keys to create_list()
    set added to append_list(keys and group_id)
    set audience to history_collect_one(checkpoint_prepare(database and "SELECT MAX(revision) FROM echo_group_membership WHERE group_id=?1;" and keys))
    if not (archive_list_text(audience and 0) equals "found"):
        return "audience-read-failed"
    if discord_command_acknowledged(journal and identity and body) equals 0:
        return "command-not-acknowledged"
    set revision to string_to_int(archive_list_text(audience and 1))
    if archive_list_text(command and 1) equals "resume":
        return group_session_resume(database and device and concat("discord-command:" and identity) and group_id and "discord" and guild and room and revision and archive_list_text(command and 5))
    if archive_list_text(command and 1) equals "search":
        set matches to group_session_search(database and device and group_id and "discord" and guild and room and revision and archive_list_text(command and 5))
        if not (archive_list_text(matches and 0) equals "found"):
            return archive_list_text(matches and 0)
        set parsed to provider_json_tokens(archive_list_text(matches and 1))
        if parsed equals 0:
            return "history-read-failed"
        set message to "Matching conversations in this channel (up to 10). Use /resume session: with an ID below. Refine your query if needed."
        set items to provider_items(parsed and 0)
        for each item in items:
            set session to provider_value(parsed and provider_member(parsed and item and "session"))
            set message to concat(message and concat("\n" and session))
        if length_list(items) equals 0:
            set message to concat(message and "\nNo matching conversations.")
        return concat("session-history:" and message)
    if archive_list_text(command and 1) equals "history":
        set history to group_session_history(database and device and group_id and "discord" and guild and room and revision and archive_list_text(command and 5))
        if not (archive_list_text(history and 0) equals "found"):
            return archive_list_text(history and 0)
        set tokens to provider_json_tokens(archive_list_text(history and 1))
        if tokens equals 0:
            return "history-read-failed"
        set message to "Your conversations in this channel. Use /resume session: with an ID below."
        set last to ""
        for each item in provider_items(tokens and 0):
            set last to provider_value(tokens and provider_member(tokens and item and "session"))
            set message to concat(message and concat("\n" and last))
        if string_length(last) > 0:
            set message to concat(message and concat("\nNext page: /history after:" and last))
        else:
            set message to concat(message and "\nNo more conversations.")
        return concat("session-history:" and message)
    set selected to group_session_restart(database and device and concat("discord-command:" and identity) and group_id and "discord" and guild and room and string_to_int(archive_list_text(audience and 1)))
    if archive_list_text(selected and 0) equals "created" or else archive_list_text(selected and 0) equals "already-created":
        return "new-session-created"
    return archive_list_text(selected and 0)

# Stop only the authenticated administrator's runs in this isolated Discord
# archive. The immutable receipt makes retrying an old command harmless after
# the same person has explicitly enabled a newer autonomous activity.
define discord_command_autooff_apply with journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List returning Str:
    if discord_command_acknowledged(journal and identity and body) equals 0:
        return "command-not-acknowledged"
    set command to discord_command_resolve(journal and body and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access"):
        return archive_list_text(command and 0)
    if not (archive_list_text(command and 1) equals "autooff"):
        return "not-autooff-command"
    set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
    if string_length(device) equals 0:
        return "principal-unavailable"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-lock-unavailable"
    set principal to principal_for_device(database and device)
    if not (principal_role(database and principal) equals "admin") or else discord_command_acknowledged(journal and identity and body) equals 0:
        return migration_fail(database and "admin-required")
    set receipt to concat("discord-autonomy-stop:" and identity)
    set payload to concat("{\"device\":" and concat(provider_quote(device) and concat(",\"interaction\":" and concat(provider_quote(identity) and concat(",\"intake_sha256\":" and concat(provider_quote(ep_sha256(body)) and "}"))))))
    set prior to archive_read_event(database and receipt)
    if prior is not equal to 0:
        if not (archive_list_text(prior and 2) equals "autonomy_global_stop") or else not (archive_list_text(prior and 3) equals payload):
            return migration_fail(database and "command-binding-denied")
    else:
        if autonomy_stop_others_pending(database and device and "" and receipt) is not equal to 0 or else archive_append_pending(database and concat("autonomy-control:" and device) and receipt and "autonomy_global_stop" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
            return migration_fail(database and "autonomy-write-failed")
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "commit-failed")
    return "autonomy-stopped"

define discord_command_tick with library as Str and token as Str and journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    if discord_command_acknowledged(journal and identity and body) equals 0:
        return "command-not-acknowledged"
    set command to discord_command_resolve(journal and body and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access"):
        return archive_list_text(command and 0)
    if archive_list_text(command and 1) equals "share":
        return discord_share_deliver(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    set access to discord_access_check(library and token and journal and directory_path and bot and archive_list_text(command and 4) and archive_list_text(command and 3) and archive_list_text(command and 2) and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return "command-access-denied"
    if file_exists(stop_file):
        return "stopped"
    if archive_list_text(command and 1) equals "testing":
        return discord_testing_toggle(journal and identity and body and archive_list_text(command and 2) and admins)
    if archive_list_text(command and 1) equals "new" or else archive_list_text(command and 1) equals "history" or else archive_list_text(command and 1) equals "resume" or else archive_list_text(command and 1) equals "search" or else archive_list_text(command and 1) equals "branch":
        return discord_command_new_apply(journal and database and identity and body and bot and guilds and admins)
    if archive_list_text(command and 1) equals "retry":
        return discord_manual_retry_message(journal and database and archive_list_text(command and 5) and archive_list_text(command and 2) and archive_list_text(command and 3) and archive_list_text(command and 4) and identity)
    if archive_list_text(command and 1) equals "cancel":
        set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
        if string_length(device) equals 0 or else string_length(principal_for_device(database and device)) equals 0 or else discord_command_acknowledged(journal and identity and body) equals 0:
            return "cancel-source-denied"
        set source to concat("message:create:" and archive_list_text(command and 5))
        return discord_cancel_source(journal and source and archive_list_text(command and 2) and archive_list_text(command and 3) and archive_list_text(command and 4) and identity)
    if archive_list_text(command and 1) equals "hud":
        return discord_hud_deliver(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    if archive_list_text(command and 1) equals "group":
        set options to provider_json_tokens(archive_list_text(command and 5))
        set offer_source to provider_member(options and 0 and "source")
        if offer_source >= 0:
            set offered to discord_group_offer_read(journal and provider_value(options and offer_source) and archive_list_text(command and 2) and archive_list_text(command and 4) and archive_list_text(command and 3))
            if not (archive_list_text(offered and 0) equals "found"):
                return "group-control:Offer source is unavailable or belongs to a different account/channel."
            set current_source to discord_source_current(library and token and journal and directory_path and archive_list_text(offered and 1))
            if not (archive_list_text(current_source and 0) equals "current"):
                return "group-control:The original message could not be verified unchanged. No shared conversation was created."
            if file_exists(stop_file):
                return "stopped"
        return discord_group_command_apply(journal and database and identity and body and bot and guilds and admins)
    if archive_list_text(command and 1) equals "schedules":
        return discord_schedule_deliver(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    if archive_list_text(command and 1) equals "attachments":
        return discord_attachment_deliver(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    if archive_list_text(command and 1) equals "project":
        return discord_project_deliver(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    if archive_list_text(command and 1) equals "export":
        return discord_export_deliver(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    if archive_list_text(command and 1) equals "autooff":
        return discord_command_autooff_apply(journal and database and identity and body and bot and guilds and admins)
    if archive_list_text(command and 1) equals "auto" or else archive_list_text(command and 1) equals "edit" or else archive_list_text(command and 1) equals "regenerate":
        if not (archive_list_text(command and 1) equals "auto"):
            set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
            set arguments to provider_json_tokens(archive_list_text(command and 5))
            set target to provider_value(arguments and provider_member(arguments and 0 and "message"))
            set source to discord_revision_target(journal and database and device and target and discord_command_server(command and bot) and archive_list_text(command and 3))
            if not (archive_list_text(source and 0) equals "found"):
                return archive_list_text(source and 0)
            if provider_member(arguments and 0 and "attachment") >= 0:
                set prepared to discord_revision_file_prepare(journal and database and identity and device and discord_command_server(command and bot) and archive_list_text(command and 3) and provider_value(arguments and provider_member(arguments and 0 and "attachment")))
                if not (archive_list_text(prepared and 0) equals "prepared"):
                    return archive_list_text(prepared and 0)
                set command to discord_command_resolve(journal and body and bot and guilds and admins)
                if not (archive_list_text(command and 0) equals "command-bound-needs-live-access"):
                    return archive_list_text(command and 0)
        set anchored to discord_command_public_anchor(library and token and journal and identity and bot and guilds and admins and directory_path and stop_file)
        if not (anchored equals "anchored"):
            return anchored
        if file_exists(stop_file):
            return "stopped"
        if not (archive_list_text(command and 1) equals "auto"):
            set published to discord_revision_prompt_publish(journal and identity and command)
            if not (published equals "revision-prompt-ready"):
                return published
        return discord_command_start_apply(journal and database and identity and body and bot and guilds and admins)
    return "command-handler-unavailable"
