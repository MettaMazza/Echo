import "../archive/history"
import "../providers/archived_stream"

# A failed observation is not proof of revoked permission. Preserve the actual
# transport/rate/permission status; never return snapshot contents or tokens.
define discord_access_failure_result with observed as List and stage as Str returning Str:
    set status to archive_list_text(observed and 0)
    set result to concat("{\"status\":" and provider_quote(status))
    set result to concat(result and concat(",\"stage\":" and provider_quote(stage)))
    set result to concat(result and ",\"effects\":\"none; this invocation did not perform the requested change\"")
    if status equals "rate-limited":
        set result to concat(result and concat(",\"retry_at_unix_ms\":" and provider_quote(archive_list_text(observed and 1))))
        return concat(result and ",\"explanation\":\"Discord's recorded rate deadline prevented this permission observation. This is not an access revocation. Wait until the deadline, then refresh observations; do not replay an earlier accepted mutation.\"}")
    set receipt to archive_list_text(observed and 1)
    if string_length(receipt) equals 41 and string_index_of(receipt and ".json") equals 36:
        set result to concat(result and concat(",\"receipt\":" and provider_quote(receipt)))
    return concat(result and ",\"explanation\":\"The required observation or permission check returned this status. Its stage identifies what failed; an unavailable snapshot does not establish revoked authority.\"}")
