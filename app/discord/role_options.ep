import "role_guard"

define discord_role_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "{"):
        return history_status("invalid-arguments")
    set index to 1
    repeat while not (provider_kind(fields and index) equals "}"):
        set key to provider_value(fields and index)
        set kind to provider_kind(fields and index + 2)
        if key equals "hoist" or else key equals "mentionable":
            if not (kind equals "true" or else kind equals "false"):
                return history_status("invalid-boolean")
        else if key equals "color" or else key equals "position":
            if not (kind equals "number"):
                return history_status("invalid-number")
        else if key equals "operation" or else key equals "role" or else key equals "member" or else key equals "name" or else key equals "permissions" or else key equals "reason" or else key equals "observed_sha256":
            if not (kind equals "string"):
                return history_status("invalid-string")
        else:
            return history_status("unknown-field")
        set index to provider_after(fields and index + 2)
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
    if not (operation equals "list" or else operation equals "inspect" or else operation equals "create" or else operation equals "edit" or else operation equals "reorder" or else operation equals "delete" or else operation equals "assign" or else operation equals "remove"):
        return history_status("invalid-operation")
    set role_id to provider_value(fields and provider_member(fields and 0 and "role"))
    if operation equals "list" or else operation equals "create":
        if string_length(role_id) > 0:
            return history_status("unused-role")
    else if discord_snowflake(role_id) equals 0:
        return history_status("role-required")
    set member_id to provider_value(fields and provider_member(fields and 0 and "member"))
    if operation equals "assign" or else operation equals "remove":
        if discord_snowflake(member_id) equals 0:
            return history_status("member-required")
    else if string_length(member_id) > 0:
        return history_status("unused-member")
    set reason to provider_value(fields and provider_member(fields and 0 and "reason"))
    set mutation to not (operation equals "list" or else operation equals "inspect")
    if mutation and string_length(discord_audit_reason(reason)) equals 0:
        return history_status("reason-required")
    if not mutation and string_length(reason) > 0:
        return history_status("unused-reason")
    set digest to provider_value(fields and provider_member(fields and 0 and "observed_sha256"))
    if mutation and not (operation equals "create"):
        if string_length(digest) is not equal to 64:
            return history_status("observed-sha256-required")
        set index to 0
        repeat while index < 64:
            if string_contains("0123456789abcdef" and substring(digest and index and 1)) equals 0:
                return history_status("invalid-sha256")
            set index to index + 1
    else if string_length(digest) > 0:
        return history_status("unused-sha256")
    set payload to "{"
    set count to 0
    set keys to create_list()
    set added to append_list(keys and "name")
    set added to append_list(keys and "permissions")
    set added to append_list(keys and "color")
    set added to append_list(keys and "hoist")
    set added to append_list(keys and "mentionable")
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            if not (operation equals "create" or else operation equals "edit"):
                return history_status("unused-role-change")
            set value to provider_value(fields and field)
            set serialized to value
            set remote_key to key
            if key equals "name":
                if string_length(string_trim(value)) equals 0 or else string_length(value) > 100 or else provider_valid_utf8(value) equals 0:
                    return history_status("invalid-name")
                set serialized to provider_quote(value)
            else if key equals "permissions":
                if discord_overwrite_mask(value) equals 0:
                    return history_status("invalid-permissions")
                set serialized to provider_quote(value)
            else if key equals "color":
                set number to http_decimal(value)
                if number < 0 or else number > 16777215 or else not (int_to_string(number) equals value):
                    return history_status("invalid-color")
                set remote_key to "colors"
                set serialized to concat("{\"primary_color\":" and concat(value and "}"))
            if count > 0:
                set payload to concat(payload and ",")
            set payload to concat(payload and concat(provider_quote(remote_key) and concat(":" and serialized)))
            set count to count + 1
    if operation equals "create":
        if provider_member(fields and 0 and "name") < 0:
            return history_status("name-required")
        if provider_member(fields and 0 and "permissions") < 0:
            set payload to concat(payload and ",\"permissions\":\"0\"")
    if operation equals "edit" and count equals 0:
        return history_status("change-required")
    set payload to concat(payload and "}")
    set position_field to provider_member(fields and 0 and "position")
    set position to provider_value(fields and position_field)
    if operation equals "reorder":
        set number to http_decimal(position)
        if position_field < 0 or else number < 1 or else number > 249 or else not (int_to_string(number) equals position):
            return history_status("invalid-position")
    else if position_field >= 0:
        return history_status("unused-position")
    return ["valid",operation,role_id,member_id,reason,digest,payload,position]
