import "question_controls"
import "trace"

# Numbered labels keep long options intact in message content instead of
# silently clipping them to Discord's button-label limit.
define discord_question_button with question as Str and outbox as Str and action as Str and item as Int and choice as Int and label as Str returning Str:
    set identity to discord_question_control_identity(question and outbox and action and item and choice)
    return concat("{\"type\":2,\"style\":2,\"label\":" and concat(provider_quote(label) and concat(",\"custom_id\":" and concat(provider_quote(identity) and "}"))))

define discord_question_render_row with identity as Str and content as Str and buttons as Str and item as Int and choices as Int returning Str:
    set components to "[]"
    if string_length(buttons) > 0:
        set components to concat("[{\"type\":1,\"components\":[" and concat(buttons and "]}]"))
    return concat("{\"identity\":" and concat(provider_quote(identity) and concat(",\"item\":" and concat(int_to_string(item) and concat(",\"choices\":" and concat(int_to_string(choices) and concat(",\"body\":{\"content\":" and concat(provider_quote(content) and concat(",\"allowed_mentions\":{\"parse\":[]},\"components\":" and concat(components and "}}"))))))))))

# Pure rendering of an archived, validated batch. Each returned JSON row
# carries a stable outbox identity and the binder metadata for its controls.
# Original text is paged at UTF-8 boundaries, never summarized or truncated.
define discord_question_render with question as Str and source as Str returning List:
    set rows to create_list()
    set tokens to provider_json_tokens(source)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return rows
    set index to provider_member(tokens and 0 and "questions")
    if not (provider_kind(tokens and index) equals "["):
        return rows
    set questions to provider_items(tokens and index)
    set total to length_list(questions)
    if total < 1 or else total > 3:
        return rows
    set item to 0
    repeat while item < total:
        set node to get_list(questions and item)
        set title to provider_value(tokens and provider_member(tokens and node and "title"))
        set options to provider_items(tokens and provider_member(tokens and node and "options"))
        set count to length_list(options)
        if string_length(title) equals 0 or else count > 3:
            return create_list()
        set text to concat("Question " and concat(int_to_string(item + 1) and concat(" of " and concat(int_to_string(total) and concat("\n" and title)))))
        set choice to 0
        repeat while choice < count:
            set text to concat(text and concat("\n\n" and concat(int_to_string(choice + 1) and concat(". " and provider_value(tokens and get_list(options and choice))))))
            set choice to choice + 1
        set text to concat(text and "\n\nChoose a numbered answer or Other. Choices are saved as drafts until you submit the batch.")
        set offset to 0
        repeat while offset < string_length(text):
            set chunk to discord_trace_chunk(text and offset)
            if string_length(chunk) equals 0:
                return create_list()
            set identity to concat("question-page:" and concat(ep_sha256(question) and concat(":" and concat(int_to_string(item) and concat(":" and int_to_string(offset))))))
            set buttons to ""
            set controls to -1
            if offset + string_length(chunk) equals string_length(text):
                set controls to count
                set choice to 0
                repeat while choice < count:
                    if string_length(buttons) > 0:
                        set buttons to concat(buttons and ",")
                    set buttons to concat(buttons and discord_question_button(question and identity and "choice" and item and choice and concat("Answer " and int_to_string(choice + 1))))
                    set choice to choice + 1
                if string_length(buttons) > 0:
                    set buttons to concat(buttons and ",")
                set buttons to concat(buttons and discord_question_button(question and identity and "other" and item and -1 and "Other"))
            set added to append_list(rows and discord_question_render_row(identity and chunk and buttons and item and controls))
            set offset to offset + string_length(chunk)
        set item to item + 1
    set identity to concat("question-page:" and concat(ep_sha256(question) and ":submit"))
    set button to discord_question_button(question and identity and "submit" and -1 and -1 and "Submit answers")
    set added to append_list(rows and discord_question_render_row(identity and "When every question has an answer, press Submit answers. You can also send a normal message to steer Echo instead." and button and -1 and 0))
    return rows
