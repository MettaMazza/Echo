import "../hud/interface"
import "../security/channel_silo"

# The authenticated interaction supplies the namespace. A linked Host account
# or a known run ID never authorizes reading a different platform or channel.
define discord_hud_scope_allows with database as Int and device as Str and guild as Str and room as Str and run as Str returning Int:
    set row to agent_run_read(database and run)
    if row equals 0:
        return 0
    return group_session_allows(database and device and archive_list_text(row and 0) and "discord" and guild and room and 1)

# Cached response delivery rechecks authority without repeating provider I/O.
define discord_hud_section_allows with database as Int and device as Str and guild as Str and room as Str and arguments as Str returning Int:
    set tokens to provider_json_tokens(arguments)
    if hud_arguments_valid(tokens and 1) equals 0:
        return 0
    set run to provider_value(tokens and provider_member(tokens and 0 and "run"))
    if discord_hud_scope_allows(database and device and guild and room and run) equals 0 or else principal_device_active(database and device) equals 0 or else run_authority_allows(database and run and "user") equals 0:
        return 0
    set owner to web_account_resource_device(database and device and "run" and run)
    if web_shared_run_read_allowed(database and owner and run) equals 0:
        return 0
    set section to provider_value(tokens and provider_member(tokens and 0 and "section"))
    if section equals "rights" or else section equals "machine":
        set role to principal_role(database and principal_for_device(database and device))
        if not (role equals "admin" or else role equals "steward") or else run_authority_allows(database and run and "admin") equals 0 or else group_privileged_audience_allows(database and run) equals 0:
            return 0
    return 1

define discord_hud_request with database as Int and device as Str and guild as Str and room as Str and arguments as Str returning Str:
    set tokens to provider_json_tokens(arguments)
    if hud_arguments_valid(tokens and 1) equals 0:
        return "{\"status\":\"invalid-arguments\"}"
    set run to provider_value(tokens and provider_member(tokens and 0 and "run"))
    if discord_hud_scope_allows(database and device and guild and room and run) equals 0:
        return "{\"status\":\"not-authorized\"}"
    set result to hud_web_read(database and device and tokens)
    # Context/provider discovery may wait. Recheck current membership afterward
    # without holding a SQLite read transaction across that network operation.
    if discord_hud_scope_allows(database and device and guild and room and run) equals 0:
        return "{\"status\":\"authorization-changed\"}"
    return result
