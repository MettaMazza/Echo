import "automod_guard"

# A referenced channel is freshly read, guild-bound and visible to both actors.
# Its contents are never read merely to configure an automod rule.
define discord_automod_channel_reference with library as Str and token as Str and journal as Int and directory_path as Str and bundle as List and guild as Str and actor as Str and bot as Str and room as Str returning Int:
    if discord_snowflake(room) equals 0:
        return 0
    set observed to discord_access_get(library and token and journal and directory_path and concat("/channels/" and room) and "GET:automod-channel-reference" and room)
    if not (archive_list_text(observed and 0) equals "observed"):
        return 0
    set body to archive_list_text(observed and 1)
    return discord_channel_permission(archive_list_text(bundle and 1) and archive_list_text(bundle and 2) and archive_list_text(bundle and 3) and body and guild and actor and room and 10) equals 1 and also discord_channel_permission(archive_list_text(bundle and 1) and archive_list_text(bundle and 2) and archive_list_text(bundle and 4) and body and guild and bot and room and 10) equals 1

define discord_automod_references_current with library as Str and token as Str and journal as Int and directory_path as Str and bundle as List and guild as Str and actor as Str and bot as Str and candidate as Str returning Int:
    set fields to provider_json_tokens(candidate)
    if fields equals 0 or else provider_unique_objects(fields) equals 0:
        return 0
    set keys to create_list()
    set keys to ["exempt_roles","exempt_channels","actions"]
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0 and also not (provider_kind(fields and field) equals "null"):
            if not (provider_kind(fields and field) equals "["):
                return 0
            set index to field + 1
            repeat while not (provider_kind(fields and index) equals "]"):
                if key equals "exempt_roles":
                    if string_length(discord_role_snapshot(archive_list_text(bundle and 2) and provider_value(fields and index))) equals 0:
                        return 0
                else if key equals "exempt_channels":
                    if discord_automod_channel_reference(library and token and journal and directory_path and bundle and guild and actor and bot and provider_value(fields and index)) equals 0:
                        return 0
                else if provider_value(fields and provider_member(fields and index and "type")) equals "2":
                    set metadata to provider_member(fields and index and "metadata")
                    set room to provider_value(fields and provider_member(fields and metadata and "channel_id"))
                    if discord_automod_channel_reference(library and token and journal and directory_path and bundle and guild and actor and bot and room) equals 0:
                        return 0
                set index to provider_after(fields and index)
                if index < 0:
                    return 0
                if provider_kind(fields and index) equals ",":
                    set index to index + 1
    return 1
