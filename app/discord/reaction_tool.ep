import "../retained_text"
import "reaction_options"
import "run_source"
import "../security/tool_policy"

# Only the host-owned Discord child process carries these arguments. Match
# both database identities and the admitted origin before reading credentials.
# Generic host/browser workers cannot borrow a Discord principal by naming it.
define discord_reaction_execute with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    set options to discord_reaction_options(arguments)
    if not (archive_list_text(options and 0) equals "valid"):
        return discord_reaction_result(archive_list_text(options and 0) and "none" and "")
    if tool_policy_allows(database and run and call_id and "discord_reaction") equals 0:
        return discord_reaction_result("not-authorized" and "none" and "")
    if not ((get_argument_count() equals 15 and also get_argument(13) equals "--turn") or else (get_argument_count() equals 16 and also get_argument(13) equals "--job")):
        return discord_reaction_result("discord-runtime-unavailable" and "none" and "")
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    set location to history_collect_one(archive_prepare(database and "SELECT file FROM pragma_database_list WHERE name='main';"))
    if not (archive_list_text(binding and 0) equals "found") or else not (archive_list_text(binding and 1) equals get_argument(7)) or else not (archive_list_text(location and 1) equals get_argument(4)):
        return discord_reaction_result("discord-binding-denied" and "none" and "")
    set journal to discord_store_open(get_argument(3) and get_argument(7))
    if journal equals 0:
        return discord_reaction_result("discord-journal-unavailable" and "none" and "")
    set source to discord_run_source(journal and database and run)
    if not (archive_list_text(source and 0) equals "found"):
        set closed to sql_close(journal)
        return discord_reaction_result("discord-origin-denied" and "none" and "")
    set credential to read_file(get_argument(2))
    if credential equals 0:
        set closed to sql_close(journal)
        return discord_reaction_result("discord-credential-unavailable" and "none" and "")
    set guilds to create_list()
    set split_count to retained_text_split(guilds and get_argument(8) and ",")
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(9) and ",")
    set result to discord_reaction_perform(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and database and run and call_id and source and options and get_argument(7) and guilds and admins and get_argument(5) and get_argument(6))
    set closed to sql_close(journal)
    return result

define discord_reaction_result with status as Str and effects as Str and receipt as Str returning Str:
    set output to concat("{\"status\":" and provider_quote(status))
    set output to concat(output and concat(",\"effects\":" and provider_quote(effects)))
    return concat(output and concat(",\"receipt\":" and concat(provider_quote(receipt) and "}")))

# Uses the existing durable tool intent, frozen authority, live Discord access,
# source-change barrier, fixed-origin transport and shared rate deadlines.
# Only PUT/DELETE @me mutate, so no non-idempotent message is blindly retried.
define discord_reaction_perform with library as Str and token as Str and journal as Int and database as Int and run as Str and call_id as Str and source as List and options as List and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    set actor to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set message to archive_list_text(source and 6)
    set operation to archive_list_text(options and 1)
    set emoji to archive_list_text(options and 2)
    if file_exists(stop_file) or else tool_policy_allows(database and run and call_id and "discord_reaction") equals 0:
        return discord_reaction_result("not-authorized-or-stopped" and "none" and "")
    if (string_length(guild) > 0 and also discord_contains(guilds and guild) equals 0) or else (string_length(guild) equals 0 and also discord_contains(admins and actor) equals 0):
        return discord_reaction_result("discord-origin-denied" and "none" and "")
    set required_bit to -1
    if operation equals "add":
        set required_bit to 6
    set access to discord_access_check_bit(library and token and journal and directory_path and bot and guild and room and actor and admins and required_bit)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_reaction_result(concat("discord-access:" and archive_list_text(access and 0)) and "none" and "")
    set route to concat("/channels/" and concat(room and concat("/messages/" and message)))
    set fetched to discord_access_get(library and token and journal and directory_path and route and "GET/channel/message" and room)
    if not (archive_list_text(fetched and 0) equals "observed"):
        return discord_reaction_result(archive_list_text(fetched and 0) and "none" and archive_list_text(fetched and 1))
    set inbox to discord_job_origin(journal and database and run)
    if discord_run_source_matches(journal and inbox and source and archive_list_text(fetched and 1)) equals 0:
        return discord_reaction_result("source-changed" and "none" and archive_list_text(fetched and 3))
    set payload to ""
    set receipt to archive_list_text(fetched and 3)
    if operation equals "inspect":
        set body to archive_list_text(fetched and 1)
        set tokens to provider_json_tokens(body)
        set field to provider_member(tokens and 0 and "reactions")
        set reactions to "[]"
        if field >= 0:
            if not (provider_kind(tokens and field) equals "["):
                return discord_reaction_result("invalid-reactions" and "none" and receipt)
            set reactions to agent_json_source(body and tokens and field)
        set payload to concat("{\"status\":\"observed\",\"reactions\":" and concat(reactions and "}"))
    else:
        set catalog to "[]"
        if operation equals "discover" or else string_contains(emoji and ":") is not equal to 0:
            if string_length(guild) > 0:
                set observed to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and "/emojis")) and "GET:guild-emojis" and guild)
                if not (archive_list_text(observed and 0) equals "observed"):
                    return discord_reaction_result(archive_list_text(observed and 0) and "none" and archive_list_text(observed and 1))
                set member to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and concat("/members/" and bot))) and "GET:member" and guild)
                if not (archive_list_text(member and 0) equals "observed"):
                    return discord_reaction_result(archive_list_text(member and 0) and "none" and archive_list_text(member and 1))
                set member_tokens to provider_json_tokens(archive_list_text(member and 1))
                if not (provider_value(member_tokens and provider_member(member_tokens and provider_member(member_tokens and 0 and "user") and "id")) equals bot):
                    return discord_reaction_result("member-identity-mismatch" and "none" and "")
                set catalog to discord_reaction_catalog(archive_list_text(observed and 1) and archive_list_text(member and 1) and 0)
                if string_length(catalog) equals 0:
                    return discord_reaction_result("invalid-emoji-catalog" and "none" and archive_list_text(observed and 3))
            set observed to discord_access_get(library and token and journal and directory_path and concat("/applications/" and concat(bot and "/emojis")) and "GET:application-emojis" and bot)
            if not (archive_list_text(observed and 0) equals "observed"):
                return discord_reaction_result(archive_list_text(observed and 0) and "none" and archive_list_text(observed and 1))
            set app_catalog to discord_reaction_catalog(archive_list_text(observed and 1) and "{}" and 1)
            if string_length(app_catalog) equals 0:
                return discord_reaction_result("invalid-application-emoji-catalog" and "none" and archive_list_text(observed and 3))
            set receipt to archive_list_text(observed and 3)
            if string_length(app_catalog) > 2:
                set prefix to substring(catalog and 0 and string_length(catalog) - 1)
                if string_length(catalog) > 2:
                    set prefix to concat(prefix and ",")
                set catalog to concat(prefix and substring(app_catalog and 1 and string_length(app_catalog) - 1))
            if operation equals "discover":
                set payload to concat("{\"status\":\"observed\",\"custom_emoji\":" and concat(catalog and ",\"unicode\":\"Use literal Unicode emoji. Discord validates the glyph; this list contains only usable custom emoji.\"}"))
            else if discord_reaction_catalog_has(catalog and emoji) equals 0:
                return discord_reaction_result("emoji-unavailable" and "none" and receipt)
    if tool_policy_allows(database and run and call_id and "discord_reaction") equals 0 or else not (discord_job_origin(journal and database and run) equals inbox) or else file_exists(stop_file):
        return discord_reaction_result("authorization-changed-or-stopped" and "none" and receipt)
    if string_length(payload) > 0:
        return payload
    # Gateway changes observed during network reads invalidate before mutation.
    if discord_turn_barrier(journal and http_decimal(archive_list_text(source and 7)) and message and room and guild) is not equal to 0:
        return discord_reaction_result("source-invalidated" and "none" and receipt)
    set method to "PUT"
    if operation equals "remove":
        set method to "DELETE"
    set route to concat(route and concat("/reactions/" and concat(archive_list_text(options and 3) and "/@me")))
    set result to discord_access_request(library and token and journal and directory_path and method and route and concat(method and ":channel/message/reaction/@me") and room)
    if not (archive_list_text(result and 0) equals "observed"):
        return discord_reaction_result(concat("reaction-unconfirmed:" and archive_list_text(result and 0)) and "not-established; inspect before retry" and archive_list_text(result and 1))
    return discord_reaction_result("applied" and concat("own-reaction:" and operation) and archive_list_text(result and 3))
