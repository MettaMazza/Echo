import "scheduled_event_time"

# Returns a bit mask for distinct bounded weekday integers, or -1 on failure.
define discord_event_weekdays with fields as List and array as Int returning Int:
    if not (provider_kind(fields and array) equals "["):
        return -1
    set items to provider_items(fields and array)
    if length_list(items) < 1 or else length_list(items) > 7:
        return -1
    set mask to 0
    for each item in items:
        if discord_rich_integer(fields and item and 0 and 6) equals 0:
            return -1
        set day to string_to_int(provider_value(fields and item))
        set bit to 1
        set index to 0
        repeat while index < day:
            set bit to bit * 2
            set index to index + 1
        if mask / bit - mask / (bit * 2) * 2 is not equal to 0:
            return -1
        set mask to mask + bit
    return mask

define discord_event_single_integer with fields as List and array as Int and minimum as Int and maximum as Int returning Int:
    if not (provider_kind(fields and array) equals "["):
        return -1
    set items to provider_items(fields and array)
    if length_list(items) is not equal to 1:
        return -1
    set item to get_list(items and 0)
    if discord_rich_integer(fields and item and minimum and maximum) equals 0:
        return -1
    return string_to_int(provider_value(fields and item))

# Discord's frequency enum is YEARLY=0, MONTHLY=1, WEEKLY=2, DAILY=3.
# Upstream prose contains contradictory numeric examples; use its enum table.
define discord_event_recurrence with fields as List and object as Int returning Int:
    if provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and object and "|start|frequency|interval|by_weekday|by_n_weekday|by_month|by_month_day|") equals 0:
        return 0
    set start to provider_member(fields and object and "start")
    if not (provider_kind(fields and start) equals "string") or else discord_event_timestamp(provider_value(fields and start)) < 0:
        return 0
    set frequency_field to provider_member(fields and object and "frequency")
    set interval_field to provider_member(fields and object and "interval")
    if discord_rich_integer(fields and frequency_field and 0 and 3) equals 0 or else discord_rich_integer(fields and interval_field and 1 and 2) equals 0:
        return 0
    set frequency to string_to_int(provider_value(fields and frequency_field))
    if string_to_int(provider_value(fields and interval_field)) equals 2 and also frequency is not equal to 2:
        return 0
    set weekday to provider_member(fields and object and "by_weekday")
    set nth to provider_member(fields and object and "by_n_weekday")
    set month to provider_member(fields and object and "by_month")
    set month_day to provider_member(fields and object and "by_month_day")
    set groups to 0
    if weekday >= 0 and also not (provider_kind(fields and weekday) equals "null"):
        set groups to groups + 1
        set mask to discord_event_weekdays(fields and weekday)
        if mask < 1:
            return 0
        if frequency equals 2:
            if length_list(provider_items(fields and weekday)) is not equal to 1:
                return 0
        else if frequency equals 3:
            if not (mask equals 31 or else mask equals 62 or else mask equals 79 or else mask equals 48 or else mask equals 96 or else mask equals 65):
                return 0
        else:
            return 0
    if nth >= 0 and also not (provider_kind(fields and nth) equals "null"):
        set groups to groups + 1
        if frequency is not equal to 1 or else not (provider_kind(fields and nth) equals "["):
            return 0
        set items to provider_items(fields and nth)
        if length_list(items) is not equal to 1:
            return 0
        set item to get_list(items and 0)
        if discord_rich_keys(fields and item and "|n|day|") equals 0 or else discord_rich_integer(fields and provider_member(fields and item and "n") and 1 and 5) equals 0 or else discord_rich_integer(fields and provider_member(fields and item and "day") and 0 and 6) equals 0:
            return 0
    set has_month to month >= 0 and also not (provider_kind(fields and month) equals "null")
    set has_day to month_day >= 0 and also not (provider_kind(fields and month_day) equals "null")
    if has_month or else has_day:
        set groups to groups + 1
        if has_month is not equal to has_day or else frequency is not equal to 0:
            return 0
        set month_value to discord_event_single_integer(fields and month and 1 and 12)
        set day_value to discord_event_single_integer(fields and month_day and 1 and 31)
        if month_value < 1 or else day_value < 1 or else day_value > discord_event_month_days(2000 and month_value):
            return 0
    return groups <= 1
