import "channel_options"

# Public threads inherit their parent's audience. Private-thread detail may
# only be returned inside that exact thread, never into its public parent.
define discord_thread_scope with origin as Str and target as Str and guild as Str and room as Str and target_id as Str returning Str:
    set source_fields to provider_json_tokens(origin)
    set target_fields to provider_json_tokens(target)
    if source_fields equals 0 or else target_fields equals 0 or else provider_unique_objects(source_fields) equals 0 or else provider_unique_objects(target_fields) equals 0:
        return "invalid-thread-snapshot"
    if not (provider_value(source_fields and provider_member(source_fields and 0 and "id")) equals room) or else not (provider_value(source_fields and provider_member(source_fields and 0 and "guild_id")) equals guild) or else not (provider_value(target_fields and provider_member(target_fields and 0 and "id")) equals target_id) or else not (provider_value(target_fields and provider_member(target_fields and 0 and "guild_id")) equals guild):
        return "thread-identity-mismatch"
    set kind to provider_value(target_fields and provider_member(target_fields and 0 and "type"))
    if not (kind equals "10" or else kind equals "11" or else kind equals "12"):
        return "not-a-thread"
    set origin_kind to provider_value(source_fields and provider_member(source_fields and 0 and "type"))
    set parent to room
    if origin_kind equals "10" or else origin_kind equals "11" or else origin_kind equals "12":
        set parent to provider_value(source_fields and provider_member(source_fields and 0 and "parent_id"))
    if discord_snowflake(parent) equals 0 or else not (provider_value(target_fields and provider_member(target_fields and 0 and "parent_id")) equals parent):
        return "thread-parent-outside-origin"
    if kind equals "12":
        if room equals target_id:
            return "private-source"
        return "private-metadata-withheld"
    return "public-parent-audience"

define discord_thread_view with body as Str and scope as Str returning Str:
    set fields to provider_json_tokens(body)
    set result to concat("{\"id\":" and provider_quote(provider_value(fields and provider_member(fields and 0 and "id"))))
    set result to concat(result and concat(",\"observed_sha256\":" and provider_quote(ep_sha256(body))))
    if scope equals "private-metadata-withheld":
        return concat(result and ",\"private\":true,\"metadata\":\"withheld from this audience\"}")
    set keys to create_list()
    set added to append_list(keys and "type")
    set added to append_list(keys and "name")
    set added to append_list(keys and "parent_id")
    set added to append_list(keys and "owner_id")
    set added to append_list(keys and "rate_limit_per_user")
    set added to append_list(keys and "thread_metadata")
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            set result to concat(result and concat("," and concat(provider_quote(key) and concat(":" and agent_json_source(body and fields and field)))))
    return concat(result and "}")

# Return a minimal member page, not guild role/profile/private member fields.
define discord_thread_member_page with body as Str and target as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else not (provider_kind(fields and 0) equals "[") or else provider_unique_objects(fields) equals 0:
        return ""
    return discord_thread_member_items(fields and provider_items(fields and 0) and target)

define discord_thread_member_items with fields as List and items as List and target as Str returning Str:
    set result to "["
    set count to 0
    for each item in items:
        set identity to provider_value(fields and provider_member(fields and item and "user_id"))
        if discord_snowflake(identity) equals 0 or else not (provider_value(fields and provider_member(fields and item and "id")) equals target):
            return ""
        if count > 0:
            set result to concat(result and ",")
        set result to concat(result and concat("{\"user_id\":" and concat(provider_quote(identity) and "}")))
        set count to count + 1
    return concat(result and "]")
