import "text_chunk"
import "agent_bridge"
import "intake_source"
import "job_origin"
import "action_output"

# Export only the final event accepted by this transport-bound run. Never scan
# arbitrary assistant events or accept a model-supplied destination. The host
# must recheck current Discord access immediately before sending each intent.
define discord_agent_output with journal as Int and database as Int and inbox as Str returning Str:
    if not (string_index_of(inbox and "message:create:") equals 0):
        return "not-user-intake"
    set message to substring(inbox and 15 and string_length(inbox) - 15)
    return discord_agent_output_run(journal and database and inbox and concat("discord-message:" and message))

# Scheduled occurrences have independent runs but retain the authenticated
# originating transport audience. Delegated children report to their parent;
# they cannot independently publish their working output through this route.
define discord_agent_output_run with journal as Int and database as Int and inbox as Str and run as Str returning Str:
    set current to agent_run_read(database and run)
    if current equals 0 or else not (archive_list_text(current and 2) equals "completed"):
        return "no-completed-bound-run"
    return discord_agent_output_final(journal and database and inbox and run and archive_list_text(current and 3))

# A committed final remains an accepted reply when autonomy or delegation
# resumes its run. Bind the exact event to both run and session before export;
# never infer an answer from current state or scan unrelated conversation text.
define discord_agent_output_final with journal as Int and database as Int and inbox as Str and run as Str and final_event as Str returning Str:
    set source to discord_intake_source(journal and inbox)
    if not (archive_list_text(source and 0) equals "found"):
        return "source-unavailable"
    set message to archive_list_text(source and 6)
    set room to archive_list_text(source and 4)
    set sender to archive_list_text(source and 3)
    set server to archive_list_text(source and 5)
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    if not (archive_list_text(binding and 0) equals "found") or else discord_snowflake(message) equals 0 or else discord_snowflake(room) equals 0 or else discord_snowflake(sender) equals 0:
        return "invalid-source"
    if string_length(server) equals 0 or else server equals "null":
        set server to concat("dm:" and archive_list_text(binding and 1))
    set root to concat("discord-message:" and message)
    if archive_list_text(source and 1) equals "INTERACTION_CREATE":
        set root to concat("discord-command:" and inbox)
        if not (discord_job_origin(journal and database and run) equals inbox):
            return "authority-revoked"
    if not (run equals root):
        set schedule_values to create_list()
        set added to append_list(schedule_values and run)
        set scheduled to history_collect_one(checkpoint_prepare(database and "SELECT identity FROM echo_schedule_occurrences WHERE identity=?1;" and schedule_values))
        if not (archive_list_text(scheduled and 0) equals "found") or else not (discord_job_origin(journal and database and run) equals inbox):
            return "not-bound-scheduled-output"
    set device to concat("discord:" and sender)
    set principal to principal_for_device(database and device)
    if string_length(principal) equals 0:
        return "authority-revoked"
    set expected_group to channel_silo_identity("discord" and server and room and principal)
    set rooted_literal_2 to create_list()
    set retained_value_added to append_list(rooted_literal_2 and run)
    set retained_value_added to append_list(rooted_literal_2 and expected_group)
    set bound to history_collect_one(checkpoint_prepare(database and "SELECT r.session,r.state,r.last_event FROM echo_runs r JOIN echo_group_run_origins o ON o.run=r.run AND o.session=r.session JOIN echo_group_sessions s ON s.session=o.session WHERE r.run=?1 AND s.group_id=?2;" and rooted_literal_2))
    if not (archive_list_text(bound and 0) equals "found"):
        return "no-completed-bound-run"
    if run_authority_allows(database and run and "user") equals 0 or else group_run_session_allows(database and run and archive_list_text(bound and 1)) equals 0:
        return "authority-revoked"
    set final to archive_read_event(database and final_event)
    if final equals 0 or else not (archive_list_text(final and 2) equals "assistant_final") or else not (archive_list_text(final and 0) equals archive_list_text(bound and 1)):
        return "final-unavailable"
    set payload to provider_json_tokens(archive_list_text(final and 3))
    if not (provider_value(payload and provider_member(payload and 0 and "run_id")) equals run):
        return "final-run-mismatch"
    set content_index to provider_member(payload and 0 and "content")
    if not (provider_kind(payload and content_index) equals "string"):
        return "final-content-unavailable"
    set content to provider_value(payload and content_index)
    if provider_valid_utf8(content) equals 0 or else string_length(content) equals 0:
        return "final-content-unavailable"
    # A delegated result may resume the same parent run and produce another
    # accepted final. Preserve existing first-reply identities, but bind later
    # replies to their immutable final event so they cannot collide with the
    # earlier outbox body or be duplicated on recovery.
    set final_values to create_list()
    set added to append_list(final_values and run)
    set added to append_list(final_values and final_event)
    set earlier to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='assistant_final' AND json_extract(payload,'$.run_id')=?1 AND sequence<(SELECT sequence FROM echo_events WHERE event=?2);" and final_values))
    if not (archive_list_text(earlier and 0) equals "found"):
        return "final-lineage-unavailable"
    set output_prefix to concat(run and ":final:")
    if not (archive_list_text(earlier and 1) equals "0"):
        set final_hash to ep_sha256(final_event)
        set output_prefix to concat(run and concat(":final-event:" and concat(final_hash and ":")))
    # Byte-bounded chunks also fit Discord's character limit, including emoji.
    # Back off continuation bytes rather than corrupting a Unicode codepoint.
    set offset to 0
    set part to 0
    repeat while offset < string_length(content):
        set count to string_length(discord_text_chunk(content and offset and 1900))
        if count equals 0:
            return "invalid-chunk"
        set body to concat("{\"content\":" and provider_quote(substring(content and offset and count)))
        set body to concat(body and ",\"allowed_mentions\":{\"parse\":[],\"replied_user\":false}")
        set body to concat(body and concat(",\"message_reference\":{\"message_id\":" and concat(provider_quote(message) and ",\"fail_if_not_exists\":false}}")))
        set identity to concat(output_prefix and int_to_string(part))
        set queued to ""
        # Reply controls are part of the Discord interface, not an optional
        # process environment feature. Authority remains checked at click time.
        if part equals 0:
            set queued to discord_action_output(journal and identity and inbox and room and body and final_event and 1)
        else:
            set queued to discord_outbox_enqueue(journal and identity and inbox and room and body)
        if not (queued equals "enqueued" or else queued equals "already-enqueued"):
            return queued
        set offset to offset + count
        set part to part + 1
    return "enqueued"
