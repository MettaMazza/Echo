import "scheduled_event_guard"
import "scheduled_event_options"

define discord_event_recurrence_items_valid with items as List and fields as List and key as Str returning Int:
    for each item in items:
        if key equals "by_n_weekday":
            if discord_rich_keys(fields and item and "|n|day|") equals 0 or else discord_rich_integer(fields and provider_member(fields and item and "n") and 1 and 5) equals 0 or else discord_rich_integer(fields and provider_member(fields and item and "day") and 0 and 6) equals 0:
                return 0
        else:
            set minimum to 1
            set maximum to 366
            if key equals "by_weekday":
                set minimum to 0
                set maximum to 6
            else if key equals "by_month":
                set maximum to 12
            else if key equals "by_month_day":
                set maximum to 31
            if discord_rich_integer(fields and item and minimum and maximum) equals 0:
                return 0
    return 1

define discord_event_recurrence_view_valid with fields as List and object as Int returning Int:
    if discord_rich_keys(fields and object and "|start|end|frequency|interval|by_weekday|by_n_weekday|by_month|by_month_day|by_year_day|count|") equals 0:
        return 0
    set start to provider_member(fields and object and "start")
    if not (provider_kind(fields and start) equals "string") or else discord_event_timestamp(provider_value(fields and start)) < 0:
        return 0
    set finish to provider_member(fields and object and "end")
    if finish >= 0 and also not (provider_kind(fields and finish) equals "null"):
        if not (provider_kind(fields and finish) equals "string") or else discord_event_timestamp(provider_value(fields and finish)) < 0:
            return 0
    if discord_rich_integer(fields and provider_member(fields and object and "frequency") and 0 and 3) equals 0 or else discord_rich_integer(fields and provider_member(fields and object and "interval") and 1 and 2) equals 0:
        return 0
    set count_field to provider_member(fields and object and "count")
    if count_field >= 0 and also not (provider_kind(fields and count_field) equals "null"):
        if discord_rich_integer(fields and count_field and 1 and 2147483647) equals 0:
            return 0
    set keys to create_list()
    set added to append_list(keys and "by_weekday")
    set added to append_list(keys and "by_month")
    set added to append_list(keys and "by_month_day")
    set added to append_list(keys and "by_year_day")
    set added to append_list(keys and "by_n_weekday")
    for each key_pointer in keys:
        set key to ptr_to_str(key_pointer)
        set field to provider_member(fields and object and key)
        if field >= 0 and also not (provider_kind(fields and field) equals "null"):
            if not (provider_kind(fields and field) equals "["):
                return 0
            set items to provider_items(fields and field)
            if discord_event_recurrence_items_valid(items and fields and key) equals 0:
                return 0
    return 1

# The controller supplies fresh guild/member/channel observations. Projection
# is not an authority grant: both requester and bot must pass before publication.
define discord_event_view with body as Str and guild as Str and server as Str and roles as Str and member as Str and person as Str and channel_body as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "{"):
        return ""
    set identity to provider_value(fields and provider_member(fields and 0 and "id"))
    if discord_snowflake(identity) equals 0 or else not (provider_value(fields and provider_member(fields and 0 and "guild_id")) equals guild):
        return ""
    set entity_field to provider_member(fields and 0 and "entity_type")
    set status_field to provider_member(fields and 0 and "status")
    if discord_rich_integer(fields and entity_field and 1 and 3) equals 0 or else discord_rich_integer(fields and status_field and 1 and 4) equals 0:
        return ""
    set entity_type to string_to_int(provider_value(fields and entity_field))
    set room to provider_member(fields and 0 and "channel_id")
    if entity_type equals 3:
        if not (provider_kind(fields and room) equals "null"):
            return ""
    else:
        set room_fields to provider_json_tokens(channel_body)
        if room_fields equals 0 or else not (provider_kind(fields and room) equals "string") or else not (provider_value(fields and room) equals provider_value(room_fields and provider_member(room_fields and 0 and "id"))):
            return ""
    set creator to provider_value(fields and provider_member(fields and 0 and "creator_id"))
    if discord_scheduled_event_permission(server and roles and member and channel_body and guild and person and creator and entity_type and "read") equals 0:
        return ""
    set name_field to provider_member(fields and 0 and "name")
    if discord_rich_text(fields and name_field and 100 and 1) < 0:
        return ""
    set keys to create_list()
    set added to append_list(keys and "id")
    set added to append_list(keys and "guild_id")
    set added to append_list(keys and "channel_id")
    set added to append_list(keys and "name")
    set added to append_list(keys and "description")
    set added to append_list(keys and "scheduled_start_time")
    set added to append_list(keys and "scheduled_end_time")
    set added to append_list(keys and "privacy_level")
    set added to append_list(keys and "status")
    set added to append_list(keys and "entity_type")
    set added to append_list(keys and "entity_id")
    set added to append_list(keys and "user_count")
    set added to append_list(keys and "image")
    set result to "{"
    set count to 0
    for each key_pointer in keys:
        set key to ptr_to_str(key_pointer)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            set value to agent_json_source(body and fields and field)
            if provider_kind(fields and field) equals "{" or else provider_kind(fields and field) equals "[":
                return ""
            if count > 0:
                set result to concat(result and ",")
            set quoted_key to provider_quote(key)
            set pair to concat(quoted_key and concat(":" and value))
            set result to concat(result and pair)
            set count to count + 1
    set metadata to provider_member(fields and 0 and "entity_metadata")
    if entity_type equals 3:
        set location to provider_member(fields and metadata and "location")
        if discord_rich_text(fields and location and 100 and 1) < 0:
            return ""
        set quoted_location to provider_quote(provider_value(fields and location))
        set projected_metadata to concat(",\"entity_metadata\":{\"location\":" and concat(quoted_location and "}"))
        set result to concat(result and projected_metadata)
    else:
        set result to concat(result and ",\"entity_metadata\":null")
    # Response recurrence fields include server-owned fields that the create
    # validator deliberately rejects. Copy only documented scalar/array fields.
    set recurrence to provider_member(fields and 0 and "recurrence_rule")
    if recurrence >= 0 and also not (provider_kind(fields and recurrence) equals "null"):
        if discord_event_recurrence_view_valid(fields and recurrence) equals 0:
            return ""
        set recurrence_body to agent_json_source(body and fields and recurrence)
        set result to concat(result and concat(",\"recurrence_rule\":" and recurrence_body))
    else:
        set result to concat(result and ",\"recurrence_rule\":null")
    return concat(result and "}")

# Interested-user inspection returns account labels only, never full member
# records (roles, permissions, joined dates, voice state or private attributes).
# The controller must authorize the parent event immediately before this read.
define discord_event_users_view with body as Str and event as Str returning Str:
    if discord_snowflake(event) equals 0:
        return ""
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "["):
        return ""
    set items to provider_items(fields and 0)
    return discord_event_users_items(body and fields and items and event)

define discord_event_users_items with body as Str and fields as List and items as List and event as Str returning Str:
    set seen to create_list()
    set result to "["
    set count to 0
    for each item in items:
        if not (provider_value(fields and provider_member(fields and item and "guild_scheduled_event_id")) equals event):
            return ""
        set user to provider_member(fields and item and "user")
        set identity to provider_value(fields and provider_member(fields and user and "id"))
        set username to provider_member(fields and user and "username")
        if discord_snowflake(identity) equals 0 or else discord_contains(seen and identity) equals 1 or else not (provider_kind(fields and username) equals "string"):
            return ""
        set added to append_list(seen and identity)
        set quoted_id to provider_quote(identity)
        set quoted_name to provider_quote(provider_value(fields and username))
        set projected to concat("{\"id\":" and concat(quoted_id and concat(",\"username\":" and quoted_name)))
        set display_name to provider_member(fields and user and "global_name")
        if display_name >= 0 and also provider_kind(fields and display_name) equals "string":
            set quoted_display to provider_quote(provider_value(fields and display_name))
            set projected to concat(projected and concat(",\"global_name\":" and quoted_display))
        if count > 0:
            set result to concat(result and ",")
        set result to concat(result and concat(projected and "}"))
        set count to count + 1
    return concat(result and "]")
