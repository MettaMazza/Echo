import "voice_dave"

# Binary network fields are big-endian. Pointers are never converted to strings
# until a bounded, terminated address field has been validated.
define discord_voice_u16 with pointer as Int and offset as Int returning Int:
    return peek_byte(pointer and offset) * 256 + peek_byte(pointer and offset + 1)

define discord_voice_u32 with pointer as Int and offset as Int returning Int:
    return discord_voice_u16(pointer and offset) * 65536 + discord_voice_u16(pointer and offset + 2)

define discord_voice_put_u16 with pointer as Int and offset as Int and value as Int returning Int:
    if value < 0 or else value > 65535:
        return 0
    set written to poke_byte(pointer and offset and value / 256)
    set written to poke_byte(pointer and offset + 1 and value % 256)
    return 1

define discord_voice_put_u32 with pointer as Int and offset as Int and value as Int returning Int:
    if value < 0 or else value > 4294967295:
        return 0
    set written to discord_voice_put_u16(pointer and offset and value / 65536)
    return discord_voice_put_u16(pointer and offset + 2 and value % 65536)

define discord_voice_discovery_request with ssrc as Int returning List:
    if ssrc < 1 or else ssrc > 4294967295:
        return 0
    set pointer to alloc_bytes(74)
    if pointer equals 0:
        return 0
    set index to 0
    repeat while index < 74:
        set written to poke_byte(pointer and index and 0)
        set index to index + 1
    set written to discord_voice_put_u16(pointer and 0 and 1)
    set written to discord_voice_put_u16(pointer and 2 and 70)
    set written to discord_voice_put_u32(pointer and 4 and ssrc)
    set blob to create_list()
    set added to append_list(blob and pointer)
    set added to append_list(blob and 74)
    return blob

# Caller must receive from the connected, authenticated voice server's UDP
# socket. This validates packet structure and SSRC, not source authentication.
define discord_voice_discovery_response with pointer as Int and count as Int and ssrc as Int returning List:
    if pointer equals 0 or else count is not equal to 74 or else ssrc < 1 or else ssrc > 4294967295:
        return 0
    if discord_voice_u16(pointer and 0) is not equal to 2 or else discord_voice_u16(pointer and 2) is not equal to 70 or else discord_voice_u32(pointer and 4) is not equal to ssrc:
        return 0
    set port to discord_voice_u16(pointer and 72)
    if port < 1:
        return 0
    set address to ""
    set index to 8
    set terminated to 0
    repeat while index < 72 and also terminated equals 0:
        set code to peek_byte(pointer and index)
        if code equals 0:
            set terminated to 1
        else:
            set valid to code >= 48 and also code <= 57
            if code equals 46 or else code equals 58 or else (code >= 65 and also code <= 70) or else (code >= 97 and also code <= 102):
                set valid to 1
            if valid equals 0:
                return 0
            set character to alloc_bytes(2)
            if character equals 0:
                return 0
            set written to poke_byte(character and 0 and code)
            set written to poke_byte(character and 1 and 0)
            set address to concat(address and ptr_to_str(character))
            free_bytes(character)
        set index to index + 1
    if terminated equals 0 or else string_length(address) equals 0:
        return 0
    set result to create_list()
    set added to append_list(result and address)
    set added to append_list(result and port)
    return result

# Discord Opus RTP payload type 120, version 2, no extensions or CSRCs.
# Nonce exhaustion is handled by the encryption state; RTP fields may wrap.
define discord_voice_rtp_header with sequence as Int and timestamp as Int and ssrc as Int returning List:
    if sequence < 0 or else sequence > 65535 or else timestamp < 0 or else timestamp > 4294967295 or else ssrc < 1 or else ssrc > 4294967295:
        return 0
    set pointer to alloc_bytes(12)
    if pointer equals 0:
        return 0
    set written to poke_byte(pointer and 0 and 128)
    set written to poke_byte(pointer and 1 and 120)
    set written to discord_voice_put_u16(pointer and 2 and sequence)
    set written to discord_voice_put_u32(pointer and 4 and timestamp)
    set written to discord_voice_put_u32(pointer and 8 and ssrc)
    set blob to create_list()
    set added to append_list(blob and pointer)
    set added to append_list(blob and 12)
    return blob
