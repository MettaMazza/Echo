import "voice_participants"
import "voice_handshake"

# Authenticated voice controls only map members already established by Gateway.
# Socket generation and Gateway generation are distinct bindings. No event here
# creates membership or recording consent. Disconnect retires audio identity;
# the Gateway remains authoritative for channel membership and MLS roster.
define discord_voice_participant_control with participants as List and handshake as List and action as List and gateway_generation as Int and socket_generation as Int returning Str:
    if discord_voice_handshake_current(handshake and socket_generation) equals 0 or else discord_voice_participants_valid(participants and gateway_generation) equals 0:
        return "stale-participant-control"
    if get_list(handshake and 0) is not equal to 4:
        return "participant-control-before-session"
    if action equals 0 or else length_list(action) is not equal to 4:
        return "invalid-participant-control"
    set status to archive_list_text(action and 0)
    set opcode to get_list(action and 1)
    set sequence to get_list(action and 2)
    set values to get_list(action and 3)
    if sequence < -1 or else sequence > 65535:
        return "invalid-participant-control"
    set result to "unhandled-participant-control"
    if status equals "speaking" and also opcode equals 5:
        if length_list(values) is not equal to 3 or else get_list(values and 2) < 0 or else get_list(values and 2) > 7:
            return "invalid-participant-control"
        set result to discord_voice_participants_ssrc(participants and gateway_generation and archive_list_text(values and 0) and get_list(values and 1))
    if status equals "client-disconnect" and also opcode equals 13:
        if length_list(values) is not equal to 1:
            return "invalid-participant-control"
        set result to "audio-identity-retired"
        for each value in get_list(participants and 4):
            set row to value
            if archive_list_text(row and 0) equals archive_list_text(values and 0) and also get_list(row and 2) is not equal to 0:
                set changed to set_list(row and 2 and 0)
                set changed to set_list(participants and 6 and get_list(participants and 6) + 1)
    if result equals "audio-identity-mapped" or else result equals "audio-identity-retired":
        if sequence >= 0:
            set accepted to discord_voice_heartbeat_sequence(get_list(handshake and 1) and sequence and socket_generation)
    return result
