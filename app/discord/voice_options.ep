import "pin_options"

# Voice control accepts identifiers only, never credentials, routes or paths.
define discord_voice_options with arguments as Str returning List:
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return history_status("invalid-arguments")
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if key equals "limit":
            if not (provider_kind(tokens and index + 2) equals "number"):
                return history_status("invalid-limit")
        else if not (key equals "operation" or else key equals "channel" or else key equals "intent" or else key equals "attachment" or else key equals "job" or else key equals "recording" or else key equals "after") or else not (provider_kind(tokens and index + 2) equals "string"):
            return history_status("invalid-arguments")
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set operation to provider_value(tokens and provider_member(tokens and 0 and "operation"))
    set room to provider_member(tokens and 0 and "channel")
    set identity to provider_member(tokens and 0 and "intent")
    set attachment to provider_member(tokens and 0 and "attachment")
    set job to provider_member(tokens and 0 and "job")
    set recording to provider_member(tokens and 0 and "recording")
    set after_field to provider_member(tokens and 0 and "after")
    set limit_field to provider_member(tokens and 0 and "limit")
    if (after_field >= 0 or else limit_field >= 0) and not (operation equals "status" and also recording >= 0):
        return history_status("unused-recording-page-arguments")
    if recording >= 0:
        set selected to provider_value(tokens and recording)
        set value to provider_value(tokens and identity)
        if not (operation equals "stop" or else operation equals "status") or else room >= 0 or else attachment >= 0 or else job >= 0 or else string_length(selected) < 1 or else string_length(selected) > 64 or else string_length(value) < 1 or else string_length(value) > 128:
            return history_status("invalid-recording-arguments")
        if operation equals "status":
            set after to "0"
            set limit to "20"
            if after_field >= 0:
                set after to provider_value(tokens and after_field)
                if http_decimal(after) < 0 or else not (int_to_string(http_decimal(after)) equals after):
                    return history_status("invalid-recording-cursor")
            if limit_field >= 0:
                set limit to provider_value(tokens and limit_field)
                if http_decimal(limit) < 1 or else http_decimal(limit) > 100 or else not (int_to_string(http_decimal(limit)) equals limit):
                    return history_status("invalid-limit")
            return ["valid",operation,value,"recording",selected,after,limit]
        return ["valid",operation,value,"recording",selected]
    if operation equals "stop":
        return history_status("invalid-recording-arguments")
    if job >= 0 and also not (operation equals "status"):
        return history_status("invalid-arguments")
    if operation equals "play":
        set value to provider_value(tokens and identity)
        set selected to provider_value(tokens and attachment)
        if room >= 0 or else string_length(value) < 1 or else string_length(value) > 128 or else string_length(selected) < 1 or else string_length(selected) > 512:
            return history_status("invalid-play-arguments")
        return ["valid",operation,value,selected]
    if attachment >= 0:
        return history_status("invalid-arguments")
    if operation equals "join":
        if identity >= 0 or else discord_snowflake(provider_value(tokens and room)) equals 0:
            return history_status("invalid-join-arguments")
        set retained_voice_result to create_list()
        set retained_voice_added to append_list(retained_voice_result and "valid")
        set retained_voice_added to append_list(retained_voice_result and operation)
        set retained_voice_added to append_list(retained_voice_result and provider_value(tokens and room))
        return retained_voice_result
    if operation equals "status" or else operation equals "leave" or else operation equals "record":
        set value to provider_value(tokens and identity)
        if room >= 0 or else string_length(value) < 1 or else string_length(value) > 128:
            return history_status("invalid-intent-arguments")
        if job >= 0:
            set selected to provider_value(tokens and job)
            if string_length(selected) < 1 or else string_length(selected) > 128:
                return history_status("invalid-job-arguments")
            return ["valid",operation,value,selected]
        return ["valid",operation,value]
    return history_status("unsupported-voice-operation")
