import "automod_options"

define discord_automod_route with guild as Str and rule as Str returning Str:
    if discord_snowflake(guild) equals 0 or else (string_length(rule) > 0 and also discord_snowflake(rule) equals 0):
        return ""
    set route to concat("/guilds/" and concat(guild and "/auto-moderation/rules"))
    if string_length(rule) > 0:
        set route to concat(route and concat("/" and rule))
    return route

define discord_automod_view with body as Str and guild as Str and rule as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "{") or else discord_snowflake(guild) equals 0:
        return ""
    set identity to provider_value(fields and provider_member(fields and 0 and "id"))
    if discord_snowflake(identity) equals 0 or else (string_length(rule) > 0 and also not (identity equals rule)) or else not (provider_value(fields and provider_member(fields and 0 and "guild_id")) equals guild):
        return ""
    set keys to create_list()
    set keys to ["id","guild_id","name","creator_id","event_type","trigger_type","trigger_metadata","actions","enabled","exempt_roles","exempt_channels"]
    set output to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            if count > 0:
                set output to concat(output and ",")
            set output to concat(output and concat(provider_quote(key) and concat(":" and agent_json_source(body and fields and field))))
            set count to count + 1
    return concat(output and "}")

define discord_automod_collection with body as Str and guild as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "["):
        return ""
    set output to "["
    set count to 0
    set index to 1
    set seen to create_list()
    repeat while not (provider_kind(fields and index) equals "]"):
        set identity to provider_value(fields and provider_member(fields and index and "id"))
        set view to discord_automod_view(agent_json_source(body and fields and index) and guild and "")
        if string_length(view) equals 0 or else discord_contains(seen and identity) equals 1:
            return ""
        set added to append_list(seen and identity)
        if count > 0:
            set output to concat(output and ",")
        set output to concat(output and view)
        set count to count + 1
        set index to provider_after(fields and index)
        if index < 0:
            return ""
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return concat(output and "]")
