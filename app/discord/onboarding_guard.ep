import "member_observation"
import "onboarding_view"

# These checks are independent of Echo's configured administrator identities.
# Onboarding updates can assign roles to future members, so both actors need
# current guild-management and role-management permission for an update.
define discord_onboarding_bundle_allowed with bundle as List and guild as Str and actor as Str and bot as Str and editing as Int returning Int:
    if not (archive_list_text(bundle and 0) equals "observed") or else discord_member_bundle_valid(bundle and guild and actor and bot and actor and 0) equals 0 or else (editing is not equal to 0 and also editing is not equal to 1):
        return 0
    set server to archive_list_text(bundle and 1)
    set roles to archive_list_text(bundle and 2)
    set requester to archive_list_text(bundle and 3)
    set bot_member to archive_list_text(bundle and 4)
    if discord_member_guild_permission(server and roles and requester and guild and actor and 5) is not equal to 1 or else discord_member_guild_permission(server and roles and bot_member and guild and bot and 5) is not equal to 1:
        return 0
    if editing equals 1 and also (discord_member_guild_permission(server and roles and requester and guild and actor and 28) is not equal to 1 or else discord_member_guild_permission(server and roles and bot_member and guild and bot and 28) is not equal to 1):
        return 0
    return 1

# A self-selected onboarding role must be an actual manageable guild role.
# Being the requesting guild owner does not bypass the bot's own hierarchy.
define discord_onboarding_role_allowed with bundle as List and guild as Str and actor as Str and bot as Str and identity as Str returning Int:
    if discord_onboarding_bundle_allowed(bundle and guild and actor and bot and 1) equals 0:
        return 0
    set server to archive_list_text(bundle and 1)
    set roles to archive_list_text(bundle and 2)
    set requester to archive_list_text(bundle and 3)
    set bot_member to archive_list_text(bundle and 4)
    set role to discord_role_snapshot(roles and identity)
    if string_length(role) equals 0 or else discord_role_below_member(server and roles and requester and guild and actor and role and 1) equals 0 or else discord_role_below_member(server and roles and bot_member and guild and bot and role and 0) equals 0:
        return 0
    set fields to provider_json_tokens(role)
    set permissions to provider_value(fields and provider_member(fields and 0 and "permissions"))
    return discord_role_permissions_held(server and roles and requester and guild and actor and permissions) equals 1 and also discord_role_permissions_held(server and roles and bot_member and guild and bot and permissions) equals 1
