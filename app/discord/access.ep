# Reuse GET evidence only inside the caller-owned pass. Any Gateway audience
# update invalidates earlier entries; failures are never cached. A new pass
# starts with an empty list and therefore performs new network observations.
define discord_access_snapshot_epoch with journal as Int returning Str:
    set row to history_collect_one(archive_prepare(journal and "SELECT CAST(COALESCE(MAX(rowid),0) AS TEXT) FROM discord_inbox WHERE identity LIKE 'audience:%';"))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    return archive_list_text(row and 1)

define discord_access_snapshot_get with library as Str and token as Str and journal as Int and directory_path as Str and route as Str and bucket as Str and major as Str and snapshot as List returning List:
    set epoch to discord_access_snapshot_epoch(journal)
    if string_length(epoch) equals 0:
        return history_status("audience-observation-unavailable")
    for each entry in snapshot:
        if archive_list_text(entry and 0) equals route and archive_list_text(entry and 1) equals bucket and archive_list_text(entry and 2) equals major and archive_list_text(entry and 3) equals epoch:
            return get_list(entry and 4)
    set observed to discord_access_get(library and token and journal and directory_path and route and bucket and major)
    if archive_list_text(observed and 0) equals "observed" and discord_access_snapshot_epoch(journal) equals epoch:
        set added to append_list(snapshot and [route,bucket,major,epoch,observed])
    return observed
