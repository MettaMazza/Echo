import "expression_changes"

# Only public resource fields leave the controller. Creator records stay in the
# fresh internal observation used for independent ownership checks.
define discord_expression_view with body as Str and kind as Str and guild as Str and resource as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "{") or else discord_snowflake(guild) equals 0:
        return ""
    set identity to provider_value(fields and provider_member(fields and 0 and "id"))
    if discord_snowflake(identity) equals 0 or else (string_length(resource) > 0 and also not (resource equals identity)):
        return ""
    set keys to ["id","name","roles","require_colons","managed","animated","available"]
    if kind equals "sticker":
        if not (provider_value(fields and provider_member(fields and 0 and "guild_id")) equals guild) or else not (provider_value(fields and provider_member(fields and 0 and "type")) equals "2"):
            return ""
        set keys to ["id","guild_id","name","description","tags","type","format_type","available"]
    else if not (kind equals "emoji"):
        return ""
    set output to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            if count > 0:
                set output to concat(output and ",")
            set value to agent_json_source(body and fields and field)
            set output to concat(output and concat(provider_quote(key) and concat(":" and value)))
            set count to count + 1
    return concat(output and "}")
