import "voice_recording_terminal"
import "select"

# Owned by the exclusive interaction-actions process, independently of voice
# process lifetimes. Private config: curl, token, journal, bot, guilds, spool,
# stop file. REST work never blocks interaction execution or the media loop.
define discord_voice_recording_terminal_worker with config as List and stop as Int and completed as Int returning Int:
    if config equals 0 or else length_list(config) is not equal to 7:
        send 1 to completed
        return 1
    set journal to discord_store_open(archive_list_text(config and 2) and archive_list_text(config and 3))
    set status to 0
    if journal equals 0:
        set status to 1
    set waits to create_list()
    set added to append_list(waits and stop)
    repeat while status equals 0:
        if select(waits and 0) >= 0:
            set signal to receive from stop
            break
        set result to discord_voice_recording_terminal_tick(archive_list_text(config and 0) and archive_list_text(config and 1) and journal and archive_list_text(config and 3) and get_list(config and 4) and archive_list_text(config and 5) and archive_list_text(config and 6))
        if result equals "stopped":
            break
        if result equals "recording-terminal-store-failed":
            set status to 1
            break
        if select(waits and 1000) >= 0:
            set signal to receive from stop
            break
    if journal is not equal to 0:
        set closed to sql_close(journal)
    send status to completed
    return status
