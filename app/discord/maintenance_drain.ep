import "../lifecycle/maintenance"
import "../context/checkpoint"

# A marker-specific acknowledgement follows native child reaping, including
# memory work retained after the foreground reply. Old acknowledgements cannot
# authorize a later restart with a different maintenance token.
define discord_maintenance_ack with journal as Int and children as Int returning Int:
    set path to ptr_to_str(get_env("ECHO_MAINTENANCE_FILE"))
    if string_length(path) equals 0:
        return 0
    if sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_maintenance_drain(singleton INTEGER PRIMARY KEY CHECK(singleton=1),token TEXT NOT NULL);") is not equal to 0:
        return 1
    if echo_maintenance_active() equals 0 or else children is not equal to 0:
        return sql_execute(journal and "DELETE FROM discord_maintenance_drain;")
    set token to file_read(path)
    if string_length(token) equals 0:
        return 1
    return archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_maintenance_drain VALUES(1,?) ON CONFLICT(singleton) DO UPDATE SET token=excluded.token;" and [token]) and 101)
