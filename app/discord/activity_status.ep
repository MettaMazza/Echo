import "activity_archive"

# Execution state is independent of delivery cursor/backlog state. Check every
# sibling sharing this thread before describing it as idle.
define discord_activity_execution_title with journal as Int and database as Int and inbox as Str returning Str:
    set cursor to "0"
    repeat while 1 equals 1:
        set row to history_collect_one(checkpoint_prepare(journal and "SELECT rowid,run FROM discord_activity_targets WHERE inbox=?1 AND rowid>CAST(?2 AS INTEGER) ORDER BY rowid LIMIT 1;" and [inbox,cursor]))
        if archive_list_text(row and 0) equals "end":
            return "Echo · Idle · delivering activity logs"
        if not (archive_list_text(row and 0) equals "found"):
            return "Echo · Activity log · status unavailable"
        set cursor to archive_list_text(row and 1)
        set state to agent_run_read(database and archive_list_text(row and 2))
        if state equals 0:
            return "Echo · Activity log · awaiting admission"
        set status to archive_list_text(state and 2)
        if status equals "ready" or else status equals "generating" or else status equals "tools":
            return "Echo · Working · activity log"

define discord_activity_status_update with library as Str and token as Str and journal as Int and database as Int and inbox as Str and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    if sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_activity_titles(inbox TEXT PRIMARY KEY,title TEXT NOT NULL);") is not equal to 0:
        return "title-store-failed"
    set title to discord_activity_execution_title(journal and database and inbox)
    set previous to history_collect_one(checkpoint_prepare(journal and "SELECT title FROM discord_activity_titles WHERE inbox=?;" and [inbox]))
    if archive_list_text(previous and 1) equals title:
        return "title-current"
    set result to discord_activity_thread_update(library and token and journal and inbox and -1 and title and bot and admins and directory_path and stop_file)
    if result equals "archive-state-confirmed":
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_activity_titles(inbox,title) VALUES(?1,?2) ON CONFLICT(inbox) DO UPDATE SET title=excluded.title;" and [inbox,title]) and 101) is not equal to 0:
            return "title-store-failed"
    return result
