import "voice_audio_authority"
import "voice_authorized_worker"

# Native-only proof: status, job identity, attempt, transport proof. This binds
# the extra playback source check to the same Gateway view as CONNECT/SPEAK and
# audience checks. This authorizes playback only, never microphone capture or
# transcription, which require their own explicit opt-in and participant policy.
define discord_voice_audio_proof_check with journal as Int and database as Int and intent as Str and claim as List and proof as List and bot as Str and guilds as List and admins as List and stop_file as Str returning Str:
    set guarded to discord_voice_audio_job_guard(journal and database and intent and claim and bot and guilds and admins and stop_file)
    if not (archive_list_text(guarded and 0) equals "voice-audio-native-current"):
        return archive_list_text(guarded and 0)
    if proof equals 0 or else length_list(proof) is not equal to 4 or else not (archive_list_text(proof and 0) equals "voice-audio-proof") or else not (archive_list_text(proof and 1) equals archive_list_text(claim and 1)) or else not (archive_list_text(proof and 2) equals archive_list_text(claim and 2)):
        return "voice-audio-proof-binding-denied"
    return discord_voice_worker_check(journal and database and intent and get_list(proof and 3) and bot and guilds and admins and stop_file and 1)

define discord_voice_audio_proof with library as Str and token as Str and journal as Int and database as Int and intent as Str and claim as List and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning List:
    set guarded to discord_voice_audio_job_guard(journal and database and intent and claim and bot and guilds and admins and stop_file)
    if not (archive_list_text(guarded and 0) equals "voice-audio-native-current"):
        return guarded
    set transport to discord_voice_request_proof(library and token and journal and database and intent and bot and guilds and admins and directory_path and stop_file and 1)
    if not (archive_list_text(transport and 0) equals "allowed"):
        return transport
    set current to discord_run_source_check(library and token and journal and directory_path and archive_list_text(guarded and 2) and get_list(guarded and 1))
    if not (current equals "current"):
        return history_status(current)
    set proof to create_list()
    set retained_voice_added to append_list(proof and "voice-audio-proof")
    set retained_voice_added to append_list(proof and archive_list_text(claim and 1))
    set retained_voice_added to append_list(proof and archive_list_text(claim and 2))
    set retained_voice_added to append_list(proof and transport)
    set checked to discord_voice_audio_proof_check(journal and database and intent and claim and proof and bot and guilds and admins and stop_file)
    if not (checked equals "allowed"):
        return history_status(checked)
    return proof
