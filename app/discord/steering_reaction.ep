import "queue_offer"

# Resolve only the retained Gateway observation; caller text is not an action.
# This returns an intent, not a guidance confirmation or permission grant.
# The controller must recheck live source/access and admitted run authority.
define discord_steering_reaction with journal as Int and identity as Str returning List:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT kind,payload FROM discord_inbox WHERE identity=?1;" and [identity]))
    if not (archive_list_text(row and 0) equals "found"):
        return history_status("reaction-unavailable")
    if not (archive_list_text(row and 1) equals "MESSAGE_REACTION_ADD"):
        return history_status("not-steering-add")
    set tokens to provider_json_tokens(archive_list_text(row and 2))
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return history_status("invalid-reaction")
    set emoji to provider_value(tokens and provider_member(tokens and 0 and "emoji_name"))
    set custom to provider_value(tokens and provider_member(tokens and 0 and "emoji_id"))
    if string_length(custom) > 0 or else not (emoji equals "↪" or else emoji equals "↪️"):
        return history_status("not-steering-add")
    set message to provider_value(tokens and provider_member(tokens and 0 and "message_id"))
    set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set guild to provider_value(tokens and provider_member(tokens and 0 and "guild_id"))
    set actor to provider_value(tokens and provider_member(tokens and 0 and "user_id"))
    if discord_testing_allows(journal and actor) equals 0:
        return history_status("reaction-unavailable")
    if discord_snowflake(message) equals 0 or else discord_snowflake(room) equals 0 or else discord_snowflake(actor) equals 0:
        return history_status("invalid-reaction")
    set source to concat("message:create:" and message)
    set offer to history_collect_one(checkpoint_prepare(journal and "SELECT o.target,o.actor FROM discord_queue_offers o JOIN discord_inbox i ON i.identity=o.source WHERE o.source=?1 AND o.actor=?2 AND i.kind='MESSAGE_CREATE' AND json_extract(i.payload,'$.id')=?3 AND json_extract(i.payload,'$.channel_id')=?4 AND COALESCE(json_extract(i.payload,'$.guild_id'),'')=?5 AND json_extract(i.payload,'$.author.id')=?2;" and [source,actor,message,room,guild]))
    if not (archive_list_text(offer and 0) equals "found"):
        return history_status("reaction-binding-denied")
    return ["steering-intent",source,archive_list_text(offer and 1),actor,room,guild]
