import "interaction_intake"

define discord_revision_command_definition with name as Str returning Str:
    if name equals "regenerate":
        return "{\"type\":1,\"name\":\"regenerate\",\"description\":\"Regenerate your reply in a new conversation branch.\",\"options\":[{\"type\":3,\"name\":\"message\",\"description\":\"Your original message ID or its delivered Echo reply ID.\",\"required\":true}]}"
    if name equals "edit":
        return "{\"type\":1,\"name\":\"edit\",\"description\":\"Edit your prompt in a new conversation branch.\",\"options\":[{\"type\":3,\"name\":\"message\",\"description\":\"Your original message ID or its delivered Echo reply ID.\",\"required\":true},{\"type\":3,\"name\":\"text\",\"description\":\"Replacement prompt; the original remains preserved.\",\"required\":true}]}"
    return ""

# The actor and destination come only from the authenticated interaction.
# Text is a literal replacement prompt, never registration or authority data.
define discord_revision_command_options with body as Str and mode as Str returning Str:
    if not (mode equals "edit" or else mode equals "regenerate"):
        return ""
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set data to provider_member(tokens and 0 and "data")
    set options to provider_member(tokens and data and "options")
    if not (provider_kind(tokens and options) equals "["):
        return ""
    set message to ""
    set text to ""
    set seen to create_list()
    set items to provider_items(tokens and options)
    for each option in items:
        set name to provider_value(tokens and provider_member(tokens and option and "name"))
        set value to provider_member(tokens and option and "value")
        if not (name equals "message" or else (mode equals "edit" and name equals "text")) or else not (provider_value(tokens and provider_member(tokens and option and "type")) equals "3") or else not (provider_kind(tokens and value) equals "string"):
            return ""
        for each prior in seen:
            if name equals ptr_to_str(prior):
                return ""
        set added to append_list(seen and name)
        if name equals "message":
            set message to provider_value(tokens and value)
        else:
            set text to provider_value(tokens and value)
    if discord_snowflake(message) equals 0 or else (mode equals "edit" and string_length(text) equals 0):
        return ""
    return concat("{\"message\":" and concat(provider_quote(message) and concat(",\"text\":" and concat(provider_quote(text) and "}"))))

define discord_revision_command_matches with body as Str and name as Str returning Int:
    set tokens to provider_json_tokens(body)
    set definition to discord_revision_command_definition(name)
    if tokens equals 0 or else string_length(definition) equals 0:
        return 0
    set expected to provider_json_tokens(definition)
    set actual_items to provider_items(tokens and provider_member(tokens and 0 and "options"))
    set wanted_items to provider_items(expected and provider_member(expected and 0 and "options"))
    if length_list(actual_items) is not equal to length_list(wanted_items):
        return 0
    set index to 0
    repeat while index < length_list(wanted_items):
        set actual to get_list(actual_items and index)
        set wanted to get_list(wanted_items and index)
        set index to index + 1
        set fields to ["type","name","description","required"]
        for each field_name in fields:
            set field to ptr_to_str(field_name)
            if not (provider_value(tokens and provider_member(tokens and actual and field)) equals provider_value(expected and provider_member(expected and wanted and field))):
                return 0
        set restrictions to ["choices","min_length","max_length","options","autocomplete"]
        for each restriction in restrictions:
            if provider_member(tokens and actual and ptr_to_str(restriction)) >= 0:
                return 0
    return 1
