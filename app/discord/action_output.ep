import "message_actions"

# Called only after the ordinary final-output authority guard. Commit the
# channel reply and all its controls together, before any delivery worker can
# see them. No caller-supplied component, URL or destination is accepted.
define discord_action_output with journal as Int and identity as Str and inbox as Str and room as Str and body as Str and final_event as Str and speak as Int returning Str:
    set tokens to provider_json_tokens(body)
    if string_length(identity) equals 0 or else string_length(final_event) equals 0 or else discord_snowflake(room) equals 0 or else tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "invalid-delivery"
    if not (speak equals 0 or else speak equals 1) or else speak equals 0:
        return "invalid-controls"
    if provider_member(tokens and 0 and "components") >= 0:
        return "caller-controls-denied"
    if discord_message_actions_schema(journal) is not equal to 0:
        return "store-failed"
    set components to "[{\"type\":1,\"components\":["
    if speak equals 1:
        set components to concat(components and concat("{\"type\":2,\"style\":2,\"label\":\"Speak\",\"custom_id\":" and concat(provider_quote(discord_message_action_identity(identity and "speak")) and "}")))
    set components to concat(components and "]}]")
    set values to create_list()
    set added to append_list(values and body)
    set added to append_list(values and components)
    set encoded to history_collect_one(checkpoint_prepare(journal and "SELECT json_set(?1,'$.components',json(?2));" and values))
    if not (archive_list_text(encoded and 0) equals "found"):
        return "invalid-delivery"
    set complete_body to archive_list_text(encoded and 1)
    if sql_execute(journal and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-unavailable"
    set keys to create_list()
    set added to append_list(keys and identity)
    set added to append_list(keys and inbox)
    set added to append_list(keys and room)
    set added to append_list(keys and complete_body)
    set added to append_list(keys and substring(ep_sha256(identity) and 0 and 24))
    if archive_finish(checkpoint_prepare(journal and "INSERT OR IGNORE INTO discord_outbox(identity,inbox,channel,body,nonce,state) VALUES(?1,?2,?3,?4,?5,'pending');" and keys) and 101) is not equal to 0:
        return migration_fail(journal and "write-failed")
    set existing to history_collect_one(checkpoint_prepare(journal and "SELECT identity FROM discord_outbox WHERE identity=?1 AND inbox=?2 AND channel=?3 AND body=?4 AND nonce=?5;" and keys))
    if not (archive_list_text(existing and 0) equals "found"):
        return migration_fail(journal and "identity-conflict")
    if speak equals 1 and also string_length(discord_message_action_bind(journal and identity and "speak" and final_event)) equals 0:
        return migration_fail(journal and "action-binding-conflict")
    if sql_execute(journal and "COMMIT;") is not equal to 0:
        return migration_fail(journal and "commit-failed")
    return "enqueued"
