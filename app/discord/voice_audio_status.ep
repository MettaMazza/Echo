import "voice_audio_jobs"
import "run_source"
import "pin_tool"

# Read only the named job in the caller's actor/origin/guild. The tool performs
# current source, administrative and channel permission checks before this read.
# No paths, attachment metadata, request text or attempt token leave the journal.
define discord_voice_audio_status with journal as Int and database as Int and job as Str and intent as Str and actor as Str and origin as Str and guild as Str returning Str:
    set keys to [job,intent,actor,guild]
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT j.state,j.run FROM discord_voice_audio_jobs j JOIN discord_voice_intents i ON i.identity=j.intent WHERE j.identity=?1 AND j.intent=?2 AND j.actor=?3 AND i.guild=?4;" and keys))
    if not (archive_list_text(row and 0) equals "found"):
        return discord_pin_result("voice-audio-job-unavailable" and "none" and "")
    set source to discord_run_source(journal and database and archive_list_text(row and 2))
    if not (archive_list_text(source and 0) equals "found") or else not (archive_list_text(source and 3) equals actor) or else not (archive_list_text(source and 4) equals origin) or else not (archive_list_text(source and 5) equals guild):
        return discord_pin_result("voice-audio-job-unavailable" and "none" and "")
    set state to archive_list_text(row and 1)
    set effects to "queued; playback has not started"
    if state equals "attempted":
        set effects to "playback attempt in progress; delivery not confirmed"
    else if state equals "completed":
        set effects to "local paced sender finished; listener audibility is not confirmed"
    else if state equals "cancelled":
        set effects to "cancelled; any earlier delivery is not undone"
    else if state equals "uncertain":
        set effects to "delivery uncertain; this attempt will not replay"
    else if not (state equals "queued"):
        return discord_pin_result("voice-audio-job-unavailable" and "none" and "")
    set output to concat("{\"status\":" and provider_quote(state))
    set output to concat(output and concat(",\"intent\":" and provider_quote(intent)))
    set output to concat(output and concat(",\"job\":" and provider_quote(job)))
    return concat(output and concat(",\"effects\":" and concat(provider_quote(effects) and "}")))
