import "command_anchor"
import "command_sender"

# Called after fresh Discord access and a confirmed public original anchor.
# Run identity is the authenticated interaction ID, never a model/user option.
# Dispatch is separate: a partial admission cannot run until its exact origin
# receipt is present. Replaying admission must not restart stopped autonomy.
define discord_command_auto_admit with journal as Int and database as Int and identity as Str and bot as Str and guilds as List and admins as List returning List:
    set archive_binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    if not (archive_list_text(archive_binding and 1) equals bot):
        return history_status("archive-binding-denied")
    set anchor to discord_command_anchor_read(journal and identity)
    if not (archive_list_text(anchor and 0) equals "found"):
        return anchor
    set original to archive_list_text(anchor and 6)
    if discord_command_acknowledged(journal and identity and original) equals 0:
        return history_status("command-not-acknowledged")
    set command to discord_command_resolve(journal and original and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access"):
        return command
    if not (archive_list_text(command and 1) equals "auto") or else not (archive_list_text(anchor and 7) equals bot):
        return history_status("command-binding-denied")
    set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
    if string_length(device) equals 0:
        return history_status("principal-unavailable")
    set message to "/auto"
    if string_length(archive_list_text(command and 5)) > 0:
        set message to concat(message and concat(" " and archive_list_text(command and 5)))
    set run to concat("discord-command:" and identity)
    set submitted to channel_silo_submit(database and device and "discord" and archive_list_text(command and 4) and archive_list_text(command and 3) and run and message and create_list())
    if not (archive_list_text(submitted and 0) equals "accepted" or else archive_list_text(submitted and 0) equals "already-accepted"):
        return submitted
    if discord_command_sender_record(database and run and original) is not equal to 0:
        return history_status("sender-record-unavailable")
    set receipt to concat(run and ":discord-command")
    set payload to concat("{\"interaction\":" and concat(provider_quote(identity) and concat(",\"intake_sha256\":" and concat(provider_quote(ep_sha256(original)) and concat(",\"anchor_message\":" and concat(provider_quote(archive_list_text(anchor and 4)) and "}"))))))
    set prior to archive_read_event(database and receipt)
    if prior is not equal to 0:
        if not (archive_list_text(prior and 0) equals archive_list_text(submitted and 1)) or else not (archive_list_text(prior and 2) equals "discord_command_origin") or else not (archive_list_text(prior and 3) equals payload):
            return history_status("command-origin-conflict")
    else if archive_append(database and archive_list_text(submitted and 1) and receipt and "discord_command_origin" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return history_status("command-origin-write-failed")
    set added to append_list(submitted and run)
    return submitted

# Used by the common lineage resolver. There is no fabricated human message:
# the real interaction and its bot-authored public response remain distinct.
define discord_command_run_source with journal as Int and database as Int and run as Str returning Str:
    if not (string_index_of(run and "discord-command:interaction:") equals 0) or else run_authority_allows(database and run and "user") equals 0:
        return ""
    set inbox to substring(run and 16 and string_length(run) - 16)
    set anchor to discord_command_anchor_read(journal and inbox)
    if not (archive_list_text(anchor and 0) equals "found"):
        return ""
    set original_tokens to provider_json_tokens(archive_list_text(anchor and 6))
    set command_data to provider_member(original_tokens and 0 and "data")
    set command_name to provider_value(original_tokens and provider_member(original_tokens and command_data and "name"))
    if command_name equals "auto":
        if run_authority_allows(database and run and "admin") equals 0:
            return ""
    else if not (command_name equals "edit" or else command_name equals "regenerate"):
        return ""
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    if not (archive_list_text(binding and 1) equals archive_list_text(anchor and 7)):
        return ""
    set device to concat("discord:" and archive_list_text(anchor and 1))
    set principal to principal_for_device(database and device)
    if string_length(principal) equals 0:
        return ""
    set group to channel_silo_identity("discord" and archive_list_text(anchor and 3) and archive_list_text(anchor and 2) and principal)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT r.session FROM echo_runs r JOIN echo_group_run_origins o ON o.run=r.run AND o.session=r.session JOIN echo_group_sessions s ON s.session=r.session JOIN echo_run_authority a ON a.run=r.run WHERE r.run=?1 AND s.group_id=?2 AND a.device=?3;" and [run,group,device]))
    if not (archive_list_text(row and 0) equals "found") or else group_run_session_allows(database and run and archive_list_text(row and 1)) equals 0:
        return ""
    set receipt to archive_read_event(database and concat(run and ":discord-command"))
    if receipt equals 0 or else not (archive_list_text(receipt and 0) equals archive_list_text(row and 1)) or else not (archive_list_text(receipt and 2) equals "discord_command_origin"):
        return ""
    set tokens to provider_json_tokens(archive_list_text(receipt and 3))
    if not (provider_value(tokens and provider_member(tokens and 0 and "interaction")) equals inbox) or else not (provider_value(tokens and provider_member(tokens and 0 and "intake_sha256")) equals archive_list_text(anchor and 5)) or else not (provider_value(tokens and provider_member(tokens and 0 and "anchor_message")) equals archive_list_text(anchor and 4)):
        return ""
    return inbox
