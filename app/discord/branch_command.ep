import "final_binding"
import "../security/group_branches"

# The command executor has verified its immutable registration, Gateway actor,
# acknowledgement and fresh Discord channel access. Recheck database rights
# inside group_session_branch; message IDs never grant access by themselves.
define discord_branch_apply with journal as Int and database as Int and device as Str and identity as Str and message as Str and guild as Str and room as Str returning Str:
    set final to discord_final_lookup(journal and message and room)
    if not (archive_list_text(final and 0) equals "found"):
        return "branch-source-unavailable"
    set keys to [archive_list_text(final and 1),archive_list_text(final and 2)]
    set source to history_collect_one(checkpoint_prepare(database and "SELECT r.session FROM echo_runs r JOIN echo_events e ON e.session=r.session AND e.event=?2 AND e.kind='assistant_final' WHERE r.run=?1 AND json_extract(e.payload,'$.run_id')=r.run;" and keys))
    if not (archive_list_text(source and 0) equals "found"):
        return "branch-source-unavailable"
    set result to group_session_branch(database and device and concat("discord-command:" and identity) and archive_list_text(source and 1) and archive_list_text(final and 2) and "discord" and guild and room and "continue" and "")
    if archive_list_text(result and 0) equals "created" or else archive_list_text(result and 0) equals "already-created":
        return "branch-created"
    if archive_list_text(result and 0) equals "invalid-boundary" or else archive_list_text(result and 0) equals "operation-identity-conflict":
        return "branch-source-unavailable"
    return archive_list_text(result and 0)
