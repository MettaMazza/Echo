define discord_socket_close with socket as List returning Int:
    if not (archive_list_text(socket and 0) equals "connected"):
        return 1
    set library to get_list(socket and 1)
    set cleaned to ep_dlcall1(ep_dlsym(library and "curl_easy_cleanup") and get_list(socket and 2))
    return ep_dlclose(library)

# Sends one complete small Gateway control payload. An incomplete transmission
# is ambiguous and requires reconnect/resume, never a blind resend.
define discord_socket_send with socket as List and body as Str returning Int:
    if not (archive_list_text(socket and 0) equals "connected"):
        return 0
    set size to string_length(body)
    if size < 1 or else size > 4096:
        return 0
    set rooted_literal_5 to create_list()
    set retained_value_added to append_list(rooted_literal_5 and 0)
    set sent to rooted_literal_5
    set library to get_list(socket and 1)
    set status to ep_dlcall6(ep_dlsym(library and "curl_ws_send") and get_list(socket and 2) and str_to_ptr(body) and size and get_list_data_ptr(sent) and 0 and 1)
    if status is not equal to 0:
        return 0
    return get_list(sent and 0) equals size

# A fixed I/O buffer is not a message limit. Caller accumulates successive
# chunks using offset/bytesleft and fragmentation flags before JSON parsing.
# libcurl handles WebSocket masking and automatic ping/pong.
define discord_socket_read with socket as List returning List:
    if not (archive_list_text(socket and 0) equals "connected"):
        set rooted_literal_6 to create_list()
        set retained_value_added to append_list(rooted_literal_6 and "not-connected")
        return rooted_literal_6
    set library to get_list(socket and 1)
    set buffer to alloc_bytes(65537)
    if buffer equals 0:
        set rooted_literal_7 to create_list()
        set retained_value_added to append_list(rooted_literal_7 and "allocation-failed")
        return rooted_literal_7
    set rooted_literal_8 to create_list()
    set retained_value_added to append_list(rooted_literal_8 and 0)
    set received to rooted_literal_8
    set rooted_literal_9 to create_list()
    set retained_value_added to append_list(rooted_literal_9 and 0)
    set metadata to rooted_literal_9
    set status to ep_dlcall5(ep_dlsym(library and "curl_ws_recv") and get_list(socket and 2) and buffer and 65536 and get_list_data_ptr(received) and get_list_data_ptr(metadata))
    if status equals 81:
        free_bytes(buffer)
        set rooted_literal_10 to create_list()
        set retained_value_added to append_list(rooted_literal_10 and "again")
        return rooted_literal_10
    if status is not equal to 0 or else get_list(metadata and 0) equals 0:
        free_bytes(buffer)
        set retained_values_15 to create_list()
        set retained_value_added to append_list(retained_values_15 and "receive-failed")
        set retained_value_added to append_list(retained_values_15 and int_to_string(status))
        return retained_values_15
    set count to get_list(received and 0)
    if count < 0 or else count > 65536:
        free_bytes(buffer)
        set rooted_literal_11 to create_list()
        set retained_value_added to append_list(rooted_literal_11 and "invalid-receive-size")
        return rooted_literal_11
    set meta to get_list(metadata and 0)
    set flags to peek_byte(meta and 4)
    set offset to research_native_word(meta + 8)
    set remaining to research_native_word(meta + 16)
    if flags equals 8:
        set first to -1
        set second to -1
        if count > 0:
            set first to peek_byte(buffer and 0)
        if count > 1:
            set second to peek_byte(buffer and 1)
        free_bytes(buffer)
        set retained_values_16 to create_list()
        set retained_value_added to append_list(retained_values_16 and "close-chunk")
        set retained_value_added to append_list(retained_values_16 and int_to_string(first))
        set retained_value_added to append_list(retained_values_16 and int_to_string(second))
        set retained_value_added to append_list(retained_values_16 and int_to_string(count))
        set retained_value_added to append_list(retained_values_16 and int_to_string(offset))
        set retained_value_added to append_list(retained_values_16 and int_to_string(remaining))
        return retained_values_16
    if flags equals 16 or else flags equals 64:
        free_bytes(buffer)
        set rooted_literal_12 to create_list()
        set retained_value_added to append_list(rooted_literal_12 and "control")
        return rooted_literal_12
    set terminated to poke_byte(buffer and count and 0)
    set value to concat(ptr_to_str(buffer) and "")
    free_bytes(buffer)
    if string_length(value) is not equal to count:
        set rooted_literal_13 to create_list()
        set retained_value_added to append_list(rooted_literal_13 and "binary-or-invalid-text")
        return rooted_literal_13
    set retained_values_17 to create_list()
    set retained_value_added to append_list(retained_values_17 and "chunk")
    set retained_value_added to append_list(retained_values_17 and value)
    set retained_value_added to append_list(retained_values_17 and int_to_string(flags))
    set retained_value_added to append_list(retained_values_17 and int_to_string(offset))
    set retained_value_added to append_list(retained_values_17 and int_to_string(remaining))
    return retained_values_17
