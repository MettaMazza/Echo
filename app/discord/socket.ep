import "../network/curl_native"

# Host entry points hold an additional library reference for their full lifetime.
# Per-request references are balanced, without repeatedly tearing down OpenSSL.
define discord_library_open with path as Str returning Int:
    return ep_dlopen(path)

# The library path is pinned host configuration, never a model argument.
# This transport is Discord-only. Resume endpoints are validated separately
# before use; the initial Gateway has a fixed origin and mandatory TLS checks.
define discord_gateway_endpoint with base as Str returning Str:
    if string_index_of(base and "wss://") is not equal to 0:
        return ""
    set host to substring(base and 6 and string_length(base) - 6)
    set size to string_length(host)
    if size <= 11:
        return ""
    if not (substring(host and size - 11 and 11) equals ".discord.gg"):
        return ""
    set index to 0
    repeat while index < size:
        set code to peek_byte(str_to_ptr(host) and index)
        set valid to 0
        if code >= 97 and code <= 122:
            set valid to 1
        if code >= 48 and code <= 57:
            set valid to 1
        if code equals 45 or else code equals 46:
            set valid to 1
        if valid equals 0:
            return ""
        set index to index + 1
    return concat(base and "/?v=10&encoding=json")

define discord_socket_open with library_path as Str returning List:
    return discord_socket_open_at(library_path and "wss://gateway.discord.gg")

define discord_socket_open_at with library_path as Str and base as Str returning List:
