import "../providers/local_json"
import "message_read_options"
import "rich_post"

# One Discord post per invocation. Long normal replies retain their existing
# sentence-aware chunking. No model-controlled mentions, routes or credentials.
define discord_post_options with arguments as Str returning List:
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return history_status("invalid-arguments")
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if key equals "embeds":
            if not (provider_kind(tokens and index + 2) equals "["):
                return history_status("invalid-embeds")
        else if key equals "poll":
            if not (provider_kind(tokens and index + 2) equals "{"):
                return history_status("invalid-poll")
        else if not (key equals "operation" or else key equals "post" or else key equals "text") or else not (provider_kind(tokens and index + 2) equals "string"):
            return history_status("invalid-arguments")
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set operation to provider_value(tokens and provider_member(tokens and 0 and "operation"))
    set text_field to provider_member(tokens and 0 and "text")
    set text to provider_value(tokens and text_field)
    set post_field to provider_member(tokens and 0 and "post")
    set post to provider_value(tokens and post_field)
    if not (operation equals "reply" or else operation equals "edit" or else operation equals "delete" or else operation equals "status" or else operation equals "retry"):
        return history_status("invalid-operation")
    if operation equals "reply":
        if post_field >= 0:
            return history_status("unused-post")
    else if string_length(post) equals 0:
        return history_status("post-required")
    set embeds to ""
    set poll to ""
    set embeds_field to provider_member(tokens and 0 and "embeds")
    set poll_field to provider_member(tokens and 0 and "poll")
    if not (operation equals "reply") and (embeds_field >= 0 or else poll_field >= 0):
        return history_status("rich-content-reply-only")
    if embeds_field >= 0:
        if discord_rich_embeds(tokens and provider_items(tokens and embeds_field)) < 0:
            return history_status("invalid-embed-fields-or-limits")
        set embeds to agent_json_source(arguments and tokens and embeds_field)
    if poll_field >= 0:
        set poll to discord_rich_poll(tokens and poll_field)
        if string_length(poll) equals 0:
            return history_status("invalid-poll-fields-or-limits")
    if operation equals "reply" or else operation equals "edit":
        if (string_length(text) equals 0 and also string_length(embeds) equals 0 and also string_length(poll) equals 0) or else provider_valid_utf8(text) equals 0:
            return history_status("text-required")
        set units to 0
        set offset to 0
        repeat while offset < string_length(text):
            set byte to peek_byte(str_to_ptr(text) and offset)
            if byte < 128 or else byte >= 192:
                set units to units + 1
                if byte >= 240:
                    set units to units + 1
            set offset to offset + 1
        if units > 2000:
            return history_status("discord-message-limit-2000; split into separate posts")
    else if text_field >= 0:
        return history_status("unused-text")
    return ["valid",operation,post,text,embeds,poll]

define discord_post_body with text as Str and reply_to as Str returning Str:
    set body to concat("{\"content\":" and provider_quote(text))
    set body to concat(body and ",\"allowed_mentions\":{\"parse\":[],\"replied_user\":false}")
    if string_length(reply_to) > 0:
        set body to concat(body and concat(",\"message_reference\":{\"message_id\":" and concat(provider_quote(reply_to) and ",\"fail_if_not_exists\":true}")))
    return concat(body and "}")
