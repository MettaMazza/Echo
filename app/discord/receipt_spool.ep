import "../workspace/directories"

# Time and random shards bound directory growth without deleting audit evidence.
# All components are host-generated; descriptor-relative traversal rejects links.
define discord_receipt_name with library as Int and root as Int and identity as Str returning Str:
    set hour to ep_time_now_ms() / 3600000
    set shard to concat("receipts/" and int_to_string(hour / 24))
    set shard to concat(shard and concat("/" and int_to_string(hour)))
    set shard to concat(shard and concat("/" and substring(identity and 0 and 2)))
    set directory to workspace_directory_open(library and root and shard and 0)
    if directory < 0:
        set directory to workspace_directory_open(library and root and shard and 1)
    if directory < 0:
        return ""
    set closed to net_close(directory)
    return concat(shard and concat("/" and identity))
