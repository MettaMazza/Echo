import "multipart_audio"
import "expression_changes"

# Sticker endpoints use individual form fields and file, not message payload_json.
# Reuse the qualified frozen-file reader, then copy its verified binary region.
# File format, dimensions and scoped admission remain controller prerequisites.
define discord_sticker_multipart with path as Str and digest as Str and size as Int and metadata as Str and filename as Str and media as Str returning List:
    if size < 1 or else size > 524288 or else discord_expression_changes(metadata and "sticker" and 1) equals 0:
        return history_status("invalid-sticker-upload")
    set frozen to discord_file_multipart(path and digest and size and 524288 and "{}" and filename and media)
    if not (archive_list_text(frozen and 0) equals "multipart-ready"):
        return frozen
    set fields to provider_json_tokens(metadata)
    set boundary to concat("EchoSticker" and ptr_to_str(ep_uuid_v4()))
    set prefix to ""
    set keys to ["name","description","tags"]
    for each item in keys:
        set key to ptr_to_str(item)
        set value to provider_value(fields and provider_member(fields and 0 and key))
        set prefix to concat(prefix and concat("--" and concat(boundary and "\r\nContent-Disposition: form-data; name=\"")))
        set prefix to concat(prefix and concat(key and concat("\"\r\n\r\n" and concat(value and "\r\n"))))
    set prefix to concat(prefix and concat("--" and concat(boundary and "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"")))
    set prefix to concat(prefix and concat(filename and concat("\"\r\nContent-Type: " and concat(media and "\r\n\r\n"))))
    set suffix to concat("\r\n--" and concat(boundary and "--\r\n"))
    set prefix_size to string_length(prefix)
    set total to prefix_size + size + string_length(suffix)
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if system equals 0:
        set released to discord_audio_multipart_release(frozen)
        return history_status("platform-unavailable")
    set buffer to ep_dlcall1(ep_dlsym(system and "malloc") and total + 1)
    if buffer equals 0:
        set released to discord_audio_multipart_release(frozen)
        set closed to ep_dlclose(system)
        return history_status("allocation-failed")
    set copied to ep_dlcall3(ep_dlsym(system and "memcpy") and buffer and str_to_ptr(prefix) and prefix_size)
    set copied to ep_dlcall3(ep_dlsym(system and "memcpy") and buffer + prefix_size and get_list(frozen and 1) + get_list(frozen and 4) and size)
    set copied to ep_dlcall3(ep_dlsym(system and "memcpy") and buffer + prefix_size + size and str_to_ptr(suffix) and string_length(suffix))
    set released to discord_audio_multipart_release(frozen)
    set closed to ep_dlclose(system)
    set result to history_status("multipart-ready")
    set added to append_list(result and buffer)
    set added to append_list(result and total)
    set added to append_list(result and concat("multipart/form-data; boundary=" and boundary))
    set added to append_list(result and prefix_size)
    return result
