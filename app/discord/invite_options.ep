import "rich_post"
import "audit_reason"

# Codes are identifiers, never URL paths or arbitrary fetch destinations.
define discord_invite_code_valid with code as Str returning Int:
    if string_length(code) < 1 or else string_length(code) > 100:
        return 0
    set index to 0
    repeat while index < string_length(code):
        if string_contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" and substring(code and index and 1)) equals 0:
            return 0
        set index to index + 1
    return 1

define discord_invite_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|operation|code|reason|observed_sha256|max_age|max_uses|temporary|") equals 0:
        return history_status("invalid-arguments")
    set strings to create_list()
    set added to append_list(strings and "operation")
    set added to append_list(strings and "code")
    set added to append_list(strings and "reason")
    set added to append_list(strings and "observed_sha256")
    for each item in strings:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and not (provider_kind(fields and field) equals "string"):
            return history_status("invalid-string")
    set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
    if not (operation equals "list" or else operation equals "inspect" or else operation equals "create" or else operation equals "delete"):
        return history_status("invalid-operation")
    set code to provider_value(fields and provider_member(fields and 0 and "code"))
    if operation equals "inspect" or else operation equals "delete":
        if discord_invite_code_valid(code) equals 0:
            return history_status("invalid-invite-code")
    else if provider_member(fields and 0 and "code") >= 0:
        return history_status("unused-code")
    set reason to provider_value(fields and provider_member(fields and 0 and "reason"))
    if operation equals "create" or else operation equals "delete":
        if string_length(discord_audit_reason(reason)) equals 0:
            return history_status("reason-required")
    else if provider_member(fields and 0 and "reason") >= 0:
        return history_status("unused-reason")
    set digest to provider_value(fields and provider_member(fields and 0 and "observed_sha256"))
    if operation equals "delete":
        if string_length(digest) is not equal to 64:
            return history_status("observed-sha256-required")
        set index to 0
        repeat while index < 64:
            if string_contains("0123456789abcdef" and substring(digest and index and 1)) equals 0:
                return history_status("invalid-sha256")
            set index to index + 1
    else if provider_member(fields and 0 and "observed_sha256") >= 0:
        return history_status("unused-sha256")
    set age to "3600"
    set uses to "1"
    set temporary to "false"
    set field to provider_member(fields and 0 and "max_age")
    if field >= 0:
        if not (operation equals "create") or else discord_rich_integer(fields and field and 0 and 604800) equals 0:
            return history_status("invalid-or-unused-max-age")
        set age to provider_value(fields and field)
    set field to provider_member(fields and 0 and "max_uses")
    if field >= 0:
        if not (operation equals "create") or else discord_rich_integer(fields and field and 0 and 100) equals 0:
            return history_status("invalid-or-unused-max-uses")
        set uses to provider_value(fields and field)
    set field to provider_member(fields and 0 and "temporary")
    if field >= 0:
        if not (operation equals "create") or else not (provider_kind(fields and field) equals "true" or else provider_kind(fields and field) equals "false"):
            return history_status("invalid-or-unused-temporary")
        set temporary to provider_value(fields and field)
    set payload to concat("{\"unique\":true,\"max_age\":" and concat(age and concat(",\"max_uses\":" and concat(uses and concat(",\"temporary\":" and concat(temporary and "}"))))))
    set result to create_list()
    set added to append_list(result and "valid")
    set added to append_list(result and operation)
    set added to append_list(result and code)
    set added to append_list(result and reason)
    set added to append_list(result and digest)
    set added to append_list(result and payload)
    return result
