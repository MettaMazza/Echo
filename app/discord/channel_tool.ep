import "../retained_text"
import "channel_options"
import "channel_permission_guard"
import "pin_tool"
import "community_intent"
import "run_barrier"

define discord_channels_execute with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    set options to discord_channel_options(arguments)
    if not (archive_list_text(options and 0) equals "valid"):
        return discord_pin_result(archive_list_text(options and 0) and "none" and "")
    if tool_policy_allows(database and run and call_id and "discord_channels") equals 0:
        return discord_pin_result("not-authorized" and "none" and "")
    if not ((get_argument_count() equals 15 and also get_argument(13) equals "--turn") or else (get_argument_count() equals 16 and also get_argument(13) equals "--job")):
        return discord_pin_result("discord-runtime-unavailable" and "none" and "")
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    set location to history_collect_one(archive_prepare(database and "SELECT file FROM pragma_database_list WHERE name='main';"))
    if not (archive_list_text(binding and 0) equals "found") or else not (archive_list_text(binding and 1) equals get_argument(7)) or else not (archive_list_text(location and 1) equals get_argument(4)):
        return discord_pin_result("discord-binding-denied" and "none" and "")
    set journal to discord_store_open(get_argument(3) and get_argument(7))
    if journal equals 0:
        return discord_pin_result("discord-journal-unavailable" and "none" and "")
    set source to discord_run_source(journal and database and run)
    if not (archive_list_text(source and 0) equals "found"):
        set closed to sql_close(journal)
        return discord_pin_result("discord-origin-denied" and "none" and "")
    set credential to read_file(get_argument(2))
    if credential equals 0:
        set closed to sql_close(journal)
        return discord_pin_result("discord-credential-unavailable" and "none" and "")
    set guilds to create_list()
    set split_count to retained_text_split(guilds and get_argument(8) and ",")
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(9) and ",")
    set result to discord_channels_perform(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and database and run and call_id and source and options and get_argument(7) and guilds and admins and get_argument(5) and get_argument(6))
    set closed to sql_close(journal)
    return result

# Snapshot permission check supports non-message channel types. The initiating
# conversational channel is independently checked by the existing access path.
define discord_channels_permission with library as Str and token as Str and journal as Int and directory_path as Str and bot as Str and guild as Str and actor as Str and target as Str and guild_only as Int returning Str:
    set target_tokens to provider_json_tokens(target)
    set room to provider_value(target_tokens and provider_member(target_tokens and 0 and "id"))
    set permission_body to target
    if guild_only equals 1:
        set permission_body to concat("{\"id\":" and concat(provider_quote(room) and concat(",\"guild_id\":" and concat(provider_quote(guild) and ",\"permission_overwrites\":[]}"))))
    set server to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and guild) and "GET:guild" and guild)
    set roles to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and "/roles")) and "GET:roles" and guild)
    if not (archive_list_text(server and 0) equals "observed") or else not (archive_list_text(roles and 0) equals "observed"):
        return "permission-snapshot-unavailable"
    set retained_keys_2 to create_list()
    set added to append_list(retained_keys_2 and actor)
    set added to append_list(retained_keys_2 and bot)
    for each identity in retained_keys_2:
        set person to ptr_to_str(identity)
        set member to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and concat("/members/" and person))) and "GET:member" and guild)
        if not (archive_list_text(member and 0) equals "observed"):
            return "member-snapshot-unavailable"
        if discord_member_timeout(journal and archive_list_text(member and 1) and ep_time_now_ms()) is not equal to 0:
            return "member-timeout-or-invalid"
        if discord_channel_permission(archive_list_text(server and 1) and archive_list_text(roles and 1) and archive_list_text(member and 1) and permission_body and guild and person and room and 4) is not equal to 1:
            return "manage-channels-permission-denied"
        if discord_channel_permission(archive_list_text(server and 1) and archive_list_text(roles and 1) and archive_list_text(member and 1) and target and guild and person and room and 10) is not equal to 1:
            return "target-view-permission-denied"
    return "allowed"

define discord_channels_perform with library as Str and token as Str and journal as Int and database as Int and run as Str and call_id as Str and source as List and options as List and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if discord_pin_admin(database and run and call_id) equals 0:
        return "{\"status\":\"admin-required\",\"cause\":\"requester-role-required\",\"restriction_scope\":\"requester\",\"required_role\":\"admin\",\"system_failure\":false,\"effects\":\"none\"}"
    set actor to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set operation to archive_list_text(options and 1)
    set target_id to archive_list_text(options and 2)
    set payload to archive_list_text(options and 5)
    set permission_change to operation equals "permissions_set" or else operation equals "permissions_delete"
    set required_bit to 4
    if permission_change:
        set required_bit to 28
    if discord_contains(guilds and guild) equals 0 or else discord_contains(admins and actor) equals 0:
        return discord_pin_result("discord-origin-denied" and "none" and "")
    if file_exists(stop_file) or else tool_policy_allows(database and run and call_id and "discord_channels") equals 0:
        return discord_pin_result("not-authorized-or-stopped" and "none" and "")
    set access to discord_access_check_bit(library and token and journal and directory_path and bot and guild and room and actor and admins and required_bit)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_pin_result(concat("discord-access:" and archive_list_text(access and 0)) and "none; requester and bot lack the required live channel permission" and "")
    set inbox to discord_job_origin(journal and database and run)
    set current to discord_run_source_check(library and token and journal and directory_path and inbox and source)
    if not (current equals "current"):
        return discord_pin_result(current and "none" and "")
    set observed to discord_access_get(library and token and journal and directory_path and concat("/channels/" and room) and "GET:channel" and room)
    if not (archive_list_text(observed and 0) equals "observed"):
        return discord_pin_result("origin-unavailable" and "none" and archive_list_text(observed and 1))
    set origin to archive_list_text(observed and 1)
    set origin_fields to provider_json_tokens(origin)
    if not (provider_value(origin_fields and provider_member(origin_fields and 0 and "id")) equals room) or else not (provider_value(origin_fields and provider_member(origin_fields and 0 and "guild_id")) equals guild):
        return discord_pin_result("origin-identity-mismatch" and "none" and "")
    set target to origin
    set route to concat("/channels/" and target_id)
    if operation equals "list":
        set route to concat("/guilds/" and concat(guild and "/channels"))
    if not (operation equals "create"):
        set observed to discord_access_get(library and token and journal and directory_path and route and "GET:community-channel" and guild)
        if not (archive_list_text(observed and 0) equals "observed"):
            return discord_pin_result(archive_list_text(observed and 0) and "none" and archive_list_text(observed and 1))
        set target to archive_list_text(observed and 1)
    set receipt to archive_list_text(observed and 3)
    set view to ""
    if operation equals "list":
        set view to discord_channels_page(target and origin and guild and options)
        if string_length(view) equals 0:
            return discord_pin_result("invalid-channel-list" and "none" and receipt)
    else:
        if discord_channel_same_audience(origin and target and guild) equals 0:
            return discord_pin_result("target-audience-not-proven" and "none; metadata withheld, not evidence that the channel is absent" and "")
        set fields to provider_json_tokens(target)
        if not (operation equals "create") and not (provider_value(fields and provider_member(fields and 0 and "id")) equals target_id):
            return discord_pin_result("target-identity-mismatch" and "none" and receipt)
        if operation equals "edit" or else operation equals "delete" or else permission_change:
            if not (ep_sha256(target) equals archive_list_text(options and 4)):
                return discord_pin_result("channel-changed" and "none; inspect current channel before deciding again" and receipt)
        set create_flag to 0
        if operation equals "create":
            set create_flag to 1
        set permission to "allowed"
        if permission_change:
            set permission to discord_overwrite_permission(library and token and journal and directory_path and bot and guild and actor and target and options)
        else:
            set permission to discord_channels_permission(library and token and journal and directory_path and bot and guild and actor and target and create_flag)
        if not (permission equals "allowed"):
            return discord_pin_result(permission and "none" and receipt)
        if operation equals "create" or else operation equals "edit":
            set kind to provider_value(fields and provider_member(fields and 0 and "type"))
            if operation equals "create":
                set changes to provider_json_tokens(payload)
                set kind to provider_value(changes and provider_member(changes and 0 and "type"))
            if discord_channel_fields_match(payload and kind) equals 0:
                return discord_pin_result("fields-not-supported-for-channel-type" and "none" and receipt)
        if operation equals "inspect":
            set view to discord_channel_view(target)
        if operation equals "create":
            set overwrites to agent_json_source(origin and fields and provider_member(fields and 0 and "permission_overwrites"))
            set payload to concat(substring(payload and 0 and string_length(payload) - 1) and concat(",\"permission_overwrites\":" and concat(overwrites and "}")))
            set route to concat("/guilds/" and concat(guild and "/channels"))
        if operation equals "delete" and target_id equals room:
            return discord_pin_result("current-control-channel" and "none; issue deletion from a different authorised channel so delivery and control remain available" and receipt)
    if operation equals "create" or else operation equals "edit":
        set changes to provider_json_tokens(payload)
        set parent_id to provider_value(changes and provider_member(changes and 0 and "parent_id"))
        if string_length(parent_id) > 0:
            set parent to discord_access_get(library and token and journal and directory_path and concat("/channels/" and parent_id) and "GET:community-parent" and guild)
            if not (archive_list_text(parent and 0) equals "observed"):
                return discord_pin_result("parent-unavailable" and "none" and archive_list_text(parent and 1))
            set parent_body to archive_list_text(parent and 1)
            set parent_fields to provider_json_tokens(parent_body)
            if not (provider_value(parent_fields and provider_member(parent_fields and 0 and "id")) equals parent_id) or else not (provider_value(parent_fields and provider_member(parent_fields and 0 and "type")) equals "4") or else discord_channel_same_audience(origin and parent_body and guild) equals 0:
                return discord_pin_result("parent-identity-type-or-audience-denied" and "none" and "")
            set permission to discord_channels_permission(library and token and journal and directory_path and bot and guild and actor and parent_body and 0)
            if not (permission equals "allowed"):
                return discord_pin_result(permission and "none" and "")
    # Recheck current source permission and captured/current call authority. No
    # target content is released after a revocation or cancelled source.
    set access to discord_access_check_bit(library and token and journal and directory_path and bot and guild and room and actor and admins and required_bit)
    if not (archive_list_text(access and 0) equals "allowed") or else file_exists(stop_file) or else discord_pin_admin(database and run and call_id) equals 0 or else tool_policy_allows(database and run and call_id and "discord_channels") equals 0 or else not (discord_job_origin(journal and database and run) equals inbox) or else discord_run_barrier(journal and inbox and http_decimal(archive_list_text(source and 7)) and archive_list_text(source and 6) and room and guild) is not equal to 0:
        return discord_pin_result("authority-source-or-permission-changed" and "none" and receipt)
    if string_length(view) > 0:
        return concat("{\"status\":\"observed\",\"source\":\"Discord REST; untrusted metadata\",\"data\":" and concat(view and concat(",\"receipt\":" and concat(provider_quote(receipt) and "}"))))
    set method to "PATCH"
    if operation equals "create":
        set method to "POST"
    else if operation equals "delete":
        set method to "DELETE"
        set payload to ""
    if permission_change:
        set route to concat(route and concat("/permissions/" and archive_list_text(options and 6)))
        set method to "PUT"
        if operation equals "permissions_delete":
            set method to "DELETE"
    set claim to discord_community_claim(journal and run and call_id and concat(method and concat(route and payload)))
    if not (claim equals "claimed"):
        return discord_pin_result(claim and "not established by this invocation; no automatic replay" and "")
    set changed to discord_access_bytes_audit(library and token and journal and directory_path and method and route and concat(method and ":community-channel") and guild and str_to_ptr(payload) and string_length(payload) and "application/json" and archive_list_text(options and 3))
    if not (archive_list_text(changed and 0) equals "observed"):
        return discord_pin_result(concat("channel-change-unconfirmed:" and archive_list_text(changed and 0)) and "not established; inspect current state; do not repeat uncertain creates" and archive_list_text(changed and 1))
    if permission_change:
        set verified to discord_access_get(library and token and journal and directory_path and concat("/channels/" and target_id) and "GET:permission-verification" and guild)
        set verification to "unavailable"
        if archive_list_text(verified and 0) equals "observed":
            set verification to discord_overwrite_matches(archive_list_text(verified and 1) and options)
        return concat("{\"status\":\"applied\",\"effects\":\"Discord accepted the permission change\",\"verification\":" and concat(provider_quote(verification) and concat(",\"receipt\":" and concat(provider_quote(archive_list_text(changed and 3)) and concat(",\"verification_receipt\":" and concat(provider_quote(archive_list_text(verified and 3)) and "}"))))))
    set changed_body to archive_list_text(changed and 1)
    if discord_channel_same_audience(origin and changed_body and guild) equals 0:
        return discord_pin_result("applied" and "Discord accepted the action; response metadata withheld because audience no longer matches" and archive_list_text(changed and 3))
    set response to discord_channel_view(changed_body)
    if string_length(response) equals 0:
        return discord_pin_result("channel-response-unconfirmed" and "remote response retained; inspect channel before another action" and archive_list_text(changed and 3))
    return concat("{\"status\":\"applied\",\"data\":" and concat(response and concat(",\"receipt\":" and concat(provider_quote(archive_list_text(changed and 3)) and "}"))))

# Fetch complete current snapshots for both authenticated requester and bot.
# Subject and parent validation never exports additional channel metadata.
define discord_overwrite_permission with library as Str and token as Str and journal as Int and directory_path as Str and bot as Str and guild as Str and actor as Str and target as Str and options as List returning Str:
    set target_tokens to provider_json_tokens(target)
    set room to provider_value(target_tokens and provider_member(target_tokens and 0 and "id"))
    set server to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and guild) and "GET:guild" and guild)
    set roles to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and "/roles")) and "GET:roles" and guild)
    if not (archive_list_text(server and 0) equals "observed") or else not (archive_list_text(roles and 0) equals "observed"):
        return "permission-snapshot-unavailable"
    set role_tokens to provider_json_tokens(archive_list_text(roles and 1))
    set retained to create_list()
    set role_items to provider_items(role_tokens and 0)
    set added to append_list(retained and role_items)
    set subject to archive_list_text(options and 6)
    set subject_type to archive_list_text(options and 7)
    set found to 0
    if subject_type equals "0":
        for each item in role_items:
            if provider_value(role_tokens and provider_member(role_tokens and item and "id")) equals subject:
                set found to found + 1
        if found is not equal to 1:
            return "subject-role-not-found"
    else:
        set person to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and concat("/members/" and subject))) and "GET:overwrite-subject" and guild)
        if not (archive_list_text(person and 0) equals "observed"):
            return "subject-member-unavailable"
        set member_tokens to provider_json_tokens(archive_list_text(person and 1))
        if not (provider_value(member_tokens and provider_member(member_tokens and provider_member(member_tokens and 0 and "user") and "id")) equals subject):
            return "subject-member-identity-mismatch"
    set parent to "{}"
    set parent_id to provider_value(target_tokens and provider_member(target_tokens and 0 and "parent_id"))
    if discord_snowflake(parent_id) equals 1:
        set observed_parent to discord_access_get(library and token and journal and directory_path and concat("/channels/" and parent_id) and "GET:permission-parent" and guild)
        if not (archive_list_text(observed_parent and 0) equals "observed"):
            return "parent-permission-unavailable"
        set parent to archive_list_text(observed_parent and 1)
        set fields to provider_json_tokens(parent)
        if not (provider_value(fields and provider_member(fields and 0 and "id")) equals parent_id) or else not (provider_value(fields and provider_member(fields and 0 and "guild_id")) equals guild) or else not (provider_value(fields and provider_member(fields and 0 and "type")) equals "4"):
            return "parent-identity-mismatch"
    set people to create_list()
    set added to append_list(people and actor)
    set added to append_list(people and bot)
    for each identity in people:
        set user to ptr_to_str(identity)
        set observed to discord_access_get(library and token and journal and directory_path and concat("/guilds/" and concat(guild and concat("/members/" and user))) and "GET:member" and guild)
        if not (archive_list_text(observed and 0) equals "observed") or else discord_member_timeout(journal and archive_list_text(observed and 1) and ep_time_now_ms()) is not equal to 0:
            return "member-unavailable-or-timeout"
        set allow to "0"
        set deny to "0"
        if archive_list_text(options and 1) equals "permissions_set":
            set fields to provider_json_tokens(archive_list_text(options and 5))
            set allow to provider_value(fields and provider_member(fields and 0 and "allow"))
            set deny to provider_value(fields and provider_member(fields and 0 and "deny"))
        if discord_overwrite_assignment(archive_list_text(server and 1) and archive_list_text(roles and 1) and archive_list_text(observed and 1) and target and parent and guild and user and room and allow and deny) is not equal to 1:
            return "permission-assignment-denied"
    return "allowed"
