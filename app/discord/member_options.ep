import "member_guard"
import "rich_post"

# Every field is operation-specific; ignored destructive options are errors.
define discord_member_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|operation|member|reason|observed_sha256|nickname|duration_seconds|delete_message_seconds|") equals 0:
        return history_status("invalid-arguments")
    set strings to create_list()
    set added to append_list(strings and "operation")
    set added to append_list(strings and "member")
    set added to append_list(strings and "reason")
    set added to append_list(strings and "observed_sha256")
    for each item in strings:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and not (provider_kind(fields and field) equals "string"):
            return history_status("invalid-string")
    set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
    if not (operation equals "inspect" or else operation equals "inspect_ban" or else operation equals "kick" or else operation equals "ban" or else operation equals "unban" or else operation equals "timeout" or else operation equals "remove_timeout" or else operation equals "nickname"):
        return history_status("invalid-operation")
    set member to provider_value(fields and provider_member(fields and 0 and "member"))
    if discord_snowflake(member) equals 0:
        return history_status("member-required")
    set mutation to not (operation equals "inspect" or else operation equals "inspect_ban")
    set reason to provider_value(fields and provider_member(fields and 0 and "reason"))
    set digest to provider_value(fields and provider_member(fields and 0 and "observed_sha256"))
    if mutation:
        if string_length(discord_audit_reason(reason)) equals 0:
            return history_status("reason-required")
        if string_length(digest) is not equal to 64:
            return history_status("observed-sha256-required")
        set index to 0
        repeat while index < 64:
            if string_contains("0123456789abcdef" and substring(digest and index and 1)) equals 0:
                return history_status("invalid-sha256")
            set index to index + 1
    else if provider_member(fields and 0 and "reason") >= 0 or else provider_member(fields and 0 and "observed_sha256") >= 0:
        return history_status("unused-mutation-field")
    set nickname to "null"
    set field to provider_member(fields and 0 and "nickname")
    if operation equals "nickname":
        if field < 0 or else not (provider_kind(fields and field) equals "string" or else provider_kind(fields and field) equals "null"):
            return history_status("nickname-required-string-or-null")
        if provider_kind(fields and field) equals "string":
            set value to provider_value(fields and field)
            if discord_rich_units(value) < 1 or else discord_rich_units(value) > 32 or else string_length(string_trim(value)) equals 0:
                return history_status("invalid-nickname")
            set nickname to provider_quote(value)
    else if field >= 0:
        return history_status("unused-nickname")
    set duration to "0"
    set field to provider_member(fields and 0 and "duration_seconds")
    if operation equals "timeout":
        if discord_rich_integer(fields and field and 1 and 2419200) equals 0:
            return history_status("invalid-timeout-duration")
        set duration to provider_value(fields and field)
    else if field >= 0:
        return history_status("unused-duration")
    set deletion to "0"
    set field to provider_member(fields and 0 and "delete_message_seconds")
    if field >= 0:
        if not (operation equals "ban"):
            return history_status("unused-message-deletion")
        if discord_rich_integer(fields and field and 0 and 604800) equals 0:
            return history_status("invalid-message-deletion")
        set deletion to provider_value(fields and field)
    set result to create_list()
    set added to append_list(result and "valid")
    set added to append_list(result and operation)
    set added to append_list(result and member)
    set added to append_list(result and reason)
    set added to append_list(result and digest)
    set added to append_list(result and nickname)
    set added to append_list(result and duration)
    set added to append_list(result and deletion)
    return result
