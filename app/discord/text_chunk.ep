import "../providers/local_json"

# Lossless byte-bound paging: sentence boundary, then whitespace, then a
# UTF-8-safe hard limit only for a single overlong unbroken token.
define discord_text_chunk with text as Str and offset as Int and limit as Int returning Str:
    if offset < 0 or else offset >= string_length(text) or else limit < 1 or else provider_valid_utf8(text) equals 0:
        return ""
    if provider_valid_utf8(substring(text and 0 and offset)) equals 0:
        return ""
    set remaining to string_length(text) - offset
    if remaining <= limit:
        return substring(text and offset and remaining)
    set count to limit
    repeat while count > 0 and also provider_valid_utf8(substring(text and offset and count)) equals 0:
        set count to count - 1
    set sentence to 0
    set whitespace to 0
    set index to 0
    set line_prefix to 1
    repeat while index < count:
        set character to substring(text and offset + index and 1)
        if character equals " " or else character equals "\n" or else character equals "\t" or else character equals "\r":
            set whitespace to index + 1
        if (character equals "." and line_prefix equals 0) or else character equals "?" or else character equals "!":
            set end to index + 1
            repeat while end < count:
                set next to substring(text and offset + end and 1)
                if next equals "." or else next equals "?" or else next equals "!" or else next equals "\"" or else next equals "'" or else next equals ")" or else next equals "]":
                    set end to end + 1
                else:
                    break
            set next to substring(text and offset + end and 1)
            if next equals " " or else next equals "\n" or else next equals "\t" or else next equals "\r":
                set sentence to end
        # A numbered-list marker is not an end-of-sentence full stop.
        set code to get_character(text and offset + index)
        if character equals "\n" or else character equals "\r":
            set line_prefix to 1
        else if not (character equals " " or else character equals "\t" or else (code >= 48 and code <= 57)):
            set line_prefix to 0
        set index to index + 1
    if sentence > 0:
        set count to sentence
    else if whitespace > 0:
        set count to whitespace
    return substring(text and offset and count)
