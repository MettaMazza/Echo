import "queue_control_store"

# A separate host worker owns this cycle so long speech synthesis cannot delay
# queue reactions. No model requests are generated by this worker.
define discord_queue_control_tick with library as Str and token as Str and journal as Int and database as Int and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    if discord_queue_control_schema(journal) is not equal to 0:
        return "queue-store-failed"
    set recovered to discord_steering_recovery_tick(journal and database)
    if recovered equals "recovery-store-failed":
        return recovered
    set reaction to discord_reaction_job_next(journal)
    if archive_list_text(reaction and 0) equals "found":
        set identity to archive_list_text(reaction and 1)
        set result to discord_steering_reaction_tick(library and token and journal and database and identity and bot and guilds and admins and directory_path and stop_file)
        if result equals "stopped":
            return result
        set recorded to discord_reaction_job_record(journal and identity and result)
        if recorded equals "reaction-store-failed":
            return recorded
    else if not (archive_list_text(reaction and 0) equals "end"):
        return "reaction-store-failed"
    set next to discord_queue_refresh_next(journal)
    if archive_list_text(next and 0) equals "end":
        return "idle"
    if not (archive_list_text(next and 0) equals "found"):
        return "queue-store-failed"
    set source to archive_list_text(next and 1)
    set refreshed to discord_queue_refresh_source(journal and database and source)
    if not (refreshed equals "refreshed"):
        return refreshed
    # Clear queue/steer controls first; confirmation comes last and is proven
    # again at transport time. A pending DELETE precedes its replacement PUT.
    for each slot in ["queue","steer","confirm"]:
        set result to discord_queue_marker_tick(library and token and journal and database and source and ptr_to_str(slot) and bot and guilds and admins and directory_path and stop_file)
        if not (result equals "settled" or else result equals "observed"):
            return result
    return discord_queue_status_tick(library and token and journal and source and bot and guilds and admins and directory_path and stop_file)
