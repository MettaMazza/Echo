import "routing"
import "../lifecycle/migrations"

# Connector-only control state. Never copy this table, toggle receipts, or
# rejected user input into the agent archive, prompt, or passive context.
define discord_testing_schema with journal as Int returning Int:
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_testing_receipts(sequence INTEGER PRIMARY KEY AUTOINCREMENT,interaction TEXT NOT NULL UNIQUE,actor TEXT NOT NULL,digest TEXT NOT NULL,enabled INTEGER NOT NULL CHECK(enabled IN (0,1)),admins TEXT NOT NULL,observed_ms INTEGER NOT NULL); CREATE TRIGGER IF NOT EXISTS discord_testing_no_update BEFORE UPDATE ON discord_testing_receipts BEGIN SELECT RAISE(ABORT,'Control receipts are immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_testing_no_delete BEFORE DELETE ON discord_testing_receipts BEGIN SELECT RAISE(ABORT,'Control receipts persist'); END;")

define discord_testing_allows with journal as Int and actor as Str returning Int:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT CASE WHEN enabled=0 OR EXISTS(SELECT 1 FROM json_each(admins) WHERE value=?1) THEN '1' ELSE '0' END FROM discord_testing_receipts ORDER BY sequence DESC LIMIT 1;" and [actor]))
    if archive_list_text(row and 0) equals "end":
        return 1
    if archive_list_text(row and 0) equals "found" and archive_list_text(row and 1) equals "1":
        return 1
    return 0

define discord_testing_actor with body as Str returning Str:
    set tokens to provider_json_tokens(body)
    set member to provider_member(tokens and 0 and "member")
    set actor to provider_value(tokens and provider_member(tokens and provider_member(tokens and member and "user") and "id"))
    if discord_snowflake(actor) equals 0:
        set actor to provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "user") and "id"))
    return actor

# Caller has verified the registered command and live channel access. Bind
# the mutation to its acknowledged immutable interaction; retries never flip
# the switch twice or reverse a newer admin's decision.
define discord_testing_toggle with journal as Int and identity as Str and body as Str and actor as Str and admins as List returning Str:
    if discord_contains(admins and actor) equals 0:
        return "admin-required"
    if sql_execute(journal and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-lock-unavailable"
    set prior to history_collect_one(checkpoint_prepare(journal and "SELECT actor,digest,CAST(enabled AS TEXT) FROM discord_testing_receipts WHERE interaction=?1;" and [identity]))
    set enabled to ""
    if archive_list_text(prior and 0) equals "found":
        if not (archive_list_text(prior and 1) equals actor) or else not (archive_list_text(prior and 2) equals ep_sha256(body)):
            set rolled to archive_rollback(journal)
            return "command-binding-denied"
        set enabled to archive_list_text(prior and 3)
    else:
        set admission to history_collect_one(checkpoint_prepare(journal and "SELECT i.identity FROM discord_inbox i JOIN discord_interaction_jobs j ON j.identity=i.identity WHERE i.identity=?1 AND i.payload=?2 AND j.state='acknowledged';" and [identity,body]))
        if not (archive_list_text(prior and 0) equals "end") or else not (archive_list_text(admission and 0) equals "found"):
            set rolled to archive_rollback(journal)
            return "command-not-acknowledged"
        set next to history_collect_one(archive_prepare(journal and "SELECT CAST(1-COALESCE((SELECT enabled FROM discord_testing_receipts ORDER BY sequence DESC LIMIT 1),0) AS TEXT);"))
        set enabled to archive_list_text(next and 1)
        set trusted to "["
        set index to 0
        for each admin in admins:
            if index > 0:
                set trusted to concat(trusted and ",")
            set trusted to concat(trusted and provider_quote(ptr_to_str(admin)))
            set index to index + 1
        set trusted to concat(trusted and "]")
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_testing_receipts(interaction,actor,digest,enabled,admins,observed_ms) VALUES(?1,?2,?3,CAST(?4 AS INTEGER),?5,CAST(?6 AS INTEGER));" and [identity,actor,ep_sha256(body),enabled,trusted,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
            set rolled to archive_rollback(journal)
            return "store-failed"
    if sql_execute(journal and "COMMIT;") is not equal to 0:
        set rolled to archive_rollback(journal)
        return "store-failed"
    set current to history_collect_one(archive_prepare(journal and "SELECT CAST(enabled AS TEXT) FROM discord_testing_receipts ORDER BY sequence DESC LIMIT 1;"))
    if not (archive_list_text(current and 0) equals "found"):
        return "store-failed"
    if archive_list_text(current and 1) equals "1":
        return "testing-enabled"
    return "testing-disabled"

# A queued event received while closed must not become eligible after reopening.
define discord_testing_received_allows with journal as Int and actor as Str and received as Str returning Int:
    if discord_testing_allows(journal and actor) equals 0:
        return 0
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT CASE WHEN enabled=0 OR EXISTS(SELECT 1 FROM json_each(admins) WHERE value=?1) THEN '1' ELSE '0' END FROM discord_testing_receipts WHERE observed_ms<=CAST(?2 AS INTEGER) ORDER BY sequence DESC LIMIT 1;" and [actor,received]))
    if archive_list_text(row and 0) equals "end":
        return 1
    if archive_list_text(row and 0) equals "found" and archive_list_text(row and 1) equals "1":
        return 1
    return 0

define discord_testing_inbox_allows with journal as Int and actor as Str and identity as Str returning Int:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT CAST(received_ms AS TEXT) FROM discord_inbox WHERE identity=?1;" and [identity]))
    if not (archive_list_text(row and 0) equals "found"):
        return 0
    return discord_testing_received_allows(journal and actor and archive_list_text(row and 1))
