import "command_binding"
import "access"
import "gateway_intake"

# Fixed host-owned definitions. Only implemented controls are eligible;
# registration never substitutes for execution or current admin authority.
define discord_control_command_definition with name as Str returning Str:
    if name equals "retry":
        return "{\"type\":1,\"name\":\"retry\",\"description\":\"Continue a safely retryable Echo request without resending your message.\",\"options\":[{\"type\":3,\"name\":\"message\",\"description\":\"Original message, command anchor or delivered reply ID.\",\"required\":true}]}"
    if name equals "edit" or else name equals "regenerate":
        return discord_revision_command_definition(name)
    if name equals "branch":
        return "{\"type\":1,\"name\":\"branch\",\"description\":\"Continue from an Echo reply here, preserving the original conversation.\",\"options\":[{\"type\":3,\"name\":\"message\",\"description\":\"Echo reply message ID (Copy Message ID), any delivered chunk.\",\"required\":true}]}"
    if name equals "cancel":
        return "{\"type\":1,\"name\":\"cancel\",\"description\":\"Cancel your queued message or active Echo request in this channel.\",\"options\":[{\"type\":3,\"name\":\"message\",\"description\":\"Original message ID (Copy Message ID), not the bot reply ID.\",\"required\":true}]}"
    if name equals "attachments":
        return discord_attachment_command_definition()
    if name equals "hud":
        return discord_hud_command_definition()
    if name equals "share":
        return discord_share_command_definition()
    if name equals "project":
        return discord_project_command_definition()
    if name equals "export":
        return "{\"type\":1,\"name\":\"export\",\"description\":\"Download a verified archive of one of your conversations here.\",\"options\":[{\"type\":3,\"name\":\"session\",\"description\":\"Session ID shown by /history or /search.\",\"required\":true}]}"
    if name equals "search":
        return "{\"type\":1,\"name\":\"search\",\"description\":\"Find your Echo conversations by message text in this channel.\",\"options\":[{\"type\":3,\"name\":\"query\",\"description\":\"Text to find in your saved messages and Echo replies.\",\"required\":true}]}"
    if name equals "history":
        return "{\"type\":1,\"name\":\"history\",\"description\":\"List your saved Echo conversations in this channel.\",\"options\":[{\"type\":3,\"name\":\"after\",\"description\":\"Optional last session ID from the previous page.\",\"required\":false}]}"
    if name equals "resume":
        return "{\"type\":1,\"name\":\"resume\",\"description\":\"Resume one of your saved Echo conversations here.\",\"options\":[{\"type\":3,\"name\":\"session\",\"description\":\"Session ID shown by /history.\",\"required\":true}]}"
    if name equals "auto":
        return "{\"type\":1,\"name\":\"auto\",\"description\":\"Start Echo autonomy here, optionally for a task (admin only).\",\"options\":[{\"type\":3,\"name\":\"prompt\",\"description\":\"Optional task for Echo to work on until complete.\",\"required\":false}]}"
    if name equals "autooff":
        return "{\"type\":1,\"name\":\"autooff\",\"description\":\"Stop your Discord autonomy and preserve saved progress (admin only).\",\"options\":[]}"
    if not (name equals "new"):
        return ""
    return "{\"type\":1,\"name\":\"new\",\"description\":\"Start a new Echo conversation here, preserving previous history.\",\"options\":[] }"

define discord_control_command_matches with body as Str and name as Str returning Int:
    set definition to discord_control_command_definition(name)
    if string_length(definition) equals 0:
        return 0
    set expected to provider_json_tokens(definition)
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 0
    if not (provider_value(tokens and provider_member(tokens and 0 and "name")) equals name) or else not (provider_value(tokens and provider_member(tokens and 0 and "type")) equals "1") or else not (provider_value(tokens and provider_member(tokens and 0 and "description")) equals provider_value(expected and provider_member(expected and 0 and "description"))):
        return 0
    if name equals "edit" or else name equals "regenerate":
        return discord_revision_command_matches(body and name)
    if name equals "attachments":
        return discord_attachment_command_matches(body)
    if name equals "hud":
        return discord_hud_command_matches(body)
    if name equals "share":
        return discord_share_command_matches(body)
    if name equals "project":
        return discord_project_command_matches(body)
    set options to provider_member(tokens and 0 and "options")
    if name equals "history" or else name equals "resume" or else name equals "search" or else name equals "export" or else name equals "cancel" or else name equals "branch" or else name equals "retry":
        set option_items to provider_items(tokens and options)
        if not (provider_kind(tokens and options) equals "[") or else length_list(option_items) is not equal to 1:
            return 0
        set option to get_list(option_items and 0)
        set expected_options to provider_items(expected and provider_member(expected and 0 and "options"))
        set expected_option to get_list(expected_options and 0)
        for each field_name in ["type","name","description"]:
            set field to ptr_to_str(field_name)
            if not (provider_value(tokens and provider_member(tokens and option and field)) equals provider_value(expected and provider_member(expected and expected_option and field))):
                return 0
        set required to provider_value(tokens and provider_member(tokens and option and "required"))
        if (name equals "resume" or else name equals "search" or else name equals "export" or else name equals "cancel" or else name equals "branch" or else name equals "retry") and not (required equals "true"):
            return 0
        if name equals "history" and required equals "true":
            return 0
        for each restriction in ["choices","min_length","max_length","options","autocomplete"]:
            if provider_member(tokens and option and ptr_to_str(restriction)) >= 0:
                return 0
        return 1
    if name equals "auto":
        if not (provider_kind(tokens and options) equals "[") or else length_list(provider_items(tokens and options)) is not equal to 1:
            return 0
        set option to get_list(provider_items(tokens and options) and 0)
        if not (provider_value(tokens and provider_member(tokens and option and "type")) equals "3") or else not (provider_value(tokens and provider_member(tokens and option and "name")) equals "prompt") or else not (provider_value(tokens and provider_member(tokens and option and "description")) equals "Optional task for Echo to work on until complete."):
            return 0
        for each flag in ["required","autocomplete"]:
            set field to provider_member(tokens and option and ptr_to_str(flag))
            if field >= 0 and also not (provider_value(tokens and field) equals "false"):
                return 0
        for each restriction in ["choices","min_length","max_length","options"]:
            if provider_member(tokens and option and ptr_to_str(restriction)) >= 0:
                return 0
        return 1
    if options >= 0 and also (not (provider_kind(tokens and options) equals "[") or else length_list(provider_items(tokens and options)) is not equal to 0):
        return 0
    return 1

# Inspect before creating, including after an uncertain earlier POST. Never
# bulk overwrite other commands or blindly retry a mutation. All evidence
# stays in the private host transport spool and the bound command journal.
define discord_control_command_register with name as Str and library as Str and token as Str and journal as Int and bot as Str and guild as Str and directory_path as Str returning Str:
    if string_length(discord_control_command_definition(name)) equals 0 or else discord_snowflake(bot) equals 0 or else discord_snowflake(guild) equals 0:
        return "invalid-registration-scope"
    set route to concat("/applications/" and concat(bot and concat("/guilds/" and concat(guild and "/commands"))))
    set observed to discord_access_get(library and token and journal and directory_path and route and "GET:guild-commands" and guild)
    if not (archive_list_text(observed and 0) equals "observed"):
        return concat("inspect:" and archive_list_text(observed and 0))
    set body to archive_list_text(observed and 1)
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else not (provider_kind(tokens and 0) equals "["):
        return "invalid-command-list"
    set found to ""
    for each entry in provider_items(tokens and 0):
        if provider_value(tokens and provider_member(tokens and entry and "name")) equals name and provider_value(tokens and provider_member(tokens and entry and "type")) equals "1":
            if string_length(found) > 0:
                return "ambiguous-registration"
            set found to discord_json_original(body and tokens and entry)
    if string_length(found) > 0:
        if discord_control_command_matches(found and name) equals 0:
            return "existing-definition-conflict"
        return discord_command_observe(journal and found and bot and guild)
    set created to discord_access_body(library and token and journal and directory_path and "POST" and route and "POST:guild-command" and guild and discord_control_command_definition(name))
    if not (archive_list_text(created and 0) equals "observed"):
        return concat("creation-unconfirmed-inspect-before-retry:" and archive_list_text(created and 0))
    set body to archive_list_text(created and 1)
    if discord_control_command_matches(body and name) equals 0:
        return "created-definition-mismatch"
    return discord_command_observe(journal and body and bot and guild)

# Preserve the existing /new maintenance interface.
define discord_new_command_definition returning Str:
    return discord_control_command_definition("new")

define discord_new_command_matches with body as Str returning Int:
    return discord_control_command_matches(body and "new")

define discord_new_command_register with library as Str and token as Str and journal as Int and bot as Str and guild as Str and directory_path as Str returning Str:
    return discord_control_command_register("new" and library and token and journal and bot and guild and directory_path)
