import "command_binding"
import "access"
import "gateway_intake"

# Fixed host-owned definition. Do not advertise autonomy until its executor
# has passed acceptance; registration never substitutes for implementation.
define discord_new_command_definition returning Str:
    return "{\"type\":1,\"name\":\"new\",\"description\":\"Start a new Echo conversation here, preserving previous history.\",\"options\":[] }"

define discord_new_command_matches with body as Str returning Int:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 0
    if not (provider_value(tokens and provider_member(tokens and 0 and "name")) equals "new") or else not (provider_value(tokens and provider_member(tokens and 0 and "type")) equals "1") or else not (provider_value(tokens and provider_member(tokens and 0 and "description")) equals "Start a new Echo conversation here, preserving previous history."):
        return 0
    set options to provider_member(tokens and 0 and "options")
    if options >= 0 and also (not (provider_kind(tokens and options) equals "[") or else length_list(provider_items(tokens and options)) is not equal to 0):
        return 0
    return 1

# Inspect before creating, including after an uncertain earlier POST. Never
# bulk overwrite other commands or blindly retry a mutation. All evidence
# stays in the private host transport spool and the bound command journal.
define discord_new_command_register with library as Str and token as Str and journal as Int and bot as Str and guild as Str and directory_path as Str returning Str:
    if discord_snowflake(bot) equals 0 or else discord_snowflake(guild) equals 0:
        return "invalid-registration-scope"
    set route to concat("/applications/" and concat(bot and concat("/guilds/" and concat(guild and "/commands"))))
    set observed to discord_access_get(library and token and journal and directory_path and route and "GET:guild-commands" and guild)
    if not (archive_list_text(observed and 0) equals "observed"):
        return concat("inspect:" and archive_list_text(observed and 0))
    set body to archive_list_text(observed and 1)
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else not (provider_kind(tokens and 0) equals "["):
        return "invalid-command-list"
    set found to ""
    for each entry in provider_items(tokens and 0):
        if provider_value(tokens and provider_member(tokens and entry and "name")) equals "new" and provider_value(tokens and provider_member(tokens and entry and "type")) equals "1":
            if string_length(found) > 0:
                return "ambiguous-registration"
            set found to discord_json_original(body and tokens and entry)
    if string_length(found) > 0:
        if discord_new_command_matches(found) equals 0:
            return "existing-definition-conflict"
        return discord_command_observe(journal and found and bot and guild)
    set created to discord_access_body(library and token and journal and directory_path and "POST" and route and "POST:guild-command" and guild and discord_new_command_definition())
    if not (archive_list_text(created and 0) equals "observed"):
        return concat("creation-unconfirmed-inspect-before-retry:" and archive_list_text(created and 0))
    set body to archive_list_text(created and 1)
    if discord_new_command_matches(body) equals 0:
        return "created-definition-mismatch"
    return discord_command_observe(journal and body and bot and guild)
