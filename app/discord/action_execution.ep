import "message_actions"
import "activity_worker"

# Resolve the immutable final to its actual admitted run, not a run inferred
# from user content, component text, a channel name or a supplied file path.
define discord_action_context with journal as Int and database as Int and body as Str and bot as Str and admins as List returning List:
    set action to discord_message_action_resolve(journal and body and bot and admins)
    if not (archive_list_text(action and 0) equals "bound-needs-live-access"):
        return action
    set final_event to archive_list_text(action and 2)
    set inbox to archive_list_text(action and 3)
    set event to archive_read_event(database and final_event)
    if event equals 0 or else not (archive_list_text(event and 2) equals "assistant_final"):
        return history_status("final-unavailable")
    set tokens to provider_json_tokens(archive_list_text(event and 3))
    set run to provider_value(tokens and provider_member(tokens and 0 and "run_id"))
    if string_length(run) equals 0 or else not (discord_job_origin(journal and database and run) equals inbox):
        return history_status("run-source-denied")
    if archive_list_text(action and 1) equals "trace" and also run_authority_allows(database and run and "admin") equals 0:
        return history_status("run-authority-revoked")
    set added to append_list(action and run)
    return action

# Repeated clicks open the same private stream/cursor. Only the original
# configured admin can request it; actual source and destination permissions
# are rechecked before every page by the existing delivery controller.
define discord_trace_action_tick with library as Str and token as Str and journal as Int and database as Int and body as Str and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    if discord_worker_schema(journal) is not equal to 0 or else discord_delivery_schema(journal) is not equal to 0:
        return "store-unavailable"
    set action to discord_action_context(journal and database and body and bot and admins)
    if not (archive_list_text(action and 0) equals "bound-needs-live-access"):
        return archive_list_text(action and 0)
    if not (archive_list_text(action and 1) equals "trace"):
        return "not-trace-action"
    set inbox to archive_list_text(action and 3)
    set run to archive_list_text(action and 5)
    set keys to create_list()
    set added to append_list(keys and inbox)
    set inbox to archive_list_text(action and 3)
    set source to discord_intake_source(journal and inbox)
    if not (archive_list_text(source and 0) equals "found"):
        return "source-unavailable"
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set actor to archive_list_text(action and 4)
    set access to discord_access_check(library and token and journal and directory_path and bot and guild and room and actor and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return "source-access-denied"
    if not (discord_run_source_check(library and token and journal and directory_path and inbox and source) equals "current"):
        return "source-changed"
    if file_exists(stop_file):
        return "stopped"
    set destination to discord_activity_private_ensure(library and token and journal and inbox and bot and admins and directory_path)
    if discord_snowflake(destination) equals 0:
        return "private-destination-unavailable"
    set stream to discord_activity_stream_open(journal and inbox and run and destination and 1)
    if string_length(stream) equals 0:
        return "private-stream-unavailable"
    return discord_activity_stream_deliver_tick(library and token and journal and database and stream and bot and admins and directory_path and stop_file)
