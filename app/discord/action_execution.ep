import "message_actions"
import "activity_worker"

# Resolve the immutable final to its actual admitted run, not a run inferred
# from user content, component text, a channel name or a supplied file path.
define discord_action_context with journal as Int and database as Int and body as Str and bot as Str and admins as List returning List:
    set action to discord_message_action_resolve(journal and body and bot and admins)
    if not (archive_list_text(action and 0) equals "bound-needs-live-access"):
        return action
    set final_event to archive_list_text(action and 2)
    set inbox to archive_list_text(action and 3)
    set event to archive_read_event(database and final_event)
    if event equals 0 or else not (archive_list_text(event and 2) equals "assistant_final"):
        return history_status("final-unavailable")
    set tokens to provider_json_tokens(archive_list_text(event and 3))
    set run to provider_value(tokens and provider_member(tokens and 0 and "run_id"))
    if string_length(run) equals 0 or else not (discord_job_origin(journal and database and run) equals inbox):
        return history_status("run-source-denied")
    set added to append_list(action and run)
    return action
