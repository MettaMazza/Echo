import "member_guard"

# Guild emoji/sticker administration. Evaluate requester and bot independently;
# creator ownership never transfers from the bot to the requesting person.
# The controller separately binds the resource, admin grant and current source.
define discord_expression_permission with server as Str and roles as Str and member as Str and guild as Str and person as Str and creator as Str and managed as Int and operation as Str returning Int:
    if not (operation equals "read" or else operation equals "create" or else operation equals "modify" or else operation equals "delete"):
        return 0
    if managed < 0 or else managed > 1:
        return 0
    set fields to provider_json_tokens(server)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_value(fields and provider_member(fields and 0 and "id")) equals guild):
        return 0
    if discord_member_highest_position(roles and member and guild and person) < 0:
        return 0
    if operation equals "read":
        return 1
    if managed equals 1:
        return 0
    set create_allowed to discord_member_guild_permission(server and roles and member and guild and person and 43)
    if operation equals "create":
        return create_allowed
    set manage_allowed to discord_member_guild_permission(server and roles and member and guild and person and 30)
    return manage_allowed equals 1 or else (creator equals person and also create_allowed equals 1)
