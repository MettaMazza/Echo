import "voice_audio_proof"
import "voice_recording_proof"
import "select"
import "voice_permission_mailbox"


# Configurations are native snapshots owned by one observer, not mutable shared
# state. A caller starts a separate mailbox for each claimed audio attempt.
define discord_voice_permission_config_valid with config as List returning Int:
    if config equals 0 or else not (length_list(config) equals 11 or else length_list(config) equals 12):
        return 0
    if length_list(config) equals 12:
        set claim to get_list(config and 11)
        if claim is not equal to 0 and also length_list(claim) equals 2 and also archive_list_text(claim and 0) equals "recording":
            return get_list(config and 10) equals 0 and also string_length(archive_list_text(claim and 1)) > 0 and also string_length(archive_list_text(claim and 1)) <= 64
        if get_list(config and 10) is not equal to 1 or else claim equals 0 or else length_list(claim) is not equal to 8 or else not (archive_list_text(claim and 0) equals "attempted"):
            return 0
    return 1

# Dedicated permission observer with its own SQLite connections. Configuration
# is native host data: curl, token, journal path, archive path, intent, bot,
# guild list, admin list, private spool, stop file, playback flag. An optional
# twelfth field binds a claimed audio job or [recording, recording identity].
# These replies retain their operation binding; never feed them to a join mailbox.
# Never log configuration, which contains the credential.
# Requests are increasing positive serials; zero stops. Replies pair serial and
# native proof/error. The caller admits only one outstanding refresh, preventing
# an unbounded REST queue and keeping slow requests off the media timing loop.
define discord_voice_permission_observer with config as List and requests as Int and replies as Int and completed as Int returning Int:
    if discord_voice_permission_config_valid(config) equals 0:
        send 1 to completed
        return 1
    set journal to sql_open(archive_list_text(config and 2))
    set database to sql_open(archive_list_text(config and 3))
    set status to 0
    if journal equals 0 or else database equals 0:
        set status to 1
    else:
        if sql_execute(journal and "PRAGMA busy_timeout=5000;") is not equal to 0 or else sql_execute(database and "PRAGMA busy_timeout=5000; PRAGMA query_only=ON;") is not equal to 0:
            set status to 1
    set waits to create_list()
    set added to append_list(waits and requests)
    set last_serial to 0
    set stopping to 0
    repeat while status equals 0 and also stopping equals 0:
        if file_exists(archive_list_text(config and 9)):
            set stopping to 1
        else:
            if select(waits and 100) >= 0:
                set serial to receive from requests
                if serial equals 0:
                    set stopping to 1
                else:
                    set result to history_status("stale-voice-proof-request")
                    if serial > last_serial and also serial <= 9007199254740991:
                        set last_serial to serial
                        if length_list(config) equals 12:
                            set claim to get_list(config and 11)
                            if archive_list_text(claim and 0) equals "recording":
                                set result to discord_voice_recording_proof(archive_list_text(config and 0) and archive_list_text(config and 1) and journal and database and archive_list_text(claim and 1) and archive_list_text(config and 5) and get_list(config and 6) and get_list(config and 7) and archive_list_text(config and 8) and archive_list_text(config and 9))
                                if archive_list_text(result and 0) equals "recording-proof" and also not (archive_list_text(result and 2) equals archive_list_text(config and 4)):
                                    set result to history_status("recording-observer-intent-denied")
                            else:
                                set result to discord_voice_audio_proof(archive_list_text(config and 0) and archive_list_text(config and 1) and journal and database and archive_list_text(config and 4) and claim and archive_list_text(config and 5) and get_list(config and 6) and get_list(config and 7) and archive_list_text(config and 8) and archive_list_text(config and 9))
                        else:
                            set result to discord_voice_request_proof(archive_list_text(config and 0) and archive_list_text(config and 1) and journal and database and archive_list_text(config and 4) and archive_list_text(config and 5) and get_list(config and 6) and get_list(config and 7) and archive_list_text(config and 8) and archive_list_text(config and 9) and get_list(config and 10))
                    set reply to create_list()
                    set added to append_list(reply and serial)
                    set added to append_list(reply and result)
                    send reply to replies
    if journal is not equal to 0:
        set closed to sql_close(journal)
    if database is not equal to 0:
        set closed to sql_close(database)
    send status to completed
    return status

# Create one observer and its worker-owned bounded handoff. Caller polls the
# mailbox and never blocks waiting for a REST result in the voice timing loop.
define discord_voice_permission_start with config as List returning List:
    if discord_voice_permission_config_valid(config) equals 0:
        return 0
    set requests to channel
    set replies to channel
    set completed to channel
    set mailbox to discord_voice_permission_mailbox_new(requests and replies and completed)
    spawn discord_voice_permission_observer(config and requests and replies and completed)
    return mailbox
