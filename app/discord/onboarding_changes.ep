import "automod_metadata"

# Explicit null remains a request; omitted fields remain absent from the PUT.
define discord_onboarding_nullable with fields as List and field as Int and kind as Str returning Int:
    if field < 0 or else provider_kind(fields and field) equals "null":
        return 1
    if kind equals "boolean":
        return provider_kind(fields and field) equals "true" or else provider_kind(fields and field) equals "false"
    if kind equals "snowflake":
        return provider_kind(fields and field) equals "string" and also discord_snowflake(provider_value(fields and field)) equals 1
    return 0

define discord_onboarding_text with fields as List and field as Int and minimum as Int and maximum as Int and optional as Int returning Int:
    if optional equals 1 and also (field < 0 or else provider_kind(fields and field) equals "null"):
        return 1
    if not (provider_kind(fields and field) equals "string"):
        return 0
    set size to discord_rich_units(provider_value(fields and field))
    return size >= minimum and also size <= maximum

define discord_onboarding_option with fields as List and object as Int returning Int:
    if discord_rich_keys(fields and object and "|id|title|description|emoji_id|emoji_name|emoji_animated|role_ids|channel_ids|") equals 0:
        return 0
    if discord_onboarding_text(fields and provider_member(fields and object and "title") and 1 and 50 and 0) equals 0 or else discord_onboarding_text(fields and provider_member(fields and object and "description") and 0 and 100 and 1) equals 0 or else discord_onboarding_text(fields and provider_member(fields and object and "emoji_name") and 0 and 100 and 1) equals 0:
        return 0
    if discord_onboarding_nullable(fields and provider_member(fields and object and "id") and "snowflake") equals 0 or else discord_onboarding_nullable(fields and provider_member(fields and object and "emoji_id") and "snowflake") equals 0 or else discord_onboarding_nullable(fields and provider_member(fields and object and "emoji_animated") and "boolean") equals 0:
        return 0
    return discord_automod_ids(fields and provider_member(fields and object and "role_ids") and 50) equals 1 and also discord_automod_ids(fields and provider_member(fields and object and "channel_ids") and 50) equals 1

define discord_onboarding_prompt with fields as List and object as Int returning Int:
    if discord_rich_keys(fields and object and "|id|title|options|single_select|required|in_onboarding|type|") equals 0:
        return 0
    set identity to provider_member(fields and object and "id")
    if not (provider_kind(fields and identity) equals "string") or else discord_snowflake(provider_value(fields and identity)) equals 0 or else discord_onboarding_text(fields and provider_member(fields and object and "title") and 1 and 100 and 0) equals 0:
        return 0
    set keys to create_list()
    set keys to ["single_select","required","in_onboarding"]
    for each item in keys:
        if discord_onboarding_nullable(fields and provider_member(fields and object and ptr_to_str(item)) and "boolean") equals 0:
            return 0
    set kind to provider_member(fields and object and "type")
    if kind >= 0 and also not (provider_kind(fields and kind) equals "null") and also discord_rich_integer(fields and kind and 0 and 1) equals 0:
        return 0
    set options to provider_member(fields and object and "options")
    if not (provider_kind(fields and options) equals "["):
        return 0
    set index to options + 1
    set count to 0
    set seen to create_list()
    repeat while not (provider_kind(fields and index) equals "]"):
        if discord_onboarding_option(fields and index) equals 0:
            return 0
        set field to provider_member(fields and index and "id")
        if field >= 0 and also not (provider_kind(fields and field) equals "null"):
            set identity to provider_value(fields and field)
            if discord_contains(seen and identity) equals 1:
                return 0
            set added to append_list(seen and identity)
        set count to count + 1
        if count > 50:
            return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return count > 0

define discord_onboarding_changes with changes as Str returning Int:
    set fields to provider_json_tokens(changes)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|prompts|enabled|default_channel_ids|mode|") equals 0 or else provider_kind(fields and 1) equals "}":
        return 0
    if discord_onboarding_nullable(fields and provider_member(fields and 0 and "enabled") and "boolean") equals 0 or else discord_automod_ids(fields and provider_member(fields and 0 and "default_channel_ids") and 500) equals 0:
        return 0
    set mode to provider_member(fields and 0 and "mode")
    if mode >= 0 and also not (provider_kind(fields and mode) equals "null") and also discord_rich_integer(fields and mode and 0 and 1) equals 0:
        return 0
    set prompts to provider_member(fields and 0 and "prompts")
    if prompts < 0 or else provider_kind(fields and prompts) equals "null":
        return 1
    if not (provider_kind(fields and prompts) equals "["):
        return 0
    set index to prompts + 1
    set count to 0
    set seen to create_list()
    repeat while not (provider_kind(fields and index) equals "]"):
        if discord_onboarding_prompt(fields and index) equals 0:
            return 0
        set identity to provider_value(fields and provider_member(fields and index and "id"))
        if discord_contains(seen and identity) equals 1:
            return 0
        set added to append_list(seen and identity)
        set count to count + 1
        if count > 15:
            return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return 1
