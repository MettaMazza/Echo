import "automod_metadata"

# Validate a merged candidate, but send only the caller's explicit patch. Omitted
# fields retain their observed values; explicit JSON null remains an explicit
# request. Read-only response fields are never copied into a mutation body.
define discord_automod_effective with changes as Str and previous as Str and creating as Int returning List:
    set fields to provider_json_tokens(changes)
    set old to provider_json_tokens(previous)
    if fields equals 0 or else old equals 0 or else provider_unique_objects(fields) equals 0 or else provider_unique_objects(old) equals 0 or else not (provider_kind(old and 0) equals "{") or else (creating is not equal to 0 and also creating is not equal to 1):
        return history_status("invalid-automod-fields")
    if discord_rich_keys(fields and 0 and "|name|event_type|trigger_type|trigger_metadata|actions|enabled|exempt_roles|exempt_channels|") equals 0 or else provider_kind(fields and 1) equals "}":
        return history_status("invalid-or-empty-automod-fields")
    set keys to create_list()
    set keys to ["name","event_type","trigger_type","trigger_metadata","actions","enabled","exempt_roles","exempt_channels"]
    set candidate to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        set value to ""
        if field >= 0:
            set value to agent_json_source(changes and fields and field)
        else if creating equals 0:
            set prior to provider_member(old and 0 and key)
            if prior >= 0:
                set value to agent_json_source(previous and old and prior)
        if string_length(value) > 0:
            if count > 0:
                set candidate to concat(candidate and ",")
            set candidate to concat(candidate and concat(provider_quote(key) and concat(":" and value)))
            set count to count + 1
    set candidate to concat(candidate and "}")
    set merged to provider_json_tokens(candidate)
    set name to provider_member(merged and 0 and "name")
    set units to discord_rich_units(provider_value(merged and name))
    if not (provider_kind(merged and name) equals "string") or else units < 0 or else units > 100:
        return history_status("invalid-automod-name")
    if discord_rich_integer(merged and provider_member(merged and 0 and "event_type") and 1 and 2) equals 0:
        return history_status("invalid-automod-event-type")
    set trigger_field to provider_member(merged and 0 and "trigger_type")
    set trigger to provider_value(merged and trigger_field)
    if not (provider_kind(merged and trigger_field) equals "number") or else not (trigger equals "1" or else trigger equals "3" or else trigger equals "4" or else trigger equals "5" or else trigger equals "6"):
        return history_status("invalid-automod-trigger-type")
    if discord_automod_metadata(merged and provider_member(merged and 0 and "trigger_metadata") and trigger) equals 0:
        return history_status("invalid-automod-trigger-metadata")
    if discord_automod_actions(merged and provider_member(merged and 0 and "actions")) equals 0:
        return history_status("invalid-automod-actions")
    set enabled to provider_member(merged and 0 and "enabled")
    if enabled >= 0 and also not (provider_kind(merged and enabled) equals "true" or else provider_kind(merged and enabled) equals "false" or else provider_kind(merged and enabled) equals "null"):
        return history_status("invalid-automod-enabled")
    if discord_automod_ids(merged and provider_member(merged and 0 and "exempt_roles") and 20) equals 0 or else discord_automod_ids(merged and provider_member(merged and 0 and "exempt_channels") and 50) equals 0:
        return history_status("invalid-automod-exemptions")
    return ["valid",candidate]
