import "revision_target"
import "command_sender"

# Called after current Discord access, public anchor and queue reservation.
# The same interaction resumes the same branch/run after an interrupted write.
define discord_revision_admit with journal as Int and database as Int and identity as Str and bot as Str and guilds as List and admins as List returning List:
    set archive_binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    if not (archive_list_text(archive_binding and 1) equals bot):
        return history_status("archive-binding-denied")
    set anchor to discord_command_anchor_read(journal and identity)
    if not (archive_list_text(anchor and 0) equals "found"):
        return anchor
    set original to archive_list_text(anchor and 6)
    if discord_command_acknowledged(journal and identity and original) equals 0:
        return history_status("command-not-acknowledged")
    set command to discord_command_resolve(journal and original and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access"):
        return command
    set mode to archive_list_text(command and 1)
    if not (mode equals "edit" or else mode equals "regenerate") or else not (archive_list_text(anchor and 7) equals bot):
        return history_status("command-binding-denied")
    set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
    if string_length(device) equals 0:
        return history_status("principal-unavailable")
    set options to provider_json_tokens(archive_list_text(command and 5))
    set target to provider_value(options and provider_member(options and 0 and "message"))
    set replacement to provider_value(options and provider_member(options and 0 and "text"))
    set source to discord_revision_target(journal and database and device and target and archive_list_text(command and 4) and archive_list_text(command and 3))
    if not (archive_list_text(source and 0) equals "found"):
        return source
    set run to concat("discord-command:" and identity)
    set submitted to group_revision_submit_run(database and device and run and run and archive_list_text(source and 1) and archive_list_text(source and 2) and "discord" and archive_list_text(command and 4) and archive_list_text(command and 3) and mode and replacement and "")
    if not (archive_list_text(submitted and 0) equals "accepted" or else archive_list_text(submitted and 0) equals "already-accepted"):
        return submitted
    if discord_command_sender_record(database and run and original) is not equal to 0:
        return history_status("sender-record-unavailable")
    set receipt to concat(run and ":discord-command")
    set payload to concat("{\"interaction\":" and concat(provider_quote(identity) and concat(",\"intake_sha256\":" and concat(provider_quote(ep_sha256(original)) and concat(",\"anchor_message\":" and concat(provider_quote(archive_list_text(anchor and 4)) and "}"))))))
    set prior to archive_read_event(database and receipt)
    if prior is not equal to 0:
        if not (archive_list_text(prior and 0) equals archive_list_text(submitted and 1)) or else not (archive_list_text(prior and 2) equals "discord_command_origin") or else not (archive_list_text(prior and 3) equals payload):
            return history_status("command-origin-conflict")
    else if archive_append(database and archive_list_text(submitted and 1) and receipt and "discord_command_origin" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return history_status("command-origin-write-failed")
    return submitted
