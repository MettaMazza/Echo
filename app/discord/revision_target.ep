import "final_binding"
import "job_origin"
import "../security/group_branches"

# Resolve only a retained admitted human message or its confirmed delivered
# answer in this channel. The ID grants no authority. This read is followed by
# group_revision_submit's transactional speaker, audience and boundary checks.
define discord_revision_target with journal as Int and database as Int and device as Str and message as Str and guild as Str and room as Str returning List:
    if discord_snowflake(message) equals 0:
        return history_status("revision-source-unavailable")
    set run to concat("discord-message:" and message)
    set delivered to discord_final_lookup(journal and message and room)
    if archive_list_text(delivered and 0) equals "found":
        set run to archive_list_text(delivered and 1)
    set inbox to discord_job_source(journal and database and run)
    if string_length(inbox) equals 0:
        return history_status("revision-source-unavailable")
    set keys to [run,device]
    set source to history_collect_one(checkpoint_prepare(database and "SELECT r.session,r.objective_event FROM echo_runs r JOIN echo_group_run_origins o ON o.run=r.run AND o.session=r.session WHERE r.run=?1 AND o.device=?2 AND r.state IN ('completed','failed','cancelled') AND NOT EXISTS(SELECT 1 FROM echo_tool_calls t WHERE t.run=r.run AND t.state<>'observed');" and keys))
    if not (archive_list_text(source and 0) equals "found"):
        return history_status("revision-source-not-authorized")
    if group_session_allows(database and device and archive_list_text(source and 1) and "discord" and guild and room and 1) equals 0:
        return history_status("audience-not-authorized")
    set result to history_status("found")
    set added to append_list(result and archive_list_text(source and 1))
    set added to append_list(result and archive_list_text(source and 2))
    set added to append_list(result and run)
    return result
