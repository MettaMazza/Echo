import "member_tool"
import "expression_access"
import "expression_options"
import "expression_upload"

# A collection response is projected one resource at a time; creator profiles
# never become model context. The REST route already binds emoji to its guild.
define discord_expression_collection with body as Str and kind as Str and guild as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "["):
        return ""
    set result to "["
    set count to 0
    set item to 1
    repeat while not (provider_kind(fields and item) equals "]"):
        set raw to agent_json_source(body and fields and item)
        set view to discord_expression_view(raw and kind and guild and "")
        if string_length(view) equals 0:
            return ""
        if count > 0:
            set result to concat(result and ",")
        set result to concat(result and view)
        set count to count + 1
        set item to provider_after(fields and item)
        if item < 0:
            return ""
        if provider_kind(fields and item) equals ",":
            set item to item + 1
    return concat(result and "]")

define discord_expression_bundle_allowed with bundle as List and kind as Str and body as Str and guild as Str and actor as Str and bot as Str and resource as Str and operation as Str returning Int:
    if not (archive_list_text(bundle and 0) equals "observed") or else discord_member_bundle_valid(bundle and guild and actor and bot and actor and 0) equals 0:
        return 0
    return discord_expression_authority(archive_list_text(bundle and 1) and archive_list_text(bundle and 2) and archive_list_text(bundle and 3) and archive_list_text(bundle and 4) and kind and body and guild and actor and bot and resource and operation)

# Called while the upload owner retains its frozen buffer; every return is
# followed by release in the caller. No HTTP library can reopen a pathname.
define discord_expression_commit with library as Str and token as Str and journal as Int and database as Int and run as Str and call_id as Str and source as List and options as List and uploaded as List and observed_body as Str and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    set actor to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set kind to archive_list_text(options and 1)
    set operation to archive_list_text(options and 2)
    set resource to archive_list_text(options and 3)
    set access to discord_access_check_bit(library and token and journal and directory_path and bot and guild and room and actor and admins and 10)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_access_failure_result(access and "final expression channel access")
    set bundle to discord_member_bundle(library and token and journal and directory_path and guild and actor and bot and actor and 0)
    if discord_expression_bundle_allowed(bundle and kind and observed_body and guild and actor and bot and resource and operation) equals 0:
        return discord_pin_result("expression-permission-or-resource-denied" and "none; requester and bot permissions are independent" and "")
    if discord_expression_roles_current(archive_list_text(options and 6) and archive_list_text(bundle and 2)) equals 0:
        return discord_pin_result("expression-role-no-longer-present" and "none" and "")
    if operation equals "create":
        set file to discord_post_file_source(database and run and actor and archive_list_text(options and 7))
        set frozen_digest to archive_list_text(uploaded and 2)
        if archive_list_text(uploaded and 0) equals "multipart-ready":
            set frozen_digest to archive_list_text(uploaded and 5)
        if not (archive_list_text(file and 0) equals "found") or else not (archive_list_text(file and 4) equals frozen_digest):
            return discord_pin_result("expression-attachment-no-longer-eligible" and "none" and "")
    set inbox to discord_job_origin(journal and database and run)
    set current to discord_run_source_check(library and token and journal and directory_path and inbox and source)
    set cancellations to [run]
    set cancelled to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_cancel_requests WHERE run=?;" and cancellations))
    if not (current equals "current") or else not (archive_list_text(cancelled and 0) equals "end") or else file_exists(stop_file) or else discord_pin_admin(database and run and call_id) equals 0 or else tool_policy_allows(database and run and call_id and "discord_expressions") equals 0 or else discord_run_barrier(journal and inbox and http_decimal(archive_list_text(source and 7)) and archive_list_text(source and 6) and room and guild) is not equal to 0:
        return discord_pin_result("expression-authority-source-changed-or-cancelled" and "none" and "")
    set route to discord_expression_route(kind and guild and resource)
    set method to "PATCH"
    set payload to archive_list_text(options and 6)
    set media to "application/json"
    if operation equals "delete":
        set method to "DELETE"
        set payload to ""
    else if operation equals "create":
        set method to "POST"
        if archive_list_text(uploaded and 0) equals "json-ready":
            set payload to archive_list_text(uploaded and 1)
    set pointer to str_to_ptr(payload)
    set size to string_length(payload)
    set fingerprint to ep_sha256(payload)
    if operation equals "create" and also archive_list_text(uploaded and 0) equals "multipart-ready":
        set pointer to get_list(uploaded and 1)
        set size to get_list(uploaded and 2)
        set media to archive_list_text(uploaded and 3)
        set fingerprint to ep_sha256(concat(payload and archive_list_text(uploaded and 5)))
    set claim to discord_community_claim(journal and run and call_id and concat(method and concat(route and fingerprint)))
    if not (claim equals "claimed"):
        return discord_pin_result(claim and "inspect original receipt and resource; no automatic replay" and "")
    set changed to discord_access_bytes_audit(library and token and journal and directory_path and method and route and concat(method and ":guild-expression") and guild and pointer and size and media and archive_list_text(options and 4))
    if not (archive_list_text(changed and 0) equals "observed"):
        return discord_pin_result(concat("expression-change-unconfirmed:" and archive_list_text(changed and 0)) and "inspect retained receipt and resource; never automatically repeat creation or mutation" and archive_list_text(changed and 1))
    if operation equals "delete":
        return concat("{\"status\":\"applied\",\"deleted\":" and concat(provider_quote(resource) and concat(",\"receipt\":" and concat(provider_quote(archive_list_text(changed and 3)) and "}"))))
    set view to discord_expression_view(archive_list_text(changed and 1) and kind and guild and resource)
    if string_length(view) equals 0:
        return discord_pin_result("expression-response-unconfirmed" and "inspect retained receipt; no automatic replay" and archive_list_text(changed and 3))
    return concat("{\"status\":\"applied\",\"source\":\"Discord REST; untrusted expression metadata\",\"data\":" and concat(view and concat(",\"receipt\":" and concat(provider_quote(archive_list_text(changed and 3)) and "}"))))

define discord_expressions_perform with library as Str and token as Str and journal as Int and database as Int and run as Str and call_id as Str and source as List and options as List and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    set actor to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set kind to archive_list_text(options and 1)
    set operation to archive_list_text(options and 2)
    set resource to archive_list_text(options and 3)
    if discord_pin_admin(database and run and call_id) equals 0 or else discord_contains(admins and actor) equals 0:
        return "{\"status\":\"admin-required\",\"cause\":\"requester-role-required\",\"restriction_scope\":\"requester\",\"required_role\":\"admin\",\"system_failure\":false,\"effects\":\"none\"}"
    if discord_contains(guilds and guild) equals 0 or else file_exists(stop_file) or else tool_policy_allows(database and run and call_id and "discord_expressions") equals 0:
        return discord_pin_result("discord-origin-denied-or-stopped" and "none" and "")
    set access to discord_access_check_bit(library and token and journal and directory_path and bot and guild and room and actor and admins and 10)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_access_failure_result(access and "expression source-channel access")
    set bundle to discord_member_bundle(library and token and journal and directory_path and guild and actor and bot and actor and 0)
    if discord_expression_bundle_allowed(bundle and kind and "{}" and guild and actor and bot and "" and "list") equals 0:
        return discord_pin_result("expression-membership-denied" and "none" and "")
    set route to discord_expression_route(kind and guild and resource)
    set body to "{}"
    set view to ""
    if not (operation equals "create"):
        set observed to discord_access_get(library and token and journal and directory_path and route and "GET:guild-expression" and guild)
        if not (archive_list_text(observed and 0) equals "observed"):
            return discord_access_failure_result(observed and "expression inspection")
        set body to archive_list_text(observed and 1)
        if operation equals "list":
            set view to discord_expression_collection(body and kind and guild)
        else:
            set view to discord_expression_view(body and kind and guild and resource)
        if string_length(view) equals 0:
            return discord_pin_result("expression-resource-binding-invalid" and "none" and "")
        if (operation equals "edit" or else operation equals "delete") and also not (ep_sha256(body) equals archive_list_text(options and 5)):
            return discord_pin_result("expression-state-changed" and "none; inspect again" and "")
    if discord_expression_bundle_allowed(bundle and kind and body and guild and actor and bot and resource and operation) equals 0:
        return discord_pin_result("expression-permission-or-resource-denied" and "none; requester and bot permissions are independent" and "")
    if operation equals "list" or else operation equals "inspect":
        set inbox to discord_job_origin(journal and database and run)
        set current to discord_run_source_check(library and token and journal and directory_path and inbox and source)
        if not (current equals "current") or else file_exists(stop_file) or else tool_policy_allows(database and run and call_id and "discord_expressions") equals 0 or else discord_run_barrier(journal and inbox and http_decimal(archive_list_text(source and 7)) and archive_list_text(source and 6) and room and guild) is not equal to 0 or else discord_pin_admin(database and run and call_id) equals 0:
            return discord_pin_result("expression-read-authority-changed" and "none" and "")
        return concat("{\"status\":\"observed\",\"source\":\"Discord REST; untrusted expression metadata\",\"observed_sha256\":" and concat(provider_quote(ep_sha256(body)) and concat(",\"data\":" and concat(view and "}"))))
    set uploaded to history_status("not-needed")
    if operation equals "create":
        set uploaded to discord_expression_upload(database and run and actor and kind and archive_list_text(options and 7) and archive_list_text(options and 6) and archive_list_text(bundle and 1))
        if not (archive_list_text(uploaded and 0) equals "json-ready" or else archive_list_text(uploaded and 0) equals "multipart-ready"):
            return discord_pin_result(archive_list_text(uploaded and 0) and "none; original attachment retained" and "")
    set result to discord_expression_commit(library and token and journal and database and run and call_id and source and options and uploaded and body and bot and admins and directory_path and stop_file)
    set released to discord_audio_multipart_release(uploaded)
    return result

define discord_expressions_execute with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    set options to discord_expression_options(arguments)
    if not (archive_list_text(options and 0) equals "valid"):
        return discord_pin_result(archive_list_text(options and 0) and "none" and "")
    if tool_policy_allows(database and run and call_id and "discord_expressions") equals 0:
        return discord_pin_result("not-authorized" and "none" and "")
    if not ((get_argument_count() equals 15 and also get_argument(13) equals "--turn") or else (get_argument_count() equals 16 and also get_argument(13) equals "--job")):
        return discord_pin_result("discord-runtime-unavailable" and "none" and "")
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    set location to history_collect_one(archive_prepare(database and "SELECT file FROM pragma_database_list WHERE name='main';"))
    if not (archive_list_text(binding and 0) equals "found") or else not (archive_list_text(binding and 1) equals get_argument(7)) or else not (archive_list_text(location and 1) equals get_argument(4)):
        return discord_pin_result("discord-binding-denied" and "none" and "")
    set journal to discord_store_open(get_argument(3) and get_argument(7))
    if journal equals 0:
        return discord_pin_result("discord-journal-unavailable" and "none" and "")
    set source to discord_run_source(journal and database and run)
    if not (archive_list_text(source and 0) equals "found"):
        set closed to sql_close(journal)
        return discord_pin_result("discord-origin-denied" and "none" and "")
    set credential to read_file(get_argument(2))
    if credential equals 0:
        set closed to sql_close(journal)
        return discord_pin_result("discord-credential-unavailable" and "none" and "")
    set guilds to create_list()
    set split_count to retained_text_split(guilds and get_argument(8) and ",")
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(9) and ",")
    set result to discord_expressions_perform(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and database and run and call_id and source and options and get_argument(7) and guilds and admins and get_argument(5) and get_argument(6))
    set closed to sql_close(journal)
    return result
