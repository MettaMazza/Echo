import "receipt_spool"
import "../retained_text"
import "gateway_connection"
import "gateway_discovery"
import "rest"
import "../archive/runtime_lock"

external define ep_uuid_v4

# Persistent retry deadlines survive a process restart. Clock movement may
# delay recovery, but must not silently bypass a server retry deadline.
define discord_owner_schema with database as Int returning Int:
    if discord_gateway_runtime_schema(database) is not equal to 0 or else discord_gateway_budget_schema(database) is not equal to 0:
        return 1
    return sql_execute(database and "CREATE TABLE IF NOT EXISTS discord_gateway_owner(singleton INTEGER PRIMARY KEY CHECK(singleton=1),retry_at INTEGER NOT NULL,cause TEXT NOT NULL);")

define discord_owner_retry with database as Int and deadline as Int and cause as Str returning Int:
    set retained_values_1 to create_list()
    set retained_value_added to append_list(retained_values_1 and int_to_string(deadline))
    set retained_value_added to append_list(retained_values_1 and cause)
    return archive_finish(checkpoint_prepare(database and "INSERT INTO discord_gateway_owner(singleton,retry_at,cause) VALUES(1,CAST(? AS INTEGER),?) ON CONFLICT(singleton) DO UPDATE SET retry_at=excluded.retry_at,cause=excluded.cause;" and retained_values_1) and 101)

define discord_owner_wait with system as Int and stop_path as Str and deadline as Int returning Int:
    repeat while ep_time_now_ms() < deadline:
        if file_exists(stop_path):
            return 1
        set waited to ep_dlcall1(ep_dlsym(system and "usleep") and 100000)
    return file_exists(stop_path)

# Discord's JSON retry_after is seconds and may contain a decimal fraction.
# Round upward, never retry early. Invalid values require operator attention.
define discord_retry_seconds with value as Str returning Int:
    set parts to create_list()
    set split_count to retained_text_split(parts and value and ".")
    if length_list(parts) < 1 or else length_list(parts) > 2:
        return -1
    set whole to archive_list_text(parts and 0)
    if string_length(whole) equals 0 or else string_length(whole) > 9:
        return -1
    for each part in parts:
        set text to ptr_to_str(part)
        if string_length(text) equals 0:
            return -1
        set index to 0
        repeat while index < string_length(text):
            if provider_digit(text and index) equals 0:
                return -1
            set index to index + 1
    return string_to_int(whole) + 1

# Responses remain in an explicitly private host directory. The generated
# filenames contain no credential, user message or model-controlled path.
define discord_owner_discover with library_path as Str and token as Str and directory_path as Str returning List:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and directory_path)
    if directory < 0:
        set closed to ep_dlclose(system)
        set rooted_literal_1 to create_list()
        set retained_value_added to append_list(rooted_literal_1 and "fatal")
        set retained_value_added to append_list(rooted_literal_1 and "discovery-directory-unavailable")
        return rooted_literal_1
    set identity to ptr_to_str(ep_uuid_v4())
    set receipt_name to discord_receipt_name(system and directory and identity)
    set filename to concat(receipt_name and ".json")
    set output to -1
    if string_length(receipt_name) > 0:
        set output to workspace_file_open(system and directory and filename and 1)
    set headers to workspace_file_open(system and directory and concat(receipt_name and ".headers") and 1)
    if output < 0 or else headers < 0:
        if output >= 0:
            set closed to net_close(output)
        if headers >= 0:
            set closed to net_close(headers)
        set closed to net_close(directory)
        set closed to ep_dlclose(system)
        set rooted_literal_2 to create_list()
        set retained_value_added to append_list(rooted_literal_2 and "fatal")
        set retained_value_added to append_list(rooted_literal_2 and "discovery-files-unavailable")
        return rooted_literal_2
    set result to discord_rest_transfer(library_path and token and "GET" and "/gateway/bot" and "" and output and headers)
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    if not (archive_list_text(result and 0) equals "complete"):
        set rooted_literal_3 to create_list()
        set retained_value_added to append_list(rooted_literal_3 and "retry")
        set retained_value_added to append_list(rooted_literal_3 and "discovery-transfer-failed")
        set retained_value_added to append_list(rooted_literal_3 and "60000")
        return rooted_literal_3
    set status to archive_list_text(result and 1)
    if status equals "401" or else status equals "403":
        set rooted_literal_4 to create_list()
        set retained_value_added to append_list(rooted_literal_4 and "fatal")
        set retained_value_added to append_list(rooted_literal_4 and "discovery-authentication-denied")
        return rooted_literal_4
    set response to read_file(concat(directory_path and concat("/" and filename)))
    if response equals 0:
        set rooted_literal_5 to create_list()
        set retained_value_added to append_list(rooted_literal_5 and "fatal")
        set retained_value_added to append_list(rooted_literal_5 and "discovery-response-unavailable")
        return rooted_literal_5
    if status equals "429":
        set tokens to provider_json_tokens(ptr_to_str(response))
        if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
            set rooted_literal_6 to create_list()
            set retained_value_added to append_list(rooted_literal_6 and "fatal")
            set retained_value_added to append_list(rooted_literal_6 and "invalid-discovery-rate-limit")
            return rooted_literal_6
        set seconds to discord_retry_seconds(provider_value(tokens and provider_member(tokens and 0 and "retry_after")))
        if seconds < 0:
            set rooted_literal_7 to create_list()
            set retained_value_added to append_list(rooted_literal_7 and "fatal")
            set retained_value_added to append_list(rooted_literal_7 and "invalid-discovery-rate-limit")
            return rooted_literal_7
        set retained_values_2 to create_list()
        set retained_value_added to append_list(retained_values_2 and "retry")
        set retained_value_added to append_list(retained_values_2 and "discovery-rate-limited")
        set retained_value_added to append_list(retained_values_2 and int_to_string(seconds * 1000))
        return retained_values_2
    if not (status equals "200"):
        set retained_values_3 to create_list()
        set retained_value_added to append_list(retained_values_3 and "retry")
        set retained_value_added to append_list(retained_values_3 and concat("discovery-http-" and status))
        set retained_value_added to append_list(retained_values_3 and "60000")
        return retained_values_3
    set discovery to discord_gateway_discovery(ptr_to_str(response) and ep_time_now_ms())
    if not (archive_list_text(discovery and 0) equals "discovered"):
        set rooted_literal_8 to create_list()
        set retained_value_added to append_list(rooted_literal_8 and "fatal")
        set retained_value_added to append_list(rooted_literal_8 and "invalid-discovery")
        return rooted_literal_8
    return discovery

# This owns only the Gateway journal. The model and delivery workers are
# separate processes, so slow inference cannot starve heartbeats.
# Caller retains the host credential and trusted scope configuration.
define discord_gateway_owner with library_path as Str and token as Str and database as Int and bot as Str and guilds as List and admins as List and directory_path as Str and stop_path as Str returning List:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to archive_runtime_lock(database and system)
    if lock < 0:
        set closed to ep_dlclose(system)
        set rooted_literal_9 to create_list()
        set retained_value_added to append_list(rooted_literal_9 and "fatal")
        set retained_value_added to append_list(rooted_literal_9 and "owner-already-running-or-lock-unavailable")
        return rooted_literal_9
    set rooted_literal_10 to create_list()
    set retained_value_added to append_list(rooted_literal_10 and "fatal")
    set retained_value_added to append_list(rooted_literal_10 and "owner-schema-failed")
    set outcome to rooted_literal_10
    if discord_owner_schema(database) is not equal to 0:
        set closed to net_close(lock)
        set closed to ep_dlclose(system)
        return outcome
    set backoff to 1000
    set gateway to "wss://gateway.discord.gg"
    repeat while 1 equals 1:
        set retry to history_collect_one(archive_prepare(database and "SELECT retry_at FROM discord_gateway_owner WHERE singleton=1;"))
        if not (archive_list_text(retry and 0) equals "found" or else archive_list_text(retry and 0) equals "end"):
            set rooted_literal_11 to create_list()
            set retained_value_added to append_list(rooted_literal_11 and "fatal")
            set retained_value_added to append_list(rooted_literal_11 and "retry-state-unavailable")
            set outcome to rooted_literal_11
            break
        if discord_owner_wait(system and stop_path and string_to_int(archive_list_text(retry and 1))) equals 1:
            set rooted_literal_12 to create_list()
            set retained_value_added to append_list(rooted_literal_12 and "stopped")
            set retained_value_added to append_list(rooted_literal_12 and "host-stop-request")
            set outcome to rooted_literal_12
            break
        set resume to discord_gateway_resume_read(database)
        if not (archive_list_text(resume and 0) equals "found"):
            if not (archive_list_text(resume and 0) equals "end"):
                set rooted_literal_13 to create_list()
                set retained_value_added to append_list(rooted_literal_13 and "fatal")
                set retained_value_added to append_list(rooted_literal_13 and "resume-state-unavailable")
                set outcome to rooted_literal_13
                break
            set discovery to discord_owner_discover(library_path and token and directory_path)
            if archive_list_text(discovery and 0) equals "fatal":
                set outcome to discovery
                break
            if archive_list_text(discovery and 0) equals "retry":
                if discord_owner_retry(database and ep_time_now_ms() + string_to_int(archive_list_text(discovery and 2)) and archive_list_text(discovery and 1)) is not equal to 0:
                    set rooted_literal_14 to create_list()
                    set retained_value_added to append_list(rooted_literal_14 and "fatal")
                    set retained_value_added to append_list(rooted_literal_14 and "retry-write-failed")
                    set outcome to rooted_literal_14
                    break
                continue
            set gateway to archive_list_text(discovery and 1)
            if discord_gateway_budget_record(database and discovery and ep_time_now_ms()) is not equal to 0:
                set rooted_literal_15 to create_list()
                set retained_value_added to append_list(rooted_literal_15 and "fatal")
                set retained_value_added to append_list(rooted_literal_15 and "discovery-budget-write-failed")
                set outcome to rooted_literal_15
                break
            set reserved to discord_gateway_identify_reserve(database and ep_time_now_ms())
            if not (reserved equals "reserved"):
                set budget to history_collect_one(archive_prepare(database and "SELECT reset_at,next_at FROM discord_identify_budget WHERE singleton=1;"))
                set deadline to string_to_int(archive_list_text(budget and 1))
                if reserved equals "identify-rate-limited":
                    set deadline to string_to_int(archive_list_text(budget and 2))
                else if not (reserved equals "budget-exhausted" or else reserved equals "discovery-expired"):
                    set rooted_literal_16 to create_list()
                    set retained_value_added to append_list(rooted_literal_16 and "fatal")
                    set retained_value_added to append_list(rooted_literal_16 and reserved)
                    set outcome to rooted_literal_16
                    break
                # A zero reset carries no future deadline. Back off before
                # fresh discovery rather than spinning on an exhausted budget.
                if deadline <= ep_time_now_ms():
                    set deadline to ep_time_now_ms() + 5000
                if not (archive_list_text(budget and 0) equals "found") or else discord_owner_retry(database and deadline and reserved) is not equal to 0:
                    set rooted_literal_17 to create_list()
                    set retained_value_added to append_list(rooted_literal_17 and "fatal")
                    set retained_value_added to append_list(rooted_literal_17 and "budget-retry-write-failed")
                    set outcome to rooted_literal_17
                    break
                continue
        set generation to ptr_to_str(ep_uuid_v4())
        set outcome to discord_gateway_connection(library_path and token and database and bot and guilds and admins and generation and gateway and stop_path)
        set action to archive_list_text(outcome and 0)
        if action equals "stopped" or else action equals "fatal":
            break
        if action equals "identify":
            if sql_execute(database and "UPDATE discord_resume SET enabled=0 WHERE singleton=1;") is not equal to 0:
                set rooted_literal_18 to create_list()
                set retained_value_added to append_list(rooted_literal_18 and "fatal")
                set retained_value_added to append_list(rooted_literal_18 and "session-invalidation-write-failed")
                set outcome to rooted_literal_18
                break
        set health to history_collect_one(archive_prepare(database and "SELECT ack_count FROM discord_gateway_health WHERE singleton=1;"))
        if string_to_int(archive_list_text(health and 1)) >= 2:
            set backoff to 1000
        set delay to backoff + ep_dlcall1(ep_dlsym(system and "arc4random_uniform") and 4000)
        if discord_owner_retry(database and ep_time_now_ms() + delay and archive_list_text(outcome and 1)) is not equal to 0:
            set rooted_literal_19 to create_list()
            set retained_value_added to append_list(rooted_literal_19 and "fatal")
            set retained_value_added to append_list(rooted_literal_19 and "retry-write-failed")
            set outcome to rooted_literal_19
            break
        set backoff to backoff * 2
        if backoff > 60000:
            set backoff to 60000
    set closed to net_close(lock)
    set closed to ep_dlclose(system)
    return outcome
