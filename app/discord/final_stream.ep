import "agent_output"

# This is a delivery cursor, not a model/history cursor. It advances only
# after all chunks of an immutable accepted final are durably enqueued.
# Crashes between enqueue and cursor commit replay the same outbox identities.
define discord_final_stream_schema with journal as Int returning Int:
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_final_cursors(run TEXT PRIMARY KEY,inbox TEXT NOT NULL REFERENCES discord_inbox(identity),sequence INTEGER NOT NULL DEFAULT 0); CREATE TRIGGER IF NOT EXISTS discord_final_cursor_binding BEFORE UPDATE OF run,inbox ON discord_final_cursors BEGIN SELECT RAISE(ABORT,'Final delivery origin is immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_final_cursor_forward BEFORE UPDATE OF sequence ON discord_final_cursors WHEN NEW.sequence<OLD.sequence BEGIN SELECT RAISE(ABORT,'Final delivery cursor cannot move backwards'); END;")

define discord_final_stream_step with journal as Int and database as Int and inbox as Str and run as Str returning Str:
    if not (discord_job_origin(journal and database and run) equals inbox):
        return "scope-denied"
    # Delegated output is collected by its parent. Its activity thread may
    # finish normally without attempting to publish a separate channel reply.
    set delegated to history_collect_one(checkpoint_prepare(database and "SELECT child FROM echo_delegations WHERE child=?1;" and [run]))
    if archive_list_text(delegated and 0) equals "found":
        return "finals-caught-up"
    if not (archive_list_text(delegated and 0) equals "end"):
        return "archive-read-failed"
    if discord_final_stream_schema(journal) is not equal to 0:
        return "store-failed"
    if archive_finish(checkpoint_prepare(journal and "INSERT OR IGNORE INTO discord_final_cursors(run,inbox) VALUES(?1,?2);" and [run,inbox]) and 101) is not equal to 0:
        return "store-failed"
    set cursor to history_collect_one(checkpoint_prepare(journal and "SELECT sequence FROM discord_final_cursors WHERE run=?1 AND inbox=?2;" and [run,inbox]))
    if not (archive_list_text(cursor and 0) equals "found"):
        return "scope-denied"
    set next to history_collect_one(checkpoint_prepare(database and "SELECT e.event,e.sequence FROM echo_events e JOIN echo_runs r ON r.run=?1 AND r.session=e.session WHERE e.kind='assistant_final' AND json_extract(e.payload,'$.run_id')=?1 AND e.sequence>CAST(?2 AS INTEGER) ORDER BY e.sequence LIMIT 1;" and [run,archive_list_text(cursor and 1)]))
    if archive_list_text(next and 0) equals "end":
        return "finals-caught-up"
    if not (archive_list_text(next and 0) equals "found"):
        return "archive-read-failed"
    set queued to discord_agent_output_final(journal and database and inbox and run and archive_list_text(next and 1))
    if not (queued equals "enqueued"):
        return queued
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_final_cursors SET sequence=CAST(?3 AS INTEGER) WHERE run=?1 AND inbox=?2 AND sequence<CAST(?3 AS INTEGER);" and [run,inbox,archive_list_text(next and 2)]) and 101) is not equal to 0:
        return "store-failed"
    return "final-enqueued"
