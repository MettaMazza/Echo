import "post_file"
import "sticker_multipart"
import "../archive/file_base64"

# Resolve only an included attachment in this admitted Discord conversation.
# Discord validates image decoding, dimensions and animation limits. A refusal
# is preserved; creation is never automatically retried with altered content.
define discord_expression_upload with database as Int and run as Str and actor as Str and kind as Str and attachment as Str and metadata as Str and server as Str returning List:
    if discord_expression_changes(metadata and kind and 1) equals 0:
        return history_status("invalid-expression-fields")
    set file to discord_post_file_source(database and run and actor and attachment)
    if not (archive_list_text(file and 0) equals "found"):
        return file
    set path to archive_list_text(file and 1)
    set digest to archive_list_text(file and 4)
    set size to http_decimal(archive_list_text(file and 5))
    set media to archive_list_text(file and 3)
    if size < 1:
        return history_status("expression-file-empty-or-invalid")
    if kind equals "emoji":
        if not (media equals "image/png" or else media equals "image/jpeg" or else media equals "image/gif" or else media equals "image/webp" or else media equals "image/avif"):
            return history_status("emoji-image-type-unsupported")
        if size > 262144:
            return history_status("emoji-image-too-large")
        set encoded to file_base64_verified(path and digest and size and 262144)
        if not (archive_list_text(encoded and 0) equals "verified"):
            return encoded
        set uri to concat("data:" and concat(media and concat(";base64," and archive_list_text(encoded and 1))))
        set trimmed to string_trim(metadata)
        set body to substring(trimmed and 0 and string_length(trimmed) - 1)
        set body to concat(body and concat(",\"image\":" and concat(provider_quote(uri) and "}")))
        return ["json-ready",body,digest]
    if not (kind equals "sticker"):
        return history_status("invalid-expression-kind")
    if size > 524288:
        return history_status("sticker-file-too-large")
    if not (media equals "image/png" or else media equals "image/apng" or else media equals "image/gif" or else media equals "application/json"):
        return history_status("sticker-file-type-unsupported")
    if media equals "application/json":
        set fields to provider_json_tokens(server)
        if fields equals 0 or else provider_unique_objects(fields) equals 0:
            return history_status("invalid-guild-features")
        set features to provider_member(fields and 0 and "features")
        if not (provider_kind(fields and features) equals "["):
            return history_status("lottie-guild-feature-required")
        set permitted to 0
        set index to features + 1
        repeat while not (provider_kind(fields and index) equals "]"):
            if provider_kind(fields and index) equals "string":
                if provider_value(fields and index) equals "VERIFIED" or else provider_value(fields and index) equals "PARTNERED":
                    set permitted to 1
            set index to provider_after(fields and index)
            if provider_kind(fields and index) equals ",":
                set index to index + 1
        if permitted equals 0:
            return history_status("lottie-guild-feature-required")
    set prepared to discord_sticker_multipart(path and digest and size and metadata and discord_post_filename(archive_list_text(file and 2)) and media)
    if archive_list_text(prepared and 0) equals "multipart-ready":
        set added to append_list(prepared and digest)
    return prepared
