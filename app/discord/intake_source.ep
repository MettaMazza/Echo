import "command_anchor"

# Transport projection only, not a permission grant. Keep the real intake and
# its human actor distinct from a slash command's bot-authored public anchor.
# Result: status, kind, original payload, actor, channel, guild, anchor, cursor.
define discord_intake_source with journal as Int and inbox as Str returning List:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT kind,payload,rowid FROM discord_inbox WHERE identity=?1;" and [inbox]))
    if not (archive_list_text(row and 0) equals "found"):
        return history_status("source-claim-unavailable")
    set kind to archive_list_text(row and 1)
    set original to archive_list_text(row and 2)
    if kind equals "INTERACTION_CREATE":
        set anchor to discord_command_anchor_read(journal and inbox)
        if not (archive_list_text(anchor and 0) equals "found"):
            return history_status("source-anchor-unavailable")
        return ["found",kind,original,archive_list_text(anchor and 1),archive_list_text(anchor and 2),archive_list_text(anchor and 3),archive_list_text(anchor and 4),archive_list_text(row and 3)]
    if not (kind equals "MESSAGE_CREATE") or else not (string_index_of(inbox and "message:create:") equals 0):
        return history_status("unsupported-source-kind")
    set parsed to provider_json_tokens(original)
    set actor to provider_value(parsed and provider_member(parsed and provider_member(parsed and 0 and "author") and "id"))
    set room to provider_value(parsed and provider_member(parsed and 0 and "channel_id"))
    set guild_id to provider_value(parsed and provider_member(parsed and 0 and "guild_id"))
    if guild_id equals "null":
        set guild_id to ""
    set message to provider_value(parsed and provider_member(parsed and 0 and "id"))
    return ["found",kind,original,actor,room,guild_id,message,archive_list_text(row and 3)]
