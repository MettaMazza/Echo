import "store"

# A newly created message cannot change an existing request, membership or
# channel permission. Every other dispatch still invalidates a voice proof.
# Require an immutable receipt for every intervening sequence: missing events,
# edits/deletions, permission changes and unknown event types are never skipped.
# Callers separately bind the Gateway session/generation and current source.
define discord_voice_proof_messages_only with journal as Int and session as Str and before as Int and after as Int returning Int:
    if string_length(session) equals 0 or else before < 0 or else after < before or else after > 9007199254740991:
        return 0
    if before equals after:
        return 1
    set first to int_to_string(before)
    set last to int_to_string(after)
    set keys to create_list()
    set added to append_list(keys and session)
    set added to append_list(keys and first)
    set added to append_list(keys and last)
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT COUNT(*),COALESCE(SUM(CASE WHEN kind='MESSAGE_CREATE' THEN 0 ELSE 1 END),0) FROM discord_dispatch WHERE session=?1 AND sequence>CAST(?2 AS INTEGER) AND sequence<=CAST(?3 AS INTEGER);" and keys))
    return archive_list_text(row and 0) equals "found" and also string_to_int(archive_list_text(row and 1)) equals after - before and also archive_list_text(row and 2) equals "0"
