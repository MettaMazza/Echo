import "../workspace/files"

# Exclusive canonical receipt files, allocated independently of Discord's
# acknowledgement deadline. Each pair is consumed once and never reused.
define discord_ack_receipt_pair with directory_path as Str returning List:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and directory_path)
    set output to -1
    set headers to -1
    if directory >= 0:
        set name to ptr_to_str(ep_uuid_v4())
        set output to workspace_file_open(system and directory and concat(name and ".json") and 1)
        set headers to workspace_file_open(system and directory and concat(name and ".headers") and 1)
        set closed to net_close(directory)
    set closed to ep_dlclose(system)
    if output < 0 or else headers < 0:
        if output >= 0:
            set closed to net_close(output)
        if headers >= 0:
            set closed to net_close(headers)
        set output to -1
        set headers to -1
    set pair to create_list()
    set added to append_list(pair and output)
    set added to append_list(pair and headers)
    return pair

define discord_ack_receipt_close with pair as List returning Int:
    if get_list(pair and 0) >= 0:
        set closed to net_close(get_list(pair and 0))
    if get_list(pair and 1) >= 0:
        set closed to net_close(get_list(pair and 1))
    return 0

define discord_ack_receipt_worker with directory_path as Str and refill as Int and receipts as Int and completed as Int returning Int:
    repeat while 1 equals 1:
        set requested to receive from refill
        if requested equals 0:
            break
        set pair to discord_ack_receipt_pair(directory_path)
        send pair to receipts
    send 0 to completed
    return 0
