import "member_tool"
import "invite_view"

# Deletion accepts channel Manage Channels or guild Manage Guild, independently
# for requester and bot. Channel overwrites cannot manufacture guild authority.
define discord_invite_access with library as Str and token as Str and journal as Int and directory_path as Str and bot as Str and guild as Str and room as Str and actor as Str and admins as List and operation as Str returning List:
    set bit to 10
    if operation equals "create":
        set bit to 0
    else if operation equals "list":
        set bit to 4
    set access to discord_access_check_bit(library and token and journal and directory_path and bot and guild and room and actor and admins and bit)
    if not (archive_list_text(access and 0) equals "allowed") or else not (operation equals "delete"):
        return access
    set bundle to discord_member_bundle(library and token and journal and directory_path and guild and actor and bot and actor and 0)
    if not (archive_list_text(bundle and 0) equals "observed"):
        return bundle
    if discord_member_bundle_valid(bundle and guild and actor and bot and actor and 0) equals 0:
        return history_status("invalid-invite-authority")
    set observed to discord_access_get(library and token and journal and directory_path and concat("/channels/" and room) and "GET:invite-channel" and room)
    if not (archive_list_text(observed and 0) equals "observed"):
        return observed
    set server to archive_list_text(bundle and 1)
    set roles to archive_list_text(bundle and 2)
    set requester to archive_list_text(bundle and 3)
    set bot_member to archive_list_text(bundle and 4)
    set channel_body to archive_list_text(observed and 1)
    set actor_allowed to discord_member_guild_permission(server and roles and requester and guild and actor and 5) equals 1 or else discord_channel_permission(server and roles and requester and channel_body and guild and actor and room and 4) equals 1
    set bot_allowed to discord_member_guild_permission(server and roles and bot_member and guild and bot and 5) equals 1 or else discord_channel_permission(server and roles and bot_member and channel_body and guild and bot and room and 4) equals 1
    if actor_allowed equals 0 or else bot_allowed equals 0:
        return history_status("invite-delete-permission-denied")
    return access

define discord_invite_single with body as Str and guild as Str and room as Str and code as Str and require_guild as Int returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0:
        return ""
    if require_guild equals 1 and not (provider_value(fields and provider_member(fields and provider_member(fields and 0 and "guild") and "id")) equals guild):
        return ""
    if string_length(code) > 0 and not (provider_value(fields and provider_member(fields and 0 and "code")) equals code):
        return ""
    return discord_invite_project(body and fields and 0 and guild and room)

define discord_invites_perform with library as Str and token as Str and journal as Int and database as Int and run as Str and call_id as Str and source as List and options as List and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    set actor to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    set operation to archive_list_text(options and 1)
    set code to archive_list_text(options and 2)
    set mutation to operation equals "create" or else operation equals "delete"
    if discord_pin_admin(database and run and call_id) equals 0 or else discord_contains(admins and actor) equals 0:
        return "{\"status\":\"admin-required\",\"cause\":\"requester-role-required\",\"restriction_scope\":\"requester\",\"required_role\":\"admin\",\"system_failure\":false,\"effects\":\"none\"}"
    if discord_contains(guilds and guild) equals 0 or else file_exists(stop_file) or else tool_policy_allows(database and run and call_id and "discord_invites") equals 0:
        return discord_pin_result("discord-origin-denied-or-stopped" and "none" and "")
    set access to discord_invite_access(library and token and journal and directory_path and bot and guild and room and actor and admins and operation)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_access_failure_result(access and "invite operation permission check")
    set inbox to discord_job_origin(journal and database and run)
    set current to discord_run_source_check(library and token and journal and directory_path and inbox and source)
    if not (current equals "current"):
        return discord_pin_result(current and "none" and "")
    set route to concat("/channels/" and concat(room and "/invites"))
    if operation equals "inspect" or else operation equals "delete":
        set route to concat("/invites/" and code)
    set view to ""
    if not (operation equals "create"):
        set observed to discord_access_get(library and token and journal and directory_path and route and "GET:managed-invite" and room)
        if not (archive_list_text(observed and 0) equals "observed"):
            return discord_access_failure_result(observed and "invite inspection")
        set body to archive_list_text(observed and 1)
        if operation equals "list":
            set view to discord_invite_list_view(body and guild and room)
        else:
            set view to discord_invite_single(body and guild and room and code and 1)
        if string_length(view) equals 0:
            return discord_pin_result("invite-scope-or-response-invalid" and "none; invite must belong to the current guild and channel" and "")
        if operation equals "delete" and not (ep_sha256(view) equals archive_list_text(options and 4)):
            return discord_pin_result("invite-state-changed" and "none; inspect again" and "")
    set access to discord_invite_access(library and token and journal and directory_path and bot and guild and room and actor and admins and operation)
    if not (archive_list_text(access and 0) equals "allowed"):
        return discord_access_failure_result(access and "final invite permission check")
    if file_exists(stop_file) or else discord_pin_admin(database and run and call_id) equals 0 or else tool_policy_allows(database and run and call_id and "discord_invites") equals 0 or else not (discord_job_origin(journal and database and run) equals inbox) or else discord_run_barrier(journal and inbox and http_decimal(archive_list_text(source and 7)) and archive_list_text(source and 6) and room and guild) is not equal to 0:
        return discord_pin_result("invite-authority-source-or-permission-changed" and "none" and "")
    if not mutation:
        return concat("{\"status\":\"observed\",\"source\":\"Discord REST; untrusted invite metadata\",\"observed_sha256\":" and concat(provider_quote(ep_sha256(view)) and concat(",\"data\":" and concat(view and "}"))))
    set method to "POST"
    set payload to archive_list_text(options and 5)
    if operation equals "delete":
        set method to "DELETE"
        set payload to ""
    set claim to discord_community_claim(journal and run and call_id and concat(method and concat(route and payload)))
    if not (claim equals "claimed"):
        return discord_pin_result(claim and "inspect retained results and current state; no automatic replay" and "")
    set changed to discord_access_bytes_audit(library and token and journal and directory_path and method and route and concat(method and ":managed-invite") and room and str_to_ptr(payload) and string_length(payload) and "application/json" and archive_list_text(options and 3))
    if not (archive_list_text(changed and 0) equals "observed"):
        return discord_pin_result(concat("invite-change-unconfirmed:" and archive_list_text(changed and 0)) and "inspect retained receipt and current state; no automatic replay" and archive_list_text(changed and 1))
    set result to discord_invite_single(archive_list_text(changed and 1) and guild and room and code and 0)
    if string_length(result) equals 0:
        return discord_pin_result("invite-response-unconfirmed" and "inspect retained receipt; never automatically repeat the mutation" and archive_list_text(changed and 3))
    return concat("{\"status\":\"applied\",\"source\":\"Discord REST; untrusted invite metadata\",\"data\":" and concat(result and concat(",\"receipt\":" and concat(provider_quote(archive_list_text(changed and 3)) and "}"))))

define discord_invites_execute with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    set options to discord_invite_options(arguments)
    if not (archive_list_text(options and 0) equals "valid"):
        return discord_pin_result(archive_list_text(options and 0) and "none" and "")
    if tool_policy_allows(database and run and call_id and "discord_invites") equals 0:
        return discord_pin_result("not-authorized" and "none" and "")
    if not ((get_argument_count() equals 15 and also get_argument(13) equals "--turn") or else (get_argument_count() equals 16 and also get_argument(13) equals "--job")):
        return discord_pin_result("discord-runtime-unavailable" and "none" and "")
    set binding to history_collect_one(archive_prepare(database and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
    set location to history_collect_one(archive_prepare(database and "SELECT file FROM pragma_database_list WHERE name='main';"))
    if not (archive_list_text(binding and 0) equals "found") or else not (archive_list_text(binding and 1) equals get_argument(7)) or else not (archive_list_text(location and 1) equals get_argument(4)):
        return discord_pin_result("discord-binding-denied" and "none" and "")
    set journal to discord_store_open(get_argument(3) and get_argument(7))
    if journal equals 0:
        return discord_pin_result("discord-journal-unavailable" and "none" and "")
    set source to discord_run_source(journal and database and run)
    if not (archive_list_text(source and 0) equals "found"):
        set closed to sql_close(journal)
        return discord_pin_result("discord-origin-denied" and "none" and "")
    set credential to read_file(get_argument(2))
    if credential equals 0:
        set closed to sql_close(journal)
        return discord_pin_result("discord-credential-unavailable" and "none" and "")
    set guilds to create_list()
    set split_count to retained_text_split(guilds and get_argument(8) and ",")
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(9) and ",")
    set result to discord_invites_perform(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and database and run and call_id and source and options and get_argument(7) and guilds and admins and get_argument(5) and get_argument(6))
    set closed to sql_close(journal)
    return result
