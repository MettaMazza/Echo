import "rich_post"

# RFC3339 timestamps have an explicit timezone. No locale-dependent parsing or
# host timezone assumptions. Fractional milliseconds are truncated, not rounded.
define discord_event_digits with value as Str and start as Int and count as Int returning Int:
    if start < 0 or else count < 1 or else start + count > string_length(value):
        return -1
    set index to start
    set number to 0
    repeat while index < start + count:
        set byte to peek_byte(str_to_ptr(value) and index)
        if byte < 48 or else byte > 57:
            return -1
        set number to number * 10 + byte - 48
        set index to index + 1
    return number

define discord_event_leap with year as Int returning Int:
    return year - year / 4 * 4 equals 0 and also (year - year / 100 * 100 is not equal to 0 or else year - year / 400 * 400 equals 0)

define discord_event_month_days with year as Int and month as Int returning Int:
    if month equals 2:
        return 28 + discord_event_leap(year)
    if month equals 4 or else month equals 6 or else month equals 9 or else month equals 11:
        return 30
    return 31

define discord_event_timestamp with value as Str returning Int:
    set size to string_length(value)
    if size < 20 or else size > 35:
        return -1
    if not (substring(value and 4 and 1) equals "-" and also substring(value and 7 and 1) equals "-" and also substring(value and 10 and 1) equals "T" and also substring(value and 13 and 1) equals ":" and also substring(value and 16 and 1) equals ":"):
        return -1
    set year to discord_event_digits(value and 0 and 4)
    set month to discord_event_digits(value and 5 and 2)
    set day to discord_event_digits(value and 8 and 2)
    set hour to discord_event_digits(value and 11 and 2)
    set minute to discord_event_digits(value and 14 and 2)
    set second to discord_event_digits(value and 17 and 2)
    if year < 1970 or else month < 1 or else month > 12 or else day < 1 or else day > discord_event_month_days(year and month) or else hour < 0 or else hour > 23 or else minute < 0 or else minute > 59 or else second < 0 or else second > 59:
        return -1
    set index to 19
    set fraction to 0
    if substring(value and index and 1) equals ".":
        set index to index + 1
        set start to index
        repeat while index < size and also discord_event_digits(value and index and 1) >= 0:
            if index - start < 3:
                set fraction to fraction * 10 + discord_event_digits(value and index and 1)
            set index to index + 1
        set count to index - start
        if count < 1 or else count > 9:
            return -1
        repeat while count < 3:
            set fraction to fraction * 10
            set count to count + 1
    set offset to 0
    if substring(value and index and 1) equals "Z":
        if index + 1 is not equal to size:
            return -1
    else:
        set sign to substring(value and index and 1)
        if not (sign equals "+" or else sign equals "-") or else index + 6 is not equal to size or else not (substring(value and index + 3 and 1) equals ":"):
            return -1
        set offset_hour to discord_event_digits(value and index + 1 and 2)
        set offset_minute to discord_event_digits(value and index + 4 and 2)
        if offset_hour < 0 or else offset_hour > 23 or else offset_minute < 0 or else offset_minute > 59:
            return -1
        # RFC3339 -00:00 signifies unknown local offset, not verified UTC.
        if sign equals "-" and also offset_hour equals 0 and also offset_minute equals 0:
            return -1
        set offset to (offset_hour * 60 + offset_minute) * 60000
        if sign equals "-":
            set offset to 0 - offset
    set prior_year to year - 1
    set days to (year - 1970) * 365 + prior_year / 4 - prior_year / 100 + prior_year / 400 - 477
    set prior_month to 1
    repeat while prior_month < month:
        set days to days + discord_event_month_days(year and prior_month)
        set prior_month to prior_month + 1
    return (days + day - 1) * 86400000 + hour * 3600000 + minute * 60000 + second * 1000 + fraction - offset
