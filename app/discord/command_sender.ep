import "agent_bridge"

# Interaction names are descriptive source data, never permission keys.
# Preserve member.user directly; do not manufacture a message author envelope.
define discord_command_sender_record with database as Int and run as Str and original as Str returning Int:
    set owner to agent_run_read(database and run)
    if owner equals 0:
        return 1
    set tokens to provider_json_tokens(original)
    set member to provider_member(tokens and 0 and "member")
    set user to provider_member(tokens and member and "user")
    set actor to provider_value(tokens and provider_member(tokens and user and "id"))
    set authority to history_collect_one(checkpoint_prepare(database and "SELECT device FROM echo_run_authority WHERE run=?1;" and [run]))
    if discord_snowflake(actor) equals 0 or else not (archive_list_text(authority and 1) equals concat("discord:" and actor)):
        return 1
    set username to discord_sender_label(tokens and provider_member(tokens and user and "username"))
    set global_name to discord_sender_label(tokens and provider_member(tokens and user and "global_name"))
    set nickname to discord_sender_label(tokens and provider_member(tokens and member and "nick"))
    set display_name to nickname
    if string_length(display_name) equals 0:
        set display_name to global_name
    if string_length(display_name) equals 0:
        set display_name to username
    set payload to concat("{\"user_id\":" and provider_quote(actor))
    set payload to concat(payload and concat(",\"username\":" and provider_quote(username)))
    set payload to concat(payload and concat(",\"display_name\":" and provider_quote(display_name)))
    set payload to concat(payload and concat(",\"global_name\":" and provider_quote(global_name)))
    set payload to concat(payload and concat(",\"server_nickname\":" and concat(provider_quote(nickname) and "}")))
    set identity to concat(run and ":discord-sender")
    set prior to archive_read_event(database and identity)
    if prior is not equal to 0:
        if not (archive_list_text(prior and 0) equals archive_list_text(owner and 0)) or else not (archive_list_text(prior and 2) equals "discord_sender") or else not (archive_list_text(prior and 3) equals payload):
            return 1
        return 0
    return archive_append(database and archive_list_text(owner and 0) and identity and "discord_sender" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms())))
