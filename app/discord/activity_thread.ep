import "store"
import "intake_source"

# A source message is the permanent identity of its activity thread. Never
# attach to whichever bot reply is newest or discard the binding at completion.
# Discord's message-started thread ID is the originating message ID.
define discord_activity_schema with journal as Int returning Int:
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_activity_threads(inbox TEXT PRIMARY KEY REFERENCES discord_inbox(identity),source TEXT NOT NULL UNIQUE,channel TEXT NOT NULL,guild TEXT NOT NULL,thread TEXT NOT NULL DEFAULT '',state TEXT NOT NULL CHECK(state IN ('planned','creating','uncertain','ready','blocked')),created_ms INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS discord_activity_thread_events(sequence INTEGER PRIMARY KEY AUTOINCREMENT,inbox TEXT NOT NULL REFERENCES discord_activity_threads(inbox),state TEXT NOT NULL,detail TEXT NOT NULL,observed_ms INTEGER NOT NULL); CREATE TRIGGER IF NOT EXISTS discord_activity_binding_immutable BEFORE UPDATE OF inbox,source,channel,guild,created_ms ON discord_activity_threads BEGIN SELECT RAISE(ABORT,'Activity source binding is immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_activity_binding_no_delete BEFORE DELETE ON discord_activity_threads BEGIN SELECT RAISE(ABORT,'Activity threads persist'); END; CREATE TRIGGER IF NOT EXISTS discord_activity_events_no_update BEFORE UPDATE ON discord_activity_thread_events BEGIN SELECT RAISE(ABORT,'Activity receipts are immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_activity_events_no_delete BEFORE DELETE ON discord_activity_thread_events BEGIN SELECT RAISE(ABORT,'Activity receipts are immutable'); END;")

define discord_activity_plan with journal as Int and inbox as Str returning Str:
    if discord_activity_schema(journal) is not equal to 0:
        return "invalid-source"
    set source to discord_intake_source(journal and inbox)
    if not (archive_list_text(source and 0) equals "found"):
        return "source-unavailable"
    set message to archive_list_text(source and 6)
    set room to archive_list_text(source and 4)
    set guild to archive_list_text(source and 5)
    if discord_snowflake(message) equals 0 or else discord_snowflake(room) equals 0:
        return "invalid-source"
    if archive_list_text(source and 1) equals "MESSAGE_CREATE" and not (inbox equals concat("message:create:" and message)):
        return "invalid-source"
    set values to create_list()
    set added to append_list(values and inbox)
    if discord_snowflake(guild) equals 0:
        return "native-thread-unavailable"
    set added to append_list(values and message)
    set added to append_list(values and room)
    set added to append_list(values and guild)
    set now to int_to_string(ep_time_now_ms())
    set added to append_list(values and now)
    if archive_finish(checkpoint_prepare(journal and "INSERT OR IGNORE INTO discord_activity_threads(inbox,source,channel,guild,state,created_ms) VALUES(?1,?2,?3,?4,'planned',CAST(?5 AS INTEGER));" and values) and 101) is not equal to 0:
        return "write-failed"
    set binding_values to create_list()
    set added to append_list(binding_values and inbox)
    set added to append_list(binding_values and message)
    set added to append_list(binding_values and room)
    set added to append_list(binding_values and guild)
    set bound to history_collect_one(checkpoint_prepare(journal and "SELECT state FROM discord_activity_threads WHERE inbox=?1 AND source=?2 AND channel=?3 AND guild=?4;" and binding_values))
    if not (archive_list_text(bound and 0) equals "found"):
        return "binding-conflict"
    return archive_list_text(bound and 1)

# Validate GET/POST channel evidence before storing a usable destination.
# A thread belonging to someone else's message or bot cannot substitute.
# Archived threads remain the same thread; reopening is a separate operation.
define discord_activity_observe with journal as Int and inbox as Str and body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "invalid-observation"
    set values to create_list()
    set added to append_list(values and inbox)
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT t.source,t.channel,t.guild,i.bot FROM discord_activity_threads t CROSS JOIN discord_identity i WHERE t.inbox=? AND i.singleton=1;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "not-planned"
    set kind to provider_value(tokens and provider_member(tokens and 0 and "type"))
    if not (kind equals "10" or else kind equals "11") or else not (provider_value(tokens and provider_member(tokens and 0 and "id")) equals archive_list_text(row and 1)) or else not (provider_value(tokens and provider_member(tokens and 0 and "parent_id")) equals archive_list_text(row and 2)) or else not (provider_value(tokens and provider_member(tokens and 0 and "guild_id")) equals archive_list_text(row and 3)) or else not (provider_value(tokens and provider_member(tokens and 0 and "owner_id")) equals archive_list_text(row and 4)):
        return "thread-binding-mismatch"
    set added to append_list(values and ep_sha256(body))
    set now to int_to_string(ep_time_now_ms())
    set added to append_list(values and now)
    set binding_values to create_list()
    set added to append_list(binding_values and inbox)
    if sql_execute(journal and "BEGIN IMMEDIATE;") is not equal to 0:
        return "busy"
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_activity_thread_events(inbox,state,detail,observed_ms) SELECT inbox,'ready',?2,CAST(?3 AS INTEGER) FROM discord_activity_threads WHERE inbox=?1 AND state<>'ready';" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_activity_threads SET thread=source,state='ready' WHERE inbox=?1;" and binding_values) and 101) is not equal to 0:
        return migration_fail(journal and "write-failed")
    if sql_execute(journal and "COMMIT;") is not equal to 0:
        return "commit-failed"
    return "ready"
