import "onboarding_changes"
import "audit_reason"

# Onboarding replaces explicitly supplied arrays. Never silently merge prompt
# choices or inherit a caller-supplied guild route; edits require fresh inspection.
define discord_onboarding_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|guild|operation|reason|observed_sha256|changes|") equals 0:
        return history_status("invalid-onboarding-arguments")
    set keys to create_list()
    set keys to ["guild","operation","reason","observed_sha256"]
    for each item in keys:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and also not (provider_kind(fields and field) equals "string"):
            return history_status("invalid-onboarding-string")
    set guild to provider_value(fields and provider_member(fields and 0 and "guild"))
    if discord_snowflake(guild) equals 0:
        return history_status("onboarding-guild-required")
    set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
    if operation equals "inspect":
        if provider_member(fields and 0 and "reason") >= 0 or else provider_member(fields and 0 and "observed_sha256") >= 0 or else provider_member(fields and 0 and "changes") >= 0:
            return history_status("unused-onboarding-fields")
        return ["valid",guild,operation,"","","{}"]
    if not (operation equals "edit"):
        return history_status("invalid-onboarding-operation")
    set reason to provider_value(fields and provider_member(fields and 0 and "reason"))
    if string_length(discord_audit_reason(reason)) equals 0:
        return history_status("onboarding-reason-required")
    set digest to provider_value(fields and provider_member(fields and 0 and "observed_sha256"))
    if string_length(digest) is not equal to 64:
        return history_status("onboarding-observed-sha256-required")
    set index to 0
    repeat while index < 64:
        if string_contains("0123456789abcdef" and substring(digest and index and 1)) equals 0:
            return history_status("invalid-onboarding-sha256")
        set index to index + 1
    set field to provider_member(fields and 0 and "changes")
    if field < 0:
        return history_status("onboarding-changes-required")
    set changes to agent_json_source(arguments and fields and field)
    if provider_kind(fields and field) equals "string":
        set changes to provider_value(fields and field)
    if discord_onboarding_changes(changes) equals 0:
        return history_status("invalid-onboarding-changes")
    return ["valid",guild,operation,reason,digest,changes]
