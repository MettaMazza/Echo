import "voice_recording_capture"
import "../research/vector_controls"

external define sqlite3_bind_blob with statement as Int and position as Int and pointer as Int and bytes as Int and destructor as Int returning Int
external define sqlite3_get_autocommit with database as Int returning Int

# Durable capture journal, not a conversation attachment or transcript. Each
# immutable PCM packet carries exact native provenance; later archive publication
# must verify these bytes and enforce the original channel audience separately.
define discord_voice_recording_frames_schema with journal as Int returning Int:
    if discord_voice_recording_runtime_schema(journal) is not equal to 0:
        return 1
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_voice_recording_frames(identity TEXT PRIMARY KEY,recording TEXT NOT NULL REFERENCES discord_voice_recordings(identity),actor TEXT NOT NULL,voice_session TEXT NOT NULL,consent TEXT NOT NULL REFERENCES discord_voice_recording_consents(receipt),ssrc INTEGER NOT NULL CHECK(ssrc BETWEEN 1 AND 4294967295),nonce INTEGER NOT NULL CHECK(nonce BETWEEN 0 AND 4294967295),packet_sequence INTEGER NOT NULL CHECK(packet_sequence BETWEEN 0 AND 65535),rtp_timestamp INTEGER NOT NULL CHECK(rtp_timestamp BETWEEN 0 AND 4294967295),gateway_session TEXT NOT NULL,gateway_sequence INTEGER NOT NULL,authority_evidence TEXT NOT NULL CHECK(length(authority_evidence)=64),captured_ms INTEGER NOT NULL CHECK(captured_ms>=0),sample_rate INTEGER NOT NULL CHECK(sample_rate=48000),channels INTEGER NOT NULL CHECK(channels=2),frames INTEGER NOT NULL CHECK(frames BETWEEN 1 AND 5760),digest TEXT NOT NULL CHECK(length(digest)=64),pcm BLOB NOT NULL CHECK(typeof(pcm)='blob' AND length(pcm)=frames*4)); CREATE INDEX IF NOT EXISTS discord_voice_recording_frames_recording ON discord_voice_recording_frames(recording,captured_ms); CREATE TRIGGER IF NOT EXISTS discord_voice_recording_frames_no_update BEFORE UPDATE ON discord_voice_recording_frames BEGIN SELECT RAISE(ABORT,'Captured voice packets are immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_voice_recording_frames_no_delete BEFORE DELETE ON discord_voice_recording_frames BEGIN SELECT RAISE(ABORT,'Captured voice packets persist'); END; CREATE TABLE IF NOT EXISTS discord_voice_recording_capture_outcomes(recording TEXT PRIMARY KEY REFERENCES discord_voice_recordings(identity),outcome TEXT NOT NULL,observed_ms INTEGER NOT NULL);")

# Caller owns a journal writer transaction from capture through this insertion
# and its commit. PCM is borrowed; SQLite copies it before this call returns.
# "staged" is deliberately not "persisted": caller must check commit success.
define discord_voice_recording_frame_stage with journal as Int and database as Int and system as Int and engine as List and receiver as List and identity as Str and proof as List and bot as Str and guilds as List and admins as List and stop_file as Str and decoded as List and captured_ms as Int returning List:
    if sqlite3_get_autocommit(journal) is not equal to 0:
        return history_status("recording-frame-transaction-required")
    if decoded equals 0 or else length_list(decoded) is not equal to 9 or else not (archive_list_text(decoded and 0) equals "voice-pcm") or else captured_ms < 0 or else system equals 0:
        return history_status("recording-frame-invalid")
    if discord_voice_recording_runtime_enabled(journal) equals 0:
        return history_status("recording-runtime-unavailable")
    set policy to discord_voice_recording_capture_policy(journal and database and engine and receiver and identity and proof and bot and guilds and admins and stop_file)
    if not (archive_list_text(policy and 0) equals "recording-current"):
        return policy
    set actor to archive_list_text(decoded and 1)
    set voice_session to archive_list_text(decoded and 2)
    set receipt to archive_list_text(decoded and 6)
    set ssrc to get_list(decoded and 7)
    set nonce to get_list(decoded and 8)
    if string_length(receipt) equals 0 or else not (discord_voice_receiver_consent(get_list(engine and 5) and policy and actor and voice_session and ssrc) equals receipt):
        return history_status("recording-frame-consent-denied")
    set pcm to get_list(decoded and 5)
    if pcm equals 0 or else length_list(pcm) is not equal to 2 or else get_list(pcm and 0) equals 0 or else get_list(pcm and 1) < 4 or else get_list(pcm and 1) > 23040 or else get_list(pcm and 1) modulo 4 is not equal to 0 or else ssrc < 1 or else ssrc > 4294967295 or else nonce < 0 or else nonce > 4294967295 or else get_list(decoded and 3) < 0 or else get_list(decoded and 3) > 65535 or else get_list(decoded and 4) < 0 or else get_list(decoded and 4) > 4294967295:
        return history_status("recording-frame-invalid")
    set digest to research_memory_digest(system and get_list(pcm and 0) and get_list(pcm and 1))
    if string_length(digest) is not equal to 64:
        return history_status("recording-frame-hash-failed")
    set key to concat(provider_quote(identity) and concat(provider_quote(actor) and provider_quote(voice_session)))
    set key to concat(key and concat(provider_quote(receipt) and concat(provider_quote(int_to_string(ssrc)) and provider_quote(int_to_string(nonce)))))
    set frame_id to ep_sha256(key)
    set transport to get_list(proof and 5)
    set values to [frame_id,identity,actor,voice_session,receipt,int_to_string(ssrc),int_to_string(nonce),int_to_string(get_list(decoded and 3)),int_to_string(get_list(decoded and 4)),archive_list_text(transport and 2),int_to_string(get_list(transport and 3)),int_to_string(captured_ms),int_to_string(get_list(pcm and 1) / 4),digest,archive_list_text(proof and 6)]
    set statement to checkpoint_prepare(journal and "INSERT INTO discord_voice_recording_frames(identity,recording,actor,voice_session,consent,ssrc,nonce,packet_sequence,rtp_timestamp,gateway_session,gateway_sequence,captured_ms,sample_rate,channels,frames,digest,authority_evidence,pcm) VALUES(?1,?2,?3,?4,?5,CAST(?6 AS INTEGER),CAST(?7 AS INTEGER),CAST(?8 AS INTEGER),CAST(?9 AS INTEGER),?10,CAST(?11 AS INTEGER),CAST(?12 AS INTEGER),48000,2,CAST(?13 AS INTEGER),?14,?15,?16) ON CONFLICT(identity) DO NOTHING;" and values)
    if statement equals 0:
        return history_status("recording-frame-store-failed")
    # SQLITE_TRANSIENT copies the exact binary PCM, including embedded NULs.
    if sqlite3_bind_blob(statement and 16 and get_list(pcm and 0) and get_list(pcm and 1) and -1) is not equal to 0:
        set closed to ep_sqlite3_finalize(statement)
        return history_status("recording-frame-store-failed")
    if archive_finish(statement and 101) is not equal to 0:
        return history_status("recording-frame-store-failed")
    set matched to history_collect_one(checkpoint_prepare(journal and "SELECT identity FROM discord_voice_recording_frames WHERE identity=?1 AND recording=?2 AND actor=?3 AND voice_session=?4 AND consent=?5 AND ssrc=CAST(?6 AS INTEGER) AND nonce=CAST(?7 AS INTEGER) AND packet_sequence=CAST(?8 AS INTEGER) AND rtp_timestamp=CAST(?9 AS INTEGER) AND gateway_session=?10 AND frames=CAST(?13 AS INTEGER) AND digest=?14 AND authority_evidence=?15;" and values))
    if not (archive_list_text(matched and 0) equals "found"):
        return history_status("recording-frame-conflict")
    # Archive cancellation is independent of the journal writer transaction.
    # A denial requires the caller to roll back this staged insertion.
    set checked to discord_voice_recording_proof_check(journal and database and identity and proof and bot and guilds and admins and stop_file)
    if not (checked equals "allowed"):
        return history_status(checked)
    return ["recording-frame-staged",frame_id,digest,int_to_string(get_list(pcm and 1))]
