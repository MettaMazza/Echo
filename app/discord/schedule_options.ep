import "interaction_intake"

define discord_schedule_command_definition returning Str:
    return "{\"type\":1,\"name\":\"schedules\",\"description\":\"Inspect your conversation schedules or cancel future occurrences.\",\"options\":[{\"type\":3,\"name\":\"action\",\"description\":\"Choose a schedule action.\",\"required\":true,\"choices\":[{\"name\":\"list\",\"value\":\"list\"},{\"name\":\"inspect\",\"value\":\"inspect\"},{\"name\":\"occurrences\",\"value\":\"occurrences\"},{\"name\":\"cancel\",\"value\":\"cancel\"}]},{\"type\":3,\"name\":\"session\",\"description\":\"Conversation ID from /history.\",\"required\":true},{\"type\":3,\"name\":\"schedule\",\"description\":\"Schedule ID from list; required except for list.\",\"required\":false},{\"type\":3,\"name\":\"after\",\"description\":\"Pagination cursor from the previous list or occurrences response.\",\"required\":false}]}"

# Only named string options are accepted; duplicate names are not last-wins.
define discord_schedule_command_options with body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set data to provider_member(tokens and 0 and "data")
    set options to provider_member(tokens and data and "options")
    if not (provider_kind(tokens and options) equals "["):
        return ""
    set seen to create_list()
    set output to "{"
    set items to provider_items(tokens and options)
    for each option in items:
        set name to provider_value(tokens and provider_member(tokens and option and "name"))
        set field to provider_member(tokens and option and "value")
        set known to 0
        set allowed_names to create_list()
        set schedule_value_1 to "action"
        set added to append_list(allowed_names and schedule_value_1)
        set schedule_value_2 to "session"
        set added to append_list(allowed_names and schedule_value_2)
        set schedule_value_3 to "schedule"
        set added to append_list(allowed_names and schedule_value_3)
        set schedule_value_4 to "after"
        set added to append_list(allowed_names and schedule_value_4)
        for each allowed in allowed_names:
            if name equals allowed:
                set known to 1
        if known equals 0 or else not (provider_value(tokens and provider_member(tokens and option and "type")) equals "3") or else not (provider_kind(tokens and field) equals "string"):
            return ""
        for each prior in seen:
            if name equals prior:
                return ""
        if length_list(seen) > 0:
            set output to concat(output and ",")
        set added to append_list(seen and name)
        set pair to concat(provider_quote(name) and concat(":" and provider_quote(provider_value(tokens and field))))
        set output to concat(output and pair)
    set output to concat(output and "}")
    set fields to provider_json_tokens(output)
    set action to provider_value(fields and provider_member(fields and 0 and "action"))
    set session to provider_value(fields and provider_member(fields and 0 and "session"))
    if string_length(session) equals 0:
        return ""
    set valid to 0
    set actions to create_list()
    set schedule_value_5 to "list"
    set added to append_list(actions and schedule_value_5)
    set schedule_value_6 to "inspect"
    set added to append_list(actions and schedule_value_6)
    set schedule_value_7 to "occurrences"
    set added to append_list(actions and schedule_value_7)
    set schedule_value_8 to "cancel"
    set added to append_list(actions and schedule_value_8)
    for each allowed in actions:
        if action equals allowed:
            set valid to 1
    if valid equals 0:
        return ""
    set schedule to provider_value(fields and provider_member(fields and 0 and "schedule"))
    set cursor to provider_member(fields and 0 and "after")
    if (not (action equals "list") and string_length(schedule) equals 0) or else (action equals "list" and provider_member(fields and 0 and "schedule") >= 0):
        return ""
    if cursor >= 0:
        if not (action equals "list" or else action equals "occurrences") or else http_decimal(provider_value(fields and cursor)) < 0 or else string_length(provider_value(fields and cursor)) equals 0:
            return ""
    # Discord supplies the cursor as a string; the control receives a JSON number.
    set output to concat("{\"action\":" and concat(provider_quote(action) and concat(",\"session\":" and provider_quote(session))))
    if string_length(schedule) > 0:
        set output to concat(output and concat(",\"schedule\":" and provider_quote(schedule)))
    if cursor >= 0:
        set output to concat(output and concat(",\"after\":" and int_to_string(http_decimal(provider_value(fields and cursor)))))
    return concat(output and "}")

# Discord may omit optional false fields, but cannot change options or choices.
define discord_schedule_command_matches with body as Str returning Int:
    set tokens to provider_json_tokens(body)
    set expected to provider_json_tokens(discord_schedule_command_definition())
    set actual_items to provider_items(tokens and provider_member(tokens and 0 and "options"))
    set wanted_items to provider_items(expected and provider_member(expected and 0 and "options"))
    if length_list(actual_items) is not equal to length_list(wanted_items):
        return 0
    set index to 0
    repeat while index < length_list(wanted_items):
        set actual to get_list(actual_items and index)
        set wanted to get_list(wanted_items and index)
        set index to index + 1
        set option_keys to create_list()
        set schedule_value_9 to "type"
        set added to append_list(option_keys and schedule_value_9)
        set schedule_value_10 to "name"
        set added to append_list(option_keys and schedule_value_10)
        set schedule_value_11 to "description"
        set added to append_list(option_keys and schedule_value_11)
        for each key in option_keys:
            if not (provider_value(tokens and provider_member(tokens and actual and key)) equals provider_value(expected and provider_member(expected and wanted and key))):
                return 0
        set actual_required to provider_value(tokens and provider_member(tokens and actual and "required")) equals "true"
        set wanted_required to provider_value(expected and provider_member(expected and wanted and "required")) equals "true"
        if actual_required is not equal to wanted_required:
            return 0
        set restrictions to create_list()
        set schedule_value_12 to "autocomplete"
        set added to append_list(restrictions and schedule_value_12)
        set schedule_value_13 to "min_length"
        set added to append_list(restrictions and schedule_value_13)
        set schedule_value_14 to "max_length"
        set added to append_list(restrictions and schedule_value_14)
        set schedule_value_15 to "options"
        set added to append_list(restrictions and schedule_value_15)
        for each forbidden in restrictions:
            if provider_member(tokens and actual and forbidden) >= 0:
                return 0
        set choices to provider_items(tokens and provider_member(tokens and actual and "choices"))
        set expected_choices to provider_items(expected and provider_member(expected and wanted and "choices"))
        if length_list(choices) is not equal to length_list(expected_choices):
            return 0
        set choice_index to 0
        repeat while choice_index < length_list(choices):
            set choice to get_list(choices and choice_index)
            set expected_choice to get_list(expected_choices and choice_index)
            set choice_index to choice_index + 1
            set choice_keys to create_list()
            set schedule_value_16 to "name"
            set added to append_list(choice_keys and schedule_value_16)
            set schedule_value_17 to "value"
            set added to append_list(choice_keys and schedule_value_17)
            for each key in choice_keys:
                if not (provider_value(tokens and provider_member(tokens and choice and key)) equals provider_value(expected and provider_member(expected and expected_choice and key))):
                    return 0
    return 1
