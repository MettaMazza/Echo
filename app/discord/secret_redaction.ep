import "../providers/archived_stream"
import "../retained_text"
import "../providers/local_json"

# Host-owned paths only. Read on every send so rotations take effect without
# retaining stale values. Failure is explicit; callers must not send unchecked.
define discord_redaction_secrets with token as Str returning List:
    set configured to ptr_to_str(get_env("ECHO_DISCORD_REDACTION_FILES"))
    set tokens to provider_json_tokens(configured)
    set files to provider_items(tokens and 0)
    if files equals 0 or else length_list(files) equals 0:
        return 0
    set secrets to create_list()
    if string_length(token) > 0:
        set added to append_list(secrets and token)
    for each item in files:
        if not (provider_kind(tokens and item) equals "string"):
            return 0
        set path to provider_value(tokens and item)
        if string_length(path) < 2 or else get_character(path and 0) is not equal to 47 or else not file_exists(path):
            return 0
        set value to read_file(path)
        if value equals 0:
            return 0
        set secret to string_trim(ptr_to_str(value))
        if string_length(secret) < 8:
            return 0
        set added to append_list(secrets and secret)
    return secrets

define discord_redaction_result with status as Str and text as Str returning List:
    set result to create_list()
    set added to append_list(result and status)
    set added to append_list(result and text)
    return result

# Darwin 64-bit SDK ABI: regex_t=32 bytes, regmatch_t=16, regoff_t=8.
# Native allocation belongs to this function; no regex or secret is logged.
define discord_redact_pattern with text as Str and pattern as Str returning List:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if system equals 0:
        return discord_redaction_result("secret-check-failed" and "")
    set compiled to ep_dlcall1(ep_dlsym(system and "malloc") and 32)
    set match to ep_dlcall1(ep_dlsym(system and "malloc") and 16)
    set compiled_ok to 0
    set status to "secret-check-failed"
    set builder to create_builder()
    set offset to 0
    set size to string_length(text)
    if compiled is not equal to 0 and match is not equal to 0:
        if ep_dlcall3(ep_dlsym(system and "regcomp") and compiled and str_to_ptr(pattern) and 3) equals 0:
            set compiled_ok to 1
            repeat while offset <= size:
                set code to ep_dlcall5(ep_dlsym(system and "regexec") and compiled and str_to_ptr(text) + offset and 1 and match and 0)
                if code equals 1:
                    set added to builder_append(builder and substring(text and offset and size - offset))
                    set status to "ready"
                    break
                if code is not equal to 0:
                    break
                set start to discord_redaction_offset(system and match)
                set finish to discord_redaction_offset(system and match + 8)
                if start < 0 or else finish <= start or else finish > size - offset:
                    break
                set added to builder_append(builder and substring(text and offset and start))
                set added to builder_append(builder and "[REDACTED]")
                set offset to offset + finish
    if compiled_ok equals 1:
        set freed to ep_dlcall1(ep_dlsym(system and "regfree") and compiled)
    set freed to ep_dlcall1(ep_dlsym(system and "free") and compiled)
    set freed to ep_dlcall1(ep_dlsym(system and "free") and match)
    set closed to ep_dlclose(system)
    set output to ptr_to_str(builder_to_string(builder))
    return discord_redaction_result(status and output)

define discord_redact_text_known with text as Str and secrets as List returning List:
    if secrets equals 0 or else provider_valid_utf8(text) equals 0:
        return discord_redaction_result("secret-check-failed" and "")
    set clean to text
    for each secret in secrets:
        set clean to ptr_to_str(string_replace(clean and ptr_to_str(secret) and "[REDACTED]"))
    set patterns to create_list()
    set added to append_list(patterns and "(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-(proj-|svcacct-)?[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{15,}|(AKIA|ASIA)[A-Z0-9]{16}|mfa[.][A-Za-z0-9_-]{40,}|[A-Za-z0-9_-]{23,28}[.][A-Za-z0-9_-]{6}[.][A-Za-z0-9_-]{25,110}|eyJ[A-Za-z0-9_-]{10,}[.]eyJ[A-Za-z0-9_-]{10,}[.][A-Za-z0-9_-]{15,})")
    set added to append_list(patterns and "((api[_-]?key|access[_-]?token|auth[_-]?token|password|passwd|secret[_-]?key)[[:space:]]*[=:][[:space:]]*[\"']?[^[:space:]\"',;<>]{1,}|(Bearer|Basic)[[:space:]]+[A-Za-z0-9_./+=-]{12,})")
    # An incomplete PEM block is withheld through the end of this message.
    set added to append_list(patterns and "-----BEGIN (RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----([^-]|-[^-]|--[^-]|---[^-]|----[^-])*(-----END (RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----|$)")
    for each pattern in patterns:
        set checked to discord_redact_pattern(clean and ptr_to_str(pattern))
        if not (archive_list_text(checked and 0) equals "ready"):
            return checked
        set clean to archive_list_text(checked and 1)
    return discord_redaction_result("ready" and clean)

define discord_redact_text with text as Str returning List:
    return discord_redact_text_known(text and discord_redaction_secrets(""))

# Decode each JSON string before matching, so JSON escapes cannot hide keys.
# Preserve unrelated fields and original formatting. Includes embed text/URLs,
# component labels and webhook/interaction message bodies, not auth headers.
define discord_redact_json with body as Str and token as Str returning List:
    set secrets to discord_redaction_secrets(token)
    set tokens to provider_json_tokens(body)
    if secrets equals 0 or else tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return discord_redaction_result("secret-check-failed" and "")
    set builder to create_builder()
    set offset to 0
    set index to 0
    set sensitive_value to -1
    repeat while index < length_list(tokens):
        if provider_kind(tokens and index) equals "string":
            set value to provider_value(tokens and index)
            set checked to discord_redact_text_known(value and secrets)
            if not (archive_list_text(checked and 0) equals "ready"):
                set discarded to builder_to_string(builder)
                return checked
            set clean to archive_list_text(checked and 1)
            if index equals sensitive_value and string_length(value) > 0:
                set clean to "[REDACTED]"
            if provider_kind(tokens and index + 1) equals ":":
                if value equals "password" or else value equals "api_key" or else value equals "access_token" or else value equals "auth_token" or else value equals "secret_key":
                    set sensitive_value to index + 2
            if not (clean equals value):
                set item to get_list(tokens and index)
                set start to get_list(item and 1)
                set finish to get_list(item and 2)
                set added to builder_append(builder and substring(body and offset and start - offset))
                set added to builder_append(builder and provider_quote(clean))
                set offset to finish
        set index to index + 1
    set added to builder_append(builder and substring(body and offset and string_length(body) - offset))
    return discord_redaction_result("ready" and ptr_to_str(builder_to_string(builder)))

# Binary files are never rewritten. Block a known credential in any byte range;
# require multipart message metadata to have already passed JSON redaction.
define discord_redaction_multipart_check with pointer as Int and size as Int and token as Str returning Int:
    set secrets to discord_redaction_secrets(token)
    if secrets equals 0 or else pointer equals 0 or else size < 0:
        return 0
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set search to ep_dlsym(system and "memmem")
    if system equals 0 or else search equals 0:
        set closed to ep_dlclose(system)
        return 0
    set valid to 1
    for each secret in secrets:
        set value to ptr_to_str(secret)
        if ep_dlcall4(search and pointer and size and str_to_ptr(value) and string_length(value)) is not equal to 0:
            set valid to 0
    set marker to "name=\"payload_json\""
    set field to ep_dlcall4(search and pointer and size and str_to_ptr(marker) and string_length(marker))
    if field is not equal to 0:
        set start to ep_dlcall4(search and field and size - (field - pointer) and str_to_ptr("\r\n\r\n") and 4)
        if start equals 0:
            set valid to 0
        else:
            set start to start + 4
            set finish to ep_dlcall4(search and start and size - (start - pointer) and str_to_ptr("\r\n--") and 4)
            if finish equals 0:
                set valid to 0
            else:
                set payload to provider_token_slice(ptr_to_str(start) and 0 and finish - start and ep_dlsym(system and "strndup") and ep_dlsym(system and "free"))
                set checked to discord_redact_json(payload and token)
                if not (archive_list_text(checked and 0) equals "ready") or else not (archive_list_text(checked and 1) equals payload):
                    set valid to 0
    set closed to ep_dlclose(system)
    return valid

# Copy a native regoff_t without alignment assumptions or signed shifts.
define discord_redaction_offset with system as Int and pointer as Int returning Int:
    set value to create_list()
    set added to append_list(value and 0)
    set copied to ep_dlcall3(ep_dlsym(system and "memcpy") and get_list_data_ptr(value) and pointer and 8)
    return get_list(value and 0)
