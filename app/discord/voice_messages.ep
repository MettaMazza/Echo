import "voice_mls"
import "../providers/archived_stream"

# Credentials come only from authenticated Gateway voice events. These bodies
# contain secrets and must go directly to the voice socket, never to receipts,
# ordinary logs, model context or tool output.
define discord_voice_credentials_valid with guild as Str and user as Str and session as Str and token as Str returning Int:
    set ids to create_list()
    set ids to [guild,user]
    if discord_dave_users_valid(ids) equals 0 or else string_length(session) < 1 or else string_length(session) > 4096 or else string_length(token) < 1 or else string_length(token) > 16384:
        return 0
    return 1

define discord_voice_identify_body with guild as Str and user as Str and session as Str and token as Str and maximum_version as Int returning Str:
    if discord_voice_credentials_valid(guild and user and session and token) equals 0 or else maximum_version < 1 or else maximum_version > 65535:
        return ""
    set body to concat("{\"op\":0,\"d\":{\"server_id\":" and provider_quote(guild))
    set body to concat(body and concat(",\"user_id\":" and provider_quote(user)))
    set body to concat(body and concat(",\"session_id\":" and provider_quote(session)))
    set body to concat(body and concat(",\"token\":" and provider_quote(token)))
    return concat(body and concat(",\"max_dave_protocol_version\":" and concat(int_to_string(maximum_version) and "}}")))

define discord_voice_resume_body with guild as Str and user as Str and session as Str and token as Str and sequence as Int returning Str:
    if discord_voice_credentials_valid(guild and user and session and token) equals 0 or else sequence < -1 or else sequence > 65535:
        return ""
    set body to concat("{\"op\":7,\"d\":{\"server_id\":" and provider_quote(guild))
    set body to concat(body and concat(",\"session_id\":" and provider_quote(session)))
    set body to concat(body and concat(",\"token\":" and provider_quote(token)))
    return concat(body and concat(",\"seq_ack\":" and concat(int_to_string(sequence) and "}}")))

# This is the client's discovered address, not the server destination. Validate
# numeric syntax with inet_pton, without DNS; private client addresses are valid.
define discord_voice_select_body with address as Str and port as Int returning Str:
    if string_length(address) < 1 or else string_length(address) > 45 or else port < 1 or else port > 65535:
        return ""
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return ""
    set function to ep_dlsym(library and "inet_pton")
    if function equals 0:
        set closed to ep_dlclose(library)
        return ""
    set packed to research_native_words(2)
    set valid to ep_dlcall3(function and 2 and str_to_ptr(address) and get_list_data_ptr(packed))
    if valid is not equal to 1:
        set valid to ep_dlcall3(function and 30 and str_to_ptr(address) and get_list_data_ptr(packed))
    set closed to ep_dlclose(library)
    if valid is not equal to 1:
        return ""
    set body to concat("{\"op\":1,\"d\":{\"protocol\":\"udp\",\"data\":{\"address\":" and provider_quote(address))
    return concat(body and concat(",\"port\":" and concat(int_to_string(port) and ",\"mode\":\"aead_xchacha20_poly1305_rtpsize\"}}}")))

define discord_voice_speaking_body with ssrc as Int and speaking as Int returning Str:
    if ssrc < 1 or else ssrc > 4294967295 or else (speaking is not equal to 0 and also speaking is not equal to 1):
        return ""
    set body to concat("{\"op\":5,\"d\":{\"speaking\":" and int_to_string(speaking))
    return concat(body and concat(",\"delay\":0,\"ssrc\":" and concat(int_to_string(ssrc) and "}}")))

# Only Ready (23) and Invalid Commit/Welcome (31) responses are emitted here.
# Caller sends Ready after successful preparation, not merely receipt of an ID.
define discord_voice_transition_body with opcode as Int and transition as Int returning Str:
    if (opcode is not equal to 23 and also opcode is not equal to 31) or else transition < 0 or else transition > 65535:
        return ""
    set body to concat("{\"op\":" and int_to_string(opcode))
    return concat(body and concat(",\"d\":{\"transition_id\":" and concat(int_to_string(transition) and "}}")))
