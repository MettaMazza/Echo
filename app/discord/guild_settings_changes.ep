import "onboarding_changes"

# Media is specified separately by admitted attachment ID (or null to clear).
# Raw base64, filesystem paths and caller-supplied CDN routes are not settings.
define discord_guild_settings_assets with assets as Str returning Int:
    set fields to provider_json_tokens(assets)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|icon|splash|discovery_splash|banner|home_header|") equals 0:
        return 0
    set keys to create_list()
    set keys to ["icon","splash","discovery_splash","banner","home_header"]
    for each item in keys:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and also not (provider_kind(fields and field) equals "null"):
            if not (provider_kind(fields and field) equals "string") or else string_length(provider_value(fields and field)) equals 0:
                return 0
    return 1

define discord_guild_settings_changes with changes as Str returning Int:
    set fields to provider_json_tokens(changes)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|name|description|region|verification_level|default_message_notifications|explicit_content_filter|preferred_locale|afk_timeout|afk_channel_id|system_channel_id|system_channel_flags|features|rules_channel_id|safety_alerts_channel_id|public_updates_channel_id|premium_progress_bar_enabled|") equals 0:
        return 0
    set field to provider_member(fields and 0 and "name")
    if field >= 0 and also discord_onboarding_text(fields and field and 2 and 100 and 0) equals 0:
        return 0
    if discord_onboarding_text(fields and provider_member(fields and 0 and "description") and 0 and 300 and 1) equals 0:
        return 0
    set field to provider_member(fields and 0 and "region")
    if field >= 0 and also not (provider_kind(fields and field) equals "null" or else provider_kind(fields and field) equals "string"):
        return 0
    set keys to create_list()
    set keys to ["verification_level","default_message_notifications","explicit_content_filter"]
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        set maximum to 4
        if key equals "default_message_notifications":
            set maximum to 1
        else if key equals "explicit_content_filter":
            set maximum to 2
        if field >= 0 and also not (provider_kind(fields and field) equals "null") and also discord_rich_integer(fields and field and 0 and maximum) equals 0:
            return 0
    set field to provider_member(fields and 0 and "preferred_locale")
    if field >= 0 and also not (provider_kind(fields and field) equals "null"):
        set value to provider_value(fields and field)
        set locales to "|ar|bg|cs|da|de|el|en-GB|en-US|es-419|es-ES|fi|fr|he|hi|hr|hu|id|it|ja|ko|lt|nl|no|pl|pt-BR|ro|ru|sv-SE|th|tr|uk|vi|zh-CN|zh-TW|"
        if not (provider_kind(fields and field) equals "string") or else string_length(value) equals 0 or else string_contains(value and "|") equals 1 or else string_contains(locales and concat("|" and concat(value and "|"))) equals 0:
            return 0
    set field to provider_member(fields and 0 and "afk_timeout")
    if field >= 0 and also not (provider_kind(fields and field) equals "null"):
        set value to provider_value(fields and field)
        if not (provider_kind(fields and field) equals "number") or else not (value equals "60" or else value equals "300" or else value equals "900" or else value equals "1800" or else value equals "3600"):
            return 0
    set keys to ["afk_channel_id","system_channel_id","rules_channel_id","safety_alerts_channel_id","public_updates_channel_id"]
    for each item in keys:
        if discord_onboarding_nullable(fields and provider_member(fields and 0 and ptr_to_str(item)) and "snowflake") equals 0:
            return 0
    if discord_onboarding_nullable(fields and provider_member(fields and 0 and "premium_progress_bar_enabled") and "boolean") equals 0:
        return 0
    set field to provider_member(fields and 0 and "system_channel_flags")
    if field >= 0 and also not (provider_kind(fields and field) equals "null"):
        if discord_rich_integer(fields and field and 0 and 2147483647) equals 0:
            return 0
    set features to provider_member(fields and 0 and "features")
    if features < 0 or else provider_kind(fields and features) equals "null":
        return 1
    if not (provider_kind(fields and features) equals "["):
        return 0
    set index to features + 1
    set count to 0
    set seen to create_list()
    repeat while not (provider_kind(fields and index) equals "]"):
        if discord_onboarding_text(fields and index and 0 and 152133 and 1) equals 0:
            return 0
        set kind to provider_kind(fields and index)
        set item_text to provider_value(fields and index)
        set value to concat(kind and concat(":" and item_text))
        if discord_contains(seen and value) equals 1:
            return 0
        set added to append_list(seen and value)
        set count to count + 1
        if count > 1521:
            return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return 1
