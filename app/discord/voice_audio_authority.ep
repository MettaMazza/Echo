import "voice_audio_source"
import "voice_request_guard"

# This guard validates a claimed job's independent playback call. Its positive
# result deliberately is NOT a playback permission: the caller still needs a
# fresh destination/source REST proof. The stored receipt must be the admitted
# playback request event; a model assertion or the join receipt is insufficient.
# Claim layout is produced only by voice_audio_job_claim, never model JSON.
define discord_voice_audio_job_guard with journal as Int and database as Int and intent as Str and claim as List and bot as Str and guilds as List and admins as List and stop_file as Str returning List:
    if claim equals 0 or else length_list(claim) is not equal to 8 or else not (archive_list_text(claim and 0) equals "attempted"):
        return history_status("voice-audio-claim-denied")
    set guarded to discord_voice_request_guard(journal and database and intent and bot and guilds and admins and stop_file)
    if not (archive_list_text(guarded and 0) equals "allowed"):
        return guarded
    set run to archive_list_text(claim and 3)
    set call_id to archive_list_text(claim and 4)
    set actor to archive_list_text(claim and 5)
    set binding to get_list(claim and 7)
    if binding equals 0 or else length_list(binding) is not equal to 7:
        return history_status("voice-audio-binding-denied")
    set values to create_list()
    set retained_voice_added to append_list(values and archive_list_text(claim and 1))
    set retained_voice_added to append_list(values and intent)
    set retained_voice_added to append_list(values and archive_list_text(claim and 2))
    set retained_voice_added to append_list(values and run)
    set retained_voice_added to append_list(values and call_id)
    set retained_voice_added to append_list(values and actor)
    set retained_voice_added to append_list(values and archive_list_text(claim and 6))
    set index to 1
    repeat while index < 7:
        set added to append_list(values and archive_list_text(binding and index))
        set index to index + 1
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT identity FROM discord_voice_audio_jobs WHERE identity=?1 AND intent=?2 AND attempt=?3 AND run=?4 AND call_id=?5 AND actor=?6 AND consent_receipt=?7 AND original=?8 AND derivative=?9 AND pcm_digest=?10 AND pcm_bytes=?11 AND session=?12 AND original_digest=?13 AND state='attempted';" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return history_status("voice-audio-claim-denied")
    if discord_contains(admins and actor) equals 0 or else run_authority_allows(database and run and "admin") equals 0 or else tool_authority_allows(database and run and call_id and "admin") equals 0 or else node_run_status(database and run) is not equal to 1:
        return history_status("voice-audio-authority-denied")
    set keys to create_list()
    set retained_voice_added to append_list(keys and run)
    set retained_voice_added to append_list(keys and call_id)
    set retained_voice_added to append_list(keys and archive_list_text(claim and 6))
    set call to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(e.payload,'$.arguments') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event JOIN echo_runs r ON r.run=t.run WHERE t.run=?1 AND t.call_id=?2 AND e.event=?3 AND e.kind='tool_call' AND json_extract(e.payload,'$.run_id')=?1 AND json_extract(e.payload,'$.call_id')=?2 AND json_extract(e.payload,'$.name')='discord_voice' AND t.state<>'uncertain' AND r.state NOT IN ('failed','cancelled') AND NOT EXISTS(SELECT 1 FROM echo_cancel_requests c WHERE c.run=t.run);" and keys))
    if not (archive_list_text(call and 0) equals "found"):
        return history_status("voice-audio-call-denied")
    set arguments to provider_json_tokens(archive_list_text(call and 1))
    if arguments equals 0 or else provider_unique_objects(arguments) equals 0 or else not (provider_kind(arguments and 0) equals "{"):
        return history_status("voice-audio-call-denied")
    if not (provider_value(arguments and provider_member(arguments and 0 and "operation")) equals "play") or else not (provider_value(arguments and provider_member(arguments and 0 and "intent")) equals intent) or else not (provider_value(arguments and provider_member(arguments and 0 and "attachment")) equals archive_list_text(binding and 1)):
        return history_status("voice-audio-call-denied")
    set source to discord_run_source(journal and database and run)
    set inbox to discord_job_origin(journal and database and run)
    set join_source to get_list(guarded and 1)
    # The current transport proof is for this exact actor and origin channel.
    # Other origins need their own audience proof before this can be relaxed.
    if not (archive_list_text(source and 0) equals "found") or else string_length(inbox) equals 0 or else not (archive_list_text(source and 3) equals actor) or else not (archive_list_text(source and 3) equals archive_list_text(join_source and 3)) or else not (archive_list_text(source and 4) equals archive_list_text(join_source and 4)) or else not (archive_list_text(source and 5) equals archive_list_text(join_source and 5)):
        return history_status("voice-audio-source-denied")
    if discord_run_barrier(journal and inbox and string_to_int(archive_list_text(source and 7)) and archive_list_text(source and 6) and archive_list_text(source and 4) and archive_list_text(source and 5)) is not equal to 0:
        return history_status("voice-audio-source-changed")
    set current to discord_voice_audio_source_current(database and run and actor and binding)
    if not (archive_list_text(current and 0) equals "found"):
        return current
    set result to history_status("voice-audio-native-current")
    set added to append_list(result and source)
    set added to append_list(result and inbox)
    return result
