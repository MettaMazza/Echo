import "speech_delivery"
import "interaction_ack"
import "interaction_recovery"
import "command_execution"
import "question_execution"

define discord_action_worker_schema with journal as Int returning Int:
    if discord_interaction_schema(journal) is not equal to 0 or else discord_message_actions_schema(journal) is not equal to 0:
        return 1
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_action_retry(identity TEXT PRIMARY KEY REFERENCES discord_interaction_jobs(identity),next_ms INTEGER NOT NULL);")

# PATCH the same ephemeral original response: retries cannot create duplicate
# public messages. Never put trace text or source data in this status response.
define discord_action_status with library as Str and token as Str and journal as Int and identity as Str and bot as Str and directory_path as Str and content as Str returning Str:
    set keys to create_list()
    set added to append_list(keys and identity)
    set added to append_list(keys and int_to_string(ep_time_now_ms()))
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT c.credential,json_extract(i.payload,'$.application_id') FROM discord_interaction_credentials c JOIN discord_inbox i ON i.identity=c.identity WHERE c.identity=?1 AND c.expires_ms>CAST(?2 AS INTEGER);" and keys))
    if not (archive_list_text(row and 0) equals "found"):
        return "response-expired"
    if not (archive_list_text(row and 2) equals bot) or else discord_interaction_credential_valid(archive_list_text(row and 1)) equals 0:
        return "response-binding-denied"
    set route to concat("/webhooks/" and concat(bot and concat("/" and concat(archive_list_text(row and 1) and "/messages/@original"))))
    set body to concat("{\"content\":" and concat(provider_quote(content) and ",\"allowed_mentions\":{\"parse\":[]}}"))
    if content equals "speech-control-dismiss":
        set removed to discord_access_body(library and token and journal and directory_path and "DELETE" and route and "DELETE:interaction-original" and identity and "")
        if archive_list_text(removed and 0) equals "http-404":
            return "observed"
        return archive_list_text(removed and 0)
    set result to discord_access_body(library and token and journal and directory_path and "PATCH" and route and "PATCH:interaction-original" and identity and body)
    return archive_list_text(result and 0)

define discord_action_worker_tick with library as Str and token as Str and journal as Int and database as Int and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    return discord_action_worker_tick_scoped(library and token and journal and database and bot and create_list() and admins and directory_path and stop_file)

define discord_action_worker_tick_scoped with library as Str and token as Str and journal as Int and database as Int and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    if discord_action_worker_schema(journal) is not equal to 0:
        return "store-failed"
    set clock to create_list()
    set added to append_list(clock and int_to_string(ep_time_now_ms()))
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT j.identity,i.payload,j.state FROM discord_interaction_jobs j JOIN discord_inbox i ON i.identity=j.identity LEFT JOIN discord_action_retry r ON r.identity=j.identity WHERE j.state IN ('acknowledged','uncertain') AND COALESCE(r.next_ms,0)<=CAST(?1 AS INTEGER) ORDER BY COALESCE(r.next_ms,0),j.received_ms LIMIT 1;" and clock))
    if archive_list_text(row and 0) equals "end":
        return "idle"
    if not (archive_list_text(row and 0) equals "found"):
        return "store-failed"
    set identity to archive_list_text(row and 1)
    set body to archive_list_text(row and 2)
    if archive_list_text(row and 3) equals "uncertain":
        set recovered to discord_interaction_recover(library and token and journal and identity and bot and directory_path)
        if recovered equals "ack-recovered" or else recovered equals "ack-expired" or else recovered equals "store-failed":
            return recovered
        set retry to create_list()
        set added to append_list(retry and identity)
        set added to append_list(retry and int_to_string(ep_time_now_ms() + 30000))
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_action_retry VALUES(?1,CAST(?2 AS INTEGER)) ON CONFLICT(identity) DO UPDATE SET next_ms=excluded.next_ms;" and retry) and 101) is not equal to 0:
            return "store-failed"
        return recovered
    set resolved to discord_message_action_resolve(journal and body and bot and admins)
    set result to archive_list_text(resolved and 0)
    set envelope to provider_json_tokens(body)
    if provider_value(envelope and provider_member(envelope and 0 and "type")) equals "2":
        set result to discord_command_tick(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    else if string_length(provider_value(envelope and provider_member(envelope and provider_member(envelope and 0 and "data") and "custom_id"))) >= 7 and also substring(provider_value(envelope and provider_member(envelope and provider_member(envelope and 0 and "data") and "custom_id")) and 0 and 7) equals "echoqc:":
        set result to discord_question_action_tick(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    else if result equals "bound-needs-live-access":
        if archive_list_text(resolved and 1) equals "speak":
            set result to discord_speech_deliver(library and token and journal and database and identity and body and bot and admins and directory_path and stop_file)
        else:
            set result to discord_trace_action_tick(library and token and journal and database and body and bot and admins and directory_path and stop_file)
    set terminal to ""
    set message to ""
    set delay to 1000
    if result equals "question-draft-saved":
        set terminal to "completed"
        set message to "Answer saved. Choose the remaining answers, then press Submit answers."
    else if result equals "question-draft-superseded":
        set terminal to "completed"
        set message to "A newer answer is already saved; this older click did not replace it."
    else if result equals "question-answered":
        set terminal to "completed"
        set message to "Your answers were submitted to Echo."
    else if result equals "question-answer-not-accepted":
        set terminal to "denied"
        set message to "The complete answer batch could not be accepted. Check that every question has an answer, then submit again."
    else if result equals "question-control-denied" or else result equals "invalid-question-control" or else result equals "question-binding-denied" or else result equals "question-authority-denied" or else result equals "question-no-longer-pending" or else result equals "invalid-question-answer" or else result equals "invalid-question-choice":
        set terminal to "denied"
        set message to "This question control is no longer available for your account or waiting request."
    else if result equals "speech-toggle-complete" or else result equals "speech-coalesced":
        set terminal to "completed"
        set message to "speech-control-dismiss"
    else if result equals "speech-delivered":
        set terminal to "completed"
    else if result equals "autonomy-admitted" or else result equals "autonomy-already-admitted":
        set terminal to "completed"
    else if result equals "export-delivered":
        set terminal to "completed"
    else if result equals "export-verification-failed":
        set terminal to "denied"
        set message to "The archive could not pass provenance verification, so it was not exported. The original conversation is retained."
    else if result equals "export-too-large":
        set terminal to "denied"
        set message to "This verified archive exceeds Discord's attachment limit. It has not been truncated or sent. Smaller-part export is not available yet."
    else if result equals "export-not-authorized":
        set terminal to "denied"
        set message to "That conversation cannot be exported by this account in this channel. Use /history to find your available conversations."
    else if result equals "autonomy-stopped":
        set terminal to "completed"
        set message to "Your Discord autonomy is off. Active work has been asked to stop; saved progress is preserved."
    else if string_index_of(result and "session-history:") equals 0:
        set terminal to "completed"
        set message to substring(result and 16 and string_length(result) - 16)
    else if result equals "session-selected":
        set terminal to "completed"
        set message to "That conversation is active again. Its existing history and memory are retained."
    else if result equals "session-not-authorized" or else result equals "selection-identity-conflict":
        set terminal to "denied"
        set message to "That conversation cannot be selected for this account and channel. Use /history for available conversations."
    else if result equals "new-session-created":
        set terminal to "completed"
        set message to "A new conversation is ready in this channel. Your previous conversations are preserved."
    else if result equals "command-handler-unavailable" or else result equals "session-migration-required":
        set terminal to "denied"
        set message to "This command is not available in the running version yet. No conversation was changed."
    else if result equals "command-not-acknowledged" or else result equals "command-access-denied" or else result equals "invalid-command" or else result equals "command-scope-denied" or else result equals "command-binding-denied" or else result equals "invalid-command-options" or else result equals "audience-not-authorized" or else result equals "principal-unavailable":
        set terminal to "denied"
        set message to "This command cannot be confirmed or executed with the current account and channel authorization."
    else if result equals "caught-up":
        set terminal to "completed"
        set message to "The available reasoning and tool activity for this reply has been delivered to your private messages."
    else if result equals "admin-required" or else result equals "action-binding-denied" or else result equals "run-source-denied" or else result equals "run-authority-revoked" or else result equals "source-access-denied" or else result equals "source-changed" or else result equals "not-trace-action" or else result equals "foreign-application" or else result equals "invalid-component" or else result equals "not-button" or else result equals "invalid-actor-or-message" or else result equals "invalid-guild" or else result equals "final-unavailable" or else result equals "source-unavailable" or else result equals "speech-response-expired" or else result equals "speech-access-changed" or else result equals "attachment-too-large-or-empty" or else result equals "speech:not-configured" or else result equals "speech:invalid-speech-profile" or else result equals "speech:not-authorized" or else result equals "speech-attachment-denied":
        set terminal to "denied"
        set message to "This control is not available for your account or the original message is no longer accessible."
    else if not (result equals "advanced" or else result equals "part-sent" or else result equals "waiting"):
        set delay to 30000
    if terminal equals "denied":
        # Release a denied operation without changing its last confirmed
        # visibility. Other legitimate clicks must not stay locked forever.
        if discord_speech_toggle_schema(journal) is not equal to 0:
            return "store-failed"
        if archive_finish(checkpoint_prepare(journal and "UPDATE discord_speech_visibility SET operation='',settled_ms=CAST(?2 AS INTEGER) WHERE operation=?1;" and [identity,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
            return "store-failed"
    if string_length(terminal) > 0 and not file_exists(stop_file):
        set delivered to "observed"
        if not (result equals "speech-delivered" or else result equals "autonomy-admitted" or else result equals "autonomy-already-admitted" or else result equals "export-delivered"):
            set delivered to discord_action_status(library and token and journal and identity and bot and directory_path and message)
        if delivered equals "observed" or else delivered equals "response-expired":
            set values to create_list()
            set added to append_list(values and identity)
            set added to append_list(values and terminal)
            set added to append_list(values and result)
            if archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state=?2,detail=?3 WHERE identity=?1 AND state='acknowledged';" and values) and 101) is not equal to 0:
                return "store-failed"
            return terminal
        set delay to 30000
    set values to create_list()
    set added to append_list(values and identity)
    set added to append_list(values and int_to_string(ep_time_now_ms() + delay))
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_action_retry VALUES(?1,CAST(?2 AS INTEGER)) ON CONFLICT(identity) DO UPDATE SET next_ms=excluded.next_ms;" and values) and 101) is not equal to 0:
        return "store-failed"
    return result
