import "../lifecycle/maintenance"
import "cancel_button"
import "speech_delivery"
import "interaction_ack"
import "interaction_recovery"
import "command_execution"
import "question_execution"
import "voice_recording_action"

define discord_action_worker_schema with journal as Int returning Int:
    if discord_interaction_schema(journal) is not equal to 0 or else discord_message_actions_schema(journal) is not equal to 0 or else discord_command_schema(journal) is not equal to 0:
        return 1
    return sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_action_retry(identity TEXT PRIMARY KEY REFERENCES discord_interaction_jobs(identity),next_ms INTEGER NOT NULL);")

# PATCH the same ephemeral original response: retries cannot create duplicate
# public messages. Never put trace text or source data in this status response.
define discord_action_status with library as Str and token as Str and journal as Int and identity as Str and bot as Str and directory_path as Str and content as Str returning Str:
    set keys to create_list()
    set added to append_list(keys and identity)
    set added to append_list(keys and int_to_string(ep_time_now_ms()))
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT c.credential,json_extract(i.payload,'$.application_id') FROM discord_interaction_credentials c JOIN discord_inbox i ON i.identity=c.identity WHERE c.identity=?1 AND c.expires_ms>CAST(?2 AS INTEGER);" and keys))
    if not (archive_list_text(row and 0) equals "found"):
        return "response-expired"
    if not (archive_list_text(row and 2) equals bot) or else discord_interaction_credential_valid(archive_list_text(row and 1)) equals 0:
        return "response-binding-denied"
    set route to concat("/webhooks/" and concat(bot and concat("/" and concat(archive_list_text(row and 1) and "/messages/@original"))))
    set body to concat("{\"content\":" and concat(provider_quote(content) and ",\"allowed_mentions\":{\"parse\":[]}}"))
    if content equals "speech-control-dismiss":
        set removed to discord_access_body(library and token and journal and directory_path and "DELETE" and route and "DELETE:interaction-original" and identity and "")
        if archive_list_text(removed and 0) equals "http-404":
            return "observed"
        return archive_list_text(removed and 0)
    set result to discord_access_body(library and token and journal and directory_path and "PATCH" and route and "PATCH:interaction-original" and identity and body)
    return archive_list_text(result and 0)

define discord_action_worker_tick with library as Str and token as Str and journal as Int and database as Int and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    return discord_action_worker_tick_scoped(library and token and journal and database and bot and create_list() and admins and directory_path and stop_file)

define discord_action_worker_tick_scoped with library as Str and token as Str and journal as Int and database as Int and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if echo_maintenance_active():
        return "idle"
    if file_exists(stop_file):
        return "stopped"
    if discord_action_worker_schema(journal) is not equal to 0:
        return "store-failed"
    set clock to create_list()
    set added to append_list(clock and int_to_string(ep_time_now_ms()))
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT j.identity,i.payload,j.state FROM discord_interaction_jobs j JOIN discord_inbox i ON i.identity=j.identity LEFT JOIN discord_action_retry r ON r.identity=j.identity WHERE j.state IN ('acknowledged','uncertain') AND COALESCE(r.next_ms,0)<=CAST(?1 AS INTEGER) ORDER BY COALESCE(r.next_ms,0),j.received_ms LIMIT 1;" and clock))
    if archive_list_text(row and 0) equals "end":
        return "idle"
    if not (archive_list_text(row and 0) equals "found"):
        return "store-failed"
    set identity to archive_list_text(row and 1)
    set body to archive_list_text(row and 2)
    if archive_list_text(row and 3) equals "uncertain":
        set recovered to discord_interaction_recover(library and token and journal and identity and bot and directory_path)
        if recovered equals "ack-recovered" or else recovered equals "ack-expired" or else recovered equals "store-failed":
            return recovered
        set retry to create_list()
        set added to append_list(retry and identity)
        set added to append_list(retry and int_to_string(ep_time_now_ms() + 30000))
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_action_retry VALUES(?1,CAST(?2 AS INTEGER)) ON CONFLICT(identity) DO UPDATE SET next_ms=excluded.next_ms;" and retry) and 101) is not equal to 0:
            return "store-failed"
        return recovered
    set recording_control to discord_voice_recording_control(body)
    # Withdrawing an existing recording consent is a privacy control, never a
    # conversation with Echo. Testing mode must not disable that withdrawal.
    set recording_revoke to archive_list_text(recording_control and 0) equals "recording-control" and also archive_list_text(recording_control and 2) equals "revoke"
    if recording_revoke equals 0 and also discord_testing_inbox_allows(journal and discord_testing_actor(body) and identity) equals 0:
        set delivered to discord_action_status(library and token and journal and identity and bot and directory_path and "Echo is currently unavailable for this account.")
        if delivered equals "observed" or else delivered equals "response-expired":
            if archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='denied',detail='account-unavailable' WHERE identity=?1 AND state='acknowledged';" and [identity]) and 101) is not equal to 0:
                return "store-failed"
            return "denied"
        return delivered
    set resolved to discord_message_action_resolve(journal and body and bot and admins)
    set result to archive_list_text(resolved and 0)
    set envelope to provider_json_tokens(body)
    if provider_value(envelope and provider_member(envelope and 0 and "type")) equals "2":
        set result to discord_command_tick(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    else if archive_list_text(recording_control and 0) equals "recording-control":
        set result to discord_voice_recording_action(library and token and journal and database and identity and bot and guilds and admins and directory_path and stop_file)
    else if string_length(provider_value(envelope and provider_member(envelope and provider_member(envelope and 0 and "data") and "custom_id"))) >= 11 and also substring(provider_value(envelope and provider_member(envelope and provider_member(envelope and 0 and "data") and "custom_id")) and 0 and 11) equals "echocancel:":
        set result to discord_cancel_button_tick(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    else if string_length(provider_value(envelope and provider_member(envelope and provider_member(envelope and 0 and "data") and "custom_id"))) >= 7 and also substring(provider_value(envelope and provider_member(envelope and provider_member(envelope and 0 and "data") and "custom_id")) and 0 and 7) equals "echoqc:":
        set result to discord_question_action_tick(library and token and journal and database and identity and body and bot and guilds and admins and directory_path and stop_file)
    else if result equals "bound-needs-live-access":
        if archive_list_text(resolved and 1) equals "speak":
            set result to discord_speech_deliver(library and token and journal and database and identity and body and bot and admins and directory_path and stop_file)
        else:
            set result to "private-activity-retired"
    set terminal to ""
    set message to ""
    set delay to 1000
    if result equals "recording-consent-granted":
        set terminal to "completed"
        set message to "Your permission for voice transcription is saved for this voice session. You can use Decline / revoke to stop further capture. Leaving or reconnecting requires new consent."
    else if result equals "recording-consent-revoked":
        set terminal to "completed"
        set message to "Your voice transcription permission is withdrawn. Further audio capture is disabled for you; previously retained audio and transcripts are unchanged."
    else if result equals "recording-consent-superseded":
        set terminal to "completed"
        set message to "A newer consent decision is already saved. This older click did not replace it."
    else if result equals "recording-control-denied":
        set terminal to "denied"
        set message to "This recording control could not be verified for your account and current voice session. No new recording permission was granted."
    else if result equals "recording-membership-refresh-required" or else result equals "recording-store-busy":
        set delay to 1000
    else if result equals "testing-enabled" or else result equals "testing-disabled":
        set terminal to "completed"
        set message to "Testing mode is OFF. Normal Discord access is restored."
        if result equals "testing-enabled":
            set message to "Testing mode is ON. Only configured admins can communicate with Echo through Discord."
    else if result equals "queue-cancelled":
        set terminal to "completed"
        set message to "Your queued message was cancelled. Its original text remains saved."
    else if result equals "cancel-requested" or else result equals "already-cancel-requested":
        set terminal to "completed"
        set message to "Cancellation requested for that message. Echo is stopping its work; completed messages remain saved."
    else if result equals "cancel-source-denied":
        set terminal to "denied"
        set message to "You can cancel only your own original messages in this channel. This is an account/source restriction."
    else if result equals "cancel-target-terminal":
        set terminal to "completed"
        set message to "That request has already finished; nothing was cancelled."
    else if result equals "cancel-target-is-steering":
        set terminal to "denied"
        set message to "That message was offered as steering. Cancel its original active request instead."
    else if result equals "retry-requested" or else result equals "retry-already-requested":
        set terminal to "completed"
        set message to "Retry requested for that saved run. Echo will continue from its safe checkpoint; this does not resend the original message or repeat completed tool actions."
    else if result equals "retry-source-denied" or else result equals "retry-run-unavailable" or else result equals "retry-request-conflict":
        set terminal to "denied"
        set message to "That request is not available for your account in this channel. Use your original message, its command anchor or a delivered reply ID."
    else if result equals "run-not-retryable" or else result equals "retry-worker-active":
        set terminal to "denied"
        set message to "That run cannot be retried now. Active, completed or cancelled work and unresolved tool actions are not restarted. Saved results remain available."
    else if result equals "question-draft-saved":
        set terminal to "completed"
        set message to "Answer saved. Choose the remaining answers, then press Submit answers."
    else if result equals "question-draft-superseded":
        set terminal to "completed"
        set message to "A newer answer is already saved; this older click did not replace it."
    else if result equals "question-answered":
        set terminal to "completed"
        set message to "Your answers were submitted to Echo."
    else if result equals "question-answer-not-accepted":
        set terminal to "denied"
        set message to "The complete answer batch could not be accepted. Check that every question has an answer, then submit again."
    else if result equals "question-control-denied" or else result equals "invalid-question-control" or else result equals "question-binding-denied" or else result equals "question-authority-denied" or else result equals "question-no-longer-pending" or else result equals "invalid-question-answer" or else result equals "invalid-question-choice":
        set terminal to "denied"
        set message to "This question control is no longer available for your account or waiting request."
    else if result equals "speech-toggle-complete" or else result equals "speech-coalesced":
        set terminal to "completed"
        set message to "speech-control-dismiss"
    else if result equals "speech-delivered":
        set terminal to "completed"
    else if result equals "autonomy-admitted" or else result equals "autonomy-already-admitted" or else result equals "revision-admitted":
        set terminal to "completed"
    else if result equals "share-delivered":
        set terminal to "completed"
    else if result equals "share-not-authorized":
        set terminal to "denied"
        set message to "That source or destination is not available to your account in this channel. Host and DM records are not shared here."
    else if result equals "share-too-large":
        set terminal to "denied"
        set message to "The complete share receipt exceeds Discord's file limit; it was not truncated. Check the destination before repeating a confirmed copy."
    else if string_index_of(result and "share-rejected:") equals 0:
        set terminal to "denied"
        set message to concat("Share not accepted: " and concat(substring(result and 15 and string_length(result) - 15) and ". Preview the exact source and destination before confirming."))
    else if result equals "hud-delivered":
        set terminal to "completed"
    else if result equals "hud-not-authorized":
        set terminal to "denied"
        set message to "This status section is not available to your account for that conversation. Host and other-channel records cannot be read here; privileged sections require an authorized administrator audience."
    else if result equals "hud-too-large":
        set terminal to "denied"
        set message to "This status snapshot exceeds Discord's file limit. Nothing was truncated or sent."
    else if string_index_of(result and "hud-rejected:") equals 0:
        set terminal to "denied"
        set message to concat("Status could not be read: " and substring(result and 13 and string_length(result) - 13))
    else if result equals "project-delivered":
        set terminal to "completed"
    else if result equals "project-not-authorized":
        set terminal to "denied"
        set message to "This project or conversation is not available to your account in this channel. Use /history for available conversations."
    else if result equals "project-too-large":
        set terminal to "denied"
        set message to "The project response exceeds Discord's file limit. No content was truncated. Saved project changes are retained."
    else if string_index_of(result and "project-rejected:") equals 0:
        set terminal to "denied"
        set message to concat("Project change was not accepted: " and concat(substring(result and 17 and string_length(result) - 17) and ". Read the project for its current revision, then check the fields before retrying."))
    else if result equals "schedule-delivered":
        set terminal to "completed"
    else if result equals "schedule-not-authorized":
        set terminal to "denied"
        set message to "This schedule is not owned by your account in this conversation and channel. Use /schedules list for your schedules."
    else if result equals "schedule-too-large":
        set terminal to "denied"
        set message to "The schedule receipt exceeds Discord's file limit. No content was truncated; saved changes are retained."
    else if string_index_of(result and "schedule-rejected:") equals 0:
        set terminal to "denied"
        set message to concat("Schedule control was not accepted: " and substring(result and 18 and string_length(result) - 18))
    else if result equals "attachment-delivered":
        set terminal to "completed"
    else if result equals "attachment-not-authorized":
        set terminal to "denied"
        set message to "This attachment or conversation is not available to your account in this channel. Use /history for available conversations."
    else if result equals "attachment-too-large":
        set terminal to "denied"
        set message to "The attachment response exceeds Discord's file limit. No content was truncated. Saved attachment changes are retained."
    else if string_index_of(result and "attachment-rejected:") equals 0:
        set terminal to "denied"
        set message to concat("Attachment change was not accepted: " and concat(substring(result and 20 and string_length(result) - 20) and ". List attachments for the matching lifecycle or visibility revision, then check the fields before retrying."))
    else if result equals "export-delivered":
        set terminal to "completed"
    else if result equals "export-verification-failed":
        set terminal to "denied"
        set message to "The archive could not pass provenance verification, so it was not exported. The original conversation is retained."
    else if result equals "export-too-large":
        set terminal to "denied"
        set message to "This verified archive exceeds Discord's attachment limit. It has not been truncated or sent. Smaller-part export is not available yet."
    else if result equals "export-not-authorized":
        set terminal to "denied"
        set message to "That conversation cannot be exported by this account in this channel. Use /history to find your available conversations."
    else if result equals "autonomy-stopped":
        set terminal to "completed"
        set message to "Your Discord autonomy is off. Active work has been asked to stop; saved progress is preserved."
    else if string_index_of(result and "group-control:") equals 0:
        set terminal to "completed"
        set message to substring(result and 14 and string_length(result) - 14)
    else if string_index_of(result and "session-history:") equals 0:
        set terminal to "completed"
        set message to substring(result and 16 and string_length(result) - 16)
    else if result equals "branch-created":
        set terminal to "completed"
        set message to "A branch is ready from that reply. Your next message continues it; the original conversation is preserved."
    else if result equals "branch-source-unavailable":
        set terminal to "denied"
        set message to "That reply cannot be used as a saved branch boundary here. Check its message ID and that its request has finished. Older replies without a saved delivery binding are not eligible yet."
    else if result equals "session-selected":
        set terminal to "completed"
        set message to "That conversation is active again. Its existing history and memory are retained."
    else if result equals "session-not-authorized" or else result equals "selection-identity-conflict":
        set terminal to "denied"
        set message to "That conversation cannot be selected for this account and channel. Use /history for available conversations."
    else if result equals "revision-source-unavailable" or else result equals "revision-source-not-authorized" or else result equals "command-source-denied" or else result equals "invalid-boundary" or else result equals "source-not-authorized":
        set terminal to "denied"
        set message to "You can revise only your own finished request in this channel, with no unresolved tool work. The original remains preserved."
    else if result equals "invalid-replacement" or else result equals "invalid-submission":
        set terminal to "denied"
        set message to "The replacement prompt could not be accepted. No revised inference was started."
    else if result equals "revision-prompt-delivery-failed":
        set terminal to "failed"
        set message to "The replacement prompt could not be delivered. No revised inference was started."
    else if result equals "new-session-created":
        set terminal to "completed"
        set message to "A new conversation is ready in this channel. Your previous conversations are preserved."
    else if result equals "command-handler-unavailable" or else result equals "session-migration-required":
        set terminal to "denied"
        set message to "This command is not available in the running version yet. No conversation was changed."
    else if result equals "command-not-acknowledged" or else result equals "command-access-denied" or else result equals "invalid-command" or else result equals "command-scope-denied" or else result equals "command-binding-denied" or else result equals "invalid-command-options" or else result equals "audience-not-authorized" or else result equals "principal-unavailable":
        set terminal to "denied"
        set message to "This command cannot be confirmed or executed with the current account and channel authorization."
    else if result equals "private-activity-retired":
        set terminal to "completed"
        set message to "This old control has been removed. Reasoning and tool activity remain in the thinking thread attached to the prompting message."
    else if result equals "attachment-too-large-or-empty" or else result equals "speech-attachment-too-large":
        set terminal to "denied"
        set message to "The complete recording exceeds Discord's attachment size limit. Your access is valid; no audio was attached."
    else if string_index_of(result and "speech-encoding:") equals 0:
        set terminal to "denied"
        set message to "Speech was generated, but preparing the audio for Discord failed. No audio was attached."
    else if result equals "admin-required" or else result equals "action-binding-denied" or else result equals "run-source-denied" or else result equals "run-authority-revoked" or else result equals "source-access-denied" or else result equals "source-changed" or else result equals "not-trace-action" or else result equals "foreign-application" or else result equals "invalid-component" or else result equals "not-button" or else result equals "invalid-actor-or-message" or else result equals "invalid-guild" or else result equals "final-unavailable" or else result equals "source-unavailable" or else result equals "speech-response-expired" or else result equals "speech-access-changed" or else result equals "speech:not-configured" or else result equals "speech:invalid-speech-profile" or else result equals "speech:not-authorized" or else result equals "speech-attachment-denied":
        set terminal to "denied"
        set message to "This control is not available for your account or the original message is no longer accessible."
    else if string_length(result) >= 7 and also substring(result and 0 and 7) equals "speech:" and also not (result equals "speech:busy" or else result equals "speech:speech-in-progress-or-interrupted"):
        # A saved synthesis failure is terminal for this click. Re-reading it
        # cannot generate audio; leaving it queued hides failure for 15 minutes.
        set terminal to "denied"
        set message to "Speech generation failed. No audio was attached."
    else if not (result equals "advanced" or else result equals "part-sent" or else result equals "waiting" or else result equals "revision-prompt-pending"):
        set delay to 30000
    if terminal equals "denied":
        # Release a denied operation without changing its last confirmed
        # visibility. Other legitimate clicks must not stay locked forever.
        if discord_speech_toggle_schema(journal) is not equal to 0:
            return "store-failed"
        if archive_finish(checkpoint_prepare(journal and "UPDATE discord_speech_visibility SET operation='',settled_ms=CAST(?2 AS INTEGER) WHERE operation=?1;" and [identity,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
            return "store-failed"
    if string_length(terminal) > 0 and not file_exists(stop_file):
        set delivered to "observed"
        if not (result equals "speech-delivered" or else result equals "autonomy-admitted" or else result equals "autonomy-already-admitted" or else result equals "revision-admitted" or else result equals "export-delivered" or else result equals "project-delivered" or else result equals "share-delivered" or else result equals "hud-delivered" or else result equals "attachment-delivered" or else result equals "schedule-delivered"):
            set delivered to discord_action_status(library and token and journal and identity and bot and directory_path and message)
        if delivered equals "observed" or else delivered equals "response-expired":
            set values to create_list()
            set added to append_list(values and identity)
            set added to append_list(values and terminal)
            set added to append_list(values and result)
            if archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state=?2,detail=?3 WHERE identity=?1 AND state='acknowledged';" and values) and 101) is not equal to 0:
                return "store-failed"
            return terminal
        set delay to 30000
    set values to create_list()
    set added to append_list(values and identity)
    set added to append_list(values and int_to_string(ep_time_now_ms() + delay))
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_action_retry VALUES(?1,CAST(?2 AS INTEGER)) ON CONFLICT(identity) DO UPDATE SET next_ms=excluded.next_ms;" and values) and 101) is not equal to 0:
        return "store-failed"
    return result
