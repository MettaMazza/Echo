import "guild_settings_options"
import "onboarding_view"

# Retain only supported writable settings. Asset hashes describe the current
# image; they are not attachment IDs and cannot be submitted as replacements.
define discord_guild_settings_view with body as Str and guild as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_snowflake(guild) equals 0:
        return ""
    set identity to provider_member(fields and 0 and "id")
    if not (provider_kind(fields and identity) equals "string") or else not (provider_value(fields and identity) equals guild):
        return ""
    set keys to create_list()
    set keys to ["name","description","region","verification_level","default_message_notifications","explicit_content_filter","preferred_locale","afk_timeout","afk_channel_id","system_channel_id","system_channel_flags","features","rules_channel_id","safety_alerts_channel_id","public_updates_channel_id","premium_progress_bar_enabled"]
    set projected to discord_onboarding_fields(body and fields and 0 and keys)
    if string_length(projected) equals 0:
        return ""
    set settings to concat("{" and concat(projected and "}"))
    if discord_guild_settings_changes(settings) equals 0:
        return ""
    set keys to ["icon","splash","discovery_splash","banner","home_header"]
    for each item in keys:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if not (provider_kind(fields and field) equals "null" or else provider_kind(fields and field) equals "string"):
            return ""
    set assets to discord_onboarding_fields(body and fields and 0 and keys)
    if string_length(assets) equals 0:
        return ""
    set output to concat("{\"guild\":" and provider_quote(guild))
    set output to concat(output and concat(",\"settings\":" and settings))
    set output to concat(output and concat(",\"asset_hashes\":{" and assets))
    return concat(output and "}}")
