import "run_source"

# A public command anchor is a bot message, not a user MESSAGE_CREATE. Only a
# complete update equal to the authenticated anchor (optionally HAS_THREAD/nonce) is
# harmless. Partial edits, extra fields, deletions and audience changes cancel.
# No schema writes are permitted here: this also runs on the read-only monitor.
define discord_run_barrier with journal as Int and inbox as Str and cursor as Int and message as Str and room as Str and guild_id as Str returning Int:
    if not (string_index_of(inbox and "interaction:") equals 0):
        return discord_turn_barrier(journal and cursor and message and room and guild_id)
    set cancellation_keys to [inbox]
    set cancellation to history_collect_one(checkpoint_prepare(journal and "SELECT source FROM discord_cancel_sources WHERE source=?1;" and cancellation_keys))
    if archive_list_text(cancellation and 0) equals "found":
        return 1
    if not (archive_list_text(cancellation and 0) equals "end"):
        return -1
    set anchor to discord_command_anchor_read(journal and inbox)
    if not (archive_list_text(anchor and 0) equals "found") or else not (archive_list_text(anchor and 2) equals room) or else not (archive_list_text(anchor and 3) equals guild_id) or else not (archive_list_text(anchor and 4) equals message):
        return 1
    set cursor_text to int_to_string(cursor)
    set values to [cursor_text,message,room,guild_id,inbox]
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT COUNT(*) FROM discord_inbox e WHERE e.rowid>CAST(?1 AS INTEGER) AND ((e.kind IN ('MESSAGE_UPDATE','MESSAGE_DELETE') AND json_extract(e.payload,'$.id')=?2 AND json_extract(e.payload,'$.channel_id')=?3 AND NOT (e.kind='MESSAGE_UPDATE' AND EXISTS(SELECT 1 FROM discord_command_anchors a WHERE a.inbox=?5 AND json_type(a.response_body,'$.flags')='integer' AND json_type(e.payload,'$.flags')='integer' AND json_extract(e.payload,'$.flags') IN (json_extract(a.response_body,'$.flags'),(json_extract(a.response_body,'$.flags')|32)) AND NOT EXISTS(SELECT fullkey,type,atom FROM json_tree(a.response_body) WHERE fullkey NOT IN ('$.flags','$.nonce') EXCEPT SELECT fullkey,type,atom FROM json_tree(e.payload) WHERE fullkey NOT IN ('$.flags','$.nonce')) AND NOT EXISTS(SELECT fullkey,type,atom FROM json_tree(e.payload) WHERE fullkey NOT IN ('$.flags','$.nonce') EXCEPT SELECT fullkey,type,atom FROM json_tree(a.response_body) WHERE fullkey NOT IN ('$.flags','$.nonce'))))) OR (e.kind='MESSAGE_DELETE_BULK' AND json_extract(e.payload,'$.channel_id')=?3 AND EXISTS(SELECT 1 FROM json_each(e.payload,'$.ids') WHERE value=?2)) OR (e.identity LIKE 'audience:%' AND ?4<>'' AND json_extract(e.payload,'$.guild_id')=?4 AND (e.kind NOT IN ('THREAD_UPDATE','THREAD_DELETE') OR json_type(e.payload,'$.thread_id') IS NULL OR json_extract(e.payload,'$.thread_id')=?3)));" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return -1
    if not (archive_list_text(row and 1) equals "0"):
        return 1
    return 0
