import "invite_options"
import "role_guard"

# Channel-bound responses are projected rather than exposing inviter profiles,
# targeted-recipient lists or unrelated guild metadata in public tool traces.
define discord_invite_matches with fields as List and item as Int and guild as Str and room as Str returning Int:
    if not (provider_kind(fields and item) equals "{"):
        return 0
    set code to provider_value(fields and provider_member(fields and item and "code"))
    set channel_body to provider_member(fields and item and "channel")
    if discord_invite_code_valid(code) equals 0 or else not (provider_value(fields and provider_member(fields and channel_body and "id")) equals room):
        return 0
    set server to provider_member(fields and item and "guild")
    if server >= 0 and not (provider_value(fields and provider_member(fields and server and "id")) equals guild):
        return 0
    return 1

define discord_invite_project with body as Str and fields as List and item as Int and guild as Str and room as Str returning Str:
    if discord_invite_matches(fields and item and guild and room) equals 0:
        return ""
    set result to concat("{\"code\":" and provider_quote(provider_value(fields and provider_member(fields and item and "code"))))
    set result to concat(result and concat(",\"guild\":" and provider_quote(guild)))
    set result to concat(result and concat(",\"channel\":" and provider_quote(room)))
    set keys to create_list()
    set added to append_list(keys and "max_age")
    set added to append_list(keys and "max_uses")
    set added to append_list(keys and "uses")
    set added to append_list(keys and "temporary")
    set added to append_list(keys and "created_at")
    set added to append_list(keys and "expires_at")
    for each key_pointer in keys:
        set key to ptr_to_str(key_pointer)
        set field to provider_member(fields and item and key)
        if field >= 0:
            set result to concat(result and concat("," and concat(provider_quote(key) and concat(":" and agent_json_source(body and fields and field)))))
    return concat(result and "}")

define discord_invite_list_view with body as Str and guild as Str and room as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "["):
        return ""
    set items to provider_items(fields and 0)
    return discord_invite_list_items(body and fields and items and guild and room)

define discord_invite_list_items with body as Str and fields as List and items as List and guild as Str and room as Str returning Str:
    set result to "["
    set count to 0
    set seen to create_list()
    for each item in items:
        set projected to discord_invite_project(body and fields and item and guild and room)
        set code to provider_value(fields and provider_member(fields and item and "code"))
        if string_length(projected) equals 0 or else discord_contains(seen and code) equals 1:
            return ""
        set added to append_list(seen and code)
        if count > 0:
            set result to concat(result and ",")
        set result to concat(result and projected)
        set count to count + 1
    return concat(result and "]")
