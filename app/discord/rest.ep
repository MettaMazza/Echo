import "secret_redaction"
import "audit_reason"
import "socket"
import "routing"

# Host-only transport. This is not a model tool: scoped controllers construct
# routes and recheck their authority before invoking it. Credentials go only to
# the fixed Discord API origin, never redirects, proxy configuration or logs.
# Caller supplies exclusive private output descriptors. This function owns them.
define discord_rest_transfer with library_path as Str and token as Str and method as Str and route as Str and body as Str and output_fd as Int and headers_fd as Int returning List:
    return discord_rest_transfer_timed(library_path and token and method and route and body and output_fd and headers_fd and 20000 and 60000)

# Interaction acknowledgements use their shorter protocol deadline. Ordinary
# REST callers retain the existing connect and total timeouts above.
define discord_rest_transfer_timed with library_path as Str and token as Str and method as Str and route as Str and body as Str and output_fd as Int and headers_fd as Int and connect_ms as Int and total_ms as Int returning List:
    return discord_rest_transfer_bytes(library_path and token and method and route and str_to_ptr(body) and string_length(body) and "application/json" and output_fd and headers_fd and connect_ms and total_ms)

# Host-owned binary payload; caller keeps it alive through this synchronous
# transfer. Same fixed-origin, no-redirect and TLS controls as JSON requests.
define discord_rest_transfer_bytes with library_path as Str and token as Str and method as Str and route as Str and body_pointer as Int and body_size as Int and content_type as Str and output_fd as Int and headers_fd as Int and connect_ms as Int and total_ms as Int returning List:
    return discord_rest_transfer_bytes_audit(library_path and token and method and route and body_pointer and body_size and content_type and output_fd and headers_fd and connect_ms and total_ms and "")

define discord_rest_transfer_bytes_audit with library_path as Str and token as Str and method as Str and route as Str and body_pointer as Int and body_size as Int and content_type as Str and output_fd as Int and headers_fd as Int and connect_ms as Int and total_ms as Int and audit_reason as Str returning List:
    set entered_ms to ep_time_now_ms()
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set library to discord_library_open(library_path)
    if system equals 0 or else library equals 0:
        set closed to net_close(output_fd)
        set closed to net_close(headers_fd)
        set rooted_literal_1 to create_list()
        set retained_value_added to append_list(rooted_literal_1 and "platform-unavailable")
        set retained_value_added to append_list(rooted_literal_1 and "0")
        set retained_value_added to append_list(rooted_literal_1 and "-1")
        return rooted_literal_1
    # Final egress gate: also covers edits, callbacks and direct tool sends.
    # Authorization headers/routes remain host-owned and are not rewritten.
    set safe_body to ""
    set safe to 1
    if body_size > 0:
        if body_pointer equals 0:
            set safe to 0
        else if content_type equals "application/json":
            set original_body to provider_token_slice(ptr_to_str(body_pointer) and 0 and body_size and ep_dlsym(system and "strndup") and ep_dlsym(system and "free"))
            set checked to discord_redact_json(original_body and token)
            if not (archive_list_text(checked and 0) equals "ready"):
                set safe to 0
            else:
                set safe_body to archive_list_text(checked and 1)
                set body_pointer to str_to_ptr(safe_body)
                set body_size to string_length(safe_body)
        else if string_index_of(content_type and "multipart/form-data;") equals 0:
            set safe to discord_redaction_multipart_check(body_pointer and body_size and token)
        else:
            set safe to 0
    if string_length(audit_reason) > 0:
        set reason_checked to discord_redact_text(audit_reason)
        if not (archive_list_text(reason_checked and 0) equals "ready"):
            set safe to 0
        else:
            set audit_reason to archive_list_text(reason_checked and 1)
    if safe equals 0:
        set closed to net_close(output_fd)
        set closed to net_close(headers_fd)
        set closed to ep_dlclose(library)
        set closed to ep_dlclose(system)
        set denied to create_list()
        set added to append_list(denied and "secret-check-failed")
        set added to append_list(denied and "0")
        set added to append_list(denied and "-1")
        return denied
    set output to ep_dlcall2(ep_dlsym(system and "fdopen") and output_fd and str_to_ptr("wb"))
    set header_output to ep_dlcall2(ep_dlsym(system and "fdopen") and headers_fd and str_to_ptr("wb"))
    set easy to ep_dlcall0(ep_dlsym(library and "curl_easy_init"))
    set valid to 1
    set setup_error to "unknown"
    if connect_ms < 1 or else total_ms < 1 or else body_size < 0 or else (body_size > 0 and body_pointer equals 0):
        set valid to 0
        set setup_error to "deadline"
    if not (method equals "GET" or else method equals "POST" or else method equals "PATCH" or else method equals "PUT" or else method equals "DELETE"):
        set valid to 0
        set setup_error to "method"
    if string_index_of(route and "/") is not equal to 0 or else string_index_of(route and "//") equals 0 or else string_contains(route and "..") is not equal to 0 or else string_contains(route and "#") is not equal to 0:
        set valid to 0
        set setup_error to "route"
    set rooted_literal_2 to create_list()
    set retained_value_added to append_list(rooted_literal_2 and token)
    set retained_value_added to append_list(rooted_literal_2 and route)
    for each value in rooted_literal_2:
        set text to ptr_to_str(value)
        set position to 0
        repeat while position < string_length(text):
            set code to peek_byte(str_to_ptr(text) and position)
            if code < 33 or else code > 126:
                set valid to 0
                set setup_error to "credential-or-route-format"
            set position to position + 1
    if string_length(token) < 20 or else output equals 0 or else header_output equals 0 or else easy equals 0:
        set valid to 0
        set setup_error to "credential-length-or-stream-or-handle"
    if string_length(content_type) equals 0 or else string_contains(content_type and "\r") is not equal to 0 or else string_contains(content_type and "\n") is not equal to 0:
        set valid to 0
        set setup_error to "content-type"
    set audit_header to ""
    if string_length(audit_reason) > 0:
        set audit_header to discord_audit_reason(audit_reason)
        if string_length(audit_header) equals 0:
            set valid to 0
            set setup_error to "audit-reason"
    set request_headers to 0
    set status to "setup-failed"
    set code to -1
    set response to "0"
    set timing to "{}"
    if valid equals 1:
        set retained_values_1 to create_list()
        set retained_value_added to append_list(retained_values_1 and concat("Authorization: Bot " and token))
        # An absent body has no media type. Discord's emoji DELETE endpoint
        # rejects an empty body labelled application/json with error 50109.
        # Keep the caller's media type for actual JSON or multipart bytes.
        if body_size > 0:
            set retained_value_added to append_list(retained_values_1 and concat("Content-Type: " and content_type))
        set retained_value_added to append_list(retained_values_1 and "Accept: application/json")
        if string_length(audit_header) > 0:
            set retained_value_added to append_list(retained_values_1 and audit_header)
        for each header in retained_values_1:
            set request_headers to ep_dlcall2(ep_dlsym(library and "curl_slist_append") and request_headers and str_to_ptr(ptr_to_str(header)))
        if request_headers equals 0:
            set valid to 0
            set setup_error to "headers"
        set retained_values_2 to create_list()
        set retained_values_3 to create_list()
        set retained_value_added to append_list(retained_values_3 and "10002")
        set retained_value_added to append_list(retained_values_3 and concat("https://discord.com/api/v10" and route))
        set retained_value_added to append_list(retained_values_2 and retained_values_3)
        set retained_values_4 to create_list()
        set retained_value_added to append_list(retained_values_4 and "10004")
        set retained_value_added to append_list(retained_values_4 and "")
        set retained_value_added to append_list(retained_values_2 and retained_values_4)
        set retained_values_5 to create_list()
        set retained_value_added to append_list(retained_values_5 and "10177")
        set retained_value_added to append_list(retained_values_5 and "*")
        set retained_value_added to append_list(retained_values_2 and retained_values_5)
        set retained_values_6 to create_list()
        set retained_value_added to append_list(retained_values_6 and "10318")
        set retained_value_added to append_list(retained_values_6 and "https")
        set retained_value_added to append_list(retained_values_2 and retained_values_6)
        set retained_values_7 to create_list()
        set retained_value_added to append_list(retained_values_7 and "10018")
        set retained_value_added to append_list(retained_values_7 and "DiscordBot (https://github.com/MettaMazza/Echo, 1.75)")
        set retained_value_added to append_list(retained_values_2 and retained_values_7)
        set retained_values_8 to create_list()
        set retained_value_added to append_list(retained_values_8 and "10036")
        set retained_value_added to append_list(retained_values_8 and method)
        set retained_value_added to append_list(retained_values_2 and retained_values_8)
        for each pair in retained_values_2:
            if network_curl_call(library and "curl_easy_setopt" and easy and string_to_int(archive_list_text(pair and 0)) and str_to_ptr(archive_list_text(pair and 1)) and 1) is not equal to 0:
                set valid to 0
                set setup_error to "string-option"
        set retained_values_9 to create_list()
        set retained_values_10 to create_list()
        set retained_value_added to append_list(retained_values_10 and 10001)
        set retained_value_added to append_list(retained_values_10 and output)
        set retained_value_added to append_list(retained_values_9 and retained_values_10)
        set retained_values_11 to create_list()
        set retained_value_added to append_list(retained_values_11 and 10029)
        set retained_value_added to append_list(retained_values_11 and header_output)
        set retained_value_added to append_list(retained_values_9 and retained_values_11)
        set retained_values_12 to create_list()
        set retained_value_added to append_list(retained_values_12 and 10023)
        set retained_value_added to append_list(retained_values_12 and request_headers)
        set retained_value_added to append_list(retained_values_9 and retained_values_12)
        for each pair in retained_values_9:
            if network_curl_call(library and "curl_easy_setopt" and easy and get_list(pair and 0) and get_list(pair and 1) and 1) is not equal to 0:
                set valid to 0
                set setup_error to "pointer-option"
        set retained_values_13 to create_list()
        set retained_values_14 to create_list()
        set retained_value_added to append_list(retained_values_14 and 52)
        set retained_value_added to append_list(retained_values_14 and 0)
        set retained_value_added to append_list(retained_values_13 and retained_values_14)
        set retained_values_15 to create_list()
        set retained_value_added to append_list(retained_values_15 and 64)
        set retained_value_added to append_list(retained_values_15 and 1)
        set retained_value_added to append_list(retained_values_13 and retained_values_15)
        set retained_values_16 to create_list()
        set retained_value_added to append_list(retained_values_16 and 81)
        set retained_value_added to append_list(retained_values_16 and 2)
        set retained_value_added to append_list(retained_values_13 and retained_values_16)
        set retained_values_17 to create_list()
        set retained_value_added to append_list(retained_values_17 and 99)
        set retained_value_added to append_list(retained_values_17 and 1)
        set retained_value_added to append_list(retained_values_13 and retained_values_17)
        set retained_values_18 to create_list()
        set retained_value_added to append_list(retained_values_18 and 156)
        set retained_value_added to append_list(retained_values_18 and connect_ms)
        set retained_value_added to append_list(retained_values_13 and retained_values_18)
        set retained_values_19 to create_list()
        set retained_value_added to append_list(retained_values_19 and 155)
        set retained_value_added to append_list(retained_values_19 and total_ms)
        set retained_value_added to append_list(retained_values_13 and retained_values_19)
        for each pair in retained_values_13:
            if network_curl_call(library and "curl_easy_setopt" and easy and get_list(pair and 0) and get_list(pair and 1) and 0) is not equal to 0:
                set valid to 0
                set setup_error to "integer-option"
        if body_size > 0:
            if network_curl_call(library and "curl_easy_setopt" and easy and 10015 and body_pointer and 1) is not equal to 0 or else network_curl_call(library and "curl_easy_setopt" and easy and 60 and body_size and 0) is not equal to 0:
                set valid to 0
                set setup_error to "body-option"
        if valid equals 1:
            set setup_ms to ep_time_now_ms() - entered_ms
            set code to ep_dlcall1(ep_dlsym(library and "curl_easy_perform") and easy)
            set timing to discord_rest_timing(library and easy and setup_ms)
            set response to network_curl_info(library and easy and 2097154)
            set status to "transfer-failed"
            if code equals 0:
                set status to "complete"
    if status equals "setup-failed":
        set status to concat("setup-failed-" and setup_error)
    if easy is not equal to 0:
        set cleaned to ep_dlcall1(ep_dlsym(library and "curl_easy_cleanup") and easy)
    if request_headers is not equal to 0:
        set cleaned to ep_dlcall1(ep_dlsym(library and "curl_slist_free_all") and request_headers)
    set rooted_literal_3 to create_list()
    set retained_value_added to append_list(rooted_literal_3 and output)
    set retained_value_added to append_list(rooted_literal_3 and header_output)
    for each stream in rooted_literal_3:
        if stream is not equal to 0:
            if ep_dlcall1(ep_dlsym(system and "fflush") and stream) is not equal to 0:
                set status to "flush-failed"
            set fd to ep_dlcall1(ep_dlsym(system and "fileno") and stream)
            if ep_dlcall1(ep_dlsym(system and "fsync") and fd) is not equal to 0:
                set status to "flush-failed"
            if ep_dlcall1(ep_dlsym(system and "fclose") and stream) is not equal to 0:
                set status to "close-failed"
    if output equals 0:
        set closed to net_close(output_fd)
    if header_output equals 0:
        set closed to net_close(headers_fd)
    set closed to ep_dlclose(library)
    set closed to ep_dlclose(system)
    set retained_values_20 to create_list()
    set retained_value_added to append_list(retained_values_20 and status)
    set retained_value_added to append_list(retained_values_20 and response)
    set retained_value_added to append_list(retained_values_20 and int_to_string(code))
    set retained_value_added to append_list(retained_values_20 and timing)
    return retained_values_20

# curl_off_t is signed 64-bit on the supported Darwin ABI. These counters
# contain durations only, never credential-bearing URLs, headers or payloads.
define discord_rest_timing with library as Int and easy as Int and setup_ms as Int returning Str:
    set setup_text to int_to_string(setup_ms)
    set result to concat("{\"setup_ms\":" and setup_text)
    set names to ["total_us","dns_us","connect_us","first_byte_us","tls_us"]
    set options to [6291506,6291507,6291508,6291510,6291512]
    set index to 0
    repeat while index < length_list(names):
        set value to [0]
        set option to get_list(options and index)
        if network_curl_call(library and "curl_easy_getinfo" and easy and option and get_list_data_ptr(value) and 1) equals 0:
            # Keep each allocated string rooted across native observer threads
            # and JSON helpers, which may reach a collection safepoint.
            set name to archive_list_text(names and index)
            set quoted_name to provider_quote(name)
            set amount to int_to_string(get_list(value and 0))
            set result to concat(result and ",")
            set result to concat(result and quoted_name)
            set result to concat(result and ":")
            set result to concat(result and amount)
        set index to index + 1
    return concat(result and "}")
