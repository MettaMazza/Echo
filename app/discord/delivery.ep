import "receipt_spool"
import "store"
import "gateway_owner"
import "string"

define discord_delivery_schema with database as Int returning Int:
    return sql_execute(database and "CREATE TABLE IF NOT EXISTS discord_rate_routes(route TEXT NOT NULL,major TEXT NOT NULL,bucket TEXT NOT NULL,PRIMARY KEY(route,major)); CREATE TABLE IF NOT EXISTS discord_rate_deadlines(bucket TEXT PRIMARY KEY,until_ms INTEGER NOT NULL);")

# curl may retain interim HTTP blocks. Only the final block is authoritative.
define discord_response_header with headers as Str and name as Str returning Str:
    # Scan the retained input directly: the runtime string_split implementation
    # can collect its own in-progress list before returning it to a caller.
    set found to ""
    set offset to 0
    set size to string_length(headers)
    repeat while offset < size:
        set ending to offset
        repeat while ending < size and char_at(headers and ending) is not equal to 10:
            set ending to ending + 1
        set text to string_trim(substring(headers and offset and ending - offset))
        set offset to ending + 1
        if string_index_of(text and "HTTP/") equals 0:
            set found to ""
        else:
            set colon to string_index_of(text and ":")
            if colon > 0:
                if ptr_to_str(string_to_lower(substring(text and 0 and colon))) equals name:
                    set value to string_trim(substring(text and colon + 1 and string_length(text) - colon - 1))
                    if string_length(found) > 0 and not (found equals value):
                        return "!conflicting-header"
                    set found to value
    return found

define discord_rate_deadline with database as Int and route as Str and major as Str returning Int:
    set rooted_literal_1 to create_list()
    set retained_value_added to append_list(rooted_literal_1 and route)
    set retained_value_added to append_list(rooted_literal_1 and major)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT COALESCE(MAX(until_ms),0) FROM discord_rate_deadlines WHERE bucket='global' OR bucket=json_array(?1,?2) OR bucket=(SELECT bucket FROM discord_rate_routes WHERE route=?1 AND major=?2);" and rooted_literal_1))
    if not (archive_list_text(row and 0) equals "found"):
        return -1
    return string_to_int(archive_list_text(row and 1))

# Response-derived buckets include the major resource, so unrelated channels
# are not merged. Shared routes reuse their advertised bucket identity.
define discord_rate_observe with database as Int and route as Str and major as Str and status as Str and headers as Str and body as Str and now as Int returning Str:
    set bucket to discord_response_header(headers and "x-ratelimit-bucket")
    set remaining to discord_response_header(headers and "x-ratelimit-remaining")
    set reset to discord_response_header(headers and "x-ratelimit-reset-after")
    set global_header to discord_response_header(headers and "x-ratelimit-global")
    set global to global_header equals "true"
    set seconds to 0
    if bucket equals "!conflicting-header" or else remaining equals "!conflicting-header" or else global_header equals "!conflicting-header":
        return "invalid-rate-headers"
    if remaining equals "0":
        set seconds to discord_retry_seconds(reset)
        if seconds < 0:
            return "invalid-rate-reset"
    if status equals "429":
        set tokens to provider_json_tokens(body)
        if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
            return "invalid-rate-response"
        set retry to discord_retry_seconds(provider_value(tokens and provider_member(tokens and 0 and "retry_after")))
        set retry_header to discord_response_header(headers and "retry-after")
        if string_length(retry_header) > 0:
            set header_seconds to discord_retry_seconds(retry_header)
            if header_seconds < 0:
                return "invalid-retry-header"
            if header_seconds > retry:
                set retry to header_seconds
        if retry < 0:
            return "invalid-retry-after"
        if retry > seconds:
            set seconds to retry
        if provider_value(tokens and provider_member(tokens and 0 and "global")) equals "true":
            set global to 1
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-unavailable"
    set rooted_literal_2 to create_list()
    set retained_value_added to append_list(rooted_literal_2 and route)
    set retained_value_added to append_list(rooted_literal_2 and major)
    set key_row to history_collect_one(checkpoint_prepare(database and "SELECT json_array(?1,?2);" and rooted_literal_2))
    if not (archive_list_text(key_row and 0) equals "found"):
        return migration_fail(database and "bucket-read-failed")
    set key to archive_list_text(key_row and 1)
    if string_length(bucket) > 0:
        set rooted_literal_3 to create_list()
        set retained_value_added to append_list(rooted_literal_3 and bucket)
        set retained_value_added to append_list(rooted_literal_3 and major)
        set key_row to history_collect_one(checkpoint_prepare(database and "SELECT json_array(?1,?2);" and rooted_literal_3))
        if not (archive_list_text(key_row and 0) equals "found"):
            return migration_fail(database and "bucket-read-failed")
        set key to archive_list_text(key_row and 1)
        set rooted_literal_4 to create_list()
        set retained_value_added to append_list(rooted_literal_4 and route)
        set retained_value_added to append_list(rooted_literal_4 and major)
        set retained_value_added to append_list(rooted_literal_4 and key)
        if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_rate_routes VALUES(?,?,?) ON CONFLICT(route,major) DO UPDATE SET bucket=excluded.bucket;" and rooted_literal_4) and 101) is not equal to 0:
            return migration_fail(database and "bucket-write-failed")
    if global equals 1:
        set key to "global"
    if seconds > 0:
        set retained_values_1 to create_list()
        set retained_value_added to append_list(retained_values_1 and key)
        set retained_value_added to append_list(retained_values_1 and int_to_string(now + seconds * 1000))
        if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_rate_deadlines VALUES(?,CAST(? AS INTEGER)) ON CONFLICT(bucket) DO UPDATE SET until_ms=MAX(discord_rate_deadlines.until_ms,excluded.until_ms);" and retained_values_1) and 101) is not equal to 0:
            return migration_fail(database and "deadline-write-failed")
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "commit-failed")
    return "recorded"

define discord_delivery_body with body as Str and nonce as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{") or else provider_member(tokens and 0 and "nonce") >= 0 or else provider_member(tokens and 0 and "enforce_nonce") >= 0:
        return ""
    set clean to string_trim(body)
    set prefix to substring(clean and 0 and string_length(clean) - 1)
    if not (string_trim(prefix) equals "{"):
        set prefix to concat(prefix and ",")
    return concat(prefix and concat("\"nonce\":" and concat(provider_quote(nonce) and ",\"enforce_nonce\":true}")))

# Only authenticated Discord API/Gateway results reach this verifier.
define discord_delivery_message with database as Int and identity as Str and body as Str returning Str:
    set rooted_literal_5 to create_list()
    set retained_value_added to append_list(rooted_literal_5 and identity)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT o.channel,o.nonce,i.bot FROM discord_outbox o CROSS JOIN discord_identity i WHERE o.identity=?;" and rooted_literal_5))
    set tokens to provider_json_tokens(body)
    if not (archive_list_text(row and 0) equals "found") or else tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set message to provider_value(tokens and provider_member(tokens and 0 and "id"))
    set author to provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "author") and "id"))
    if discord_snowflake(message) equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "channel_id")) equals archive_list_text(row and 1)) or else not (provider_value(tokens and provider_member(tokens and 0 and "nonce")) equals archive_list_text(row and 2)) or else not (author equals archive_list_text(row and 3)):
        return ""
    return message

# A verified observation can resolve either a lost response or a crash after
# send intent. No observation/no match leaves it uncertain, never requeued.
define discord_delivery_reconcile with database as Int and identity as Str and body as Str returning Str:
    set message to discord_delivery_message(database and identity and body)
    if string_length(message) equals 0:
        return "not-proven"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-unavailable"
    set rooted_literal_6 to create_list()
    set retained_value_added to append_list(rooted_literal_6 and identity)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT state,attempt,message FROM discord_outbox WHERE identity=?;" and rooted_literal_6))
    if archive_list_text(row and 1) equals "sent":
        if archive_list_text(row and 3) equals message:
            return migration_fail(database and "already-reconciled")
        return migration_fail(database and "message-conflict")
    if not (archive_list_text(row and 1) equals "sending" or else archive_list_text(row and 1) equals "uncertain"):
        return migration_fail(database and "not-uncertain")
    set rooted_literal_7 to create_list()
    set retained_value_added to append_list(rooted_literal_7 and identity)
    set retained_value_added to append_list(rooted_literal_7 and message)
    if archive_finish(checkpoint_prepare(database and "UPDATE discord_outbox SET state='sent',message=?2 WHERE identity=?1;" and rooted_literal_7) and 101) is not equal to 0:
        return migration_fail(database and "result-write-failed")
    set retained_values_2 to create_list()
    set retained_value_added to append_list(retained_values_2 and identity)
    set retained_value_added to append_list(retained_values_2 and archive_list_text(row and 2))
    set retained_value_added to append_list(retained_values_2 and concat("authenticated-message-sha256:" and ep_sha256(body)))
    set retained_value_added to append_list(retained_values_2 and int_to_string(ep_time_now_ms()))
    if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_delivery_events(identity,attempt,state,detail,observed_ms) VALUES(?,?,'sent',?,CAST(? AS INTEGER));" and retained_values_2) and 101) is not equal to 0:
        return migration_fail(database and "receipt-failed")
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "commit-failed")
    return "reconciled"

# HTTP429 proves this request was not accepted. Only that known failure may
# return to pending; server-derived cooldown must already be persisted.
define discord_delivery_rate_retry with database as Int and identity as Str and attempt as Str returning Str:
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "writer-unavailable"
    set rooted_literal_8 to create_list()
    set retained_value_added to append_list(rooted_literal_8 and identity)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT state,attempt FROM discord_outbox WHERE identity=?;" and rooted_literal_8))
    if not (archive_list_text(row and 1) equals "sending") or else not (archive_list_text(row and 2) equals attempt):
        return migration_fail(database and "stale-attempt")
    set rooted_literal_9 to create_list()
    set retained_value_added to append_list(rooted_literal_9 and identity)
    if archive_finish(checkpoint_prepare(database and "UPDATE discord_outbox SET state='pending',attempt='' WHERE identity=?;" and rooted_literal_9) and 101) is not equal to 0:
        return migration_fail(database and "requeue-failed")
    set retained_values_3 to create_list()
    set retained_value_added to append_list(retained_values_3 and identity)
    set retained_value_added to append_list(retained_values_3 and attempt)
    set retained_value_added to append_list(retained_values_3 and int_to_string(ep_time_now_ms()))
    if archive_finish(checkpoint_prepare(database and "INSERT INTO discord_delivery_events(identity,attempt,state,detail,observed_ms) VALUES(?,?,'pending','HTTP429: no message accepted; cooldown persisted',CAST(? AS INTEGER));" and retained_values_3) and 101) is not equal to 0:
        return migration_fail(database and "receipt-failed")
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "commit-failed")
    return "retry-scheduled"

# Host-only single attempt. The scoped delivery controller must recheck the
# requester and destination's current audience before calling. Never expose
# token, raw route or journal selection to a model tool.
define discord_delivery_send with library_path as Str and token as Str and database as Int and identity as Str and directory_path as Str returning Str:
    return discord_delivery_send_prepared(library_path and token and database and identity and directory_path and 0 and 0 and "" and "")

# Optional frozen multipart bytes must bind the exact nonce-bearing JSON claimed
# from the immutable outbox. No retries or reconciliation semantics are changed.
define discord_delivery_send_prepared with library_path as Str and token as Str and database as Int and identity as Str and directory_path as Str and pointer as Int and size as Int and media as Str and expected as Str returning Str:
    return discord_delivery_send_policy(library_path and token and database and identity and directory_path and pointer and size and media and expected and 0)

# Quiet is a host delivery policy, evaluated at send time for existing backlog.
define discord_delivery_send_policy with library_path as Str and token as Str and database as Int and identity as Str and directory_path as Str and pointer as Int and size as Int and media as Str and expected as Str and quiet as Int returning Str:
    set rooted_literal_10 to create_list()
    set retained_value_added to append_list(rooted_literal_10 and identity)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT channel FROM discord_outbox WHERE identity=?;" and rooted_literal_10))
    if not (archive_list_text(row and 0) equals "found"):
        return "delivery-unavailable"
    set room to archive_list_text(row and 1)
    set deadline to discord_rate_deadline(database and "POST:messages" and room)
    if deadline < 0:
        return "rate-state-unavailable"
    if deadline > ep_time_now_ms():
        return "rate-limited"
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and directory_path)
    if directory < 0:
        set closed to ep_dlclose(system)
        return "private-output-unavailable"
    set attempt to ptr_to_str(ep_uuid_v4())
    set receipt_name to discord_receipt_name(system and directory and attempt)
    set filename to concat(receipt_name and ".json")
    set headerfile to concat(receipt_name and ".headers")
    set output to -1
    if string_length(receipt_name) > 0:
        set output to workspace_file_open(system and directory and filename and 1)
    set headers to workspace_file_open(system and directory and headerfile and 1)
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    if output < 0 or else headers < 0:
        if output >= 0:
            set closed to net_close(output)
        if headers >= 0:
            set closed to net_close(headers)
        return "private-output-unavailable"
    set claim to discord_outbox_claim(database and identity and attempt)
    if not (archive_list_text(claim and 0) equals "claimed"):
        set closed to net_close(output)
        set closed to net_close(headers)
        return archive_list_text(claim and 0)
    set request to discord_delivery_body(archive_list_text(claim and 2) and archive_list_text(claim and 3))
    if string_length(request) equals 0:
        set closed to net_close(output)
        set closed to net_close(headers)
        return discord_outbox_finish(database and identity and attempt and "rejected" and "" and "Invalid adapter payload; no HTTP request made")
    if pointer is not equal to 0 and not (ep_sha256(request) equals expected):
        set closed to net_close(output)
        set closed to net_close(headers)
        return discord_outbox_finish(database and identity and attempt and "rejected" and "" and "Frozen payload mismatch; no HTTP request made")
    if quiet equals 1:
        if pointer is not equal to 0:
            set closed to net_close(output)
            set closed to net_close(headers)
            return discord_outbox_finish(database and identity and attempt and "rejected" and "" and "Quiet delivery requires native JSON; no HTTP request made")
        set request to discord_delivery_quiet_body(database and request)
        if string_length(request) equals 0 or else archive_finish(checkpoint_prepare(database and "INSERT INTO discord_delivery_events(identity,attempt,state,detail,observed_ms) VALUES(?1,?2,'sending',?3,CAST(?4 AS INTEGER));" and [identity,attempt,concat("notification-policy:suppressed; request-sha256:" and ep_sha256(request)),int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
            set closed to net_close(output)
            set closed to net_close(headers)
            return discord_outbox_finish(database and identity and attempt and "rejected" and "" and "Quiet policy receipt failed; no HTTP request made")
    set result to create_list()
    if pointer equals 0:
        set result to discord_rest_transfer(library_path and token and "POST" and concat("/channels/" and concat(room and "/messages")) and request and output and headers)
    else:
        set result to discord_rest_transfer_bytes(library_path and token and "POST" and concat("/channels/" and concat(room and "/messages")) and pointer and size and media and output and headers and 20000 and 60000)
    set detail to concat("private-response:" and filename)
    if not (archive_list_text(result and 0) equals "complete"):
        return discord_outbox_finish(database and identity and attempt and "uncertain" and "" and concat(detail and "; transfer outcome unknown"))
    set response_file to read_file(concat(directory_path and concat("/" and filename)))
    set header_file to read_file(concat(directory_path and concat("/" and headerfile)))
    if response_file equals 0 or else header_file equals 0:
        return discord_outbox_finish(database and identity and attempt and "uncertain" and "" and concat(detail and "; retained response unreadable"))
    set body to ptr_to_str(response_file)
    set status to archive_list_text(result and 1)
    set rate to discord_rate_observe(database and "POST:messages" and room and status and ptr_to_str(header_file) and body and ep_time_now_ms())
    if not (rate equals "recorded"):
        set recorded to discord_outbox_finish(database and identity and attempt and "uncertain" and "" and concat(detail and concat("; " and rate)))
        return "rate-response-unresolved"
    if status equals "429":
        return discord_delivery_rate_retry(database and identity and attempt)
    if status equals "200" or else status equals "201":
        set message to discord_delivery_message(database and identity and body)
        if string_length(message) > 0:
            return discord_outbox_finish(database and identity and attempt and "sent" and message and concat(detail and concat("; sha256:" and ep_sha256(body))))
    if status equals "400" or else status equals "401" or else status equals "403" or else status equals "404":
        return discord_outbox_finish(database and identity and attempt and "rejected" and "" and concat(detail and concat("; HTTP" and status)))
    return discord_outbox_finish(database and identity and attempt and "uncertain" and "" and concat(detail and concat("; HTTP" and status)))

# Shared authenticated access buckets. This is scheduling only, never a grant
# to skip the caller's fresh permission, source or uncertain-effect checks.
define discord_scope_retry_due with journal as Int and room as Str and guild as Str and include_send as Int and now as Int returning Int:
    if discord_delivery_schema(journal) is not equal to 0:
        return -1
    set next to now + 1000
    set routes to ["GET:channel","GET/channel/message","GET:thread-member"]
    if include_send is not equal to 0:
        set added to append_list(routes and "POST:messages")
    for each route in routes:
        set deadline to discord_rate_deadline(journal and ptr_to_str(route) and room)
        if deadline < 0:
            return -1
        if deadline > next:
            set next to deadline
    if string_length(guild) > 0:
        for each route in ["GET:guild","GET:roles","GET:member"]:
            set deadline to discord_rate_deadline(journal and ptr_to_str(route) and guild)
            if deadline < 0:
                return -1
            if deadline > next:
                set next to deadline
    return next

# Discord SUPPRESS_NOTIFICATIONS (4096) silences push/desktop notifications.
# Preserve all existing flags, content, allowed mentions and nonce binding.
define discord_delivery_quiet_body with database as Int and request as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_set(?1,'$.flags',COALESCE(json_extract(?1,'$.flags'),0)|4096) WHERE json_valid(?1) AND json_type(?1)='object' AND (json_type(?1,'$.flags') IS NULL OR json_type(?1,'$.flags')='integer');" and [request]))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    return archive_list_text(row and 1)
