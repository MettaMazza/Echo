import "worker_store"
import "run_barrier"
import "dm_redirect"

# Activity uses its own audience checks and worker. It must not occupy the
# conversation sender's oldest-pending slot or acquire its retry clock.
define discord_reply_due with journal as Int and now as Int returning List:
    set values to create_list()
    set added to append_list(values and int_to_string(now))
    return history_collect_one(checkpoint_prepare(journal and "SELECT o.identity FROM discord_outbox o JOIN discord_inbox origin ON origin.identity=o.inbox LEFT JOIN discord_delivery_retry_clock c ON c.identity=o.identity WHERE o.state='pending' AND substr(o.identity,1,10)<>'tool-post:' AND substr(o.identity,1,14)<>'activity-page:' AND substr(o.identity,1,13)<>'queue-status:' AND substr(o.identity,1,14)<>'question-page:' AND COALESCE(c.next_ms,0)<=CAST(? AS INTEGER) AND NOT EXISTS(SELECT 1 FROM discord_outbox prior JOIN discord_inbox source ON source.identity=prior.inbox WHERE prior.rowid<o.rowid AND prior.channel=o.channel AND prior.state IN ('pending','sending','uncertain') AND substr(prior.identity,1,10)<>'tool-post:' AND substr(prior.identity,1,14)<>'activity-page:' AND substr(prior.identity,1,13)<>'queue-status:' AND substr(prior.identity,1,14)<>'question-page:' AND COALESCE(json_extract(source.payload,'$.author.id'),json_extract(source.payload,'$.author_id'),json_extract(source.payload,'$.member.user.id'),json_extract(source.payload,'$.user.id'),'')=COALESCE(json_extract(origin.payload,'$.author.id'),json_extract(origin.payload,'$.author_id'),json_extract(origin.payload,'$.member.user.id'),json_extract(origin.payload,'$.user.id'),'')) ORDER BY o.rowid LIMIT 1;" and values))

# A durable pending intent is not an evergreen permission grant. Every actual
# POST rechecks the original request and both users' current channel access.
define discord_worker_deliver with library as Str and token as Str and journal as Int and identity as Str and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    if string_index_of(identity and "tool-post:") equals 0:
        return "separate-tool-controller"
    if string_index_of(identity and "activity-page:") equals 0 or else string_index_of(identity and "queue-status:") equals 0 or else string_index_of(identity and "question-page:") equals 0:
        return "separate-activity-worker"
    set rooted_literal_1 to create_list()
    set retained_value_added to append_list(rooted_literal_1 and identity)
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT i.payload,o.channel,COALESCE(j.cursor,i.rowid),i.identity FROM discord_outbox o JOIN discord_inbox i ON i.identity=o.inbox LEFT JOIN discord_agent_jobs j ON j.inbox=i.identity WHERE o.identity=? AND o.state='pending' AND (((i.identity LIKE 'message:create:%' OR i.identity LIKE 'message:redirect:%') AND j.inbox IS NOT NULL) OR i.kind='INTERACTION_CREATE');" and rooted_literal_1))
    if not (archive_list_text(row and 0) equals "found"):
        return "not-pending"
    set original to archive_list_text(row and 1)
    set parsed to provider_json_tokens(original)
    set room to provider_value(parsed and provider_member(parsed and 0 and "channel_id"))
    if string_index_of(archive_list_text(row and 4) and "message:redirect:") equals 0:
        set recipient to provider_value(parsed and provider_member(parsed and 0 and "author_id"))
        set allowed to discord_redirect_check(library and token and journal and directory_path and bot and room and recipient and admins)
        if not (allowed equals "allowed") or else file_exists(stop_file):
            return concat("redirect:" and allowed)
        return discord_delivery_send(library and token and journal and identity and directory_path)
    set inbox to archive_list_text(row and 4)
    set source to discord_intake_source(journal and inbox)
    if not (archive_list_text(source and 0) equals "found"):
        return "source-unavailable"
    set user to archive_list_text(source and 3)
    set room to archive_list_text(source and 4)
    set guild_id to archive_list_text(source and 5)
    set message to archive_list_text(source and 6)
    set cursor to http_decimal(archive_list_text(row and 3))
    if archive_list_text(source and 1) equals "INTERACTION_CREATE" and discord_command_source_allows(journal and source and bot and admins) equals 0:
        return "command-source-denied"
    if discord_run_barrier(journal and inbox and cursor and message and room and guild_id) is not equal to 0:
        return "delivery-invalidated"
    if not (room equals archive_list_text(row and 2)) or else file_exists(stop_file):
        return "delivery-stopped"
    set access to discord_access_check(library and token and journal and directory_path and bot and guild_id and room and user and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return concat("access:" and archive_list_text(access and 0))
    set fresh to discord_run_source_check(library and token and journal and directory_path and inbox and source)
    if not (fresh equals "current"):
        return fresh
    if file_exists(stop_file) or else discord_run_barrier(journal and inbox and cursor and message and room and guild_id) is not equal to 0:
        return "delivery-stopped"
    return discord_delivery_send(library and token and journal and identity and directory_path)

# Gateway observations are authenticated by the connection owner. Reconcile
# by bot/channel/nonce before considering another model turn or delivery.
define discord_worker_reconcile with journal as Int returning Int:
    set row to history_collect_one(archive_prepare(journal and "SELECT o.identity,i.payload FROM discord_outbox o JOIN discord_inbox i ON i.identity LIKE 'delivery:observed:%' AND json_extract(i.payload,'$.nonce')=o.nonce AND json_extract(i.payload,'$.channel_id')=o.channel WHERE o.state IN ('sending','uncertain') ORDER BY i.rowid LIMIT 1;"))
    if archive_list_text(row and 0) equals "end":
        return 0
    if not (archive_list_text(row and 0) equals "found"):
        return 1
    set result to discord_delivery_reconcile(journal and archive_list_text(row and 1) and archive_list_text(row and 2))
    if not (result equals "reconciled" or else result equals "already-reconciled"):
        return 1
    return 0

# Discord's authenticated rate deadlines determine throttle waits. Do not add
# an unconditional thirty seconds to a subsecond server cooldown. This only
# schedules pending delivery; sending/uncertain intents still need reconciliation.
define discord_reply_reschedule with journal as Int and identity as Str and outcome as Str and now as Int returning Int:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT o.channel,COALESCE(json_extract(i.payload,'$.guild_id'),'') FROM discord_outbox o JOIN discord_inbox i ON i.identity=o.inbox WHERE o.identity=?1 AND o.state='pending';" and [identity]))
    if archive_list_text(row and 0) equals "end":
        return 0
    if not (archive_list_text(row and 0) equals "found"):
        return 1
    if outcome equals "delivery-invalidated" or else outcome equals "source-changed" or else outcome equals "http-404":
        return discord_reply_withdraw(journal and identity and outcome and now)
    set next to now + 30000
    if outcome equals "rate-limited" or else outcome equals "retry-scheduled" or else outcome equals "access:rate-limited" or else outcome equals "access:http-429" or else outcome equals "http-429":
        set next to discord_scope_retry_due(journal and archive_list_text(row and 1) and archive_list_text(row and 2) and 1 and now)
        if next < 0:
            return 1
    return archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_delivery_retry_clock VALUES(?1,CAST(?2 AS INTEGER)) ON CONFLICT(identity) DO UPDATE SET next_ms=excluded.next_ms;" and [identity,int_to_string(next)]) and 101)

# Only a host-confirmed invalidation before POST may withdraw a pending reply.
# One transaction records the withdrawal; a crash cannot turn it into an
# uncertain send. Retain original intent, nonce and every earlier receipt.
define discord_reply_withdraw with journal as Int and identity as Str and reason as Str and now as Int returning Int:
    if not (reason equals "delivery-invalidated" or else reason equals "source-changed" or else reason equals "http-404"):
        return 1
    if sql_execute(journal and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT state,attempt FROM discord_outbox WHERE identity=?1;" and [identity]))
    if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 1) equals "pending"):
        set rolled to sql_execute(journal and "ROLLBACK;")
        return rolled
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_outbox SET state='rejected' WHERE identity=?1 AND state='pending';" and [identity]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_delivery_events(identity,attempt,state,detail,observed_ms) VALUES(?1,?2,'rejected',?3,CAST(?4 AS INTEGER));" and [identity,archive_list_text(row and 2),concat("host withdrew before POST: " and reason),int_to_string(now)]) and 101) is not equal to 0:
        set rolled to sql_execute(journal and "ROLLBACK;")
        return 1
    return sql_execute(journal and "COMMIT;")
