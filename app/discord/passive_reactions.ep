import "final_binding"

# Only confirmed Echo final chunks qualify. These observations never enter
# message admission or queue steering and never confer actor authority.
define discord_passive_reaction with journal as Int and bot as Str and original as Str and guilds as List and admins as List returning Str:
    set tokens to provider_json_tokens(original)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set message to provider_value(tokens and provider_member(tokens and 0 and "message_id"))
    set actor to provider_value(tokens and provider_member(tokens and 0 and "user_id"))
    if discord_snowflake(actor) equals 0 or else actor equals bot:
        return ""
    set final to discord_final_lookup(journal and message and room)
    if not (archive_list_text(final and 0) equals "found"):
        return ""
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT COALESCE(json_extract(i.payload,'$.guild_id'),''),COALESCE(json_extract(i.payload,'$.author.id'),json_extract(i.payload,'$.member.user.id'),json_extract(i.payload,'$.user.id'),'') FROM discord_outbox o JOIN discord_inbox i ON i.identity=o.inbox WHERE o.message=?1 AND o.channel=?2 AND o.state='sent';" and [message,room]))
    if not (archive_list_text(source and 0) equals "found"):
        return ""
    set guild to provider_value(tokens and provider_member(tokens and 0 and "guild_id"))
    if provider_kind(tokens and provider_member(tokens and 0 and "guild_id")) equals "null":
        set guild to ""
    if not (guild equals archive_list_text(source and 1)):
        return ""
    if string_length(guild) > 0:
        if discord_contains(guilds and guild) equals 0:
            return ""
    else if not (actor equals archive_list_text(source and 2)) or else discord_contains(admins and actor) equals 0:
        return ""
    set emoji to provider_member(tokens and 0 and "emoji")
    set name to provider_value(tokens and provider_member(tokens and emoji and "name"))
    set custom to provider_value(tokens and provider_member(tokens and emoji and "id"))
    if provider_kind(tokens and provider_member(tokens and emoji and "id")) equals "null":
        set custom to ""
    if string_length(name) equals 0 or else string_length(name) > 128 or else (string_length(custom) > 0 and discord_snowflake(custom) equals 0):
        return ""
    set member to provider_member(tokens and 0 and "member")
    set user to provider_member(tokens and member and "user")
    set label to ""
    if provider_value(tokens and provider_member(tokens and user and "id")) equals actor:
        set label to discord_passive_label(tokens and provider_member(tokens and member and "nick"))
        if string_length(label) equals 0:
            set label to discord_passive_label(tokens and provider_member(tokens and user and "global_name"))
        if string_length(label) equals 0:
            set label to discord_passive_label(tokens and provider_member(tokens and user and "username"))
    set result to concat("{\"channel_id\":" and provider_quote(room))
    set result to concat(result and concat(",\"guild_id\":" and provider_quote(guild)))
    set result to concat(result and concat(",\"message_id\":" and provider_quote(message)))
    set result to concat(result and concat(",\"user_id\":" and provider_quote(actor)))
    set result to concat(result and concat(",\"display_name\":" and provider_quote(label)))
    set result to concat(result and concat(",\"emoji_name\":" and provider_quote(name)))
    set result to concat(result and concat(",\"emoji_id\":" and provider_quote(custom)))
    set result to concat(result and concat(",\"target_run\":" and provider_quote(archive_list_text(final and 1))))
    return concat(result and concat(",\"target_final_event\":" and concat(provider_quote(archive_list_text(final and 2)) and "}")))

define discord_passive_label with tokens as List and field as Int returning Str:
    if not (provider_kind(tokens and field) equals "string"):
        return ""
    set text to provider_value(tokens and field)
    if string_length(text) > 256:
        return ""
    return text
