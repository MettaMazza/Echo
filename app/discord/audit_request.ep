import "audit_options"

# A DM has no originating guild. Require an explicit configured guild, while
# keeping the pagination parser independent of transport configuration.
define discord_audit_request with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|guild|limit|before|after|user_id|action_type|") equals 0:
        return history_status("invalid-audit-arguments")
    set field to provider_member(fields and 0 and "guild")
    set guild to provider_value(fields and field)
    if not (provider_kind(fields and field) equals "string") or else discord_snowflake(guild) equals 0:
        return history_status("audit-guild-required")
    set keys to create_list()
    set keys to ["limit","before","after","user_id","action_type"]
    set filters to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            if count > 0:
                set filters to concat(filters and ",")
            set filters to concat(filters and concat(provider_quote(key) and concat(":" and agent_json_source(arguments and fields and field))))
            set count to count + 1
    set filters to concat(filters and "}")
    set parsed to discord_audit_options(filters)
    if not (archive_list_text(parsed and 0) equals "valid"):
        return parsed
    return ["valid",guild,filters]
