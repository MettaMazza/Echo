import "onboarding_options"

# Project only writable settings. Response emoji objects become their explicit
# request fields, so an inspected configuration can be restored without copying
# profiles or unknown response metadata into a later request.
define discord_onboarding_fields with body as Str and fields as List and object as Int and keys as List returning Str:
    set output to ""
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and object and key)
        if field < 0:
            return ""
        if count > 0:
            set output to concat(output and ",")
        set output to concat(output and concat(provider_quote(key) and concat(":" and agent_json_source(body and fields and field))))
        set count to count + 1
    return output

define discord_onboarding_option_view with body as Str and fields as List and object as Int returning Str:
    set keys to create_list()
    set keys to ["id","title","description","role_ids","channel_ids"]
    set projected to discord_onboarding_fields(body and fields and object and keys)
    if string_length(projected) equals 0:
        return ""
    set identity to provider_member(fields and object and "id")
    if not (provider_kind(fields and identity) equals "string") or else discord_snowflake(provider_value(fields and identity)) equals 0:
        return ""
    set emoji to provider_member(fields and object and "emoji")
    if not (provider_kind(fields and emoji) equals "{"):
        return ""
    set keys to ["id","name","animated"]
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and emoji and key)
        if field < 0:
            return ""
        set projected to concat(projected and concat("," and concat(provider_quote(concat("emoji_" and key)) and concat(":" and agent_json_source(body and fields and field)))))
    return concat("{" and concat(projected and "}"))

define discord_onboarding_prompt_view with body as Str and fields as List and object as Int returning Str:
    set keys to create_list()
    set keys to ["id","title","single_select","required","in_onboarding","type"]
    set projected to discord_onboarding_fields(body and fields and object and keys)
    if string_length(projected) equals 0:
        return ""
    set options to provider_member(fields and object and "options")
    if not (provider_kind(fields and options) equals "["):
        return ""
    set projected to concat("{" and concat(projected and ",\"options\":["))
    set index to options + 1
    set count to 0
    repeat while not (provider_kind(fields and index) equals "]"):
        set value to discord_onboarding_option_view(body and fields and index)
        if string_length(value) equals 0:
            return ""
        if count > 0:
            set projected to concat(projected and ",")
        set projected to concat(projected and value)
        set count to count + 1
        set index to provider_after(fields and index)
        if index < 0:
            return ""
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return concat(projected and "]}")

define discord_onboarding_view with body as Str and guild as Str returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "{") or else discord_snowflake(guild) equals 0:
        return ""
    set identity to provider_member(fields and 0 and "guild_id")
    if not (provider_kind(fields and identity) equals "string") or else not (provider_value(fields and identity) equals guild):
        return ""
    set keys to create_list()
    set keys to ["enabled","mode","default_channel_ids"]
    set projected to discord_onboarding_fields(body and fields and 0 and keys)
    if string_length(projected) equals 0:
        return ""
    set prompts to provider_member(fields and 0 and "prompts")
    if not (provider_kind(fields and prompts) equals "["):
        return ""
    set projected to concat("{" and concat(projected and ",\"prompts\":["))
    set index to prompts + 1
    set count to 0
    repeat while not (provider_kind(fields and index) equals "]"):
        set value to discord_onboarding_prompt_view(body and fields and index)
        if string_length(value) equals 0:
            return ""
        if count > 0:
            set projected to concat(projected and ",")
        set projected to concat(projected and value)
        set count to count + 1
        set index to provider_after(fields and index)
        if index < 0:
            return ""
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    set projected to concat(projected and "]}")
    if discord_onboarding_changes(projected) equals 0:
        return ""
    return projected
