import "member_observation"
import "automod_view"

# The administrator's grant and the bot's role permissions remain independent.
# Configuring a timeout action additionally needs MODERATE_MEMBERS; listing,
# inspecting or deleting the rule does not itself configure that action.
define discord_automod_bundle_allowed with bundle as List and guild as Str and actor as Str and bot as Str and candidate as Str and mutation as Int returning Int:
    if not (archive_list_text(bundle and 0) equals "observed") or else discord_member_bundle_valid(bundle and guild and actor and bot and actor and 0) equals 0:
        return 0
    set server to archive_list_text(bundle and 1)
    set roles to archive_list_text(bundle and 2)
    set requester to archive_list_text(bundle and 3)
    set bot_member to archive_list_text(bundle and 4)
    if discord_member_guild_permission(server and roles and requester and guild and actor and 5) is not equal to 1 or else discord_member_guild_permission(server and roles and bot_member and guild and bot and 5) is not equal to 1:
        return 0
    if mutation equals 0:
        return 1
    if mutation is not equal to 1:
        return 0
    set fields to provider_json_tokens(candidate)
    if fields equals 0 or else provider_unique_objects(fields) equals 0:
        return 0
    set actions to provider_member(fields and 0 and "actions")
    if actions < 0 or else provider_kind(fields and actions) equals "null":
        return 1
    if not (provider_kind(fields and actions) equals "["):
        return 0
    set index to actions + 1
    repeat while not (provider_kind(fields and index) equals "]"):
        if provider_value(fields and provider_member(fields and index and "type")) equals "3":
            if discord_member_guild_permission(server and roles and requester and guild and actor and 40) is not equal to 1 or else discord_member_guild_permission(server and roles and bot_member and guild and bot and 40) is not equal to 1:
                return 0
        set index to provider_after(fields and index)
        if index < 0:
            return 0
        if provider_kind(fields and index) equals ",":
            set index to index + 1
    return 1

# A private DM has no source guild. Check the explicit target guild separately:
# permission or visibility events arriving during this call invalidate the action.
# A conservative guild-wide barrier also covers referenced exemption/alert rooms.
define discord_automod_target_current with journal as Int and guild as Str and cursor as Int returning Int:
    if discord_snowflake(guild) equals 0 or else cursor < 0:
        return 0
    set values to create_list()
    set values to [int_to_string(cursor),guild]
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT COUNT(*) FROM discord_inbox WHERE rowid>CAST(?1 AS INTEGER) AND identity LIKE 'audience:%' AND json_extract(payload,'$.guild_id')=?2;" and values))
    return archive_list_text(row and 0) equals "found" and also archive_list_text(row and 1) equals "0"
