import "guild_settings_changes"
import "post_file"
import "../archive/file_base64"

# Freeze the exact original bytes of admitted, included attachments. The body
# owns its encoded bytes; no later REST operation reopens a model-supplied path.
define discord_guild_settings_upload with database as Int and run as Str and actor as Str and changes as Str and assets as Str returning List:
    if discord_guild_settings_changes(changes) equals 0 or else discord_guild_settings_assets(assets) equals 0:
        return history_status("invalid-guild-settings-fields")
    set fields to provider_json_tokens(assets)
    set keys to create_list()
    set keys to ["icon","splash","discovery_splash","banner","home_header"]
    set bindings to create_list()
    set output to string_trim(changes)
    set output to substring(output and 0 and string_length(output) - 1)
    set change_fields to provider_json_tokens(changes)
    set count to 0
    if not (provider_kind(change_fields and 1) equals "}"):
        set count to 1
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            set value to "null"
            if not (provider_kind(fields and field) equals "null"):
                set attachment to provider_value(fields and field)
                set file to discord_post_file_source(database and run and actor and attachment)
                if not (archive_list_text(file and 0) equals "found"):
                    return file
                set media to archive_list_text(file and 3)
                if not (media equals "image/png" or else media equals "image/jpeg" or else media equals "image/gif" or else media equals "image/webp" or else media equals "image/avif"):
                    return history_status("guild-settings-image-type-unsupported")
                set size to http_decimal(archive_list_text(file and 5))
                if size < 1:
                    return history_status("guild-settings-image-empty")
                set encoded to file_base64_verified(archive_list_text(file and 1) and archive_list_text(file and 4) and size and 262144)
                if not (archive_list_text(encoded and 0) equals "verified"):
                    return encoded
                set uri to concat("data:" and media)
                set uri to concat(uri and ";base64,")
                set uri to concat(uri and archive_list_text(encoded and 1))
                set value to provider_quote(uri)
                set binding to create_list()
                set binding to [key,attachment,file]
                set added to append_list(bindings and binding)
            if count > 0:
                set output to concat(output and ",")
            set output to concat(output and provider_quote(key))
            set output to concat(output and ":")
            set output to concat(output and value)
            set count to count + 1
    set output to concat(output and "}")
    return ["ready",output,bindings]

# Immediately before commit, revalidate eligibility and immutable metadata.
# The request still sends the previously hash-verified frozen byte buffer.
define discord_guild_settings_upload_current with database as Int and run as Str and actor as Str and prepared as List returning Int:
    if not (archive_list_text(prepared and 0) equals "ready"):
        return 0
    set bindings to create_list()
    set bindings to get_list(prepared and 2)
    for each item in bindings:
        set binding to create_list()
        set binding to item
        set file to discord_post_file_source(database and run and actor and archive_list_text(binding and 1))
        set original to get_list(binding and 2)
        if not (archive_list_text(file and 0) equals "found"):
            return 0
        set index to 1
        repeat while index < 7:
            if not (archive_list_text(file and index) equals archive_list_text(original and index)):
                return 0
            set index to index + 1
    return 1
