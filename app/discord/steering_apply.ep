import "steering_store"
import "run_barrier"
import "../web/cancellation"
import "steering_media"

# The transport must recheck both source messages and current channel access
# before calling this host operation. No checkmark is emitted until both
# archives confirm the exact guidance event. Replay repairs the journal after
# an archive commit; it never duplicates guidance or ordinary dequeue.
define discord_steering_apply with journal as Int and database as Int and source as Str and run as Str and actor as Str returning Str:
    # Serialize recovery and application across the two databases. The journal
    # lock is acquired first by both paths; a released source cannot gain late guidance.
    if sql_execute(journal and "BEGIN IMMEDIATE;") is not equal to 0:
        return "journal-reconciliation-required"
    set intent to history_collect_one(checkpoint_prepare(journal and "SELECT s.target,s.actor,s.source_digest,s.identity,i.payload,j.state FROM discord_steering_intents s JOIN discord_inbox i ON i.identity=s.source JOIN discord_agent_jobs j ON j.inbox=s.source WHERE s.source=?1;" and [source]))
    if not (archive_list_text(intent and 0) equals "found") or else not (archive_list_text(intent and 2) equals actor) or else not (discord_job_origin(journal and database and run) equals archive_list_text(intent and 1)):
        return migration_fail(journal and "steering-binding-denied")
    if not (archive_list_text(intent and 6) equals "steering-reserved" or else archive_list_text(intent and 6) equals "steered"):
        return migration_fail(journal and "steering-binding-denied")
    # Intake revisions cannot interleave this check and the guidance commit:
    # the journal writer is held until both archive and journal are reconciled.
    for each inbox in [source,archive_list_text(intent and 1)]:
        set origin to discord_intake_source(journal and ptr_to_str(inbox))
        if not (archive_list_text(origin and 0) equals "found"):
            return migration_fail(journal and "steering-source-invalidated")
        if discord_run_barrier(journal and ptr_to_str(inbox) and string_to_int(archive_list_text(origin and 7)) and archive_list_text(origin and 6) and archive_list_text(origin and 4) and archive_list_text(origin and 5)) is not equal to 0:
            return migration_fail(journal and "steering-source-invalidated")
    set body to archive_list_text(intent and 5)
    if not (ep_sha256(body) equals archive_list_text(intent and 3)):
        return migration_fail(journal and "source-digest-mismatch")
    set tokens to provider_json_tokens(body)
    set message to provider_value(tokens and provider_member(tokens and 0 and "content"))
    set state to agent_run_read(database and run)
    set selection to discord_steering_media_selection(database and archive_list_text(state and 0) and body)
    if not (archive_list_text(selection and 0) equals "selected"):
        return migration_fail(journal and archive_list_text(selection and 0))
    set attachments to get_list(selection and 1)
    if string_length(message) equals 0 and length_list(attachments) equals 0:
        return migration_fail(journal and "empty-steering")
    set device to concat("discord:" and actor)
    set identity to archive_list_text(intent and 4)
    set event to concat(run and concat(":guidance:" and identity))
    if web_guidance_files_environment(database and device and run and identity and message and attachments and "") is not equal to 0:
        return migration_fail(journal and "guidance-not-accepted")
    set saved to archive_read_event(database and event)
    if saved equals 0 or else not (archive_list_text(saved and 2) equals "guidance_received"):
        return migration_fail(journal and "guidance-receipt-unavailable")
    set current to history_collect_one(checkpoint_prepare(journal and "SELECT state,detail FROM discord_agent_jobs WHERE inbox=?1;" and [source]))
    if archive_list_text(current and 1) equals "steered" and archive_list_text(current and 2) equals event:
        return migration_fail(journal and "already-steered")
    if not (archive_list_text(current and 1) equals "steering-reserved"):
        return migration_fail(journal and "steering-state-conflict")
    set now to int_to_string(ep_time_now_ms())
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_agent_jobs SET state='steered',detail=?2,updated_ms=CAST(?3 AS INTEGER) WHERE inbox=?1 AND state='steering-reserved';" and [source,event,now]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_agent_job_events(inbox,state,detail,observed_ms) VALUES(?1,'steered',?2,CAST(?3 AS INTEGER));" and [source,event,now]) and 101) is not equal to 0:
        return migration_fail(journal and "journal-reconciliation-required")
    if sql_execute(journal and "COMMIT;") is not equal to 0:
        return "journal-reconciliation-required"
    return "steered"
