import "scheduled_event_options"

# Build the effective state solely for validation; send only caller-supplied
# changes. Missing fields inherit observed state, explicit null clears them.
define discord_event_effective with existing as Str and changes as Str and creating as Int and now as Int returning List:
    set prior to provider_json_tokens(existing)
    set supplied to provider_json_tokens(changes)
    if now < 0 or else prior equals 0 or else supplied equals 0 or else provider_unique_objects(prior) equals 0 or else provider_unique_objects(supplied) equals 0 or else not (provider_kind(prior and 0) equals "{") or else discord_event_changes(supplied and 0 and creating) equals 0:
        return history_status("invalid-event-state")
    set keys to ["name","description","channel_id","entity_type","scheduled_start_time","scheduled_end_time","entity_metadata","recurrence_rule","image"]
    set effective to "{"
    set payload to "{"
    set count to 0
    set payload_count to 0
    if creating equals 1:
        set payload to "{\"privacy_level\":2"
        set payload_count to 1
    for each key_pointer in keys:
        set key to ptr_to_str(key_pointer)
        set field to provider_member(supplied and 0 and key)
        set value to ""
        if field >= 0:
            set value to agent_json_source(changes and supplied and field)
            if payload_count > 0:
                set payload to concat(payload and ",")
            set payload to concat(payload and concat(provider_quote(key) and concat(":" and value)))
            set payload_count to payload_count + 1
        else if creating equals 0:
            set field to provider_member(prior and 0 and key)
            if field >= 0:
                set value to agent_json_source(existing and prior and field)
        if string_length(value) > 0:
            if count > 0:
                set effective to concat(effective and ",")
            set effective to concat(effective and concat(provider_quote(key) and concat(":" and value)))
            set count to count + 1
    set effective to concat(effective and "}")
    set payload to concat(payload and "}")
    set fields to provider_json_tokens(effective)
    if fields equals 0 or else discord_rich_text(fields and provider_member(fields and 0 and "name") and 100 and 1) < 0 or else discord_rich_integer(fields and provider_member(fields and 0 and "entity_type") and 1 and 3) equals 0:
        return history_status("missing-effective-event-fields")
    set entity_type to provider_value(fields and provider_member(fields and 0 and "entity_type"))
    set room_field to provider_member(fields and 0 and "channel_id")
    set room to provider_value(fields and room_field)
    set metadata to provider_member(fields and 0 and "entity_metadata")
    set finish_field to provider_member(fields and 0 and "scheduled_end_time")
    set start_field to provider_member(fields and 0 and "scheduled_start_time")
    if not (provider_kind(fields and start_field) equals "string"):
        return history_status("invalid-effective-start")
    set start to discord_event_timestamp(provider_value(fields and start_field))
    if start < 0:
        return history_status("invalid-effective-start")
    if (creating equals 1 or else provider_member(supplied and 0 and "scheduled_start_time") >= 0) and also start <= now:
        return history_status("start-must-be-in-future")
    set finish to -1
    if finish_field >= 0 and also not (provider_kind(fields and finish_field) equals "null"):
        if not (provider_kind(fields and finish_field) equals "string"):
            return history_status("invalid-effective-end")
        set finish to discord_event_timestamp(provider_value(fields and finish_field))
        if finish <= start:
            return history_status("end-must-follow-start")
    if entity_type equals "3":
        if room_field >= 0 and also not (provider_kind(fields and room_field) equals "null"):
            return history_status("external-event-requires-null-channel")
        if metadata < 0 or else discord_rich_keys(fields and metadata and "|location|") equals 0 or else discord_rich_text(fields and provider_member(fields and metadata and "location") and 100 and 1) < 0 or else finish < 0:
            return history_status("external-event-requires-location-and-end")
        if creating equals 0 and also provider_member(supplied and 0 and "entity_type") >= 0:
            if not (provider_value(prior and provider_member(prior and 0 and "entity_type")) equals "3"):
                if not (provider_kind(supplied and provider_member(supplied and 0 and "channel_id")) equals "null") or else provider_member(supplied and 0 and "entity_metadata") < 0 or else provider_member(supplied and 0 and "scheduled_end_time") < 0:
                    return history_status("external-transition-requires-explicit-fields")
        set room to ""
    else:
        if not (provider_kind(fields and room_field) equals "string") or else discord_snowflake(room) equals 0:
            return history_status("voice-or-stage-event-requires-channel")
        if metadata >= 0 and also not (provider_kind(fields and metadata) equals "null"):
            return history_status("voice-or-stage-event-requires-null-metadata")
    return ["valid",payload,entity_type,room,int_to_string(start),int_to_string(finish)]
