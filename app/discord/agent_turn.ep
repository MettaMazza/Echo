import "turn_guard"
import "agent_output"
import "../agent/runner"

# One host-owned turn; never accept a destination, principal or credential from
# model output. Continuous scheduling and durable claim recovery are separate.
define discord_agent_turn with library as Str and token as Str and journal as Int and journal_path as Str and database as Int and inbox as Str and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str and profile as Str returning Str:
    set rooted_literal_1 to create_list()
    set retained_value_added to append_list(rooted_literal_1 and inbox)
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT payload FROM discord_inbox WHERE identity=? AND kind='MESSAGE_CREATE';" and rooted_literal_1))
    if not (archive_list_text(source and 0) equals "found"):
        return "source-unavailable"
    set original to archive_list_text(source and 1)
    set parsed to provider_json_tokens(original)
    set room to provider_value(parsed and provider_member(parsed and 0 and "channel_id"))
    set message to provider_value(parsed and provider_member(parsed and 0 and "id"))
    set user to provider_value(parsed and provider_member(parsed and provider_member(parsed and 0 and "author") and "id"))
    set guild_id to provider_value(parsed and provider_member(parsed and 0 and "guild_id"))
    if guild_id equals "null":
        set guild_id to ""
    # Capture the barrier before network checks to include concurrent edits.
    set rooted_literal_2 to create_list()
    set retained_value_added to append_list(rooted_literal_2 and inbox)
    set position to history_collect_one(checkpoint_prepare(journal and "SELECT cursor FROM discord_agent_jobs WHERE inbox=? AND state='claimed';" and rooted_literal_2))
    if not (archive_list_text(position and 0) equals "found"):
        return "journal-unavailable"
    set cursor to http_decimal(archive_list_text(position and 1))
    set access to discord_access_check(library and token and journal and directory_path and bot and guild_id and room and user and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return concat("access:" and archive_list_text(access and 0))
    set fresh to discord_source_current(library and token and journal and directory_path and original)
    if not (archive_list_text(fresh and 0) equals "current"):
        return archive_list_text(fresh and 0)
    if file_exists(stop_file):
        return "service-stopped"
    if discord_turn_barrier(journal and cursor and message and room and guild_id) is not equal to 0:
        return "invalidated-before-inference"
    set submitted to discord_agent_submit_media(journal and database and inbox and bot and guilds and admins and directory_path and archive_list_text(fresh and 1))
    if not (archive_list_text(submitted and 0) equals "accepted" or else archive_list_text(submitted and 0) equals "already-accepted"):
        return archive_list_text(submitted and 0)
    set run to concat("discord-message:" and message)
    if file_exists(stop_file):
        return "service-stopped"
    if discord_turn_barrier(journal and cursor and message and room and guild_id) is not equal to 0:
        set cancelled to agent_cancel_run(database and run)
        return "invalidated-after-import"
    set current to agent_run_read(database and run)
    if not (archive_list_text(current and 2) equals "completed"):
        # Never rerun an interrupted tool phase without its normal recovery.
        if not (archive_list_text(current and 2) equals "ready"):
            return "run-recovery-required"
        set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
        if system equals 0:
            return "cancellation-unavailable"
        set cancellation to socket_cancellation_create(system)
        set stop to socket_cancellation_create(system)
        if cancellation equals 0 or else stop equals 0:
            if cancellation is not equal to 0:
                set closed to socket_cancellation_close(cancellation)
            if stop is not equal to 0:
                set closed to socket_cancellation_close(stop)
            set closed to ep_dlclose(system)
            return "cancellation-unavailable"
        set completed to channel
        set monitor_journal to concat(journal_path and "")
        set monitor_bot to concat(bot and "")
        set monitor_message to concat(message and "")
        set monitor_room to concat(room and "")
        set monitor_guild to concat(guild_id and "")
        set monitor_stop to concat(stop_file and "")
        spawn discord_turn_monitor(monitor_journal and monitor_bot and cursor and monitor_message and monitor_room and monitor_guild and monitor_stop and get_list(stop and 0) and get_list(cancellation and 1) and completed)
        set outcome to agent_loop_provider_managed(database and run and profile and 8192 and get_list(cancellation and 0) and 65536 and stop_file)
        set closed to net_close(get_list(stop and 1))
        set monitored to receive from completed
        set closed to net_close(get_list(cancellation and 0))
        set closed to ep_dlclose(system)
        if monitored is not equal to 0:
            return "monitor-failed"
        if not (outcome equals "completed"):
            return outcome
    # Enqueue is private, not delivery. The delivery worker repeats the full
    # live permission AND source checks immediately before POST. Repeating
    # those same network reads here added seconds without protecting any
    # external effect. Keep the local invalidation barrier at enqueue too.
    if file_exists(stop_file):
        return "service-stopped"
    if discord_turn_barrier(journal and cursor and message and room and guild_id) is not equal to 0:
        return "invalidated-before-output"
    return discord_agent_output(journal and database and inbox)
