import "voice_gateway_recording"

# Caller holds the journal fence and has checked the native recording proof and
# current owner. A successful OP4 write alone never permits receive decoding.
# 0 waits for own server state; -1 denies; 1 confirms current undeafened state.
define discord_voice_recording_gate_confirmed with journal as Int and owner as List and recording as Str returning Int:
    if owner equals 0 or else length_list(owner) is not equal to 4:
        return -1
    set connection to get_list(owner and 0)
    set credentials to get_list(connection and 1)
    set gate to history_collect_one(checkpoint_prepare(journal and "SELECT p.state,p.gateway_session,p.after_sequence,p.voice_session,p.bot FROM discord_voice_recording_gates p JOIN discord_voice_recordings r ON r.identity=p.recording AND r.intent=p.intent WHERE p.recording=?1 AND p.intent=?2 AND p.generation=?3 AND r.state='active';" and [recording,archive_list_text(owner and 1),archive_list_text(owner and 2)]))
    if not (archive_list_text(gate and 0) equals "found") or else not (archive_list_text(gate and 4) equals archive_list_text(credentials and 2)) or else not (archive_list_text(gate and 5) equals archive_list_text(owner and 3)):
        return -1
    set state to archive_list_text(gate and 1)
    if state equals "pending" or else state equals "attempted":
        return 0
    if not (state equals "sent"):
        return -1
    set values to [archive_list_text(gate and 2),archive_list_text(credentials and 0),archive_list_text(owner and 3)]
    set latest to history_collect_one(checkpoint_prepare(journal and "SELECT sequence,kind,payload FROM discord_voice_membership_events WHERE session=?1 AND COALESCE(json_extract(payload,'$.guild_id'),json_extract(payload,'$.id'))=?2 AND (kind<>'VOICE_STATE_UPDATE' OR json_extract(payload,'$.user_id')=?3 OR json_extract(payload,'$.invalid')=1) ORDER BY sequence DESC LIMIT 1;" and values))
    if not (archive_list_text(latest and 0) equals "found") or else string_to_int(archive_list_text(latest and 1)) <= string_to_int(archive_list_text(gate and 3)):
        return 0
    if not (archive_list_text(latest and 2) equals "VOICE_STATE_UPDATE"):
        return -1
    set fields to provider_json_tokens(archive_list_text(latest and 3))
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_value(fields and provider_member(fields and 0 and "user_id")) equals archive_list_text(owner and 3)) or else not (provider_value(fields and provider_member(fields and 0 and "channel_id")) equals archive_list_text(connection and 2)) or else not (provider_value(fields and provider_member(fields and 0 and "session_id")) equals archive_list_text(credentials and 2)):
        return -1
    if not (provider_kind(fields and provider_member(fields and 0 and "self_deaf")) equals "false") or else not (provider_kind(fields and provider_member(fields and 0 and "deaf")) equals "false"):
        return -1
    return 1
