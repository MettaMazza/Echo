import "command_registration"

# Host maintenance only. The operator supplies the ID/version inspected from
# Discord. Model arguments and channel text cannot call this entry point.
define discord_command_upgrade_scope with body as Str and bot as Str and guild as Str and name as Str and identity as Str and revision as Str returning Int:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else discord_snowflake(identity) equals 0 or else discord_snowflake(revision) equals 0:
        return 0
    return provider_value(tokens and provider_member(tokens and 0 and "id")) equals identity and also provider_value(tokens and provider_member(tokens and 0 and "version")) equals revision and also provider_value(tokens and provider_member(tokens and 0 and "application_id")) equals bot and also provider_value(tokens and provider_member(tokens and 0 and "guild_id")) equals guild and also provider_value(tokens and provider_member(tokens and 0 and "name")) equals name and also provider_value(tokens and provider_member(tokens and 0 and "type")) equals "1"

define discord_command_upgrade with name as Str and library as Str and token as Str and journal as Int and bot as Str and guild as Str and directory_path as Str and identity as Str and revision as Str returning Str:
    if string_length(discord_control_command_definition(name)) equals 0 or else discord_snowflake(bot) equals 0 or else discord_snowflake(guild) equals 0 or else discord_snowflake(identity) equals 0 or else discord_snowflake(revision) equals 0:
        return "invalid-upgrade-scope"
    set route to concat("/applications/" and concat(bot and concat("/guilds/" and concat(guild and concat("/commands/" and identity)))))
    set observed to discord_access_get(library and token and journal and directory_path and route and "GET:command-upgrade" and identity)
    if not (archive_list_text(observed and 0) equals "observed"):
        return concat("inspect:" and archive_list_text(observed and 0))
    set body to archive_list_text(observed and 1)
    set tokens to provider_json_tokens(body)
    set current_revision to provider_value(tokens and provider_member(tokens and 0 and "version"))
    if discord_command_upgrade_scope(body and bot and guild and name and identity and current_revision) equals 0:
        return "upgrade-identity-conflict"
    # Recovery after an uncertain PATCH first observes the installed definition.
    if discord_control_command_matches(body and name) equals 1:
        return discord_command_observe(journal and body and bot and guild)
    if not (current_revision equals revision):
        return "upgrade-version-conflict"
    set updated to discord_access_body(library and token and journal and directory_path and "PATCH" and route and "PATCH:command-upgrade" and identity and discord_control_command_definition(name))
    if not (archive_list_text(updated and 0) equals "observed"):
        return concat("upgrade-unconfirmed-inspect-before-retry:" and archive_list_text(updated and 0))
    # Re-read persisted state, not merely a successful transfer response.
    set confirmed to discord_access_get(library and token and journal and directory_path and route and "GET:command-upgrade-confirm" and identity)
    if not (archive_list_text(confirmed and 0) equals "observed"):
        return concat("confirmation-unavailable:" and archive_list_text(confirmed and 0))
    set body to archive_list_text(confirmed and 1)
    set tokens to provider_json_tokens(body)
    set current_revision to provider_value(tokens and provider_member(tokens and 0 and "version"))
    if discord_command_upgrade_scope(body and bot and guild and name and identity and current_revision) equals 0 or else discord_control_command_matches(body and name) equals 0:
        return "upgraded-definition-mismatch"
    return discord_command_observe(journal and body and bot and guild)
