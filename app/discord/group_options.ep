import "interaction_intake"

define discord_group_command_definition returning Str:
    return "{\"type\":1,\"name\":\"group\",\"description\":\"Create, join, leave or select a shared conversation in this channel.\",\"options\":[{\"type\":3,\"name\":\"action\",\"description\":\"Choose a group action.\",\"required\":true,\"choices\":[{\"name\":\"list\",\"value\":\"list\"},{\"name\":\"create\",\"value\":\"create\"},{\"name\":\"inspect\",\"value\":\"inspect\"},{\"name\":\"invite\",\"value\":\"invite\"},{\"name\":\"join\",\"value\":\"join\"},{\"name\":\"leave\",\"value\":\"leave\"},{\"name\":\"remove\",\"value\":\"remove\"},{\"name\":\"open\",\"value\":\"open\"},{\"name\":\"personal\",\"value\":\"personal\"}]},{\"type\":3,\"name\":\"group\",\"description\":\"Group ID from the group list.\",\"required\":false},{\"type\":6,\"name\":\"member\",\"description\":\"Account to invite or remove; this never forces a join.\",\"required\":false},{\"type\":3,\"name\":\"revision\",\"description\":\"Current membership revision shown by inspect.\",\"required\":false},{\"type\":3,\"name\":\"source\",\"description\":\"Original message ID from a shared-conversation offer (create only).\",\"required\":false},{\"type\":3,\"name\":\"after\",\"description\":\"Next-page cursor from list.\",\"required\":false}]}"

# Strict native Discord option types; identifiers and actor authority come
# from the authenticated interaction, not from these editable option values.
define discord_group_command_options with body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set data to provider_member(tokens and 0 and "data")
    set options to provider_member(tokens and data and "options")
    if not (provider_kind(tokens and options) equals "["):
        return ""
    set seen to create_list()
    set output to "{"
    set items to provider_items(tokens and options)
    for each option in items:
        set name to provider_value(tokens and provider_member(tokens and option and "name"))
        set field to provider_member(tokens and option and "value")
        if not (name equals "action" or else name equals "group" or else name equals "member" or else name equals "revision" or else name equals "after" or else name equals "source") or else not (provider_kind(tokens and field) equals "string"):
            return ""
        set expected_type to "3"
        if name equals "member":
            set expected_type to "6"
            if discord_snowflake(provider_value(tokens and field)) equals 0:
                return ""
        if not (provider_value(tokens and provider_member(tokens and option and "type")) equals expected_type):
            return ""
        for each prior in seen:
            if name equals prior:
                return ""
        if length_list(seen) > 0:
            set output to concat(output and ",")
        set added to append_list(seen and name)
        set quoted_name to provider_quote(name)
        set quoted_value to provider_quote(provider_value(tokens and field))
        set pair to concat(quoted_name and concat(":" and quoted_value))
        set output to concat(output and pair)
    set output to concat(output and "}")
    set fields to provider_json_tokens(output)
    set action to provider_value(fields and provider_member(fields and 0 and "action"))
    if not (action equals "list" or else action equals "create" or else action equals "inspect" or else action equals "invite" or else action equals "join" or else action equals "leave" or else action equals "remove" or else action equals "open" or else action equals "personal"):
        return ""
    set group to provider_member(fields and 0 and "group")
    set member to provider_member(fields and 0 and "member")
    set revision to provider_member(fields and 0 and "revision")
    set after to provider_member(fields and 0 and "after")
    set source to provider_member(fields and 0 and "source")
    if source >= 0 and (not (action equals "create") or else discord_snowflake(provider_value(fields and source)) equals 0):
        return ""
    set needs_group to not (action equals "list" or else action equals "create" or else action equals "personal")
    set needs_member to action equals "invite" or else action equals "remove"
    set needs_revision to needs_member or else action equals "join" or else action equals "leave"
    if (needs_group and (group < 0 or else string_length(provider_value(fields and group)) equals 0)) or else (not needs_group and group >= 0):
        return ""
    if (needs_member and member < 0) or else (not needs_member and member >= 0):
        return ""
    if needs_revision:
        if revision < 0 or else http_decimal(provider_value(fields and revision)) < 1:
            return ""
    else if revision >= 0:
        return ""
    if after >= 0 and not (action equals "list"):
        return ""
    return output

define discord_group_command_matches with body as Str returning Int:
    set tokens to provider_json_tokens(body)
    set expected to provider_json_tokens(discord_group_command_definition())
    set actual_items to provider_items(tokens and provider_member(tokens and 0 and "options"))
    set wanted_items to provider_items(expected and provider_member(expected and 0 and "options"))
    if length_list(actual_items) is not equal to length_list(wanted_items):
        return 0
    set index to 0
    repeat while index < length_list(wanted_items):
        set actual to get_list(actual_items and index)
        set wanted to get_list(wanted_items and index)
        set index to index + 1
        set option_keys to create_list()
        set group_option_value_9 to "type"
        set added to append_list(option_keys and group_option_value_9)
        set group_option_value_10 to "name"
        set added to append_list(option_keys and group_option_value_10)
        set group_option_value_11 to "description"
        set added to append_list(option_keys and group_option_value_11)
        for each key in option_keys:
            if not (provider_value(tokens and provider_member(tokens and actual and key)) equals provider_value(expected and provider_member(expected and wanted and key))):
                return 0
        set actual_required to provider_value(tokens and provider_member(tokens and actual and "required")) equals "true"
        set wanted_required to provider_value(expected and provider_member(expected and wanted and "required")) equals "true"
        if actual_required is not equal to wanted_required:
            return 0
        set restrictions to create_list()
        set group_option_value_12 to "autocomplete"
        set added to append_list(restrictions and group_option_value_12)
        set group_option_value_13 to "min_length"
        set added to append_list(restrictions and group_option_value_13)
        set group_option_value_14 to "max_length"
        set added to append_list(restrictions and group_option_value_14)
        set group_option_value_15 to "options"
        set added to append_list(restrictions and group_option_value_15)
        for each forbidden in restrictions:
            if provider_member(tokens and actual and forbidden) >= 0:
                return 0
        set choices to provider_items(tokens and provider_member(tokens and actual and "choices"))
        set expected_choices to provider_items(expected and provider_member(expected and wanted and "choices"))
        if length_list(choices) is not equal to length_list(expected_choices):
            return 0
        set choice_index to 0
        repeat while choice_index < length_list(choices):
            set choice to get_list(choices and choice_index)
            set expected_choice to get_list(expected_choices and choice_index)
            set choice_index to choice_index + 1
            set choice_keys to create_list()
            set group_option_value_16 to "name"
            set added to append_list(choice_keys and group_option_value_16)
            set group_option_value_17 to "value"
            set added to append_list(choice_keys and group_option_value_17)
            for each key in choice_keys:
                if not (provider_value(tokens and provider_member(tokens and choice and key)) equals provider_value(expected and provider_member(expected and expected_choice and key))):
                    return 0
    return 1
