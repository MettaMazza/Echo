import "activity_archive"
import "activity_pages"
import "activity_transport"

# Final activity delivery is separate from answer delivery: answers remain in
# the original channel. Full Discord-run activity is visible to its source
# audience in the exact attached thread. No alternate private delivery exists.
define discord_activity_deliver with library as Str and token as Str and journal as Int and database as Int and identity as Str and bot as Str and admins as List and directory_path as Str and stop_file as Str returning Str:
    if not (string_index_of(identity and "activity-page:") equals 0):
        return "not-activity"
    set values to create_list()
    set added to append_list(values and identity)
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT p.inbox,p.run,p.destination,p.full_trace,i.payload,json_extract(i.payload,'$.id'),json_extract(i.payload,'$.channel_id'),COALESCE(json_extract(i.payload,'$.guild_id'),'') FROM discord_outbox o JOIN discord_activity_pages p ON o.identity LIKE p.identity||':%' AND o.inbox=p.inbox AND o.channel=p.destination JOIN discord_inbox i ON i.identity=p.inbox WHERE o.identity=? AND o.state='pending';" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "activity-binding-unavailable"
    set inbox to archive_list_text(row and 1)
    set run to archive_list_text(row and 2)
    set destination to archive_list_text(row and 3)
    set binding_values to create_list()
    set added to append_list(binding_values and inbox)
    set added to append_list(binding_values and destination)
    set thread_binding to history_collect_one(checkpoint_prepare(journal and "SELECT thread FROM discord_activity_threads WHERE inbox=?1 AND thread=?2 AND state='ready';" and binding_values))
    if not (archive_list_text(thread_binding and 0) equals "found"):
        return "activity-requires-attached-thread"
    if not (discord_job_origin(journal and database and run) equals inbox):
        return "activity-authority-revoked"
    if file_exists(stop_file):
        return "stopped"
    set intake to discord_intake_source(journal and inbox)
    if not (archive_list_text(intake and 0) equals "found"):
        return "source-unavailable"
    set user to archive_list_text(intake and 3)
    set room to archive_list_text(intake and 4)
    set guild to archive_list_text(intake and 5)
    if archive_list_text(intake and 1) equals "INTERACTION_CREATE" and discord_contains(admins and user) equals 0:
        return "admin-required"
    set access to discord_access_check(library and token and journal and directory_path and bot and guild and room and user and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return concat("source-access:" and archive_list_text(access and 0))
    set fresh to discord_run_source_check(library and token and journal and directory_path and inbox and intake)
    if not (fresh equals "current"):
        return fresh
    set observed to discord_access_get(library and token and journal and directory_path and concat("/channels/" and destination) and "GET:channel" and destination)
    if not (archive_list_text(observed and 0) equals "observed") or else not (discord_activity_observe(journal and inbox and archive_list_text(observed and 1)) equals "ready"):
        return "thread-revalidation-failed"
    set thread_tokens to provider_json_tokens(archive_list_text(observed and 1))
    set metadata to provider_member(thread_tokens and 0 and "thread_metadata")
    if provider_value(thread_tokens and provider_member(thread_tokens and metadata and "archived")) equals "true":
        set reopened to discord_activity_archive_set(library and token and journal and inbox and 0 and bot and admins and directory_path and stop_file)
        if not (reopened equals "archive-state-confirmed"):
            return reopened
    set target_access to discord_access_check(library and token and journal and directory_path and bot and guild and destination and user and admins)
    if not (archive_list_text(target_access and 0) equals "allowed"):
        return concat("thread-access:" and archive_list_text(target_access and 0))
    if file_exists(stop_file) or else not (discord_job_origin(journal and database and run) equals inbox):
        return "delivery-stopped"
    return discord_delivery_send(library and token and journal and identity and directory_path)
