import "audit_options"
import "role_guard"

# Full change values belong only in an independently authorized audit audience.
# Auxiliary user profiles, webhooks and integrations are not copied into model
# context. IDs, reasons, changes and options retain their original provenance.
define discord_audit_page with body as Str and options as List returning Str:
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_kind(fields and 0) equals "{") or else not (archive_list_text(options and 0) equals "valid"):
        return ""
    set entries to provider_member(fields and 0 and "audit_log_entries")
    if not (provider_kind(fields and entries) equals "["):
        return ""
    set items to create_list()
    set retained to create_list()
    set items to provider_items(fields and entries)
    set added to append_list(retained and items)
    set keys to create_list()
    set keys to ["id","target_id","user_id","action_type","reason","changes","options"]
    set seen to create_list()
    set output to "["
    set count to 0
    set oldest to ""
    set newest to ""
    for each item in items:
        if not (provider_kind(fields and item) equals "{"):
            return ""
        set identity_field to provider_member(fields and item and "id")
        set identity to provider_value(fields and identity_field)
        set action_field to provider_member(fields and item and "action_type")
        set action to provider_value(fields and action_field)
        if not (provider_kind(fields and identity_field) equals "string") or else discord_snowflake(identity) equals 0 or else discord_contains(seen and identity) equals 1 or else not (provider_kind(fields and action_field) equals "number") or else http_decimal(action) < 1 or else not (int_to_string(http_decimal(action)) equals action):
            return ""
        set added to append_list(seen and identity)
        set before to archive_list_text(options and 3)
        set after to archive_list_text(options and 4)
        if string_length(before) > 0 and also discord_role_id_older(identity and before) is not equal to 1:
            return ""
        if string_length(after) > 0 and also discord_role_id_older(after and identity) is not equal to 1:
            return ""
        if string_length(archive_list_text(options and 5)) > 0 and also not (provider_value(fields and provider_member(fields and item and "user_id")) equals archive_list_text(options and 5)):
            return ""
        if string_length(archive_list_text(options and 6)) > 0 and also not (action equals archive_list_text(options and 6)):
            return ""
        if count equals 0 or else discord_role_id_older(identity and oldest) equals 1:
            set oldest to identity
        if count equals 0 or else discord_role_id_older(newest and identity) equals 1:
            set newest to identity
        if count > 0:
            set output to concat(output and ",")
        set output to concat(output and "{")
        set properties to 0
        for each key_item in keys:
            set key to ptr_to_str(key_item)
            set field to provider_member(fields and item and key)
            if field >= 0:
                if properties > 0:
                    set output to concat(output and ",")
                set output to concat(output and concat(provider_quote(key) and concat(":" and agent_json_source(body and fields and field))))
                set properties to properties + 1
        set output to concat(output and "}")
        set count to count + 1
        if count > http_decimal(archive_list_text(options and 2)):
            return ""
    set output to concat(output and "]")
    set more to "false"
    if count equals http_decimal(archive_list_text(options and 2)):
        set more to "true"
    set result to concat("{\"entries\":" and output)
    set result to concat(result and concat(",\"count\":" and int_to_string(count)))
    set result to concat(result and concat(",\"oldest_id\":" and provider_quote(oldest)))
    set result to concat(result and concat(",\"newest_id\":" and provider_quote(newest)))
    return concat(result and concat(",\"more_may_exist\":" and concat(more and "}")))
