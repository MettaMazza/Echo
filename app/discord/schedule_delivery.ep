import "schedule_control"
import "command_authority"
import "agent_bridge"
import "access"
import "interaction_recovery"

# The original interaction fixes the actor, namespace, options and operation.
# Freeze response bytes once; retries never create a newer public response.
define discord_schedule_prepare with journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List returning List:
    if discord_command_acknowledged(journal and identity and body) equals 0 or else not (discord_interaction_visibility_read(journal and identity and body) equals "private"):
        return history_status("schedule-not-authorized")
    set command to discord_command_resolve(journal and body and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access") or else not (archive_list_text(command and 1) equals "schedules"):
        return history_status("schedule-not-authorized")
    set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
    set options to archive_list_text(command and 5)
    set fields to provider_json_tokens(options)
    set session to provider_value(fields and provider_member(fields and 0 and "session"))
    if discord_schedule_scope(database and device and discord_command_server(command and bot) and archive_list_text(command and 3) and session) equals 0:
        return history_status("schedule-not-authorized")
    set action to provider_value(fields and provider_member(fields and 0 and "action"))
    if not (action equals "list"):
        set schedule to provider_value(fields and provider_member(fields and 0 and "schedule"))
        set owned to discord_schedule_row(database and device and session and schedule and 0)
        if not (archive_list_text(owned and 0) equals "found"):
            return history_status("schedule-not-authorized")
    if sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_schedule_responses(identity TEXT PRIMARY KEY REFERENCES discord_inbox(identity),intake_digest TEXT NOT NULL,payload TEXT NOT NULL,digest TEXT NOT NULL); CREATE TRIGGER IF NOT EXISTS discord_schedule_response_no_update BEFORE UPDATE ON discord_schedule_responses BEGIN SELECT RAISE(ABORT,'Schedule response is immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_schedule_response_no_delete BEFORE DELETE ON discord_schedule_responses BEGIN SELECT RAISE(ABORT,'Schedule response provenance persists'); END;") is not equal to 0:
        return history_status("store-failed")
    set schedule_query_values_1 to create_list()
    set schedule_value_2 to identity
    set added to append_list(schedule_query_values_1 and schedule_value_2)
    set old to history_collect_one(checkpoint_prepare(journal and "SELECT payload,digest,intake_digest FROM discord_schedule_responses WHERE identity=?1;" and schedule_query_values_1))
    if archive_list_text(old and 0) equals "found":
        if not (archive_list_text(old and 3) equals ep_sha256(body)) or else not (ep_sha256(archive_list_text(old and 1)) equals archive_list_text(old and 2)):
            return history_status("schedule-not-authorized")
        return old
    if not (archive_list_text(old and 0) equals "end"):
        return history_status("store-failed")
    set payload to discord_schedule_request(database and device and discord_command_server(command and bot) and archive_list_text(command and 3) and concat("discord-schedule:" and identity) and options)
    set result to provider_json_tokens(payload)
    set status to provider_value(result and provider_member(result and 0 and "status"))
    if status equals "database-busy" or else status equals "database-error" or else status equals "commit-failed" or else status equals "write-failed":
        return history_status("store-failed")
    if not (status equals "found" or else status equals "end" or else status equals "cancelled" or else status equals "already-cancelled"):
        return history_status(concat("schedule-rejected:" and status))
    set schedule_query_values_3 to create_list()
    set schedule_value_4 to identity
    set added to append_list(schedule_query_values_3 and schedule_value_4)
    set schedule_value_5 to ep_sha256(body)
    set added to append_list(schedule_query_values_3 and schedule_value_5)
    set schedule_value_6 to payload
    set added to append_list(schedule_query_values_3 and schedule_value_6)
    set schedule_value_7 to ep_sha256(payload)
    set added to append_list(schedule_query_values_3 and schedule_value_7)
    if archive_finish(checkpoint_prepare(journal and "INSERT OR IGNORE INTO discord_schedule_responses VALUES(?1,?2,?3,?4);" and schedule_query_values_3) and 101) is not equal to 0:
        return history_status("store-failed")
    return discord_schedule_prepare(journal and database and identity and body and bot and guilds and admins)

define discord_schedule_caption with payload as Str returning Str:
    set fields to provider_json_tokens(payload)
    set effect to provider_value(fields and provider_member(fields and 0 and "effect"))
    if string_length(effect) > 0:
        return concat("Schedule cancellation saved.\n" and effect)
    return "Your schedule status is in the attached receipt. Use next_after to continue list or occurrences. Cancel stops future reservations; existing runs use their own Cancel control."

define discord_schedule_deliver with library as Str and token as Str and journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    set prepared to discord_schedule_prepare(journal and database and identity and body and bot and guilds and admins)
    if not (archive_list_text(prepared and 0) equals "found"):
        return archive_list_text(prepared and 0)
    set command to discord_command_resolve(journal and body and bot and guilds and admins)
    set access to discord_access_check(library and token and journal and directory_path and bot and archive_list_text(command and 4) and archive_list_text(command and 3) and archive_list_text(command and 2) and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return "schedule-not-authorized"
    set schedule_query_values_8 to create_list()
    set schedule_value_9 to identity
    set added to append_list(schedule_query_values_8 and schedule_value_9)
    set schedule_value_10 to int_to_string(ep_time_now_ms())
    set added to append_list(schedule_query_values_8 and schedule_value_10)
    set credential to history_collect_one(checkpoint_prepare(journal and "SELECT credential FROM discord_interaction_credentials WHERE identity=?1 AND expires_ms>CAST(?2 AS INTEGER);" and schedule_query_values_8))
    if not (archive_list_text(credential and 0) equals "found") or else discord_interaction_credential_valid(archive_list_text(credential and 1)) equals 0:
        return "response-expired"
    set route to concat("/webhooks/" and concat(bot and concat("/" and concat(archive_list_text(credential and 1) and "/messages/@original"))))
    set observed to discord_access_get(library and token and journal and directory_path and route and "GET:schedule-original" and identity)
    if not (archive_list_text(observed and 0) equals "observed"):
        return archive_list_text(observed and 0)
    if discord_interaction_original_matches(archive_list_text(observed and 1) and bot and archive_list_text(command and 3)) equals 0:
        return "schedule-not-authorized"
    set exported to archive_list_text(prepared and 1)
    set digest to archive_list_text(prepared and 2)
    set filename to concat("Echo-schedule-" and concat(digest and ".json"))
    set response to provider_json_tokens(archive_list_text(observed and 1))
    set attachments to provider_items(response and provider_member(response and 0 and "attachments"))
    for each item in attachments:
        if provider_value(response and provider_member(response and item and "filename")) equals filename and provider_value(response and provider_member(response and item and "size")) equals int_to_string(string_length(exported)):
            return "schedule-delivered"
    set envelope to provider_json_tokens(body)
    set limit to 10485760
    set reported to http_decimal(provider_value(envelope and provider_member(envelope and 0 and "attachment_size_limit")))
    if reported > 0 and reported <= 4294967295:
        set limit to reported
    if string_length(exported) > limit:
        return "schedule-too-large"
    set caption to concat(discord_schedule_caption(exported) and concat("\nSHA-256: " and digest))
    set payload to concat("{\"content\":" and concat(provider_quote(caption) and concat(",\"allowed_mentions\":{\"parse\":[]},\"attachments\":[{\"id\":0,\"filename\":" and concat(provider_quote(filename) and "}]}"))))
    set boundary to concat("EchoExport" and ptr_to_str(ep_uuid_v4()))
    set multipart to concat("--" and concat(boundary and concat("\r\nContent-Disposition: form-data; name=\"payload_json\"\r\nContent-Type: application/json; charset=utf-8\r\n\r\n" and payload)))
    set multipart to concat(multipart and concat("\r\n--" and concat(boundary and concat("\r\nContent-Disposition: form-data; name=\"files[0]\"; filename=\"" and concat(filename and "\"\r\nContent-Type: application/json; charset=utf-8\r\n\r\n")))))
    set multipart to concat(multipart and concat(exported and concat("\r\n--" and concat(boundary and "--\r\n"))))
    # Recheck current authority after archive generation and HTTP inspection.
    set fresh to discord_schedule_prepare(journal and database and identity and body and bot and guilds and admins)
    if not (archive_list_text(fresh and 0) equals "found") or else not (archive_list_text(fresh and 2) equals digest) or else file_exists(stop_file):
        return "schedule-not-authorized"
    set access to discord_access_check(library and token and journal and directory_path and bot and archive_list_text(command and 4) and archive_list_text(command and 3) and archive_list_text(command and 2) and admins)
    if not (archive_list_text(access and 0) equals "allowed") or else file_exists(stop_file) or else discord_command_acknowledged(journal and identity and body) equals 0:
        return "schedule-not-authorized"
    set sent to discord_access_bytes(library and token and journal and directory_path and "PATCH" and route and "PATCH:schedule-original" and identity and str_to_ptr(multipart) and string_length(multipart) and concat("multipart/form-data; boundary=" and boundary))
    if not (archive_list_text(sent and 0) equals "observed"):
        return archive_list_text(sent and 0)
    if discord_interaction_original_matches(archive_list_text(sent and 1) and bot and archive_list_text(command and 3)) equals 0:
        return "schedule-not-authorized"
    set response to provider_json_tokens(archive_list_text(sent and 1))
    set attachments to provider_items(response and provider_member(response and 0 and "attachments"))
    for each item in attachments:
        if provider_value(response and provider_member(response and item and "filename")) equals filename and provider_value(response and provider_member(response and item and "size")) equals int_to_string(string_length(exported)):
            return "schedule-delivered"
    return "schedule-upload-unconfirmed"
