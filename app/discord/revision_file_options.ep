import "revision_options"

# A separate registration preserves the existing /edit definition and receipts.
define discord_revision_file_definition returning Str:
    return "{\"type\":1,\"name\":\"editfile\",\"description\":\"Replace your prompt with a complete retained text file in a new branch.\",\"options\":[{\"type\":3,\"name\":\"message\",\"description\":\"Your original message ID or its delivered Echo reply ID.\",\"required\":true},{\"type\":3,\"name\":\"attachment\",\"description\":\"Retained text attachment ID from /attachments list.\",\"required\":true}]}"

define discord_revision_file_options with journal as Int and body as Str and actor as Str and guild as Str and room as Str returning Str:
    set tokens to provider_json_tokens(body)
    set data to provider_member(tokens and 0 and "data")
    set options to provider_member(tokens and data and "options")
    if not (provider_kind(tokens and options) equals "["):
        return ""
    set message to ""
    set attachment to ""
    set seen to create_list()
    set items to provider_items(tokens and options)
    for each option in items:
        set name to provider_value(tokens and provider_member(tokens and option and "name"))
        set value to provider_member(tokens and option and "value")
        if not (name equals "message" or else name equals "attachment") or else not (provider_value(tokens and provider_member(tokens and option and "type")) equals "3") or else not (provider_kind(tokens and value) equals "string"):
            return ""
        for each prior in seen:
            if name equals ptr_to_str(prior):
                return ""
        set added to append_list(seen and name)
        if name equals "message":
            set message to provider_value(tokens and value)
        else:
            set attachment to provider_value(tokens and value)
    set interaction to provider_value(tokens and provider_member(tokens and 0 and "id"))
    if discord_snowflake(message) equals 0 or else discord_snowflake(interaction) equals 0 or else string_length(attachment) equals 0:
        return ""
    set text to ""
    set installed to history_collect_one(archive_prepare(journal and "SELECT name FROM sqlite_master WHERE type='table' AND name='discord_revision_files';"))
    if archive_list_text(installed and 0) equals "found":
        set keys to [concat("interaction:" and interaction),concat("discord:" and actor),guild,room,attachment]
        set frozen to history_collect_one(checkpoint_prepare(journal and "SELECT content FROM discord_revision_files WHERE interaction=?1 AND device=?2 AND guild=?3 AND channel=?4 AND attachment=?5;" and keys))
        if archive_list_text(frozen and 0) equals "found":
            set text to archive_list_text(frozen and 1)
        else if not (archive_list_text(frozen and 0) equals "end"):
            return ""
    else if not (archive_list_text(installed and 0) equals "end"):
        return ""
    return concat("{\"message\":" and concat(provider_quote(message) and concat(",\"attachment\":" and concat(provider_quote(attachment) and concat(",\"text\":" and concat(provider_quote(text) and "}"))))))
