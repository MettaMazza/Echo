import "interaction_intake"
import "../hud/interface"

define discord_hud_command_definition returning Str:
    return "{\"type\":1,\"name\":\"hud\",\"description\":\"Inspect permitted Echo status for a conversation in this channel.\",\"options\":[{\"type\":3,\"name\":\"run\",\"description\":\"Run ID from the thinking thread or conversation export.\",\"required\":true},{\"type\":3,\"name\":\"section\",\"description\":\"Choose the current status section.\",\"required\":true,\"choices\":[{\"name\":\"interaction\",\"value\":\"interaction\"},{\"name\":\"context\",\"value\":\"context\"},{\"name\":\"work\",\"value\":\"work\"},{\"name\":\"schedules\",\"value\":\"schedules\"},{\"name\":\"incidents\",\"value\":\"incidents\"},{\"name\":\"community\",\"value\":\"community\"},{\"name\":\"rights\",\"value\":\"rights\"},{\"name\":\"machine\",\"value\":\"machine\"}]},{\"type\":3,\"name\":\"after\",\"description\":\"Optional next_after cursor from the previous response.\",\"required\":false}]}"

# Only named string options are accepted; duplicate names are not last-wins.
define discord_hud_command_options with body as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set data to provider_member(tokens and 0 and "data")
    set options to provider_member(tokens and data and "options")
    if not (provider_kind(tokens and options) equals "["):
        return ""
    set seen to create_list()
    set output to "{"
    for each option in provider_items(tokens and options):
        set name to provider_value(tokens and provider_member(tokens and option and "name"))
        set field to provider_member(tokens and option and "value")
        set known to 0
        for each allowed in ["run","section","after"]:
            if name equals allowed:
                set known to 1
        if known equals 0 or else not (provider_value(tokens and provider_member(tokens and option and "type")) equals "3") or else not (provider_kind(tokens and field) equals "string"):
            return ""
        for each prior in seen:
            if name equals prior:
                return ""
        if length_list(seen) > 0:
            set output to concat(output and ",")
        set added to append_list(seen and name)
        set pair to concat(provider_quote(name) and concat(":" and provider_quote(provider_value(tokens and field))))
        set output to concat(output and pair)
    set output to concat(output and "}")
    set fields to provider_json_tokens(output)
    set run to provider_value(fields and provider_member(fields and 0 and "run"))
    set section to provider_value(fields and provider_member(fields and 0 and "section"))
    set after to "0"
    if provider_member(fields and 0 and "after") >= 0:
        set after to provider_value(fields and provider_member(fields and 0 and "after"))
    set cursor to http_decimal(after)
    if cursor < 0 or else not (int_to_string(cursor) equals after):
        return ""
    set arguments to concat("{\"run\":" and concat(provider_quote(run) and concat(",\"section\":" and concat(provider_quote(section) and concat(",\"after\":" and concat(after and "}"))))))
    if hud_arguments_valid(provider_json_tokens(arguments) and 1) equals 0:
        return ""
    return arguments

# Discord may omit optional false fields, but cannot change options or choices.
define discord_hud_command_matches with body as Str returning Int:
    set tokens to provider_json_tokens(body)
    set expected to provider_json_tokens(discord_hud_command_definition())
    set actual_items to provider_items(tokens and provider_member(tokens and 0 and "options"))
    set wanted_items to provider_items(expected and provider_member(expected and 0 and "options"))
    if length_list(actual_items) is not equal to length_list(wanted_items):
        return 0
    set index to 0
    repeat while index < length_list(wanted_items):
        set actual to get_list(actual_items and index)
        set wanted to get_list(wanted_items and index)
        set index to index + 1
        for each key in ["type","name","description"]:
            if not (provider_value(tokens and provider_member(tokens and actual and key)) equals provider_value(expected and provider_member(expected and wanted and key))):
                return 0
        set actual_required to provider_value(tokens and provider_member(tokens and actual and "required")) equals "true"
        set wanted_required to provider_value(expected and provider_member(expected and wanted and "required")) equals "true"
        if actual_required is not equal to wanted_required:
            return 0
        for each forbidden in ["autocomplete","min_length","max_length","options"]:
            if provider_member(tokens and actual and forbidden) >= 0:
                return 0
        set choices to provider_items(tokens and provider_member(tokens and actual and "choices"))
        set expected_choices to provider_items(expected and provider_member(expected and wanted and "choices"))
        if length_list(choices) is not equal to length_list(expected_choices):
            return 0
        set choice_index to 0
        repeat while choice_index < length_list(choices):
            set choice to get_list(choices and choice_index)
            set expected_choice to get_list(expected_choices and choice_index)
            set choice_index to choice_index + 1
            for each key in ["name","value"]:
                if not (provider_value(tokens and provider_member(tokens and choice and key)) equals provider_value(expected and provider_member(expected and expected_choice and key))):
                    return 0
    return 1
