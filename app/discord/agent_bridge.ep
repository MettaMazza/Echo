import "gateway_intake"
import "../security/channel_silo"
import "../security/group_output_policy"
import "../web/run_store"
import "attachments"
import "audio_decode"
import "joined_groups"

external define ep_uuid_v4

# Refuse adoption of an existing unbound conversation archive. The connector
# never opens the owner's archive and never links a Discord identity to it.
define discord_agent_open with path as Str and bot as Str returning Int:
    if discord_snowflake(bot) equals 0:
        return 0
    set inspect to sql_open(path)
    if inspect equals 0:
        return 0
    if sql_execute(inspect and "PRAGMA busy_timeout=5000;") is not equal to 0:
        set closed to sql_close(inspect)
        return 0
    set marker to history_collect_one(archive_prepare(inspect and "SELECT name FROM sqlite_master WHERE name='echo_discord_binding';"))
    if archive_list_text(marker and 0) equals "found":
        set bound to history_collect_one(archive_prepare(inspect and "SELECT bot FROM echo_discord_binding WHERE singleton=1;"))
        if not (archive_list_text(bound and 0) equals "found") or else not (archive_list_text(bound and 1) equals bot):
            set closed to sql_close(inspect)
            return 0
    else if archive_list_text(marker and 0) equals "end":
        set existing to history_collect_one(archive_prepare(inspect and "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';"))
        if not (archive_list_text(existing and 0) equals "found") or else not (archive_list_text(existing and 1) equals "0"):
            set closed to sql_close(inspect)
            return 0
        set rooted_literal_1 to create_list()
        set retained_value_added to append_list(rooted_literal_1 and bot)
        if sql_execute(inspect and "CREATE TABLE echo_discord_binding(singleton INTEGER PRIMARY KEY CHECK(singleton=1),bot TEXT NOT NULL); CREATE TRIGGER echo_discord_binding_no_update BEFORE UPDATE ON echo_discord_binding BEGIN SELECT RAISE(ABORT,'Discord archive identity is immutable'); END; CREATE TRIGGER echo_discord_binding_no_delete BEFORE DELETE ON echo_discord_binding BEGIN SELECT RAISE(ABORT,'Discord archive identity is immutable'); END;") is not equal to 0 or else archive_finish(checkpoint_prepare(inspect and "INSERT INTO echo_discord_binding VALUES(1,?);" and rooted_literal_1) and 101) is not equal to 0:
            set closed to sql_close(inspect)
            return 0
    else:
        set closed to sql_close(inspect)
        return 0
    set closed to sql_close(inspect)
    set database to archive_open(path)
    if database equals 0:
        return 0
    if web_run_schema(database) is not equal to 0:
        set closed to sql_close(database)
        return 0
    set upgraded to concat(group_output_schema(database) and "")
    if not (upgraded equals "applied" or else upgraded equals "already-applied"):
        set closed to sql_close(database)
        return 0
    if discord_joined_schema(database) is not equal to 0:
        set closed to sql_close(database)
        return 0
    return database

# Transport-authenticated user ID supplies the device identity. Random pairing
# material is host-internal and never given to Discord users or the model.
define discord_agent_principal with database as Int and user as Str and admins as List returning Str:
    if discord_snowflake(user) equals 0:
        return ""
    set device to concat("discord:" and user)
    set rooted_literal_2 to create_list()
    set retained_value_added to append_list(rooted_literal_2 and device)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT revoked FROM echo_devices WHERE device=?;" and rooted_literal_2))
    if archive_list_text(row and 0) equals "end":
        set invitation to ptr_to_str(ep_uuid_v4())
        set credential to ptr_to_str(ep_uuid_v4())
        if web_pairing_invite(database and invitation) is not equal to 0 or else web_device_pair(database and invitation and device and device and credential) is not equal to 0:
            return ""
    else if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 1) equals "0"):
        return ""
    set principal to principal_for_device(database and device)
    if string_length(principal) equals 0:
        return ""
    set role to "user"
    if discord_contains(admins and user) equals 1:
        set role to "admin"
    if not (principal_role(database and principal) equals role):
        if not (principal_host_role(database and ptr_to_str(ep_uuid_v4()) and principal and role and "Trusted Discord adapter: current explicit admin ID configuration") equals "recorded"):
            return ""
    return device

# Fresh destination/audience permission checks belong to the host worker
# before this call and again before releasing output. This function cannot
# infer Discord permissions from message text or a stored role label.
define discord_agent_submit with journal as Int and database as Int and inbox as Str and bot as Str and guilds as List and admins as List returning List:
    return discord_agent_submit_media(journal and database and inbox and bot and guilds and admins and "" and "")

define discord_agent_submit_media with journal as Int and database as Int and inbox as Str and bot as Str and guilds as List and admins as List and directory_path as Str and fresh_message as Str returning List:
    if not (string_index_of(inbox and "message:create:") equals 0):
        set rooted_literal_3 to create_list()
        set retained_value_added to append_list(rooted_literal_3 and "not-user-intake")
        return rooted_literal_3
    set rooted_literal_4 to create_list()
    set retained_value_added to append_list(rooted_literal_4 and inbox)
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT payload FROM discord_inbox WHERE identity=? AND kind='MESSAGE_CREATE';" and rooted_literal_4))
    if not (archive_list_text(row and 0) equals "found"):
        set rooted_literal_5 to create_list()
        set retained_value_added to append_list(rooted_literal_5 and "intake-unavailable")
        return rooted_literal_5
    set original to archive_list_text(row and 1)
    set tokens to provider_json_tokens(original)
    set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set target to provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "message_reference") and "message_id"))
    set route to discord_message_route(original and bot and guilds and admins and discord_reply_channel(journal and target and room))
    if not (archive_list_text(route and 0) equals "accepted"):
        set rooted_literal_6 to create_list()
        set retained_value_added to append_list(rooted_literal_6 and "intake-no-longer-authorized")
        return rooted_literal_6
    set manifest to discord_attachment_manifest(original)
    if string_length(manifest) equals 0:
        return history_status("invalid-attachments")
    set has_files to not (manifest equals "[]")
    if has_files and string_length(directory_path) equals 0:
        set rooted_literal_7 to create_list()
        set retained_value_added to append_list(rooted_literal_7 and "attachment-import-required")
        return rooted_literal_7
    set device to discord_agent_principal(database and archive_list_text(route and 3) and admins)
    if string_length(device) equals 0:
        set rooted_literal_8 to create_list()
        set retained_value_added to append_list(rooted_literal_8 and "principal-unavailable")
        return rooted_literal_8
    set server to archive_list_text(route and 1)
    if string_length(server) equals 0:
        set server to concat("dm:" and bot)
    set run to concat("discord-message:" and archive_list_text(route and 4))
    set selected_group to discord_joined_target(database and device and server and room and run)
    if not (archive_list_text(selected_group and 0) equals "selected"):
        return selected_group
    set group_id to archive_list_text(selected_group and 1)
    set attachments to create_list()
    set media_session to ""
    set media_revision to ""
    if has_files:
        if web_attachment_schema(database) is not equal to 0:
            return history_status("attachment-store-unavailable")
        if not (discord_attachment_manifest(fresh_message) equals manifest):
            return history_status("attachment-source-changed")
        set selected to discord_media_session(database and device and group_id and server and room and run)
        if not (archive_list_text(selected and 0) equals "routed"):
            return selected
        set media_session to archive_list_text(selected and 1)
        set media_revision to archive_list_text(selected and 2)
        set fresh_tokens to provider_json_tokens(fresh_message)
        for each item in provider_items(fresh_tokens and provider_member(fresh_tokens and 0 and "attachments")):
            set imported to discord_attachment_import(database and device and archive_list_text(selected and 1) and room and archive_list_text(route and 4) and fresh_tokens and item and directory_path)
            if not (archive_list_text(imported and 0) equals "imported"):
                return imported
            set added to append_list(attachments and archive_list_text(imported and 1))
            set decoded to discord_audio_decode(database and device and archive_list_text(selected and 1) and archive_list_text(imported and 1) and directory_path)
            if not (archive_list_text(decoded and 0) equals "decoded"):
                return decoded
            if not (archive_list_text(decoded and 1) equals archive_list_text(imported and 1)):
                set added to append_list(attachments and archive_list_text(decoded and 1))
    set submitted to create_list()
    if has_files:
        # Keep the selection made before I/O. /new during the download must
        # not silently redirect these already imported sources on submission.
        set status to group_run_submit_attachments(database and device and run and media_session and "discord" and server and room and archive_list_text(route and 5) and attachments)
        set submitted to [status,media_session,media_revision]
    else:
        set submitted to group_route_submit_files(database and device and group_id and "discord" and server and room and run and archive_list_text(route and 5) and attachments)
    if archive_list_text(submitted and 0) equals "accepted" or else archive_list_text(submitted and 0) equals "already-accepted":
        if discord_agent_sender_record(database and run and original) is not equal to 0:
            return ["sender-record-unavailable"]
        set added to append_list(submitted and run)
    return submitted

# Existing accepted runs are pinned before import, not only at final submit.
# Scope and current membership are still checked by import and submission.
define discord_media_session with database as Int and device as Str and group_id as Str and server as Str and room as Str and run as Str returning List:
    set old to history_collect_one(checkpoint_prepare(database and "SELECT s.session,CAST(s.revision AS TEXT) FROM echo_group_run_origins g JOIN echo_group_sessions s ON s.session=g.session WHERE g.run=?1 AND s.group_id=?2 AND g.device=?3;" and [run,group_id,device]))
    if archive_list_text(old and 0) equals "found":
        return ["routed",archive_list_text(old and 1),archive_list_text(old and 2)]
    if not (archive_list_text(old and 0) equals "end"):
        return history_status("route-read-failed")
    return group_route(database and device and group_id and "discord" and server and room)

# Capture account labels from the authenticated Gateway envelope at admission.
# Names are descriptive untrusted strings, never identity/permission keys.
define discord_agent_sender_record with database as Int and run as Str and original as Str returning Int:
    set owner to agent_run_read(database and run)
    if owner equals 0:
        return 1
    set identity to concat(run and ":discord-sender")
    set saved to archive_read_event(database and identity)
    if saved is not equal to 0:
        return 0
    set tokens to provider_json_tokens(original)
    set author to provider_member(tokens and 0 and "author")
    set user to provider_value(tokens and provider_member(tokens and author and "id"))
    if discord_snowflake(user) equals 0:
        return 1
    set username to discord_sender_label(tokens and provider_member(tokens and author and "username"))
    set global_name to discord_sender_label(tokens and provider_member(tokens and author and "global_name"))
    set member to provider_member(tokens and 0 and "member")
    set nickname to discord_sender_label(tokens and provider_member(tokens and member and "nick"))
    set display_name to nickname
    if string_length(display_name) equals 0:
        set display_name to global_name
    if string_length(display_name) equals 0:
        set display_name to username
    set payload to concat("{\"user_id\":" and provider_quote(user))
    set payload to concat(payload and concat(",\"username\":" and provider_quote(username)))
    set payload to concat(payload and concat(",\"display_name\":" and provider_quote(display_name)))
    set payload to concat(payload and concat(",\"global_name\":" and provider_quote(global_name)))
    set payload to concat(payload and concat(",\"server_nickname\":" and concat(provider_quote(nickname) and "}")))
    return archive_append(database and archive_list_text(owner and 0) and identity and "discord_sender" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms())))

define discord_sender_label with tokens as List and field as Int returning Str:
    if not (provider_kind(tokens and field) equals "string"):
        return ""
    set value to provider_value(tokens and field)
    if string_length(value) > 256:
        return ""
    return value
