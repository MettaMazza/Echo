import "permissions"
import "../agent/run_messages"

# Check the Discord overwrite exception using zero base permissions while
# preserving actual role membership and overwrite precedence.
define discord_overwrite_role_grant with roles as Str and member as Str and target as Str and guild as Str and user as Str and room as Str returning Int:
    set tokens to provider_json_tokens(roles)
    return discord_overwrite_role_grant_items(tokens and provider_items(tokens and 0) and member and target and guild and user and room)

define discord_overwrite_role_grant_items with tokens as List and items as List and member as Str and target as Str and guild as Str and user as Str and room as Str returning Int:
    set zero_roles to "["
    set count to 0
    for each item in items:
        set identity to provider_value(tokens and provider_member(tokens and item and "id"))
        if discord_snowflake(identity) equals 0:
            return -1
        if count > 0:
            set zero_roles to concat(zero_roles and ",")
        set zero_roles to concat(zero_roles and concat("{\"id\":" and concat(provider_quote(identity) and ",\"permissions\":\"0\"}")))
        set count to count + 1
    set zero_roles to concat(zero_roles and "]")
    set server to concat("{\"id\":" and concat(provider_quote(guild) and ",\"owner_id\":\"0\"}"))
    return discord_channel_permission(server and zero_roles and member and target and guild and user and room and 28)

# Every set bit must be held at guild or verified parent scope, unless the
# actor has the documented target-channel MANAGE_ROLES overwrite exception.
define discord_overwrite_assignment with server as Str and roles as Str and member as Str and target as Str and parent as Str and guild as Str and user as Str and room as Str and allow as Str and deny as Str returning Int:
    if discord_channel_permission(server and roles and member and target and guild and user and room and 28) is not equal to 1 or else discord_channel_permission(server and roles and member and target and guild and user and room and 10) is not equal to 1:
        return 0
    if discord_overwrite_role_grant(roles and member and target and guild and user and room) equals 1:
        return 1
    set base to concat("{\"id\":" and concat(provider_quote(room) and concat(",\"guild_id\":" and concat(provider_quote(guild) and ",\"permission_overwrites\":[]}"))))
    set parent_tokens to provider_json_tokens(parent)
    set parent_id to provider_value(parent_tokens and provider_member(parent_tokens and 0 and "id"))
    set bit to 0
    repeat while bit <= 52:
        if discord_permission_bit(allow and bit) equals 1 or else discord_permission_bit(deny and bit) equals 1:
            if discord_channel_permission(server and roles and member and base and guild and user and room and bit) is not equal to 1:
                if string_length(parent_id) equals 0 or else discord_channel_permission(server and roles and member and parent and guild and user and parent_id and bit) is not equal to 1:
                    return 0
        set bit to bit + 1
    return 1
