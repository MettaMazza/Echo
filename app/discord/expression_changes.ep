import "rich_post"
import "routing"

# Validate metadata before resource permissions and scoped file resolution.
# Upload bytes, role existence and guild ownership are controller checks.
define discord_expression_changes with body as Str and kind as Str and creating as Int returning Int:
    if not (kind equals "emoji" or else kind equals "sticker") or else (creating is not equal to 0 and also creating is not equal to 1):
        return 0
    set fields to provider_json_tokens(body)
    if fields equals 0 or else provider_unique_objects(fields) equals 0:
        return 0
    set allowed to "|name|roles|"
    if kind equals "sticker":
        set allowed to "|name|description|tags|"
    if discord_rich_keys(fields and 0 and allowed) equals 0:
        return 0
    set name to provider_member(fields and 0 and "name")
    set description to provider_member(fields and 0 and "description")
    set tags to provider_member(fields and 0 and "tags")
    set roles to provider_member(fields and 0 and "roles")
    if name < 0 and also description < 0 and also tags < 0 and also roles < 0:
        return 0
    if creating equals 1 and also name < 0:
        return 0
    if name >= 0:
        set maximum to 32
        if kind equals "sticker":
            set maximum to 30
        if discord_rich_text(fields and name and maximum and 1) < 0 or else discord_rich_units(provider_value(fields and name)) < 2:
            return 0
    if kind equals "sticker":
        if creating equals 1 and also (description < 0 or else tags < 0):
            return 0
        if description >= 0:
            if provider_kind(fields and description) equals "null":
                if creating equals 1:
                    return 0
            else:
                set size to discord_rich_text(fields and description and 100 and 0)
                if creating equals 1 and also provider_kind(fields and description) equals "string" and also string_length(provider_value(fields and description)) equals 0:
                    set size to 0
                if size < 0 or else size equals 1 or else (creating equals 0 and also size equals 0):
                    return 0
        if tags >= 0 and also discord_rich_text(fields and tags and 200 and 1) < 0:
            return 0
    if roles >= 0:
        if provider_kind(fields and roles) equals "null":
            return creating equals 0
        if not (provider_kind(fields and roles) equals "["):
            return 0
        set seen to "|"
        set index to roles + 1
        repeat while not (provider_kind(fields and index) equals "]"):
            set role to provider_value(fields and index)
            set marker to concat("|" and concat(role and "|"))
            if not (provider_kind(fields and index) equals "string") or else discord_snowflake(role) equals 0 or else string_contains(seen and marker) > 0:
                return 0
            set seen to concat(seen and concat(role and "|"))
            set index to provider_after(fields and index)
            if provider_kind(fields and index) equals ",":
                set index to index + 1
    return 1
