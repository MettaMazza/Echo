import "group_control"
import "command_authority"
import "agent_bridge"

# Invoked only after the command executor's fresh channel-access check.
# A member option identifies an invitation target, not an authenticated actor.
define discord_group_command_apply with journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List returning Str:
    if discord_command_acknowledged(journal and identity and body) equals 0:
        return "command-not-acknowledged"
    set command to discord_command_resolve(journal and body and bot and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access") or else not (archive_list_text(command and 1) equals "group"):
        return "command-binding-denied"
    set device to discord_agent_principal(database and archive_list_text(command and 2) and admins)
    if string_length(device) equals 0:
        return "principal-unavailable"
    set arguments to archive_list_text(command and 5)
    set fields to provider_json_tokens(arguments)
    set offer to history_status("offer-not-needed")
    set source_index to provider_member(fields and 0 and "source")
    if source_index >= 0:
        set offer to discord_group_offer_read(journal and provider_value(fields and source_index) and archive_list_text(command and 2) and archive_list_text(command and 4) and archive_list_text(command and 3))
        if not (archive_list_text(offer and 0) equals "found"):
            return concat("group-control:Offer was not accepted: " and archive_list_text(offer and 0))
    set member to ""
    set target to provider_member(fields and 0 and "member")
    if target >= 0:
        set target_device to discord_agent_principal(database and provider_value(fields and target) and admins)
        set member to principal_for_device(database and target_device)
        if string_length(member) equals 0:
            return "principal-unavailable"
    set operation to concat("discord-group:" and identity)
    if source_index >= 0:
        set operation to concat("discord-group-offer:" and provider_value(fields and source_index))
    set result to discord_group_request(database and device and archive_list_text(command and 4) and archive_list_text(command and 3) and operation and arguments and member)
    set parsed to provider_json_tokens(result)
    set status to provider_value(parsed and provider_member(parsed and 0 and "status"))
    if status equals "writer-lock-unavailable" or else status equals "commit-failed" or else status equals "group-read-failed" or else status equals "selection-read-failed" or else status equals "selection-write-failed":
        return "store-failed"
    if source_index >= 0 and (status equals "created" or else status equals "already-created"):
        set group_id to provider_value(parsed and provider_member(parsed and 0 and "group"))
        set finished to discord_group_offer_accept(journal and database and device and group_id and operation and offer and admins)
        if not (finished equals "enqueued" or else finished equals "already-enqueued"):
            return concat("group-control:Shared conversation created; invitation delivery remains pending: " and finished)
        return concat("group-control:Shared conversation: " and concat(group_id and "\nInvitation receipts are saved. Each account chooses whether to join. Use /group open to select this conversation; only the public initiating message is shared."))
    # The existing response writer suppresses mentions and edits the same
    # private command response. No new public message is posted on retries.
    return concat("group-control:" and discord_group_caption(result))

define discord_group_caption with result as Str returning Str:
    set fields to provider_json_tokens(result)
    set status to provider_value(fields and provider_member(fields and 0 and "status"))
    set group_id to provider_value(fields and provider_member(fields and 0 and "group"))
    if status equals "found" and provider_member(fields and 0 and "groups") >= 0:
        set message to "Your joined conversations and invitations in this channel:"
        set items to provider_items(fields and provider_member(fields and 0 and "groups"))
        set last to ""
        for each item in items:
            set last to provider_value(fields and provider_member(fields and item and "group"))
            set membership to provider_value(fields and provider_member(fields and item and "membership"))
            set revision to provider_value(fields and provider_member(fields and item and "revision"))
            set message to concat(message and concat("\n" and concat(last and concat(" — " and concat(membership and concat(", revision " and revision))))))
        if length_list(items) equals 0:
            return "No joined conversations or invitations in this channel. Use /group create to start one."
        return concat(message and concat("\nNext page: /group list after:" and last))
    if status equals "found":
        set message to concat(group_id and concat("\nMembership: " and provider_value(fields and provider_member(fields and 0 and "membership"))))
        return concat(message and concat("\nRevision: " and provider_value(fields and provider_member(fields and 0 and "revision"))))
    if status equals "created" or else status equals "already-created":
        return concat("Shared conversation created and selected: " and concat(group_id and "\nUse /group invite to invite an account. It must choose /group join before participating."))
    if status equals "selected" or else status equals "already-selected":
        if string_length(group_id) equals 0:
            return "Your personal conversation is selected. Existing group history is preserved."
        return concat("Shared conversation selected: " and group_id)
    if status equals "recorded" or else status equals "already-recorded":
        return concat("Membership change saved for " and concat(group_id and ". Use /group inspect for its current revision. An invitation does not force anyone to join."))
    return concat("Group action was not accepted: " and concat(status and ". Check your membership, channel and the latest revision with /group inspect."))

# Replay each invitation by its immutable membership operation, even after a
# later leave/remove. Retrying acceptance must not invite that person again.
define discord_group_offer_accept with journal as Int and database as Int and device as Str and group_id as Str and identity as Str and offer as List and admins as List returning Str:
    set original to archive_list_text(offer and 1)
    set source to provider_json_tokens(original)
    set guild to provider_value(source and provider_member(source and 0 and "guild_id"))
    set room to provider_value(source and provider_member(source and 0 and "channel_id"))
    if discord_joined_namespace(database and group_id and guild and room) equals 0:
        return "offer-group-denied"
    set seeded to discord_group_seed_bind(database and group_id and original)
    if not (seeded equals "recorded"):
        return seeded
    set targets to provider_json_tokens(archive_list_text(offer and 2))
    set items to provider_items(targets and 0)
    for each item in items:
        set target to provider_value(targets and item)
        set target_device to discord_agent_principal(database and target and admins)
        set principal to principal_for_device(database and target_device)
        if string_length(principal) equals 0:
            return "invitee-unavailable"
        set operation to concat("discord-group-offer-invite:" and concat(identity and concat(":" and target)))
        set values to create_list()
        set added to append_list(values and operation)
        set added to append_list(values and group_id)
        set revision to history_collect_one(checkpoint_prepare(database and "SELECT COALESCE((SELECT revision-1 FROM echo_group_membership WHERE identity=?1),(SELECT MAX(revision) FROM echo_group_membership WHERE group_id=?2));" and values))
        if not (archive_list_text(revision and 0) equals "found"):
            return "membership-read-failed"
        set changed to discord_joined_change(database and device and guild and room and operation and group_id and principal and "invited" and http_decimal(archive_list_text(revision and 1)))
        if not (changed equals "recorded" or else changed equals "already-recorded"):
            return changed
    set content to concat("Shared conversation invitation: " and concat(group_id and ". Tagged accounts can use /group list, then /group join with the group and its current revision. Joining is optional; personal histories remain separate."))
    set message to provider_value(source and provider_member(source and 0 and "id"))
    set body to concat("{\"content\":" and concat(provider_quote(content) and concat(",\"allowed_mentions\":{\"parse\":[],\"replied_user\":false},\"message_reference\":{\"message_id\":" and concat(provider_quote(message) and ",\"fail_if_not_exists\":true}}"))))
    return discord_outbox_enqueue(journal and concat("discord-group-invitation:" and identity) and archive_list_text(offer and 3) and room and body)
