import "voice_recording_controller"
import "select"

# One slow control thread per exclusive native voice owner. It owns its own
# SQLite connections and all controller state. No REST or SQLite handle crosses
# into the audio thread. The host must join completed before releasing config.
# Restart recovery belongs to the exclusive service startup, before admitting
# new recording requests; starting this helper must not interrupt a new request.
define discord_voice_recording_controller_worker with config as List and stop as Int and completed as Int returning Int:
    if config equals 0 or else length_list(config) is not equal to 11:
        send 1 to completed
        return 1
    set journal to sql_open(archive_list_text(config and 2))
    set database to sql_open(archive_list_text(config and 3))
    set status to 0
    if journal equals 0 or else database equals 0:
        set status to 1
    else:
        if sql_execute(journal and "PRAGMA busy_timeout=5000;") is not equal to 0 or else sql_execute(database and "PRAGMA busy_timeout=5000; PRAGMA query_only=ON;") is not equal to 0 or else discord_voice_recording_offer_schema(journal) is not equal to 0:
            set status to 1
    set state to discord_voice_recording_controller_new(archive_list_text(config and 4))
    if state equals 0:
        set status to 1
    set waits to create_list()
    set added to append_list(waits and stop)
    repeat while status equals 0:
        if file_exists(archive_list_text(config and 9)):
            break
        if select(waits and 0) >= 0:
            set signal to receive from stop
            break
        set outcome to discord_voice_recording_controller_tick(journal and database and state and config)
        if outcome equals "stopped":
            break
        # Bounded cadence, including failures. This channel wait wakes promptly
        # on shutdown; an in-progress REST call retains its existing deadline.
        if select(waits and 1000) >= 0:
            set signal to receive from stop
            break
    if journal is not equal to 0:
        if discord_voice_recording_recover(journal and archive_list_text(config and 4)) is not equal to 0:
            set status to 1
        set closed to sql_close(journal)
    if database is not equal to 0:
        set closed to sql_close(database)
    send status to completed
    return status

# Host-owned lifetime. Joining is idempotent and consumes completion exactly
# once. The voice socket must already be closed before waiting for slow REST.
define discord_voice_recording_controller_start with config as List returning List:
    if config equals 0 or else length_list(config) is not equal to 11:
        return 0
    set stop to channel
    set completed to channel
    set state to [stop,completed,-1]
    spawn discord_voice_recording_controller_worker(config and stop and completed)
    return state

define discord_voice_recording_controller_join with state as List returning Str:
    if state equals 0 or else length_list(state) is not equal to 3:
        return "recording-controller-failed"
    if get_list(state and 2) equals -1:
        send 1 to get_list(state and 0)
        set status to receive from get_list(state and 1)
        set changed to set_list(state and 2 and status)
    if get_list(state and 2) is not equal to 0:
        return "recording-controller-failed"
    return "recording-controller-stopped"
