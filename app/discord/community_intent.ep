import "store"

# Claim is persisted before network mutation. A repeated call never repeats an
# uncertain POST/PATCH/DELETE. The immutable agent ledger supplies the result.
define discord_community_claim with journal as Int and run as Str and call_id as Str and body as Str returning Str:
    if sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_community_intents(run TEXT NOT NULL,call_id TEXT NOT NULL,body TEXT NOT NULL,PRIMARY KEY(run,call_id)); CREATE TRIGGER IF NOT EXISTS discord_community_intents_no_update BEFORE UPDATE ON discord_community_intents BEGIN SELECT RAISE(ABORT,'Community intent is immutable'); END; CREATE TRIGGER IF NOT EXISTS discord_community_intents_no_delete BEFORE DELETE ON discord_community_intents BEGIN SELECT RAISE(ABORT,'Community intent persists'); END;") is not equal to 0:
        return "intent-store-unavailable"
    set keys to [run,call_id,body]
    if archive_finish(checkpoint_prepare(journal and "INSERT OR IGNORE INTO discord_community_intents VALUES(?1,?2,?3);" and keys) and 101) is not equal to 0:
        return "intent-store-unavailable"
    set changed to history_collect_one(archive_prepare(journal and "SELECT changes();"))
    if archive_list_text(changed and 1) equals "1":
        return "claimed"
    return "already-attempted; inspect retained results and remote state; never automatically replay"
