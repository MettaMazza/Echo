import "question_action"
import "run_source"

# Public controls do not grant access. Refresh the actor's current channel
# access and original source before any draft or answer operation.
define discord_question_action_tick with library as Str and token as Str and journal as Int and database as Int and identity as Str and body as Str and bot as Str and guilds as List and admins as List and directory_path as Str and stop_file as Str returning Str:
    if file_exists(stop_file):
        return "stopped"
    set control to discord_question_control_resolve(journal and body and bot)
    if not (archive_list_text(control and 0) equals "found"):
        return archive_list_text(control and 0)
    set inbox to archive_list_text(control and 7)
    set source to discord_intake_source(journal and inbox)
    if not (archive_list_text(source and 0) equals "found"):
        return "source-unavailable"
    if string_length(archive_list_text(source and 5)) > 0 and also discord_contains(guilds and archive_list_text(source and 5)) equals 0:
        return "question-authority-denied"
    set access to discord_access_check(library and token and journal and directory_path and bot and archive_list_text(source and 5) and archive_list_text(source and 4) and archive_list_text(source and 3) and admins)
    if not (archive_list_text(access and 0) equals "allowed"):
        return "source-access-denied"
    if not (discord_run_source_check(library and token and journal and directory_path and inbox and source) equals "current"):
        return "source-changed"
    if file_exists(stop_file):
        return "stopped"
    return discord_question_action_apply(journal and database and identity and body and bot)
