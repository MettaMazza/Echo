import "store"

# Derived index only. Originals remain immutable, and callers must revalidate
# every match with Discord before exposing it. No index content is a receipt
# of current visibility. Atomic checkpointing makes interrupted replay safe.
define discord_message_index_refresh with journal as Int returning Int:
    if sql_execute(journal and "CREATE TABLE IF NOT EXISTS discord_message_index(message TEXT PRIMARY KEY,room TEXT NOT NULL,content TEXT NOT NULL,deleted INTEGER NOT NULL,sequence INTEGER NOT NULL); CREATE INDEX IF NOT EXISTS discord_message_index_room ON discord_message_index(room,sequence); CREATE TABLE IF NOT EXISTS discord_message_index_cursor(singleton INTEGER PRIMARY KEY CHECK(singleton=1),sequence INTEGER NOT NULL); INSERT OR IGNORE INTO discord_message_index_cursor VALUES(1,0);") is not equal to 0:
        return 1
    if sql_execute(journal and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    set statement to archive_prepare(journal and "SELECT rowid,kind,payload FROM discord_inbox WHERE rowid>(SELECT sequence FROM discord_message_index_cursor WHERE singleton=1) ORDER BY rowid;")
    if statement equals 0:
        set rolled to sql_execute(journal and "ROLLBACK;")
        return 1
    set failed to 0
    set row to discord_message_index_row(statement)
    repeat while archive_list_text(row and 0) equals "found":
        set sequence to archive_list_text(row and 1)
        set kind to archive_list_text(row and 2)
        set tokens to provider_json_tokens(archive_list_text(row and 3))
        if tokens is not equal to 0 and also provider_unique_objects(tokens) is not equal to 0:
            set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
            set message to provider_value(tokens and provider_member(tokens and 0 and "id"))
            if discord_snowflake(room) is not equal to 0:
                if (kind equals "MESSAGE_CREATE" or else kind equals "MESSAGE_UPDATE" or else kind equals "REST_MESSAGE_OBSERVATION") and discord_snowflake(message) is not equal to 0:
                    set field to provider_member(tokens and 0 and "content")
                    if provider_kind(tokens and field) equals "string":
                        set content to provider_value(tokens and field)
                        set keys to [message,room,content,sequence]
                        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_message_index VALUES(?1,?2,?3,0,CAST(?4 AS INTEGER)) ON CONFLICT(message) DO UPDATE SET content=excluded.content,sequence=excluded.sequence WHERE room=excluded.room AND deleted=0;" and keys) and 101) is not equal to 0:
                            set failed to 1
                else if kind equals "MESSAGE_DELETE" and discord_snowflake(message) is not equal to 0:
                    set failed to discord_message_index_delete(journal and room and message and sequence)
                else if kind equals "MESSAGE_DELETE_BULK":
                    set ids to provider_member(tokens and 0 and "ids")
                    if provider_kind(tokens and ids) equals "[":
                        for each item in provider_items(tokens and ids):
                            set message to provider_value(tokens and item)
                            if discord_snowflake(message) is not equal to 0:
                                if discord_message_index_delete(journal and room and message and sequence) is not equal to 0:
                                    set failed to 1
        if failed is not equal to 0:
            break
        if archive_finish(checkpoint_prepare(journal and "UPDATE discord_message_index_cursor SET sequence=CAST(?1 AS INTEGER) WHERE singleton=1;" and [sequence]) and 101) is not equal to 0:
            set failed to 1
            break
        set row to discord_message_index_row(statement)
    set finalized to ep_sqlite3_finalize(statement)
    if failed is not equal to 0 or else not (archive_list_text(row and 0) equals "end"):
        set rolled to sql_execute(journal and "ROLLBACK;")
        return 1
    if sql_execute(journal and "COMMIT;") is not equal to 0:
        set rolled to sql_execute(journal and "ROLLBACK;")
        return 1
    return 0

define discord_message_index_delete with journal as Int and room as Str and message as Str and sequence as Str returning Int:
    set keys to [message,room,sequence]
    return archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_message_index VALUES(?1,?2,'',1,CAST(?3 AS INTEGER)) ON CONFLICT(message) DO UPDATE SET content='',deleted=1,sequence=excluded.sequence WHERE room=excluded.room;" and keys) and 101)

define discord_message_index_candidates with journal as Int and room as Str and query as Str and before as Str and limit as Str returning Int:
    set keys to [room,query,before,limit]
    return checkpoint_prepare(journal and "SELECT message,sequence FROM discord_message_index WHERE room=?1 AND deleted=0 AND instr(content,?2)>0 AND (?3='' OR sequence<CAST(?3 AS INTEGER)) ORDER BY sequence DESC LIMIT CAST(?4 AS INTEGER);" and keys)

# Caller retains/finalizes this iterator; history_collect_one deliberately
# accepts only a single row and cannot be used for a multi-row scan.
define discord_message_index_row with statement as Int returning List:
    if statement equals 0:
        return history_status("error")
    set status to ep_sqlite3_step(statement)
    if status equals 101:
        return history_status("end")
    if status is not equal to 100:
        return history_status("error")
    set row to history_status("found")
    set column to 0
    repeat while column < ep_sqlite3_column_count(statement):
        set value to concat(ptr_to_str(ep_sqlite3_column_text(statement and column)) and "")
        set added to append_list(row and value)
        set column to column + 1
    return row

# REST observations are labelled as such, never fabricated Gateway events.
# Store only the validated current-channel projection plus its retained receipt.
define discord_message_index_observe with journal as Int and page as Str and receipt as Str returning Int:
    set tokens to provider_json_tokens(page)
    for each item in provider_items(tokens and 0):
        set message to provider_value(tokens and provider_member(tokens and item and "id"))
        set room to provider_value(tokens and provider_member(tokens and item and "channel_id"))
        set content to provider_value(tokens and provider_member(tokens and item and "content"))
        set body to concat("{\"id\":" and provider_quote(message))
        set body to concat(body and concat(",\"channel_id\":" and provider_quote(room)))
        set body to concat(body and concat(",\"content\":" and provider_quote(content)))
        set body to concat(body and concat(",\"receipt\":" and concat(provider_quote(receipt) and "}")))
        set identity to concat("rest-message-observation:" and ep_sha256(body))
        set saved to discord_inbox_record(journal and identity and "REST_MESSAGE_OBSERVATION" and body)
        if not (saved equals "recorded" or else saved equals "already-recorded"):
            return 1
    return 0
