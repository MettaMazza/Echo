import "voice_transitions"
import "voice_handshake"

# Streams are private [transition queue, media epoch] pairs. Before touching any
# native media, validate every owner and requested transition. A failed batch
# closes all its media: audio cannot escape with a mixture of epoch keys.
define discord_voice_transition_streams_close with streams as List returning Int:
    if streams is not equal to 0:
        for each stream in streams:
            if stream is not equal to 0 and also length_list(stream) equals 2:
                set closed to discord_voice_transitions_close(get_list(stream and 0))
                set closed to discord_voice_epoch_close(get_list(stream and 1))
    return 1

define discord_voice_transition_execute with transport as List and transition as Int and sequence as Int and streams as List and roster as List and generation as Int returning Str:
    if transport equals 0 or else length_list(transport) is not equal to 8:
        return "invalid-transition-transport"
    set handshake to get_list(transport and 0)
    if discord_voice_handshake_current(handshake and generation) equals 0 or else get_list(handshake and 0) is not equal to 4:
        return "stale-transition-owner"
    if transition < 0 or else transition > 65535 or else sequence < -1 or else sequence > 65535 or else streams equals 0 or else length_list(streams) < 1 or else discord_dave_users_valid(roster) equals 0:
        set closed to discord_voice_transition_streams_close(streams)
        return "invalid-transition-execution"
    for each stream in streams:
        if stream equals 0 or else length_list(stream) is not equal to 2:
            set closed to discord_voice_transition_streams_close(streams)
            return "invalid-transition-stream"
        set queue to get_list(stream and 0)
        set epoch to get_list(stream and 1)
        if queue equals 0 or else length_list(queue) is not equal to 7 or else epoch equals 0 or else length_list(epoch) is not equal to 3:
            set closed to discord_voice_transition_streams_close(streams)
            return "invalid-transition-stream"
        set media to get_list(epoch and 0)
        if media equals 0 or else length_list(media) is not equal to 5 or else get_list(media and 0) equals 0 or else get_list(queue and 5) is not equal to 0 or else get_list(queue and 0) is not equal to get_list(transport and 4) or else get_list(media and 2) is not equal to get_list(transport and 4) or else not (archive_list_text(epoch and 1) equals archive_list_text(queue and 2)):
            set closed to discord_voice_transition_streams_close(streams)
            return "transition-owner-mismatch"
        set eligible to 0
        for each user in roster:
            if ptr_to_str(user) equals archive_list_text(epoch and 1):
                set eligible to 1
        set found to 0
        for each row in get_list(queue and 3):
            if get_list(row and 0) equals transition and also get_list(row and 1) >= get_list(queue and 4):
                set found to 1
        if eligible equals 0 or else found equals 0:
            set closed to discord_voice_transition_streams_close(streams)
            return "transition-not-current"
    for each stream in streams:
        set applied to discord_voice_transitions_execute(get_list(stream and 0) and transition and get_list(stream and 1) and roster)
        if not (applied equals "transition-applied" or else applied equals "transition-duplicate"):
            set closed to discord_voice_transition_streams_close(streams)
            return applied
    if sequence >= 0 and also discord_voice_heartbeat_sequence(get_list(handshake and 1) and sequence and generation) equals 0:
        set closed to discord_voice_transition_streams_close(streams)
        return "transition-execute-ack-failed"
    return "transition-executed"
