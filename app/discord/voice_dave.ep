import "../research/native_ffi"

# Host-pinned native library only; never exposed as a model-supplied path.
# Session owns its library reference. Returned blobs own copied bytes, so they
# remain valid after a session closes and never borrow a libdave allocation.
define discord_dave_close with state as List returning Int:
    if state equals 0 or else length_list(state) is not equal to 4:
        return 0
    set library to get_list(state and 0)
    set session to get_list(state and 1)
    if library equals 0:
        return 1
    if session is not equal to 0:
        set destroyed to ep_dlcall1(ep_dlsym(library and "daveSessionDestroy") and session)
    set callbacks to get_list(state and 2)
    set released to ep_dlcall1(ep_dlsym(callbacks and "echo_voice_failure_state_destroy") and get_list(state and 3))
    set dropped to ep_dlcall0(ep_dlsym(callbacks and "echo_voice_logging_drop"))
    set changed to set_list(state and 1 and 0)
    set changed to set_list(state and 0 and 0)
    set changed to set_list(state and 2 and 0)
    set changed to set_list(state and 3 and 0)
    set closed to ep_dlclose(library)
    set closed to ep_dlclose(callbacks)
    return 1

# DAVE registers native TLS destructors. Their code must remain mapped until
# every calling thread exits, beyond session destruction and completion sends.
# Darwin RTLD_NOW|RTLD_LOCAL|RTLD_NODELETE (2|4|128) retains the code mapping;
# session, callback state, key buffers and each dlopen reference still close.
# Only the existing pinned host path reaches this adapter.
define discord_dave_library_open with path as Str returning Int:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if system equals 0:
        return 0
    set open_function to ep_dlsym(system and "dlopen")
    set library to 0
    if open_function is not equal to 0:
        set library to ep_dlcall2(open_function and str_to_ptr(path) and 134)
    set closed to ep_dlclose(system)
    return library

define discord_dave_open with path as Str and callback_path as Str and version as Int and group as Int and user as Str returning List:
    if version < 1 or else version > 65535 or else group < 1 or else string_length(user) < 1 or else string_length(user) > 20:
        return 0
    set index to 0
    repeat while index < string_length(user):
        set code to peek_byte(str_to_ptr(user) and index)
        if code < 48 or else code > 57:
            return 0
        set index to index + 1
    if string_to_int(user) < 1:
        return 0
    set library to discord_dave_library_open(path)
    if library equals 0:
        return 0
    set required to create_list()
    set required to ["daveMaxSupportedProtocolVersion","daveSessionCreate","daveSessionDestroy","daveSessionInit","daveSessionGetProtocolVersion","daveSessionGetMarshalledKeyPackage","daveFree","daveSetLogSinkCallback","daveSessionSetExternalSender","daveSessionProcessProposals","daveSessionProcessCommit","daveSessionProcessWelcome","daveCommitResultGetRosterMemberIds","daveCommitResultDestroy","daveCommitResultIsFailed","daveCommitResultIsIgnored","daveWelcomeResultGetRosterMemberIds","daveWelcomeResultDestroy"]
    for each name in required:
        if ep_dlsym(library and ptr_to_str(name)) equals 0:
            set closed to ep_dlclose(library)
            return 0
    set maximum to ep_dlcall0(ep_dlsym(library and "daveMaxSupportedProtocolVersion"))
    if version > maximum:
        set closed to ep_dlclose(library)
        return 0
    set callbacks to ep_dlopen(callback_path)
    if callbacks equals 0:
        set closed to ep_dlclose(library)
        return 0
    set callback_names to create_list()
    set callback_names to ["echo_voice_failure_state_create","echo_voice_failure_state_destroy","echo_voice_failure_count","echo_voice_failure_callback","echo_voice_logging_hold","echo_voice_logging_drop"]
    for each name in callback_names:
        if ep_dlsym(callbacks and ptr_to_str(name)) equals 0:
            set closed to ep_dlclose(callbacks)
            set closed to ep_dlclose(library)
            return 0
    set failure_state to ep_dlcall0(ep_dlsym(callbacks and "echo_voice_failure_state_create"))
    if failure_state equals 0:
        set closed to ep_dlclose(callbacks)
        set closed to ep_dlclose(library)
        return 0
    if ep_dlcall1(ep_dlsym(callbacks and "echo_voice_logging_hold") and ep_dlsym(library and "daveSetLogSinkCallback")) is not equal to 1:
        set released to ep_dlcall1(ep_dlsym(callbacks and "echo_voice_failure_state_destroy") and failure_state)
        set closed to ep_dlclose(callbacks)
        set closed to ep_dlclose(library)
        return 0
    # Native callback state never points into movable Ernos values. No keys
    # persist, and native debug payloads do not enter ordinary worker logs.
    set session to ep_dlcall4(ep_dlsym(library and "daveSessionCreate") and 0 and 0 and ep_dlsym(callbacks and "echo_voice_failure_callback") and failure_state)
    set state to create_list()
    set added to append_list(state and library)
    set added to append_list(state and session)
    set added to append_list(state and callbacks)
    set added to append_list(state and failure_state)
    if session equals 0:
        set closed to discord_dave_close(state)
        return 0
    set initialized to ep_dlcall4(ep_dlsym(library and "daveSessionInit") and session and version and group and str_to_ptr(user))
    if ep_dlcall1(ep_dlsym(library and "daveSessionGetProtocolVersion") and session) is not equal to version or else discord_dave_failures(state) is not equal to 0:
        set closed to discord_dave_close(state)
        return 0
    return state

define discord_dave_failures with state as List returning Int:
    if state equals 0 or else length_list(state) is not equal to 4 or else get_list(state and 2) equals 0:
        return -1
    return ep_dlcall1(ep_dlsym(get_list(state and 2) and "echo_voice_failure_count") and get_list(state and 3))

define discord_voice_blob_release with blob as List returning Int:
    if blob equals 0 or else length_list(blob) is not equal to 2:
        return 0
    set pointer to get_list(blob and 0)
    set changed to set_list(blob and 0 and 0)
    set changed to set_list(blob and 1 and 0)
    if pointer is not equal to 0:
        free_bytes(pointer)
    return 1

define discord_dave_key_package with state as List returning List:
    if state equals 0 or else length_list(state) is not equal to 4 or else get_list(state and 0) equals 0 or else get_list(state and 1) equals 0:
        return 0
    if discord_dave_failures(state) is not equal to 0:
        return 0
    set library to get_list(state and 0)
    set pointer to research_native_words(1)
    set size to research_native_words(1)
    set fetched to ep_dlcall3(ep_dlsym(library and "daveSessionGetMarshalledKeyPackage") and get_list(state and 1) and get_list_data_ptr(pointer) and get_list_data_ptr(size))
    set raw to get_list(pointer and 0)
    set count to get_list(size and 0)
    if raw equals 0:
        return 0
    # Binary MLS control payload allocation bound; never treat it as text.
    if count < 1 or else count > 1048576 or else discord_dave_failures(state) is not equal to 0:
        set released to ep_dlcall1(ep_dlsym(library and "daveFree") and raw)
        return 0
    set copied to alloc_bytes(count)
    if copied equals 0:
        set released to ep_dlcall1(ep_dlsym(library and "daveFree") and raw)
        return 0
    set index to 0
    repeat while index < count:
        set written to poke_byte(copied and index and peek_byte(raw and index))
        set index to index + 1
    set released to ep_dlcall1(ep_dlsym(library and "daveFree") and raw)
    set blob to create_list()
    set added to append_list(blob and copied)
    set added to append_list(blob and count)
    return blob
