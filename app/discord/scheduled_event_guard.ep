import "member_guard"

# Evaluate requester and bot separately. Bot-created events do not confer
# creator permissions on the requester. Source/admin checks remain separate.
define discord_scheduled_event_permission with server as Str and roles as Str and member as Str and channel_body as Str and guild as Str and person as Str and creator as Str and entity_type as Int and operation as Str returning Int:
    if not (operation equals "read" or else operation equals "create" or else operation equals "modify" or else operation equals "delete") or else entity_type < 1 or else entity_type > 3:
        return 0
    set fields to provider_json_tokens(server)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else not (provider_value(fields and provider_member(fields and 0 and "id")) equals guild):
        return 0
    if discord_member_highest_position(roles and member and guild and person) < 0:
        return 0
    set create_allowed to 0
    set manage_allowed to 0
    if entity_type equals 3:
        if operation equals "read":
            return 1
        set create_allowed to discord_member_guild_permission(server and roles and member and guild and person and 44)
        set manage_allowed to discord_member_guild_permission(server and roles and member and guild and person and 33)
    else:
        set room_fields to provider_json_tokens(channel_body)
        if room_fields equals 0 or else provider_unique_objects(room_fields) equals 0 or else not (provider_value(room_fields and provider_member(room_fields and 0 and "guild_id")) equals guild):
            return 0
        set room to provider_value(room_fields and provider_member(room_fields and 0 and "id"))
        set room_type to provider_value(room_fields and provider_member(room_fields and 0 and "type"))
        if discord_snowflake(room) equals 0 or else (entity_type equals 1 and also not (room_type equals "13")) or else (entity_type equals 2 and also not (room_type equals "2")):
            return 0
        if discord_channel_permission(server and roles and member and channel_body and guild and person and room and 10) equals 0:
            return 0
        if operation equals "read":
            return 1
        if entity_type equals 2:
            if discord_channel_permission(server and roles and member and channel_body and guild and person and room and 20) equals 0:
                return 0
        else:
            if discord_channel_permission(server and roles and member and channel_body and guild and person and room and 4) equals 0 or else discord_channel_permission(server and roles and member and channel_body and guild and person and room and 22) equals 0 or else discord_channel_permission(server and roles and member and channel_body and guild and person and room and 24) equals 0:
                return 0
        set create_allowed to discord_channel_permission(server and roles and member and channel_body and guild and person and room and 44)
        set manage_allowed to discord_channel_permission(server and roles and member and channel_body and guild and person and room and 33)
    if operation equals "create":
        return create_allowed
    return manage_allowed equals 1 or else (creator equals person and also create_allowed equals 1)

# Terminal states cannot reopen; a repeated status is not a new mutation.
define discord_scheduled_event_transition with current as Int and desired as Int returning Int:
    return (current equals 1 and also (desired equals 2 or else desired equals 4)) or else (current equals 2 and also desired equals 3)
