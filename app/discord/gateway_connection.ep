import "gateway_intake"
import "fs"

define discord_monotonic_ms with system as Int returning Int:
    set rooted_literal_1 to create_list()
    set retained_value_added to append_list(rooted_literal_1 and 0)
    set retained_value_added to append_list(rooted_literal_1 and 0)
    set clock to rooted_literal_1
    # Darwin CLOCK_MONOTONIC = 6; timespec has two signed 64-bit fields.
    if ep_dlcall2(ep_dlsym(system and "clock_gettime") and 6 and get_list_data_ptr(clock)) is not equal to 0:
        return -1
    return get_list(clock and 0) * 1000 + get_list(clock and 1) / 1000000

define discord_gateway_health with database as Int and generation as Str and status as Str returning Int:
    if sql_execute(database and "CREATE TABLE IF NOT EXISTS discord_gateway_health(singleton INTEGER PRIMARY KEY CHECK(singleton=1),generation TEXT NOT NULL,status TEXT NOT NULL,observed_ms INTEGER NOT NULL,ack_count INTEGER NOT NULL DEFAULT 0);") is not equal to 0:
        return 1
    set retained_values_1 to create_list()
    set retained_value_added to append_list(retained_values_1 and generation)
    set retained_value_added to append_list(retained_values_1 and status)
    set retained_value_added to append_list(retained_values_1 and int_to_string(ep_time_now_ms()))
    return archive_finish(checkpoint_prepare(database and "INSERT INTO discord_gateway_health(singleton,generation,status,observed_ms,ack_count) VALUES(1,?,?,CAST(? AS INTEGER),CASE WHEN ?2='heartbeat-ack' THEN 1 ELSE 0 END) ON CONFLICT(singleton) DO UPDATE SET generation=excluded.generation,status=excluded.status,observed_ms=excluded.observed_ms,ack_count=CASE WHEN discord_gateway_health.generation=excluded.generation THEN discord_gateway_health.ack_count+excluded.ack_count ELSE excluded.ack_count END;" and retained_values_1) and 101)

define discord_gateway_heartbeat_body with database as Int returning Str:
    set current to history_collect_one(archive_prepare(database and "SELECT sequence FROM discord_gateway WHERE singleton=1;"))
    if archive_list_text(current and 0) equals "found" and string_to_int(archive_list_text(current and 1)) >= 0:
        return concat("{\"op\":1,\"d\":" and concat(archive_list_text(current and 1) and "}"))
    return "{\"op\":1,\"d\":null}"

# Owns one real connection until a stop request, disconnect or protocol failure.
# No model execution or REST delivery runs in this heartbeat owner.
# Return [stopped/resume/identify/fatal, cause]; caller owns backoff/discovery.
define discord_gateway_connection with library_path as Str and token as Str and database as Int and bot as Str and guilds as List and admins as List and generation as Str and initial_gateway as Str and stop_path as Str returning List:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set resume to discord_gateway_resume_read(database)
    set base to initial_gateway
    set session to ""
    set sequence to ""
    if archive_list_text(resume and 0) equals "found":
        set session to archive_list_text(resume and 1)
        set base to archive_list_text(resume and 2)
        set sequence to archive_list_text(resume and 3)
        if not (discord_gateway_bind(database and generation and session) equals "bound"):
            set closed to ep_dlclose(system)
            set rooted_literal_2 to create_list()
            set retained_value_added to append_list(rooted_literal_2 and "fatal")
            set retained_value_added to append_list(rooted_literal_2 and "resume-bind-failed")
            return rooted_literal_2
    set socket to discord_socket_open_at(library_path and base)
    if not (archive_list_text(socket and 0) equals "connected"):
        set closed to ep_dlclose(system)
        set rooted_literal_3 to create_list()
        set retained_value_added to append_list(rooted_literal_3 and "resume")
        set retained_value_added to append_list(rooted_literal_3 and "connect-failed")
        return rooted_literal_3
    set opened to discord_monotonic_ms(system)
    set heart to 0
    set frames to discord_frames_new()
    set hello to 0
    set authenticated to 0
    set rooted_literal_4 to create_list()
    set retained_value_added to append_list(rooted_literal_4 and "resume")
    set retained_value_added to append_list(rooted_literal_4 and "connection-lost")
    set outcome to rooted_literal_4
    set recorded to discord_gateway_health(database and generation and "connected-awaiting-hello")
    if recorded is not equal to 0 or else opened < 0:
        set closed to discord_socket_close(socket)
        set closed to ep_dlclose(system)
        set rooted_literal_5 to create_list()
        set retained_value_added to append_list(rooted_literal_5 and "fatal")
        set retained_value_added to append_list(rooted_literal_5 and "connection-state-unavailable")
        return rooted_literal_5
    repeat while 1 equals 1:
        if file_exists(stop_path):
            set rooted_literal_6 to create_list()
            set retained_value_added to append_list(rooted_literal_6 and "stopped")
            set retained_value_added to append_list(rooted_literal_6 and "host-stop-request")
            set outcome to rooted_literal_6
            break
        set now to discord_monotonic_ms(system)
        if now < 0:
            set rooted_literal_7 to create_list()
            set retained_value_added to append_list(rooted_literal_7 and "fatal")
            set retained_value_added to append_list(rooted_literal_7 and "monotonic-clock-unavailable")
            set outcome to rooted_literal_7
            break
        if hello equals 0 and now - opened >= 20000:
            set rooted_literal_8 to create_list()
            set retained_value_added to append_list(rooted_literal_8 and "resume")
            set retained_value_added to append_list(rooted_literal_8 and "hello-timeout")
            set outcome to rooted_literal_8
            break
        set heartbeat_action to discord_heartbeat_action(heart and now)
        if heartbeat_action equals "reconnect-missing-ack":
            set rooted_literal_9 to create_list()
            set retained_value_added to append_list(rooted_literal_9 and "resume")
            set retained_value_added to append_list(rooted_literal_9 and "heartbeat-ack-missing")
            set outcome to rooted_literal_9
            break
        if heartbeat_action equals "send":
            set heartbeat to "{\"op\":1,\"d\":null}"
            if string_length(session) > 0 or else authenticated equals 1:
                set heartbeat to discord_gateway_heartbeat_body(database)
            if discord_socket_send(socket and heartbeat) equals 0:
                set rooted_literal_10 to create_list()
                set retained_value_added to append_list(rooted_literal_10 and "resume")
                set retained_value_added to append_list(rooted_literal_10 and "heartbeat-write-uncertain")
                set outcome to rooted_literal_10
                break
            set sent to discord_heartbeat_sent(heart and now and 1)
        if authenticated equals 1:
            set voice_tick to discord_voice_gateway_tick(database and socket and generation and stop_path and bot)
            if voice_tick equals "uncertain" or else voice_tick equals "voice-dispatch-outcome-unrecorded":
                # The write marker prevents replay on reconnect; stop using a
                # socket whose last voice command may have been partial.
                set outcome to history_status("resume")
                set added to append_list(outcome and "voice-gateway-write-uncertain")
                break
            if voice_tick equals "voice-tick-store-failed":
                set outcome to history_status("fatal")
                set added to append_list(outcome and "voice-dispatch-store-failed")
                break
        set raw to discord_socket_read(socket)
        set packet to discord_frames_accept(frames and raw)
        set disposition to archive_list_text(packet and 0)
        if disposition equals "pending":
            if archive_list_text(raw and 0) equals "again":
                # Bounded poll sleep; monotonic heartbeat deadlines are checked
                # on every iteration, independently of model work.
                set waited to ep_dlcall1(ep_dlsym(system and "usleep") and 20000)
        else if disposition equals "closed":
            set code to string_to_int(archive_list_text(packet and 1))
            set action to discord_gateway_close_action(code)
            if action equals "stop-configuration":
                set action to "fatal"
            set retained_values_2 to create_list()
            set retained_value_added to append_list(retained_values_2 and action)
            set retained_value_added to append_list(retained_values_2 and concat("gateway-close-" and int_to_string(code)))
            set outcome to retained_values_2
            break
        else if disposition equals "message":
            set body to archive_list_text(packet and 1)
            set tokens to provider_json_tokens(body)
            if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
                set rooted_literal_11 to create_list()
                set retained_value_added to append_list(rooted_literal_11 and "resume")
                set retained_value_added to append_list(rooted_literal_11 and "invalid-gateway-json")
                set outcome to rooted_literal_11
                break
            set opcode to provider_index(tokens and provider_member(tokens and 0 and "op"))
            if opcode equals "10":
                if hello is not equal to 0:
                    set rooted_literal_12 to create_list()
                    set retained_value_added to append_list(rooted_literal_12 and "resume")
                    set retained_value_added to append_list(rooted_literal_12 and "duplicate-hello")
                    set outcome to rooted_literal_12
                    break
                set data to provider_member(tokens and 0 and "d")
                set interval_text to provider_index(tokens and provider_member(tokens and data and "heartbeat_interval"))
                set interval to string_to_int(interval_text)
                if interval <= 0:
                    set rooted_literal_13 to create_list()
                    set retained_value_added to append_list(rooted_literal_13 and "fatal")
                    set retained_value_added to append_list(rooted_literal_13 and "invalid-heartbeat-interval")
                    set outcome to rooted_literal_13
                    break
                set jitter to ep_dlcall1(ep_dlsym(system and "arc4random_uniform") and interval)
                set heart to discord_heartbeat_new(interval and now and jitter)
                set hello to 1
                set identify to discord_gateway_identify(token)
                if string_length(session) > 0:
                    set identify to concat("{\"op\":6,\"d\":{\"token\":" and provider_quote(token))
                    set identify to concat(identify and concat(",\"session_id\":" and provider_quote(session)))
                    set identify to concat(identify and concat(",\"seq\":" and concat(sequence and "}}")))
                if discord_socket_send(socket and identify) equals 0:
                    set rooted_literal_14 to create_list()
                    set retained_value_added to append_list(rooted_literal_14 and "resume")
                    set retained_value_added to append_list(rooted_literal_14 and "handshake-write-uncertain")
                    set outcome to rooted_literal_14
                    break
            else if opcode equals "11":
                if heart equals 0:
                    set rooted_literal_15 to create_list()
                    set retained_value_added to append_list(rooted_literal_15 and "resume")
                    set retained_value_added to append_list(rooted_literal_15 and "ack-before-hello")
                    set outcome to rooted_literal_15
                    break
                set ack to discord_heartbeat_ack(heart and now)
                if discord_gateway_health(database and generation and "heartbeat-ack") is not equal to 0:
                    set rooted_literal_16 to create_list()
                    set retained_value_added to append_list(rooted_literal_16 and "fatal")
                    set retained_value_added to append_list(rooted_literal_16 and "health-write-failed")
                    set outcome to rooted_literal_16
                    break
            else if opcode equals "1":
                set heartbeat to "{\"op\":1,\"d\":null}"
                if string_length(session) > 0 or else authenticated equals 1:
                    set heartbeat to discord_gateway_heartbeat_body(database)
                if heart equals 0 or else discord_socket_send(socket and heartbeat) equals 0:
                    set rooted_literal_17 to create_list()
                    set retained_value_added to append_list(rooted_literal_17 and "resume")
                    set retained_value_added to append_list(rooted_literal_17 and "requested-heartbeat-write-failed")
                    set outcome to rooted_literal_17
                    break
                set sent to discord_heartbeat_sent(heart and now and 0)
            else if opcode equals "7":
                set rooted_literal_18 to create_list()
                set retained_value_added to append_list(rooted_literal_18 and "resume")
                set retained_value_added to append_list(rooted_literal_18 and "server-reconnect-request")
                set outcome to rooted_literal_18
                break
            else if opcode equals "9":
                set resumable to provider_value(tokens and provider_member(tokens and 0 and "d"))
                set rooted_literal_19 to create_list()
                set retained_value_added to append_list(rooted_literal_19 and "identify")
                set retained_value_added to append_list(rooted_literal_19 and "session-invalidated")
                set outcome to rooted_literal_19
                if resumable equals "true":
                    set rooted_literal_20 to create_list()
                    set retained_value_added to append_list(rooted_literal_20 and "resume")
                    set retained_value_added to append_list(rooted_literal_20 and "server-session-retry")
                    set outcome to rooted_literal_20
                break
            else if opcode equals "0":
                if hello equals 0:
                    set rooted_literal_21 to create_list()
                    set retained_value_added to append_list(rooted_literal_21 and "resume")
                    set retained_value_added to append_list(rooted_literal_21 and "dispatch-before-hello")
                    set outcome to rooted_literal_21
                    break
                set kind to provider_value(tokens and provider_member(tokens and 0 and "t"))
                set saved to ""
                if kind equals "READY":
                    if string_length(session) > 0 or else authenticated equals 1:
                        set rooted_literal_22 to create_list()
                        set retained_value_added to append_list(rooted_literal_22 and "resume")
                        set retained_value_added to append_list(rooted_literal_22 and "unexpected-ready")
                        set outcome to rooted_literal_22
                        break
                    set saved to discord_gateway_ready_record(database and generation and bot and body)
                    if saved equals "recorded":
                        set authenticated to 1
                        set stored to discord_gateway_resume_read(database)
                        set session to archive_list_text(stored and 1)
                else:
                    if string_length(session) equals 0:
                        set rooted_literal_23 to create_list()
                        set retained_value_added to append_list(rooted_literal_23 and "resume")
                        set retained_value_added to append_list(rooted_literal_23 and "dispatch-before-ready")
                        set outcome to rooted_literal_23
                        break
                    set saved to discord_gateway_intake(database and generation and bot and guilds and admins and body)
                    if kind equals "RESUMED" and saved equals "recorded":
                        set authenticated to 1
                if not (saved equals "recorded" or else saved equals "already-recorded"):
                    set retained_values_3 to create_list()
                    set retained_value_added to append_list(retained_values_3 and "fatal")
                    set retained_value_added to append_list(retained_values_3 and concat("dispatch-persistence-" and saved))
                    set outcome to retained_values_3
                    break
            else:
                set rooted_literal_24 to create_list()
                set retained_value_added to append_list(rooted_literal_24 and "resume")
                set retained_value_added to append_list(rooted_literal_24 and "unsupported-gateway-opcode")
                set outcome to rooted_literal_24
                break
        else:
            set rooted_literal_25 to create_list()
            set retained_value_added to append_list(rooted_literal_25 and "resume")
            set retained_value_added to append_list(rooted_literal_25 and disposition)
            set outcome to rooted_literal_25
            break
    set closed to discord_socket_close(socket)
    set recorded to discord_gateway_health(database and generation and archive_list_text(outcome and 1))
    set closed to ep_dlclose(system)
    return outcome
