import "message_moderation_options"
import "rich_post"

# Pagination and filters are values, never caller-controlled route fragments.
define discord_audit_options with arguments as Str returning List:
    set fields to provider_json_tokens(arguments)
    if fields equals 0 or else provider_unique_objects(fields) equals 0 or else discord_rich_keys(fields and 0 and "|limit|before|after|user_id|action_type|") equals 0:
        return history_status("invalid-audit-arguments")
    set limit to "50"
    set field to provider_member(fields and 0 and "limit")
    if field >= 0:
        set limit to provider_value(fields and field)
        if not (provider_kind(fields and field) equals "number") or else http_decimal(limit) < 1 or else http_decimal(limit) > 100 or else not (int_to_string(http_decimal(limit)) equals limit):
            return history_status("invalid-audit-limit")
    set query to concat("?limit=" and limit)
    set keys to create_list()
    set keys to ["before","after","user_id"]
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        if field >= 0:
            set value to provider_value(fields and field)
            if not (provider_kind(fields and field) equals "string") or else discord_snowflake(value) equals 0:
                return history_status("invalid-audit-identity")
            set query to concat(query and concat("&" and concat(key and concat("=" and value))))
    if provider_member(fields and 0 and "before") >= 0 and also provider_member(fields and 0 and "after") >= 0:
        return history_status("conflicting-audit-cursors")
    set field to provider_member(fields and 0 and "action_type")
    if field >= 0:
        set value to provider_value(fields and field)
        if not (provider_kind(fields and field) equals "number") or else http_decimal(value) < 1 or else http_decimal(value) > 1000 or else not (int_to_string(http_decimal(value)) equals value):
            return history_status("invalid-audit-action")
        set query to concat(query and concat("&action_type=" and value))
    set before to provider_value(fields and provider_member(fields and 0 and "before"))
    set after to provider_value(fields and provider_member(fields and 0 and "after"))
    set person to provider_value(fields and provider_member(fields and 0 and "user_id"))
    set action to provider_value(fields and provider_member(fields and 0 and "action_type"))
    return ["valid",query,limit,before,after,person,action]
