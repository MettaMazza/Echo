import "guild_settings_view"
import "onboarding_guard"
import "automod_references"

# Server settings never use a guest report as administrative authority.
# Current membership and MANAGE_GUILD are evaluated for both actors separately.
define discord_guild_settings_bundle_allowed with bundle as List and guild as Str and actor as Str and bot as Str returning Int:
    return discord_onboarding_bundle_allowed(bundle and guild and actor and bot and 0)

define discord_guild_settings_effective with changes as Str and previous as Str returning Str:
    if discord_guild_settings_changes(changes) equals 0 or else discord_guild_settings_changes(previous) equals 0:
        return ""
    set fields to provider_json_tokens(changes)
    set old to provider_json_tokens(previous)
    set keys to create_list()
    set keys to ["name","description","region","verification_level","default_message_notifications","explicit_content_filter","preferred_locale","afk_timeout","afk_channel_id","system_channel_id","system_channel_flags","features","rules_channel_id","safety_alerts_channel_id","public_updates_channel_id","premium_progress_bar_enabled"]
    set output to "{"
    set count to 0
    for each item in keys:
        set key to ptr_to_str(item)
        set field to provider_member(fields and 0 and key)
        set value to ""
        if field >= 0:
            set value to agent_json_source(changes and fields and field)
        else:
            set field to provider_member(old and 0 and key)
            if field < 0:
                return ""
            set value to agent_json_source(previous and old and field)
        if count > 0:
            set output to concat(output and ",")
        set output to concat(output and provider_quote(key))
        set output to concat(output and ":")
        set output to concat(output and value)
        set count to count + 1
    return concat(output and "}")

define discord_guild_settings_references_current with library as Str and token as Str and journal as Int and directory_path as Str and bundle as List and guild as Str and actor as Str and bot as Str and candidate as Str returning Int:
    if discord_guild_settings_changes(candidate) equals 0:
        return 0
    set fields to provider_json_tokens(candidate)
    set keys to create_list()
    set keys to ["afk_channel_id","system_channel_id","rules_channel_id","safety_alerts_channel_id","public_updates_channel_id"]
    set seen to create_list()
    for each item in keys:
        set field to provider_member(fields and 0 and ptr_to_str(item))
        if field >= 0 and also not (provider_kind(fields and field) equals "null"):
            set room to provider_value(fields and field)
            if discord_contains(seen and room) equals 0:
                if discord_automod_channel_reference(library and token and journal and directory_path and bundle and guild and actor and bot and room) equals 0:
                    return 0
                set added to append_list(seen and room)
    return 1
