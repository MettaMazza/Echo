import "voice_messages"

# Exact bounded unsigned integers: overflow is checked before multiplication.
define discord_voice_control_uint with tokens as List and index as Int and maximum as Int returning Int:
    set value to provider_index(tokens and index)
    if string_length(value) < 1:
        return -1
    set number to 0
    set position to 0
    repeat while position < string_length(value):
        set digit to peek_byte(str_to_ptr(value) and position) - 48
        if number > (maximum - digit) / 10:
            return -1
        set number to number * 10 + digit
        if number > maximum:
            return -1
        set position to position + 1
    return number

# HELLO may spell milliseconds with a fractional part. Round upward so the
# chosen interval never becomes zero through truncation. Exponent spellings are
# rejected rather than interpreted by an overflowing integer conversion.
define discord_voice_control_interval with tokens as List and index as Int returning Int:
    if not (provider_kind(tokens and index) equals "number"):
        return -1
    set value to provider_value(tokens and index)
    set position to 0
    set whole to 0
    set fraction to 0
    set rounded to 0
    repeat while position < string_length(value):
        set code to peek_byte(str_to_ptr(value) and position)
        if code equals 46 and also fraction equals 0:
            set fraction to 1
        else:
            if code < 48 or else code > 57:
                return -1
            if fraction equals 0:
                set whole to whole * 10 + code - 48
                if whole > 86400000:
                    return -1
            else:
                if code is not equal to 48:
                    set rounded to 1
        set position to position + 1
    if whole + rounded < 1 or else whole + rounded > 86400000:
        return -1
    return whole + rounded

# Output is [disposition, opcode, sequence (-1 absent), normalized data].
# Session keys stay in a rooted native word buffer; never return this result to
# the model or log it. The caller copies the key into its zeroizing crypto state.
define discord_voice_control_decode with body as Str returning List:
    if string_length(body) < 2 or else string_length(body) > 1048576:
        return history_status("invalid-voice-control")
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return history_status("invalid-voice-control")
    set opcode to discord_voice_control_uint(tokens and provider_member(tokens and 0 and "op") and 255)
    set data to provider_member(tokens and 0 and "d")
    set sequence_index to provider_member(tokens and 0 and "seq")
    set sequence to -1
    if sequence_index >= 0:
        set sequence to discord_voice_control_uint(tokens and sequence_index and 65535)
        if sequence < 0:
            return history_status("invalid-voice-control")
    if opcode < 0 or else data < 0:
        return history_status("invalid-voice-control")
    set values to create_list()
    set status to "unhandled-voice-control"
    if opcode equals 8:
        set interval to discord_voice_control_interval(tokens and provider_member(tokens and data and "heartbeat_interval"))
        if interval < 1:
            return history_status("invalid-voice-control")
        set status to "hello"
        set values to [interval]
    if opcode equals 2:
        set ssrc to discord_voice_control_uint(tokens and provider_member(tokens and data and "ssrc") and 4294967295)
        set port to discord_voice_control_uint(tokens and provider_member(tokens and data and "port") and 65535)
        set ip_index to provider_member(tokens and data and "ip")
        set address to provider_value(tokens and ip_index)
        if ssrc < 1 or else port < 1 or else not (provider_kind(tokens and ip_index) equals "string") or else discord_voice_select_body(address and port) equals "":
            return history_status("invalid-voice-control")
        set modes to provider_items(tokens and provider_member(tokens and data and "modes"))
        if modes equals 0:
            return history_status("invalid-voice-control")
        set supported to 0
        for each item in modes:
            if not (provider_kind(tokens and item) equals "string"):
                return history_status("invalid-voice-control")
            if provider_value(tokens and item) equals "aead_xchacha20_poly1305_rtpsize":
                set supported to 1
        if supported equals 0:
            return history_status("unsupported-voice-encryption")
        set status to "ready"
        set values to [ssrc,address,port]
    if opcode equals 4:
        set mode_index to provider_member(tokens and data and "mode")
        if not (provider_kind(tokens and mode_index) equals "string") or else not (provider_value(tokens and mode_index) equals "aead_xchacha20_poly1305_rtpsize"):
            return history_status("unsupported-voice-encryption")
        set version to discord_voice_control_uint(tokens and provider_member(tokens and data and "dave_protocol_version") and 65535)
        if version is not equal to 1:
            return history_status("unsupported-dave-version")
        set items to provider_items(tokens and provider_member(tokens and data and "secret_key"))
        if items equals 0 or else length_list(items) is not equal to 32:
            return history_status("invalid-voice-control")
        for each item in items:
            if discord_voice_control_uint(tokens and item and 255) < 0:
                return history_status("invalid-voice-control")
        set key to research_native_words(4)
        set index to 0
        for each item in items:
            set byte_value to discord_voice_control_uint(tokens and item and 255)
            set written to poke_byte(get_list_data_ptr(key) and index and byte_value)
            set index to index + 1
        set status to "session-description"
        set values to [version,key]
    if opcode equals 21 or else opcode equals 22:
        set transition to discord_voice_control_uint(tokens and provider_member(tokens and data and "transition_id") and 65535)
        if transition < 0:
            return history_status("invalid-voice-control")
        set status to "execute-transition"
        set values to [transition]
        if opcode equals 21:
            set version to discord_voice_control_uint(tokens and provider_member(tokens and data and "protocol_version") and 65535)
            if version is not equal to 1:
                return history_status("unsupported-dave-version")
            set status to "prepare-transition"
            set values to [transition,version]
    if opcode equals 24:
        set epoch to discord_voice_control_uint(tokens and provider_member(tokens and data and "epoch") and 9007199254740991)
        set version to discord_voice_control_uint(tokens and provider_member(tokens and data and "protocol_version") and 65535)
        if epoch < 1:
            return history_status("invalid-voice-control")
        if version is not equal to 1:
            return history_status("unsupported-dave-version")
        set status to "prepare-epoch"
        set values to [epoch,version]
    if opcode equals 5 or else opcode equals 13:
        set user_index to provider_member(tokens and data and "user_id")
        set user to provider_value(tokens and user_index)
        set users to create_list()
        set added to append_list(users and user)
        if not (provider_kind(tokens and user_index) equals "string") or else discord_dave_users_valid(users) equals 0:
            return history_status("invalid-voice-control")
        set status to "client-disconnect"
        set values to [user]
        if opcode equals 5:
            set ssrc to discord_voice_control_uint(tokens and provider_member(tokens and data and "ssrc") and 4294967295)
            set speaking to discord_voice_control_uint(tokens and provider_member(tokens and data and "speaking") and 7)
            if ssrc < 1 or else speaking < 0:
                return history_status("invalid-voice-control")
            set status to "speaking"
            set values to [user,ssrc,speaking]
    if opcode equals 6:
        set status to "heartbeat-ack"
    if opcode equals 9:
        set status to "resumed"
    set output to create_list()
    set output to [status,opcode,sequence,values]
    return output
