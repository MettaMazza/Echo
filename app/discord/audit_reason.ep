import "../network/search_query"

# Only this fixed header may be added by the audited transport. Encode all
# UTF-8 bytes before joining headers, so reason text cannot inject a header.
define discord_audit_reason with reason as Str returning Str:
    if string_length(string_trim(reason)) equals 0:
        return ""
    set encoded to network_query_encode(reason)
    if string_length(encoded) > 512:
        return ""
    return concat("X-Audit-Log-Reason: " and encoded)
