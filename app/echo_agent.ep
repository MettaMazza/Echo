import "agent/runner"
import "fs"

# Command-line entry point while the browser lifecycle is connected.
# start database session model port output-reserve read-batch objective
# resume database run model port output-reserve read-batch
# start-profile database session profile-file output-reserve read-batch objective
# resume-profile database run profile-file output-reserve read-batch
define main returning Int:
    if get_argument_count() is less than 7:
        display "Usage: echo_agent start database session model port output-reserve read-batch objective"
        display "Or: echo_agent resume database run model port output-reserve read-batch"
        display "Or: echo_agent start-profile database session profile-file output-reserve read-batch objective"
        display "Or: echo_agent resume-profile database run profile-file output-reserve read-batch"
        return 1
    set mode to get_argument(1)
    if not (mode equals "start" or else mode equals "resume" or else mode equals "start-profile" or else mode equals "resume-profile"):
        return 1
    set selected_profile to mode equals "start-profile" or else mode equals "resume-profile"
    set starting to mode equals "start" or else mode equals "start-profile"
    set expected_arguments to 8
    if selected_profile:
        set expected_arguments to 7
    if starting:
        set expected_arguments to expected_arguments + 1
    if get_argument_count() is not equal to expected_arguments:
        return 1
    set profile to ""
    set reserve_index to 6
    if selected_profile:
        set profile to ptr_to_str(read_file(get_argument(4)))
        set reserve_index to 5
    else:
        set profile to provider_llama_profile(get_argument(4) and http_decimal(get_argument(5)))
    set configuration to provider_json_tokens(profile)
    if not (provider_profile_status(profile) equals "ready"):
        return 1
    set port to http_decimal(provider_index(configuration and provider_member(configuration and 0 and "port")))
    set reserve to http_decimal(get_argument(reserve_index))
    set batch to http_decimal(get_argument(reserve_index + 1))
    if port is less than 1 or else port is greater than 65535 or else reserve is less than 1 or else batch is less than 1:
        return 1
    set database to archive_open(get_argument(2))
    if database equals 0:
        return 1
    if agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        set closed to sql_close(database)
        return 1
    set run to get_argument(3)
    if starting:
        set run to agent_identity()
        set objective to agent_identity()
        if archive_append(database and get_argument(3) and objective and "user" and get_argument(reserve_index + 2) and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0 or else agent_run_create(database and run and get_argument(3) and objective) is not equal to 0:
            set closed to sql_close(database)
            return 1
    display concat("Run: " and run)
    set status to agent_loop_provider(database and run and profile and reserve and -1 and batch)
    display concat("Run status: " and status)
    set closed to sql_close(database)
    if closed is not equal to 0 or else not (status equals "completed"):
        return 1
    return 0
