import "archive/restore_release"

define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Supply restored database, restored attachment directory and the SHA256 of the reviewed database. Stop its original and restored services first."
        return 1
    if restore_release(get_argument(1) and get_argument(2) and get_argument(3)) is not equal to 0:
        display "Restore release refused; no permission to replay unfinished historical actions was granted."
        return 1
    display "PASS: terminal historical snapshot reconciled under exclusive runtime ownership. Release receipt recorded; no historical work was replayed."
    return 0
