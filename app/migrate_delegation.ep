import "jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 2 or else not file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set active to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_web_workers WHERE status='running';"))
    if not (archive_list_text(active and 0) equals "found") or else not (archive_list_text(active and 1) equals "0"):
        display "Active or unresolved workers must be reconciled before migration."
        return 3
    set status to delegation_schema(database)
    display status
    if not (status equals "applied" or else status equals "already-applied"):
        set closed to sql_close(database)
        return 4
    return sql_close(database)
