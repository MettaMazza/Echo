import "network/fetch"

# Independent helper: parent termination cannot leave a background transfer.
define network_parent_watch with parent as Int returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    repeat while ep_dlcall0(ep_dlsym(library and "getppid")) equals parent:
        set slept to sleep_ms(100)
    return ep_dlcall1(ep_dlsym(library and "_exit") and 125)

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 2
    if not (ptr_to_str(os_name()) equals "macos") or else not (ptr_to_str(arch_name()) equals "arm64"):
        return 3
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set parent to ep_dlcall0(ep_dlsym(library and "getppid"))
    if parent <= 1:
        return 4
    spawn network_parent_watch(parent)
    set directory to workspace_root_open(library and get_argument(2))
    if directory < 0:
        return 5
    set key_path to ptr_to_str(get_env("ECHO_SEARCH_API_KEY_FILE"))
    set key to ""
    if string_length(key_path) > 0:
        if network_brave_endpoint(get_argument(1)) equals 0 or else not file_exists(key_path):
            return 6
        set key to ptr_to_str(string_trim(ptr_to_str(read_file(key_path))))
        if string_length(key) < 20 or else string_contains(key and "\n") > 0 or else string_contains(key and "\r") > 0:
            return 6
    set setenv to ep_dlsym(library and "setenv")
    set configured to ep_dlcall3(setenv and str_to_ptr("ECHO_FETCH_DIRECTORY") and str_to_ptr(get_argument(2)) and 1)
    set result to network_fetch_authenticated(get_argument(1) and directory and key)
    set saved to network_fetch_save(library and directory and "result.json" and result)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    display result
    return saved
