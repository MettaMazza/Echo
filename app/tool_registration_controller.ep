import "lifecycle/tool_registration_worker"
import "lifecycle/tool_version_worker"

# Installed root service. Only a protected configuration can select archives,
# principals, compiler, registry, review inputs and qualification machinery.
define main returning Int:
    if get_argument_count() < 2 or else get_argument_count() > 3:
        return 1
    if get_argument_count() equals 3 and not (get_argument(2) equals "--once"):
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set effective_user to ep_dlsym(library and "geteuid")
    if effective_user equals 0 or else ep_dlcall0(effective_user) is not equal to 0:
        set released to ep_dlclose(library)
        return 2
    set released to ep_dlclose(library)
    set input to tool_store_text(get_argument(1) and "")
    if not (archive_list_text(input and 0) equals "read"):
        return 3
    set content to archive_list_text(input and 1)
    set config to provider_json_tokens(content)
    if config equals 0 or else provider_unique_objects(config) equals 0:
        return 4
    set loaded to controller_configuration_load(provider_value(config and provider_member(config and 0 and "controller_configuration")))
    if not (archive_list_text(loaded and 0) equals "ready") or else string_length(controller_activation_policy(archive_list_text(loaded and 1))) > 0:
        return 5
    set database to controller_ledger_open(archive_list_text(loaded and 6) and archive_list_text(loaded and 7))
    if database equals 0 or else controller_service_ready(database and ep_sha256(archive_list_text(loaded and 1))) equals 0:
        return 6
    repeat while 1 equals 1:
        set current to tool_store_text(get_argument(1) and ep_sha256(content))
        if not (archive_list_text(current and 0) equals "read"):
            set closed to sql_close(database)
            return 7
        set result to tool_registration_tick(database and config and loaded)
        set result to result + tool_version_tick(database and config and loaded)
        if get_argument_count() equals 3:
            set closed to sql_close(database)
            return result + closed
        if result is not equal to 0:
            display "Tool registration requires attention; no unverified registry publication."
        set slept to sleep_ms(1000)
    return 0
