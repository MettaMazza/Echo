import "web/attachments"
import "agent/runner"

# Live manual compaction probe with corrections, relationships, unfinished
# work and an exact original. This tests real recap/review/activation/reopen;
# it does not substitute for the separate automatic full-capacity trigger test.
define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Supply a new archive path, local provider port and post-compaction objective."
        return 1
    set port to http_decimal(get_argument(2))
    if port is less than 1 or else port is greater than 65535:
        return 1
    set models to local_json_request(port and "GET" and "/v1/models" and "" and -1 and 65536)
    set props to local_json_request(port and "GET" and "/props" and "" and -1 and 65536)
    if not (ptr_to_str(get_list(models and 0)) equals "ready") or else not (ptr_to_str(get_list(props and 0)) equals "ready"):
        display "Provider discovery is not ready."
        return 1
    set tokens to provider_json_tokens(ptr_to_str(get_list(models and 2)))
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 1
    set entries to provider_items(tokens and provider_member(tokens and 0 and "data"))
    if entries equals 0 or else length_list(entries) is not equal to 1:
        display "Qualification requires an unambiguous loaded model."
        return 1
    set model to provider_value(tokens and provider_member(tokens and get_list(entries and 0) and "id"))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    set identity to agent_identity()
    set device to concat(identity and ":device")
    if web_pairing_invite(database and identity) is not equal to 0 or else web_device_pair(database and identity and device and "Local qualification" and agent_identity()) is not equal to 0:
        return 1
    set selected to create_list()
    set created to web_create_session(database and device and identity)
    if not (ptr_to_str(get_list(created and 0)) equals "accepted"):
        return 1
    set requested_session to ptr_to_str(get_list(created and 1))
    if archive_append(database and requested_session and "seed-original" and "user" and "The workshop is called Cedar. Its access phrase is amber lantern. We initially chose a blue sign. Mira handles the design and I handle testing. The unfinished task is to compare two paper samples before ordering." and "qualification") is not equal to 0:
        return 1
    if archive_append(database and requested_session and "seed-correction" and "user" and "Correction: use a green sign, not blue. Keep the name Cedar and the phrase amber lantern. Mira still handles design. Do not place the paper order until both samples have been tested." and "qualification") is not equal to 0:
        return 1
    if archive_append(database and requested_session and "seed-verbatim" and "user" and "Exact receipt text: Lot C-17; mass 18.250 g; inspection pending. Preserve this original for exact rereading." and "qualification") is not equal to 0:
        return 1
    # These earlier accepted user turns were cancelled before generation.
    # They still belong to real run lineage and must be retained in the recap.
    if agent_run_create(database and "seed-run-original" and requested_session and "seed-original") is not equal to 0 or else agent_cancel_run(database and "seed-run-original") is not equal to 0:
        return 1
    if agent_run_create(database and "seed-run-correction" and requested_session and "seed-correction") is not equal to 0 or else agent_cancel_run(database and "seed-run-correction") is not equal to 0:
        return 1
    if agent_run_create(database and "seed-run-verbatim" and requested_session and "seed-verbatim") is not equal to 0 or else agent_cancel_run(database and "seed-run-verbatim") is not equal to 0:
        return 1
    set submitted to web_submit_owned_files(database and device and identity and requested_session and get_argument(3) and selected)
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    set session to ptr_to_str(get_list(submitted and 1))
    set run to ptr_to_str(get_list(submitted and 2))
    if archive_append(database and session and concat(identity and ":models") and "qualification_models" and ptr_to_str(get_list(models and 2)) and "live") is not equal to 0 or else archive_append(database and session and concat(identity and ":props") and "qualification_props" and ptr_to_str(get_list(props and 2)) and "live") is not equal to 0:
        return 1
    display concat("Model: " and model)
    display concat("Run: " and run)
    set source_bundle to recap_sources(database and session and concat(identity and ":props"))
    if string_contains(source_bundle and "amber lantern") equals 0 or else string_contains(source_bundle and "use a green sign") equals 0 or else string_contains(source_bundle and "Lot C-17; mass 18.250 g; inspection pending.") equals 0:
        display "FAIL: qualification seeds missing from accepted conversation ancestry"
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 1
    set before to ep_time_now_ms()
    set compacted to context_compact(database and run and model and port and 2048 and -1 and 65536 and library)
    display concat("Compaction: " and compacted)
    display concat("Compaction milliseconds: " and int_to_string(ep_time_now_ms() - before))
    set closed to ep_dlclose(library)
    if not (compacted equals "activated") or else checkpoint_read_active(database and session) equals 0 or else archive_verify(database and session) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else checkpoint_read_active(database and session) equals 0:
        return 1
    set started to ep_time_now_ms()
    # One token is the admission reserve for this caller; it does not cap output.
    set status to agent_loop(database and run and model and port and 1 and -1 and 65536)
    display concat("Status: " and status)
    display concat("Elapsed milliseconds: " and int_to_string(ep_time_now_ms() - started))
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    if not (status equals "completed"):
        return 1
    return 0
