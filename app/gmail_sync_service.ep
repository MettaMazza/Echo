import "mail/sync_service"

# Scheduled host entry point. Credentials stay in the configured private vault.
# Args: existing Echo authority archive, enrolled account ID, graceful stop file.
define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Expected Echo archive, mailbox account and stop-file path."
        return 1
    set status to gmail_sync_cycle(get_argument(1) and get_argument(2) and get_argument(3))
    display status
    if status equals "idle" or else status equals "stopped" or else status equals "sync-busy":
        return 0
    return 2
