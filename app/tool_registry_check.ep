import "tools/tool_version_store"

# Installed qualification/health executable: validates the full registry and
# every usable version's protected source, binary and qualification binding.
# Quarantined/retired entries remain historical even if their files are damaged.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set registry to tool_versions_installed_read(get_argument(1))
    if not (archive_list_text(registry and 0) equals "ready"):
        return 2
    set tokens to provider_json_tokens(archive_list_text(registry and 1))
    for each entry in provider_items(tokens and provider_member(tokens and 0 and "entries")):
        set state to provider_value(tokens and provider_member(tokens and entry and "state"))
        if state equals "active" or else state equals "dormant":
            if not (tool_version_files_check(tokens and entry) equals "accepted-files-verified"):
                return 3
    return 0
