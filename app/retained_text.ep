# Borrow text from a caller-retained list. This avoids allocating an unrooted
# duplicate between evaluations of function arguments. The caller keeps the
# containing list alive. Missing entries keep ptr_to_str's empty-string result.
define archive_list_text with values as List and index as Int returning Str:
    set value to get_list(values and index)
    if value equals 0:
        return ""
    return value

# Split into the caller's fresh, retained list. Both input strings and output
# remain rooted while substring allocation may trigger collection. Preserve
# empty segments, multi-byte delimiters, and the empty-delimiter convention.
define retained_text_split with output as List and value as Str and delimiter as Str returning Int:
    if output equals 0 or else length_list(output) is not equal to 0:
        return -1
    if str_to_ptr(value) equals 0 or else str_to_ptr(delimiter) equals 0:
        return 0
    set width to string_length(delimiter)
    if width equals 0:
        set added to append_list(output and value)
        return 1
    set size to string_length(value)
    set start to 0
    set cursor to 0
    repeat while cursor + width <= size:
        if peek_byte(str_to_ptr(value) and cursor) equals peek_byte(str_to_ptr(delimiter) and 0) and substring(value and cursor and width) equals delimiter:
            set part to substring(value and start and cursor - start)
            set added to append_list(output and part)
            set cursor to cursor + width
            set start to cursor
        else:
            set cursor to cursor + 1
    set part to substring(value and start and size - start)
    set added to append_list(output and part)
    return length_list(output)
