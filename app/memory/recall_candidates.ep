import "source_provenance"
import "knowledge"
import "corrections"
import "group_context"

define memory_recall_claims with database as Int and run as Str returning Str:
    set principal to memory_archive_principal(database and run)
    if string_length(principal) equals 0:
        return group_memory_recall_claims(database and run)
    set binding to echo_runtime_binding(database and run)
    set values to create_list()
    set added to append_list(values and principal)
    set added to append_list(values and run)
    set added to append_list(values and binding)
    set query to concat("SELECT json_group_array(json(item)) FROM (SELECT json_object('id',c.identity,'kind',c.kind,'subject',a.name,'category',c.predicate,'quotation',b.name,'evidence',c.evidence,'source_event',c.source_event,'source_session',e.session,'source_digest',c.source_digest,'source_sequence',e.sequence,'occurred',e.occurred,'source_recorded_at',e.occurred,'source_recorded_utc',CASE WHEN e.occurred LIKE 'unix-ms:%' THEN strftime('%Y-%m-%dT%H:%M:%fZ',CAST(substr(e.occurred,9) AS REAL)/1000.0,'unixepoch') ELSE e.occurred END,'source_kind',e.kind,'event_time',c.event_time,'valid_until',c.valid_until,'ingested_at',c.recorded_at,'supersedes',COALESCE(c.supersedes,''),'runtime_status',__RUNTIME_STATUS__) AS item FROM echo_memory_claims c JOIN echo_memory_nodes a ON a.identity=c.subject AND a.principal=c.principal JOIN echo_memory_nodes b ON b.identity=c.object AND b.principal=c.principal JOIN echo_events e ON e.event=c.source_event AND e.digest=c.source_digest JOIN echo_session_principals p ON p.session=e.session AND p.principal=c.principal WHERE c.principal IN (__MEMORY_SCOPE__) AND e.sequence<(SELECT o.sequence FROM echo_runs r JOIN echo_events o ON o.event=r.objective_event WHERE r.run=?2) AND NOT EXISTS(SELECT 1 FROM echo_memory_claims n WHERE n.supersedes=c.identity) AND (c.valid_until='' OR julianday(c.valid_until)>julianday('now')) AND " and concat(knowledge_visible_sql(database) and " ORDER BY c.sequence);"))
    set query to ptr_to_str(string_replace(query and "__RUNTIME_STATUS__" and memory_runtime_status_sql("e" and "?3")))
    set query to ptr_to_str(string_replace(query and " ORDER BY c.sequence)" and concat(" AND c.source_event NOT IN (" and concat(memory_correction_sources_sql() and ") ORDER BY c.sequence)"))))
    set claims to history_collect_one(checkpoint_prepare(database and memory_scope_query(database and query) and values))
    if not (archive_list_text(claims and 0) equals "found"):
        return ""
    if not (memory_archive_principal(database and run) equals principal):
        return "[]"
    return archive_list_text(claims and 1)

# Adapt authorised shared claims to the existing selector. Never retain the
# original object beside quotation: selection replaces it with an exact passage.
define group_memory_recall_claims with database as Int and run as Str returning Str:
    set records to group_memory_records(database and run)
    if string_length(records) equals 0:
        return ""
    set row to history_collect_one(checkpoint_prepare(database and "SELECT COALESCE(json_group_array(json(item)),'[]') FROM (SELECT json_object('id',json_extract(j.value,'$.identity'),'identity',json_extract(j.value,'$.identity'),'kind',json_extract(j.value,'$.kind'),'subject',json_extract(j.value,'$.subject'),'category',json_extract(j.value,'$.predicate'),'quotation',json_extract(j.value,'$.object'),'evidence',json_extract(j.value,'$.evidence'),'source_event',json_extract(j.value,'$.source_event'),'source_session',json_extract(j.value,'$.source_session'),'source_digest',json_extract(j.value,'$.source_digest'),'source_sequence',json_extract(j.value,'$.source_sequence'),'occurred',json_extract(j.value,'$.source_recorded_at'),'source_recorded_at',json_extract(j.value,'$.source_recorded_at'),'event_time',json_extract(j.value,'$.event_time'),'valid_until',json_extract(j.value,'$.valid_until'),'ingested_at',json_extract(j.value,'$.ingested_at'),'supersedes',json_extract(j.value,'$.supersedes'),'runtime_status',json_extract(j.value,'$.runtime_status'),'source_kind',e.kind,'source_platform',(SELECT g.platform FROM echo_group_sessions s JOIN echo_groups g ON g.identity=s.group_id WHERE s.session=e.session),'source_channel',(SELECT g.channel FROM echo_group_sessions s JOIN echo_groups g ON g.identity=s.group_id WHERE s.session=e.session),'source_speaker',CASE WHEN e.kind='assistant_final' THEN 'echo' ELSE (SELECT a.principal FROM echo_runs r JOIN echo_run_authority a ON a.run=r.run WHERE r.objective_event=e.event OR r.run=json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.run_id') LIMIT 1) END,'source_recorded_utc',CASE WHEN e.occurred LIKE 'unix-ms:%' THEN strftime('%Y-%m-%dT%H:%M:%fZ',CAST(substr(e.occurred,9) AS REAL)/1000.0,'unixepoch') ELSE e.occurred END) AS item FROM json_each(?1) j JOIN echo_events e ON e.event=json_extract(j.value,'$.source_event') AND e.digest=json_extract(j.value,'$.source_digest') ORDER BY e.sequence,json_extract(j.value,'$.identity'));" and [records]))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    return archive_list_text(row and 1)
