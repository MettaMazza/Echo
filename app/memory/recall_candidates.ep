import "source_provenance"
import "knowledge"
import "corrections"

define memory_recall_claims with database as Int and run as Str returning Str:
    set principal to memory_archive_principal(database and run)
    if string_length(principal) equals 0:
        return "[]"
    set binding to echo_runtime_binding(database and run)
    set values to create_list()
    set added to append_list(values and principal)
    set added to append_list(values and run)
    set added to append_list(values and binding)
    set query to concat("SELECT json_group_array(json(item)) FROM (SELECT json_object('id',c.identity,'kind',c.kind,'subject',a.name,'category',c.predicate,'quotation',b.name,'evidence',c.evidence,'source_event',c.source_event,'source_session',e.session,'source_digest',c.source_digest,'source_sequence',e.sequence,'occurred',e.occurred,'source_recorded_at',e.occurred,'source_recorded_utc',CASE WHEN e.occurred LIKE 'unix-ms:%' THEN strftime('%Y-%m-%dT%H:%M:%fZ',CAST(substr(e.occurred,9) AS REAL)/1000.0,'unixepoch') ELSE e.occurred END,'source_kind',e.kind,'event_time',c.event_time,'valid_until',c.valid_until,'ingested_at',c.recorded_at,'supersedes',COALESCE(c.supersedes,''),'runtime_status',__RUNTIME_STATUS__) AS item FROM echo_memory_claims c JOIN echo_memory_nodes a ON a.identity=c.subject AND a.principal=c.principal JOIN echo_memory_nodes b ON b.identity=c.object AND b.principal=c.principal JOIN echo_events e ON e.event=c.source_event AND e.digest=c.source_digest JOIN echo_session_principals p ON p.session=e.session AND p.principal=c.principal WHERE c.principal IN (__MEMORY_SCOPE__) AND e.sequence<(SELECT o.sequence FROM echo_runs r JOIN echo_events o ON o.event=r.objective_event WHERE r.run=?2) AND NOT EXISTS(SELECT 1 FROM echo_memory_claims n WHERE n.supersedes=c.identity) AND (c.valid_until='' OR julianday(c.valid_until)>julianday('now')) AND " and concat(knowledge_visible_sql(database) and " ORDER BY c.sequence);"))
    set query to ptr_to_str(string_replace(query and "__RUNTIME_STATUS__" and memory_runtime_status_sql("e" and "?3")))
    set query to ptr_to_str(string_replace(query and " ORDER BY c.sequence)" and concat(" AND c.source_event NOT IN (" and concat(memory_correction_sources_sql() and ") ORDER BY c.sequence)"))))
    set claims to history_collect_one(checkpoint_prepare(database and memory_scope_query(database and query) and values))
    if not (archive_list_text(claims and 0) equals "found"):
        return ""
    if not (memory_archive_principal(database and run) equals principal):
        return "[]"
    return archive_list_text(claims and 1)
