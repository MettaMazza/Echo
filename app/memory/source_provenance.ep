import "../retained_text"
import "fs"

# Operator-owned annotations never rewrite canonical archive bytes. Only entries
# for sessions already visible in this owner's catalog enter their recall.
define memory_source_provenance_file returning Str:
    set path to ptr_to_str(get_env("ECHO_MEMORY_PROVENANCE_FILE"))
    if string_length(path) equals 0 or else not file_exists(path):
        return ""
    return ptr_to_str(read_file(path))

define memory_source_provenance with catalog as Str returning Str:
    set tokens to provider_json_tokens(memory_source_provenance_file())
    if tokens equals 0:
        return ""
    set items to provider_items(tokens and 0)
    if items equals 0:
        return ""
    set output to ""
    set index to 0
    repeat while index < length_list(items):
        set item to get_list(items and index)
        set session to provider_value(tokens and provider_member(tokens and item and "session"))
        if string_length(session) > 0 and string_contains(catalog and provider_quote(session)) > 0:
            set actor to provider_value(tokens and provider_member(tokens and item and "actor"))
            set evidence to provider_value(tokens and provider_member(tokens and item and "evidence"))
            set output to concat(output and concat("\nSource session: " and session))
            set output to concat(output and concat(". Actor: " and actor))
            set output to concat(output and concat(". Evidence: " and evidence))
        set index to index + 1
    if string_length(output) equals 0:
        return ""
    return concat("\nOperator-recorded source provenance. These annotations identify source authorship and verified corrections; all original messages and memories remain unchanged. Account ownership alone does not identify the speaker." and output)

# Keep raw timestamps and quotations intact. Supply readable dates alongside
# them so earlier Echo prose cannot masquerade as the archive's chronology.
define memory_source_chronology with database as Int and claims as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_group_array(json_object('source_event',event,'source_recorded_utc',CASE WHEN occurred LIKE 'unix-ms:%' THEN strftime('%Y-%m-%dT%H:%M:%fZ',CAST(substr(occurred,9) AS REAL)/1000.0,'unixepoch') ELSE occurred END,'source_kind',kind)) FROM echo_events WHERE event IN (SELECT json_extract(value,'$.source_event') FROM json_each(?1));" and [claims]))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    return concat("\nSource chronology index: these are archive recording dates, not inferred dates of described experiences. They take precedence over relative dates asserted in earlier Echo prose. Compare them with the current turn's host clock before saying yesterday or today. Source kind user is a transport role, not proof of a human author; delegated task instructions and operator diagnostics retain their separate attribution.\n" and archive_list_text(row and 1))

# Explicit operator-verified corrections stay adjacent to the active turn, so a
# preserved earlier false Echo assertion is not mistaken for current evidence.
define memory_current_source_correction with session as Str returning Str:
    set tokens to provider_json_tokens(memory_source_provenance_file())
    if tokens equals 0:
        return ""
    set items to provider_items(tokens and 0)
    if items equals 0:
        return ""
    set output to ""
    set index to 0
    repeat while index < length_list(items):
        set item to get_list(items and index)
        if provider_value(tokens and provider_member(tokens and item and "session")) equals session:
            set correction to provider_value(tokens and provider_member(tokens and item and "correction"))
            if string_length(correction) > 0:
                set output to concat(output and concat("\n" and correction))
                set output to concat(output and concat("\nSource evidence: " and provider_value(tokens and provider_member(tokens and item and "evidence"))))
        set index to index + 1
    if string_length(output) equals 0:
        return ""
    return concat("Echo runtime source-correction record from the operator, not a newly spoken user message. Original conversation and memory text remains preserved." and output)
