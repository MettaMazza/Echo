import "archive_recall"
import "../security/group_gate"

# Private notes retain their established principal identity. Shared notes belong
# to the exact audience segment, never to a participant's private principal.
define scratchpad_scope with database as Int and run as Str returning Str:
    if run_authority_allows(database and run and "user") equals 0:
        return ""
    set private to memory_archive_principal(database and run)
    if string_length(private) > 0:
        return private
    set row to agent_run_read(database and run)
    if row equals 0:
        return ""
    set session to archive_list_text(row and 0)
    if group_run_session_allows(database and run and session) equals 0:
        return ""
    return concat("scratchpad-audience:" and session)
