# The ordering timestamp is explicitly not an assertion about an undated
# experience. Preserve the reported time and source time separately.
define episode_order_time_sql returning Str:
    return "COALESCE(strftime('%Y-%m-%dT%H:%M:%fZ',NULLIF(c.event_time,'')),CASE WHEN substr(e.occurred,1,8)='unix-ms:' AND CAST(CAST(substr(e.occurred,9) AS INTEGER) AS TEXT)=substr(e.occurred,9) THEN strftime('%Y-%m-%dT%H:%M:%fZ',CAST(substr(e.occurred,9) AS REAL)/1000,'unixepoch') ELSE strftime('%Y-%m-%dT%H:%M:%fZ',e.occurred) END,'')"

