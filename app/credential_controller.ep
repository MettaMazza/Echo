import "lifecycle/controller_credential"

define main returning Int:
    if get_argument_count() is not equal to 3:
        display "Usage: credential_controller ROOT_PRIVATE_DIRECTORY FILE_NAME. Creates a private random credential; does not enroll or print it."
        return 1
    set result to controller_credential_host(get_argument(1) and get_argument(2))
    display result
    if result equals "credential-created":
        return 0
    return 1
