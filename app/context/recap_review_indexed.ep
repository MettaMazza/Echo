import "../providers/archived_stream"

# Expand explicit ordinal verdicts into the established archival contract.
# The placeholder for covered records is labelled as such, never presented as
# a model-authored explanation. raw_report is retained by the caller.
define recap_review_expand with sources as Str and report as Str returning Str:
    set tokens to provider_json_tokens(report)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return report
    if provider_member(tokens and 0 and "records") >= 0:
        return report
    set originals to provider_json_tokens(sources)
    set records to provider_items(originals and provider_member(originals and 0 and "records"))
    set assessments to provider_items(tokens and provider_member(tokens and 0 and "assessments"))
    if assessments is not equal to 0:
        if records equals 0 or else length_list(assessments) is not equal to length_list(records):
            return report
        set expanded to concat("{\"candidate_digest\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "candidate_digest"))))
        set expanded to concat(expanded and concat(",\"source_end\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "source_end")))))
        set expanded to concat(expanded and ",\"records\":[")
        set position to 0
        for each item in assessments:
            set verdict to provider_value(tokens and provider_member(tokens and item and "verdict"))
            set explanation to provider_value(tokens and provider_member(tokens and item and "explanation"))
            if provider_kind(tokens and item) equals "string":
                if not (provider_value(tokens and item) equals "covered"):
                    return report
                set verdict to "covered"
            if verdict equals "covered" and string_length(explanation) equals 0:
                set explanation to "Covered: positional model verdict; no individual explanation was emitted."
            set identity to provider_value(originals and provider_member(originals and get_list(records and position) and "event"))
            if position > 0:
                set expanded to concat(expanded and ",")
            set expanded to concat(expanded and concat("{\"event\":" and provider_quote(identity)))
            set expanded to concat(expanded and concat(",\"verdict\":" and provider_quote(verdict)))
            set expanded to concat(expanded and concat(",\"explanation\":" and concat(provider_quote(explanation) and "}")))
            set position to position + 1
        return concat(expanded and concat("],\"findings\":" and concat(agent_json_source(report and tokens and provider_member(tokens and 0 and "findings")) and "}")))
    set covered to provider_items(tokens and provider_member(tokens and 0 and "covered"))
    set issues to provider_items(tokens and provider_member(tokens and 0 and "issues"))
    set findings to provider_items(tokens and provider_member(tokens and 0 and "findings"))
    set verdicts to provider_items(tokens and provider_member(tokens and 0 and "verdicts"))
    if verdicts is not equal to 0:
        if records equals 0 or else length_list(verdicts) is not equal to length_list(records) or else issues equals 0:
            return report
        set covered to create_list()
        set position to 0
        for each item in verdicts:
            set verdict to provider_value(tokens and item)
            set matches to 0
            for each issue in issues:
                if provider_index(tokens and provider_member(tokens and issue and "index")) equals int_to_string(position):
                    if not (provider_value(tokens and provider_member(tokens and issue and "verdict")) equals verdict):
                        return report
                    set matches to matches + 1
            if verdict equals "covered":
                if matches is not equal to 0:
                    return report
                # Numeric token list is reconstructed below with the original indices.
                set added to append_list(covered and position)
            else if matches is not equal to 1:
                return report
            set position to position + 1
        set converted to concat("{\"candidate_digest\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "candidate_digest"))))
        set converted to concat(converted and concat(",\"source_end\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "source_end")))))
        set converted to concat(converted and ",\"covered\":[")
        set comma to ""
        for each position in covered:
            set converted to concat(converted and concat(comma and int_to_string(position)))
            set comma to ","
        set converted to concat(converted and concat("],\"issues\":" and agent_json_source(report and tokens and provider_member(tokens and 0 and "issues"))))
        set converted to concat(converted and concat(",\"findings\":" and concat(agent_json_source(report and tokens and provider_member(tokens and 0 and "findings")) and "}")))
        return recap_review_expand(sources and converted)
    if records equals 0 or else covered equals 0 or else issues equals 0 or else findings equals 0:
        return report
    set total to length_list(records)
    for each item in covered:
        set number to provider_index(tokens and item)
        if string_length(number) equals 0 or else http_decimal(number) >= total:
            return report
    for each item in issues:
        set number to provider_index(tokens and provider_member(tokens and item and "index"))
        if string_length(number) equals 0 or else http_decimal(number) >= total:
            return report
    set output to concat("{\"candidate_digest\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "candidate_digest"))))
    set output to concat(output and concat(",\"source_end\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "source_end")))))
    set output to concat(output and ",\"representation\":\"expanded-indexed-review\",\"records\":[")
    set index to 0
    repeat while index < total:
        set matches to 0
        set verdict to "covered"
        set explanation to "Covered: indexed model verdict; no individual explanation was emitted."
        for each item in covered:
            if http_decimal(provider_index(tokens and item)) equals index:
                set matches to matches + 1
        for each item in issues:
            if http_decimal(provider_index(tokens and provider_member(tokens and item and "index"))) equals index:
                set matches to matches + 1
                set verdict to provider_value(tokens and provider_member(tokens and item and "verdict"))
                set explanation to provider_value(tokens and provider_member(tokens and item and "explanation"))
            if provider_kind(tokens and item) equals "string":
                if not (provider_value(tokens and item) equals "covered"):
                    return report
                set verdict to "covered"
                if verdict equals "covered":
                    return report
        if matches is not equal to 1:
            return report
        if index > 0:
            set output to concat(output and ",")
        set identity to provider_value(originals and provider_member(originals and get_list(records and index) and "event"))
        set output to concat(output and concat("{\"event\":" and provider_quote(identity)))
        set output to concat(output and concat(",\"verdict\":" and provider_quote(verdict)))
        set output to concat(output and concat(",\"explanation\":" and concat(provider_quote(explanation) and "}")))
        set index to index + 1
    return concat(output and concat("],\"findings\":" and concat(agent_json_source(report and tokens and provider_member(tokens and 0 and "findings")) and "}")))
