import "recap_review"
import "recap_patch"

# Repairs receive the originals as well as the rejected candidate and feedback.
# Both candidate and feedback are untrusted evidence, never new instructions.
define recap_repair_provider with database as Int and session as Str and endpoint as Str and candidate as Str and feedback as Str and request as Str and profile as Str and reserve as Int and cancellation_reader as Int and read_size as Int returning List:
    set provider_config to provider_json_tokens(profile)
    set model to provider_value(provider_config and provider_member(provider_config and 0 and "model"))
    set port to http_decimal(provider_index(provider_config and provider_member(provider_config and 0 and "port")))
    set visibility_revision to attachment_context_revision(database and session)
    if string_length(visibility_revision) equals 0:
        return recap_generation_result("archive-error" and "")
    set sources to recap_sources(database and session and endpoint)
    if string_length(sources) equals 0:
        return recap_generation_result("invalid-source" and "")
    if recap_validate_structure(database and session and endpoint and candidate) is not equal to 0:
        set package to concat("{\"original_sources\":" and sources)
        set package to concat(package and concat(",\"previous_candidate\":" and provider_quote(candidate)))
        set package to concat(package and concat(",\"feedback\":" and concat(provider_quote(feedback) and "}")))
        return recap_generate_sources_provider(database and session and endpoint and package and request and profile and reserve and cancellation_reader and read_size)
    return recap_patch_generate_provider(database and session and endpoint and sources and candidate and feedback and request and profile and reserve and cancellation_reader and read_size)

# Compatibility entry for existing host llama.cpp launch settings.
define recap_repair with database as Int and session as Str and endpoint as Str and candidate as Str and feedback as Str and request as Str and model as Str and port as Int and reserve as Int and cancellation_reader as Int and read_size as Int returning List:
    set profile to provider_llama_profile(model and port)
    return recap_repair_provider(database and session and endpoint and candidate and feedback and request and profile and reserve and cancellation_reader and read_size)
