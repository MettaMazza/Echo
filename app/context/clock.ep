import "../providers/local_json"

# Format an actual host-clock sample; no date inferred from conversation text.
# Darwin struct tm fits in eight native words. strftime output is bounded by
# this fixed format, not by any conversation or model context limit.
define echo_clock_format with milliseconds as Int and utc as Int returning Str:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set convert to ep_dlsym(library and "localtime_r")
    if utc equals 1:
        set convert to ep_dlsym(library and "gmtime_r")
    set format to ep_dlsym(library and "strftime")
    if convert equals 0 or else format equals 0:
        return "clock-format-unavailable"
    set seconds to create_list()
    set added to append_list(seconds and milliseconds / 1000)
    set calendar to create_list()
    set output to create_list()
    set index to 0
    repeat while index < 32:
        set added to append_list(output and 0)
        set added to append_list(calendar and 0)
        set index to index + 1
    if ep_dlcall2(convert and get_list_data_ptr(seconds) and get_list_data_ptr(calendar)) equals 0:
        return "clock-format-unavailable"
    if ep_dlcall4(format and get_list_data_ptr(output) and 256 and str_to_ptr("%A, %Y-%m-%d %H:%M:%S %Z (UTC%z)") and get_list_data_ptr(calendar)) equals 0:
        return "clock-format-unavailable"
    return ptr_to_str(get_list_data_ptr(output))

define echo_clock_observation with milliseconds as Int returning Str:
    set text to concat("Host clock observation. Local date and time: " and echo_clock_format(milliseconds and 0))
    set text to concat(text and concat(". UTC date and time: " and echo_clock_format(milliseconds and 1)))
    return concat(text and concat(". Unix milliseconds: " and int_to_string(milliseconds)))
