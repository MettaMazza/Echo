import "recap_review_indexed"
import "recap_bound_review"
import "recap_findings"
import "../retained_text"
import "recap_generate"

define recap_review_body with model as Str and sources as Str and candidate as Str returning Str:
    set instruction to "Independently compare the current candidate against every frozen source. Preserve task-relevant meaning, attribution, corrections, tool outcomes and uncertainty. Accurate paraphrases and grouped redundant records are sufficient. Return candidate_digest, source_end, source_digest, coverage and issues. Copy the supplied digests and endpoint exactly. coverage complete declares that you compared the whole frozen prefix with the current candidate; it does not assert that there are no defects. Return only concrete unresolved issues that materially lose or change task-relevant facts, constraints, corrections, current tool outcomes, artifacts or unfinished work. Each issue gives the original event ID, category, entry_index within that category, explanation, specific correction, and verdict (omitted, contradicted or uncertain). The host resolves source positions and current entry text from those references and the candidate digest. Do not count original records or reproduce recap passages. For a missing entry use omitted with entry_index zero; specify the missing meaning in correction. category is a state category or summary; entry_index selects that current entry. There may be at most one issue per original source; combine related corrections. Return empty issues when retained meaning is sufficient. Do not construct a per-record accounting list or narrate each source in your analysis or output: evaluate the candidate claims and continuity against the evidence. Closed retries and redundant tests may be grouped; each historical event does not need its own recap entry or citation. Do not report defects against obsolete wording or repeat resolved complaints. Preserving the speaker, claim, correction chronology and unresolved status is sufficient for disputed claims; do not adjudicate the scientific dispute. A failed memory write does not establish that its arithmetic is false. Do not infer a platform bug merely from a cancellation."
    set instruction to concat(instruction and " An accepted_checkpoint record is previously reviewed continuity state. Verify preservation and updates against new records; do not demand absent older originals or re-audit settled history. The summary may be only a label; factual continuity is retained in structured state.")
    set instruction to concat(instruction and recap_review_semantics())
    set instruction to concat(instruction and concat("\nSource digest: " and ep_sha256(sources)))
    set input to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set input to concat(input and concat(",\"candidate\":" and concat(provider_quote(candidate) and "}")))
    set operation to concat(instruction and concat("\nCandidate to review against the original sources in the preceding message:\n" and input))
    return recap_bound_cached_body(model and sources and operation)

# Validates the shape, candidate binding and exhaustive source accounting of a
# model review. A well-formed passing judgment is still fallible model evidence.
# This function does not change active context or certify semantic truth.
define recap_review_validate with sources as Str and candidate as Str and report as Str returning Str:
    set originals to provider_json_tokens(sources)
    set tokens to provider_json_tokens(report)
    if originals equals 0 or else tokens equals 0:
        return "invalid-review"
    if provider_unique_objects(tokens) equals 0:
        return "invalid-review"
    if not (provider_value(tokens and provider_member(tokens and 0 and "candidate_digest")) equals ep_sha256(candidate)) or else not (provider_value(tokens and provider_member(tokens and 0 and "source_end")) equals provider_value(originals and provider_member(originals and 0 and "source_end"))):
        return "invalid-review"
    set records to provider_items(originals and provider_member(originals and 0 and "records"))
    set reviewed to provider_items(tokens and provider_member(tokens and 0 and "records"))
    set findings to provider_items(tokens and provider_member(tokens and 0 and "findings"))
    if records equals 0 or else reviewed equals 0 or else findings equals 0:
        return "invalid-review"
    if length_list(records) is not equal to length_list(reviewed):
        return "invalid-review"
    set status to recap_findings_validate(tokens and findings)
    if status equals "invalid-review":
        return status
    set index to 0
    repeat while index is less than length_list(records):
        set identity to provider_value(originals and provider_member(originals and get_list(records and index) and "event"))
        set matches to 0
        set review_index to 0
        repeat while review_index is less than length_list(reviewed):
            set record to get_list(reviewed and review_index)
            if provider_value(tokens and provider_member(tokens and record and "event")) equals identity:
                set matches to matches + 1
                set explanation to provider_member(tokens and record and "explanation")
                if not (provider_kind(tokens and explanation) equals "string") or else string_length(provider_value(tokens and explanation)) equals 0:
                    return "invalid-review"
                set verdict to provider_value(tokens and provider_member(tokens and record and "verdict"))
                if verdict equals "omitted" or else verdict equals "contradicted" or else verdict equals "uncertain":
                    set status to "review-repair"
                else if not (verdict equals "covered"):
                    return "invalid-review"
            set review_index to review_index + 1
        if matches is not equal to 1:
            return "invalid-review"
        set index to index + 1
    return status

# Review always rereads original accepted sources. Intermediate notes cannot
# stand in for the evidence being checked. No review result activates context.
define recap_review_generate_provider with database as Int and session as Str and endpoint as Str and candidate as Str and request as Str and profile as Str and reserve as Int and cancellation_reader as Int and read_size as Int returning List:
    set provider_config to provider_json_tokens(profile)
    set model to provider_value(provider_config and provider_member(provider_config and 0 and "model"))
    set port to http_decimal(provider_index(provider_config and provider_member(provider_config and 0 and "port")))
    if recap_validate_structure(database and session and endpoint and candidate) is not equal to 0:
        return recap_generation_result("structure-invalid" and "")
    set sources to recap_sources(database and session and endpoint)
    if string_length(sources) equals 0:
        return recap_generation_result("invalid-source" and "")
    set body to recap_review_body(model and sources and candidate)
    set patch_values to create_list()
    set added to append_list(patch_values and session)
    set added to append_list(patch_values and ep_sha256(candidate))
    set patch_row to history_collect_one(checkpoint_prepare(database and "SELECT payload FROM echo_events WHERE session=?1 AND kind='recap_patch' AND json_extract(payload,'$.candidate_digest')=?2 ORDER BY sequence DESC LIMIT 1;" and patch_values))
    if archive_list_text(patch_row and 0) equals "found":
        set receipt to archive_list_text(patch_row and 1)
        set receipt_tokens to provider_json_tokens(receipt)
        set base_candidate to provider_value(receipt_tokens and provider_member(receipt_tokens and 0 and "base_candidate"))
        set base_review to provider_value(receipt_tokens and provider_member(receipt_tokens and 0 and "base_review"))
        # The host applied only these digest-bound edits. Review the changed
        # entries and unresolved findings; unchanged accepted state carries on.
        if recap_review_validate(sources and base_candidate and base_review) equals "review-repair":
            set operation to "Verify the CURRENT candidate against frozen sources. The listed patch identifies changed entries. The previous recap is deliberately absent: do not review obsolete wording. Recheck changed meaning and cross-entry consistency. Return candidate_digest, source_end, source_digest, coverage and issues. Copy the supplied digests and endpoint exactly. coverage complete declares that you compared the whole frozen prefix with the current candidate; it does not assert that there are no defects. Return only concrete unresolved issues that materially lose or change task-relevant facts, constraints, corrections, current tool outcomes, artifacts or unfinished work. Each issue gives the original event ID, category, entry_index within that category, explanation, specific correction, and verdict (omitted, contradicted or uncertain). The host resolves source positions and current entry text from those references and the candidate digest. Do not count original records or reproduce recap passages. For a missing entry use omitted with entry_index zero; specify the missing meaning in correction. category is a state category or summary; entry_index selects that current entry. There may be at most one issue per original source; combine related corrections. Return empty issues when retained meaning is sufficient. Do not construct a per-record accounting list or narrate each source in your analysis or output: evaluate the candidate claims and continuity against the evidence. Closed retries and redundant tests may be grouped; each historical event does not need its own recap entry or citation. Do not report defects against obsolete wording or repeat resolved complaints. Preserving the speaker, claim, correction chronology and unresolved status is sufficient for disputed claims; do not adjudicate the scientific dispute. A failed memory write does not establish that its arithmetic is false. Do not infer a platform bug merely from a cancellation."
            set prior_tokens to provider_json_tokens(base_review)
            if provider_member(prior_tokens and 0 and "issue_keys") >= 0:
                set prior_records to provider_items(prior_tokens and provider_member(prior_tokens and 0 and "records"))
                set coverage to "Previously non-covered source IDs; all other sources were covered in the source-bound review (not new evidence):\n"
                set position to 0
                for each record in prior_records:
                    if not (provider_value(prior_tokens and provider_member(prior_tokens and record and "verdict")) equals "covered"):
                        set coverage to concat(coverage and concat(provider_value(prior_tokens and provider_member(prior_tokens and record and "event")) and "\n"))
                    set position to position + 1
                set operation to concat(operation and " The previous source-bound review already checked every original. Preserve its covered judgments for meaning unaffected by the patch. Inspect the changed entries, their relationships and the previously non-covered sources; do not enumerate and re-audit every accepted source. Close a previous defect when the current wording resolves it. Report any defect introduced by the patch, including affected previously covered meaning.")
                set operation to concat(operation and concat("\n" and coverage))
                set operation to concat(operation and concat("\nConcrete defects from that source-bound review. Check whether the CURRENT candidate resolves these corrections; obsolete wording in a prior explanation is not a new defect:\n" and agent_json_source(base_review and prior_tokens and provider_member(prior_tokens and 0 and "findings"))))
            set operation to concat(operation and recap_review_semantics())
            set operation to concat(operation and concat("\nApplied patch: " and agent_json_source(receipt and receipt_tokens and provider_member(receipt_tokens and 0 and "patch"))))
            set operation to concat(operation and concat("\nSource digest: " and ep_sha256(sources)))
            set operation to concat(operation and concat("\nCandidate digest: " and ep_sha256(candidate)))
            set operation to concat(operation and concat("\nCandidate: " and candidate))
            set body to recap_bound_cached_body(model and sources and operation)
    set body to recap_structured_body(body and profile and 2)
    set decision to provider_prepare(database and session and concat(request and ":preflight") and profile and body and reserve and cancellation_reader and read_size)
    if not (archive_list_text(decision and 0) equals "ready"):
        return recap_generation_result(archive_list_text(decision and 0) and "")
    set body to archive_list_text(decision and 5)
    set payload to concat("{\"purpose\":\"recap-review\",\"source_end\":" and provider_quote(endpoint))
    set payload to concat(payload and concat(",\"candidate_digest\":" and provider_quote(ep_sha256(candidate))))
    set payload to concat(payload and concat(",\"request_body\":" and concat(provider_quote(body) and "}")))
    if archive_append(database and session and request and "model_request" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return recap_generation_result("archive-error" and "")
    set response to provider_profile_generate(database and session and request and profile and port and "/v1/chat/completions" and body and cancellation_reader and read_size)
    if not (archive_list_text(response and 0) equals "complete"):
        return recap_generation_result(archive_list_text(response and 0) and "")
    set state to get_list(response and 1)
    if get_list(state and 2) is not equal to 2:
        return recap_generation_result("incomplete-response" and "")
    set choice to chat_find(get_list(state and 0) and "0")
    if choice equals 0:
        return recap_generation_result("missing-choice" and "")
    if length_list(get_list(choice and 3)) is not equal to 0:
        return recap_generation_result("unexpected-tool-call" and "")
    set raw_report to archive_list_text(choice and 1)
    set report to recap_bound_review_expand(sources and candidate and raw_report)
    set status to recap_review_validate(sources and candidate and report)
    set payload to concat("{\"review_contract\":\"source-bound-issues-v3\",\"source_end\":" and provider_quote(endpoint))
    set payload to concat(payload and concat(",\"candidate_digest\":" and provider_quote(ep_sha256(candidate))))
    set payload to concat(payload and concat(",\"raw_report\":" and provider_quote(raw_report)))
    set payload to concat(payload and concat(",\"validation\":" and provider_quote(status)))
    set payload to concat(payload and concat(",\"report\":" and concat(provider_quote(report) and "}")))
    if archive_append(database and session and concat(request and ":review") and "recap_review" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return recap_generation_result("archive-error" and "")
    return recap_generation_result(status and report)

# Compatibility entry for existing host llama.cpp launch settings.
define recap_review_generate with database as Int and session as Str and endpoint as Str and candidate as Str and request as Str and model as Str and port as Int and reserve as Int and cancellation_reader as Int and read_size as Int returning List:
    set profile to provider_llama_profile(model and port)
    return recap_review_generate_provider(database and session and endpoint and candidate and request and profile and reserve and cancellation_reader and read_size)
