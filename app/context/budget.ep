# All capacities and token counts arrive from the provider/tokenizer or workload.
# A negative result is invalid metadata, never a guessed replacement capacity.

define context_remaining with capacity as Int and occupied as Int returning Int:
    if capacity is less than 1 or else occupied is less than 0:
        return -1
    if occupied is greater than capacity:
        return -1
    return capacity - occupied

# A provider output ceiling of -1 explicitly means no separate ceiling.
# Zero or other negative values mean unresolved/invalid provider information.
define context_output_allowance with capacity as Int and occupied as Int and provider_output_ceiling as Int returning Int:
    set remaining to context_remaining(capacity and occupied)
    if remaining is less than 0:
        return -1
    if provider_output_ceiling equals -1:
        return remaining
    if provider_output_ceiling is less than 1:
        return -1
    if provider_output_ceiling is less than remaining:
        return provider_output_ceiling
    return remaining

# Reserve each known contribution separately to avoid overflowing integer sums.
# Result: -1 invalid input, 0 compaction required, 1 request fits as assembled.
# The output reserve is chosen from the actual next workload, not a fixed default.
define context_request_fits with capacity as Int and occupied as Int and next_input as Int and tool_overhead as Int and output_reserve as Int returning Int:
    set remaining to context_remaining(capacity and occupied)
    if remaining is less than 0 or else next_input is less than 0 or else tool_overhead is less than 0 or else output_reserve is less than 0:
        return -1
    if next_input is greater than remaining:
        return 0
    set remaining to remaining - next_input
    if tool_overhead is greater than remaining:
        return 0
    set remaining to remaining - tool_overhead
    if output_reserve is greater than remaining:
        return 0
    return 1

# Comparison is exact: reductions must be surfaced instead of called maximum.
define context_loaded_at_maximum with requested as Int and loaded as Int returning Int:
    if requested is less than 1 or else loaded is less than 1:
        return -1
    if requested equals loaded:
        return 1
    return 0
