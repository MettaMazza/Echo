import "clock"
import "checkpoint"
import "../archive/history"

# Only stored host timestamps are parsed. Unknown formats remain unknown.
define echo_temporal_milliseconds with value as Str returning Str:
    if string_length(value) < 9 or else not (substring(value and 0 and 8) equals "unix-ms:"):
        return "null"
    set digits to substring(value and 8 and string_length(value) - 8)
    if string_length(digits) > 16 or else string_length(digits) equals 0:
        return "null"
    set index to 0
    repeat while index < string_length(digits):
        if string_contains("0123456789" and substring(digits and index and 1)) equals 0:
            return "null"
        set index to index + 1
    set value_ms to http_decimal(digits)
    if value_ms <= 0:
        return "null"
    return int_to_string(value_ms)

define echo_temporal_elapsed with start as Str and observed as Int returning Str:
    if start equals "null" or else observed < http_decimal(start):
        return "null"
    return int_to_string(observed - http_decimal(start))

# Exact current session only: inherited branch history, imported memories,
# recaps and autonomous jobs cannot turn into a fictitious human start time.
# Callers supply an already-authorised run; this routine is not a public lookup.
define echo_temporal_observation with database as Int and run as Str and observed as Int returning Str:
    set values to create_list()
    set added to append_list(values and run)
    set statement to "SELECT r.session,s.created,e.occurred,e.sequence,COALESCE(json_extract(CASE WHEN json_valid(t.payload) THEN t.payload ELSE '{}' END,'$.received_unix_ms'),'') FROM echo_runs r JOIN echo_sessions s ON s.session=r.session JOIN echo_events e ON e.event=r.objective_event AND e.session=r.session LEFT JOIN echo_events t ON t.event=e.event||':received' AND t.session=e.session AND t.kind='input_received' WHERE r.run=?1;"
    set current to history_collect_one(checkpoint_prepare(database and statement and values))
    if not (archive_list_text(current and 0) equals "found"):
        return "{\"status\":\"temporal-context-unavailable\"}"
    set session to archive_list_text(current and 1)
    set created to echo_temporal_milliseconds(archive_list_text(current and 2))
    set received to echo_temporal_milliseconds(archive_list_text(current and 3))
    set source_received to echo_temporal_milliseconds(concat("unix-ms:" and archive_list_text(current and 5)))
    set parameters to create_list()
    set added to append_list(parameters and session)
    set added to append_list(parameters and archive_list_text(current and 4))
    # Runtime autonomy messages are not human turns. Guidance counts only when
    # it is an actual human input. Synthetic/delegated origins stay labelled.
    set query to "WITH turns AS (SELECT e.sequence,e.occurred,COALESCE(json_extract(CASE WHEN json_valid(t.payload) THEN t.payload ELSE '{}' END,'$.received_unix_ms'),'') AS receipt FROM echo_events e LEFT JOIN echo_events t ON t.event=e.event||':received' AND t.session=e.session AND t.kind='input_received' WHERE e.session=?1 AND e.sequence<=CAST(?2 AS INTEGER) AND e.kind IN ('user','user_guidance') AND NOT (json_valid(e.payload) AND COALESCE(json_extract(CASE WHEN json_valid(e.payload) THEN e.payload ELSE '{}' END,'$.runtime_autonomy'),0)=1)) SELECT CAST(COUNT(*) AS TEXT),COALESCE((SELECT occurred FROM turns ORDER BY sequence LIMIT 1),''),COALESCE((SELECT occurred FROM turns WHERE sequence<CAST(?2 AS INTEGER) ORDER BY sequence DESC LIMIT 1),''),COALESCE((SELECT receipt FROM turns ORDER BY sequence LIMIT 1),''),COALESCE((SELECT receipt FROM turns WHERE sequence<CAST(?2 AS INTEGER) ORDER BY sequence DESC LIMIT 1),'') FROM turns;"
    set turns to history_collect_one(checkpoint_prepare(database and query and parameters))
    if not (archive_list_text(turns and 0) equals "found"):
        return "{\"status\":\"temporal-context-unavailable\"}"
    set first to echo_temporal_milliseconds(archive_list_text(turns and 2))
    set previous to echo_temporal_milliseconds(archive_list_text(turns and 3))
    set first_receipt to echo_temporal_milliseconds(concat("unix-ms:" and archive_list_text(turns and 4)))
    set previous_receipt to echo_temporal_milliseconds(concat("unix-ms:" and archive_list_text(turns and 5)))
    set result to concat("{\"status\":\"observed\",\"observed_unix_ms\":" and int_to_string(observed))
    set result to concat(result and concat(",\"clock\":" and provider_quote(echo_clock_observation(observed))))
    set result to concat(result and concat(",\"session_created_unix_ms\":" and created))
    set result to concat(result and concat(",\"session_age_ms\":" and echo_temporal_elapsed(created and observed)))
    set result to concat(result and concat(",\"first_admitted_input_unix_ms\":" and first))
    set result to concat(result and concat(",\"elapsed_since_first_admitted_input_ms\":" and echo_temporal_elapsed(first and observed)))
    set result to concat(result and concat(",\"current_run_admitted_unix_ms\":" and received))
    set result to concat(result and concat(",\"elapsed_since_run_admitted_ms\":" and echo_temporal_elapsed(received and observed)))
    set result to concat(result and concat(",\"previous_admitted_input_unix_ms\":" and previous))
    set result to concat(result and concat(",\"gap_between_admitted_inputs_ms\":" and echo_temporal_elapsed(previous and http_decimal(received))))
    set result to concat(result and concat(",\"scoped_input_count\":" and archive_list_text(turns and 1)))
    set result to concat(result and concat(",\"first_input_received_unix_ms\":" and first_receipt))
    set result to concat(result and concat(",\"current_input_received_unix_ms\":" and source_received))
    set result to concat(result and concat(",\"previous_input_received_unix_ms\":" and previous_receipt))
    set result to concat(result and concat(",\"gap_between_received_inputs_ms\":" and echo_temporal_elapsed(previous_receipt and http_decimal(source_received))))
    set result to concat(result and concat(",\"receipt_to_admission_ms\":" and echo_temporal_elapsed(source_received and http_decimal(received))))
    return concat(result and ",\"interpretation\":\"Computed from this exact session's stored host timestamps. Inputs include recorded user/guidance events, which may be labelled operator tests or delegated work; do not infer a human author from role alone. Admission timestamps describe when a queued request entered its run, NOT when the user sent it or the gateway received it. Separately recorded receipt timestamps come from the immutable transport journal; absent historical receipts remain null. Session age and wall-clock gaps are not continuous active conversation time. Do not estimate time spent computing or active conversation from these values; neither is measured here. Historical memories and parent branches do not set this session's start. Null durations mean unknown timestamp or backward clock, not zero. This is dated runtime evidence, not a new user request.\"}")

# Render computed durations, never estimates derived from prose or token volume.
# Seconds are floored; the raw observation remains available to system_inspect.
define echo_temporal_duration with milliseconds as Str returning Str:
    if milliseconds equals "null" or else string_length(milliseconds) equals 0:
        return "unknown"
    set value to http_decimal(milliseconds)
    if value < 0:
        return "unknown"
    set seconds to value / 1000
    set text to concat(int_to_string(seconds / 3600) and " h ")
    set text to concat(text and concat(int_to_string((seconds / 60) modulo 60) and " min "))
    return concat(text and concat(int_to_string(seconds modulo 60) and " s"))

define echo_temporal_duration_field with fields as List and key as Str returning Str:
    return echo_temporal_duration(provider_value(fields and provider_member(fields and 0 and key)))

# A fresh, compact suffix for EVERY model request, including tool continuations.
# Historical timestamps stay in the cacheable history; this sample is current.
define echo_temporal_current with database as Int and run as Str and observed as Int returning Str:
    set observation to echo_temporal_observation(database and run and observed)
    set fields to provider_json_tokens(observation)
    set text to concat("CURRENT RUNTIME TIME — sampled for this model request. " and echo_clock_observation(observed))
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "observed"):
        return concat(text and ". Session durations are unavailable; do not infer them from historical text. Runtime evidence, not a new user request.")
    set text to concat(text and concat("\nElapsed since this session was created: " and echo_temporal_duration_field(fields and "session_age_ms")))
    set text to concat(text and concat("\nElapsed since this session's first input was admitted: " and echo_temporal_duration_field(fields and "elapsed_since_first_admitted_input_ms")))
    set first_receipt to provider_value(fields and provider_member(fields and 0 and "first_input_received_unix_ms"))
    set text to concat(text and concat("\nElapsed since this session's first input was received: " and echo_temporal_duration(echo_temporal_elapsed(first_receipt and observed))))
    set text to concat(text and concat("\nElapsed since the current request was admitted: " and echo_temporal_duration_field(fields and "elapsed_since_run_admitted_ms")))
    set text to concat(text and concat("\nGap between the preceding and current input receipts: " and echo_temporal_duration_field(fields and "gap_between_received_inputs_ms")))
    set text to concat(text and concat("\nCurrent input's receipt-to-admission queue delay: " and echo_temporal_duration_field(fields and "receipt_to_admission_ms")))
    set text to concat(text and concat("\nInputs through this request in this exact session: " and provider_value(fields and provider_member(fields and 0 and "scoped_input_count"))))
    return concat(text and ".\nUse these computed durations for elapsed-time claims about this session. Historical clocks and recalled conversations describe their own dates; their durations do not accumulate into this session. Session age includes idle time; request age includes tool and waiting time, not measured inference time. Unknown is not zero. This is runtime evidence accompanying the existing request, not a new user request; answer the user normally without reciting timing unless relevant.")

define echo_temporal_messages_at with database as Int and run as Str and messages as Str and observed as Int returning Str:
    set timing to echo_temporal_current(database and run and observed)
    set prefix to substring(messages and 0 and string_length(messages) - 1)
    if string_length(prefix) > 1:
        set prefix to concat(prefix and ",")
    return concat(prefix and concat("{\"role\":\"user\",\"content\":" and concat(provider_quote(timing) and "}]")))
