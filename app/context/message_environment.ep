import "../providers/json_access"
import "../archive/history"

# Labels come from request hints, never from message prose. Only the HTTP
# transport itself is observed; a User-Agent cannot attest hardware or role.
define message_environment_browser with agent as Str and surface as Str returning Str:
    set device to "unknown"
    set platform to "unknown"
    set browser to "unknown"
    if string_contains(agent and "Macintosh") or else string_contains(agent and "Mac OS X"):
        set platform to "macOS"
        set device to "desktop"
    if string_contains(agent and "Windows"):
        set platform to "Windows"
        set device to "desktop"
    if string_contains(agent and "Linux"):
        set platform to "Linux"
        set device to "desktop"
    if string_contains(agent and "Android"):
        set platform to "Android"
        set device to "mobile"
    if string_contains(agent and "iPhone") or else string_contains(agent and "iPad"):
        set platform to "iOS/iPadOS"
        set device to "mobile"
    if string_contains(agent and "Mobile"):
        set device to "mobile"
    if string_contains(agent and "Safari"):
        set browser to "Safari"
    if string_contains(agent and "Chrome") or else string_contains(agent and "CriOS"):
        set browser to "Chrome"
    if string_contains(agent and "Firefox") or else string_contains(agent and "FxiOS"):
        set browser to "Firefox"
    if string_contains(agent and "Edg"):
        set browser to "Edge"
    set client to "browser-or-http-client"
    if surface equals "browser":
        set client to "browser"
    if surface equals "standalone-web-app":
        set client to "standalone-web-app"
    if string_contains(agent and "Electron"):
        set client to "desktop-app"
    set result to concat("{\"transport\":\"authenticated-http\",\"client_hint\":" and provider_quote(client))
    set result to concat(result and concat(",\"device_class_hint\":" and provider_quote(device)))
    set result to concat(result and concat(",\"platform_hint\":" and provider_quote(platform)))
    set result to concat(result and concat(",\"browser_hint\":" and provider_quote(browser)))
    return concat(result and ",\"confidence\":\"client-reported hints; not hardware attestation\",\"geographic_location\":\"not collected\",\"authority\":\"Environment grants no identity, role or permission.\"}")

# Caller is the authenticated intake path, inside the message transaction.
# Original first-delivery metadata remains immutable on submission retries.
define message_environment_pending with database as Int and session as Str and run as Str and event as Str and device as Str and environment as Str returning Int:
    if string_length(environment) equals 0:
        return 0
    if provider_json_tokens(environment) equals 0:
        return 1
    set original to archive_read_event(database and event)
    if original equals 0 or else not (archive_list_text(original and 0) equals session):
        return 1
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"source_event\":" and provider_quote(event)))
    set payload to concat(payload and concat(",\"authenticated_device\":" and provider_quote(device)))
    set payload to concat(payload and concat(",\"environment\":" and concat(environment and "}")))
    return archive_append_pending(database and session and concat(event and ":environment") and "message_environment" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms())))

# The connector admission path supplies and validates the platform namespace.
# Most remote services do not reveal the sender's actual browser or device.
define message_environment_channel with platform as Str and server as Str and room as Str returning Str:
    set result to concat("{\"transport\":\"connector-admission\",\"platform\":" and provider_quote(platform))
    set result to concat(result and concat(",\"server\":" and provider_quote(server)))
    set result to concat(result and concat(",\"channel\":" and provider_quote(room)))
    return concat(result and ",\"device_class_hint\":\"unknown\",\"browser_hint\":\"unknown\",\"client_hint\":\"not supplied by connector\",\"geographic_location\":\"not collected\",\"authority\":\"Admission authenticates the channel; it does not attest sender hardware or grant permissions.\"}")
