import "../security/principals"
import "../retained_text"
import "../tools/history_tools"
import "../agent/run_state"

# Requesting a rebuild is a durable tool observation, not an immediate edit.
# The runner consumes observed requests only after all tool results are saved.
define recap_rebuild_enqueue with database as Int and run as Str and call_id as Str and arguments as Str returning Str:
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "{\"status\":\"invalid-arguments\"}"
    set reason_field to provider_member(tokens and 0 and "reason")
    if not (provider_kind(tokens and reason_field) equals "string") or else string_length(provider_value(tokens and reason_field)) equals 0:
        return "{\"status\":\"invalid-arguments\"}"
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        if not (provider_value(tokens and index) equals "reason"):
            return "{\"status\":\"invalid-arguments\"}"
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set retained_list_1 to create_list()
    set retained_item_1_0 to run
    set retained_added to append_list(retained_list_1 and retained_item_1_0)
    set retained_item_1_1 to call_id
    set retained_added to append_list(retained_list_1 and retained_item_1_1)
    set values to retained_list_1
    set row to history_collect_one(checkpoint_prepare(database and concat("SELECT t.request_event FROM echo_tool_calls t JOIN echo_runs r ON r.run=t.run AND r.session=t.session JOIN echo_session_owners o ON o.session=r.session JOIN echo_devices d ON d.device=o.device JOIN echo_events e ON e.event=t.request_event AND e.session=t.session WHERE " and concat(principal_session_sql(database and "o.session" and "o.device") and " AND t.run=?1 AND t.call_id=?2 AND t.state='running' AND r.state='tools' AND d.revoked=0 AND json_extract(e.payload,'$.name')='session_rebuild_recap' AND json_extract(e.payload,'$.run_id')=?1 AND json_extract(e.payload,'$.call_id')=?2;")) and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "{\"status\":\"not-authorized\"}"
    return "{\"status\":\"queued\",\"instruction\":\"After the saved tool observations, Echo will rebuild from original records and independently review before activation. The previous recap remains active on failure. Do not claim completion until the rebuilt checkpoint is available. Corrections must remain grounded in original user/source records.\"}"

# Return none, required, recorded or an explicit recoverable failure. A crash
# after checkpoint activation but before this receipt reuses that checkpoint;
# it does not regenerate another recap or mutate original source records.
define recap_rebuild_pending with database as Int and run as Str returning Str:
    set retained_list_2 to create_list()
    set retained_item_2_0 to run
    set retained_added to append_list(retained_list_2 and retained_item_2_0)
    set values to retained_list_2
    set query to "SELECT t.session,t.request_event,e.sequence FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event AND q.session=t.session JOIN echo_events e ON e.event=t.result_event AND e.session=t.session WHERE t.run=?1 AND t.state='observed' AND json_extract(q.payload,'$.name')='session_rebuild_recap' AND json_extract(e.payload,'$.result.status')='queued' AND NOT EXISTS(SELECT 1 FROM echo_events f WHERE f.session=t.session AND f.event=t.request_event||':rebuild-completed' AND f.kind='recap_rebuild_completed') ORDER BY e.sequence LIMIT 1;"
    set pending to history_collect_one(checkpoint_prepare(database and query and values))
    if archive_list_text(pending and 0) equals "end":
        return "none"
    if not (archive_list_text(pending and 0) equals "found"):
        return "archive-error"
    set session to archive_list_text(pending and 1)
    set request to archive_list_text(pending and 2)
    set retained_list_3 to create_list()
    set retained_item_3_0 to session
    set retained_added to append_list(retained_list_3 and retained_item_3_0)
    set retained_item_3_1 to archive_list_text(pending and 3)
    set retained_added to append_list(retained_list_3 and retained_item_3_1)
    set values to retained_list_3
    set active to history_collect_one(checkpoint_prepare(database and "SELECT c.identity,c.source_end,c.source_digest FROM echo_active_context a JOIN echo_checkpoints c ON c.identity=a.checkpoint AND c.session=a.session JOIN echo_events e ON e.event=c.source_end AND e.session=c.session AND e.digest=c.source_digest JOIN echo_events v ON v.event=json_extract(c.validation,'$.review_event') AND v.session=c.session AND v.kind IN ('recap_review','recap_review_synthesis') WHERE a.session=?1 AND e.sequence>=CAST(?2 AS INTEGER);" and values))
    if archive_list_text(active and 0) equals "end":
        return "required"
    if not (archive_list_text(active and 0) equals "found"):
        return "archive-error"
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"request_event\":" and provider_quote(request)))
    set payload to concat(payload and concat(",\"checkpoint\":" and provider_quote(archive_list_text(active and 1))))
    set payload to concat(payload and concat(",\"source_end\":" and concat(provider_quote(archive_list_text(active and 2)) and "}")))
    if archive_append(database and session and concat(request and ":rebuild-completed") and "recap_rebuild_completed" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return "archive-error"
    return "recorded"

define recap_rebuild_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"session_rebuild_recap\",\"description\":\"Request a fresh recap from original session records, for example after a user correction or finding an omission. This queues work in the SAME run; the old context stays active until source-based generation and independent review pass. Supply the reason and original event references where available. This does not edit source history or elevate tool text to user authority. After continuation, use session_get_compaction to inspect the active result.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"reason\":{\"type\":\"string\"}},\"required\":[\"reason\"],\"additionalProperties\":false}}}"
