import "../providers/archived_stream"

# Legacy string findings remain conservative repair evidence. New reports must
# explicitly distinguish observations from unresolved, actionable defects.
# No text-keyword heuristic turns criticism into an approval.
define recap_findings_validate with tokens as List and findings as List returning Str:
    if findings equals 0:
        return "invalid-review"
    set status to "review-pass"
    for each finding in findings:
        if provider_kind(tokens and finding) equals "string":
            if string_length(provider_value(tokens and finding)) equals 0:
                return "invalid-review"
            set status to "review-repair"
        else:
            set disposition to provider_value(tokens and provider_member(tokens and finding and "status"))
            set explanation to provider_member(tokens and finding and "explanation")
            set correction to provider_member(tokens and finding and "correction")
            if not (provider_kind(tokens and explanation) equals "string") or else string_length(provider_value(tokens and explanation)) equals 0 or else not (provider_kind(tokens and correction) equals "string"):
                return "invalid-review"
            if disposition equals "supported":
                if string_length(provider_value(tokens and correction)) > 0:
                    return "invalid-review"
            else if disposition equals "defect" or else disposition equals "uncertain":
                if string_length(provider_value(tokens and correction)) equals 0:
                    return "invalid-review"
                set status to "review-repair"
            else:
                return "invalid-review"
    return status
