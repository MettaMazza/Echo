import "recap_review_indexed"

# A criticism must bind both an original event and the current candidate text.
# Legacy positional commentary is never promoted to a new repair instruction.
define recap_bound_review_expand with sources as Str and candidate as Str and report as Str returning Str:
    set originals to provider_json_tokens(sources)
    set tokens to provider_json_tokens(report)
    set current to provider_json_tokens(candidate)
    if originals equals 0 or else tokens equals 0 or else current equals 0 or else provider_unique_objects(tokens) equals 0:
        return ""
    set records to provider_items(originals and provider_member(originals and 0 and "records"))
    set issues to provider_items(tokens and provider_member(tokens and 0 and "issues"))
    if records equals 0 or else issues equals 0:
        return ""
    if not (provider_value(tokens and provider_member(tokens and 0 and "coverage")) equals "complete") or else not (provider_value(tokens and provider_member(tokens and 0 and "source_digest")) equals ep_sha256(sources)):
        return ""
    set normalized_issues to "["
    set keys to "["
    set comma to ""
    for each issue in issues:
        set identity to provider_value(tokens and provider_member(tokens and issue and "event"))
        set source_position to 0
        set matched_position to -1
        for each original in records:
            if identity equals provider_value(originals and provider_member(originals and original and "event")):
                if matched_position >= 0:
                    return ""
                set matched_position to source_position
            set source_position to source_position + 1
        if matched_position < 0:
            return ""
        set ordinal to int_to_string(matched_position)
        # Retain validation of the older explicit-index representation.
        if provider_member(tokens and issue and "index") >= 0 and not (provider_index(tokens and provider_member(tokens and issue and "index")) equals ordinal):
            return ""
        set correction to provider_value(tokens and provider_member(tokens and issue and "correction"))
        if string_length(correction) equals 0:
            return ""
        set category to provider_value(tokens and provider_member(tokens and issue and "category"))
        set entry_ordinal to provider_index(tokens and provider_member(tokens and issue and "entry_index"))
        set quoted to provider_value(tokens and provider_member(tokens and issue and "candidate_text"))
        set verdict to provider_value(tokens and provider_member(tokens and issue and "verdict"))
        if string_length(entry_ordinal) equals 0:
            return ""
        set categories to recap_categories()
        set added to append_list(categories and "summary")
        set allowed to 0
        for each name in categories:
            if ptr_to_str(name) equals category:
                set allowed to 1
        if allowed equals 0:
            return ""
        if provider_member(tokens and issue and "candidate_text") < 0 and not (verdict equals "omitted"):
            if category equals "summary":
                set quoted to provider_value(current and provider_member(current and 0 and "summary"))
            else:
                set selected to provider_items(current and provider_member(current and provider_member(current and 0 and "state") and category))
                if selected equals 0 or else http_decimal(entry_ordinal) >= length_list(selected):
                    return ""
                set quoted to provider_value(current and provider_member(current and get_list(selected and http_decimal(entry_ordinal)) and "text"))
        if string_length(quoted) equals 0:
            if not (verdict equals "omitted"):
                return ""
        else if category equals "summary":
            if not (quoted equals provider_value(current and provider_member(current and 0 and "summary"))) or else not (entry_ordinal equals "0"):
                return ""
        else:
            set entries to provider_items(current and provider_member(current and provider_member(current and 0 and "state") and category))
            if entries equals 0 or else http_decimal(entry_ordinal) >= length_list(entries):
                return ""
            if not (quoted equals provider_value(current and provider_member(current and get_list(entries and http_decimal(entry_ordinal)) and "text"))):
                return ""
        set normalized to agent_json_source(report and tokens and issue)
        if provider_member(tokens and issue and "index") < 0:
            set normalized to concat(substring(normalized and 0 and string_length(normalized) - 1) and concat(",\"index\":" and concat(ordinal and "}")))
        if provider_member(tokens and issue and "candidate_text") < 0:
            set normalized to concat(substring(normalized and 0 and string_length(normalized) - 1) and concat(",\"candidate_text\":" and concat(provider_quote(quoted) and "}")))
        set normalized_issues to concat(normalized_issues and concat(comma and normalized))
        set key to concat(identity and concat(":" and concat(category and concat(":" and concat(entry_ordinal and concat(":" and verdict))))))
        set keys to concat(keys and concat(comma and provider_quote(key)))
        set comma to ","
    # The model explicitly reviewed the whole prefix. Host expansion records
    # unflagged sources without inventing individual model-authored judgments.
    set converted to concat("{\"candidate_digest\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "candidate_digest"))))
    set converted to concat(converted and concat(",\"source_end\":" and provider_quote(provider_value(tokens and provider_member(tokens and 0 and "source_end")))))
    set converted to concat(converted and concat(",\"issues\":" and concat(normalized_issues and "]")))
    set converted to concat(converted and ",\"findings\":[],\"verdicts\":[")
    set position to 0
    for each record in records:
        set verdict to "covered"
        set matches to 0
        for each issue in issues:
            if provider_value(tokens and provider_member(tokens and issue and "event")) equals provider_value(originals and provider_member(originals and record and "event")):
                set verdict to provider_value(tokens and provider_member(tokens and issue and "verdict"))
                set matches to matches + 1
        if matches > 1:
            return ""
        if position > 0:
            set converted to concat(converted and ",")
        set converted to concat(converted and provider_quote(verdict))
        set position to position + 1
    set converted to concat(converted and "]}")
    set expanded to recap_review_expand(sources and converted)
    set expanded to ptr_to_str(string_replace(expanded and "Covered: indexed model verdict; no individual explanation was emitted." and "Covered by the model's whole-prefix review; host expanded the absence of a source-bound defect."))
    set expanded_tokens to provider_json_tokens(expanded)
    if provider_items(expanded_tokens and provider_member(expanded_tokens and 0 and "records")) equals 0:
        return ""
    # Keep concrete corrections as actionable findings, bound to the same issue.
    set actionable to "["
    set comma to ""
    for each issue in issues:
        set explanation to provider_value(tokens and provider_member(tokens and issue and "explanation"))
        set correction to provider_value(tokens and provider_member(tokens and issue and "correction"))
        set actionable to concat(actionable and concat(comma and concat("{\"status\":\"defect\",\"explanation\":" and provider_quote(explanation))))
        set actionable to concat(actionable and concat(",\"correction\":" and concat(provider_quote(correction) and "}")))
        set comma to ","
    set actionable to concat(actionable and "]")
    set expanded to ptr_to_str(string_replace(expanded and "\"findings\":[]" and concat("\"findings\":" and actionable)))
    return concat(substring(expanded and 0 and string_length(expanded) - 1) and concat(",\"issue_keys\":" and concat(keys and "]}")))

# Compare defect identities independently of recap wording or review order.
# This never accepts an unreviewed candidate; it detects a nonconverging repair.
define recap_review_same_issues with previous as Str and current as Str returning Int:
    set old_tokens to provider_json_tokens(previous)
    set new_tokens to provider_json_tokens(current)
    set old_items to provider_items(old_tokens and provider_member(old_tokens and 0 and "issue_keys"))
    set new_items to provider_items(new_tokens and provider_member(new_tokens and 0 and "issue_keys"))
    if old_items equals 0 or else new_items equals 0 or else length_list(old_items) equals 0 or else length_list(old_items) is not equal to length_list(new_items):
        return 0
    for each item in old_items:
        set matches to 0
        for each other in new_items:
            if provider_value(old_tokens and item) equals provider_value(new_tokens and other):
                set matches to matches + 1
        if matches is not equal to 1:
            return 0
    return 1
