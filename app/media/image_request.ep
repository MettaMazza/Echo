import "../retained_text"
import "../providers/json_tokens"
import "../providers/json_string"
import "../tools/history_tools"

# Host profile owns the executable, weights and native argument template.
# Model text can fill named values only; it cannot select paths or add flags.
define image_request_arguments with profile as Str and arguments as Str returning List:
    set config to provider_json_tokens(profile)
    set request to provider_json_tokens(arguments)
    if config equals 0 or else request equals 0:
        return 0
    if provider_unique_objects(config) equals 0 or else provider_unique_objects(request) equals 0 or else not (provider_kind(config and 0) equals "{") or else not (provider_kind(request and 0) equals "{"):
        return 0
    set executable to provider_value(config and provider_member(config and 0 and "executable"))
    if string_length(executable) equals 0 or else get_character(executable and 0) is not equal to 47:
        return 0
    set prompt to provider_member(request and 0 and "prompt")
    if not (provider_kind(request and prompt) equals "string") or else string_length(string_trim(provider_value(request and prompt))) equals 0:
        return 0
    set index to 1
    repeat while not (provider_kind(request and index) equals "}"):
        set key to provider_value(request and index)
        if not (key equals "prompt" or else key equals "width" or else key equals "height" or else key equals "steps" or else key equals "seed"):
            return 0
        set index to provider_after(request and index + 2)
        if provider_kind(request and index) equals ",":
            set index to index + 1
    set retained_list_1 to create_list()
    set retained_item_1_0 to "width"
    set retained_added to append_list(retained_list_1 and retained_item_1_0)
    set retained_item_1_1 to "height"
    set retained_added to append_list(retained_list_1 and retained_item_1_1)
    set retained_item_1_2 to "steps"
    set retained_added to append_list(retained_list_1 and retained_item_1_2)
    set retained_item_1_3 to "seed"
    set retained_added to append_list(retained_list_1 and retained_item_1_3)
    set names to retained_list_1
    set index to 0
    repeat while index is less than length_list(names):
        set name to archive_list_text(names and index)
        set field to provider_member(request and 0 and name)
        if not (provider_kind(request and field) equals "number"):
            return 0
        set numeric_value to http_decimal(provider_index(request and field))
        if numeric_value is less than 0 or else (not (name equals "seed") and numeric_value equals 0):
            return 0
        set index to index + 1
    set items to provider_items(config and provider_member(config and 0 and "arguments"))
    if items equals 0:
        return 0
    set output to create_list()
    set seen to create_list()
    set index to 0
    repeat while index is less than length_list(items):
        set field to get_list(items and index)
        if not (provider_kind(config and field) equals "string"):
            return 0
        set value to provider_value(config and field)
        set retained_list_2 to create_list()
        set retained_item_2_0 to "prompt"
        set retained_added to append_list(retained_list_2 and retained_item_2_0)
        set retained_item_2_1 to "width"
        set retained_added to append_list(retained_list_2 and retained_item_2_1)
        set retained_item_2_2 to "height"
        set retained_added to append_list(retained_list_2 and retained_item_2_2)
        set retained_item_2_3 to "steps"
        set retained_added to append_list(retained_list_2 and retained_item_2_3)
        set retained_item_2_4 to "seed"
        set retained_added to append_list(retained_list_2 and retained_item_2_4)
        set keys to retained_list_2
        set key_index to 0
        repeat while key_index is less than length_list(keys):
            set key to archive_list_text(keys and key_index)
            if value equals concat("{" and concat(key and "}")):
                set added to append_list(seen and key)
                set requested to provider_member(request and 0 and key)
                if key equals "prompt":
                    set value to provider_value(request and requested)
                else:
                    set value to provider_index(request and requested)
                break
            set key_index to key_index + 1
        set added to append_list(output and value)
        set index to index + 1
    # Require each setting exactly once; no silently ignored controls.
    set retained_list_3 to create_list()
    set retained_item_3_0 to "prompt"
    set retained_added to append_list(retained_list_3 and retained_item_3_0)
    set retained_item_3_1 to "width"
    set retained_added to append_list(retained_list_3 and retained_item_3_1)
    set retained_item_3_2 to "height"
    set retained_added to append_list(retained_list_3 and retained_item_3_2)
    set retained_item_3_3 to "steps"
    set retained_added to append_list(retained_list_3 and retained_item_3_3)
    set retained_item_3_4 to "seed"
    set retained_added to append_list(retained_list_3 and retained_item_3_4)
    set keys to retained_list_3
    set index to 0
    repeat while index is less than length_list(keys):
        set count to 0
        set scan to 0
        repeat while scan is less than length_list(seen):
            if archive_list_text(seen and scan) equals archive_list_text(keys and index):
                set count to count + 1
            set scan to scan + 1
        if count is not equal to 1:
            return 0
        set index to index + 1
    return output
