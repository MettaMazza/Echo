import "../web/attachments"
import "../security/principals"
import "../retained_text"
import "../tools/history_tools"
import "../archive/session_scope"

# This adapter accepts only an owned archive identity and spoken language.
# Runtime paths, model weights and output filenames are host controlled.
define speech_request_source with database as Int and session as Str and arguments as Str returning List:
    return speech_request_source_device(database and "" and session and arguments)

define speech_request_source_device with database as Int and device as Str and session as Str and arguments as Str returning List:
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        set retained_list_1 to create_list()
        set retained_item_1_0 to "invalid-arguments"
        set retained_added to append_list(retained_list_1 and retained_item_1_0)
        return retained_list_1
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "attachment" or else key equals "language"):
            set retained_list_2 to create_list()
            set retained_item_2_0 to "invalid-arguments"
            set retained_added to append_list(retained_list_2 and retained_item_2_0)
            return retained_list_2
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set field to provider_member(tokens and 0 and "attachment")
    set language to provider_member(tokens and 0 and "language")
    if not (provider_kind(tokens and field) equals "string") or else not (provider_kind(tokens and language) equals "string"):
        set retained_list_3 to create_list()
        set retained_item_3_0 to "invalid-arguments"
        set retained_added to append_list(retained_list_3 and retained_item_3_0)
        return retained_list_3
    set spoken to provider_value(tokens and language)
    if string_length(spoken) equals 0:
        set retained_list_4 to create_list()
        set retained_item_4_0 to "invalid-language"
        set retained_added to append_list(retained_list_4 and retained_item_4_0)
        return retained_list_4
    set index to 0
    repeat while index is less than string_length(spoken):
        set code to get_character(spoken and index)
        if code < 97 or else code > 122:
            set retained_list_5 to create_list()
            set retained_item_5_0 to "invalid-language"
            set retained_added to append_list(retained_list_5 and retained_item_5_0)
            return retained_list_5
        set index to index + 1
    set retained_list_6 to create_list()
    set retained_item_6_0 to session
    set retained_added to append_list(retained_list_6 and retained_item_6_0)
    set retained_item_6_1 to provider_value(tokens and field)
    set retained_added to append_list(retained_list_6 and retained_item_6_1)
    set values to retained_list_6
    set row to history_collect_one(checkpoint_prepare(database and concat(session_scope_sql() and concat("SELECT a.path,a.digest,CAST(a.bytes AS TEXT),a.event,a.media_type FROM scopes s JOIN echo_attachments a ON a.session=s.session JOIN echo_events e ON e.event=a.event AND e.session=a.session AND e.sequence<=s.boundary JOIN echo_session_owners o ON o.session=a.session JOIN echo_devices d ON d.device=o.device WHERE " and concat(principal_session_sql(database and "o.session" and "o.device") and " AND a.attachment=?2 AND d.revoked=0 AND d.device=(SELECT device FROM echo_session_owners WHERE session=?1);"))) and values))
    if principal_session_active(database and session) equals 0 and string_length(device) > 0 and web_attachment_session_allowed(database and device and session and 0) equals 1:
        set shared_values to [session,provider_value(tokens and field)]
        set row to history_collect_one(checkpoint_prepare(database and "SELECT a.path,a.digest,CAST(a.bytes AS TEXT),a.event,a.media_type FROM echo_attachments a JOIN echo_events e ON e.event=a.event AND e.session=a.session WHERE a.session=?1 AND a.attachment=?2;" and shared_values))
    if not (archive_list_text(row and 0) equals "found"):
        return row
    set media to archive_list_text(row and 5)
    if not (media equals "audio/wav" or else media equals "audio/x-wav" or else media equals "audio/wave"):
        set retained_list_7 to create_list()
        set retained_item_7_0 to "unsupported-audio-format"
        set retained_added to append_list(retained_list_7 and retained_item_7_0)
        return retained_list_7
    set added to append_list(row and spoken)
    return row

define speech_request_arguments with profile as Str and language as Str returning List:
    set tokens to provider_json_tokens(profile)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return 0
    set retained_list_8 to create_list()
    set retained_item_8_0 to "executable"
    set retained_added to append_list(retained_list_8 and retained_item_8_0)
    set retained_item_8_1 to "model"
    set retained_added to append_list(retained_list_8 and retained_item_8_1)
    set retained_item_8_2 to "engine_revision"
    set retained_added to append_list(retained_list_8 and retained_item_8_2)
    set retained_item_8_3 to "model_sha256"
    set retained_added to append_list(retained_list_8 and retained_item_8_3)
    set names to retained_list_8
    set index to 0
    repeat while index is less than length_list(names):
        set field to provider_member(tokens and 0 and archive_list_text(names and index))
        if not (provider_kind(tokens and field) equals "string") or else string_length(provider_value(tokens and field)) equals 0:
            return 0
        set index to index + 1
    set executable to provider_value(tokens and provider_member(tokens and 0 and "executable"))
    set model to provider_value(tokens and provider_member(tokens and 0 and "model"))
    if get_character(executable and 0) is not equal to 47 or else get_character(model and 0) is not equal to 47:
        return 0
    # No duration, output-token or segment-length override. Whisper processes
    # the entire recording using its native windows. JSON retains timestamps.
    set retained_list_9 to create_list()
    set retained_item_9_0 to "--model"
    set retained_added to append_list(retained_list_9 and retained_item_9_0)
    set retained_item_9_1 to model
    set retained_added to append_list(retained_list_9 and retained_item_9_1)
    set retained_item_9_2 to "--file"
    set retained_added to append_list(retained_list_9 and retained_item_9_2)
    set retained_item_9_3 to "input.wav"
    set retained_added to append_list(retained_list_9 and retained_item_9_3)
    set retained_item_9_4 to "--language"
    set retained_added to append_list(retained_list_9 and retained_item_9_4)
    set retained_item_9_5 to language
    set retained_added to append_list(retained_list_9 and retained_item_9_5)
    set retained_item_9_6 to "--output-txt"
    set retained_added to append_list(retained_list_9 and retained_item_9_6)
    set retained_item_9_7 to "--output-json"
    set retained_added to append_list(retained_list_9 and retained_item_9_7)
    set retained_item_9_8 to "--output-file"
    set retained_added to append_list(retained_list_9 and retained_item_9_8)
    set retained_item_9_9 to "transcript"
    set retained_added to append_list(retained_list_9 and retained_item_9_9)
    set retained_item_9_10 to "--print-progress"
    set retained_added to append_list(retained_list_9 and retained_item_9_10)
    return retained_list_9

define speech_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"attachment_transcribe\",\"description\":\"Transcribe a saved WAV audio attachment locally. Original audio stays archived. Supply a runtime language code or auto. Returns owned transcript text and timestamped JSON attachments; use attachment_read_text to read them progressively. Speech recognition is an interpretation, not exact original text. Unsupported audio formats are explicit.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"attachment\":{\"type\":\"string\"},\"language\":{\"type\":\"string\"}},\"required\":[\"attachment\",\"language\"],\"additionalProperties\":false}}}"
