import "../retained_text"
import "../providers/json_tokens"
import "../providers/json_string"

# Text is written to a private input file, never interpolated into a command.
define voice_request_text with arguments as Str returning Str:
    set tokens to provider_json_tokens(arguments)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return ""
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        if not (provider_value(tokens and index) equals "text"):
            return ""
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set field to provider_member(tokens and 0 and "text")
    if not (provider_kind(tokens and field) equals "string"):
        return ""
    set text to provider_value(tokens and field)
    if string_length(string_trim(text)) equals 0:
        return ""
    set index to 0
    repeat while index is less than string_length(text):
        if get_character(text and index) equals 0:
            return ""
        set index to index + 1
    return text

define voice_request_arguments with profile as Str returning List:
    set tokens to provider_json_tokens(profile)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 0
    set retained_list_1 to create_list()
    set retained_item_1_0 to "executable"
    set retained_added to append_list(retained_list_1 and retained_item_1_0)
    set retained_item_1_1 to "voice"
    set retained_added to append_list(retained_list_1 and retained_item_1_1)
    set retained_item_1_2 to "engine_revision"
    set retained_added to append_list(retained_list_1 and retained_item_1_2)
    set keys to retained_list_1
    set index to 0
    repeat while index is less than length_list(keys):
        set field to provider_member(tokens and 0 and archive_list_text(keys and index))
        if not (provider_kind(tokens and field) equals "string") or else string_length(provider_value(tokens and field)) equals 0:
            return 0
        set index to index + 1
    if get_character(provider_value(tokens and provider_member(tokens and 0 and "executable")) and 0) is not equal to 47:
        return 0
    set voice to provider_value(tokens and provider_member(tokens and 0 and "voice"))
    set engine to provider_value(tokens and provider_member(tokens and 0 and "engine"))
    if engine equals "qwen3-tts-resident":
        set config to provider_value(tokens and provider_member(tokens and 0 and "resident_config"))
        if string_length(config) equals 0 or else get_character(config and 0) is not equal to 47:
            return 0
        return [config]
    if engine equals "qwen3-tts-enrolled":
        set arguments to create_list()
        for each name in ["python_library", "python_executable", "model", "conditioning", "reference", "ffmpeg"]:
            set value to provider_value(tokens and provider_member(tokens and 0 and ptr_to_str(name)))
            if string_length(value) equals 0 or else get_character(value and 0) is not equal to 47:
                return 0
            set added to append_list(arguments and value)
        return arguments
    if engine equals "kokoro-onnx":
        set retained_list_2 to create_list()
        set retained_item_2_0 to "python_library"
        set retained_added to append_list(retained_list_2 and retained_item_2_0)
        set retained_item_2_1 to "python_executable"
        set retained_added to append_list(retained_list_2 and retained_item_2_1)
        set retained_item_2_2 to "model"
        set retained_added to append_list(retained_list_2 and retained_item_2_2)
        set retained_item_2_3 to "voices"
        set retained_added to append_list(retained_list_2 and retained_item_2_3)
        set retained_item_2_4 to "language"
        set retained_added to append_list(retained_list_2 and retained_item_2_4)
        set fields to retained_list_2
        set arguments to create_list()
        set index to 0
        repeat while index is less than length_list(fields):
            set field to provider_member(tokens and 0 and archive_list_text(fields and index))
            if not (provider_kind(tokens and field) equals "string") or else string_length(provider_value(tokens and field)) equals 0:
                return 0
            set value to provider_value(tokens and field)
            if index is less than 4 and get_character(value and 0) is not equal to 47:
                return 0
            if index equals 4:
                set added to append_list(arguments and voice)
            set added to append_list(arguments and value)
            set index to index + 1
        return arguments
    if string_length(engine) > 0 and not (engine equals "macos-say"):
        return 0
    set retained_list_3 to create_list()
    set retained_item_3_0 to "-v"
    set retained_added to append_list(retained_list_3 and retained_item_3_0)
    set retained_item_3_1 to voice
    set retained_added to append_list(retained_list_3 and retained_item_3_1)
    set retained_item_3_2 to "-f"
    set retained_added to append_list(retained_list_3 and retained_item_3_2)
    set retained_item_3_3 to "input.txt"
    set retained_added to append_list(retained_list_3 and retained_item_3_3)
    set retained_item_3_4 to "-o"
    set retained_added to append_list(retained_list_3 and retained_item_3_4)
    set retained_item_3_5 to "spoken.wav"
    set retained_added to append_list(retained_list_3 and retained_item_3_5)
    set retained_item_3_6 to "--file-format=WAVE"
    set retained_added to append_list(retained_list_3 and retained_item_3_6)
    set retained_item_3_7 to "--data-format=LEI16@16000"
    set retained_added to append_list(retained_list_3 and retained_item_3_7)
    return retained_list_3

define voice_tool_schema returning Str:
    return "{\"type\":\"function\",\"function\":{\"name\":\"speech_synthesize\",\"description\":\"Create a saved spoken reply locally from supplied text using the host-selected installed voice. Returns a WAV attachment the user can play or download; never autoplays. Text and generation identity remain archived. Use attachment_transcribe if you need to check the actual generated words.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"],\"additionalProperties\":false}}}"
