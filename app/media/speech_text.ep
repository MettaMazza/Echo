import "../providers/json_string"

# Speech is a derived presentation. The original archived message stays intact.
# Markdown structure is silent; link labels and inline code remain readable.
define speech_plain_text with text as Str returning Str:
    set text_size to string_length(text)
    set text_pointer to str_to_ptr(text)
    set output to create_builder()
    set byte_buffer to create_list()
    set added to append_list(byte_buffer and 0)
    set position to 0
    set line_start to 1
    set fenced to 0
    repeat while position < text_size:
        if line_start equals 1:
            set scan to position
            set separators_only to 1
            set separator_seen to 0
            repeat while scan < text_size and speech_text_byte(text_pointer and text_size and scan) is not equal to 10:
                set mark to speech_text_byte(text_pointer and text_size and scan)
                if mark equals 45 or else mark equals 124 or else mark equals 42 or else mark equals 95 or else mark equals 61:
                    set separator_seen to 1
                else if mark is not equal to 32 and mark is not equal to 9 and mark is not equal to 58:
                    set separators_only to 0
                set scan to scan + 1
            if separators_only equals 1 and separator_seen equals 1:
                set position to scan
                set line_start to 0
                continue
        set character to speech_text_byte(text_pointer and text_size and position)
        if line_start equals 1 and (character equals 96 or else character equals 126) and speech_text_byte(text_pointer and text_size and position + 1) equals character and speech_text_byte(text_pointer and text_size and position + 2) equals character:
            set fenced to 1 - fenced
            repeat while position < text_size and speech_text_byte(text_pointer and text_size and position) is not equal to 10:
                set position to position + 1
            continue
        if character equals 10:
            set added to builder_append(output and "\n")
            set line_start to 1
            set position to position + 1
            continue
        if fenced equals 1:
            set position to position + 1
            continue
        if line_start equals 1:
            if character equals 32 or else character equals 9 or else character equals 35 or else character equals 62:
                set position to position + 1
                continue
            if (character equals 45 or else character equals 43 or else character equals 42) and (speech_text_byte(text_pointer and text_size and position + 1) equals 32 or else speech_text_byte(text_pointer and text_size and position + 1) equals character):
                set position to position + 1
                continue
        set line_start to 0
        if character equals 93 and speech_text_byte(text_pointer and text_size and position + 1) equals 40:
            set position to position + 2
            set depth to 1
            repeat while position < text_size and depth > 0:
                if speech_text_byte(text_pointer and text_size and position) equals 40:
                    set depth to depth + 1
                if speech_text_byte(text_pointer and text_size and position) equals 41:
                    set depth to depth - 1
                set position to position + 1
            continue
        if character equals 60:
            set end to position + 1
            repeat while end < text_size and speech_text_byte(text_pointer and text_size and end) is not equal to 62 and speech_text_byte(text_pointer and text_size and end) is not equal to 10:
                set end to end + 1
            if speech_text_byte(text_pointer and text_size and end) equals 62:
                set position to end + 1
                continue
        if character equals 42:
            set left to position - 1
            set right to position + 1
            repeat while left >= 0 and speech_text_byte(text_pointer and text_size and left) equals 32:
                set left to left - 1
            repeat while right < text_size and speech_text_byte(text_pointer and text_size and right) equals 32:
                set right to right + 1
            if speech_text_byte(text_pointer and text_size and left) >= 48 and speech_text_byte(text_pointer and text_size and left) <= 57 and speech_text_byte(text_pointer and text_size and right) >= 48 and speech_text_byte(text_pointer and text_size and right) <= 57:
                set added to builder_append(output and " times ")
        if character equals 42 or else character equals 95 or else character equals 96 or else character equals 126 or else character equals 91 or else character equals 93 or else character equals 92:
            set position to position + 1
            continue
        if character equals 124:
            set added to builder_append(output and ", ")
        else if character equals 33 and speech_text_byte(text_pointer and text_size and position + 1) equals 91:
            set position to position + 1
            continue
        else:
            set written to set_list(byte_buffer and 0 and character)
            set piece to ptr_to_str(get_list_data_ptr(byte_buffer))
            set added to builder_append(output and piece)
        set position to position + 1
    set result to ptr_to_str(builder_to_string(output))
    set result to string_replace(result and "&amp;" and " and ")
    set result to string_replace(result and "&lt;" and " less than ")
    set result to string_replace(result and "&gt;" and " greater than ")
    set result to string_replace(result and "&quot;" and "\"")
    set result to string_replace(result and "&#39;" and "'")
    set result to string_replace(result and "&nbsp;" and " ")
    return string_trim(result)

# Preserve get_character's zero sentinel for look-ahead and look-behind.

define speech_text_byte with pointer as Int and size as Int and position as Int returning Int:
    if position < 0 or else position >= size:
        return 0
    return peek_byte(pointer and position)
