# Bound each autoregressive utterance, never the complete response. Preserve
# every byte and avoid splitting a UTF-8 scalar even in an unbroken word.
define speech_chunk_end with text as Str and start as Int returning Int:
    set end to start + 240
    if end >= string_length(text):
        return string_length(text)
    repeat while end > start and get_character(text and end) >= 128 and get_character(text and end) < 192:
        set end to end - 1
    set index to start
    set word to 0
    set sentence to 0
    repeat while index < end:
        set character to get_character(text and index)
        if character equals 32 or else character equals 10 or else character equals 13 or else character equals 9:
            set word to index + 1
            if index > start:
                set previous to get_character(text and index - 1)
                if previous equals 46 or else previous equals 33 or else previous equals 63:
                    set sentence to index + 1
        set index to index + 1
    if sentence >= start + 80:
        return sentence
    if word > start:
        return word
    return end
