import "../workspace/output_archive"
import "../workspace/files"

external define ep_uuid_v4

# Called only after the helper is reaped. The original host-owned descriptor
# stays open; no pathname is reopened. Pages are transfer sizes, not quotas.
# Immutable process_output events travel with database snapshots and can be
# read through the existing session-scoped output cursor and history tools.
define image_log_archive with database as Int and run as Str and call_id as Str and library as Int and descriptor as Int and stream as Str returning Int:
    if descriptor is less than 0 or else workspace_regular_file(library and descriptor) equals 0:
        return 1
    set seek_function to ep_dlsym(library and "lseek")
    set read_function to ep_dlsym(library and "read")
    set allocate to ep_dlsym(library and "malloc")
    set page_function to ep_dlsym(library and "getpagesize")
    if seek_function equals 0 or else read_function equals 0 or else allocate equals 0 or else page_function equals 0:
        return 1
    if ep_dlcall3(seek_function and descriptor and 0 and 0) is not equal to 0:
        return 1
    set capacity to ep_dlcall0(page_function)
    if capacity is less than 1:
        return 1
    set buffer to ep_dlcall1(allocate and capacity)
    if buffer equals 0:
        return 1
    set result to 0
    repeat while result equals 0:
        set count to socket_signed_result(ep_dlcall3(read_function and descriptor and buffer and capacity))
        if count is less than 0:
            if socket_errno(library) equals 4:
                continue
            set result to 1
            break
        set ended to 0
        if count equals 0:
            set ended to 1
        set event to concat("image-output:" and ptr_to_str(ep_uuid_v4()))
        set result to workspace_output_record(database and run and call_id and event and stream and buffer and count and ended)
        if ended equals 1:
            break
    if socket_release_buffer(library and buffer) is not equal to 0:
        set result to 1
    return result
