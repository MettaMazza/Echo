import "lifecycle/controller_prepare"

define main returning Int:
    if get_argument_count() is not equal to 9:
        display "Usage: prepare_controller CONFIGURATION PROPOSAL OPERATION DIRECTORY TARGET_NAME STAGE_NAME RECOVERY_PATH AUDIT_REQUEST. Root host authentication required. Preparation does not apply a change."
        return 1
    set result to controller_prepare_host(get_argument(1) and get_argument(2) and get_argument(3) and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(7) and get_argument(8))
    display result
    if result equals "prepared" or else result equals "already-prepared":
        return 0
    return 1
