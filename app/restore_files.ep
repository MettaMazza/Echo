import "archive/attachment_restore"

define main returning Int:
    if get_argument_count() is not equal to 5:
        display "Supply backup database, backup attachment directory, new database destination and new private attachment directory."
        return 1
    if attachment_restore(get_argument(1) and get_argument(2) and get_argument(3) and get_argument(4)) is not equal to 0:
        display "Restore did not complete. Preserve the destination, reservation and any .restoring candidate for investigation; do not start it."
        return 1
    display "Restored database and attachment bytes verified. Automatic startup is held pending historical-action reconciliation."
    return 0
