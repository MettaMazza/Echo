import "archive/tree_snapshot"

define main returning Int:
    if get_argument_count() is not equal to 5 or else not (get_argument(1) equals "offline"):
        display "Stop every source writer first. Supply: offline, absolute source directory, new backup bundle, new internal restore directory."
        return 1
    if tree_snapshot(get_argument(2) and get_argument(3) and get_argument(4)) is not equal to 0:
        display "Tree backup or clean restore verification failed. Preserve candidate files and logs; do not treat this as a completed backup."
        return 1
    display "PASS: offline tree archived and restored into new storage; content hashes, types, modes and symlink targets match the source manifest."
    return 0
