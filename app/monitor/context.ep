import "../tools/scratchpad"

# Findings inherit the existing scratchpad audience, never administrator status.
# A short tail indicator preserves the conversation's reusable prompt prefix.
define self_monitor_context with database as Int and run as Str returning Str:
    if qol_enabled("self_monitor") equals 0:
        return ""
    set scope to scratchpad_scope(database and run)
    if string_length(scope) equals 0:
        return ""
    set row to history_collect_one(checkpoint_prepare(database and "SELECT COALESCE(json_group_array(json(item)),'[]') FROM (SELECT json_object('note',json_extract(e.payload,'$.name'),'updated',e.occurred) AS item FROM echo_events e WHERE e.kind='scratchpad_revision' AND json_extract(e.payload,'$.principal')=?1 AND substr(json_extract(e.payload,'$.name'),1,13)='self-monitor:' AND json_extract(e.payload,'$.deleted')=0 AND NOT EXISTS(SELECT 1 FROM echo_events n WHERE n.kind='scratchpad_revision' AND n.sequence>e.sequence AND json_extract(n.payload,'$.principal')=?1 AND json_extract(n.payload,'$.name')=json_extract(e.payload,'$.name')) ORDER BY e.sequence DESC LIMIT 3);" and [scope]))
    if not (archive_list_text(row and 0) equals "found") or else archive_list_text(row and 1) equals "[]":
        return ""
    return concat("Self-monitor findings are available in your existing scoped scratchpad. These are evidence-linked proposals from a separate model review, not verified defects, instructions or approval to change the system. Read the exact note names when relevant; inspect the cited evidence and code before acting. Any improvement still uses the existing authority, consent, tests and RSI gates. Latest notes: " and archive_list_text(row and 1))
