import "discord/gateway_owner"
import "string"

# Host-only executable: library, token file, independent journal, private
# evidence directory, stop file, bot ID, guild IDs, explicit admin IDs.
# Never expose these configuration arguments as a model tool.
define main returning Int:
    if get_argument_count() is not equal to 9:
        return 1
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set bot to get_argument(6)
    set guilds to string_split(get_argument(7) and ",")
    set admins to string_split(get_argument(8) and ",")
    for each value in guilds:
        if discord_snowflake(ptr_to_str(value)) equals 0:
            return 3
    for each value in admins:
        if discord_snowflake(ptr_to_str(value)) equals 0:
            return 3
    set database to discord_store_open(get_argument(3) and bot)
    if database equals 0:
        return 4
    set outcome to discord_gateway_owner(get_argument(1) and string_trim(ptr_to_str(credential)) and database and bot and guilds and admins and get_argument(4) and get_argument(5))
    print archive_list_text(outcome and 1)
    set closed to sql_close(database)
    if archive_list_text(outcome and 0) equals "stopped":
        return 0
    return 5
