import "archive/backup_bundle"

define main returning Int:
    if get_argument_count() is not equal to 2:
        display "Supply a host offline backup profile. Stop Echo and other writers first."
        return 1
    set result to backup_bundle_run(ptr_to_str(read_file(get_argument(1))))
    if result equals 0:
        display "PASS: combined offline backup and clean database/attachment/tree restores verified; final manifest published."
    else:
        display "Backup did not complete; no candidate should be accepted without its final manifest."
    return result
