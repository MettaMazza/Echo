import "../agent/generation"
import "../agent/run_messages"
import "../tools/protected_tools"

# This worker advertises only inspection and review. The supplied messages are
# retained verbatim; identity, philosophy and provider capacities are unchanged.
define controller_review_request_body with model as Str and messages as Str returning Str:
    set body to concat("{\"model\":" and provider_quote(model))
    set body to concat(body and ",\"stream\":true,\"messages\":")
    set body to concat(body and messages)
    set body to concat(body and ",\"tools\":")
    set schemas to protected_tool_schemas()
    set body to concat(body and schemas)
    return concat(body and "}")

# A separate dispatcher is intentional: a privileged review worker must not
# link model-selected names to the general runtime tool dispatcher. Its only
# effects are proposal inspection, review receipts and normal tool observations.
define controller_review_tool_step with database as Int and run as Str returning Int:
    set row to agent_run_read(database and run)
    if row equals 0:
        return 1
    if not (archive_list_text(row and 2) equals "tools"):
        return 1
    set session to archive_list_text(row and 0)
    set parent to archive_list_text(row and 3)
    set values to create_list()
    set added to append_list(values and run)
    # Do not advance another queued action past an unresolved earlier effect.
    set unresolved to checkpoint_prepare(database and "SELECT call_id FROM echo_tool_calls WHERE run=? AND state IN ('running','uncertain') LIMIT 1;" and values)
    if unresolved equals 0:
        return 1
    set unresolved_step to ep_sqlite3_step(unresolved)
    set unresolved_closed to ep_sqlite3_finalize(unresolved)
    if unresolved_step is not equal to 101 or else unresolved_closed is not equal to 0:
        return 1
    set statement to checkpoint_prepare(database and "SELECT t.call_id,t.request_event FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run=? AND t.state='queued' ORDER BY e.sequence LIMIT 1;" and values)
    if statement equals 0:
        return 1
    set step to ep_sqlite3_step(statement)
    if step equals 101:
        set closed to ep_sqlite3_finalize(statement)
        if closed is not equal to 0:
            return 1
        set statement to checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls WHERE run=? AND state<>'observed';" and values)
        if statement equals 0:
            return 1
        if ep_sqlite3_step(statement) is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return 1
        set remaining to ptr_to_str(ep_sqlite3_column_text(statement and 0))
        if archive_finish(statement and 101) is not equal to 0 or else not (remaining equals "0"):
            return 1
        set event to concat(parent and ":observed")
        set payload to concat(agent_event_envelope(run and parent) and "}")
        if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
            return 1
        if archive_append_pending(database and session and event and "agent_observation" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0 or else agent_run_transition(database and run and "tools" and parent and "ready" and event) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
            return archive_rollback(database)
        return 0
    if step is not equal to 100:
        set closed to ep_sqlite3_finalize(statement)
        return 1
    set call_id to ptr_to_str(ep_sqlite3_column_text(statement and 0))
    set request_event to ptr_to_str(ep_sqlite3_column_text(statement and 1))
    if archive_finish(statement and 101) is not equal to 0:
        return 1
    set original to archive_read_event(database and request_event)
    if original equals 0:
        return 1
    set tokens to provider_json_tokens(archive_list_text(original and 3))
    if tokens equals 0:
        return 1
    set name_field to provider_member(tokens and 0 and "name")
    set arguments_field to provider_member(tokens and 0 and "arguments")
    if not (provider_kind(tokens and name_field) equals "string") or else not (provider_kind(tokens and arguments_field) equals "string"):
        return 1
    if agent_run_claim_tool(database and run and call_id) is not equal to 0:
        return 1
    return controller_review_finish_call(database and run and call_id and request_event)

# Both allowed tools are ledger-idempotent: inspection is read-only and review
# reuses its immutable (run, call_id) receipt. Never replay general runtime tools.
define controller_review_finish_call with database as Int and run as Str and call_id as Str and request_event as Str returning Int:
    set row to agent_run_read(database and run)
    if row equals 0 or else not (archive_list_text(row and 2) equals "tools"):
        return 1
    set session to archive_list_text(row and 0)
    set parent to archive_list_text(row and 3)
    set call to tool_ledger_read(database and run and call_id)
    if call equals 0 or else not (archive_list_text(call and 1) equals "running") or else not (archive_list_text(call and 2) equals session) or else not (archive_list_text(call and 3) equals request_event):
        return 1
    set original to archive_read_event(database and request_event)
    if original equals 0:
        return 1
    set tokens to provider_json_tokens(archive_list_text(original and 3))
    set name_field to provider_member(tokens and 0 and "name")
    if tokens equals 0 or else not (provider_kind(tokens and name_field) equals "string"):
        return 1
    set name to provider_value(tokens and name_field)
    set observation to "{\"status\":\"tool-unavailable\",\"effects\":\"none\",\"cause\":\"protected-review-only\"}"
    if name equals "protected_change_inspect" or else name equals "protected_change_review":
        set observation to protected_tool_execute(database and run and call_id and name)
    if string_length(observation) equals 0:
        return 1
    set payload to agent_event_envelope(run and parent)
    set payload to concat(payload and concat(",\"call_id\":" and provider_quote(call_id)))
    set payload to concat(payload and concat(",\"request_event\":" and provider_quote(request_event)))
    set payload to concat(payload and concat(",\"result\":" and concat(observation and "}")))
    set event to concat(request_event and ":result")
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if archive_append_pending(database and session and event and "tool_result" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0 or else tool_ledger_observe(database and run and call_id and event) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    return 0

# Recover only inspection/review calls, including the receipt-before-result
# crash window. Do not claim an already recorded decision never happened.
define controller_review_recover_call with database as Int and run as Str and call_id as Str returning Int:
    set row to agent_run_read(database and run)
    set call to tool_ledger_read(database and run and call_id)
    if row equals 0 or else call equals 0:
        return 1
    set session to archive_list_text(row and 0)
    set request to archive_list_text(call and 3)
    if not (archive_list_text(call and 2) equals session) or else archive_verify(database and session) is not equal to 0:
        return 1
    set original to archive_read_event(database and request)
    if original equals 0:
        return 1
    set tokens to provider_json_tokens(archive_list_text(original and 3))
    set name to provider_value(tokens and provider_member(tokens and 0 and "name"))
    if not (name equals "protected_change_inspect" or else name equals "protected_change_review"):
        return 1
    set event to concat(request and ":result")
    set values to create_list()
    set added to append_list(values and event)
    set added to append_list(values and session)
    set added to append_list(values and run)
    set added to append_list(values and call_id)
    set added to append_list(values and request)
    set saved to history_collect_one(checkpoint_prepare(database and "SELECT event FROM echo_events WHERE event=?1 AND session=?2 AND kind='tool_result' AND json_extract(payload,'$.run_id')=?3 AND json_extract(payload,'$.call_id')=?4 AND json_extract(payload,'$.request_event')=?5;" and values))
    if archive_list_text(saved and 0) equals "found":
        if archive_list_text(call and 1) equals "observed":
            if archive_list_text(call and 4) equals event:
                return 0
            return 1
        if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
            return 1
        if tool_ledger_observe(database and run and call_id and event) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
            return archive_rollback(database)
        return 0
    if not (archive_list_text(saved and 0) equals "end") or else not (archive_list_text(call and 1) equals "running"):
        return 1
    return controller_review_finish_call(database and run and call_id and request)
