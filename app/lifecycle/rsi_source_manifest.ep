import "rsi_source"

# Publish the exact next source baseline only after checking every staged byte.
# Candidate compilation cannot silently rewrite an imported application file.
define rsi_source_manifest with baseline as Str and request as Str and stage_root as Str returning Str:
    if rsi_request_valid(request) equals 0:
        return ""
    set original to provider_json_tokens(baseline)
    set candidate to provider_json_tokens(request)
    if original equals 0 or else provider_unique_objects(original) equals 0:
        return ""
    set files to provider_items(original and provider_member(original and 0 and "files"))
    set changes to provider_items(candidate and provider_member(candidate and 0 and "changes"))
    if files equals 0 or else length_list(files) equals 0:
        return ""
    set result to "{\"files\":["
    set paths to create_list()
    set count to 0
    for each entry in files:
        set path to provider_value(original and provider_member(original and entry and "path"))
        set expected to provider_value(original and provider_member(original and entry and "sha256"))
        for each change in changes:
            if provider_value(candidate and provider_member(candidate and change and "path")) equals path:
                set expected to ep_sha256(provider_value(candidate and provider_member(candidate and change and "source")))
        set encoded to rsi_source_manifest_entry(stage_root and path and expected)
        if string_length(encoded) equals 0:
            return ""
        for each prior in paths:
            if ptr_to_str(prior) equals path:
                return ""
        set added to append_list(paths and path)
        if count > 0:
            set result to concat(result and ",")
        set result to concat(result and encoded)
        set count to count + 1
    for each change in changes:
        set path to provider_value(candidate and provider_member(candidate and change and "path"))
        set found to 0
        for each prior in paths:
            if ptr_to_str(prior) equals path:
                set found to 1
        if found equals 0:
            set expected to ep_sha256(provider_value(candidate and provider_member(candidate and change and "source")))
            set encoded to rsi_source_manifest_entry(stage_root and path and expected)
            if string_length(encoded) equals 0:
                return ""
            set result to concat(result and ",")
            set result to concat(result and encoded)
    return concat(result and "]}")

define rsi_source_manifest_entry with root as Str and path as Str and expected as Str returning Str:
    if workspace_path_parts(path) equals 0 or else string_length(path) < 8 or else not (substring(path and 0 and 4) equals "app/") or else not (substring(path and string_length(path) - 3 and 3) equals ".ep"):
        return ""
    set full_path to concat(root and "/")
    set full_path to concat(full_path and path)
    set observed to file_digest_durable(full_path and 65536)
    if not (archive_list_text(observed and 0) equals "verified") or else not (archive_list_text(observed and 1) equals expected):
        return ""
    set encoded_path to provider_quote(path)
    set encoded_digest to provider_quote(expected)
    set result to concat("{\"path\":" and encoded_path)
    set result to concat(result and ",\"sha256\":")
    set result to concat(result and encoded_digest)
    return concat(result and "}")
