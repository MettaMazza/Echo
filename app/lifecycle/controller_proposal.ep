import "controller_requests"
import "../rights/inventory"
import "../web/run_store"

define controller_proposal_submit with database as Int and charter as Str and inventory as Str and inventory_digest as Str and credential as Str and identity as Str and manifest as Str returning Str:
    set actor to protected_steward_actor(database and credential)
    if not (archive_list_text(actor and 0) equals "found"):
        return "controller-caller-not-authorized"
    if string_length(identity) equals 0 or else protected_inventory_matches(charter and inventory and inventory_digest and manifest) equals 0:
        return "invalid-proposal"
    set device to archive_list_text(actor and 1)
    set run to concat("controller-review:" and identity)
    set digest to ep_sha256(manifest)
    set objective to concat("Review protected proposal " and identity)
    set objective to concat(objective and ". Exact manifest digest: ")
    set objective to concat(objective and digest)
    set objective to concat(objective and ". Inspect the full proposal and record your own review using the protected review tools. This request grants no deployment approval.")
    # Existing idempotent submission binds device, objective and run identity.
    # A worker may select only runs with a successfully stored proposal. If the
    # second transaction fails, the same request safely resumes proposal storage.
    set submitted to web_submit_owned(database and device and run and "" and objective)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return archive_list_text(submitted and 0)
    set stored to protected_proposal_store(database and charter and run and identity and manifest)
    if not (stored equals "recorded" or else stored equals "already-recorded"):
        return concat("proposal-pending:" and stored)
    return "accepted"

define controller_proposal_dispatch with database as Int and charter as Str and inventory as Str and digest as Str and tokens as List and credential as Str returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "invalid-operation-request"
    set index to 1
    set count to 0
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "proposal" or else key equals "manifest") or else not (provider_kind(tokens and index + 2) equals "string"):
            return "invalid-operation-request"
        set count to count + 1
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    if count is not equal to 2:
        return "invalid-operation-request"
    set identity to provider_value(tokens and provider_member(tokens and 0 and "proposal"))
    set manifest to provider_value(tokens and provider_member(tokens and 0 and "manifest"))
    return controller_proposal_submit(database and charter and inventory and digest and credential and identity and manifest)
