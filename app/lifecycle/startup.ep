import "migrations"
import "fs"

# Inspect before archive_open can create or update any application schema.
# Deployment must stop old processes before migrations; this is not a live
# migration lock or permission to run mixed application versions.
# Distinguish a transient database lock from a proven schema incompatibility.
# -1 never permits writes; it tells the process supervisor this is retryable.
define startup_archive_status with path as Str and supported as Int returning Int:
    if supported < 0 or else string_length(path) equals 0:
        return 0
    if not file_exists(path):
        return 1
    set database to sql_open(path)
    if database equals 0:
        return 0
    # Match normal archive access: a short writer lock is not a schema change.
    if sql_execute(database and "PRAGMA busy_timeout=5000;") is not equal to 0:
        set closed to sql_close(database)
        return 0
    set compatible to migration_compatible(database and supported)
    set code to sqlite3_extended_errcode(database)
    set primary_code to code modulo 256
    if primary_code equals 5 or else primary_code equals 6:
        display concat("Startup archive is busy; SQLite code " and int_to_string(code))
        set closed to sql_close(database)
        return -1
    if sql_close(database) is not equal to 0:
        return 0
    return compatible

# Existing boolean callers remain fail-closed for both busy and incompatible.
define startup_archive_compatible with path as Str and supported as Int returning Int:
    return startup_archive_status(path and supported) equals 1
