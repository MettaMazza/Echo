import "migrations"
import "fs"

# Inspect before archive_open can create or update any application schema.
# Deployment must stop old processes before migrations; this is not a live
# migration lock or permission to run mixed application versions.
define startup_archive_compatible with path as Str and supported as Int returning Int:
    if supported < 0 or else string_length(path) equals 0:
        return 0
    if not file_exists(path):
        return 1
    set database to sql_open(path)
    if database equals 0:
        return 0
    # Match normal archive access: a short writer lock is not a schema change.
    if sql_execute(database and "PRAGMA busy_timeout=5000;") is not equal to 0:
        set closed to sql_close(database)
        return 0
    set compatible to migration_compatible(database and supported)
    if sql_close(database) is not equal to 0:
        return 0
    return compatible
