import "controller_prepare"
import "qualification_runner"
import "controller_activation"

# A single independently owned maintenance transaction. The caller supplies
# candidate locations, never acceptance commands, fabricated reports or approval.
# The configured qualification replaces routine human stewardship; Echo's exact
# review/consent, inventory, preimage, recovery and Observer gates remain active.
define controller_autonomous_host with configuration as Str and proposal as Str and identity as Str and directory as Str and target as Str and stage as Str and recovery as Str and audit_request as Str and workspace as Str and runtime as Str and output_directory as Str returning Str:
    set loaded to controller_configuration_load(configuration)
    if not (archive_list_text(loaded and 0) equals "ready"):
        return archive_list_text(loaded and 0)
    set content to archive_list_text(loaded and 1)
    set config to provider_json_tokens(content)
    set plan_path to provider_value(config and provider_member(config and 0 and "qualification_plan"))
    set plan_pin to provider_value(config and provider_member(config and 0 and "qualification_plan_sha256"))
    set health_path to provider_value(config and provider_member(config and 0 and "health_plan"))
    set health_pin to provider_value(config and provider_member(config and 0 and "health_plan_sha256"))
    if string_length(plan_path) equals 0 or else string_length(health_path) equals 0:
        return "autonomous-qualification-not-configured"
    set database to controller_ledger_open(archive_list_text(loaded and 6) and archive_list_text(loaded and 7))
    if database equals 0:
        return "controller-ledger-unavailable"
    if controller_service_ready(database and ep_sha256(content)) equals 0:
        set closed to sql_close(database)
        return "controller-bootstrap-incomplete-or-changed"
    set result to controller_autonomous_run(database and loaded and proposal and identity and directory and target and stage and recovery and audit_request and workspace and runtime and output_directory)
    set closed to sql_close(database)
    return result

define controller_autonomous_run with database as Int and loaded as List and proposal as Str and identity as Str and directory as Str and target as Str and stage as Str and recovery as Str and audit_request as Str and workspace as Str and runtime as Str and output_directory as Str returning Str:
    set activation_policy to controller_activation_policy(archive_list_text(loaded and 1))
    if activation_policy equals "invalid":
        return "activation-policy-invalid"
    set config to provider_json_tokens(archive_list_text(loaded and 1))
    set plan_path to provider_value(config and provider_member(config and 0 and "qualification_plan"))
    set plan_pin to provider_value(config and provider_member(config and 0 and "qualification_plan_sha256"))
    set health_path to provider_value(config and provider_member(config and 0 and "health_plan"))
    set health_pin to provider_value(config and provider_member(config and 0 and "health_plan_sha256"))
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set output_root to workspace_root_open(library and output_directory)
    if output_root < 0:
        set closed to ep_dlclose(library)
        return "output-root-unavailable"
    set attempt to ptr_to_str(ep_uuid_v4())
    for each part in ["baseline","qualification","health","recovery-health"]:
        set path to concat(attempt and concat("/" and ptr_to_str(part)))
        set created to workspace_directory_open(library and output_root and path and 1)
        if created < 0:
            set closed to net_close(output_root)
            set closed to ep_dlclose(library)
            return "attempt-directory-unavailable"
        set closed to net_close(created)
    set closed to net_close(output_root)
    set closed to ep_dlclose(library)
    set output_directory to concat(output_directory and concat("/" and attempt))
    set values to create_list()
    set added to append_list(values and proposal)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_protected_proposals WHERE identity=?;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "controller-proposal-unavailable"
    set run to archive_list_text(row and 1)
    set original to protected_proposal_read(database and run and proposal)
    set manifest to provider_json_tokens(archive_list_text(original and 1))
    set candidate_digest to provider_value(manifest and provider_member(manifest and 0 and "proposed_sha256"))
    set before_digest to provider_value(manifest and provider_member(manifest and 0 and "before_sha256"))
    set target_path to concat(directory and concat("/" and target))
    set operation to protected_operation_read(database and identity)
    set state to archive_list_text(operation and 0)
    if not (state equals "operation-missing"):
        set saved_operation to provider_json_tokens(archive_list_text(operation and 1))
        if saved_operation equals 0 or else not (provider_value(saved_operation and provider_member(saved_operation and 0 and "proposal")) equals proposal) or else not (provider_value(saved_operation and provider_member(saved_operation and 0 and "directory")) equals directory) or else not (provider_value(saved_operation and provider_member(saved_operation and 0 and "target")) equals target):
            return "operation-request-conflict"
    if state equals "applying" or else state equals "uncertain" or else state equals "applied" or else state equals "not-applied":
        set state to protected_operation_reconcile(database and identity)
    if state equals "rolling-back" or else state equals "rollback-uncertain" or else state equals "rolled-back":
        set state to protected_rollback_reconcile(database and archive_list_text(loaded and 2) and identity)
    if state equals "rollback-not-applied":
        set state to protected_operation_rollback(database and archive_list_text(loaded and 2) and identity)
    if state equals "rolled-back" or else state equals "not-applied":
        set resume_status to controller_activation_resume(activation_policy)
        if not (resume_status equals "restarted"):
            return resume_status
        set health to file_read(health_path)
        set recovered to qualification_execute(health and health_pin and target_path and before_digest and workspace and runtime and concat(output_directory and "/recovery-health"))
        if qualification_results_valid(health and health_pin and recovered and before_digest) equals 0:
            return "rolled-back-recovery-health-failed"
        if controller_activation_health(activation_policy) equals 0:
            return "rolled-back-service-health-failed"
        if controller_activation_marker(activation_policy and 0) is not equal to 0:
            return "maintenance-release-failed"
        if state equals "not-applied":
            return "not-applied-and-verified"
        return "rolled-back-and-verified"
    if not (state equals "operation-missing" or else state equals "prepared" or else state equals "applied"):
        return concat("operation-state:" and state)
    set health to file_read(health_path)
    if not (state equals "applied"):
        set baseline to qualification_execute(health and health_pin and target_path and before_digest and workspace and runtime and concat(output_directory and "/baseline"))
        if qualification_results_valid(health and health_pin and baseline and before_digest) equals 0:
            return "baseline-health-failed"
    if state equals "operation-missing":
        set stage_path to concat(directory and concat("/" and stage))
        set plan to file_read(plan_path)
        set report to qualification_execute(plan and plan_pin and stage_path and candidate_digest and workspace and runtime and concat(output_directory and "/qualification"))
        if string_length(report) equals 0:
            return "qualification-execution-failed"
        set saved to protected_qualification_record(database and run and proposal and plan and plan_pin and report)
        if not (saved equals "qualified"):
            return saved
        set prepared to controller_prepare_record(database and archive_list_text(loaded and 2) and archive_list_text(loaded and 3) and archive_list_text(loaded and 4) and archive_list_text(loaded and 5) and proposal and identity and directory and target and stage and recovery and audit_request)
        if not (prepared equals "prepared" or else prepared equals "already-prepared"):
            return prepared
    if controller_activation_marker(activation_policy and 1) is not equal to 0:
        return "maintenance-acquire-failed"
    set activation_locks to controller_activation_lock(activation_policy)
    if activation_locks equals 0:
        return "awaiting-idle"
    if not (state equals "applied"):
        if controller_activation_authority(loaded) equals 0:
            set released to controller_activation_unlock(activation_locks)
            set reopened to controller_activation_marker(activation_policy and 0)
            return "source-authority-revoked"
        set applied to protected_operation_apply(database and archive_list_text(loaded and 2) and identity and archive_list_text(loaded and 3) and archive_list_text(loaded and 4) and archive_list_text(loaded and 5))
        if not (applied equals "applied"):
            set released to controller_activation_unlock(activation_locks)
            return applied
    set restarted to controller_activation_restart(activation_policy)
    set released to controller_activation_unlock(activation_locks)
    set target_path to concat(directory and concat("/" and target))
    set health to file_read(health_path)
    set observed to qualification_execute(health and health_pin and target_path and candidate_digest and workspace and runtime and concat(output_directory and "/health"))
    set healthy to qualification_results_valid(health and health_pin and observed and candidate_digest)
    if restarted is not equal to 0 or else controller_activation_health(activation_policy) equals 0:
        set healthy to 0
    set result to "activated-and-verified"
    if healthy equals 0:
        set reverted to protected_operation_rollback(database and archive_list_text(loaded and 2) and identity)
        set result to concat("health-failed:" and reverted)
        if reverted equals "rolled-back":
            set restored_services to controller_activation_resume(activation_policy)
            if not (restored_services equals "restarted"):
                return concat("rolled-back:" and restored_services)
            set recovered to qualification_execute(health and health_pin and target_path and before_digest and workspace and runtime and concat(output_directory and "/recovery-health"))
            if qualification_results_valid(health and health_pin and recovered and before_digest) equals 0 or else controller_activation_health(activation_policy) equals 0:
                set result to "rolled-back-recovery-health-failed"
            else:
                set result to "health-failed-rolled-back-and-verified"
    if result equals "activated-and-verified" or else result equals "health-failed-rolled-back-and-verified":
        if controller_activation_marker(activation_policy and 0) is not equal to 0:
            return "maintenance-release-failed"
    set health_session to concat("autonomous-health:" and ep_sha256(identity))
    set event to concat(health_session and concat(":" and attempt))
    set payload to concat("{\"status\":" and provider_quote(result))
    set payload to concat(payload and concat(",\"report\":" and concat(provider_quote(observed) and "}")))
    if archive_append(database and health_session and event and "autonomous_health_result" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        set result to concat("health-receipt-failed:" and result)
    return result

# Used for startup reconciliation and restoration; maintenance stays held on
# any failure, preventing new requests from entering an unverified release.
define controller_activation_resume with policy as Str returning Str:
    if controller_activation_marker(policy and 1) is not equal to 0:
        return "maintenance-acquire-failed"
    set connections to controller_activation_lock(policy)
    if connections equals 0:
        return "awaiting-idle"
    set restarted to controller_activation_restart(policy)
    set released to controller_activation_unlock(connections)
    if restarted is not equal to 0 or else released is not equal to 0:
        return "service-restart-failed"
    return "restarted"
