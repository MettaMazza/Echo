import "../rights/emergency_report"
import "controller_console"
import "controller_review"
import "controller_proposal"
import "controller_process"
import "../web/http_api"
import "../transport/http_body"
import "../transport/socket_write"

# Only operation selectors cross this boundary. Trusted service inputs and
# controller credentials are never accepted inside the JSON request body.
define controller_http_dispatch with database as Int and charter as Str and inventory as Str and digest as Str and policy as Str and tokens as List and credential as Str returning Str:
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return "invalid-operation-request"
    set index to 1
    set count to 0
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "action" or else key equals "operation") or else not (provider_kind(tokens and index + 2) equals "string"):
            return "invalid-operation-request"
        set count to count + 1
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    if count is not equal to 2:
        return "invalid-operation-request"
    set action to provider_value(tokens and provider_member(tokens and 0 and "action"))
    set identity to provider_value(tokens and provider_member(tokens and 0 and "operation"))
    return controller_authenticated_operation(database and charter and inventory and digest and policy and action and identity and credential)

define controller_http_reply with library as Int and descriptor as Int and code as Str and status as Str returning Int:
    set quoted to provider_quote(status)
    set body to concat("{\"status\":" and quoted)
    set body to concat(body and "}")
    return controller_http_json_reply(library and descriptor and code and body)

define controller_http_json_reply with library as Int and descriptor as Int and code as Str and body as Str returning Int:
    set head to concat("HTTP/1.1 " and code)
    set head to concat(head and "\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\nContent-Length: ")
    set size to int_to_string(string_length(body))
    set head to concat(head and size)
    set head to concat(head and "\r\n\r\n")
    set sent to socket_write_all(library and descriptor and -1 and str_to_ptr(head) and string_length(head))
    if not (archive_list_text(sent and 0) equals "sent"):
        return 1
    set sent to socket_write_all(library and descriptor and -1 and str_to_ptr(body) and string_length(body))
    if not (archive_list_text(sent and 0) equals "sent"):
        return 1
    return 0

# No bootstrap, enrollment, public gateway or browser cookie authority. The
# service must supply an independently opened private controller ledger.
define controller_http_connection with library as Int and descriptor as Int and port as Int and database as Int and charter as Str and inventory as Str and digest as Str and policy as Str and configuration as Str and configuration_pin as Str returning Int:
    set reader to http_stream_create(library and descriptor and -1)
    set request to http_stream_head(reader)
    set code to "400 Bad Request"
    set status to "invalid-operation-request"
    set response_body to ""
    if archive_list_text(request and 0) equals "ready" and web_origin_allowed(request and port and 0 and "") equals 1:
        if archive_list_text(request and 1) equals "GET" and archive_list_text(request and 2) equals "/":
            set released to http_stream_release(reader)
            return controller_console_reply(library and descriptor and "text/html" and controller_console_html())
        if archive_list_text(request and 1) equals "GET" and archive_list_text(request and 2) equals "/console.js":
            set script to controller_console_script(configuration)
            set released to http_stream_release(reader)
            if string_length(script) equals 0:
                return controller_http_reply(library and descriptor and "503 Service Unavailable" and "controller-console-not-configured")
            return controller_console_reply(library and descriptor and "text/javascript" and script)
        if archive_list_text(request and 1) equals "POST" and (archive_list_text(request and 2) equals "/operation" or else archive_list_text(request and 2) equals "/review" or else archive_list_text(request and 2) equals "/proposal" or else archive_list_text(request and 2) equals "/emergencies"):
            set supplied to web_header(get_list(request and 5) and "x-echo-token")
            set code to "403 Forbidden"
            set status to "controller-caller-not-authorized"
            if archive_list_text(supplied and 0) equals "found":
                set credential to archive_list_text(supplied and 1)
                set actor to protected_steward_actor(database and credential)
                if archive_list_text(actor and 0) equals "found":
                    set received to web_read_json(reader and request and 65536)
                    set code to "400 Bad Request"
                    set status to "invalid-operation-request"
                    if archive_list_text(received and 0) equals "ready":
                        if archive_list_text(request and 2) equals "/proposal":
                            set status to controller_proposal_dispatch(database and charter and inventory and digest and get_list(received and 2) and credential)
                            if status equals "accepted" and string_length(configuration) > 0:
                                set submitted_tokens to get_list(received and 2)
                                set identity to provider_value(submitted_tokens and provider_member(submitted_tokens and 0 and "proposal"))
                                set review_run to concat("controller-review:" and identity)
                                if controller_review_start(configuration and review_run and configuration_pin) < 0:
                                    set status to "accepted-review-launch-failed"
                        else if archive_list_text(request and 2) equals "/emergencies":
                            set emergency_tokens to get_list(received and 2)
                            if provider_kind(emergency_tokens and 0) equals "{" and provider_kind(emergency_tokens and 1) equals "}":
                                set report to protected_emergency_report(database and charter and credential)
                                set report_tokens to provider_json_tokens(report)
                                if report_tokens is not equal to 0:
                                    set response_body to report
                                    set status to provider_value(report_tokens and provider_member(report_tokens and 0 and "status"))
                                else:
                                    set status to report
                                    if status equals "not-authorized":
                                        set status to "controller-caller-not-authorized"
                        else if archive_list_text(request and 2) equals "/review":
                            set response_body to controller_review_dispatch(database and get_list(received and 2) and credential)
                            set response_tokens to provider_json_tokens(response_body)
                            set status to provider_value(response_tokens and provider_member(response_tokens and 0 and "status"))
                        else:
                            set status to controller_http_dispatch(database and charter and inventory and digest and policy and get_list(received and 2) and credential)
                            set operation_tokens to get_list(received and 2)
                            if provider_value(operation_tokens and provider_member(operation_tokens and 0 and "action")) equals "inspect" and not (status equals "invalid-operation-request" or else status equals "controller-caller-not-authorized"):
                                set operation_identity to provider_value(operation_tokens and provider_member(operation_tokens and 0 and "operation"))
                                set response_body to controller_operation_disclosure(database and credential and operation_identity)
                                set response_tokens to provider_json_tokens(response_body)
                                set status to provider_value(response_tokens and provider_member(response_tokens and 0 and "status"))
                        set code to "200 OK"
                        if status equals "controller-caller-not-authorized":
                            set code to "403 Forbidden"
                        else if status equals "invalid-operation-request":
                            set code to "400 Bad Request"
    set released to http_stream_release(reader)
    if string_length(response_body) > 0:
        return controller_http_json_reply(library and descriptor and code and response_body)
    return controller_http_reply(library and descriptor and code and status)
