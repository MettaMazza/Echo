import "controller_operations"
import "../transport/socket_write"

define controller_console_html returning Str:
    return "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Echo | Protected changes</title><style>body{margin:0;background:#101215;color:#edf3ef;font:16px system-ui}main{max-width:850px;margin:auto;padding:36px 22px}h1{font-size:32px}p{line-height:1.6;color:#bcc8c0}section{background:#191e23;padding:24px;border:1px solid #303a35;border-radius:18px;margin:24px 0}label{display:block;margin:16px 0 8px}input,textarea{box-sizing:border-box;width:100%;padding:12px;border:1px solid #52655a;border-radius:9px;background:#101715;color:#fff;font:inherit}button{padding:12px 18px;margin:12px 8px 0 0;border:1px solid #52655a;border-radius:10px;background:#b8efd2;color:#10251a;font:inherit;cursor:pointer}button:disabled{opacity:.4;cursor:default}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;line-height:1.5}#status{min-height:3em}</style><main><h1>Protected changes</h1><p>Review Echo's exact proposal and recorded decision, then record your own. This console is separate from chat and available only on this Mac.</p><section><label for=\"credential\">Controller credential</label><input id=\"credential\" type=\"password\" autocomplete=\"off\" spellcheck=\"false\"><p>Your credential stays in this page and is cleared when you leave. It is not your Echo pairing code.</p><label for=\"proposal\">Proposal ID</label><input id=\"proposal\" autocomplete=\"off\"><button id=\"inspect\" type=\"button\">Inspect proposal</button></section><p id=\"status\" role=\"status\" aria-live=\"polite\">Enter your enrolled controller credential and proposal ID.</p><section><h2>Emergency disclosures</h2><button id=\"emergency-refresh\" type=\"button\">Refresh status</button><p id=\"emergency-status\" role=\"status\" aria-live=\"polite\">Enter your controller credential to view your disclosure deadlines.</p><pre id=\"emergency-report\"></pre></section><section><h2>Exact proposal and Echo review</h2><pre id=\"disclosure\">No proposal inspected.</pre></section><section><h2>Operation evidence</h2><label for=\"operation\">Operation ID</label><input id=\"operation\" autocomplete=\"off\"><button id=\"operation-inspect\" type=\"button\">Read before and after records</button><p id=\"operation-status\" role=\"status\">Inspect a prepared operation to see its verified record.</p><pre id=\"operation-report\"></pre></section><section><label for=\"reason\">Your reason</label><textarea id=\"reason\" rows=\"3\"></textarea><button id=\"authorize\" disabled>Authorize</button><button id=\"withdraw\" disabled>Withdraw authorization</button><button id=\"reject\" disabled>Reject</button><p>Recording a decision does not apply a change. Every later application rechecks the manifest and current decisions.</p></section></main><script src=\"/console.js\"></script></html>"

# The installed script is independently pinned; no script path comes from HTTP.
define controller_console_script with configuration as Str returning Str:
    set loaded to controller_configuration_load(configuration)
    if not (archive_list_text(loaded and 0) equals "ready"):
        return ""
    set tokens to provider_json_tokens(archive_list_text(loaded and 1))
    set path to provider_value(tokens and provider_member(tokens and 0 and "console_script"))
    set pin to provider_value(tokens and provider_member(tokens and 0 and "console_script_sha256"))
    if string_length(path) equals 0 or else protected_digest_valid(pin) equals 0:
        return ""
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to protected_path_open(library and path and 0)
    if descriptor < 0:
        set closed to ep_dlclose(library)
        return ""
    set content to file_read(path)
    set closed to net_close(descriptor)
    set closed to ep_dlclose(library)
    if not (ep_sha256(content) equals pin):
        return ""
    return content

define controller_console_reply with library as Int and descriptor as Int and mime as Str and body as Str returning Int:
    set head to concat("HTTP/1.1 200 OK\r\nContent-Type: " and mime)
    set head to concat(head and "; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\nContent-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'\r\nConnection: close\r\nContent-Length: ")
    set head to concat(head and int_to_string(string_length(body)))
    set head to concat(head and "\r\n\r\n")
    set result to socket_write_all(library and descriptor and -1 and str_to_ptr(head) and string_length(head))
    if not (archive_list_text(result and 0) equals "sent"):
        return 1
    set result to socket_write_all(library and descriptor and -1 and str_to_ptr(body) and string_length(body))
    if not (archive_list_text(result and 0) equals "sent"):
        return 1
    return 0
