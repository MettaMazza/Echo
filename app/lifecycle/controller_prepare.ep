import "controller_service"

# Host preparation resolves the proposal's own run from the private ledger.
# It never manufactures a review, steward approval or Observer decision.
define controller_prepare_record with database as Int and charter as Str and inventory as Str and inventory_digest as Str and policy as Str and proposal as Str and identity as Str and directory as Str and target as Str and stage as Str and recovery as Str and audit_request as Str returning Str:
    set values to create_list()
    set added to append_list(values and proposal)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_protected_proposals WHERE identity=?;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return "controller-proposal-unavailable"
    set policy_digest to ""
    if string_length(policy) > 0:
        set policy_digest to ep_sha256(policy)
    return protected_operation_prepare(database and charter and archive_list_text(row and 1) and proposal and identity and inventory and inventory_digest and directory and target and stage and recovery and audit_request and policy and policy_digest)

# Root authentication precedes every read. Inputs come from the protected
# configuration; operation paths still pass exact manifest and byte checks.
define controller_prepare_host with configuration as Str and proposal as Str and identity as Str and directory as Str and target as Str and stage as Str and recovery as Str and audit_request as Str returning Str:
    set loaded to controller_configuration_load(configuration)
    if not (archive_list_text(loaded and 0) equals "ready"):
        return archive_list_text(loaded and 0)
    set content to archive_list_text(loaded and 1)
    set ledger_directory to archive_list_text(loaded and 6)
    set ledger_name to archive_list_text(loaded and 7)
    set suffix to concat("/" and ledger_name)
    if not file_exists(concat(ledger_directory and suffix)):
        return "controller-ledger-not-initialized"
    set database to controller_ledger_open(ledger_directory and ledger_name)
    if database equals 0:
        return "controller-ledger-unavailable"
    if controller_service_ready(database and ep_sha256(content)) equals 0:
        set closed to sql_close(database)
        return "controller-bootstrap-incomplete-or-changed"
    set result to controller_prepare_record(database and archive_list_text(loaded and 2) and archive_list_text(loaded and 3) and archive_list_text(loaded and 4) and archive_list_text(loaded and 5) and proposal and identity and directory and target and stage and recovery and audit_request)
    if sql_close(database) is not equal to 0:
        return concat("controller-close-failed-after:" and result)
    return result
