import "../rights/operation_rollback"

# The service supplies its already-open private ledger and pinned inputs. No
# request can choose a database, charter, inventory or policy, or initialize state.
define controller_authenticated_operation with database as Int and charter as Str and inventory as Str and inventory_digest as Str and policy as Str and action as Str and identity as Str and credential as Str returning Str:
    if string_length(credential) equals 0 or else string_length(identity) equals 0:
        return "controller-caller-not-authorized"
    if action equals "apply":
        return protected_operation_apply_as(database and charter and identity and inventory and inventory_digest and policy and credential)
    if action equals "reconcile":
        return protected_operation_reconcile_as(database and identity and credential)
    if action equals "rollback":
        return protected_operation_rollback_as(database and charter and identity and credential)
    if action equals "rollback-reconcile":
        return protected_rollback_reconcile_as(database and charter and identity and credential)
    if not (action equals "inspect"):
        return "invalid-operation-request"
    if sql_execute(database and "BEGIN;") is not equal to 0:
        return "controller-read-unavailable"
    set stamp to protected_operation_actor_stamp(database and identity and credential)
    if string_length(stamp) equals 0:
        return migration_fail(database and "controller-caller-not-authorized")
    set operation to protected_operation_read(database and identity)
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return migration_fail(database and "controller-read-failed")
    return archive_list_text(operation and 0)
