import "controller_ledger"
import "controller_operations"
import "../archive/file_stage"

# 256 bits from the operating system CSPRNG, encoded without truncation.
define controller_credential_random with library as Int returning Str:
    set random_function to ep_dlsym(library and "arc4random_buf")
    if random_function equals 0:
        return ""
    set buffer to [0,0,0,0]
    set pointer to get_list_data_ptr(buffer)
    set generated to ep_dlcall2(random_function and pointer and 32)
    set digits to "0123456789abcdef"
    set result to ""
    set index to 0
    repeat while index < 32:
        set value to peek_byte(pointer and index)
        set high to ptr_to_str(substring(digits and value / 16 and 1))
        set low to ptr_to_str(substring(digits and value % 16 and 1))
        set result to concat(result and high)
        set result to concat(result and low)
        set index to index + 1
    return result

# Exclusive creation preserves an earlier credential or interrupted file.
# Caller has already verified the directory; this helper grants no authority.
define controller_credential_write with library as Int and directory as Int and name as Str and secret as Str returning Str:
    set parts to workspace_path_parts(name)
    if parts equals 0 or else length_list(parts) is not equal to 1 or else protected_digest_valid(secret) equals 0:
        return "credential-input-invalid"
    set descriptor to native_open_at(library and directory and name and 16780034 and 384)
    if descriptor < 0:
        return "credential-exists-or-unavailable"
    set written to file_stage_write(library and descriptor and str_to_ptr(secret) and string_length(secret))
    set finished to file_stage_finish(library and descriptor)
    set flush to ep_dlsym(library and "fsync")
    if written is not equal to 0 or else finished is not equal to 0 or else flush equals 0 or else ep_dlcall1(flush and directory) is not equal to 0:
        return "credential-write-incomplete-file-preserved"
    return "credential-created"

define controller_credential_host with path as Str and name as Str returning Str:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set user_function to ep_dlsym(library and "geteuid")
    if user_function equals 0 or else ep_dlcall0(user_function) is not equal to 0:
        set closed to ep_dlclose(library)
        return "root-controller-required"
    set directory to protected_path_open(library and path and 1)
    if directory < 0:
        set closed to ep_dlclose(library)
        return "credential-directory-not-protected"
    if controller_private_inode(library and directory and 1) equals 0:
        set closed to net_close(directory)
        set closed to ep_dlclose(library)
        return "credential-directory-not-private"
    set secret to controller_credential_random(library)
    set result to controller_credential_write(library and directory and name and secret)
    set closed to net_close(directory)
    set unloaded to ep_dlclose(library)
    if closed is not equal to 0 or else unloaded is not equal to 0:
        return concat("credential-close-failed-after:" and result)
    return result
