import "../rights/proposals"

# The installed controller supplies the pinned plan. Candidate code and model
# requests cannot select commands, remove checks, or declare a passing result.
define qualification_plan_valid with content as Str and digest as Str returning Int:
    if protected_digest_valid(digest) equals 0 or else not (ep_sha256(content) equals digest):
        return 0
    set tokens to provider_json_tokens(content)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "version")) equals "1"):
        return 0
    set checks to provider_items(tokens and provider_member(tokens and 0 and "checks"))
    if checks equals 0 or else length_list(checks) equals 0:
        return 0
    set names to create_list()
    for each check in checks:
        set name to provider_value(tokens and provider_member(tokens and check and "name"))
        set executable to provider_value(tokens and provider_member(tokens and check and "executable"))
        set pin to provider_value(tokens and provider_member(tokens and check and "sha256"))
        set args to provider_items(tokens and provider_member(tokens and check and "arguments"))
        if string_length(name) equals 0 or else string_length(executable) < 2 or else get_character(executable and 0) is not equal to 47 or else protected_digest_valid(pin) equals 0 or else args equals 0:
            return 0
        for each prior in names:
            if ptr_to_str(prior) equals name:
                return 0
        set added to append_list(names and name)
        for each argument in args:
            if not (provider_kind(tokens and argument) equals "string"):
                return 0
    return 1

# Reconstruct the required result set, including order and executable digest.
# Missing, additional, duplicated, failed and substituted checks all fail closed.
define qualification_results_valid with plan as Str and plan_digest as Str and report as Str and candidate_digest as Str returning Int:
    if qualification_plan_valid(plan and plan_digest) equals 0 or else protected_digest_valid(candidate_digest) equals 0:
        return 0
    set configured to provider_json_tokens(plan)
    set tokens to provider_json_tokens(report)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 0
    if not (provider_value(tokens and provider_member(tokens and 0 and "plan_sha256")) equals plan_digest) or else not (provider_value(tokens and provider_member(tokens and 0 and "candidate_sha256")) equals candidate_digest):
        return 0
    set expected to provider_items(configured and provider_member(configured and 0 and "checks"))
    set actual to provider_items(tokens and provider_member(tokens and 0 and "checks"))
    if actual equals 0 or else length_list(actual) is not equal to length_list(expected):
        return 0
    set index to 0
    repeat while index < length_list(expected):
        set before to get_list(expected and index)
        set after to get_list(actual and index)
        for each key in ["name","sha256"]:
            if not (provider_value(configured and provider_member(configured and before and ptr_to_str(key))) equals provider_value(tokens and provider_member(tokens and after and ptr_to_str(key)))):
                return 0
        if not (provider_kind(tokens and provider_member(tokens and after and "wait_status")) equals "number") or else not (provider_value(tokens and provider_member(tokens and after and "wait_status")) equals "0"):
            return 0
        if protected_digest_valid(provider_value(tokens and provider_member(tokens and after and "output_sha256"))) equals 0:
            return 0
        set index to index + 1
    return 1
