import "qualification_plan"
import "../workspace/sandbox_process"
import "../workspace/native_process"
import "../workspace/sandbox_profile"
import "../archive/file_digest"

# Controller-only runner. No report supplied by the candidate/model is trusted.
# Each installed check receives the candidate path as its final argument and
# executes in a sandbox with no private host data or service/network access.
define qualification_execute with plan as Str and plan_digest as Str and candidate as Str and candidate_digest as Str and workspace as Str and runtime as Str and output_directory as Str returning Str:
    if qualification_plan_valid(plan and plan_digest) equals 0:
        return ""
    set prefix to concat(workspace and "/")
    if output_directory equals workspace or else (string_length(output_directory) >= string_length(prefix) and ptr_to_str(substring(output_directory and 0 and string_length(prefix))) equals prefix):
        return ""
    set original to file_digest_durable(candidate and 65536)
    if not (archive_list_text(original and 0) equals "verified") or else not (archive_list_text(original and 1) equals candidate_digest):
        return ""
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and workspace)
    if directory < 0:
        set closed to ep_dlclose(library)
        return ""
    set tokens to provider_json_tokens(plan)
    set checks to provider_items(tokens and provider_member(tokens and 0 and "checks"))
    set report to concat("{\"plan_sha256\":" and provider_quote(plan_digest))
    set report to concat(report and concat(",\"candidate_sha256\":" and provider_quote(candidate_digest)))
    set report to concat(report and ",\"checks\":[")
    set index to 0
    for each check in checks:
        set executable to provider_value(tokens and provider_member(tokens and check and "executable"))
        set expected to provider_value(tokens and provider_member(tokens and check and "sha256"))
        set actual to file_digest_durable(executable and 65536)
        if not (archive_list_text(actual and 0) equals "verified") or else not (archive_list_text(actual and 1) equals expected):
            set closed to net_close(directory)
            set closed to ep_dlclose(library)
            return ""
        set arguments to create_list()
        set configured to provider_items(tokens and provider_member(tokens and check and "arguments"))
        for each argument in configured:
            set added to append_list(arguments and provider_value(tokens and argument))
        set added to append_list(arguments and candidate)
        set output_path to concat(output_directory and concat("/check-" and concat(int_to_string(index) and ".log")))
        # O_EXCL and O_NOFOLLOW: never overwrite or follow a candidate-created log.
        set output to native_open_mode(library and output_path and 2817 and 384)
        if output < 0:
            set closed to net_close(directory)
            set closed to ep_dlclose(library)
            return ""
        set profile to concat(concat(workspace_compiler_profile() and "(allow signal (target children))\n") and concat("(allow file-read* file-map-executable process-exec (literal " and concat(provider_quote(executable) and "))\n")))
        set profile to concat(profile and concat("(allow file-read* file-map-executable process-exec (literal " and concat(provider_quote(candidate) and "))\n")))
        set profile to concat(profile and concat("(deny file-write* (literal " and concat(provider_quote(candidate) and "))\n")))
        # Only installed plans can grant these immutable acceptance inputs.
        # The candidate tree is read/execute-only; test state stays in workspace.
        if provider_kind(tokens and provider_member(tokens and check and "candidate_tree")) equals "true":
            set release_fields to provider_json_tokens(file_read(candidate))
            if release_fields equals 0 or else provider_unique_objects(release_fields) equals 0:
                return ""
            set tree to provider_value(release_fields and provider_member(release_fields and 0 and "source_root"))
            if string_length(tree) < 8 or else get_character(tree and 0) is not equal to 47 or else not (substring(tree and string_length(tree) - 7 and 7) equals "/source"):
                return ""
            if workspace equals tree or else string_index_of(workspace and concat(tree and "/")) equals 0:
                return ""
            set tree_filter to concat("(subpath " and concat(provider_quote(tree) and ")"))
            set profile to concat(profile and concat("(allow file-read* file-map-executable process-exec " and concat(tree_filter and ")\n")))
            set profile to concat(profile and concat("(deny file-write* " and concat(tree_filter and ")\n")))
            set release_root to substring(tree and 0 and string_length(tree) - 7)
            set inputs to [provider_value(release_fields and provider_member(release_fields and 0 and "source_manifest"))]
            set services to provider_items(release_fields and provider_member(release_fields and 0 and "services"))
            if services equals 0:
                return ""
            # Candidate-linked acceptance tests must never inherit access to
            # credential-bearing profiles. Only a separately pinned immutable
            # integrity evaluator may receive this explicit installed grant.
            if provider_kind(tokens and provider_member(tokens and check and "service_profiles")) equals "true":
                for each service in services:
                    set added to append_list(inputs and provider_value(release_fields and provider_member(release_fields and service and "profile")))
            for each input in inputs:
                set path to ptr_to_str(input)
                set prefix to concat(release_root and "/")
                if string_index_of(path and prefix) is not equal to 0:
                    return ""
                set leaf to substring(path and string_length(prefix) and string_length(path) - string_length(prefix))
                set parts to workspace_path_parts(leaf)
                if parts equals 0 or else length_list(parts) is not equal to 1:
                    return ""
                set profile to concat(profile and concat("(allow file-read* (literal " and concat(provider_quote(path) and "))\n")))
                set profile to concat(profile and concat("(deny file-write* (literal " and concat(provider_quote(path) and "))\n")))
        set read_files to provider_items(tokens and provider_member(tokens and check and "read_files"))
        if read_files is not equal to 0:
            for each item in read_files:
                set path to provider_value(tokens and item)
                set profile to concat(profile and concat("(allow file-read* (literal " and concat(provider_quote(path) and "))\n")))
        set environment to ["PATH=/Library/Developer/CommandLineTools/usr/bin:/usr/bin:/bin",concat("TMPDIR=" and workspace),"SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"]
        set handle to workspace_sandbox_start_profile(runtime and workspace and executable and arguments and environment and directory and output and output and profile)
        set closed to net_close(output)
        if handle equals 0:
            set closed to net_close(directory)
            set closed to ep_dlclose(library)
            return ""
        set timeout_ms to 900000
        set timeout_field to provider_member(tokens and check and "timeout_ms")
        if timeout_field >= 0:
            set timeout_ms to string_to_int(provider_value(tokens and timeout_field))
        set deadline to ep_time_now_ms() + timeout_ms
        set timed_out to 0
        set state to workspace_process_poll(handle)
        repeat while state equals 0:
            if ep_time_now_ms() >= deadline:
                set timed_out to 1
                repeat while workspace_process_abort(handle) is not equal to 0:
                    set slept to sleep_ms(10)
                set state to 1
                break
            set slept to sleep_ms(10)
            set state to workspace_process_poll(handle)
        if state is not equal to 1:
            set closed to net_close(directory)
            set closed to ep_dlclose(library)
            return ""
        set waited to get_list(handle and 3)
        if timed_out equals 1:
            set waited to 124
        set descendants to workspace_process_group_cleanup(handle)
        if descendants is not equal to 0:
            set waited to 125
        set closed to workspace_process_close(handle)
        set captured to file_digest_durable(output_path and 65536)
        set after to file_digest_durable(executable and 65536)
        if not (archive_list_text(captured and 0) equals "verified") or else not (archive_list_text(after and 1) equals expected):
            set closed to net_close(directory)
            set closed to ep_dlclose(library)
            return ""
        if index > 0:
            set report to concat(report and ",")
        set report to concat(report and concat("{\"name\":" and provider_quote(provider_value(tokens and provider_member(tokens and check and "name")))))
        set report to concat(report and concat(",\"sha256\":" and provider_quote(expected)))
        set report to concat(report and concat(",\"wait_status\":" and int_to_string(waited)))
        set report to concat(report and concat(",\"output_sha256\":" and concat(provider_quote(archive_list_text(captured and 1)) and "}")))
        set index to index + 1
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    set after to file_digest_durable(candidate and 65536)
    if not (archive_list_text(after and 0) equals "verified") or else not (archive_list_text(after and 1) equals candidate_digest):
        return ""
    return concat(report and "]}")
