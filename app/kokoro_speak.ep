import "providers/native_python"
import "providers/json_access"
import "providers/archived_stream"
import "fs"

# Isolated local speech helper. Only upstream library calls cross the bridge.
# The private job directory contains input.txt and receives spoken.wav.
define main returning Int:
    if get_argument_count() is not equal to 7:
        display "Supply interpreter library, interpreter, model, voices, voice and language."
        return 1
    if not file_exists(get_argument(3)) or else not file_exists(get_argument(4)) or else not file_exists("input.txt"):
        return 2
    set library to native_python_open(get_argument(1) and get_argument(2))
    if library equals 0:
        return 3
    set loader to native_python_import(library and "espeakng_loader")
    set locate to native_python_attribute(library and loader and "get_data_path")
    set data_path to native_python_call(library and locate and create_list() and 0)
    if data_path equals 0:
        return 3
    set operating_system to native_python_import(library and "os")
    set environment to native_python_attribute(library and operating_system and "environ")
    set assign to native_python_attribute(library and environment and "__setitem__")
    set key to native_python_string(library and "PHONEMIZER_ESPEAK_DATA_PATH")
    set configured to native_python_call(library and assign and [key, data_path] and 0)
    set key to native_python_string(library and "ESPEAK_DATA_PATH")
    set configured to native_python_call(library and assign and [key, data_path] and 0)
    set module to native_python_import(library and "kokoro_onnx")
    set constructor to native_python_attribute(library and module and "Kokoro")
    set model to native_python_string(library and get_argument(3))
    set voices to native_python_string(library and get_argument(4))
    set engine to native_python_call(library and constructor and [model, voices] and 0)
    set synthesize to native_python_attribute(library and engine and "create")
    set text to native_python_string(library and ptr_to_str(read_file("input.txt")))
    set options to concat("{\"voice\":" and provider_quote(get_argument(5)))
    set options to concat(options and concat(",\"lang\":" and concat(provider_quote(get_argument(6)) and "}")))
    set keywords to native_python_json(library and options)
    set result to native_python_call(library and synthesize and [text] and keywords)
    if result equals 0:
        set printer to ep_dlsym(library and "PyErr_Print")
        set ignored to ep_dlcall0(printer)
        return 4
    set item to ep_dlsym(library and "PyTuple_GetItem")
    set samples to ep_dlcall2(item and result and 0)
    set rate to ep_dlcall2(item and result and 1)
    set soundfile to native_python_import(library and "soundfile")
    set write to native_python_attribute(library and soundfile and "write")
    set output to native_python_string(library and "spoken.wav")
    set encoding to native_python_json(library and "{\"subtype\":\"PCM_16\"}")
    set saved to native_python_call(library and write and [output, samples, rate] and encoding)
    if saved equals 0:
        set printer to ep_dlsym(library and "PyErr_Print")
        set ignored to ep_dlcall0(printer)
        return 5
    display "Local Kokoro speech saved."
    return 0
