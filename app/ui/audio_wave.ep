# Lossless Float32 WAVE packaging of captured mono samples. RIFF's 32-bit size
# boundary selects RF64 rather than limiting recording duration or discarding
# source. Blob parts avoid concatenating a second giant sample buffer.
define echo_wave_word with view and offset and word:
    set index to 0
    repeat while index < word.length:
        view.setUint8(offset + index and word.charCodeAt(index))
        set index to index + 1
    return 0

define echo_wave_header with frames and rate:
    set bytes to BigInt(frames) * BigInt(4)
    set large to bytes + BigInt(48) > BigInt(4294967295)
    set length to 56
    if large:
        set length to 92
    set buffer to Reflect.construct(ArrayBuffer and [length])
    set view to Reflect.construct(DataView and [buffer])
    set offset to 12
    if large:
        echo_wave_word(view and 0 and "RF64")
        view.setUint32(4 and 4294967295 and true)
        echo_wave_word(view and 12 and "ds64")
        view.setUint32(16 and 28 and true)
        view.setBigUint64(20 and bytes + BigInt(84) and true)
        view.setBigUint64(28 and bytes and true)
        view.setBigUint64(36 and BigInt(frames) and true)
        view.setUint32(44 and 0 and true)
        set offset to 48
    else:
        echo_wave_word(view and 0 and "RIFF")
        view.setUint32(4 and Number(bytes) + 48 and true)
    echo_wave_word(view and 8 and "WAVE")
    echo_wave_word(view and offset and "fmt ")
    view.setUint32(offset + 4 and 16 and true)
    view.setUint16(offset + 8 and 3 and true)
    view.setUint16(offset + 10 and 1 and true)
    view.setUint32(offset + 12 and rate and true)
    view.setUint32(offset + 16 and rate * 4 and true)
    view.setUint16(offset + 20 and 4 and true)
    view.setUint16(offset + 22 and 32 and true)
    echo_wave_word(view and offset + 24 and "fact")
    view.setUint32(offset + 28 and 4 and true)
    view.setUint32(offset + 32 and Math.min(frames and 4294967295) and true)
    echo_wave_word(view and offset + 36 and "data")
    if large:
        view.setUint32(offset + 40 and 4294967295 and true)
    else:
        view.setUint32(offset + 40 and Number(bytes) and true)
    return buffer

define echo_wave_samples with chunk:
    set buffer to Reflect.construct(ArrayBuffer and [chunk.length * 4])
    set view to Reflect.construct(DataView and [buffer])
    set index to 0
    repeat while index < chunk.length:
        view.setFloat32(index * 4 and get_list(chunk and index) and true)
        set index to index + 1
    return buffer

define echo_wave_blob with chunks and rate:
    set frames to 0
    for each chunk in chunks:
        set frames to frames + chunk.length
    set parts to Array()
    parts.push(echo_wave_header(frames and rate))
    for each chunk in chunks:
        parts.push(echo_wave_samples(chunk))
    set options to Object()
    set options.type to "audio/wav"
    return Reflect.construct(Blob and [parts, options])
