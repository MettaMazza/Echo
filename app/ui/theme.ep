define echo_theme_style returning Str:
    return ":root{--bg:#101216;--fg:#eceef2;--surface:#191c22;--sidebar:#14171c;--button:#242930;--border:#414751;--line:#ffffff0d;--composer-line:#ffffff16;--accent:#b6e8cf;--on-accent:#153e2e;--muted:#8b929e;--soft:#b8bec8;--code:#12151a;--inline:#252a32;--user:#b6e8cf;--pair:#191c22;--selected:#232830;--bubble:#1b2027}:root[data-theme=light]{color-scheme:light;--bg:#fafbfc;--fg:#20252d;--surface:#ffffff;--sidebar:#f1f3f5;--button:#e9edf0;--border:#bdc6cd;--line:#182b3a12;--composer-line:#182b3a20;--accent:#226c52;--on-accent:#ffffff;--muted:#707986;--soft:#495563;--code:#f3f5f7;--inline:#edf1f4;--user:#226c52;--pair:#ffffff;--selected:#e4e9ec;--bubble:#eef2f4}:root{background:var(--bg);color:var(--fg);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}header,article{border-color:var(--line)}.brand{color:var(--fg)}.muted,#model,.footnote,.code-tools{color:var(--muted)}button,input,textarea,select{font:inherit;border-color:var(--border);color:var(--fg);background:var(--surface)}button{background:var(--button);border-radius:10px}select{padding:9px;border-radius:8px}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}#pairing{border-color:var(--line);background:var(--pair)}.markdown-body pre{background:var(--code);border-color:var(--line)}.markdown-body :not(pre)>code,.markdown-body th{background:var(--inline)}.markdown-body blockquote{color:var(--soft);border-color:var(--accent)}.markdown-body th,.markdown-body td{border-color:var(--line)}article.user>strong{color:var(--user)}#progress{color:var(--soft)}a{color:var(--accent)}.theme-control{display:flex;align-items:center;gap:8px;margin:0;font-size:14px}"
