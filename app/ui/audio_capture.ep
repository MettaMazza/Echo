# Browser-native worklet; mono Float32 capture at the actual context sample rate.
# One second is a transfer batch, not a recording length limit. Stop flushes the
# final partial batch before an end receipt; no audio is played through output.
define echo_capture_processor:
    set instance to Reflect.construct(AudioWorkletProcessor and Array() and echo_capture_processor)
    set instance.pending to Reflect.construct(Float32Array and [sampleRate])
    set instance.used to 0
    set instance.running to true
    set instance.port.onmessage to given event:
        if event.data == "stop" && instance.running:
            set instance.running to false
            if instance.used > 0:
                instance.port.postMessage(instance.pending.slice(0 and instance.used))
            instance.port.postMessage("ended")
    return instance

define echo_capture_process with inputs and outputs and parameters:
    if not this.running:
        return false
    set channels to get_list(inputs and 0)
    if not channels || channels.length == 0:
        return true
    set samples to get_list(channels and 0)
    set offset to 0
    repeat while offset < samples.length:
        set count to Math.min(samples.length - offset and this.pending.length - this.used)
        set setter to get_list(this.pending and "set")
        setter.call(this.pending and samples.subarray(offset and offset + count) and this.used)
        set this.used to this.used + count
        set offset to offset + count
        if this.used == this.pending.length:
            this.port.postMessage(this.pending.slice())
            set this.used to 0
    return true

define main:
    Object.setPrototypeOf(echo_capture_processor.prototype and AudioWorkletProcessor.prototype)
    set echo_capture_processor.prototype.process to echo_capture_process
    registerProcessor("echo-capture" and echo_capture_processor)
    return 0
