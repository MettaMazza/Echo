# Generated as a separate local browser worker. The caller can terminate a
# nonterminating expression without freezing chat or imposing an expansion cap.
define main:
    self.importScripts("/assets/katex.min.js")
    set self.onmessage to given event:
        set result to Object()
        set result.identity to event.data.identity
        set options to Object()
        set options.throwOnError to false
        set options.trust to false
        set options.maxExpand to Infinity
        set options.maxSize to Infinity
        set options.macros to Object()
        set options.displayMode to event.data.display
        set result.html to self.katex.renderToString(event.data.source and options)
        self.postMessage(result)
    return 0
