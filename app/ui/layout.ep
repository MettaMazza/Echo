define echo_layout_style returning Str:
    set css to "html,body{height:100%;margin:0}body{font-size:14px;-webkit-font-smoothing:antialiased}main{max-width:none;margin:0;padding:0;height:100dvh;display:flex;flex-direction:column}header{height:72px;min-height:72px;padding:0 28px;gap:20px;flex-wrap:nowrap;background:var(--bg);border-bottom:1px solid var(--line);z-index:20}.brand{font-size:24px;font-weight:650;letter-spacing:-1px}#model{font-size:11px;margin-top:3px}#connection{margin-left:auto;font-size:12px;color:var(--muted);white-space:nowrap}#connection::before{content:'';display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--accent);margin-right:8px}.echo-layout{display:grid;grid-template-columns:264px minmax(0,1fr);min-height:0;flex:1;gap:0}#history-sidebar{padding:24px 14px;background:var(--sidebar);border-right:1px solid var(--line);overflow:auto;min-height:0;scrollbar-width:thin}#history-sidebar>button{width:100%;text-align:left;margin:0 0 22px;padding:13px 16px;border:1px solid var(--line);background:var(--surface);font-weight:600}#history-sidebar details{margin:0}#history-sidebar details>summary{font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);padding:0 10px 12px;list-style:none}#history-sidebar form{margin:0 0 16px;position:relative}#history-sidebar form label{font-size:0;margin:0}#session-search{font-size:12px;padding:10px 58px 10px 12px;border-radius:10px;background:var(--bg);border:1px solid var(--line)}#history-sidebar form>button{position:absolute;right:4px;bottom:4px;padding:7px;font-size:11px;border:0;background:transparent;color:var(--muted)}#sessions>div{position:relative;margin:3px 0;border:0;padding:0;border-radius:10px}#sessions .session-choice{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;width:100%;text-align:left;line-height:1.5;height:58px;max-height:58px;padding:10px 35px 10px 12px;font-size:12px;font-weight:450;white-space:normal;overflow-wrap:anywhere;background:transparent;border:1px solid transparent;margin:0;color:var(--soft)}#sessions .session-choice>span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;max-height:36px}#sessions .session-choice:hover{background:var(--button)}#sessions .session-choice[aria-current=page]{background:var(--selected);border-color:var(--line);color:var(--fg)}#sessions>div>div{position:absolute;right:5px;top:13px}#sessions>div>div:has(>div:not([hidden])){position:static;padding:8px 10px}#sessions>div>div input{font-size:12px}#sessions>div>div>div button{font-size:11px;padding:7px;margin:6px 4px 0 0}#sessions>div>div>button{font-size:0;width:25px;height:25px;padding:0;background:transparent;border:0;color:var(--muted);opacity:0}#sessions>div>div>button::after{content:'⋯';font-size:18px}#sessions>div:hover>div>button,#sessions>div:focus-within>div>button{opacity:1}#provider-controls{border-top:1px solid var(--line);margin-top:24px;padding:16px 10px;font-size:12px;overflow-wrap:anywhere}#provider-controls label{color:var(--muted);font-size:11px}#provider-controls select{width:100%;font-size:12px;margin-top:8px;background:var(--surface);border:1px solid var(--line)}"
    set css to concat(css and "#workspace{width:100%;min-width:0;max-width:none;margin:0;overflow:auto;padding:30px max(28px,calc((100% - 850px)/2));scrollbar-width:thin;scroll-behavior:smooth}#session-label{font-size:11px;letter-spacing:.5px;margin:0 0 24px;color:var(--muted)}#welcome{padding:clamp(48px,12vh,130px) 0 44px;text-align:center}#welcome h1{font-size:clamp(30px,4vw,46px);line-height:1.15;font-weight:550;letter-spacing:-1.8px;margin:18px 0 14px}#welcome p{font-size:15px;line-height:1.6;color:var(--muted)}.welcome-mark{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border:1px solid var(--line);border-radius:19px;background:var(--surface);color:var(--accent);font-size:32px;box-shadow:0 8px 32px #00000010}.suggestions{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:28px}.suggestions button{font-size:12px;background:transparent;border:1px solid var(--line);padding:10px 14px;border-radius:20px;color:var(--soft)}#transcript{margin:0}article{border:0;padding:0 0 34px;margin:0 0 10px;line-height:1.7}article>strong{font-size:12px;font-weight:600;letter-spacing:.2px;color:var(--fg);margin-bottom:14px;display:flex;align-items:center;gap:9px}article.assistant>strong::before{content:'◉';color:var(--accent);font-size:19px}article.user{margin-left:12%;padding:18px 22px 12px;background:var(--bubble);border:1px solid var(--line);border-radius:20px 20px 5px 20px;margin-bottom:36px}article.user>strong{font-size:11px;color:var(--muted);margin-bottom:7px}.message-text{font-size:15px;line-height:1.8}.markdown-body p{margin:0 0 16px}.markdown-body h1,.markdown-body h2,.markdown-body h3{letter-spacing:-.5px;font-weight:600}.markdown-body pre{border:1px solid var(--line);border-radius:14px;font-size:13px}.markdown-body table{font-size:13px}article>button{font-size:11px;padding:6px 9px;margin:8px 3px 0 0;background:transparent;border-color:transparent;color:var(--muted)}article>button:hover{background:var(--button);color:var(--fg)}article>p,article>div:not(.message-text){font-size:11px;color:var(--muted);margin-top:10px}article>div:not(.message-text) button{font-size:11px;padding:5px 8px;background:transparent}#draft{margin:16px 0 24px;border-left:2px solid var(--accent);padding-left:20px}#source-panel{border:1px solid var(--line);border-radius:16px;padding:22px;background:var(--surface);font-size:13px}#source-panel img{max-width:100%;border-radius:12px}#source-panel audio{width:100%}")
    set css to concat(css and "#composer{position:sticky;bottom:0;z-index:5;margin:24px 0 0;padding:16px 18px 12px;border:1px solid var(--composer-line);border-radius:22px;background:var(--surface);box-shadow:0 12px 45px #00000016,0 1px 4px #0000000c}#composer>label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);margin:0}#message{min-height:76px;max-height:35vh;padding:10px 4px;background:transparent;border:0;border-radius:8px;font-size:15px;line-height:1.65;resize:vertical}#message::placeholder{color:var(--muted)}#message:focus-visible{outline:none}#composer:focus-within{border-color:var(--accent)}.composer-bottom{gap:8px;margin:8px 0 0;align-items:center}#progress{font-size:11px;line-height:1.5;flex:1;color:var(--muted)}#send{background:var(--accent);color:var(--on-accent);border:0;border-radius:12px;font-weight:600;padding:11px 17px;white-space:nowrap}#stop,#retry{font-size:12px;padding:9px 12px;border:1px solid var(--line);background:transparent}#stop:disabled{display:none}.tools-drawer{margin:0 0 3px}.tools-drawer>summary{list-style:none;cursor:pointer;font-size:12px;color:var(--muted);display:inline-flex;padding:5px 8px;border-radius:8px}.tools-drawer>summary:hover{background:var(--button);color:var(--fg)}.tools-content{max-height:35vh;overflow:auto;border-bottom:1px solid var(--line);padding:8px 0 14px;margin-bottom:10px}.tools-content label{font-size:12px;color:var(--muted)}.tools-content input[type=file]{border:1px dashed var(--border);padding:14px;font-size:12px;background:transparent;border-radius:12px}.tools-content input::file-selector-button{border:0;border-radius:7px;padding:7px 10px;margin-right:10px;background:var(--button);color:var(--fg)}#attachment-status,#audio-status{font-size:11px;line-height:1.6;color:var(--muted)}#attachment-list,#audio-recordings{list-style:none;padding:0;margin:10px 0;font-size:11px;overflow-wrap:anywhere}#attachment-list li{border:1px solid var(--line);border-radius:10px;padding:9px 12px;margin:6px 0}#attachment-list button,#audio-recordings button,#audio-panel button{font-size:11px;padding:6px 9px;margin:3px;border:1px solid var(--line);background:transparent}input[type=checkbox]{width:auto;accent-color:var(--accent);margin:0 8px}#audio-panel{margin:12px 0 0;padding-top:10px;border-top:1px solid var(--line)}#workspace>.footnote{text-align:center;font-size:10px;margin:12px 0 0;line-height:1.5}.header-options{position:relative;margin:0}.header-options>summary{list-style:none;cursor:pointer;padding:9px 12px;border:1px solid var(--line);border-radius:10px;font-size:12px;color:var(--soft)}.header-options[open]>div{position:absolute;right:0;top:44px;width:255px;padding:16px;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:0 12px 40px #00000025;z-index:30}.header-options>div>button{display:block;width:100%;text-align:left;margin:4px 0;font-size:12px;background:transparent;border:0}.header-options .theme-control{margin:14px 0;font-size:12px;justify-content:space-between}.header-options label{font-size:11px}.header-options input{font-size:12px;max-width:90px}.header-options select{font-size:12px}#nav-toggle{display:none}button{transition:background .15s,border-color .15s,transform .15s}button:not(:disabled):active{transform:translateY(1px)}#pairing{max-width:480px;margin:40px auto;padding:28px;border:1px solid var(--line);background:var(--surface);border-radius:20px}")
    set css to concat(css and ".thinking{border:1px solid var(--line);border-radius:14px;padding:14px 18px;margin:16px 0;color:var(--muted);font-size:12px}.thinking summary{cursor:pointer;color:var(--fg)}.thinking-log{max-height:55vh;overflow:auto;overflow-wrap:anywhere}.thinking-log pre{white-space:pre-wrap;font:12px/1.6 ui-monospace,monospace;border-left:2px solid var(--line);padding-left:12px}.thinking-log>div{margin:14px 0}")
    set css to concat(css and ".message-audio{padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:var(--surface);margin:14px 0}.message-audio audio{display:block;width:100%;margin:8px 0}.message-audio p{margin:0;font-size:12px}.thinking{width:100%;box-sizing:border-box;text-align:left}article>.thinking{margin:0 0 20px}")
    return concat(css and "@media(max-width:800px){header{height:64px;min-height:64px;padding:0 16px;gap:12px}.brand{font-size:21px}#model{max-width:180px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}#connection{font-size:0}#connection::before{margin:0;width:7px;height:7px}.echo-layout{display:block;position:relative;overflow:hidden}#nav-toggle{display:block;padding:7px 10px;border:1px solid var(--line);background:transparent;font-size:17px}#history-sidebar{display:none;position:absolute;inset:0 auto 0 0;width:min(300px,85vw);z-index:15;box-shadow:20px 0 60px #00000030}#history-sidebar[data-open=true]{display:block}#workspace{height:100%;padding:24px 18px}#welcome{padding:60px 0 30px}article.user{margin-left:6%;padding:15px 17px}.message-text{font-size:14px}#composer{padding:12px;border-radius:18px}#send{padding:10px 13px}#sessions>div>div>button{opacity:1}.suggestions{gap:6px}.suggestions button{font-size:11px;padding:9px 12px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}")
