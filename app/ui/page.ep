import "theme"
import "layout"

define echo_page returning Str:
    set page to "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Echo</title><style>:root{color-scheme:dark;font-family:system-ui,-apple-system,sans-serif;background:#151719;color:#eeede8}*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}main{max-width:1100px;margin:auto;padding:24px}header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;border-bottom:1px solid #34383b;padding-bottom:20px}.brand{font-size:26px;color:#e3be84}.muted,#model{color:#aab1b5;font-size:14px}button{cursor:pointer;border:1px solid #60696e;border-radius:10px;padding:10px 16px;background:#30363a;color:#eeede8}button:disabled{opacity:.5;cursor:default}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid #e3be84;outline-offset:4px}section,form{margin-top:24px}#pairing{border:1px solid #776442;background:#23211d;border-radius:16px;padding:24px}label{display:block;margin:12px 0 8px}input,textarea{width:100%;padding:12px;background:#1d2023;color:#eeede8;border:1px solid #60696e;border-radius:10px}#pair-form button{margin-top:16px}#workspace{max-width:800px;margin:40px auto}h1{font-size:36px;letter-spacing:-1px;font-weight:500}#welcome{padding:30px 0}.message-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65}.markdown-body{white-space:normal}.markdown-body pre{white-space:pre;overflow:auto;padding:16px;background:#101214;border:1px solid #34383b;border-radius:10px}.markdown-body code{font-family:ui-monospace,monospace;font-size:.9em}.markdown-body :not(pre)>code{background:#292d30;padding:2px 5px;border-radius:4px}.markdown-body blockquote{border-left:3px solid #e3be84;padding-left:16px;margin-left:0;color:#bdc3c6}.markdown-body h1{font-size:1.6em}.markdown-body h2{font-size:1.35em}.markdown-body h3{font-size:1.15em}.code-tools{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:16px;color:#aab1b5}.code-tools button{padding:6px 12px;font-size:13px}.code-tools+pre{margin-top:6px}.table-scroll{overflow-x:auto}.markdown-body table{border-collapse:collapse;width:100%;margin:16px 0}.markdown-body th,.markdown-body td{border:1px solid #50585d;padding:10px 14px}.markdown-body th{background:#292d30}.align-left{text-align:left}.align-center{text-align:center}.align-right{text-align:right}.markdown-body p{margin:12px 0}article{padding:24px 0;border-bottom:1px solid #34383b}article>strong{display:block;margin-bottom:10px;color:#e3be84}article.user>strong{color:#b4c5d4}textarea{min-height:110px;resize:vertical}.composer-bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:12px}#progress{font-size:14px;color:#bdc3c6;line-height:1.5}.footnote{font-size:12px;color:#aab1b5;line-height:1.6}#connection{font-size:13px;color:#e3be84}.session-choice{display:block;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:8px}details{margin-top:20px}summary{cursor:pointer}[hidden]{display:none!important}@media(max-width:600px){main{padding:18px}#workspace{margin:24px auto}h1{font-size:29px}.composer-bottom{align-items:flex-start}#pairing{padding:18px}}</style></head><body><main><header><div><div class='brand'>◉ Echo</div><div id='model'>Connecting…</div></div><span id='connection' role='status'>Checking local service</span><button id='new-chat' disabled>New chat</button></header><section id='pairing' hidden aria-labelledby='pair-title'><h2 id='pair-title'>Pair this browser</h2><p>Use a one-use invitation from the host Mac. This browser gets its own conversations and work.</p><form id='pair-form'><label for='device-name'>Device name</label><input id='device-name' autocomplete='off' placeholder='My phone' required><label for='invitation'>Invitation</label><input id='invitation' type='password' autocomplete='off' spellcheck='false' required><button type='submit'>Pair device</button></form><p class='footnote'>Anyone using this browser profile shares its identity. Use a separate browser profile for another person.</p></section><div class='echo-layout'><aside id='history-sidebar' aria-label='Conversation navigation'><details open><summary>Conversations on this device</summary><nav id='sessions' aria-label='Saved conversations'></nav></details><div id='provider-controls'></div></aside><div id='workspace'><div id='session-label' class='muted'>New conversation</div><section id='welcome'><h1>What shall we work on?</h1><p class='muted'>Your conversation and original tool results stay on this Mac.</p></section><section id='transcript' aria-label='Conversation'></section><section id='draft' hidden aria-label='Reply in progress'><strong>Echo · writing</strong><div id='draft-text' class='message-text'></div><p class='footnote'>Partial reply — not yet completed.</p></section><form id='composer'><label for='message'>Message Echo</label><textarea id='message' placeholder='Write a message…' disabled></textarea><div class='composer-bottom'><div id='progress' role='status' aria-live='polite'>Connecting…</div><button id='stop' type='button' disabled>Stop</button><button id='send' type='submit' disabled>Send ↑</button></div></form><p class='footnote'>Conversations and original tool results are saved locally on this Mac.</p></div></div></main><script src='/app.js' defer></script></body></html>"
    set page to string_replace(page and "</style>" and concat(echo_theme_style() and concat(echo_layout_style() and "</style>")))
    set page to string_replace(page and "</head>" and "<link rel='stylesheet' href='/assets/katex.min.css'><style>.katex-display{overflow-x:auto;overflow-y:hidden;padding:8px 0}.math-source{white-space:pre-wrap}.hljs-keyword,.hljs-selector-tag{color:#dba8ff}.hljs-string,.hljs-attr{color:#a3d8a0}.hljs-number,.hljs-literal{color:#e8b67d}.hljs-comment{color:var(--muted);font-style:italic}.hljs-title,.hljs-built_in{color:#8ecde6}:root[data-theme=light] .hljs-keyword,:root[data-theme=light] .hljs-selector-tag{color:#75329b}:root[data-theme=light] .hljs-string,:root[data-theme=light] .hljs-attr{color:#245c2d}:root[data-theme=light] .hljs-number,:root[data-theme=light] .hljs-literal{color:#8a4400}:root[data-theme=light] .hljs-title,:root[data-theme=light] .hljs-built_in{color:#185d78}</style></head>")
    return string_replace(page and "<script src='/app.js'" and "<script src='/assets/math-render.js' defer></script><script src='/assets/highlight.min.js' defer></script><script src='/assets/audio-wave.js' defer></script><script src='/assets/audio-store.js' defer></script><script src='/assets/audio-recorder.js' defer></script><script src='/assets/audio-controls.js' defer></script><script src='/app.js'")
