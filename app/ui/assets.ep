import "../retained_text"
import "../archive/file_digest"
import "../transport/file_response"

# Only these upstream public UI resources are exposed. This is not a general
# file route; model output and browser arguments cannot supply a host path.
define echo_asset with target as Str returning List:
    set root to ptr_to_str(get_env("ECHO_UI_ASSETS"))
    if string_length(root) equals 0:
        return 0
    set path to ""
    set media to ""
    if target equals "/assets/audio-controls.js":
        set path to "/echo-audio-controls.js"
        set media to "application/javascript"
    else if target equals "/assets/audio-recorder.js":
        set path to "/echo-audio-recorder.js"
        set media to "application/javascript"
    else if target equals "/assets/audio-store.js":
        set path to "/echo-audio-store.js"
        set media to "application/javascript"
    else if target equals "/assets/audio-capture.js":
        set path to "/echo-audio-capture.js"
        set media to "application/javascript"
    else if target equals "/assets/audio-wave.js":
        set path to "/echo-audio-wave.js"
        set media to "application/javascript"
    else if target equals "/assets/math-render.js":
        set path to "/echo-math-render.js"
        set media to "application/javascript"
    else if target equals "/assets/math-worker.js":
        set path to "/echo-math-worker.js"
        set media to "application/javascript"
    else if target equals "/assets/katex.min.js":
        set path to "/katex-0.19.0/dist/katex.min.js"
        set media to "application/javascript"
    else if target equals "/assets/auto-render.min.js":
        set path to "/katex-0.19.0/dist/contrib/auto-render.min.js"
        set media to "application/javascript"
    else if target equals "/assets/katex.min.css":
        set path to "/katex-0.19.0/dist/katex.min.css"
        set media to "text/css"
    else if target equals "/assets/highlight.min.js":
        set path to "/highlight-11.12.0/highlight.min.js"
        set media to "application/javascript"
    else if string_length(target) > 14 and ptr_to_str(substring(target and 0 and 14)) equals "/assets/fonts/":
        set name to ptr_to_str(substring(target and 14 and string_length(target) - 14))
        # No slashes, percent escapes, query strings or dot path components.
        set index to 0
        repeat while index is less than string_length(name):
            set byte to get_character(name and index)
            if not ((byte >= 65 and byte <= 90) or else (byte >= 97 and byte <= 122) or else (byte >= 48 and byte <= 57) or else byte equals 95 or else byte equals 45 or else byte equals 46):
                return 0
            set index to index + 1
        if string_contains(name and "..") > 0 or else string_length(name) < 7:
            return 0
        if ptr_to_str(substring(name and string_length(name) - 6 and 6)) equals ".woff2":
            set media to "font/woff2"
        else if ptr_to_str(substring(name and string_length(name) - 5 and 5)) equals ".woff":
            set media to "font/woff"
        else if ptr_to_str(substring(name and string_length(name) - 4 and 4)) equals ".ttf":
            set media to "font/ttf"
        else:
            return 0
        set path to concat("/katex-0.19.0/dist/fonts/" and name)
    else:
        return 0
    set path to concat(root and path)
    set verified to file_digest(path and 65536)
    if not (archive_list_text(verified and 0) equals "verified"):
        return 0
    set result to create_list()
    set added to append_list(result and path)
    set added to append_list(result and media)
    set added to append_list(result and get_list(verified and 2))
    return result
