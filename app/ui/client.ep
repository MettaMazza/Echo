# Keep the newest turn visible without pulling readers away from older messages.
define echo_follow_latest:
    if window.echoFollowLatest:
        set workspace to document.getElementById("workspace")
        set workspace.scrollTop to workspace.scrollHeight
    return 0

# Authored in Ernos; the browser program is generated by the reference compiler.
# Original message text is retained; assistant formatting escapes raw HTML.
define echo_note with text:
    set element to document.getElementById("progress")
    if element.textContent != text:
        set element.textContent to text
    if text != window.echoCompactionActivity:
        element.setAttribute("aria-live" and "polite")
        set panel to document.getElementById("compaction-progress")
        if panel:
            set panel.hidden to true
            panel.setAttribute("data-active" and "false")
        set window.echoCompactionActivity to ""
    return 0

# Only a current-run backend observation can start this indicator.
define echo_compaction_progress with result:
    set observation to result.compaction
    if window.echoCompactionActivity && observation && observation.state != "pending":
        echo_recap_notice(window.echoHistoryMarker)
    if not observation || observation.session != window.echoSession || observation.state != "pending":
        # Identical stage text must not preserve another conversation's spinner.
        set window.echoCompactionActivity to ""
        echo_note(result.activity || "Preparing the next step…")
        return 0
    if result.worker_status != "running":
        echo_note("Recap work is saved and waiting for a worker to continue.")
        return 0
    set panel to document.getElementById("compaction-progress")
    if not panel:
        set panel to document.createElement("aside")
        set panel.id to "compaction-progress"
        panel.setAttribute("aria-label" and "Conversation compaction")
        set title to document.createElement("strong")
        set title.textContent to "Organising this conversation"
        panel.appendChild(title)
        set explanation to document.createElement("p")
        set explanation.textContent to "Your original messages and files remain saved. Echo is preparing a detailed recap and checking it before continuing. This may take longer than a normal reply."
        panel.appendChild(explanation)
        set stage to document.createElement("p")
        set stage.id to "compaction-stage"
        stage.setAttribute("role" and "status")
        stage.setAttribute("aria-live" and "polite")
        stage.setAttribute("aria-atomic" and "true")
        panel.appendChild(stage)
        set composer to document.getElementById("composer")
        composer.parentNode.insertBefore(panel and composer)
    set window.echoCompactionActivity to result.activity
    document.getElementById("progress").setAttribute("aria-live" and "off")
    echo_note(result.activity)
    set stage to document.getElementById("compaction-stage")
    if stage.textContent != result.activity:
        set stage.textContent to result.activity
    set panel.hidden to false
    panel.setAttribute("data-active" and "true")
    return 0

define echo_busy with busy:
    set window.echoBusy to busy
    set busy to busy || window.echoUploading || window.echoReadOnly
    set input to document.getElementById("message")
    set button to document.getElementById("send")
    set fresh to document.getElementById("new-chat")
    set input.disabled to window.echoReadOnly || not window.echoToken
    set button.disabled to window.echoUploading || window.echoReadOnly || not window.echoToken || (window.echoGroup && not window.echoGroupWritable)
    set button.textContent to "Send ↑"
    if window.echoBusy && not window.echoAutonomy:
        set button.textContent to "Queue ↑"
    echo_queue_render()
    set fresh.disabled to window.echoUploading || window.echoReadOnly || (window.echoBusy && not window.echoAutonomy)
    set picker to document.getElementById("provider-picker")
    if picker:
        set picker.disabled to busy || window.echoGroup || not (not window.localStorage.getItem("echo.pending"))
    set stop_button to document.getElementById("stop")
    set stop_button.disabled to window.echoReadOnly || not (window.echoCanStop && window.echoRun && window.echoToken)
    set retry_button to document.getElementById("retry")
    set retry_button.hidden to busy || not window.echoRetryWorker || not window.echoToken
    set revision_button to document.getElementById("resume-revision")
    set revision_button.hidden to not window.localStorage.getItem("echo.revision.pending")
    set revision_button.disabled to busy || not window.echoToken || not (not window.localStorage.getItem("echo.pending"))
    set export_button to document.getElementById("export-session")
    set export_button.disabled to not window.echoToken || not window.echoSession
    set attachment_input to document.getElementById("attachment-file")
    set attachment_input.disabled to busy || not window.echoToken || (window.echoGroup && not window.echoGroupWritable)
    for each file_checkbox in document.querySelectorAll(".attachment-file_checkbox"):
        set file_checkbox.disabled to busy || not window.echoToken || not (not window.localStorage.getItem("echo.pending"))
    echo_audio_controls_refresh()
    return 0

# Keep machine codes for control flow while presenting actionable messages.
define echo_error_code with error:
    if error && error.code:
        return error.code
    if error && error.status:
        return error.status
    return String(error)

define echo_failure with source:
    if source && source.echoFeedback:
        return source
    set code to echo_error_code(source)
    set feedback to null
    if source && source.feedback:
        set feedback to source.feedback
    set message to "The operation reported: " + code + "."
    set effects to "The outcome is not confirmed; check saved state before repeating a change."
    set recovery to "Reopen the affected panel to check its current state. If the problem persists, keep this error and the run reference for investigation; do not repeat the same action unchanged."
    if code.includes("fetch") || code.includes("network") || code.includes("Network") || code.includes("service") || code.includes("HTTP 50"):
        set message to "Echo could not confirm a response from the local service."
        set recovery to "Check the connection to the host Mac and reopen this panel when the service is reachable. For a pending message, retry its existing submission rather than creating a duplicate."
    else if code.includes("unauthorized") || code.includes("not-authorized") || code.includes("revoked"):
        set recovery to "Open Devices & access and check this browser's access and role. Restore access through an authorised device or administrator. Your existing link must not be erased just because this check failed."
    else if code.includes("conflict") || code.includes("changed") || code.includes("cursor"):
        set recovery to "Reload the current record, compare it with your intended change, then retry using the updated revision. Keep your draft and existing files."
    else if code.includes("invalid") || code.includes("parse") || code.includes("SyntaxError"):
        set recovery to "Check the requested fields and supported file format. Correct the input before retrying. If the server response was incomplete, check whether the operation already completed before resubmitting."
    else if code.includes("integrity") || code.includes("digest") || code.includes("hash"):
        set recovery to "Keep the original file and report this integrity error. Verify or restore the source before retrying; do not bypass verification."
    else if code.includes("busy") || code.includes("pending") || code.includes("progress") || code.includes("session-active"):
        set recovery to "Check the existing task's progress. Wait, steer it, or use Stop if needed; do not submit a duplicate operation."
    else if code.includes("unavailable") || code.includes("not-found") || code.includes("missing") || code.includes("not-configured"):
        set recovery to "Refresh the available items and check the selected file, device or service configuration. Restore the missing resource or access, then retry."
    else if code.includes("storage") || code.includes("write") || code.includes("commit") || code.includes("database"):
        set recovery to "Check the host's available storage and permissions. Inspect whether the change was saved before retrying, and preserve the original data."
    if source && source.recovery:
        set recovery to source.recovery
    if source && source.effects:
        set effects to source.effects
    if feedback:
        if feedback.message:
            set message to feedback.message
        if feedback.effects:
            set effects to feedback.effects
        if feedback.recovery:
            set recovery to feedback.recovery
    if feedback && feedback.reference:
        set recovery to recovery + " Reference: " + feedback.reference
    set result to Error(message + " " + effects + " " + recovery + " Code: " + code)
    set result.code to code
    set result.echoFeedback to true
    return result

define echo_error with error:
    echo_note(String(echo_failure(error)))
    echo_busy(not window.echoToken)
    echo_outbox_render()
    return 0

define echo_catch with promise:
    set catcher to get_list(promise and "catch")
    catcher.call(promise and echo_error)
    return promise

define echo_api with path and payload:
    set options to Object()
    set options.method to "POST"
    set headers to Object()
    set setter to get_list(Reflect and "set")
    setter.call(Reflect and headers and "Content-Type" and "application/json")
    setter.call(Reflect and headers and "X-Echo-Token" and window.echoToken)
    set options.headers to headers
    set options.body to JSON.stringify(payload)
    return window.fetch(path and options).then(given response:
        set parsed to response.json()
        set parse_failure to get_list(parsed and "catch")
        set decoded to parse_failure.call(parsed and given error:
            set error to echo_failure(error)
            return Promise.reject(echo_failure("Incomplete server response: HTTP " + response.status))
        )
        return decoded.then(given body:
            if not response.ok:
                if body.status == "session-active" && (path == "/api/runs" || path == "/api/group-submit"):
                    return body
                if body.status == "unauthorized":
                    # A failed request must never erase a durable device link.
                    # Explicit unlink remains enforced by the server.
                    set pairing to document.getElementById("pairing")
                    set pairing.hidden to false
                echo_note(String(echo_failure(body)))
                return Promise.reject(echo_failure(body))
            return body
        )
    )

# Authenticated original bytes produce a thumbnail; no credential-bearing URL.
define echo_attachment_thumbnail with file:
    set holder to document.createElement("div")
    set holder.className to "attachment-thumbnail"
    set preview to document.createElement("img")
    set preview.alt to file.name
    set preview.style.maxWidth to "100%"
    set preview.style.width to "240px"
    set preview.style.maxHeight to "220px"
    set preview.style.objectFit to "contain"
    set preview.style.borderRadius to "12px"
    set preview.loading to "lazy"
    holder.appendChild(preview)
    set loaded to echo_verified_attachment(file).then(given bytes:
        set options to Object()
        set options.type to file.media_type
        set blob to Reflect.construct(Blob and [[bytes], options])
        set address to URL.createObjectURL(blob)
        preview.addEventListener("load" and given ignored:
            URL.revokeObjectURL(address)
        )
        preview.addEventListener("error" and given ignored:
            URL.revokeObjectURL(address)
            set holder.textContent to "Preview unavailable: " + file.name + ". Open or download the original to inspect it; retry preview after checking its format."
        )
        set preview.src to address
    )
    set failed to get_list(loaded and "catch")
    failed.call(loaded and given error:
        set error to echo_failure(error)
        set holder.textContent to "Preview unavailable: " + error
    )
    return holder

# Keep pending attachments visible even when Files & voice is collapsed.
define echo_pending_attachments:
    set strip to document.getElementById("pending-attachments")
    if not strip:
        set strip to document.createElement("div")
        set strip.id to "pending-attachments"
        set strip.style.display to "flex"
        set strip.style.flexWrap to "wrap"
        set strip.style.gap to "8px"
        strip.setAttribute("aria-label" and "Attachments ready to send")
        set composer to document.getElementById("message")
        composer.parentNode.insertBefore(strip and composer)
    set strip.textContent to ""
    set selected to echo_selected_files()
    for each file in window.echoAttachmentFiles || Array():
        if file.lifecycle && file.lifecycle.state == "trashed":
            continue
        if selected.includes(file.attachment):
            set card to document.createElement("div")
            set card.style.maxWidth to "160px"
            if echo_image_supported(file):
                card.appendChild(echo_attachment_thumbnail(file))
            set label to document.createElement("span")
            set label.textContent to file.name
            set label.style.overflowWrap to "anywhere"
            card.appendChild(label)
            card.appendChild(echo_remove_attachment(file and card))
            strip.appendChild(card)
    return 0

define echo_remove_attachment with file and item:
    return echo_attachment_lifecycle_button(file and "trash")

define echo_attachment_lifecycle_button with file and action:
    set query to null
    set key to null
    set saved to null
    set request to null
    set catcher to null
    set selected to null
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Move to trash"
    if action == "restore":
        set button.textContent to "Restore attachment"
    button.setAttribute("aria-label" and button.textContent + ": " + file.name)
    set button.disabled to window.echoReadOnly || (window.echoGroup && not window.echoGroupWritable)
    button.addEventListener("click" and given ignored:
        if window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
            echo_note("Finish or stop the current submission before changing attachments.")
            return 0
        set query to Object()
        set query.action to action
        set query.attachment to file.attachment
        set query.previous to ""
        if file.lifecycle:
            set query.previous to file.lifecycle.revision
        set key to "echo.attachment-lifecycle:" + file.attachment
        set saved to window.localStorage.getItem(key)
        if saved:
            set saved to JSON.parse(saved)
            if saved.action != action:
                echo_note("Retry the previous attachment change before changing it again.")
                return 0
            set query to saved
        else:
            set query.identity to window.crypto.randomUUID()
            window.localStorage.setItem(key and JSON.stringify(query))
        set button.disabled to true
        set request to echo_api("/api/attachment-lifecycle" and query).then(given result:
            window.localStorage.removeItem(key)
            if action == "trash":
                set selected to echo_selected_files().filter(given identity:
                    return identity != file.attachment
                )
                window.localStorage.setItem("echo.files:" + window.echoSession and JSON.stringify(selected))
            echo_attachments()
            echo_note("Attachment " + action + " saved. Original files, historical messages and recall remain intact; this is not memory erasure.")
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set button.disabled to false
            if echo_error_code(error) == "revision-conflict" || echo_error_code(error) == "not-authorized":
                window.localStorage.removeItem(key)
                echo_attachments()
            echo_note("Attachment change failed: " + error + ". Retry the same action; duplicate changes are prevented.")
        )
    )
    return button

define echo_attachment_visibility_button with file and action:
    set query to null
    set key to null
    set saved to null
    set request to null
    set catcher to null
    set selected to null
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Forget automatic use"
    if action == "restore":
        set button.textContent to "Restore automatic use"
    button.setAttribute("aria-label" and button.textContent + ": " + file.name)
    set button.title to "Stop automatic use without deleting the original. Explicit rereading remains available; existing messages are preserved."
    set button.disabled to window.echoReadOnly || (window.echoGroup && not window.echoGroupWritable)
    button.addEventListener("click" and given ignored:
        if window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
            echo_note("Finish or stop the current submission before changing attachments.")
            return 0
        set query to Object()
        set query.action to action
        set query.attachment to file.attachment
        set query.previous to ""
        if file.visibility:
            set query.previous to file.visibility.revision
        set key to "echo.attachment-visibility:" + file.attachment
        set saved to window.localStorage.getItem(key)
        if saved:
            set saved to JSON.parse(saved)
            if saved.action != action:
                echo_note("Retry the previous attachment change before changing it again.")
                return 0
            set query to saved
        else:
            set query.identity to window.crypto.randomUUID()
            window.localStorage.setItem(key and JSON.stringify(query))
        set button.disabled to true
        set request to echo_api("/api/attachment-visibility" and query).then(given result:
            window.localStorage.removeItem(key)
            if action == "exclude":
                set selected to echo_selected_files().filter(given identity:
                    return identity != file.attachment
                )
                window.localStorage.setItem("echo.files:" + window.echoSession and JSON.stringify(selected))
            echo_attachments()
            echo_note("Attachment preference saved. Forgotten files stay out of automatic context; Echo can reread the original when explicitly asked. Existing messages and separately shared copies are preserved.")
            if action == "restore":
                echo_note("Automatic use restored. You can select this attachment for new messages again.")
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set button.disabled to false
            if echo_error_code(error) == "revision-conflict" || echo_error_code(error) == "not-authorized":
                window.localStorage.removeItem(key)
                echo_attachments()
            echo_note("Attachment change failed: " + error + ". Retry the same action; duplicate changes are prevented.")
        )
    )
    return button


define echo_attachment_visibility_control with file:
    if file.inherited_exclusion && file.visibility && file.visibility.state == "included":
        set note to document.createElement("p")
        set note.textContent to "Automatic use follows the forgotten original video. Restore automatic use on that original to include this sample again. Explicit opening and download remain available."
        return note
    set action to "exclude"
    if file.visibility && file.visibility.state == "excluded":
        set action to "restore"
    return echo_attachment_visibility_button(file and action)

define echo_restore_legacy_attachment with file:
    set key to null
    set hidden to null
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Restore to this browser’s picker"
    button.addEventListener("click" and given ignored:
        set key to "echo.hidden-files:" + window.echoSession
        set hidden to JSON.parse(window.localStorage.getItem(key) || "[]").filter(given identity:
            return identity != file.attachment
        )
        window.localStorage.setItem(key and JSON.stringify(hidden))
        echo_attachments()
    )
    return button

define echo_message_source with file:
    set source to document.createElement("div")
    set source_label to document.createElement("span")
    set source_label.textContent to "Attached: " + file.name + " · " + file.bytes + " bytes"
    if file.observation:
        set source_label.textContent to "Source read: " + file.name + " · characters " + file.offset + "–" + (BigInt(file.offset) + BigInt(file.characters)).toString()
        if file.page != "":
            set source_label.textContent to source_label.textContent + " · page " + (BigInt(file.page) + BigInt(1)).toString()
    source.appendChild(source_label)
    if echo_image_supported(file):
        source.appendChild(echo_attachment_thumbnail(file))
    set read to document.createElement("button")
    set read.type to "button"
    set read.textContent to "Open"
    read.addEventListener("click" and given ignored:
        echo_open_attachment(file)
    )
    source.appendChild(read)
    set download to document.createElement("button")
    set download.type to "button"
    set download.textContent to "Download"
    download.addEventListener("click" and given ignored:
        echo_download_attachment(file)
    )
    source.appendChild(download)
    return source

# Bind each button to its own saved message, not a loop-scoped variable.
define echo_copy_message with message:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Copy message"
    button.addEventListener("click" and given event:
        set copied to navigator.clipboard.writeText(message.text).then(given ignored:
            echo_note("Message copied.")
        )
        set catcher to get_list(copied and "catch")
        catcher.call(copied and given error:
            set error to echo_failure(error)
            echo_note("Copy failed. Select the message text to copy it manually.")
        )
    )
    return button

# Explicit human sharing uses the server's exact content and recipient preview.
# It never shares attachments, other history, or future changes implicitly.
define echo_share_destination with select and session and title:
    if session == window.echoSession:
        return 0
    for each existing in select.options:
        if existing.value == session:
            return 0
    set option to document.createElement("option")
    set option.value to session
    set option.textContent to title
    select.appendChild(option)
    return 0

define echo_share_button with message:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Share…"
    set button.disabled to window.echoReadOnly
    button.addEventListener("click" and given ignored:
        echo_share_dialog(message and button)
    )
    return button

define echo_share_dialog with message and opener:
    set request to null
    set selection to null
    set recipients to null
    set content to null
    set key to null
    set identity to null
    set pending to null
    set dialog to document.createElement("dialog")
    dialog.setAttribute("aria-label" and "Share a message")
    set dialog.style.cssText to "width:min(540px,calc(100vw - 40px));max-height:85vh;box-sizing:border-box;overflow:auto;background:var(--surface);color:var(--fg);border:1px solid var(--border);border-radius:18px;padding:24px"
    set heading to document.createElement("h2")
    set heading.textContent to "Share a message"
    dialog.appendChild(heading)
    set explanation to document.createElement("p")
    set explanation.textContent to "Copy this message into another conversation. Only this text is shared, with its original source recorded. Attachments and other messages stay where they are. The copy remains available there even if you later leave the original conversation."
    dialog.appendChild(explanation)
    set label to document.createElement("label")
    set label.textContent to "Destination conversation "
    set select to document.createElement("select")
    select.setAttribute("aria-label" and "Destination conversation")
    set select.style.maxWidth to "100%"
    label.appendChild(select)
    dialog.appendChild(label)
    set status to document.createElement("p")
    status.setAttribute("role" and "status")
    set status.textContent to "Loading your conversations…"
    dialog.appendChild(status)
    set preview to document.createElement("div")
    dialog.appendChild(preview)
    set review to document.createElement("button")
    set review.type to "button"
    set review.textContent to "Review share"
    set review.disabled to true
    dialog.appendChild(review)
    set confirm to document.createElement("button")
    set confirm.type to "button"
    set confirm.textContent to "Confirm share"
    set confirm.hidden to true
    dialog.appendChild(confirm)
    set close to document.createElement("button")
    set close.type to "button"
    set close.textContent to "Cancel"
    dialog.appendChild(close)
    set dialog.echoPending to null
    set dialog.echoSending to false
    close.addEventListener("click" and given ignored:
        dialog.close()
    )
    dialog.addEventListener("cancel" and given event:
        if dialog.echoSending:
            event.preventDefault()
    )
    dialog.addEventListener("close" and given ignored:
        dialog.remove()
        opener.focus()
    )
    select.addEventListener("change" and given ignored:
        set preview.textContent to ""
        set confirm.hidden to true
        set dialog.echoPending to null
        set status.textContent to "Review the message and recipients before sharing."
    )
    review.addEventListener("click" and given ignored:
        set review.disabled to true
        set select.disabled to true
        set confirm.hidden to true
        set status.textContent to "Checking the selected message and recipients…"
        set query to Object()
        set query.action to "preview"
        set query.source_event to message.event
        set query.destination to select.value
        set request to echo_api("/api/memory-share" and query).then(given result:
            if result.status != "review-required":
                return Promise.reject(echo_failure(result))
            set selection to result.selection
            set preview.textContent to ""
            set recipients to document.createElement("p")
            set recipients.textContent to "Recipients: " + selection.destination_audience.join(", ")
            preview.appendChild(recipients)
            set content to document.createElement("pre")
            set content.style.cssText to "white-space:pre-wrap;overflow-wrap:anywhere;max-height:35vh;overflow:auto;font:inherit"
            set content.textContent to selection.content
            preview.appendChild(content)
            set query.action to "commit"
            set query.review_digest to result.review_digest
            set key to "echo.share." + message.event + "." + query.destination + "." + result.review_digest
            set identity to window.localStorage.getItem(key)
            if not identity:
                set identity to window.crypto.randomUUID()
                window.localStorage.setItem(key and identity)
            set query.identity to identity
            set dialog.echoPending to query
            set dialog.echoKey to key
            set confirm.hidden to false
            set confirm.disabled to false
            set review.disabled to false
            set select.disabled to false
            set status.textContent to "Review this exact text and its recipients before confirming. Repeating a confirmed share will not create another copy."
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set review.disabled to false
            set select.disabled to false
            set status.textContent to "Could not prepare share: " + error + ". Choose a current conversation and retry."
        )
    )
    confirm.addEventListener("click" and given ignored:
        if dialog.echoSending || not dialog.echoPending:
            return 0
        set dialog.echoSending to true
        set confirm.disabled to true
        set review.disabled to true
        set select.disabled to true
        set close.disabled to true
        set status.textContent to "Sharing this message…"
        set request to echo_api("/api/memory-share" and dialog.echoPending).then(given result:
            if result.status != "recorded" && result.status != "already-recorded":
                return Promise.reject(echo_failure(result))
            set dialog.echoSending to false
            set close.disabled to false
            set close.textContent to "Done"
            set confirm.hidden to true
            set status.textContent to "Shared. The selected conversation now has a source-preserving copy."
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set dialog.echoSending to false
            set close.disabled to false
            set confirm.disabled to false
            set review.disabled to false
            set select.disabled to false
            set status.textContent to "Share not confirmed: " + error + ". Retry Confirm share safely; it uses the same identity. If recipients changed, review again."
        )
    )
    document.body.appendChild(dialog)
    dialog.showModal()
    set query to Object()
    set query.query to ""
    set loading to echo_api("/api/sessions" and query).then(given result:
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        for each session in result.sessions:
            echo_share_destination(select and session.session and session.title)
        return echo_api("/api/groups" and Object())
    ).then(given result:
        set pending to Array()
        for each group in result.groups || Array():
            set query to Object()
            set query.group to group.group
            pending.push(echo_share_group_choices(select and query))
        return Promise.all(pending)
    ).then(given ignored:
        set review.disabled to select.options.length == 0
        set status.textContent to "Review the message and recipients before sharing."
        if select.options.length == 0:
            set status.textContent to "Open another private or shared conversation first, then return here to share."
    )
    set catcher to get_list(loading and "catch")
    catcher.call(loading and given error:
        set error to echo_failure(error)
        set status.textContent to "Conversation loading failed: " + error + ". Close and reopen Share to retry."
    )
    return 0

define echo_share_group_choices with select and query:
    return echo_api("/api/group-state" and query).then(given result:
        for each session in result.sessions || Array():
            if session.writable:
                echo_share_destination(select and session.session and "Shared · " + query.group)
    )

define echo_branch_button with message:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Branch from here"
    set button.disabled to window.echoReadOnly
    button.addEventListener("click" and given event:
        if window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
            echo_note("Finish or stop the current turn before opening a branch.")
            return 0
        set query to Object()
        set query.source to message.source_session
        set query.endpoint to message.event
        set saved to window.localStorage.getItem("echo.branch.pending")
        if saved:
            set query to JSON.parse(saved)
            if query.source != message.source_session || query.endpoint != message.event:
                echo_note("Retry the previous Branch from here action to resolve its interrupted request.")
                return 0
        else:
            set query.identity to window.crypto.randomUUID()
            window.localStorage.setItem("echo.branch.pending" and JSON.stringify(query))
        echo_busy(true)
        set created to echo_api("/api/session-branch" and query).then(given result:
            window.localStorage.removeItem("echo.branch.pending")
            echo_busy(false)
            set branch to Object()
            set branch.session to result.session
            set branch.run to ""
            echo_open_session(branch)
            echo_sessions()
            echo_note("Branch created. Earlier messages are preserved; continue here.")
        )
        echo_catch(created)
    )
    return button

define echo_revision_start with message and mode and text:
    if window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
        echo_note("Finish or stop the current turn before revising it.")
        return 0
    set query to Object()
    set query.source to message.source_session
    set query.user_event to message.user_event
    set query.mode to mode
    set query.text to text
    set pending to window.localStorage.getItem("echo.revision.pending")
    if pending:
        set saved to JSON.parse(pending)
        if saved.source != query.source || saved.user_event != query.user_event || saved.mode != mode || saved.text != text:
            echo_note("Retry the interrupted revision with its saved text before starting another.")
            return 0
        set query to saved
    else:
        set query.identity to window.crypto.randomUUID()
        set picker to document.getElementById("provider-picker")
        if picker && picker.value && not window.echoGroup:
            set query.provider to picker.value
        window.localStorage.setItem("echo.revision.pending" and JSON.stringify(query))
    echo_busy(true)
    set revised to echo_api("/api/session-revise" and query).then(given result:
        window.localStorage.removeItem("echo.revision.pending")
        echo_busy(false)
        set branch to Object()
        set branch.session to result.session
        set branch.run to result.run
        echo_open_session(branch)
        echo_sessions()
    )
    echo_catch(revised)
    return 0

define echo_regenerate_button with message:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Regenerate"
    set button.disabled to window.echoReadOnly
    button.addEventListener("click" and given event:
        echo_revision_start(message and "regenerate" and "")
    )
    return button

define echo_edit_button with message:
    set container to document.createElement("div")
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Edit and branch"
    set button.disabled to window.echoReadOnly
    set editor to document.createElement("div")
    set editor.hidden to true
    set input to document.createElement("textarea")
    input.setAttribute("aria-label" and "Revised message")
    set input.value to message.text
    set save to document.createElement("button")
    set save.type to "button"
    set save.textContent to "Send revised message"
    set cancel to document.createElement("button")
    set cancel.type to "button"
    set cancel.textContent to "Cancel edit"
    editor.appendChild(input)
    editor.appendChild(save)
    editor.appendChild(cancel)
    container.appendChild(button)
    container.appendChild(editor)
    button.addEventListener("click" and given event:
        set pending to window.localStorage.getItem("echo.revision.pending")
        if pending:
            set saved to JSON.parse(pending)
            if saved.source == message.source_session && saved.user_event == message.user_event && saved.mode == "edit":
                set input.value to saved.text
        set button.hidden to true
        set editor.hidden to false
        input.focus()
    )
    cancel.addEventListener("click" and given event:
        set editor.hidden to true
        set button.hidden to false
        button.focus()
    )
    save.addEventListener("click" and given event:
        if input.value.trim().length == 0:
            echo_note("Enter the revised message.")
            return 0
        echo_revision_start(message and "edit" and input.value)
    )
    return container

# Bind a separate copy action to each rendered block. Copy reads code text,
# never labels or markup, and never executes the model's program.
define echo_code_controls with block:
    set code to block.querySelector("code")
    set tools to document.createElement("div")
    set tools.className to "code-tools"
    set label to document.createElement("span")
    set label.textContent to block.getAttribute("data-language") || "Code"
    set copy to document.createElement("button")
    set copy.type to "button"
    set copy.textContent to "Copy code"
    copy.addEventListener("click" and given event:
        set copied to navigator.clipboard.writeText(code.textContent).then(given ignored:
            echo_note("Code copied.")
        )
        set catcher to get_list(copied and "catch")
        catcher.call(copied and given error:
            set error to echo_failure(error)
            echo_note("Code copy failed. Select the code text to copy it manually.")
        )
    )
    tools.appendChild(label)
    tools.appendChild(copy)
    block.parentNode.insertBefore(tools and block)
    return 0

define echo_format_response with element and original:
    set element.className to "message-text markdown-body"
    set element.innerHTML to renderAiMarkdown(original)
    for each block in element.querySelectorAll("pre"):
        echo_code_controls(block)
        set language to block.getAttribute("data-language")
        set code to block.querySelector("code")
        if window.hljs && language && window.hljs.getLanguage(language):
            set options to Object()
            set options.language to language
            set options.ignoreIllegals to true
            set highlighted to window.hljs.highlight(code.textContent and options)
            set code.innerHTML to highlighted.value
    echo_math_render(element)
    return 0

define echo_inline_audio with file and owner:
    set key to owner + ":" + file.attachment
    if not window.echoAudioCards:
        set window.echoAudioCards to Reflect.construct(Map and Array())
    if window.echoAudioCards.has(key):
        return window.echoAudioCards.get(key)
    set card to document.createElement("div")
    set card.className to "message-audio"
    set title to document.createElement("p")
    set title.textContent to file.name
    set player to document.createElement("audio")
    set player.controls to true
    set player.preload to "metadata"
    player.setAttribute("aria-label" and "Spoken reply")
    set status to document.createElement("span")
    set status.textContent to "Loading audio…"
    set download to document.createElement("button")
    set download.type to "button"
    set download.textContent to "Download audio"
    download.addEventListener("click" and given ignored:
        echo_download_attachment(file)
    )
    card.appendChild(title)
    card.appendChild(player)
    card.appendChild(status)
    card.appendChild(download)
    set cache to get_list(window.echoAudioCards and "set")
    cache.call(window.echoAudioCards and key and card)
    set loaded to echo_verified_attachment(file).then(given bytes:
        set options to Object()
        set options.type to file.media_type
        set blob to Reflect.construct(Blob and [[bytes], options])
        set card.echoURL to URL.createObjectURL(blob)
        set player.src to card.echoURL
        set status.textContent to ""
        player.addEventListener("error" and given ignored:
            set status.textContent to "This browser cannot play the audio. Download the WAV instead."
        )
    )
    set failed to get_list(loaded and "catch")
    failed.call(loaded and given error:
        set error to echo_failure(error)
        set status.textContent to "Audio unavailable: " + error
    )
    return card

define echo_speak_button with message and article:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Speak"
    set button.disabled to window.echoReadOnly
    button.addEventListener("click" and given ignored:
        set button.disabled to true
        set button.textContent to "Creating audio…"
        set query to Object()
        set query.event to message.event
        set request to echo_api("/api/speak" and query).then(given result:
            if result.status != "complete":
                return Promise.reject(echo_failure(result))
            set files_query to Object()
            set files_query.session to message.source_session
            return echo_api("/api/attachments" and files_query).then(given files:
                for each file in files.attachments || Array():
                    if file.attachment == result.attachment:
                        article.appendChild(echo_inline_audio(file and message.event))
                        if message.source_session == window.echoSession:
                            echo_history()
                        set button.textContent to "Speak"
                        set button.disabled to false
                        return 0
                return Promise.reject("Saved audio was not found")
            )
        )
        set failed to get_list(request and "catch")
        failed.call(request and given error:
            set error to echo_failure(error)
            set button.textContent to "Retry speech"
            set button.disabled to false
            echo_note("Speech: " + error)
        )
    )
    return button

define echo_render_message with message:
    # Reuse the connected message so a playing native audio element is never
    # detached just because another message or a final reply arrives.
    for each existing in document.getElementById("transcript").children:
        if existing.echoEvent == message.event:
            echo_message_attachments(existing and message)
            return existing
    set article to document.createElement("article")
    set article.className to message.role
    set article.echoEvent to message.event
    set label to document.createElement("strong")
    if message.role == "user":
        set label.textContent to "You"
        if message.recorded_sender:
            set label.textContent to message.recorded_sender.principal
    else if message.role == "source":
        set label.textContent to "Shared source"
    else:
        set label.textContent to "Echo"
    set text to document.createElement("div")
    set text.className to "message-text"
    set text.textContent to message.text
    if message.role == "assistant":
        echo_format_response(text and message.text)
    if message.role == "assistant" && message.run:
        article.appendChild(echo_thinking_panel(message.run))
    article.appendChild(label)
    article.appendChild(text)
    article.appendChild(echo_copy_message(message))
    article.appendChild(echo_share_button(message))
    if message.role == "assistant":
        if not window.echoGroup:
            article.appendChild(echo_branch_button(message))
            article.appendChild(echo_regenerate_button(message))
        if not window.echoGroup || window.echoGroupWritable:
            article.appendChild(echo_speak_button(message and article))
    else if message.role == "user" && not window.echoGroup:
        article.appendChild(echo_edit_button(message))
    echo_message_attachments(article and message)
    if message.research_sources && message.research_sources.length > 0:
        article.appendChild(echo_research_panel(message.research_sources))
    if message.source_reads && message.source_reads.length > 0:
        set source_panel to document.createElement("details")
        set source_panel.className to "sources-read"
        set source_heading to document.createElement("summary")
        set source_heading.textContent to "Sources read (" + message.source_reads.length + ")"
        set source_heading.style.cursor to "pointer"
        source_panel.appendChild(source_heading)
        for each file in message.source_reads:
            source_panel.appendChild(echo_message_source(file))
        article.appendChild(source_panel)
    return article

define echo_message_attachments with article and message:
    if not article.echoAttachments:
        set article.echoAttachments to Array()
    for each file in message.attachments || Array():
        if article.echoAttachments.includes(file.attachment):
            continue
        if file.media_type && file.media_type.slice(0 and 6) == "audio/":
            set card to echo_inline_audio(file and message.event)
            if card.parentNode != article:
                article.appendChild(card)
        else:
            article.appendChild(echo_message_source(file))
        article.echoAttachments.push(file.attachment)
    return 0

# Commit a batch without disconnecting retained messages or their media.
define echo_commit_messages with transcript and nodes and before:
    if before == "0":
        for each child in get_list(Array and "from").call(Array and transcript.children):
            if not nodes.includes(child):
                set player to child.querySelector("audio")
                if not player || player.paused:
                    child.remove()
    set reference to transcript.firstChild
    for each node in nodes:
        if node.parentNode == transcript:
            set reference to node.nextSibling
        else:
            transcript.insertBefore(node and reference)
    return 0

define echo_history_page with before and marker:
    set query to Object()
    set query.session to window.echoSession
    set query.before to before
    set size to document.getElementById("history-page-size")
    set query.messages to Number(size.value)
    if not Number.isSafeInteger(query.messages) || query.messages < 1:
        echo_note("Choose a positive whole-number message batch size.")
        return 0
    set older to document.getElementById("history-older")
    set older.disabled to true
    set loaded to echo_api("/api/session" and query).then(given result:
        if marker != window.echoHistoryMarker || query.session != window.echoSession:
            return 0
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        echo_history_render(result and before and marker)
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given error:
        set error to echo_failure(error)
        if marker == window.echoHistoryMarker && query.session == window.echoSession:
            set older.disabled to false
            echo_note("Conversation batch could not be loaded: " + error)
    )
    return 0

# Render one message per animation frame so a batch yields to browser input.
define echo_history_render with result and before and marker:
    set transcript to document.getElementById("transcript")
    set older to document.getElementById("history-older")
    set welcome to document.getElementById("welcome")
    set session_label to document.getElementById("session-label")
    set workspace to document.getElementById("workspace")
    set previous_height to workspace.scrollHeight
    set previous_top to workspace.scrollTop
    set batch to Array()
    set index to 0
    set draw to given ignored:
        if marker != window.echoHistoryMarker:
            return 0
        if index < result.messages.length:
            batch.push(echo_render_message(get_list(result.messages and index)))
            set index to index + 1
            window.requestAnimationFrame(draw)
            return 0
        if before != "0":
            set window.echoFollowLatest to false
        echo_commit_messages(transcript and batch and before)
        if before == "0" && result.revision:
            set window.echoRenderedRevision to window.echoSession + ":" + result.revision
        set window.echoHistoryCursor to result.next_before
        set older.hidden to not result.older_possible
        set older.disabled to false
        set welcome.hidden to transcript.childElementCount > 0
        set session_label.textContent to "Current conversation"
        if window.echoGroup:
            set session_label.textContent to "Shared · " + window.echoGroup
        if before != "0":
            set workspace.scrollTop to previous_top + workspace.scrollHeight - previous_height
        else if window.echoQuestionRequest:
            set question_panel to document.getElementById("echo-interaction")
            if question_panel:
                set question_scroll to Object()
                set question_scroll.block to "start"
                question_panel.scrollIntoView(question_scroll)
        else if window.echoFollowLatest:
            echo_follow_latest()
        else:
            set workspace.scrollTop to previous_top
    window.requestAnimationFrame(draw)
    return 0

# Read the committed active checkpoint, so the completion notice survives refresh.
# This fetch never changes the selected context or any original source record.
define echo_recap_notice with marker:
    set notice to document.getElementById("recap-notice")
    if notice:
        set notice.hidden to true
    if not window.echoSession:
        return 0
    set query to Object()
    set query.session to window.echoSession
    set query.arguments to "{\"checkpoint\":\"\",\"section\":\"summary\",\"offset\":0,\"characters\":1}"
    set loaded to echo_api("/api/compaction" and query).then(given result:
        if marker != window.echoHistoryMarker || query.session != window.echoSession:
            return 0
        if result.status != "found" || (result.active != "true" && result.active != true):
            return 0
        set notice to document.getElementById("recap-notice")
        if not notice:
            set notice to document.createElement("aside")
            set notice.id to "recap-notice"
            set label to document.createElement("span")
            set label.textContent to "Conversation condensed — originals preserved"
            notice.appendChild(label)
            set recap to document.createElement("button")
            set recap.type to "button"
            set recap.textContent to "Read recap"
            recap.addEventListener("click" and echo_open_recap)
            notice.appendChild(recap)
            set originals to document.createElement("button")
            set originals.type to "button"
            set originals.textContent to "Browse original messages"
            originals.addEventListener("click" and given ignored:
                set window.echoFollowLatest to false
                set workspace to document.getElementById("workspace")
                set workspace.scrollTop to 0
                document.getElementById("transcript").focus()
            )
            notice.appendChild(originals)
            set transcript to document.getElementById("transcript")
            transcript.setAttribute("tabindex" and "-1")
            transcript.parentNode.insertBefore(notice and transcript)
        set notice.hidden to false
        notice.setAttribute("data-checkpoint" and result.checkpoint)
        return 0
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given error:
        set error to echo_failure(error)
        # Leave the notice hidden when its saved state cannot be verified.
        return 0
    )
    return 0

define echo_history:
    if window.echoTranscriptSession != window.echoSession || window.echoTranscriptWritable != window.echoGroupWritable:
        set transcript to document.getElementById("transcript")
        set transcript.textContent to ""
        set window.echoTranscriptSession to window.echoSession
        set window.echoTranscriptWritable to window.echoGroupWritable
        echo_math_cancel_all()
    echo_attachments()
    set window.echoHistoryMarker to window.crypto.randomUUID()
    echo_recap_notice(window.echoHistoryMarker)
    if not window.echoSession:
        return 0
    return echo_history_page("0" and window.echoHistoryMarker)

define echo_open_session with session:
    if (window.echoBusy && not window.echoAutonomy) || window.echoUploading:
        echo_note("Wait for the current run before changing conversations.")
        return 0
    if not window.echoReadOnly && window.localStorage.getItem("echo.pending"):
        echo_note("Resolve the interrupted submission before changing conversations.")
        return 0
    set window.echoFollowLatest to true
    set window.echoGroup to session.group || ""
    set window.echoGroupWritable to not session.group || session.writable == true
    window.localStorage.setItem("echo.group" and window.echoGroup)
    set window.echoSession to session.session
    set input to document.getElementById("message")
    set input.value to window.localStorage.getItem("echo.composer:" + session.session) || ""
    document.getElementById("history-sidebar").setAttribute("data-open" and "false")
    set navigation to document.getElementById("nav-toggle")
    if navigation:
        navigation.setAttribute("aria-expanded" and "false")
    set window.echoRetryWorker to ""
    echo_interaction_clear()
    set window.echoRun to session.run
    window.localStorage.setItem("echo.session" and session.session)
    window.localStorage.setItem("echo.run" and session.run)
    echo_busy(true)
    echo_sessions()
    echo_history()
    echo_poll()
    if not session.run:
        echo_busy(false)
    echo_group_watch_start()
    return 0

define echo_session_rename with session:
    set container to document.createElement("div")
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Rename"
    button.setAttribute("aria-label" and "Rename conversation: " + session.title)
    set button.disabled to window.echoReadOnly
    set editor to document.createElement("div")
    set editor.hidden to true
    set input to document.createElement("input")
    set input.type to "text"
    set input.value to session.title
    input.setAttribute("aria-label" and "Conversation name")
    set save to document.createElement("button")
    set save.type to "button"
    set save.textContent to "Save name"
    set cancel to document.createElement("button")
    set cancel.type to "button"
    set cancel.textContent to "Cancel rename"
    editor.appendChild(input)
    editor.appendChild(save)
    editor.appendChild(cancel)
    container.appendChild(button)
    container.appendChild(editor)
    button.addEventListener("click" and given event:
        set editor.hidden to false
        set button.hidden to true
        input.focus()
        input.select()
    )
    cancel.addEventListener("click" and given event:
        set editor.hidden to true
        set button.hidden to false
        set input.value to session.title
        button.focus()
    )
    save.addEventListener("click" and given event:
        set title to input.value.trim()
        if title.length == 0:
            echo_note("Enter a conversation name.")
            input.focus()
            return 0
        set query to Object()
        set query.session to session.session
        set query.previous to session.title
        set query.title to title
        set save.disabled to true
        set cancel.disabled to true
        set changed to echo_api("/api/session-rename" and query).then(given result:
            echo_sessions()
            echo_note("Conversation renamed.")
        )
        set catcher to get_list(changed and "catch")
        catcher.call(changed and given error:
            set error to echo_failure(error)
            echo_sessions()
            echo_note("Rename failed: " + error + ". Conversation names refreshed.")
        )
    )
    return container

define echo_session_button with session:
    set button to document.createElement("button")
    set button.type to "button"
    set title to document.createElement("span")
    set title.textContent to session.title
    if session.autonomy:
        set title.textContent to session.title + " · Autonomy"
    button.appendChild(title)
    set button.className to "session-choice"
    if session.session == window.echoSession:
        button.setAttribute("aria-current" and "page")
    button.addEventListener("click" and given event:
        echo_open_session(session)
    )
    return button

define echo_sessions:
    echo_autonomy_refresh()
    set query to Object()
    set search to document.getElementById("session-search")
    set query.query to search.value
    set window.echoSearchRequest to (window.echoSearchRequest || 0) + 1
    set identity to window.echoSearchRequest
    set loaded to echo_api("/api/sessions" and query).then(given result:
        if identity != window.echoSearchRequest:
            return 0
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        echo_sessions_render(result)
    )
    echo_catch(loaded)
    return 0


define echo_sessions_render with result:
    set signature to JSON.stringify(result.sessions)
    if signature == window.echoSessionListSignature:
        return 0
    set window.echoSessionListSignature to signature
    set list to document.getElementById("sessions")
    set list.textContent to ""
    for each session in result.sessions:
        set row to document.createElement("div")
        row.appendChild(echo_session_button(session))
        row.appendChild(echo_session_rename(session))
        list.appendChild(row)
    if result.sessions.length == 0:
        set list.textContent to "No conversations match in your account."
    return 0

define echo_thinking_panel with run:
    if not window.echoTracePanels:
        set window.echoTracePanels to Reflect.construct(Map and Array())
    if window.echoTracePanels.has(run):
        return window.echoTracePanels.get(run)
    set panel to document.createElement("details")
    set panel.className to "thinking"
    set title to document.createElement("summary")
    set title.textContent to "Thinking · actions, tools and model traces"
    set note to document.createElement("p")
    set note.textContent to "Model traces and tool activity from this reply."
    set log to document.createElement("div")
    set log.className to "thinking-log"
    set panel.echoLog to log
    set panel.echoCursor to 0
    set panel.echoRun to run
    panel.appendChild(title)
    panel.appendChild(note)
    panel.appendChild(log)
    panel.addEventListener("toggle" and given ignored:
        if panel.open:
            echo_trace_load(panel)
    )
    set cache to get_list(window.echoTracePanels and "set")
    cache.call(window.echoTracePanels and run and panel)
    return panel

define echo_trace_load with panel:
    if panel.echoLoading:
        return 0
    set log to panel.echoLog
    set query to Object()
    set query.run to panel.echoRun
    set query.after to panel.echoCursor
    set query.events to 100
    set panel.echoLoading to true
    set loaded to echo_api("/api/trace" and query).then(given result:
        set panel.echoLoading to false
        if result.status != "found":
            return 0
        set follow_log to log.scrollHeight - log.scrollTop - log.clientHeight < 80
        for each entry in result.entries:
            if entry.kind == "user_guidance":
                set receiptKey to "echo.guidance.receipt:" + panel.echoRun
                set receipt to JSON.parse(window.localStorage.getItem(receiptKey) || "null")
                if receipt && entry.event == receipt.run + ":guidance:" + receipt.identity + ":applied":
                    set receipt.phase to "applied"
                    window.localStorage.setItem(receiptKey and JSON.stringify(receipt))
                    echo_guidance_clear(receipt)
                    if panel.echoRun == window.echoRun:
                        echo_queue_render()
            if entry.kind == "model_reasoning" && panel.echoReasoning:
                set panel.echoReasoning.textContent to panel.echoReasoning.textContent + entry.text
                continue
            set panel.echoReasoning to null
            set block to document.createElement("div")
            set label to document.createElement("strong")
            set label.textContent to entry.kind.replaceAll("_" and " ")
            set text to document.createElement("pre")
            set text.textContent to entry.text
            if entry.kind == "model_reasoning":
                set panel.echoReasoning to text
            block.appendChild(label)
            block.appendChild(text)
            log.appendChild(block)
        set panel.echoCursor to result.after
        if follow_log:
            set log.scrollTop to log.scrollHeight
        if result.more:
            window.setTimeout(given ignored:
                echo_trace_load(panel)
            and 0)
        return 0
    )
    set failed to get_list(loaded and "catch")
    failed.call(loaded and given error:
        set error to echo_failure(error)
        set panel.echoLoading to false
    )
    return 0

define echo_trace_clear_floating:
    set draft to document.getElementById("draft")
    if draft && draft.parentNode:
        for each panel in draft.parentNode.querySelectorAll(":scope > .thinking"):
            if panel.echoRun != window.echoRun:
                panel.remove()
    return 0

define echo_trace_refresh:
    echo_trace_clear_floating()
    if not window.echoRun:
        return 0
    set panel to echo_thinking_panel(window.echoRun)
    if not panel.isConnected:
        set draft to document.getElementById("draft")
        draft.parentNode.insertBefore(panel and draft)
    echo_trace_load(panel)
    return 0

define echo_poll:
    echo_trace_refresh()
    if window.echoReadOnly:
        echo_note("Restored archive: you can read and export. Tasks stay stopped until restored work is checked.")
        echo_busy(false)
        return 0
    if window.localStorage.getItem("echo.pending"):
        echo_note("Submission interrupted. Send again to recover the same message and selected files.")
        return 0
    if not window.echoRun:
        return 0
    set query to Object()
    set query.run to window.echoRun
    set loaded to echo_api("/api/run" and query).then(given result:
        if query.run != window.echoRun:
            return 0
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        echo_interaction_render(result)
        if result.autonomy && window.echoAutonomyEvent != result.event:
            set window.echoAutonomyEvent to result.event
            echo_history()
        set window.echoCompactionUnknownRun to ""
        set window.echoCanStop to result.can_control != false && result.state != "completed" && result.state != "cancelled" && result.state != "failed"
        set window.echoRetryWorker to ""
        if result.retry_allowed && result.can_control != false:
            set window.echoRetryWorker to result.worker
        if result.state == "completed":
            echo_clear_draft()
            echo_note("Saved on this Mac.")
            echo_history()
            set window.echoQueueReadyRun to query.run
            echo_busy(false)
            echo_queue_next()
        else if result.state == "cancelled" or else result.state == "failed":
            echo_clear_draft()
            if result.state == "cancelled":
                echo_note("Stopped. Any received partial output remains in the archive.")
            else:
                echo_note(String(echo_failure(result.failure || result.text)))
            echo_history()
            set window.echoQueueReadyRun to query.run
            echo_busy(false)
            set queued to echo_queue_read()
            if queued.length > 0 && get_list(queued and 0).steer_run == query.run:
                echo_queue_next()
        else if result.worker_status != "running" && result.worker_status != "not-started":
            echo_note(String(echo_failure(result.worker_feedback || result.worker_status)))
            if result.retry_allowed && result.can_control != false:
                echo_note(String(echo_failure(result.worker_feedback || result.worker_status)) + " Retry resumes this task from saved work.")
            echo_history()
            echo_busy(false)
        else:
            if result.user_input:
                echo_note("Waiting for your answers. You can also steer or stop this task.")
            else:
                echo_compaction_progress(result)
            echo_busy(true)
            if result.state == "generating":
                return echo_draft().then(given ignored:
                    window.setTimeout(echo_poll and 500)
                )
            echo_clear_draft()
            window.setTimeout(echo_poll and 500)
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given error:
        set error to echo_failure(error)
        if query.run != window.echoRun:
            return 0
        if window.echoCompactionActivity || window.echoCompactionUnknownRun == query.run:
            set window.echoCompactionUnknownRun to query.run
            echo_note("Reconnecting — compaction status unknown. Original records remain saved. " + error)
            echo_busy(true)
        else:
            echo_error(error)
        if window.echoToken && not window.echoReadOnly:
            window.setTimeout(echo_poll and 3000)
        return 0
    )
    return 0

define echo_clear_draft:
    set window.echoDraftGeneration to ""
    set window.echoDraftCursor to 0
    set window.echoDraftText to ""
    set draft to document.getElementById("draft")
    set draft.hidden to true
    set text to document.getElementById("draft-text")
    set text.textContent to ""
    return 0

define echo_draft:
    set run to window.echoRun
    set query to Object()
    set query.run to run
    set query.generation to window.echoDraftGeneration || ""
    set query.after to window.echoDraftCursor || 0
    return echo_api("/api/progress" and query).then(given result:
        if run != window.echoRun:
            return 0
        if result.status == "idle":
            echo_clear_draft()
            return 0
        if result.status != "draft":
            return Promise.reject(echo_failure(result))
        set text to document.getElementById("draft-text")
        if result.generation != window.echoDraftGeneration:
            set window.echoDraftText to ""
        set window.echoDraftGeneration to result.generation
        set window.echoDraftCursor to result.after
        set window.echoDraftText to (window.echoDraftText || "") + result.text
        # Keep an incomplete tool-protocol prefix out of the user reply while
        # its provider representation is being validated. The raw trace remains archived.
        set visible to window.echoDraftText.trimStart()
        set protocol to "<tool_call>"
        if visible && (protocol.startsWith(visible) || visible.startsWith(protocol)):
            set text.textContent to ""
        else:
            echo_format_response(text and window.echoDraftText)
        set draft to document.getElementById("draft")
        set draft.hidden to not text.textContent
        echo_follow_latest()
        return 0
    )

# A saved shared submission always returns to its recorded group and segment.
# Provider selection belongs to private chats until shared-provider policy exists.
define echo_submit_payload with payload:
    if payload.group:
        return echo_api("/api/group-submit" and payload)
    return echo_api("/api/runs" and payload)

# Reuse the durable submission identity to reconcile a lost response. Never
# discard a newer composer draft or invent a second submission for old work.
define echo_reconcile_pending:
    set pending to window.localStorage.getItem("echo.pending")
    if not pending:
        return Promise.resolve(null)
    set saved to JSON.parse(pending)
    echo_busy(true)
    echo_note("Checking the earlier submission; your new draft is kept…")
    return echo_submit_payload(saved).then(given result:
        if result.status != "accepted":
            return Promise.reject(echo_failure(result))
        set input to document.getElementById("message")
        window.localStorage.removeItem("echo.composer:" + (saved.session || "new"))
        if input.value == saved.message:
            set input.value to ""
        set window.echoGroup to saved.group || ""
        window.localStorage.setItem("echo.group" and window.echoGroup)
        set window.echoSession to result.session
        set window.echoRun to result.run
        window.localStorage.setItem("echo.session" and result.session)
        window.localStorage.setItem("echo.run" and result.run)
        window.localStorage.setItem("echo.composer:" + result.session and input.value)
        window.localStorage.removeItem("echo.pending")
        echo_outbox_render()
        echo_history()
        echo_sessions()
        echo_group_watch_start()
        set query to Object()
        set query.run to result.run
        return echo_api("/api/run" and query)
    )

define echo_send with event:
    event.preventDefault()
    if window.echoGroup && not window.echoGroupWritable:
        echo_note("This group segment is not currently writable. Your draft is kept; open the current membership explicitly to continue.")
        return 0
    set command to document.getElementById("message").value.trim()
    if command == "/autoOff":
        echo_autonomy_command(false)
        return 0
    if (command == "/auto" || command.startsWith("/auto ") || command.startsWith("/auto\n") || command.startsWith("/auto\t")) && window.echoBusy:
        echo_autonomy_command(true)
        return 0
    if window.echoBusy && window.echoAutonomy:
        return echo_guidance_send(false)
    if window.echoBusy:
        return echo_queue_add(false)
    set input to document.getElementById("message")
    set text to input.value
    if not text.trim():
        return 0
    set pending to window.localStorage.getItem("echo.pending")
    set payload to Object()
    if pending:
        set payload to JSON.parse(pending)
        if payload.message != text:
            set recovered to echo_reconcile_pending().then(given previous:
                if previous.state == "completed" || previous.state == "cancelled" || previous.state == "failed":
                    echo_busy(false)
                    echo_send(event)
                else:
                    echo_note("Earlier work is still running. Your new draft is saved; send it when that work finishes.")
                    echo_poll()
            )
            echo_catch(recovered)
            return 0
    else:
        set payload.submission to window.crypto.randomUUID()
        set payload.message to text
        set payload.session to window.echoSession || ""
        set payload.attachments to echo_selected_files()
        if window.echoGroup:
            set payload.group to window.echoGroup
        set picker to document.getElementById("provider-picker")
        if picker && picker.value && not window.echoGroup:
            set payload.provider to picker.value
        window.localStorage.setItem("echo.pending" and JSON.stringify(payload))
    set window.echoFollowLatest to true
    echo_busy(true)
    echo_note("Saving your message…")
    set sent to echo_submit_payload(payload).then(given result:
        if result.status == "session-active" && window.echoSession:
            window.localStorage.removeItem("echo.pending")
            echo_queue_add(false)
            echo_linked_session_watch()
            return 0
        if result.status != "accepted":
            return Promise.reject(echo_failure(result))
        set window.echoSession to result.session
        set window.echoRun to result.run
        window.localStorage.setItem("echo.session" and result.session)
        window.localStorage.setItem("echo.run" and result.run)
        window.localStorage.removeItem("echo.pending")
        echo_outbox_render()
        window.localStorage.removeItem("echo.files:" + result.session)
        window.localStorage.removeItem("echo.composer:" + (payload.session || "new"))
        window.localStorage.removeItem("echo.composer:" + result.session)
        if input.value == payload.message:
            set input.value to ""
        window.localStorage.setItem("echo.composer:" + result.session and input.value)
        echo_sessions()
        echo_history()
        echo_poll()
    )
    echo_catch(sent)
    return 0

define echo_new_chat with event:
    echo_math_cancel_all()
    if (window.echoBusy && not window.echoAutonomy) || window.echoUploading:
        return 0
    document.getElementById("history-sidebar").setAttribute("data-open" and "false")
    set navigation to document.getElementById("nav-toggle")
    if navigation:
        navigation.setAttribute("aria-expanded" and "false")
    if not window.echoReadOnly && window.localStorage.getItem("echo.pending"):
        echo_note("Resolve the interrupted submission before starting a new conversation.")
        return 0
    set window.echoGroup to ""
    window.localStorage.removeItem("echo.group")
    echo_group_watch_start()
    set window.echoSession to ""
    set input to document.getElementById("message")
    set input.value to window.localStorage.getItem("echo.composer:new") || ""
    set window.echoHistoryMarker to window.crypto.randomUUID()
    echo_recap_notice(window.echoHistoryMarker)
    set older to document.getElementById("history-older")
    set older.hidden to true
    echo_attachments()
    echo_sessions()
    set window.echoRetryWorker to ""
    echo_busy(false)
    echo_clear_draft()
    echo_interaction_clear()
    set window.echoRun to ""
    echo_trace_clear_floating()
    window.localStorage.removeItem("echo.session")
    window.localStorage.removeItem("echo.run")
    set transcript to document.getElementById("transcript")
    set transcript.textContent to ""
    set welcome to document.getElementById("welcome")
    set welcome.hidden to false
    set session_label to document.getElementById("session-label")
    set session_label.textContent to "New conversation"
    set window.echoCanStop to false
    echo_busy(false)
    echo_note("Ready for a new conversation.")
    return 0

define echo_stop with event:
    if not window.echoRun:
        return 0
    set query to Object()
    set query.run to window.echoRun
    set requested to echo_api("/api/cancel" and query).then(given result:
        echo_note("Stop requested. Waiting for the worker to finish cancelling.")
        echo_poll()
    )
    set catcher to get_list(requested and "catch")
    catcher.call(requested and given error:
        set error to echo_failure(error)
        echo_steer_status("Could not confirm the stop: " + String(error) + ". Your correction stays queued. Click Steer now to retry.")
        echo_error(error)
    )
    return 0

define echo_retry with event:
    if window.echoBusy || not window.echoRun || not window.echoRetryWorker:
        return 0
    set query to Object()
    set query.run to window.echoRun
    set query.worker to window.echoRetryWorker
    echo_busy(true)
    echo_note("Resuming saved work…")
    set retried to echo_api("/api/retry" and query).then(given result:
        echo_poll()
    )
    set catcher to get_list(retried and "catch")
    catcher.call(retried and given error:
        set error to echo_failure(error)
        echo_poll()
    )
    return 0

define echo_pair with event:
    event.preventDefault()
    set invitation to document.getElementById("invitation")
    set name to document.getElementById("device-name")
    set window.echoToken to invitation.value.trim()
    set payload to Object()
    set payload.name to name.value.trim()
    set paired to echo_api("/api/pair" and payload).then(given result:
        window.localStorage.setItem("echo.credential" and result.token)
        window.localStorage.setItem("echo.device" and result.device)
        set invitation.value to ""
        # A new identity must not inherit the previous identity's selected work.
        window.localStorage.removeItem("echo.session")
        window.localStorage.removeItem("echo.group")
        window.localStorage.removeItem("echo.run")
        window.localStorage.removeItem("echo.pending")
        window.localStorage.removeItem("echo.session-create")
        window.location.reload()
    )
    set catcher to get_list(paired and "catch")
    catcher.call(paired and given error:
        set error to echo_failure(error)
        set window.echoToken to ""
        echo_error(error)
    )
    return 0

define echo_export:
    if not window.echoToken || not window.echoSession:
        echo_note("Select a conversation to export.")
        return 0
    set query to Object()
    set query.session to window.echoSession
    set downloaded to echo_api("/api/export" and query).then(given result:
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        set parts to Array()
        parts.push(JSON.stringify(result and null and 2))
        set options to Object()
        set options.type to "application/json;charset=utf-8"
        set arguments to Array()
        arguments.push(parts)
        arguments.push(options)
        set blob to Reflect.construct(Blob and arguments)
        set url to URL.createObjectURL(blob)
        set link to document.createElement("a")
        set link.href to url
        set link.download to "Echo-conversation.json"
        document.body.appendChild(link)
        link.click()
        link.remove()
        window.setTimeout(given ignored:
            URL.revokeObjectURL(url)
        and 1000)
        echo_note("Conversation export prepared. It includes original messages and recorded tool and compaction history.")
    )
    echo_catch(downloaded)
    return 0

define echo_verified_attachment with file:
    set options to Object()
    set options.method to "POST"
    set headers to Object()
    set setter to get_list(Reflect and "set")
    setter.call(Reflect and headers and "Content-Type" and "application/json")
    setter.call(Reflect and headers and "X-Echo-Token" and window.echoToken)
    set options.headers to headers
    set query to Object()
    set query.attachment to file.attachment
    set options.body to JSON.stringify(query)
    return window.fetch("/api/attachment-download" and options).then(given response:
        if not response.ok:
            return Promise.reject("File download failed: " + response.status)
        return response.arrayBuffer()
    ).then(given bytes:
        if String(bytes.byteLength) != file.bytes:
            return Promise.reject("File length does not match its saved record.")
        return window.crypto.subtle.digest("SHA-256" and bytes).then(given digest:
            set arguments to Array()
            arguments.push(digest)
            set values to Reflect.construct(Uint8Array and arguments)
            set actual to ""
            for each value in values:
                set actual to actual + value.toString(16).padStart(2 and "0")
            if actual != file.sha256:
                return Promise.reject("File integrity check failed. File was not opened.")
            return bytes
        )
    )

define echo_download_attachment with file:
    echo_note("Downloading and checking " + file.name + "…")
    set downloaded to echo_verified_attachment(file).then(given bytes:
        set parts to Array()
        parts.push(bytes)
        set options to Object()
        set options.type to "application/octet-stream"
        set arguments to Array()
        arguments.push(parts)
        arguments.push(options)
        set blob to Reflect.construct(Blob and arguments)
        set url to URL.createObjectURL(blob)
        set link to document.createElement("a")
        set link.href to url
        set link.download to file.name
        document.body.appendChild(link)
        link.click()
        link.remove()
        window.setTimeout(given ignored:
            URL.revokeObjectURL(url)
        and 1000)
        echo_note("Verified " + file.name + " against its saved SHA-256 record.")
    )
    set catcher to get_list(downloaded and "catch")
    catcher.call(downloaded and given error:
        set error to echo_failure(error)
        echo_note("Download failed: " + error)
    )
    return 0

define echo_image_supported with file:
    return file.media_type == "image/svg+xml" || file.media_type == "image/png" || file.media_type == "image/jpeg" || file.media_type == "image/webp" || file.media_type == "image/gif"

define echo_release_image:
    for each player in document.querySelectorAll("#source-panel audio, #source-panel video"):
        player.pause()
        player.removeAttribute("src")
        player.load()
    if window.echoImageURL:
        URL.revokeObjectURL(window.echoImageURL)
        set window.echoImageURL to ""
    return 0

define echo_open_attachment with file:
    if file.media_type.slice(0 and 6) == "audio/" || file.media_type.slice(0 and 6) == "video/":
        return echo_preview_audio(file)
    if echo_image_supported(file):
        return echo_preview_image(file)
    return echo_open_source(file)

# Browser playback uses verified local original bytes and never autoplay.
define echo_preview_audio with file:
    set kind to "audio"
    if file.media_type.slice(0 and 6) == "video/":
        set kind to "video"
    echo_release_image()
    set marker to Object()
    set window.echoSourceRequest to marker
    set panel to document.getElementById("source-panel")
    set panel.textContent to ""
    set panel.hidden to false
    set title to document.createElement("h3")
    set title.textContent to file.name
    panel.appendChild(title)
    set status to document.createElement("p")
    set status.textContent to "Checking original " + kind + " bytes…"
    panel.appendChild(status)
    set close_button to document.createElement("button")
    set close_button.type to "button"
    set close_button.textContent to "Close " + kind
    close_button.addEventListener("click" and given ignored:
        set window.echoSourceRequest to null
        echo_release_image()
        set panel.hidden to true
    )
    panel.appendChild(close_button)
    set parts to null
    set options to null
    set arguments to null
    set blob to null
    set player to null
    set loaded to echo_verified_attachment(file).then(given bytes:
        if window.echoSourceRequest != marker:
            return 0
        set parts to Array()
        parts.push(bytes)
        set options to Object()
        set options.type to file.media_type
        set arguments to Array()
        arguments.push(parts)
        arguments.push(options)
        set blob to Reflect.construct(Blob and arguments)
        set window.echoImageURL to URL.createObjectURL(blob)
        set player to document.createElement(kind)
        set player.controls to true
        set player.preload to "metadata"
        if kind == "video":
            set player.style.maxWidth to "100%"
            set player.style.display to "block"
            player.setAttribute("playsinline" and "")
        player.setAttribute("aria-label" and "Original recording: " + file.name)
        player.addEventListener("loadedmetadata" and given ignored:
            if window.echoSourceRequest == marker:
                set status.textContent to "Original source " + file.event + " · SHA-256 " + file.sha256 + " · " + player.duration + " seconds. Speech recognition may differ from this recording."
                if kind == "video":
                    set status.textContent to "Original video · " + player.duration + " seconds · " + player.videoWidth + " × " + player.videoHeight + " · Source " + file.event + " · SHA-256 " + file.sha256 + ". Playback is the original; any frames Echo samples are separate observations, not the whole video."
                    set picker to document.getElementById("attachment-file").closest("details")
                    if picker:
                        set picker.open to false
                    set player.style.scrollMarginTop to "5rem"
                    set preview_scroll to Object()
                    set preview_scroll.block to "start"
                    player.scrollIntoView(preview_scroll)
        )
        player.addEventListener("error" and given ignored:
            if window.echoSourceRequest == marker:
                set status.textContent to "The saved bytes are intact, but this browser cannot decode the " + kind + ". You can download the original."
        )
        set player.src to window.echoImageURL
        if kind == "video":
            panel.insertBefore(player and close_button)
        else:
            panel.appendChild(player)
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given error:
        set error to echo_failure(error)
        if window.echoSourceRequest == marker:
            set status.textContent to kind + " preview failed: " + error + ". Download the original or retry opening it."
    )
    return 0

define echo_preview_image with file:
    if not echo_image_supported(file):
        return 0
    echo_release_image()
    set marker to Object()
    set window.echoSourceRequest to marker
    set panel to document.getElementById("source-panel")
    set panel.textContent to ""
    set panel.hidden to false
    set title to document.createElement("h3")
    set title.textContent to file.name
    panel.appendChild(title)
    set status to document.createElement("p")
    set status.textContent to "Checking original image bytes…"
    panel.appendChild(status)
    set close to document.createElement("button")
    set close.type to "button"
    set close.textContent to "Close image"
    close.addEventListener("click" and given ignored:
        set window.echoSourceRequest to null
        echo_release_image()
        set panel.hidden to true
    )
    panel.appendChild(close)
    set loaded to echo_verified_attachment(file).then(given bytes:
        if window.echoSourceRequest != marker:
            return 0
        set parts to Array()
        parts.push(bytes)
        set options to Object()
        set options.type to file.media_type
        set arguments to Array()
        arguments.push(parts)
        arguments.push(options)
        set blob to Reflect.construct(Blob and arguments)
        set url to URL.createObjectURL(blob)
        set window.echoImageURL to url
        set picture to document.createElement("img")
        set picture.alt to "Verified uploaded image: " + file.name
        set picture.style.maxWidth to "100%"
        set picture.style.height to "auto"
        picture.addEventListener("load" and given ignored:
            if window.echoSourceRequest == marker:
                set status.textContent to "Source " + file.event + " · SHA-256 " + file.sha256 + " · " + picture.naturalWidth + " × " + picture.naturalHeight
        )
        picture.addEventListener("error" and given ignored:
            if window.echoSourceRequest == marker:
                set status.textContent to "The saved bytes are intact, but the browser could not decode this image. Download the original and open it in an application that supports its format."
                echo_release_image()
                picture.remove()
        )
        set picture.src to url
        panel.appendChild(picture)
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given error:
        set error to echo_failure(error)
        if window.echoSourceRequest == marker:
            set status.textContent to "Image preview failed: " + error
    )
    return 0

define echo_read_source with file:
    set marker to Object()
    set window.echoSourceRequest to marker
    set output to document.getElementById("source-text")
    set citation to document.getElementById("source-citation")
    set next to document.getElementById("source-next")
    set next.disabled to true
    set output.textContent to "Reading and verifying…"
    set citation.textContent to ""
    set loaded to Promise.resolve().then(given ignored:
        set offset to BigInt(document.getElementById("source-offset").value)
        set characters to BigInt(document.getElementById("source-count").value)
        if offset < BigInt(0) || characters < BigInt(1):
            return Promise.reject("Choose a nonnegative offset and a positive character count.")
        set options to Object()
        set options.method to "POST"
        set headers to Object()
        set setter to get_list(Reflect and "set")
        setter.call(Reflect and headers and "Content-Type" and "application/json")
        setter.call(Reflect and headers and "X-Echo-Token" and window.echoToken)
        set options.headers to headers
        set options.body to "{\"attachment\":" + JSON.stringify(file.attachment) + ",\"offset\":" + offset.toString() + ",\"characters\":" + characters.toString() + "}"
        if file.media_type == "application/pdf":
            set page to BigInt(document.getElementById("source-page").value) - BigInt(1)
            if page < BigInt(0):
                return Promise.reject("Page must be one or greater.")
            set options.body to options.body.slice(0 and -1) + ",\"page\":" + page.toString() + "}"
        return window.fetch("/api/attachment-text" and options).then(given response:
            return response.json().then(given result:
                if not response.ok || result.status != "found":
                    return Promise.reject(echo_failure(result))
                return result
            )
        )
    ).then(given result:
        if window.echoSourceRequest != marker:
            return 0
        set output.textContent to result.text
        set citation.textContent to "Source " + result.event + " · offset " + result.offset + " · characters " + result.characters + " · SHA-256 " + result.sha256
        if result.representation == "pdfkit-page-text":
            set citation.textContent to citation.textContent + " · Extracted PDF text · page " + (BigInt(result.page) + BigInt(1)).toString() + " of " + result.pages
        set window.echoSourceNext to (BigInt(result.offset) + BigInt(result.characters)).toString()
        set next.disabled to result.characters == "0"
        if result.characters == "0":
            set output.textContent to "End of file."
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given error:
        set error to echo_failure(error)
        if window.echoSourceRequest == marker:
            set output.textContent to "Cannot display this text range: " + error
    )
    return 0

define echo_open_source with file:
    echo_release_image()
    set panel to document.getElementById("source-panel")
    set panel.textContent to ""
    set panel.hidden to false
    set title to document.createElement("h3")
    set title.textContent to file.name
    panel.appendChild(title)
    set form to document.createElement("form")
    if file.media_type == "application/pdf":
        set page_label to document.createElement("label")
        set page_label.textContent to "PDF page"
        set page_input to document.createElement("input")
        set page_input.id to "source-page"
        set page_input.inputMode to "numeric"
        set page_input.value to "1"
        page_input.addEventListener("change" and given ignored:
            set start_field to document.getElementById("source-offset")
            set start_field.value to "0"
        )
        page_label.appendChild(page_input)
        form.appendChild(page_label)
    set offset_label to document.createElement("label")
    set offset_label.textContent to "Starting character (zero-based)"
    set offset to document.createElement("input")
    set offset.id to "source-offset"
    set offset.inputMode to "numeric"
    set offset.value to "0"
    offset_label.appendChild(offset)
    form.appendChild(offset_label)
    set count_label to document.createElement("label")
    set count_label.textContent to "Characters to read (editable page size)"
    set count to document.createElement("input")
    set count.id to "source-count"
    set count.inputMode to "numeric"
    set count.value to "1000"
    count_label.appendChild(count)
    form.appendChild(count_label)
    set read to document.createElement("button")
    set read.type to "submit"
    set read.textContent to "Read range"
    form.appendChild(read)
    form.addEventListener("submit" and given event:
        event.preventDefault()
        echo_read_source(file)
    )
    panel.appendChild(form)
    set next to document.createElement("button")
    set next.id to "source-next"
    set next.type to "button"
    set next.textContent to "Next range"
    next.addEventListener("click" and given ignored:
        set offset.value to window.echoSourceNext
        echo_read_source(file)
    )
    panel.appendChild(next)
    set close to document.createElement("button")
    set close.type to "button"
    set close.textContent to "Close source"
    close.addEventListener("click" and given ignored:
        set window.echoSourceRequest to null
        set panel.hidden to true
    )
    panel.appendChild(close)
    set citation to document.createElement("p")
    set citation.id to "source-citation"
    set citation.style.overflowWrap to "anywhere"
    panel.appendChild(citation)
    set text to document.createElement("pre")
    set text.id to "source-text"
    set text.style.whiteSpace to "pre-wrap"
    set text.style.overflowWrap to "anywhere"
    panel.appendChild(text)
    if file.observation:
        set offset.value to file.offset
        set count.value to file.characters
        if file.page != "":
            set page_field to document.getElementById("source-page")
            set page_field.value to (BigInt(file.page) + BigInt(1)).toString()
    echo_read_source(file)
    return 0

define echo_selected_files:
    set pending to window.localStorage.getItem("echo.pending")
    if pending:
        set saved to JSON.parse(pending)
        if saved.session == window.echoSession:
            return saved.attachments || Array()
    set stored to window.localStorage.getItem("echo.files:" + window.echoSession)
    if stored:
        return JSON.parse(stored)
    return Array()

define echo_file_choice with file:
    set choice_label to document.createElement("label")
    set file_checkbox to document.createElement("input")
    set file_checkbox.type to "checkbox"
    set file_checkbox.className to "attachment-file_checkbox"
    file_checkbox.setAttribute("aria-label" and "Include " + file.name + " in next message")
    set file_checkbox.checked to echo_selected_files().includes(file.attachment)
    set file_checkbox.disabled to window.echoBusy || window.echoUploading || window.echoReadOnly || not (not window.localStorage.getItem("echo.pending"))
    file_checkbox.addEventListener("change" and given ignored:
        if window.echoBusy || window.echoReadOnly || window.localStorage.getItem("echo.pending"):
            set file_checkbox.checked to echo_selected_files().includes(file.attachment)
            return 0
        set selected to echo_selected_files().filter(given identity:
            return identity != file.attachment
        )
        if file_checkbox.checked:
            selected.push(file.attachment)
        window.localStorage.setItem("echo.files:" + window.echoSession and JSON.stringify(selected))
        echo_pending_attachments()
    )
    choice_label.appendChild(file_checkbox)
    return choice_label

define echo_attachments:
    set selected to null
    set trash to null
    set trash_title to null
    set trash_note to null
    set trash_item to null
    echo_release_image()
    set window.echoSourceRequest to null
    set panel to document.getElementById("source-panel")
    set panel.hidden to true
    set list to document.getElementById("attachment-list")
    set list.textContent to ""
    set status to document.getElementById("attachment-status")
    set window.echoAttachmentFiles to Array()
    echo_pending_attachments()
    if not window.echoSession:
        set status.textContent to "Choose files, drop them here, or paste an image into your message."
        return 0
    set status.textContent to "Select files for your next message. Text uses archive tools; images require a vision-capable model."
    if window.echoReadOnly:
        set status.textContent to "Files recovered from your backup. Downloads verify the saved file hash."
    set query to Object()
    set query.session to window.echoSession
    set loaded to echo_api("/api/attachments" and query).then(given result:
        if query.session != window.echoSession:
            return 0
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        set list.textContent to ""
        set window.echoAttachmentFiles to result.attachments
        set selected to echo_selected_files().filter(given identity:
            return not result.attachments.some(given file:
                return file.attachment == identity && file.lifecycle && file.lifecycle.state == "trashed"
            )
        )
        window.localStorage.setItem("echo.files:" + window.echoSession and JSON.stringify(selected))
        set trash to document.createElement("details")
        set trash_title to document.createElement("summary")
        set trash_title.textContent to "Attachment trash and hidden files"
        trash.appendChild(trash_title)
        set trash_note to document.createElement("p")
        set trash_note.textContent to "Trash prevents attaching a file to new messages across linked devices. Shared-file changes affect its current shared conversation. Originals, earlier messages and recall stay available. Restore returns the file to the picker; Forget automatic use keeps the original available for explicit rereading and does not erase history."
        trash.appendChild(trash_note)
        echo_pending_attachments()
        set hidden to JSON.parse(window.localStorage.getItem("echo.hidden-files:" + window.echoSession) || "[]")
        for each file in result.attachments:
            if (file.lifecycle && file.lifecycle.state == "trashed") || hidden.includes(file.attachment):
                set trash_item to document.createElement("div")
                set trash_item.textContent to file.name + " "
                if file.lifecycle && file.lifecycle.state == "trashed":
                    trash_item.appendChild(echo_attachment_lifecycle_button(file and "restore"))
                else:
                    trash_item.appendChild(echo_restore_legacy_attachment(file))
                trash_item.appendChild(echo_attachment_visibility_control(file))
                trash.appendChild(trash_item)
                continue
            set item to document.createElement("li")
            set item.textContent to file.name + " · " + file.bytes + " bytes"
            if not file.inherited_exclusion && (not file.visibility || file.visibility.state != "excluded"):
                item.appendChild(echo_file_choice(file))
            if echo_image_supported(file):
                item.appendChild(echo_attachment_thumbnail(file))
            item.appendChild(echo_remove_attachment(file and item))
            item.appendChild(echo_attachment_visibility_control(file))
            set download to document.createElement("button")
            set download.type to "button"
            set download.textContent to "Download"
            download.addEventListener("click" and given ignored:
                echo_download_attachment(file)
            )
            item.appendChild(download)
            set read to document.createElement("button")
            set read.type to "button"
            set read.textContent to "Open"
            if echo_image_supported(file):
                set read.textContent to "Open image"
            if file.media_type.slice(0 and 6) == "audio/":
                set read.textContent to "Play audio"
            read.addEventListener("click" and given ignored:
                echo_open_attachment(file)
            )
            item.appendChild(read)
            list.appendChild(item)
        list.appendChild(trash)
    )
    echo_catch(loaded)
    return 0

define echo_ensure_session:
    if window.echoSession:
        return Promise.resolve(window.echoSession)
    set identity to window.localStorage.getItem("echo.session-create")
    if not identity:
        set identity to window.crypto.randomUUID()
        window.localStorage.setItem("echo.session-create" and identity)
    set query to Object()
    set query.identity to identity
    return echo_api("/api/session-create" and query).then(given result:
        if result.status != "accepted":
            return Promise.reject(echo_failure(result))
        set window.echoSession to result.session
        window.localStorage.setItem("echo.session" and result.session)
        window.localStorage.removeItem("echo.session-create")
        echo_sessions()
        return result.session
    )

define echo_upload_file with event:
    set input to document.getElementById("attachment-file")
    return echo_upload_files(input.files)

# One upload protocol for chosen, pasted and dropped original files. The batch
# holds the UI busy, so changing conversation cannot redirect later files.
define echo_upload_one with file:
    set payload to Object()
    set payload.session to window.echoSession
    set payload.name to file.name
    set payload.media_type to file.type || "application/octet-stream"
    set status to document.getElementById("attachment-status")
    set status.textContent to "Uploading " + file.name + "…"
    return echo_ensure_session().then(given session:
        set payload.session to session
        return echo_api("/api/upload-prepare" and payload)
    ).then(given prepared:
        if prepared.status != "prepared":
            return Promise.reject(echo_failure(prepared))
        return echo_upload_prepared(file and prepared.upload)
    ).then(given result:
        set selected to echo_selected_files()
        if not selected.includes(result.attachment):
            selected.push(result.attachment)
        window.localStorage.setItem("echo.files:" + window.echoSession and JSON.stringify(selected))
        echo_attachments()
        set status.textContent to "Attached " + file.name + ". Ready to send."
        return result
    )

define echo_upload_prepared with file and identity:
    set options to Object()
    set options.method to "POST"
    set headers to Object()
    set setter to get_list(Reflect and "set")
    setter.call(Reflect and headers and "Content-Type" and "application/octet-stream")
    setter.call(Reflect and headers and "X-Echo-Token" and window.echoToken)
    setter.call(Reflect and headers and "X-Echo-Upload" and identity)
    set options.headers to headers
    set options.body to file
    return window.fetch("/api/upload-body" and options).then(given response:
        return response.json().then(given result:
            if not response.ok || result.status != "complete":
                return Promise.reject(echo_failure(result))
            set result.attachment to identity
            return result
        )
    )

define echo_upload_files with originals:
    set input to document.getElementById("attachment-file")
    set status to document.getElementById("attachment-status")
    if window.echoBusy || window.echoUploading || window.echoReadOnly || not window.echoToken || originals.length == 0:
        echo_note("Wait for the current task or upload to finish before attaching files.")
        return 0
    set files to Array()
    for each file in originals:
        files.push(file)
    set window.echoUploading to true
    echo_busy(window.echoBusy)
    set uploaded to Promise.resolve()
    for each file in files:
        set uploaded to uploaded.then(given ignored:
            return echo_upload_one(file)
        )
    set uploaded to uploaded.then(given ignored:
        set input.value to ""
        set window.echoUploading to false
        echo_busy(window.echoBusy)
    )
    set catcher to get_list(uploaded and "catch")
    catcher.call(uploaded and given error:
        set error to echo_failure(error)
        set status.textContent to "Upload did not confirm completion: " + error
        set input.value to ""
        set window.echoUploading to false
        echo_busy(window.echoBusy)
    )
    return 0

define echo_drag_files with event:
    set has_files to false
    if event.dataTransfer:
        for each kind in event.dataTransfer.types:
            if kind == "Files":
                set has_files to true
    if has_files:
        event.preventDefault()
        set event.dataTransfer.dropEffect to "copy"

define echo_drop_files with event:
    if event.dataTransfer && event.dataTransfer.files.length > 0:
        event.preventDefault()
        echo_upload_files(event.dataTransfer.files)

define echo_paste_files with event:
    if event.clipboardData && event.clipboardData.files.length > 0:
        event.preventDefault()
        set pasted_text to event.clipboardData.getData("text/plain")
        if pasted_text:
            set composer to document.getElementById("message")
            composer.setRangeText(pasted_text and composer.selectionStart and composer.selectionEnd and "end")
        echo_upload_files(event.clipboardData.files)

define echo_attachment_inputs:
    set workspace to document.getElementById("workspace")
    workspace.addEventListener("dragover" and echo_drag_files)
    workspace.addEventListener("drop" and echo_drop_files)
    document.getElementById("message").addEventListener("paste" and echo_paste_files)

# Formatting foundation adapted from ErnosDecent decent_web/app.ep.
define escapeHTML with str:
    if not str:
        return ""
    set reClass to get_list(window and "RegExp")
    set reAmp to Reflect.construct(reClass and ["&", "g"])
    set reLt to Reflect.construct(reClass and ["<", "g"])
    set reGt to Reflect.construct(reClass and [">", "g"])
    set reQuot to Reflect.construct(reClass and ["\"", "g"])
    set reApos to Reflect.construct(reClass and ["'", "g"])
    set res to str.replace(reAmp and "&amp;").replace(reLt and "&lt;").replace(reGt and "&gt;").replace(reQuot and "&quot;").replace(reApos and "&#039;")
    return res

# Inline formatting is applied only after HTML escaping.  The replacement tags are
# fixed strings, so model output cannot introduce executable markup or attributes.
define renderAiInlineMarkdown with text:
    set reClass to get_list(window and "RegExp")
    set reCode to Reflect.construct(reClass and ["(`[^`\\n]+`|\\\\\\([\\s\\S]*?\\\\\\)|\\\\\\[[\\s\\S]*?\\\\\\]|\\$\\$[\\s\\S]*?\\$\\$)", "g"])
    set reBold to Reflect.construct(reClass and ["\\*\\*([^*\\n]+)\\*\\*", "g"])
    set reItalic to Reflect.construct(reClass and ["(^|[^*])\\*([^*\\n]+)\\*", "g"])
    set pieces to text.split(reCode)
    set safe to ""
    set index to 0
    for each piece in pieces:
        if index % 2 == 1:
            if piece.slice(0 and 1) == "`":
                set safe to safe + "<code>" + escapeHTML(piece.slice(1 and -1)) + "</code>"
            else:
                set safe to safe + "<span class='echo-equation'>" + escapeHTML(piece) + "</span>"
        else:
            set safe to safe + escapeHTML(piece).replace(reBold and "<strong>$1</strong>").replace(reItalic and "$1<em>$2</em>")
        set index to index + 1
    return safe

# Tables retain literal escaped pipes and escape all cell content before styling.
define echo_table_cells with line:
    set cells to Array()
    set cell to ""
    set index to 0
    set separator to false
    repeat while index < line.length:
        set character to line.charAt(index)
        if character == "\\" && index + 1 < line.length:
            set next to line.charAt(index + 1)
            if next == "|" || next == "\\":
                set cell to cell + next
                set index to index + 2
                continue
        if character == "|":
            cells.push(cell.trim())
            set cell to ""
            set separator to true
        else:
            set cell to cell + character
        set index to index + 1
    cells.push(cell.trim())
    if not separator:
        return Array()
    if get_list(cells and 0) == "":
        cells.shift()
    if get_list(cells and cells.length - 1) == "":
        cells.pop()
    return cells

define echo_table_row with cells and alignments and heading:
    set html to "<tr>"
    set index to 0
    repeat while index < alignments.length:
        set tag to "td"
        if heading:
            set tag to "th"
        set content to get_list(cells and index) || ""
        set html to html + "<" + tag + " class='align-" + get_list(alignments and index) + "'>" + renderAiInlineMarkdown(content) + "</" + tag + ">"
        set index to index + 1
    return html + "</tr>"

define echo_markdown_table with lines and start:
    set result to Object()
    set result.html to ""
    set result.next to start
    if start + 1 >= lines.length:
        return result
    set headings to echo_table_cells(get_list(lines and start).trim())
    set delimiters to echo_table_cells(get_list(lines and start + 1).trim())
    if headings.length == 0 || headings.length != delimiters.length:
        return result
    set reClass to get_list(window and "RegExp")
    set delimiter to Reflect.construct(reClass and ["^:?-{3,}:?$", ""])
    set alignments to Array()
    for each cell in delimiters:
        if not delimiter.test(cell):
            return result
        set alignment to "left"
        if cell.endsWith(":"):
            set alignment to "right"
            if cell.startsWith(":"):
                set alignment to "center"
        alignments.push(alignment)
    set html to "<div class='table-scroll'><table><thead>" + echo_table_row(headings and alignments and true) + "</thead><tbody>"
    set index to start + 2
    repeat while index < lines.length:
        set cells to echo_table_cells(get_list(lines and index).trim())
        if cells.length == 0:
            break
        set html to html + echo_table_row(cells and alignments and false)
        set index to index + 1
    set result.html to html + "</tbody></table></div>"
    set result.next to index
    return result

# Render the Markdown subset Echo uses in normal replies. Raw HTML is always escaped;
# headings, lists, quotations, fenced code, emphasis and inline code are then added
# from fixed templates. This keeps formatting readable without trusting model HTML.
define renderAiMarkdown with inputText:
    set text to inputText
    set lines to text.split("\n")
    set lineCount to get_list(lines and "length")
    set reClass to get_list(window and "RegExp")
    set orderedPrefix to Reflect.construct(reClass and ["^[0-9]+[.)][ \\t]+", ""])
    set html to ""
    set inUnorderedList to false
    set inOrderedList to false
    set inCodeBlock to false
    set inMathBlock to false
    set mathEnd to ""
    set i to 0
    repeat while i < lineCount:
        set line to get_list(lines and i)
        set trimmed to line.trim()

        if inMathBlock:
            set html to html + escapeHTML(line) + "\n"
            if trimmed == mathEnd:
                set html to html + "</div>"
                set inMathBlock to false
        else if inCodeBlock:
            if trimmed.slice(0 and 3) == "```":
                set html to concat(html and "</code></pre>")
                set inCodeBlock to false
            else:
                set html to concat(html and concat(escapeHTML(line) and "\n"))
        else if trimmed == "$$" || trimmed == "\\[":
            if inUnorderedList:
                set html to html + "</ul>"
                set inUnorderedList to false
            if inOrderedList:
                set html to html + "</ol>"
                set inOrderedList to false
            set inMathBlock to true
            set mathEnd to "$$"
            if trimmed == "\\[":
                set mathEnd to "\\]"
            set html to html + "<div class='math-source'>" + escapeHTML(line) + "\n"
        else if trimmed.slice(0 and 3) == "```":
            if inUnorderedList:
                set html to concat(html and "</ul>")
                set inUnorderedList to false
            if inOrderedList:
                set html to concat(html and "</ol>")
                set inOrderedList to false
            set language to escapeHTML(trimmed.slice(3).trim())
            set html to html + "<pre data-language='" + language + "'><code>"
            set inCodeBlock to true
        else if string_length(trimmed) == 0:
            if inUnorderedList:
                set html to concat(html and "</ul>")
                set inUnorderedList to false
            if inOrderedList:
                set html to concat(html and "</ol>")
                set inOrderedList to false
        else:
            set table to echo_markdown_table(lines and i)
            if table.html:
                if inUnorderedList:
                    set html to html + "</ul>"
                    set inUnorderedList to false
                if inOrderedList:
                    set html to html + "</ol>"
                    set inOrderedList to false
                set html to html + table.html
                set i to table.next
                continue
            set isBullet to trimmed.slice(0 and 2) == "* " || trimmed.slice(0 and 2) == "- " || trimmed.slice(0 and 2) == "+ "
            set orderedMatch to trimmed.match(orderedPrefix)
            set isOrdered to orderedMatch && get_list(orderedMatch and "length") > 0

            if isBullet:
                if inOrderedList:
                    set html to concat(html and "</ol>")
                    set inOrderedList to false
                if not inUnorderedList:
                    set html to concat(html and "<ul>")
                    set inUnorderedList to true
                set itemText to trimmed.slice(2).trim()
                set html to concat(html and concat("<li>" and concat(renderAiInlineMarkdown(itemText) and "</li>")))
            else if isOrdered:
                if inUnorderedList:
                    set html to concat(html and "</ul>")
                    set inUnorderedList to false
                if not inOrderedList:
                    set html to concat(html and "<ol>")
                    set inOrderedList to true
                set itemText to trimmed.replace(orderedPrefix and "")
                set html to concat(html and concat("<li>" and concat(renderAiInlineMarkdown(itemText) and "</li>")))
            else:
                if inUnorderedList:
                    set html to concat(html and "</ul>")
                    set inUnorderedList to false
                if inOrderedList:
                    set html to concat(html and "</ol>")
                    set inOrderedList to false
                if trimmed.slice(0 and 4) == "### ":
                    set html to concat(html and concat("<h3>" and concat(renderAiInlineMarkdown(trimmed.slice(4)) and "</h3>")))
                else if trimmed.slice(0 and 3) == "## ":
                    set html to concat(html and concat("<h2>" and concat(renderAiInlineMarkdown(trimmed.slice(3)) and "</h2>")))
                else if trimmed.slice(0 and 2) == "# ":
                    set html to concat(html and concat("<h1>" and concat(renderAiInlineMarkdown(trimmed.slice(2)) and "</h1>")))
                else if trimmed.slice(0 and 2) == "> ":
                    set html to concat(html and concat("<blockquote>" and concat(renderAiInlineMarkdown(trimmed.slice(2)) and "</blockquote>")))
                else if trimmed == "---" || trimmed == "***" || trimmed == "___":
                    set html to concat(html and "<hr>")
                else:
                    set html to concat(html and concat("<p>" and concat(renderAiInlineMarkdown(trimmed) and "</p>")))
        set i to i + 1

    if inUnorderedList:
        set html to concat(html and "</ul>")
    if inOrderedList:
        set html to concat(html and "</ol>")
    if inCodeBlock:
        set html to concat(html and "</code></pre>")
    if inMathBlock:
        set html to html + "</div>"
    return html


define echo_open_recap:
    if not window.echoSession:
        echo_note("Open a conversation to inspect its saved recap.")
        return 0
    set session to window.echoSession
    set panel to document.getElementById("source-panel")
    set panel.hidden to false
    set panel.textContent to ""
    set heading to document.createElement("h2")
    set heading.textContent to "Saved conversation recap"
    panel.appendChild(heading)
    set description to document.createElement("p")
    set description.textContent to "The recap is a fallible summary. Original conversation records remain available. Read its summary, structured state or validation references."
    panel.appendChild(description)
    set identity_label to document.createElement("label")
    set identity to document.createElement("input")
    set identity_label.textContent to "Checkpoint ID (blank selects active recap) "
    identity_label.appendChild(identity)
    panel.appendChild(identity_label)
    set section_label to document.createElement("label")
    set section to document.createElement("select")
    set section_label.textContent to "Recap section "
    for each name in Array("summary" and "state" and "validation"):
        set option to document.createElement("option")
        set option.value to name
        set option.textContent to name
        section.appendChild(option)
    section_label.appendChild(section)
    panel.appendChild(section_label)
    set offset_label to document.createElement("label")
    set offset to document.createElement("input")
    set offset_label.textContent to "Starting character (zero-based) "
    set offset.value to "0"
    set offset.inputMode to "numeric"
    offset_label.appendChild(offset)
    panel.appendChild(offset_label)
    set count_label to document.createElement("label")
    set count to document.createElement("input")
    set count_label.textContent to "Characters to read (editable page size) "
    set count.value to "4096"
    set count.inputMode to "numeric"
    count_label.appendChild(count)
    panel.appendChild(count_label)
    set citation to document.createElement("p")
    set output to document.createElement("pre")
    set output.style.whiteSpace to "pre-wrap"
    set read to document.createElement("button")
    set read.type to "button"
    set read.textContent to "Read recap range"
    set next to document.createElement("button")
    set next.type to "button"
    set next.textContent to "Next recap range"
    set next.disabled to true
    set previous to document.createElement("button")
    set previous.type to "button"
    set previous.textContent to "Previous recap"
    set previous.disabled to true
    set current to Object()
    set load to given event:
        set marker to Object()
        set window.echoSourceRequest to marker
        set next.disabled to true
        set previous.disabled to true
        set output.textContent to "Reading saved recap…"
        set loaded to Promise.resolve().then(given ignored:
            set start to BigInt(offset.value)
            set amount to BigInt(count.value)
            if start < BigInt(0) || amount < BigInt(1):
                return Promise.reject("Choose a nonnegative offset and positive character count.")
            set query to Object()
            set query.session to session
            set query.arguments to "{\"checkpoint\":" + JSON.stringify(identity.value) + ",\"section\":" + JSON.stringify(section.value) + ",\"offset\":" + start.toString() + ",\"characters\":" + amount.toString() + "}"
            return echo_api("/api/compaction" and query)
        ).then(given result:
            if window.echoSourceRequest != marker || window.echoSession != session:
                return 0
            if result.status == "end":
                set output.textContent to "No saved recap was found. This conversation may still be using its original history."
                set citation.textContent to ""
                return 0
            if result.status != "found":
                return Promise.reject(echo_failure(result))
            set current.result to result
            set identity.value to result.checkpoint
            set output.textContent to result.text
            set citation.textContent to "Checkpoint " + result.checkpoint + " · active: " + result.active + " · source endpoint: " + result.source_end + " · source digest: " + result.source_digest + " · characters " + result.offset + "–" + result.next_offset + " of " + result.total_characters
            set next.disabled to BigInt(result.next_offset) >= BigInt(result.total_characters)
            set previous.disabled to not result.previous
        )
        set catcher to get_list(loaded and "catch")
        catcher.call(loaded and given error:
            set error to echo_failure(error)
            if window.echoSourceRequest == marker:
                set output.textContent to "Cannot read saved recap: " + error
        )
    read.addEventListener("click" and load)
    next.addEventListener("click" and given event:
        set offset.value to current.result.next_offset
        load()
    )
    previous.addEventListener("click" and given event:
        set identity.value to current.result.previous
        set offset.value to "0"
        load()
    )
    section.addEventListener("change" and given event:
        set offset.value to "0"
        load()
    )
    set close to document.createElement("button")
    set close.type to "button"
    set close.textContent to "Close recap"
    close.addEventListener("click" and given event:
        set window.echoSourceRequest to Object()
        set panel.hidden to true
    )
    panel.appendChild(read)
    panel.appendChild(next)
    panel.appendChild(previous)
    panel.appendChild(close)
    panel.appendChild(citation)
    panel.appendChild(output)
    load()
    return 0

define echo_theme_apply:
    set preference to window.localStorage.getItem("echo.theme") || "system"
    set dark to window.matchMedia("(prefers-color-scheme: dark)").matches
    set selected to "light"
    if preference == "dark" or else (preference != "light" && dark):
        set selected to "dark"
    document.documentElement.setAttribute("data-theme" and selected)

define echo_theme_setup:
    echo_theme_apply()
    set label to document.createElement("label")
    set label.className to "theme-control"
    set label.textContent to "Appearance"
    set picker to document.createElement("select")
    set picker.id to "appearance"
    picker.setAttribute("aria-label" and "Appearance")
    for each name in Array("system" and "light" and "dark"):
        set option to document.createElement("option")
        set option.value to name
        set option.textContent to name
        picker.appendChild(option)
    set picker.value to window.localStorage.getItem("echo.theme") || "system"
    picker.addEventListener("change" and given event:
        window.localStorage.setItem("echo.theme" and picker.value)
        echo_theme_apply()
    )
    label.appendChild(picker)
    document.querySelector("header").appendChild(label)
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change" and given event:
        echo_theme_apply()
    )

define echo_suggestion with label and prompt and container:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to label
    button.addEventListener("click" and given event:
        set composer to document.getElementById("message")
        if not composer.disabled:
            set composer.value to prompt
            composer.focus()
    )
    container.appendChild(button)
    return 0

define echo_polish_layout:
    set header to document.querySelector("header")
    set navigation to document.createElement("button")
    set navigation.id to "nav-toggle"
    set navigation.type to "button"
    set navigation.textContent to "☰"
    navigation.setAttribute("aria-label" and "Toggle conversations")
    navigation.setAttribute("aria-expanded" and "false")
    set sidebar to document.getElementById("history-sidebar")
    navigation.addEventListener("click" and given event:
        set opened to sidebar.getAttribute("data-open") != "true"
        sidebar.setAttribute("data-open" and String(opened))
        navigation.setAttribute("aria-expanded" and String(opened))
    )
    header.prepend(navigation)
    set menu to document.createElement("details")
    set menu.className to "header-options"
    set summary to document.createElement("summary")
    set summary.textContent to "Options"
    menu.appendChild(summary)
    set contents to document.createElement("div")
    for each button in header.querySelectorAll("button"):
        if button.id != "nav-toggle":
            contents.appendChild(button)
    contents.appendChild(header.querySelector(".theme-control"))
    contents.appendChild(document.getElementById("history-page-size").parentNode.parentNode)
    set access to document.createElement("p")
    set access.id to "browser-access"
    set access.style.overflowWrap to "anywhere"
    set access.style.fontSize to "12px"
    set access.textContent to "Open Options to check this browser’s access."
    contents.appendChild(access)
    echo_device_links_setup(contents)
    menu.addEventListener("toggle" and given event:
        if menu.open:
            echo_show_identity(access)
    )
    menu.appendChild(contents)
    header.appendChild(menu)
    set link_shortcut to document.createElement("button")
    set link_shortcut.type to "button"
    set link_shortcut.textContent to "Link devices"
    link_shortcut.addEventListener("click" and given event:
        set menu.open to true
        set link_panel to document.getElementById("device-link-panel")
        set link_panel.open to true
        document.getElementById("device-link-code").focus()
    )
    header.appendChild(link_shortcut)
    set tools to document.createElement("details")
    set tools.className to "tools-drawer"
    set summary to document.createElement("summary")
    set summary.textContent to "＋ Files & voice"
    tools.appendChild(summary)
    set tool_content to document.createElement("div")
    set tool_content.className to "tools-content"
    tool_content.appendChild(document.getElementById("attachment-file").parentNode)
    tool_content.appendChild(document.getElementById("attachment-status"))
    tool_content.appendChild(document.getElementById("attachment-list"))
    tool_content.appendChild(document.getElementById("audio-panel"))
    tools.appendChild(tool_content)
    document.getElementById("composer").prepend(tools)
    set welcome to document.getElementById("welcome")
    set welcome.innerHTML to "<span class='welcome-mark' aria-hidden='true'>◉</span><h1>What’s on your mind?</h1><p>A little space to think, create, and make things happen.</p>"
    set suggestions to document.createElement("div")
    set suggestions.className to "suggestions"
    echo_suggestion("Build something" and "Help me build " and suggestions)
    echo_suggestion("Think it through" and "Help me think through " and suggestions)
    echo_suggestion("Explore an idea" and "I’d like to explore " and suggestions)
    welcome.appendChild(suggestions)
    set search to document.getElementById("session-search")
    set search.placeholder to "Search conversations"
    set message to document.getElementById("message")
    set message.placeholder to "Message Echo…"
    return 0

# Refresh on opening Options so grants and revocation are not stale UI claims.
define echo_show_identity with target:
    set target.textContent to "Checking this browser’s access…"
    set pending to echo_api("/api/identity" and Object()).then(given result:
        if result.status != "observed":
            set target.textContent to "Access could not be verified."
            return 0
        set target.textContent to "Access: " + result.role + " · Account ID: " + result.device
        if result.authority == "legacy-sandbox":
            set target.textContent to target.textContent + " · Host enrolment is not installed yet."
    )
    set catcher to get_list(pending and "catch")
    catcher.call(pending and given error:
        set error to echo_failure(error)
        set target.textContent to "Access check failed: " + String(error)
    )
    return 0

define main:
    window.setInterval(echo_linked_session_watch and 3000)
    window.setInterval(echo_autonomy_refresh and 3000)
    document.addEventListener("visibilitychange" and given event:
        if document.visibilityState == "visible":
            echo_linked_session_watch()
    )
    window.addEventListener("focus" and given event:
        echo_linked_session_watch()
    )
    echo_playback_setup()
    set window.echoFollowLatest to true
    set workspace to document.getElementById("workspace")
    set workspace.style.scrollBehavior to "auto"
    workspace.addEventListener("scroll" and given event:
        set window.echoFollowLatest to workspace.scrollHeight - workspace.scrollTop - workspace.clientHeight < 80
    )
    set on_resize to given entries:
        echo_follow_latest()
    set resize_observer to Reflect.construct(ResizeObserver and [on_resize])
    resize_observer.observe(document.getElementById("transcript"))
    resize_observer.observe(document.getElementById("draft"))
    echo_theme_setup()
    set history_controls to document.createElement("div")
    set history_label to document.createElement("label")
    set history_label.textContent to "Messages per batch (older messages remain saved)"
    set history_size to document.createElement("input")
    set history_size.id to "history-page-size"
    set history_size.type to "number"
    set history_size.min to "1"
    set history_size.value to "20"
    history_size.addEventListener("change" and given event:
        echo_history()
    )
    history_label.appendChild(history_size)
    history_controls.appendChild(history_label)
    set older to document.createElement("button")
    set older.id to "history-older"
    set older.type to "button"
    set older.textContent to "Load older messages"
    set older.hidden to true
    older.addEventListener("click" and given event:
        echo_history_page(window.echoHistoryCursor and window.echoHistoryMarker)
    )
    history_controls.appendChild(older)
    set transcript to document.getElementById("transcript")
    transcript.parentNode.insertBefore(history_controls and transcript)
    set window.echoUploading to false
    set window.echoBusy to false
    set window.echoRetryWorker to ""
    set window.echoToken to window.localStorage.getItem("echo.credential") || ""
    set window.echoGroup to window.localStorage.getItem("echo.group") || ""
    set window.echoGroupWritable to not window.echoGroup
    set window.echoSession to window.localStorage.getItem("echo.session") || ""
    set window.echoRun to window.localStorage.getItem("echo.run") || ""
    set input to document.getElementById("message")
    set input.value to window.localStorage.getItem("echo.composer:" + (window.echoSession || "new")) || ""
    input.addEventListener("input" and given event:
        window.localStorage.setItem("echo.composer:" + (window.echoSession || "new") and input.value)
        echo_guidance_render()
    )
    set form to document.getElementById("composer")
    form.addEventListener("submit" and echo_send)
    input.addEventListener("keydown" and given event:
        if event.key == "Enter" && not event.shiftKey && not event.isComposing && event.keyCode != 229:
            event.preventDefault()
            if not event.repeat:
                echo_send(event)
    )
    echo_queue_setup()
    set fresh to document.getElementById("new-chat")
    fresh.addEventListener("click" and echo_new_chat)
    set stop_button to document.getElementById("stop")
    stop_button.addEventListener("click" and echo_stop)
    set revision_button to document.createElement("button")
    set revision_button.id to "resume-revision"
    set revision_button.type to "button"
    set revision_button.textContent to "Resume interrupted revision"
    set revision_button.hidden to true
    fresh.parentNode.appendChild(revision_button)
    revision_button.addEventListener("click" and given event:
        set pending to window.localStorage.getItem("echo.revision.pending")
        if not pending:
            echo_busy(window.echoBusy)
            return 0
        set saved to JSON.parse(pending)
        set message to Object()
        set message.source_session to saved.source
        set message.user_event to saved.user_event
        echo_revision_start(message and saved.mode and saved.text)
    )
    set retry_button to document.createElement("button")
    set retry_button.id to "retry"
    set retry_button.type to "button"
    set retry_button.textContent to "Retry run"
    set retry_button.hidden to true
    retry_button.addEventListener("click" and echo_retry)
    stop_button.parentNode.insertBefore(retry_button and stop_button)
    set export_button to document.createElement("button")
    set export_button.id to "export-session"
    set export_button.type to "button"
    set export_button.textContent to "Export conversation"
    export_button.addEventListener("click" and echo_export)
    fresh.parentNode.insertBefore(export_button and fresh)
    set recap_button to document.createElement("button")
    set recap_button.type to "button"
    set recap_button.textContent to "Inspect recap"
    recap_button.addEventListener("click" and echo_open_recap)
    fresh.parentNode.insertBefore(recap_button and fresh)
    document.getElementById("history-sidebar").prepend(fresh)
    set source_panel to document.createElement("section")
    set source_panel.id to "source-panel"
    set source_panel.hidden to true
    form.parentNode.insertBefore(source_panel and form)
    set attachment_label to document.createElement("label")
    set attachment_label.textContent to "Attach a file to this conversation"
    set attachment_input to document.createElement("input")
    set attachment_input.id to "attachment-file"
    set attachment_input.type to "file"
    set attachment_input.multiple to true
    attachment_input.addEventListener("change" and echo_upload_file)
    attachment_label.appendChild(attachment_input)
    form.parentNode.insertBefore(attachment_label and form)
    set attachment_status to document.createElement("p")
    set attachment_status.id to "attachment-status"
    attachment_status.setAttribute("role" and "status")
    set attachment_status.textContent to "Choose files, drop them here, or paste an image into your message."
    form.parentNode.insertBefore(attachment_status and form)
    set attachment_list to document.createElement("ul")
    set attachment_list.id to "attachment-list"
    attachment_list.setAttribute("aria-label" and "Conversation files")
    form.parentNode.insertBefore(attachment_list and form)
    echo_attachment_inputs()
    echo_audio_controls_setup()
    set search_form to document.createElement("form")
    set search_label to document.createElement("label")
    set search_label.textContent to "Search conversations (exact text)"
    set search to document.createElement("input")
    set search.id to "session-search"
    set search.type to "search"
    search_label.appendChild(search)
    search_form.appendChild(search_label)
    set search_button to document.createElement("button")
    set search_button.type to "submit"
    set search_button.textContent to "Search"
    search_form.appendChild(search_button)
    search_form.addEventListener("submit" and given event:
        event.preventDefault()
        if window.echoToken:
            echo_sessions()
    )
    set sessions to document.getElementById("sessions")
    sessions.parentNode.insertBefore(search_form and sessions)
    set pairing_form to document.getElementById("pair-form")
    pairing_form.addEventListener("submit" and echo_pair)
    echo_polish_layout()
    echo_settings_setup()
    echo_sidebar_dismiss_setup()
    echo_agents_setup()
    echo_busy(true)
    set request to window.fetch("/api/bootstrap").then(given response:
        if not response.ok:
            return Promise.reject("Chat service is not configured")
        return response.json()
    )
    set started to request.then(given config:
        if config.provider:
            echo_provider_details(config.provider)
        set window.echoReadOnly to config.read_only == true
        set connection to document.getElementById("connection")
        set connection.textContent to "Local service connected"
        if window.echoReadOnly:
            set connection.textContent to "Restored archive · Read only"
        set model to document.getElementById("model")
        set model_parts to config.model.split("/")
        set model.textContent to get_list(model_parts and model_parts.length - 1)
        if config.model == "fixture" or else config.model == "fixture-model":
            set model.textContent to "Fixture — scripted test provider"
        set pairing to document.getElementById("pairing")
        set pairing.hidden to not (not window.echoToken)
        if not window.echoToken:
            echo_note("Pair this browser using an invitation from the host Mac.")
            echo_busy(true)
            return 0
        echo_busy(false)
        set pending to window.localStorage.getItem("echo.pending")
        if pending && not window.echoReadOnly:
            set saved to JSON.parse(pending)
            set window.echoSession to saved.session || ""
            set input to document.getElementById("message")
            set input.value to window.localStorage.getItem("echo.composer:" + (saved.session || "new")) || saved.message
            set recovered to echo_reconcile_pending().then(given previous:
                echo_poll()
            )
            echo_catch(recovered)
        else:
            echo_note("Ready. Original messages and tool results are retained.")
        echo_history()
        echo_poll()
        echo_sessions()
        echo_projects_setup()
        echo_work_setup()
        echo_groups_setup()
        echo_groups_refresh()
        echo_outbox_setup()
        echo_group_watch_start()
        if not window.echoReadOnly:
            echo_provider_picker()
    )
    set catcher to get_list(started and "catch")
    catcher.call(started and given error:
        set error to echo_failure(error)
        set connection to document.getElementById("connection")
        set connection.textContent to "Chat service unavailable. Check the connection to the host Mac; reopen Options when it is reachable."
        echo_note("Chat is not configured or the local service is unavailable. No model response is being simulated.")
        echo_busy(true)
    )
    return 0

define echo_capability_label with value:
    if value == true:
        return "Supported"
    if value == false:
        return "Unsupported"
    return "Unknown"

define echo_provider_picker:
    set label to null
    set picker to null
    set previous to ""
    set pending to ""
    set default_choice to ""
    set option to null
    set workspace to null
    set loaded to echo_api("/api/providers" and Object()).then(given result:
        if not result.providers.length:
            return 0
        set label to document.createElement("label")
        set label.textContent to "Model for the next message "
        set picker to document.createElement("select")
        set picker.id to "provider-picker"
        set previous to window.localStorage.getItem("echo.provider") || ""
        set pending to window.localStorage.getItem("echo.pending")
        if pending:
            set previous to JSON.parse(pending).provider || ""
        set default_choice to ""
        for each provider in result.providers:
            set option to document.createElement("option")
            set option.value to provider.identity
            set option.textContent to provider.label
            picker.appendChild(option)
            if provider.default == 1:
                set default_choice to provider.identity
        if default_choice:
            set picker.value to default_choice
        for each provider in result.providers:
            if provider.identity == previous:
                set picker.value to previous
        picker.addEventListener("change" and given event:
            window.localStorage.setItem("echo.provider" and picker.value)
            echo_provider_refresh(picker.value)
        )
        set picker.disabled to window.echoBusy || window.echoUploading || not (not pending)
        label.appendChild(picker)
        set workspace to document.getElementById("provider-controls")
        workspace.appendChild(label)
        echo_provider_refresh(picker.value)
        return 0
    )
    echo_catch(loaded)
    return 0

define echo_provider_details with provider:
    set details to document.getElementById("provider-details")
    if not details:
        set details to document.createElement("details")
        set details.id to "provider-details"
        set workspace to document.getElementById("provider-controls")
        workspace.appendChild(details)
    set details.textContent to ""
    set heading to document.createElement("summary")
    set heading.textContent to "Selected model capabilities"
    details.appendChild(heading)
    set description to document.createElement("p")
    set supported to "Unknown"
    if provider.supported_context != null:
        set supported to String(provider.supported_context)
    set loaded to "Not reported by this runtime"
    if provider.loaded_context != null:
        set loaded to String(provider.loaded_context)
    set description.textContent to provider.adapter + " · " + provider.status + ". Supported context: " + supported + " tokens. Loaded context: " + loaded + "."
    details.appendChild(description)
    set modalities to document.createElement("p")
    set modalities.textContent to "Runtime media support — images: " + echo_capability_label(provider.vision) + "; video: " + echo_capability_label(provider.video) + "; audio: " + echo_capability_label(provider.audio) + ". Echo processing routes are qualified separately."
    details.appendChild(modalities)
    set research to document.createElement("p")
    set research.textContent to "Web research: " + provider.research + ". Output allowance: " + provider.output_policy + "."
    details.appendChild(research)
    return 0

define echo_provider_refresh with identity:
    set window.echoProviderDetailsIdentity to identity
    set details to document.getElementById("provider-details")
    if details:
        set details.textContent to "Checking selected model…"
    set query to Object()
    set query.identity to identity
    set model to document.getElementById("model")
    set request to echo_api("/api/providers" and query).then(given result:
        if window.echoProviderDetailsIdentity != identity:
            return 0
        set model.textContent to result.label
        echo_provider_details(result.provider)
        return 0
    )
    set catcher to get_list(request and "catch")
    catcher.call(request and given error:
        set error to echo_failure(error)
        if window.echoProviderDetailsIdentity == identity && details:
            set details.textContent to "Selected model details unavailable: " + error
    )
    return 0

# Shared conversation selection, explicit invitations and membership controls.
define echo_group_action with path and payload and button:
    if window.echoReadOnly || window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
        echo_note("Finish or resolve the current submission before changing groups.")
        return Promise.resolve(null)
    set button.disabled to true
    set request to echo_api(path and payload).then(given result:
        echo_groups_refresh()
        set button.disabled to false
        echo_note("Group updated. Open the group to use its current membership.")
        return result
    )
    set catcher to get_list(request and "catch")
    catcher.call(request and given error:
        set error to echo_failure(error)
        set button.disabled to false
        echo_note("Group change failed: " + error + ". Retry keeps the same operation; refresh to see current membership.")
    )
    return request

define echo_group_member_button with group and member and state and title:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to title
    set button.disabled to window.echoReadOnly
    set payload to Object()
    set payload.group to group.group
    set payload.operation to window.crypto.randomUUID()
    set payload.member to member
    set payload.state to state
    set payload.previous to group.revision
    button.addEventListener("click" and given ignored:
        echo_group_action("/api/group-change" and payload and button)
    )
    return button

define echo_group_open with group:
    if window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
        echo_note("Finish or resolve the current submission before changing conversations.")
        return 0
    set query to Object()
    set query.group to group.group
    set pending to echo_api("/api/group-open" and query).then(given result:
        if result.status != "routed":
            return Promise.reject(echo_failure(result))
        set result.group to group.group
        set result.writable to true
        echo_open_session(result)
        echo_note("Shared with this group’s current members. Membership changes start a new segment; earlier records stay saved.")
        return 0
    )
    echo_catch(pending)
    return 0

define echo_group_row with group and principal:
    set row to document.createElement("details")
    set title to document.createElement("summary")
    set title.textContent to group.group
    if group.access == "admin":
        set title.textContent to group.group + " · Admins only"
    if group.state == "invited":
        set title.textContent to group.group + " · Invitation"
    row.appendChild(title)
    if group.state == "invited":
        row.appendChild(echo_group_member_button(group and principal and "joined" and "Accept invitation"))
        row.appendChild(echo_group_member_button(group and principal and "left" and "Decline"))
        return row
    set open_button to document.createElement("button")
    set open_button.type to "button"
    set open_button.textContent to "Open shared conversation"
    set open_button.disabled to window.echoReadOnly
    open_button.addEventListener("click" and given ignored:
        echo_group_open(group)
    )
    row.appendChild(open_button)
    set members to document.createElement("ul")
    for each member in group.members || Array():
        set item to document.createElement("li")
        set label to document.createElement("span")
        set label.textContent to member.principal + " · " + member.state
        item.appendChild(label)
        if group.creator == principal && member.principal != principal:
            item.appendChild(echo_group_member_button(group and member.principal and "removed" and "Remove"))
        members.appendChild(item)
    row.appendChild(members)
    set invite_form to document.createElement("form")
    set label to document.createElement("label")
    set label.textContent to "Invite by principal ID"
    set input to document.createElement("input")
    set input.type to "text"
    set input.required to true
    label.appendChild(input)
    invite_form.appendChild(label)
    set invite to document.createElement("button")
    set invite.type to "submit"
    set invite.textContent to "Invite"
    set invite.disabled to window.echoReadOnly
    invite_form.appendChild(invite)
    set pending to null
    invite_form.addEventListener("submit" and given event:
        event.preventDefault()
        if not pending:
            set pending to Object()
            set pending.group to group.group
            set pending.operation to window.crypto.randomUUID()
            set pending.member to input.value.trim()
            set pending.state to "invited"
            set pending.previous to group.revision
        if pending.member != input.value.trim():
            echo_note("Retry the original invitation or refresh before changing its recipient.")
            return 0
        echo_group_action("/api/group-change" and pending and invite)
    )
    row.appendChild(invite_form)
    row.appendChild(echo_group_member_button(group and principal and "left" and "Leave group"))
    return row

define echo_groups_refresh:
    set identity to null
    set empty to null
    set list to document.getElementById("group-list")
    if not list || not window.echoToken:
        return 0
    set request to echo_api("/api/groups" and Object()).then(given result:
        if result.status != "found":
            return Promise.reject(echo_failure(result))
        set list.textContent to ""
        set identity to document.createElement("p")
        set identity.textContent to "Your principal ID: " + result.principal
        list.appendChild(identity)
        for each group in result.groups:
            list.appendChild(echo_group_row(group and result.principal))
        if result.groups.length == 0:
            set empty to document.createElement("p")
            set empty.textContent to "No shared conversations or invitations yet."
            list.appendChild(empty)
        return 0
    )
    set catcher to get_list(request and "catch")
    catcher.call(request and given error:
        set error to echo_failure(error)
        set list.textContent to "Shared conversations unavailable: " + error
    )
    return 0

define echo_groups_setup:
    if document.getElementById("group-list"):
        return 0
    set panel to document.createElement("details")
    set title to document.createElement("summary")
    set title.textContent to "Shared conversations"
    panel.appendChild(title)
    set refresh to document.createElement("button")
    set refresh.type to "button"
    set refresh.textContent to "Refresh groups and invitations"
    refresh.addEventListener("click" and echo_groups_refresh)
    panel.appendChild(refresh)
    set form to document.createElement("form")
    set label to document.createElement("label")
    set label.textContent to "New group name (unique on this Mac)"
    set name to document.createElement("input")
    set name.type to "text"
    set name.required to true
    label.appendChild(name)
    form.appendChild(label)
    set access_label to document.createElement("label")
    set access_label.textContent to "Who can join"
    set access to document.createElement("select")
    for each entry in ["members", "admin"]:
        set option to document.createElement("option")
        set option.value to entry
        set option.textContent to "Invited users"
        if entry == "admin":
            set option.textContent to "Invited admins only"
        access.appendChild(option)
    access_label.appendChild(access)
    form.appendChild(access_label)
    set create_button to document.createElement("button")
    set create_button.type to "submit"
    set create_button.textContent to "Create group"
    set create_button.disabled to window.echoReadOnly
    form.appendChild(create_button)
    form.addEventListener("submit" and given event:
        event.preventDefault()
        set payload to Object()
        set payload.group to name.value.trim()
        set payload.access to access.value
        if not payload.group:
            return 0
        echo_group_action("/api/group-create" and payload and create_button)
    )
    panel.appendChild(form)
    set list to document.createElement("div")
    set list.id to "group-list"
    panel.appendChild(list)
    document.getElementById("history-sidebar").appendChild(panel)
    return 0

# One observer belongs to the selected group/segment. It never sends a message
# or switches audiences, and late responses cannot repaint another selection.
define echo_group_watch_start:
    if window.echoGroupWatchTimer:
        window.clearTimeout(window.echoGroupWatchTimer)
    set marker to window.crypto.randomUUID()
    set window.echoGroupWatchMarker to marker
    set panel to document.getElementById("group-context")
    if panel:
        set panel.hidden to not window.echoGroup
    if not window.echoGroup || not window.echoToken:
        return 0
    if not panel:
        set panel to document.createElement("aside")
        set panel.id to "group-context"
        set status to document.createElement("p")
        set status.id to "group-context-status"
        status.setAttribute("role" and "status")
        panel.appendChild(status)
        set current to document.createElement("button")
        set current.type to "button"
        set current.textContent to "Open current membership"
        current.addEventListener("click" and given ignored:
            if not window.echoReadOnly:
                set group to Object()
                set group.group to window.echoGroup
                echo_group_open(group)
        )
        panel.appendChild(current)
        set history to document.createElement("details")
        set heading to document.createElement("summary")
        set heading.textContent to "Group conversation history"
        history.appendChild(heading)
        set choices to document.createElement("div")
        set choices.id to "group-history-choices"
        history.appendChild(choices)
        panel.appendChild(history)
        set transcript to document.getElementById("transcript")
        transcript.parentNode.insertBefore(panel and transcript)
    set window.echoGroupHistorySignature to ""
    echo_group_watch(marker)
    return 0

define echo_group_history_choice with segment and group:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Membership " + segment.revision
    if segment.writable:
        set button.textContent to button.textContent + " · Current"
    if segment.session == window.echoSession:
        button.setAttribute("aria-current" and "page")
    set segment.group to group
    button.addEventListener("click" and given ignored:
        echo_open_session(segment)
    )
    return button

define echo_group_watch with marker:
    set selected to null
    set status to null
    set notice_text to ""
    set transcript to null
    set signature to ""
    set choices to null
    set next_check to null
    if marker != window.echoGroupWatchMarker || not window.echoGroup || not window.echoToken:
        return 0
    set group to window.echoGroup
    set session to window.echoSession
    set query to Object()
    set query.group to group
    set request to echo_api("/api/group-state" and query).then(given result:
        if marker != window.echoGroupWatchMarker || group != window.echoGroup || session != window.echoSession:
            return 0
        if result.status != "found" && result.status != "not-found":
            return Promise.reject(echo_failure(result))
        set selected to null
        for each segment in result.sessions || Array():
            if segment.session == session:
                set selected to segment
        set window.echoGroupWritable to selected && selected.writable == true
        set status to document.getElementById("group-context-status")
        if not selected:
            set notice_text to "This shared history is no longer available to this identity. Your unsent draft stays on this browser."
            echo_interaction_clear()
            set window.echoRun to ""
            window.localStorage.removeItem("echo.run")
            set window.echoHistoryMarker to window.crypto.randomUUID()
            set transcript to document.getElementById("transcript")
            set transcript.textContent to ""
            echo_clear_draft()
            echo_trace_clear_floating()
            set window.echoTracePanels to Reflect.construct(Map and Array())
            for each audio in document.querySelectorAll("audio"):
                audio.pause()
                audio.removeAttribute("src")
            echo_busy(false)
        else:
            if selected.writable:
                set notice_text to "Shared with membership " + selected.revision + ". New messages appear here automatically."
            else:
                set notice_text to "Reading earlier membership " + selected.revision + ". Current membership is " + result.revision + ". This segment and its drafts remain separate."
            if selected.run != window.echoRun && not window.localStorage.getItem("echo.pending"):
                set window.echoRun to selected.run
                window.localStorage.setItem("echo.run" and selected.run)
                echo_history()
                echo_poll()
            echo_busy(window.echoBusy)
        if status.textContent != notice_text:
            set status.textContent to notice_text
        set signature to JSON.stringify(result.sessions || Array())
        if signature != window.echoGroupHistorySignature:
            set window.echoGroupHistorySignature to signature
            set choices to document.getElementById("group-history-choices")
            set choices.textContent to ""
            for each segment in result.sessions || Array():
                choices.appendChild(echo_group_history_choice(segment and group))
        return 0
    )
    set catcher to get_list(request and "catch")
    set settled to catcher.call(request and given error:
        set error to echo_failure(error)
        if marker == window.echoGroupWatchMarker:
            set window.echoGroupWritable to false
            set status to document.getElementById("group-context-status")
            set status.textContent to "Reconnecting to shared history. Your draft stays here. " + error
            echo_busy(window.echoBusy)
        return 0
    )
    settled.then(given ignored:
        if marker == window.echoGroupWatchMarker:
            set next_check to given ignored:
                echo_group_watch(marker)
            set window.echoGroupWatchTimer to window.setTimeout(next_check and 1500)
        return 0
    )
    return 0

# Parking is a local preservation operation, never cancellation or proof of
# non-delivery. Write and verify the original bytes before releasing the lock.
define echo_outbox_prefix:
    set device to window.localStorage.getItem("echo.device")
    if not device:
        return ""
    return "echo.saved-submission:" + encodeURIComponent(device) + ":"

define echo_outbox_park:
    set prefix to echo_outbox_prefix()
    set original to window.localStorage.getItem("echo.pending")
    if not prefix || not original:
        return Promise.reject("A paired browser identity and saved submission are required.")
    set payload to JSON.parse(original)
    if not payload.submission:
        return Promise.reject("Saved submission has no identity; its original record was kept.")
    set key to prefix + encodeURIComponent(payload.submission)
    set prior to window.localStorage.getItem(key)
    if prior && prior != original:
        return Promise.reject("Conflicting saved submission identity. Both existing records were kept.")
    window.localStorage.setItem(key and original)
    if window.localStorage.getItem(key) != original:
        return Promise.reject("The browser could not verify the saved copy. Pending submission was kept.")
    window.localStorage.removeItem("echo.pending")
    return payload

define echo_outbox_restore with key:
    set prefix to echo_outbox_prefix()
    if not prefix || key.indexOf(prefix) != 0:
        return Promise.reject("This saved submission belongs to a different browser identity.")
    set original to window.localStorage.getItem(key)
    if not original:
        return Promise.reject("Saved submission is missing.")
    set pending to window.localStorage.getItem("echo.pending")
    if pending && pending != original:
        return Promise.reject("Keep or resolve the current pending submission first.")
    window.localStorage.setItem("echo.pending" and original)
    return JSON.parse(original)

define echo_outbox_row with key and original:
    set payload to JSON.parse(original)
    set row to document.createElement("details")
    set title to document.createElement("summary")
    set title.textContent to payload.group || "Private conversation"
    row.appendChild(title)
    set text to document.createElement("pre")
    set text.style.whiteSpace to "pre-wrap"
    set text.style.overflowWrap to "anywhere"
    set text.textContent to payload.message
    row.appendChild(text)
    set identity to document.createElement("p")
    set identity.textContent to "Original submission: " + payload.submission + " · Selected files: " + (payload.attachments || Array()).length
    row.appendChild(identity)
    set retry to document.createElement("button")
    set retry.type to "button"
    set retry.textContent to "Check / retry original submission"
    set retry.disabled to window.echoReadOnly
    retry.addEventListener("click" and given ignored:
        if window.echoBusy || window.echoUploading:
            echo_note("Wait for the current operation before checking saved work.")
            return 0
        set restored to Promise.resolve().then(given ignored:
            return echo_outbox_restore(key)
        ).then(given payload:
            return echo_reconcile_pending()
        ).then(given result:
            echo_note("Original submission found: " + result.state + ". The saved copy remains available.")
            echo_poll()
            return result
        )
        echo_catch(restored)
    )
    row.appendChild(retry)
    return row

define echo_outbox_render:
    set panel to document.getElementById("saved-submissions")
    if not panel:
        return 0
    set rows to document.getElementById("saved-submission-list")
    set rows.textContent to ""
    set prefix to echo_outbox_prefix()
    set count to 0
    set index to 0
    repeat while index < window.localStorage.length:
        set key to window.localStorage.key(index)
        if prefix && key.indexOf(prefix) == 0:
            rows.appendChild(echo_outbox_row(key and window.localStorage.getItem(key)))
            set count to count + 1
        set index to index + 1
    set pending to window.localStorage.getItem("echo.pending")
    set park to document.getElementById("park-submission")
    set park.hidden to not pending
    set park.disabled to not prefix || window.echoReadOnly
    set panel.hidden to not pending && count == 0
    if pending:
        set panel.open to true
    return 0

define echo_outbox_setup:
    if document.getElementById("saved-submissions"):
        return echo_outbox_render()
    set panel to document.createElement("details")
    set panel.id to "saved-submissions"
    set title to document.createElement("summary")
    set title.textContent to "Saved submissions"
    panel.appendChild(title)
    set explanation to document.createElement("p")
    set explanation.textContent to "An interrupted submission may already have reached Echo. Keeping it here unlocks other chats but does not cancel it. Checking retries its original ID, audience and files; nothing is automatically sent to a new audience. Copies stay in this browser."
    panel.appendChild(explanation)
    set park to document.createElement("button")
    set park.id to "park-submission"
    set park.type to "button"
    set park.textContent to "Keep pending submission here and unlock chats"
    park.addEventListener("click" and given ignored:
        if window.echoBusy || window.echoUploading:
            echo_note("Wait for the current request to settle before keeping its submission.")
            return 0
        set preserved to Promise.resolve().then(given ignored:
            return echo_outbox_park()
        ).then(given payload:
            echo_outbox_render()
            echo_busy(false)
            echo_note("Original submission and selected-file references saved here. You can open another chat. This did not cancel or resend the original.")
            return payload
        )
        echo_catch(preserved)
    )
    panel.appendChild(park)
    set rows to document.createElement("div")
    set rows.id to "saved-submission-list"
    panel.appendChild(rows)
    document.getElementById("history-sidebar").appendChild(panel)
    return echo_outbox_render()


# Queued messages are device/session bound and keep their original retry identity.
define echo_queue_key:
    return "echo.queue:" + encodeURIComponent(window.localStorage.getItem("echo.device") || "") + ":" + encodeURIComponent(window.echoSession || "")

define echo_queue_read:
    return JSON.parse(window.localStorage.getItem(echo_queue_key()) || "[]")

define echo_queue_render:
    set panel to document.getElementById("message-queue")
    if not panel:
        return 0
    set queue to echo_queue_read()
    set heading to document.getElementById("queue-heading")
    if heading:
        set heading.hidden to queue.length == 0
        set heading.textContent to "Up next · " + String(queue.length)
    set signature to echo_queue_key() + JSON.stringify(queue) + String(window.echoBusy) + String(window.echoCanStop) + String(window.echoGuidanceSending)
    if window.echoQueueRendered != signature:
        set window.echoQueueRendered to signature
        set rows to document.getElementById("message-queue-rows")
        set rows.textContent to ""
        for each item in queue:
            set row to document.createElement("div")
            set row.className to "queued-message-card"
            if item.steer_run:
                row.setAttribute("data-steering" and "true")
            set label to document.createElement("span")
            set label.textContent to item.message
            if item.steer_run:
                set label.textContent to "Steering correction · " + item.message
            row.appendChild(label)
            if window.echoBusy && window.echoCanStop && not (item.attachments && item.attachments.length > 0):
                set guide to document.createElement("button")
                set guide.type to "button"
                set guide.textContent to "Steer now"
                set guide.disabled to window.echoGuidanceSending || window.echoReadOnly
                guide.addEventListener("click" and given event:
                    event.preventDefault()
                    echo_guidance_send(item)
                )
                row.appendChild(guide)
            set remove to document.createElement("button")
            set remove.type to "button"
            set remove.textContent to "×"
            set remove.className to "queue-remove"
            remove.setAttribute("aria-label" and "Remove queued message")
            remove.setAttribute("title" and "Remove queued message")
            remove.addEventListener("click" and given event:
                set remaining to echo_queue_read().filter(given entry:
                    return entry.submission != item.submission
                )
                window.localStorage.setItem(echo_queue_key() and JSON.stringify(remaining))
                echo_queue_render()
            )
            row.appendChild(remove)
            rows.appendChild(row)
    set steer to document.getElementById("steer-now")
    set steer.hidden to not window.echoBusy
    echo_guidance_render()
    set next to document.getElementById("queue-next")
    set next.hidden to queue.length == 0
    set next.disabled to window.echoBusy || window.echoQueueSending || window.echoQueueReadyRun != window.echoRun
    return 0

define echo_queue_add with steer:
    if steer:
        echo_guidance_send()
        return 0
    set input to document.getElementById("message")
    if window.echoReadOnly || window.echoUploading || not window.echoToken:
        echo_steer_status("Cannot send yet. Wait for uploads to finish and check this browser is connected.")
        return 0
    if not input.value.trim():
        return 0
    if not window.echoSession || window.localStorage.getItem("echo.pending"):
        echo_note("Waiting for the current message to be saved. Your draft is kept.")
        return 0
    if window.echoGroup && not window.echoGroupWritable:
        return 0
    set item to Object()
    set item.submission to window.crypto.randomUUID()
    set item.message to input.value
    set item.session to window.echoSession
    set item.attachments to echo_selected_files()
    if window.echoGroup:
        set item.group to window.echoGroup
    set picker to document.getElementById("provider-picker")
    if picker && picker.value && not item.group:
        set item.provider to picker.value
    set queue to echo_queue_read()
    queue.push(item)
    window.localStorage.setItem(echo_queue_key() and JSON.stringify(queue))
    set input.value to ""
    window.localStorage.removeItem("echo.composer:" + window.echoSession)
    window.localStorage.removeItem("echo.files:" + window.echoSession)
    echo_queue_render()
    echo_note("Message queued for this conversation.")
    return 0

define echo_queue_next:
    if window.echoQueueSending || window.echoBusy || window.echoReadOnly || not window.echoToken || window.echoQueueReadyRun != window.echoRun || window.localStorage.getItem("echo.pending"):
        return 0
    if window.echoGroup && not window.echoGroupWritable:
        return 0
    set queue to echo_queue_read()
    if queue.length == 0:
        return 0
    set item to get_list(queue and 0)
    if item.session != window.echoSession || (item.group || "") != (window.echoGroup || ""):
        return 0
    set key to echo_queue_key()
    set payload to Object.assign(Object() and item)
    Reflect.deleteProperty(payload and "steer_run")
    window.localStorage.setItem("echo.pending" and JSON.stringify(payload))
    # Pending owns the retry before removal from the queue.
    queue.shift()
    window.localStorage.setItem(key and JSON.stringify(queue))
    set window.echoQueueSending to true
    echo_busy(true)
    if item.steer_run:
        echo_steer_status("Sending your steering correction…")
    set sent to echo_reconcile_pending().then(given result:
        if item.steer_run:
            echo_steer_status("Correction sent. Echo is responding to your updated message.")
        set window.echoQueueSending to false
        echo_poll()
    )
    set catcher to get_list(sent and "catch")
    catcher.call(sent and given error:
        set error to echo_failure(error)
        set window.echoQueueSending to false
        if item.steer_run:
            echo_steer_status("Correction is saved, but sending needs attention: " + String(error))
        if error == "session-active":
            set saved to window.localStorage.getItem("echo.pending")
            if saved:
                set original to JSON.parse(saved)
                if item.steer_run:
                    set original.steer_run to item.steer_run
                set remaining to echo_queue_read()
                remaining.unshift(original)
                window.localStorage.setItem(echo_queue_key() and JSON.stringify(remaining))
                window.localStorage.removeItem("echo.pending")
                echo_busy(true)
                echo_linked_session_watch()
                return 0
        echo_error(error)
    )
    return 0

define echo_steer_status with text:
    set status to document.getElementById("steering-status")
    if status:
        set status.hidden to false
        set status.textContent to text
    return 0

define echo_queue_setup:
    set panel to document.createElement("section")
    set panel.id to "message-queue"
    set style to document.createElement("style")
    set style.textContent to "#message-queue{margin:12px 0 0;padding-top:10px;border-top:1px solid var(--composer-line);font-size:13px}#message-queue[hidden],#message-queue [hidden]{display:none!important}#message-queue .footnote{font-size:11px;margin:8px 0 0;color:var(--muted)}#queue-heading{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.03em;margin:0 0 8px}#message-queue-rows{display:grid;gap:6px;max-height:160px;overflow:auto;overscroll-behavior:contain}.queued-message-card{display:flex;align-items:center;gap:10px;padding:9px 11px;border:1px solid var(--composer-line);border-radius:12px;background:var(--bg)}.queued-message-card>span{flex:1;min-width:0;white-space:pre-wrap;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;line-height:1.45;color:var(--soft)}.queued-message-card[data-steering=true]{border-color:var(--accent)}#message-queue .queue-remove{flex:none;width:30px;height:30px;padding:0;border:0;border-radius:8px;background:transparent;color:var(--muted);font-size:20px}#message-queue .queue-remove:hover{background:var(--button);color:var(--fg)}.queue-actions{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap;margin-top:8px}.queue-actions button{font-size:12px;padding:8px 12px;border-radius:10px;margin:0}#steer-now{background:transparent;color:var(--accent);border:1px solid var(--accent)}#queue-next{background:var(--button);border:1px solid var(--composer-line);color:var(--soft)}#steering-status{margin:8px 0;line-height:1.5;color:var(--accent);font-size:12px;padding:8px 10px;background:var(--bg);border-radius:10px}.header-options[open]>div{width:min(360px,calc(100vw - 32px));max-height:75vh;overflow:auto}#device-link-panel input{max-width:none;width:100%}#device-link-panel p{font-size:12px;line-height:1.55;color:var(--soft)}@media(max-width:600px){#message-queue .footnote{display:none}.queue-actions button{min-height:40px}.queued-message-card{padding:8px 10px}#message-queue-rows{max-height:130px}}"
    document.head.appendChild(style)
    panel.setAttribute("aria-label" and "Queued messages")
    set hint to document.createElement("p")
    set hint.className to "footnote"
    set hint.textContent to "Enter to send or queue · Shift+Enter for a new line"
    set heading to document.createElement("p")
    set heading.id to "queue-heading"
    set heading.hidden to true
    panel.appendChild(heading)
    set status to document.createElement("p")
    set status.id to "steering-status"
    set status.hidden to true
    status.setAttribute("role" and "status")
    status.setAttribute("aria-live" and "polite")
    panel.appendChild(status)
    set rows to document.createElement("div")
    set rows.id to "message-queue-rows"
    panel.appendChild(rows)
    set steer to document.createElement("button")
    set steer.id to "steer-now"
    set steer.type to "button"
    set steer.textContent to "Steer now"
    steer.setAttribute("title" and "Send guidance into the current turn. It will not queue another turn.")
    steer.addEventListener("click" and given event:
        echo_queue_add(true)
    )
    set actions to document.createElement("div")
    set actions.className to "queue-actions"
    actions.appendChild(steer)
    set next to document.createElement("button")
    set next.id to "queue-next"
    set next.type to "button"
    set next.textContent to "Send next"
    next.addEventListener("click" and given event:
        echo_queue_next()
    )
    actions.appendChild(next)
    panel.appendChild(actions)
    panel.appendChild(hint)
    document.getElementById("composer").appendChild(panel)
    echo_queue_render()
    return 0


# Linking switches this browser to an explicitly selected existing account.
# Prior credentials/context are retained for an explicit return, never merged.
define echo_link_switch with result:
    set previous to Object()
    for each key in ["echo.credential", "echo.device", "echo.session", "echo.run", "echo.group"]:
        get_list(Reflect and "set").call(Reflect and previous and key and window.localStorage.getItem(key))
    if window.echoToken:
        window.localStorage.setItem("echo.previous-account" and JSON.stringify(previous))
    window.localStorage.setItem("echo.credential" and result.token)
    window.localStorage.setItem("echo.device" and result.device)
    for each key in ["echo.session", "echo.run", "echo.group"]:
        window.localStorage.removeItem(key)
    window.location.reload()
    return 0

define echo_link_list with rows:
    set request to Object()
    set request.action to "list"
    set loaded to echo_api("/api/device-link" and request).then(given result:
        set rows.textContent to ""
        for each item in result.browsers || Array():
            set row to document.createElement("div")
            set label to document.createElement("span")
            set label.textContent to item.name
            row.appendChild(label)
            set revoke to document.createElement("button")
            set revoke.type to "button"
            set revoke.textContent to "Unlink"
            revoke.addEventListener("click" and given event:
                set query to Object()
                set query.action to "revoke"
                set query.identity to item.identity
                echo_catch(echo_api("/api/device-link" and query).then(given ignored:
                    echo_link_list(rows)
                ))
            )
            row.appendChild(revoke)
            rows.appendChild(row)
    )
    echo_catch(loaded)
    return 0

define echo_device_links_setup with parent:
    set panel to document.createElement("details")
    set heading to document.createElement("summary")
    set heading.textContent to "Link your devices"
    set panel.id to "device-link-panel"
    panel.appendChild(heading)
    set note to document.createElement("p")
    set note.textContent to "Have a code from your phone or another device? Paste it below to open the same conversations here."
    note.setAttribute("role" and "status")
    panel.appendChild(note)
    set code_label to document.createElement("label")
    set code_label.textContent to "1. Paste the code from your other device"
    code_label.setAttribute("for" and "device-link-code")
    panel.appendChild(code_label)
    set code to document.createElement("input")
    set code.id to "device-link-code"
    set code.style.width to "100%"
    set code.style.boxSizing to "border-box"
    code.setAttribute("autocapitalize" and "none")
    code.setAttribute("spellcheck" and "false")
    code.setAttribute("aria-label" and "Linking code from your other device")
    set code.placeholder to "Code from your other device"
    panel.appendChild(code)
    set name_label to document.createElement("label")
    set name_label.textContent to "2. Name this device (optional)"
    name_label.setAttribute("for" and "device-link-name")
    panel.appendChild(name_label)
    set name to document.createElement("input")
    set name.id to "device-link-name"
    set name.style.width to "100%"
    set name.style.boxSizing to "border-box"
    name.setAttribute("aria-label" and "Name for this linked browser")
    set name.placeholder to "This device name, e.g. Mac browser"
    panel.appendChild(name)
    set accept to document.createElement("button")
    set accept.type to "button"
    set accept.textContent to "Link this device & open my chats"
    set accept.style.width to "100%"
    set accept.style.marginTop to "12px"
    panel.appendChild(accept)
    accept.addEventListener("click" and given event:
        if window.echoBusy || window.echoUploading || window.localStorage.getItem("echo.pending"):
            set note.textContent to "Finish or stop this browser’s current turn before switching accounts. Your existing history will stay in its original account."
            return 0
        if not code.value.trim():
            set note.textContent to "Paste the code from your other device into step 1."
            code.focus()
            return 0
        set options to Object()
        set options.method to "POST"
        set options.headers to Object()
        get_list(Reflect and "set").call(Reflect and options.headers and "Content-Type" and "application/json")
        get_list(Reflect and "set").call(Reflect and options.headers and "X-Echo-Token" and code.value.trim())
        set body to Object()
        set body.name to name.value.trim() || "Linked browser"
        set body.previous_token to window.echoToken || ""
        set options.body to JSON.stringify(body)
        set accept.disabled to true
        set accept.textContent to "Linking your device…"
        set note.textContent to "Opening your other device’s conversations here…"
        set request to window.fetch("/api/pair" and options).then(given response:
            if not response.ok:
                return Promise.reject("That code has expired, was already used, or was copied incorrectly. Create a new code on your other device and paste it here.")
            return response.json()
        ).then(given result:
            if result.status != "paired":
                return Promise.reject(echo_failure(result))
            echo_link_switch(result)
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set note.textContent to String(error)
            set accept.disabled to false
            set accept.textContent to "Link this device & open my chats"
        )
    )
    set explanation to document.createElement("p")
    set explanation.textContent to "Your conversations from both devices will appear together. Open any conversation on either device; new messages update automatically. Linking also gives this browser access to the other account’s permissions."
    panel.appendChild(explanation)
    set outgoing to document.createElement("details")
    set outgoing_title to document.createElement("summary")
    set outgoing_title.textContent to "Want to bring these chats to another device instead?"
    outgoing.appendChild(outgoing_title)
    set outgoing_help to document.createElement("p")
    set outgoing_help.textContent to "Create a code here. On your other device, open Link devices and paste it into step 1. The code works once and expires in 10 minutes."
    outgoing.appendChild(outgoing_help)
    set create_button to document.createElement("button")
    set create_button.type to "button"
    set create_button.textContent to "Create a code for my other device"
    outgoing.appendChild(create_button)
    set output to document.createElement("input")
    set output.readOnly to true
    set output.hidden to true
    set output.style.width to "100%"
    output.setAttribute("aria-label" and "Your one-use linking code")
    outgoing.appendChild(output)
    create_button.addEventListener("click" and given event:
        set query to Object()
        set query.action to "create"
        echo_catch(echo_api("/api/device-link" and query).then(given result:
            set output.value to result.code || ""
            set output.hidden to false
            output.select()
        ))
    )
    panel.appendChild(outgoing)
    # Upgrade an earlier switch-only link when both credentials are still held here.
    set previous_text to window.localStorage.getItem("echo.previous-account")
    if previous_text && window.echoToken:
        set previous to JSON.parse(previous_text)
        set merge to Object()
        set merge.action to "merge"
        set merge.previous_token to get_list(previous and "echo.credential")
        set merging to echo_api("/api/device-link" and merge).then(given result:
            if result.status == "merged":
                window.localStorage.removeItem("echo.previous-account")
                set note.textContent to "Your linked devices now share one conversation list. New messages appear automatically."
                echo_sessions()
        )
        set merge_error to get_list(merging and "catch")
        merge_error.call(merging and given error:
            set error to echo_failure(error)
            set note.textContent to "Earlier chats could not be combined yet. Your saved chats remain intact. " + String(error)
        )
    set rows to document.createElement("div")
    panel.appendChild(rows)
    panel.addEventListener("toggle" and given event:
        if panel.open && window.echoToken:
            echo_link_list(rows)
    )
    parent.appendChild(panel)
    return 0


# Follow new turns from another linked browser without replacing its draft.
define echo_linked_session_watch:
    if not window.echoToken || window.echoPrivateWatching || document.visibilityState != "visible":
        return 0
    set window.echoPrivateWatching to true
    set session to window.echoSession
    set query to Object()
    set request to echo_api("/api/sessions" and query).then(given result:
        set window.echoPrivateWatching to false
        if result.status != "found":
            return 0
        if not document.getElementById("session-search").value:
            echo_sessions_render(result)
        else:
            echo_sessions()
        if not session || session != window.echoSession || window.echoGroup || window.localStorage.getItem("echo.pending"):
            return 0
        for each item in result.sessions || Array():
            if item.session == session && item.revision && not window.echoBusy && window.echoRenderedRevision != session + ":" + item.revision:
                echo_history()
            if item.session == session && item.run && item.run != window.echoRun:
                set window.echoRun to item.run
                window.localStorage.setItem("echo.run" and item.run)
                echo_history()
                echo_poll()
    )
    set catcher to get_list(request and "catch")
    catcher.call(request and given ignored:
        set window.echoPrivateWatching to false
    )
    return 0


define echo_playback_setup:
    document.addEventListener("play" and given event:
        if event.target.tagName == "AUDIO":
            if window.echoActiveAudio && window.echoActiveAudio != event.target:
                window.echoActiveAudio.pause()
            set window.echoActiveAudio to event.target
    and true)
    return 0


# Guidance is sent to the existing durable run, never through Stop or /api/runs.
define echo_guidance_send with queued:
    set input to document.getElementById("message")
    if not input:
        return 0
    if window.echoGuidanceSending:
        echo_guidance_render()
        return 0
    if not window.echoToken || window.echoReadOnly || window.echoUploading || not window.echoRun || not window.echoCanStop:
        echo_steer_status("There is no active turn ready for guidance. Your text is kept.")
        return 0
    if (queued && queued.attachments && queued.attachments.length > 0) || (not queued && echo_selected_files().length > 0):
        echo_steer_status("Send attachments as a queued message. Mid-turn guidance currently accepts text; your draft is kept.")
        return 0
    set message to input.value
    if queued:
        set message to queued.message
    if not message.trim():
        echo_guidance_render()
        input.focus()
        return 0
    set key to "echo.guidance:" + window.echoRun
    set payload to Object()
    set saved to window.localStorage.getItem(key)
    if saved:
        set payload to JSON.parse(saved)
        set message to payload.message
    else:
        set payload.run to window.echoRun
        set payload.identity to window.crypto.randomUUID()
        set payload.message to message
        set payload.queue_key to echo_queue_key()
        if queued:
            set payload.queue_submission to queued.submission
        window.localStorage.setItem(key and JSON.stringify(payload))
    set payload.phase to "sending"
    window.localStorage.setItem("echo.guidance.receipt:" + payload.run and JSON.stringify(payload))
    set window.echoGuidanceSending to true
    echo_queue_render()
    set sent to echo_api("/api/steer" and payload).then(given result:
        if result.status != "guidance-received":
            return Promise.reject("Guidance was not accepted: " + result.status)
        set priorReceipt to JSON.parse(window.localStorage.getItem("echo.guidance.receipt:" + payload.run) || "null")
        set payload.phase to "received"
        if priorReceipt && priorReceipt.identity == payload.identity && priorReceipt.phase == "applied":
            set payload.phase to "applied"
        window.localStorage.setItem("echo.guidance.receipt:" + payload.run and JSON.stringify(payload))
        echo_guidance_clear(payload)
        set window.echoGuidanceSending to false
        echo_queue_render()
        echo_poll()
    )
    sent.catch(given error:
        set error to echo_failure(error)
        set window.echoGuidanceSending to false
        echo_queue_render()
        set receipt to JSON.parse(window.localStorage.getItem("echo.guidance.receipt:" + payload.run) || "null")
        if not (receipt && receipt.identity == payload.identity && receipt.phase == "applied"):
            echo_steer_status("Delivery not confirmed. Retry guidance uses the same message ID and cannot duplicate it. " + String(error))
    )
    return 0


# Sending, acknowledged and applied are distinct. Repeated taps never create
# another identity; a retry retains the durable intake identity.
define echo_guidance_render:
    set button to document.getElementById("steer-now")
    set input to document.getElementById("message")
    if not button || not input:
        return 0
    set pending to window.localStorage.getItem("echo.guidance:" + window.echoRun)
    set receipt to JSON.parse(window.localStorage.getItem("echo.guidance.receipt:" + window.echoRun) || "null")
    set button.disabled to window.echoGuidanceSending || not window.echoCanStop || window.echoReadOnly || window.echoUploading || not window.echoToken || not input.value.trim()
    set button.textContent to "Steer now"
    if window.echoGuidanceSending:
        set button.textContent to "Sending guidance…"
        echo_steer_status("Sending guidance once. Please wait for confirmation.")
    else if pending:
        set button.textContent to "Retry guidance"
        echo_steer_status("Delivery not confirmed. Retry guidance checks the same saved message; it will not send a duplicate.")
    else if receipt && receipt.phase == "applied":
        echo_steer_status("Guidance applied to this turn.")
    else if receipt:
        echo_steer_status("Guidance received once — waiting for Echo to apply it. You do not need to send it again.")
    else:
        set status to document.getElementById("steering-status")
        if status:
            set status.hidden to true
            set status.textContent to ""
    return 0

# Both HTTP acknowledgement and an archived application receipt confirm delivery.
# Remove only that identity, never a later draft or another queued message.
define echo_guidance_clear with payload:
    set key to "echo.guidance:" + payload.run
    set pending to JSON.parse(window.localStorage.getItem(key) || "null")
    if pending && pending.identity == payload.identity:
        window.localStorage.removeItem(key)
    if payload.queue_key:
        set remaining to JSON.parse(window.localStorage.getItem(payload.queue_key) || "[]").filter(given entry:
            return not ((payload.queue_submission && entry.submission == payload.queue_submission) || (entry.steer_run == payload.run && entry.message == payload.message))
        )
        window.localStorage.setItem(payload.queue_key and JSON.stringify(remaining))
    set input to document.getElementById("message")
    if input && not payload.queue_submission && window.echoRun == payload.run && input.value == payload.message:
        set input.value to ""
        window.localStorage.removeItem("echo.composer:" + window.echoSession)
    return 0

# Project editor fields retain normal labels and browser keyboard behaviour.
define echo_project_field with parent and title and multiline:
    set label to document.createElement("label")
    set label.style.cssText to "display:block;margin:12px 0"
    set caption to document.createElement("span")
    set caption.textContent to title
    label.appendChild(caption)
    set control to document.createElement("input")
    if multiline:
        set control to document.createElement("textarea")
        set control.rows to 5
    set control.style.cssText to "display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:10px;border:1px solid var(--border);border-radius:8px"
    control.setAttribute("aria-label" and title)
    label.appendChild(control)
    parent.appendChild(label)
    return control

define echo_project_task with parent and task:
    set row to document.createElement("div")
    set row.style.cssText to "display:flex;gap:8px;flex-wrap:wrap;margin:8px 0"
    set row.echoIdentity to task.id || window.crypto.randomUUID()
    set title to document.createElement("input")
    title.setAttribute("aria-label" and "Task title")
    set title.value to task.title || ""
    set title.style.cssText to "flex:1;min-width:140px;padding:8px"
    row.appendChild(title)
    set status to document.createElement("select")
    status.setAttribute("aria-label" and "Task status")
    for each value in ["todo","doing","done","blocked"]:
        set option to document.createElement("option")
        set option.value to value
        set option.textContent to value
        status.appendChild(option)
    set status.value to task.status || "todo"
    row.appendChild(status)
    set remove to document.createElement("button")
    set remove.type to "button"
    set remove.textContent to "Remove task"
    remove.addEventListener("click" and given ignored:
        row.remove()
    )
    row.appendChild(remove)
    parent.appendChild(row)
    return 0

define echo_project_file with parent and file and checked:
    for each existing in parent.children:
        if existing.echoFile.attachment == file.attachment:
            return 0
    set label to document.createElement("label")
    set label.style.cssText to "display:block;margin:8px 0;overflow-wrap:anywhere"
    set label.echoFile to file
    set checkbox to document.createElement("input")
    set checkbox.type to "checkbox"
    set checkbox.checked to checked
    checkbox.setAttribute("aria-label" and "Project file: " + file.label)
    label.appendChild(checkbox)
    label.appendChild(document.createTextNode(" " + file.label))
    parent.appendChild(label)
    return 0

define echo_projects_setup:
    if document.getElementById("projects-open"):
        return 0
    set button to document.createElement("button")
    set button.id to "projects-open"
    set button.type to "button"
    set button.textContent to "Projects"
    set button.disabled to window.echoReadOnly
    button.addEventListener("click" and given ignored:
        echo_catch(echo_ensure_session().then(given session:
            echo_projects_dialog(session and button)
        ))
    )
    document.getElementById("history-sidebar").appendChild(button)
    return 0

define echo_projects_dialog with session and opener:
    set request to null
    set catcher to null
    set query to null
    set selected to null
    set manifest to null
    set task to null
    set control to null
    set pending_key to null
    set pending to null
    set dialog to document.createElement("dialog")
    dialog.setAttribute("aria-label" and "Projects")
    set dialog.style.cssText to "width:min(680px,calc(100vw - 32px));max-height:90vh;box-sizing:border-box;overflow:auto;background:var(--surface);color:var(--fg);border:1px solid var(--border);border-radius:18px;padding:24px"
    set heading to document.createElement("h2")
    set heading.textContent to "Projects"
    dialog.appendChild(heading)
    set status to document.createElement("p")
    status.setAttribute("role" and "status")
    set status.textContent to "Loading projects for this conversation…"
    dialog.appendChild(status)
    set picker to document.createElement("select")
    picker.setAttribute("aria-label" and "Choose project")
    set picker.style.maxWidth to "100%"
    dialog.appendChild(picker)
    set activate to document.createElement("button")
    set activate.type to "button"
    set activate.textContent to "Use in this conversation"
    dialog.appendChild(activate)
    set clear to document.createElement("button")
    set clear.type to "button"
    set clear.textContent to "Clear conversation project"
    dialog.appendChild(clear)
    set name to echo_project_field(dialog and "Project name" and false)
    set instructions to echo_project_field(dialog and "Project instructions" and true)
    set tasks_heading to document.createElement("h3")
    set tasks_heading.textContent to "Tasks"
    dialog.appendChild(tasks_heading)
    set tasks to document.createElement("div")
    dialog.appendChild(tasks)
    set add to document.createElement("button")
    set add.type to "button"
    set add.textContent to "Add task"
    add.addEventListener("click" and given ignored:
        echo_project_task(tasks and Object())
    )
    dialog.appendChild(add)
    set files_heading to document.createElement("h3")
    set files_heading.textContent to "Project files"
    dialog.appendChild(files_heading)
    set explanation to document.createElement("p")
    set explanation.textContent to "Choose from this conversation’s uploaded files. Existing project references stay available below. Unchecking removes a project reference, not the original file. Task status records your plan, not a verified result."
    dialog.appendChild(explanation)
    set files to document.createElement("div")
    dialog.appendChild(files)
    set save to document.createElement("button")
    set save.type to "button"
    set save.textContent to "Save project"
    dialog.appendChild(save)
    set close to document.createElement("button")
    set close.type to "button"
    set close.textContent to "Close"
    close.addEventListener("click" and given ignored:
        dialog.close()
    )
    dialog.appendChild(close)
    set retry to document.createElement("button")
    set retry.type to "button"
    set retry.textContent to "Retry unfinished project change"
    set retry.hidden to not window.localStorage.getItem("echo.project-request:" + session)
    retry.addEventListener("click" and given ignored:
        set pending to window.localStorage.getItem("echo.project-request:" + session)
        if pending:
            submit(JSON.parse(pending))
    )
    dialog.appendChild(retry)
    set dialog.echoProjects to Array()
    set dialog.echoFiles to Array()
    set dialog.echoBusy to false
    set save.disabled to true
    set activate.disabled to true
    set clear.disabled to true
    set picker.disabled to true
    dialog.addEventListener("cancel" and given event:
        if dialog.echoBusy:
            event.preventDefault()
    )
    dialog.addEventListener("close" and given ignored:
        dialog.remove()
        opener.focus()
    )
    set render to given ignored:
        set selected to dialog.echoProjects.find(given item:
            return item.project == picker.value
        )
        set manifest to Object()
        if selected:
            set manifest to selected.manifest
        set name.value to manifest.name || ""
        set instructions.value to manifest.instructions || ""
        set tasks.textContent to ""
        for each task in manifest.tasks || Array():
            echo_project_task(tasks and task)
        set files.textContent to ""
        for each control in manifest.files || Array():
            echo_project_file(files and control and true)
        for each control in dialog.echoFiles:
            echo_project_file(files and control and false)
        set activate.disabled to not selected
    picker.addEventListener("change" and render)
    set refresh to given chosen:
        set query to Object()
        set query.operation to "list"
        set query.session to session
        return echo_api("/api/projects" and query).then(given result:
            set dialog.echoProjects to result.projects
            set picker.textContent to ""
            set control to document.createElement("option")
            set control.value to ""
            set control.textContent to "New project"
            picker.appendChild(control)
            for each item in result.projects:
                set control to document.createElement("option")
                set control.value to item.project
                set control.textContent to item.manifest.name
                if item.project == result.selected:
                    set control.textContent to control.textContent + " · Active"
                picker.appendChild(control)
            set picker.value to chosen || result.selected || ""
            set save.disabled to false
            set clear.disabled to false
            set picker.disabled to false
            render(null)
            set status.textContent to "Project instructions apply when Echo builds its next request. Saving retains earlier revisions."
        )
    set submit to given payload:
        if dialog.echoBusy:
            return 0
        set pending_key to "echo.project-request:" + session
        set pending to window.localStorage.getItem(pending_key)
        if pending:
            set pending to JSON.parse(pending)
            set payload.identity to pending.identity
            if JSON.stringify(payload) != JSON.stringify(pending):
                set status.textContent to "An earlier project save is unresolved. Retry its unchanged values before saving another change."
                return 0
        else:
            set payload.identity to window.crypto.randomUUID()
            window.localStorage.setItem(pending_key and JSON.stringify(payload))
        set retry.hidden to false
        set dialog.echoBusy to true
        set close.disabled to true
        set save.disabled to true
        set activate.disabled to true
        set clear.disabled to true
        set picker.disabled to true
        set status.textContent to "Saving project change…"
        set request to echo_api("/api/projects" and payload).then(given result:
            return refresh(result.project)
        ).then(given ignored:
            window.localStorage.removeItem(pending_key)
            set retry.hidden to true
            set dialog.echoBusy to false
            set close.disabled to false
            set save.disabled to false
            set clear.disabled to false
            set picker.disabled to false
            set status.textContent to "Saved. Project revisions and selection are retained across conversations and linked devices."
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set dialog.echoBusy to false
            set close.disabled to false
            set save.disabled to false
            set clear.disabled to false
            set picker.disabled to false
            set activate.disabled to picker.value == ""
            if echo_error_code(error) == "revision-conflict" || echo_error_code(error) == "invalid-manifest" || echo_error_code(error) == "not-authorized":
                window.localStorage.removeItem(pending_key)
                set retry.hidden to true
            set status.textContent to "Project change failed: " + error + ". Your fields remain here. For a stale revision, close and reopen Projects to load the current version."
        )
    save.addEventListener("click" and given ignored:
        set selected to dialog.echoProjects.find(given item:
            return item.project == picker.value
        )
        set manifest to Object()
        set manifest.name to name.value
        set manifest.instructions to instructions.value
        set manifest.tasks to Array()
        for each row in tasks.children:
            set task to Object()
            set task.id to row.echoIdentity
            set task.title to row.querySelector("input").value
            set task.status to row.querySelector("select").value
            manifest.tasks.push(task)
        set manifest.files to Array()
        for each row in files.children:
            if row.querySelector("input").checked:
                manifest.files.push(row.echoFile)
        set query to Object()
        set query.operation to "create"
        set query.session to session
        if selected:
            set query.operation to "update"
            set query.project to selected.project
            set query.expected_revision to selected.revision
        set query.manifest to manifest
        submit(query)
    )
    activate.addEventListener("click" and given ignored:
        set query to Object()
        set query.operation to "select"
        set query.session to session
        set query.project to picker.value
        submit(query)
    )
    clear.addEventListener("click" and given ignored:
        set query to Object()
        set query.operation to "select"
        set query.session to session
        set query.project to ""
        submit(query)
    )
    document.body.appendChild(dialog)
    dialog.showModal()
    set query to Object()
    set query.session to session
    set request to echo_api("/api/attachments" and query).then(given result:
        for each file in result.attachments:
            if file.lifecycle && file.lifecycle.state == "trashed":
                continue
            set control to Object()
            set control.attachment to file.attachment
            set control.sha256 to file.sha256
            set control.label to file.name
            dialog.echoFiles.push(control)
        return refresh("")
    )
    set catcher to get_list(request and "catch")
    catcher.call(request and given error:
        set error to echo_failure(error)
        set status.textContent to "Could not load projects: " + error + ". Close and retry."
    )
    return 0

# Render server-bound fetch receipts as text and retained local attachments.
# No remote page loads automatically and fetched HTML never becomes markup.
define echo_research_panel with sources:
    set panel to document.createElement("details")
    set heading to document.createElement("summary")
    set heading.textContent to "Web research (" + sources.length + ")"
    panel.appendChild(heading)
    set explanation to document.createElement("p")
    set explanation.textContent to "Fetched sources, not proof that every page was read or every claim verified. HTTP failures and search challenges can retain source files too. Open shows the retained copy; no remote page loads automatically."
    panel.appendChild(explanation)
    for each source in sources:
        set item to document.createElement("section")
        set title to document.createElement("p")
        set title.textContent to source.url + " — " + source.status
        set title.style.overflowWrap to "anywhere"
        item.appendChild(title)
        set receipt to document.createElement("p")
        set receipt.textContent to "Recorded result: " + source.observation + " · SHA-256: " + source.sha256
        set receipt.style.overflowWrap to "anywhere"
        item.appendChild(receipt)
        set file to Object.assign(Object() and source)
        set file.observation to null
        item.appendChild(echo_message_source(file))
        panel.appendChild(item)
    return panel

# Work is read-only here. Opening a panel never launches or cancels a job.
define echo_work_setup:
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to "Work"
    button.addEventListener("click" and given ignored:
        echo_catch(echo_ensure_session().then(given session:
            echo_work_dialog(session and button)
        ))
    )
    document.getElementById("history-sidebar").appendChild(button)
    return 0

define echo_work_dialog with session and opener:
    set query to null
    set request to null
    set catcher to null
    set record to null
    set line to null
    set detail to null
    set heading to null
    set dialog to document.createElement("dialog")
    dialog.setAttribute("aria-label" and "Conversation work")
    set dialog.style.cssText to "width:min(720px,calc(100vw - 32px));max-height:90vh;overflow:auto;background:var(--surface);color:var(--fg);border:1px solid var(--border);border-radius:18px;padding:24px"
    set title to document.createElement("h2")
    set title.textContent to "Conversation work"
    dialog.appendChild(title)
    set note to document.createElement("p")
    set note.textContent to "Saved run and schedule states for this conversation. Refresh to check for changes. A cancellation request is not a completed cancellation."
    dialog.appendChild(note)
    set family to document.createElement("select")
    family.setAttribute("aria-label" and "Work type")
    for each name in ["runs","schedules"]:
        set option to document.createElement("option")
        set option.value to name
        set option.textContent to name
        family.appendChild(option)
    dialog.appendChild(family)
    set amount to echo_project_field(dialog and "Rows per batch" and false)
    set amount.type to "number"
    set amount.min to "1"
    set amount.value to "20"
    set refresh to document.createElement("button")
    set refresh.textContent to "Refresh work"
    set next to document.createElement("button")
    set next.textContent to "Load more work"
    set status to document.createElement("p")
    status.setAttribute("role" and "status")
    set list to document.createElement("div")
    set close to document.createElement("button")
    set close.textContent to "Close"
    dialog.appendChild(refresh)
    dialog.appendChild(next)
    dialog.appendChild(status)
    dialog.appendChild(list)
    dialog.appendChild(close)
    set dialog.echoCursor to "0"
    set dialog.echoBusy to false
    set load to given reset:
        if dialog.echoBusy:
            return 0
        set query to Object()
        set query.session to session
        set query.family to family.value
        set query.after to Number(dialog.echoCursor)
        if reset:
            set query.after to 0
        set query.amount to Number(amount.value)
        if not Number.isSafeInteger(query.amount) || query.amount < 1:
            set status.textContent to "Choose a positive whole-number batch size."
            return 0
        set dialog.echoBusy to true
        set refresh.disabled to true
        set next.disabled to true
        set family.disabled to true
        set status.textContent to "Reading saved work…"
        set request to echo_api("/api/work" and query).then(given result:
            if reset:
                set list.textContent to ""
            for each item in result.entries:
                set record to document.createElement("section")
                set record.style.cssText to "padding:12px 0;border-bottom:1px solid var(--border);overflow-wrap:anywhere"
                set heading to document.createElement("strong")
                set heading.textContent to item.state + " · " + (item.instruction || item.run)
                record.appendChild(heading)
                set detail to document.createElement("details")
                set line to document.createElement("summary")
                set line.textContent to "Record details"
                detail.appendChild(line)
                for each key in Object.keys(item):
                    if key != "status" && key != "next_after":
                        set line to document.createElement("p")
                        set line.textContent to key.replaceAll("_" and " ") + ": " + get_list(item and key)
                        detail.appendChild(line)
                record.appendChild(detail)
                list.appendChild(record)
            set dialog.echoCursor to result.next_after
            set next.hidden to not result.more
            set status.textContent to "Checked " + Reflect.construct(Date and Array()).toLocaleTimeString() + ". " + list.children.length + " records shown."
            set dialog.echoBusy to false
            set refresh.disabled to false
            set next.disabled to false
            set family.disabled to false
        )
        set catcher to get_list(request and "catch")
        catcher.call(request and given error:
            set error to echo_failure(error)
            set status.textContent to "Could not refresh work: " + error + ". Displayed records may be stale."
            set dialog.echoBusy to false
            set refresh.disabled to false
            set next.disabled to false
            set family.disabled to false
        )
        return 0
    refresh.addEventListener("click" and given ignored:
        load(true)
    )
    family.addEventListener("change" and given ignored:
        load(true)
    )
    next.addEventListener("click" and given ignored:
        load(false)
    )
    close.addEventListener("click" and given ignored:
        dialog.close()
    )
    dialog.addEventListener("close" and given ignored:
        dialog.remove()
        opener.focus()
    )
    document.body.appendChild(dialog)
    dialog.showModal()
    load(true)
    return 0

# Settings presentation only: existing controls and their handlers are moved intact.
# Each category owns a section; more controls can be added without enlarging the header menu.
define echo_settings_section with navigation and content and title and description:
    set section to document.createElement("section")
    set section.className to "settings-section"
    set section.hidden to content.children.length > 0
    set heading to document.createElement("h3")
    set heading.textContent to title
    section.appendChild(heading)
    set detail to document.createElement("p")
    set detail.className to "settings-description"
    set detail.textContent to description
    section.appendChild(detail)
    set button to document.createElement("button")
    set button.type to "button"
    set button.textContent to title
    button.setAttribute("aria-current" and String(not section.hidden))
    button.addEventListener("click" and given event:
        for each sibling in content.children:
            set sibling.hidden to sibling != section
        for each sibling in navigation.children:
            sibling.setAttribute("aria-current" and String(sibling == button))
    )
    navigation.appendChild(button)
    content.appendChild(section)
    return section

define echo_settings_card with section and control and description:
    if not control:
        return 0
    set card to document.createElement("div")
    set card.className to "settings-card"
    card.appendChild(control)
    if description:
        set note to document.createElement("p")
        set note.textContent to description
        card.appendChild(note)
    section.appendChild(card)
    return 0

define echo_settings_setup:
    set menu to document.querySelector(".header-options")
    if not menu || document.getElementById("echo-settings"):
        return 0
    set summary to menu.querySelector("summary")
    set controls to menu.querySelector("div")
    set dialog to document.createElement("dialog")
    set dialog.id to "echo-settings"
    dialog.setAttribute("aria-labelledby" and "echo-settings-title")
    set heading to document.createElement("div")
    set heading.className to "settings-heading"
    set heading.innerHTML to "<div><h2 id='echo-settings-title'>Settings</h2><p>Make this space work for you.</p></div>"
    set close to document.createElement("button")
    set close.className to "settings-close"
    set close.type to "button"
    set close.textContent to "×"
    close.setAttribute("aria-label" and "Close settings")
    close.addEventListener("click" and given event:
        dialog.close()
    )
    heading.appendChild(close)
    dialog.appendChild(heading)
    set body to document.createElement("div")
    set body.className to "settings-body"
    set navigation to document.createElement("nav")
    set navigation.className to "settings-nav"
    navigation.setAttribute("aria-label" and "Settings categories")
    set content to document.createElement("div")
    set content.className to "settings-content"
    body.appendChild(navigation)
    body.appendChild(content)
    dialog.appendChild(body)
    set general to echo_settings_section(navigation and content and "Appearance" and "Choose how Echo looks on this browser.")
    echo_settings_card(general and controls.querySelector(".theme-control") and "System follows your device’s light or dark appearance. Your choice is saved automatically.")
    set conversation to echo_settings_section(navigation and content and "Conversations" and "Manage your conversation history and inspect its saved context.")
    set batch to document.getElementById("history-page-size")
    if batch:
        set batch.parentNode.firstChild.textContent to "Messages loaded at a time"
        echo_settings_card(conversation and batch.parentNode.parentNode and "Controls how many messages load at once. It does not limit Echo’s context or delete older messages.")
    set devices to null
    if controls.querySelector("#browser-access") || controls.querySelector("#device-link-panel"):
        set devices to echo_settings_section(navigation and content and "Devices & access" and "Continue across devices and check this browser’s access.")
        echo_settings_card(devices and controls.querySelector("#browser-access") and "")
        echo_settings_card(devices and controls.querySelector("#device-link-panel") and "")
    for each control in controls.querySelectorAll(":scope > *"):
        set description to ""
        if control.id == "export-session":
            set description to "Download a copy of the current conversation."
        if control.textContent == "Inspect recap":
            set description to "View the saved summary used to continue this conversation."
        echo_settings_card(conversation and control and description)
    set controls.hidden to true
    document.body.appendChild(dialog)
    set open to given ignored:
        if not dialog.open:
            dialog.showModal()
        set access to document.getElementById("browser-access")
        if access:
            echo_show_identity(access)
    summary.addEventListener("click" and given event:
        event.preventDefault()
        open()
    )
    menu.addEventListener("toggle" and given event:
        if menu.open:
            open()
            if devices:
                navigation.lastChild.click()
                set code to document.getElementById("device-link-code")
                if code:
                    code.focus()
            set menu.open to false
    )
    dialog.addEventListener("click" and given event:
        if event.target == dialog:
            set bounds to dialog.getBoundingClientRect()
            if event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom:
                dialog.close()
    )
    dialog.addEventListener("close" and given event:
        summary.focus()
    )
    set style to document.createElement("style")
    set style.textContent to "#echo-settings{padding:0;width:min(880px,calc(100vw - 40px));height:min(560px,calc(100dvh - 64px));max-width:none;max-height:none;border:1px solid var(--composer-line);border-radius:24px;background:var(--surface);color:var(--fg);box-shadow:0 32px 100px #0006;overflow:hidden}#echo-settings::backdrop{background:#05080db3;backdrop-filter:blur(7px)}.settings-heading{display:flex;justify-content:space-between;align-items:center;padding:24px 28px;border-bottom:1px solid var(--line)}.settings-heading h2{font-size:22px;letter-spacing:-.6px;margin:0}.settings-heading p{color:var(--muted);font-size:13px;margin:6px 0 0}.settings-close{border:1px solid var(--line);background:transparent;width:36px;height:36px;padding:0;font-size:22px}.settings-body{display:grid;grid-template-columns:190px minmax(0,1fr);height:calc(100% - 100px)}.settings-nav{padding:20px 12px;background:var(--sidebar);border-right:1px solid var(--line);overflow:auto}.settings-nav button{display:block;text-align:left;width:100%;padding:12px 14px;margin:3px 0;border:1px solid transparent;background:transparent;color:var(--soft);font-size:13px}.settings-nav button[aria-current=true]{background:var(--selected);color:var(--accent);border-color:var(--line)}.settings-content{overflow:auto;padding:28px;overscroll-behavior:contain}.settings-section{margin:0}.settings-section h3{margin:0 0 7px;font-size:19px;letter-spacing:-.3px}.settings-description{color:var(--muted);font-size:13px;line-height:1.6;margin:0 0 24px}.settings-card{padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--bg);margin:12px 0;overflow-wrap:anywhere}.settings-card>p{font-size:12px;line-height:1.6;color:var(--muted);margin:8px 0 0}.settings-card label{font-size:13px;line-height:1.5;margin:0 0 10px}.settings-card .theme-control{display:flex;justify-content:space-between;margin:0;gap:20px}.settings-card input{max-width:100%;font-size:14px}.settings-card:has(>[hidden]:only-child){display:none}.settings-card input[type=number]{display:block;width:100px;margin-top:8px}.settings-card select{min-width:130px;border:1px solid var(--border);font-size:13px}.settings-card>button{width:100%;text-align:left;border:0;background:transparent;padding:0;color:var(--fg);font-size:14px;font-weight:550}.settings-card>button:hover{color:var(--accent)}#echo-settings #device-link-panel{margin:0}#echo-settings #device-link-panel input{max-width:none}#echo-settings #browser-access{margin:0;font-size:12px!important;line-height:1.8;color:var(--soft)}@media(max-width:600px){#echo-settings{width:calc(100vw - 16px);height:calc(100dvh - 24px);border-radius:20px}.settings-heading{padding:20px}.settings-heading p{font-size:12px}.settings-body{display:flex;flex-direction:column;height:calc(100% - 94px)}.settings-nav{display:flex;flex-shrink:0;gap:6px;padding:10px 12px;border-right:0;border-bottom:1px solid var(--line);overflow-x:auto}.settings-nav button{width:auto;white-space:nowrap;margin:0;padding:10px 13px}.settings-content{padding:22px 18px;flex:1;min-height:0}.settings-card{padding:16px}.settings-card button{min-height:32px}.settings-close{min-width:36px}}"
    document.head.appendChild(style)
    return 0

# One dismissal path for the mobile conversation drawer.
define echo_sidebar_dismiss_setup:
    set sidebar to document.getElementById("history-sidebar")
    set original to document.getElementById("nav-toggle")
    if not sidebar || not original:
        return 0
    set toggle to original.cloneNode(true)
    original.replaceWith(toggle)
    set close to given ignored:
        sidebar.setAttribute("data-open" and "false")
        toggle.setAttribute("aria-expanded" and "false")
    toggle.addEventListener("click" and given event:
        event.preventDefault()
        set opened to sidebar.getAttribute("data-open") != "true"
        sidebar.setAttribute("data-open" and String(opened))
        toggle.setAttribute("aria-expanded" and String(opened))
    )
    document.addEventListener("pointerdown" and given event:
        if sidebar.getAttribute("data-open") == "true" && not sidebar.contains(event.target) && not toggle.contains(event.target):
            close()
    )
    document.addEventListener("keydown" and given event:
        if event.key == "Escape" && sidebar.getAttribute("data-open") == "true":
            close()
            toggle.focus()
    )
    set dismiss to document.createElement("button")
    set dismiss.type to "button"
    set dismiss.id to "sidebar-close"
    set dismiss.textContent to "Close menu ×"
    dismiss.addEventListener("click" and given event:
        close()
        toggle.focus()
    )
    sidebar.prepend(dismiss)
    set style to document.createElement("style")
    set style.textContent to "#history-sidebar>#sidebar-close{display:none}@media(max-width:800px){#history-sidebar>#sidebar-close{display:block;margin-bottom:12px;background:transparent;color:var(--muted);text-align:right;border:0;padding:8px}#nav-toggle{position:relative;z-index:22;flex-shrink:0}#history-sidebar{max-height:100%;overscroll-behavior:contain}}"
    document.head.appendChild(style)
    return 0

# Delegated sessions retain isolated storage but are presented inside the parent chat.
define echo_agent_panel_load with panel:
    if panel.echoLoading || not panel.open:
        return 0
    set panel.echoLoading to true
    set query to Object()
    set query.session to panel.echoSession
    set query.before to panel.echoBefore || "0"
    set query.messages to 50
    set request to echo_api("/api/session" and query).then(given result:
        set panel.echoLoading to false
        if result.status != "found":
            set panel.echoStatus.textContent to String(echo_failure(result))
            return 0
        set signature to JSON.stringify(result.messages)
        if query.before == "0" && panel.echoSignature == signature:
            return 0
        if query.before == "0":
            set panel.echoBody.textContent to ""
            set panel.echoSignature to signature
        set batch to document.createElement("div")
        for each message in result.messages:
            set block to document.createElement("div")
            set label to document.createElement("strong")
            set label.textContent to "Agent result"
            if message.role == "user":
                set label.textContent to "Delegated task"
            set text to document.createElement("div")
            set text.className to "message-text"
            set text.textContent to message.text
            if message.role == "assistant":
                echo_format_response(text and message.text)
            block.appendChild(label)
            block.appendChild(text)
            batch.appendChild(block)
        if query.before == "0":
            panel.echoBody.appendChild(batch)
        else:
            panel.echoBody.prepend(batch)
        set panel.echoBefore to "0"
        set panel.echoOlderCursor to result.next_before
        set panel.echoOlder.hidden to not result.older_possible
    )
    get_list(request and "catch").call(request and given error:
        set error to echo_failure(error)
        set panel.echoLoading to false
        set panel.echoStatus.textContent to "Could not read agent output: " + String(error) + ". Reopen to retry."
    )
    return 0

define echo_agents_refresh:
    set request to null
    set panel to null
    set heading to null
    set status to null
    set body to null
    set older to null
    set owner to null
    set holder to null
    set error_panel to null
    if not window.echoSession || window.echoAgentsLoading || document.hidden:
        return 0
    set session to window.echoSession
    set window.echoAgentsLoading to true
    set query to Object()
    set query.session to session
    set query.family to "runs"
    set query.after to 0
    set query.amount to 50
    set load to given ignored:
        set request to echo_api("/api/work" and query).then(given result:
            if session != window.echoSession:
                set window.echoAgentsLoading to false
                return 0
            set error_panel to document.getElementById("agent-connection-status")
            if error_panel:
                error_panel.remove()
            for each item in result.entries || Array():
                if not item.parent_run:
                    continue
                set panel to window.echoAgentPanels.get(item.run)
                if not panel:
                    set panel to document.createElement("details")
                    set panel.className to "thinking delegated-agent"
                    set heading to document.createElement("summary")
                    panel.appendChild(heading)
                    set panel.echoHeading to heading
                    set status to document.createElement("p")
                    set panel.echoStatus to status
                    panel.appendChild(status)
                    set body to document.createElement("div")
                    set body.className to "agent-results"
                    panel.appendChild(body)
                    set panel.echoBody to body
                    set panel.echoSession to item.session
                    set older to document.createElement("button")
                    set older.type to "button"
                    set older.textContent to "Read earlier agent messages"
                    set older.hidden to true
                    set panel.echoOlder to older
                    panel.appendChild(older)
                    echo_agent_panel_bind(panel and older)
                    panel.appendChild(echo_thinking_panel(item.run))
                    get_list(window.echoAgentPanels and "set").call(window.echoAgentPanels and item.run and panel)
                set panel.echoHeading.textContent to "Agent · " + (item.activity || item.state.replaceAll("_" and " "))
                set panel.echoStatus.textContent to "Delegated work · Results return to Echo in this conversation."
                if item.compaction && item.compaction.state == "pending":
                    if item.worker_status == "running":
                        set panel.echoHeading.textContent to "Agent · Compacting context"
                        set panel.echoStatus.textContent to item.activity + ". Original records and completed work remain saved; the agent will continue after the recap is checked."
                    else:
                        set panel.echoHeading.textContent to "Agent · Recap saved, waiting to resume"
                        set panel.echoStatus.textContent to "Completed work is retained. Waiting for a worker to continue compaction."
                set owner to null
                for each article in document.getElementById("transcript").children:
                    if article.echoEvent == item.parent_objective:
                        set owner to article
                if owner:
                    if panel.parentNode != owner:
                        owner.appendChild(panel)
                else:
                    set holder to document.getElementById("delegated-agents")
                    if panel.parentNode != holder:
                        holder.appendChild(panel)
                if panel.open:
                    echo_agent_panel_load(panel)
                    echo_trace_load(panel.querySelector("details.thinking"))
            if result.more == true || result.more == "true":
                set query.after to Number(result.next_after)
                load()
            else:
                set window.echoAgentsLoading to false
        )
        get_list(request and "catch").call(request and given error:
            set error to echo_failure(error)
            set window.echoAgentsLoading to false
            if session != window.echoSession:
                return 0
            set error_panel to document.getElementById("agent-connection-status")
            if not error_panel:
                set error_panel to document.createElement("p")
                set error_panel.id to "agent-connection-status"
                error_panel.setAttribute("role" and "status")
                document.getElementById("delegated-agents").appendChild(error_panel)
            set error_panel.textContent to "Reconnecting to agent activity… Your saved work is retained. " + String(error)
        )
    load()
    return 0

define echo_agent_panel_bind with panel and older:
    panel.addEventListener("toggle" and given event:
        if event.target == panel && panel.open:
            echo_agent_panel_load(panel)
    )
    older.addEventListener("click" and given event:
        set panel.echoBefore to panel.echoOlderCursor
        echo_agent_panel_load(panel)
    )
    return 0

define echo_agents_setup:
    set window.echoAgentPanels to Reflect.construct(Map and Array())
    set holder to document.createElement("div")
    set holder.id to "delegated-agents"
    document.getElementById("composer").before(holder)
    set previous to window.echoSession
    window.setInterval(given ignored:
        if previous != window.echoSession:
            for each panel in window.echoAgentPanels.values():
                panel.remove()
            window.echoAgentPanels.clear()
            set previous to window.echoSession
        echo_agents_refresh()
    and 3000)
    set style to document.createElement("style")
    set style.textContent to ".delegated-agent{background:var(--surface);border-color:var(--composer-line);color:var(--fg)}.delegated-agent>summary{font-weight:600}.delegated-agent>p{color:var(--muted);font-size:12px}.agent-results{max-height:55vh;overflow:auto;overscroll-behavior:contain}.agent-results>div>div{padding:14px 0;border-bottom:1px solid var(--line)}.agent-results strong{font-size:12px;color:var(--accent)}.agent-results .message-text{font-size:13px;margin-top:8px}.delegated-agent>button{font-size:12px;margin-top:12px}"
    document.head.appendChild(style)
    echo_agents_refresh()
    return 0

# Durable mid-task questions. Defaults are local UI state only; only the Send
# answers button produces authenticated guidance for the running task.
define echo_interaction_clear:
    set steering to document.getElementById("steering-status")
    if steering:
        set steering.hidden to true
        set steering.textContent to ""
    set panel to document.getElementById("echo-interaction")
    if panel:
        panel.remove()
    set window.echoQuestionRequest to ""
    set window.echoAutonomy to false

define echo_interaction_render with result:
    set styles to document.getElementById("echo-interaction-style")
    if not styles:
        set styles to document.createElement("style")
        set styles.id to "echo-interaction-style"
        set styles.textContent to "#echo-interaction{margin:16px 0;padding:22px;border:1px solid var(--composer-line);border-radius:22px;background:var(--surface);color:var(--fg);scroll-margin-top:18px}#echo-interaction[hidden]{display:none}#workspace:has(#echo-interaction fieldset) #composer{position:relative;bottom:auto}#echo-interaction h3{font-size:17px;font-weight:600;letter-spacing:-.3px;margin:0 0 7px}#echo-interaction .question-note{font-size:12px;line-height:1.6;color:var(--muted);margin:0 0 20px}#echo-interaction fieldset{border:0;padding:0;margin:0 0 20px;min-width:0}#echo-interaction legend{font-size:14px;font-weight:600;line-height:1.5;margin:0 0 9px;padding:0}#echo-interaction .question-options{display:flex;flex-wrap:wrap;gap:8px}#echo-interaction .question-option{display:inline-flex;gap:8px;align-items:center;min-height:40px;padding:8px 12px;margin:0;box-sizing:border-box;border:1px solid var(--composer-line);border-radius:10px;background:transparent;cursor:pointer;font-size:13px;line-height:1.4}#echo-interaction .question-option:hover{background:var(--button)}#echo-interaction .question-option:has(input:checked){background:var(--selected);border-color:var(--accent)}#echo-interaction .question-option:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:3px}#echo-interaction input[type=radio]{width:15px;height:15px;min-height:0;padding:0;margin:0;flex:none;accent-color:var(--accent)}#echo-interaction textarea{display:block;width:100%;box-sizing:border-box;margin:10px 0 0;min-height:78px;padding:12px 14px;border:1px solid var(--composer-line);border-radius:12px;background:var(--bg);color:var(--fg);font:inherit;font-size:14px;line-height:1.5;resize:vertical}#echo-interaction textarea[hidden]{display:none}#echo-interaction .question-footer{display:flex;gap:16px;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:16px}#echo-interaction .question-feedback{font-size:12px;line-height:1.5;color:var(--muted);margin:0;flex:1}#echo-interaction .question-submit{background:var(--accent);color:var(--on-accent);border:0;border-radius:12px;font-size:13px;font-weight:600;padding:11px 17px;min-height:40px;flex-shrink:0}#echo-interaction .autonomy-bar{display:flex;gap:16px;align-items:center;justify-content:space-between}#echo-interaction .autonomy-bar:has(+h3){padding-bottom:18px;margin-bottom:20px;border-bottom:1px solid var(--line)}#echo-interaction .autonomy-label{margin:0;font-size:13px;line-height:1.5;color:var(--soft)}#echo-interaction .autonomy-stop{font-size:12px;padding:9px 12px;border:1px solid var(--composer-line);border-radius:10px;background:transparent;white-space:nowrap}@media(max-width:800px){#echo-interaction{padding:18px;border-radius:18px}#echo-interaction .question-options{gap:7px}#echo-interaction .autonomy-bar{align-items:flex-start}}"
        document.head.appendChild(styles)
    set panel to document.getElementById("echo-interaction")
    if not panel:
        set panel to document.createElement("section")
        set panel.id to "echo-interaction"
        panel.setAttribute("aria-label" and "Active task controls")
        set composer to document.getElementById("composer")
        composer.parentNode.insertBefore(panel and composer)
    set window.echoAutonomy to result.autonomy == true
    set question to result.user_input
    if question && question.status:
        echo_note("Question state unavailable. Reconnecting…")
        return 0
    set identity to result.run + ":" + String(result.autonomy) + ":" + (result.autonomy_goal || "") + ":" + String(result.can_control) + ":" + (question && question.request || "")
    if panel.echoIdentity == identity:
        return 0
    set panel.echoIdentity to identity
    set panel.textContent to ""
    set panel.hidden to not result.autonomy && not question
    set window.echoQuestionRequest to question && question.request || ""
    if result.autonomy:
        set autonomy_bar to document.createElement("div")
        set autonomy_bar.className to "autonomy-bar"
        panel.appendChild(autonomy_bar)
        set label to document.createElement("p")
        set label.textContent to "Free autonomy · Echo chooses what to work on"
        if result.autonomy_goal:
            set label.textContent to "Task autonomy · " + result.autonomy_goal
        set label.className to "autonomy-label"
        autonomy_bar.appendChild(label)
        set stop_button to document.createElement("button")
        set stop_button.type to "button"
        set stop_button.textContent to "Turn autonomy off"
        set stop_button.disabled to result.can_control == false
        stop_button.addEventListener("click" and given event:
            echo_autonomy_command(false)
        )
        set stop_button.className to "autonomy-stop"
        autonomy_bar.appendChild(stop_button)
    if not question:
        return 0
    set title to document.createElement("h3")
    set title.textContent to "Echo has a few questions"
    panel.appendChild(title)
    set note to document.createElement("p")
    set note.className to "question-note"
    set note.textContent to "Choose an answer or add your own. Echo will continue when you send your answers."
    panel.appendChild(note)
    set storage to "echo.questions:" + question.request
    set drafts to JSON.parse(window.localStorage.getItem(storage) || "{}")
    set answers to Array()
    for each item in question.questions:
        answers.push(echo_question_field(item and question and result and panel and drafts and storage))
    set footer to document.createElement("div")
    set footer.className to "question-footer"
    panel.appendChild(footer)
    set feedback to document.createElement("p")
    set feedback.className to "question-feedback"
    feedback.setAttribute("role" and "status")
    footer.appendChild(feedback)
    set submit to document.createElement("button")
    set submit.type to "button"
    set submit.textContent to "Send answers"
    set submit.className to "question-submit"
    set submit.disabled to result.can_control == false
    submit.addEventListener("click" and given event:
        echo_question_submit(result and question and answers and submit and feedback and storage)
    )
    footer.appendChild(submit)
    set scroll_options to Object()
    set scroll_options.block to "start"
    panel.scrollIntoView(scroll_options)
    return 0

define echo_autonomy_command with enabled:
    if window.echoReadOnly || not window.echoToken || (enabled && (not window.echoRun || not window.echoCanStop)):
        echo_note("There is no active task to change. Send /auto to start autonomy.")
        return 0
    set payload to Object()
    set payload.run to window.echoRun
    set payload.identity to window.crypto.randomUUID()
    set payload.enabled to enabled
    if not enabled:
        set payload.run to ""
    set payload.goal to ""
    if enabled:
        set payload.goal to document.getElementById("message").value.trim().slice(5).trim()
    set input to document.getElementById("message")
    set sent to echo_api("/api/autonomy" and payload).then(given result:
        if result.status != "accepted":
            return Promise.reject(echo_failure(result))
        echo_autonomy_refresh()
        echo_sessions()
        if not enabled || window.echoRun == payload.run:
            if input.value.trim() == "/autoOff" || input.value.trim().startsWith("/auto"):
                set input.value to ""
                window.localStorage.setItem("echo.composer:" + window.echoSession and "")
            if enabled:
                echo_note("Continuous autonomy enabled.")
            else:
                echo_note("Autonomy off. Stopping the active task…")
            echo_poll()
    )
    echo_catch(sent)
    return 0

define echo_question_field with item and question and result and panel and drafts and storage:
    set question_group to document.createElement("fieldset")
    set legend to document.createElement("legend")
    set legend.textContent to item.title
    question_group.appendChild(legend)
    set answer to Object()
    set answer.id to item.id
    set saved to get_list(drafts and "question:" + item.id)
    set answer.choice to -1
    if item.options.length > 0:
        set answer.choice to 0
    if saved && Number.isInteger(saved.choice) && saved.choice >= -1 && saved.choice < item.options.length:
        set answer.choice to saved.choice
    set answer.text to saved && saved.text || ""
    set free_answer to document.createElement("textarea")
    set free_answer.value to answer.text
    set free_answer.rows to 3
    set free_answer.placeholder to "Type your answer…"
    free_answer.setAttribute("aria-label" and item.title + " — Other answer")
    set free_answer.hidden to answer.choice != -1
    set free_answer.disabled to result.can_control == false || answer.choice != -1
    set options_row to document.createElement("div")
    set options_row.className to "question-options"
    question_group.appendChild(options_row)
    set index to 0
    set labels to item.options.slice()
    if item.options.length > 0:
        labels.push("Other")
    for each option in labels:
        set choice to index
        if index == item.options.length:
            set choice to -1
        echo_question_option(options_row and option and choice and answer and free_answer and drafts and storage and item and question and result)
        set index to index + 1
    set save_draft to get_list(Reflect and "set")
    free_answer.addEventListener("input" and given event:
        set answer.text to free_answer.value
        save_draft(drafts and "question:" + item.id and answer)
        window.localStorage.setItem(storage and JSON.stringify(drafts))
    )
    question_group.appendChild(free_answer)
    panel.appendChild(question_group)
    return answer

define echo_question_option with question_group and option and choice and answer and free_answer and drafts and storage and item and question and result:
    set row to document.createElement("label")
    set row.className to "question-option"
    set radio to document.createElement("input")
    set radio.type to "radio"
    set radio.name to question.request + ":" + item.id
    set radio.checked to answer.choice == choice
    set radio.disabled to result.can_control == false
    set save_draft to get_list(Reflect and "set")
    radio.addEventListener("change" and given event:
        set answer.choice to choice
        set free_answer.disabled to choice != -1
        set free_answer.hidden to choice != -1
        save_draft(drafts and "question:" + item.id and answer)
        window.localStorage.setItem(storage and JSON.stringify(drafts))
        if choice == -1:
            free_answer.focus()
    )
    row.appendChild(radio)
    set text to document.createElement("span")
    set text.textContent to option
    row.appendChild(text)
    question_group.appendChild(row)
    return 0

define echo_question_submit with result and question and answers and submit and feedback and storage:
    if window.echoRun != result.run || window.echoQuestionRequest != question.request:
        return 0
    set payload to Object()
    set payload.run to result.run
    set payload.request to question.request
    set payload.answers to Array()
    for each answer in answers:
        if answer.choice == -1 && not answer.text.trim():
            set feedback.textContent to "Please type an answer for each Other choice."
            return 0
        set response to Object()
        set response.id to answer.id
        set response.choice to answer.choice
        set response.text to ""
        if answer.choice == -1:
            set response.text to answer.text
        payload.answers.push(response)
    set submit.disabled to true
    set feedback.textContent to "Sending answers…"
    set sent to echo_api("/api/question-answer" and payload).then(given received:
        if received.status != "answer-received":
            return Promise.reject(echo_failure(received))
        window.localStorage.removeItem(storage)
        if window.echoRun == result.run:
            set feedback.textContent to "Answers received. Echo is continuing."
            echo_poll()
    )
    set catcher to get_list(sent and "catch")
    catcher.call(sent and given error:
        set submit.disabled to false
        set feedback.textContent to "Answers were not confirmed. Your choices are kept; retry to check the same answer. " + String(error)
    )
    return 0

# A global, account-scoped indicator makes background autonomy visible without
# taking over the current conversation or changing its draft.
define echo_autonomy_refresh:
    if not window.echoToken || window.echoReadOnly || window.echoAutonomyWatching:
        return 0
    set window.echoAutonomyWatching to true
    set token to window.echoToken
    set loaded to echo_api("/api/autonomy-status" and Object()).then(given result:
        set window.echoAutonomyWatching to false
        if token != window.echoToken:
            return 0
        set window.echoAutonomyLocation to result
        echo_autonomy_location_render(result)
    )
    set catcher to get_list(loaded and "catch")
    catcher.call(loaded and given ignored:
        set window.echoAutonomyWatching to false
    )
    return 0

define echo_autonomy_location_render with result:
    set panel to document.getElementById("echo-autonomy-location")
    if not panel:
        set panel to document.createElement("div")
        set panel.id to "echo-autonomy-location"
        set panel.style.cssText to "display:flex;gap:12px;align-items:center;flex-wrap:wrap;padding:12px 16px;margin:12px 0;border:1px solid var(--composer-line);border-radius:14px;background:var(--surface);font-size:12px;color:var(--soft);"
        set composer to document.getElementById("composer")
        composer.parentNode.insertBefore(panel and composer)
    set panel.hidden to result.status != "found" || result.run == window.echoRun
    if panel.hidden:
        set panel.style.display to "none"
        return 0
    set panel.style.display to "flex"
    set identity to result.run + ":" + (result.goal || "") + ":" + (result.title || "")
    if panel.echoIdentity == identity:
        return 0
    set panel.echoIdentity to identity
    set panel.textContent to ""
    set label to document.createElement("span")
    set label.textContent to "Autonomy is running in another conversation"
    if result.goal:
        set label.textContent to "Task autonomy is running in another conversation"
    set label.style.flex to "1"
    panel.appendChild(label)
    set open_button to document.createElement("button")
    set open_button.type to "button"
    set open_button.textContent to "Open conversation"
    set open_button.style.cssText to "font-size:12px;padding:9px 12px;border:1px solid var(--composer-line);background:transparent;"
    open_button.addEventListener("click" and given event:
        echo_open_session(result)
    )
    panel.appendChild(open_button)
    set off_button to document.createElement("button")
    set off_button.type to "button"
    set off_button.textContent to "Turn autonomy off"
    set off_button.style.cssText to "font-size:12px;padding:9px 12px;border:1px solid var(--composer-line);background:transparent;"
    off_button.addEventListener("click" and given event:
        echo_autonomy_command(false)
    )
    panel.appendChild(off_button)
    return 0
