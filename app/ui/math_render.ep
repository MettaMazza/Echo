# All renderer controls remain authored in English. Original equation text stays
# visible until a worker result arrives; cancellation keeps it available.
define echo_math_cancel_all:
    if window.echoMathWorkers:
        for each worker in window.echoMathWorkers:
            worker.terminate()
    set window.echoMathWorkers to Array()
    return 0

define echo_math_render with element:
    set formulas to element.querySelectorAll(".echo-equation,.math-source")
    if formulas.length == 0 || not window.Worker:
        return 0
    if not window.echoMathWorkers:
        set window.echoMathWorkers to Array()
    set worker to Reflect.construct(window.Worker and ["/assets/math-worker.js"])
    window.echoMathWorkers.push(worker)
    set pending to formulas.length
    set position to -1
    set formula to null
    set cancel_button to document.createElement("button")
    set cancel_button.type to "button"
    set cancel_button.textContent to "Stop math rendering"
    element.appendChild(cancel_button)
    set finish to given ignored:
        worker.terminate()
        set position to window.echoMathWorkers.indexOf(worker)
        if position >= 0:
            window.echoMathWorkers.splice(position and 1)
        cancel_button.remove()
    cancel_button.addEventListener("click" and given event:
        finish()
        echo_note("Math rendering stopped. Original expressions remain available.")
    )
    set worker.onerror to given event:
        finish()
        echo_note("Math rendering failed. Original expressions remain available.")
    set worker.onmessage to given event:
        set formula to get_list(formulas and event.data.identity)
        if formula:
            set formula.innerHTML to event.data.html
        set pending to pending - 1
        if pending == 0:
            finish()
    set index to 0
    for each formula in formulas:
        set source to formula.textContent.trim()
        set opening to source.slice(0 and 2)
        set closing to source.slice(-2)
        if not ((opening == "\\(" && closing == "\\)") || (opening == "\\[" && closing == "\\]") || (opening == "$$" && closing == "$$")):
            set pending to pending - 1
            set index to index + 1
            continue
        set request to Object()
        set request.identity to index
        set request.display to source.slice(0 and 2) != "\\("
        set request.source to source.slice(2 and -2)
        worker.postMessage(request)
        set index to index + 1
    if pending == 0:
        finish()
    return 0
