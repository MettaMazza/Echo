import "discord/background_recovery"

# Explicit maintenance entry point; no direct ledger edits or model prompt.
# Recovery verifies origin and native ownership before any new worker claim.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set journal to discord_store_open(get_argument(1) and get_argument(3))
    set database to discord_agent_open(get_argument(2) and get_argument(3))
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0:
        return 2
    set result to discord_background_recover(journal and database and get_argument(4))
    display archive_list_text(result and 0)
    set closed to sql_close(database)
    set closed to sql_close(journal)
    if not (archive_list_text(result and 0) equals "recovered"):
        return 3
    return 0
