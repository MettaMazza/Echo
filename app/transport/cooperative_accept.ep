import "socket_write"

# One server owner accepts from this nonblocking listener. Idle readiness waits
# cooperate with other workers; transient interruptions never stop the server.
define local_socket_accept_cooperative with listener as List returning Int:
    set library to get_list(listener and 0)
    if socket_make_nonblocking(library and get_list(listener and 1)) is not equal to 0:
        return -1
    repeat while 1 equals 1:
        if socket_wait_readable(library and get_list(listener and 1) and -1) is not equal to 1:
            return -1
        set descriptor to local_socket_accept(listener)
        if descriptor is greater than -1:
            return descriptor
        set error to socket_errno(library)
        if error is not equal to 4 and error is not equal to 35:
            return -1
    return -1
