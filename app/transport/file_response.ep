import "../retained_text"
import "socket_write"

# The caller supplies only an ownership-resolved host path and recorded size.
# Raw bounded reads preserve binary bytes without buffering the whole file.
define file_response with library as Int and socket as Int and path as Str and bytes as Int and batch as Int returning Int:
    return file_response_typed(library and socket and path and bytes and batch and "application/octet-stream" and 1)

# Media type is supplied by host code, never copied from a request header.
define file_response_typed with library as Int and socket as Int and path as Str and bytes as Int and batch as Int and media as Str and download as Int returning Int:
    if bytes is less than 0 or else batch is less than 1:
        return 1
    set open_function to ep_dlsym(library and "open")
    set read_function to ep_dlsym(library and "read")
    set allocate to ep_dlsym(library and "malloc")
    set release to ep_dlsym(library and "free")
    set descriptor to socket_signed_result(ep_dlcall2(open_function and str_to_ptr(path) and 16777472))
    if descriptor is less than 0:
        set head to "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"
        set sent to socket_write_all(library and socket and -1 and str_to_ptr(head) and string_length(head))
        return 1
    set buffer to ep_dlcall1(allocate and batch)
    if buffer equals 0:
        set closed to net_close(descriptor)
        return 1
    set head to concat("HTTP/1.1 200 OK\r\nContent-Type: " and media)
    if download equals 1:
        set head to concat(head and "\r\nContent-Disposition: attachment")
    set head to concat(head and concat("\r\nContent-Length: " and int_to_string(bytes)))
    set head to concat(head and "\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n")
    set sent to socket_write_all(library and socket and -1 and str_to_ptr(head) and string_length(head))
    set status to 0
    if not (archive_list_text(sent and 0) equals "sent"):
        set status to 1
    set remaining to bytes
    repeat while status equals 0 and remaining is greater than 0:
        set wanted to batch
        if remaining is less than wanted:
            set wanted to remaining
        set count to ep_dlcall3(read_function and descriptor and buffer and wanted)
        if count is less than 0 or else count is greater than wanted:
            if socket_errno(library) equals 4:
                continue
            set status to 1
        else if count equals 0:
            set status to 1
        else:
            set sent to socket_write_all(library and socket and -1 and buffer and count)
            if not (archive_list_text(sent and 0) equals "sent"):
                set status to 1
            set remaining to remaining - count
    set freed to ep_dlcall1(release and buffer)
    if net_close(descriptor) is not equal to 0:
        set status to 1
    return status
