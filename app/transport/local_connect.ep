import "socket_write"

# Darwin loopback client. Nonblocking connect waits on the same cancellation
# signal as reads/writes; no application connection deadline is imposed.
# Caller owns the library; a successful descriptor transfers to the caller.
define local_socket_connect with library as Int and port as Int and cancellation_reader as Int returning List:
    if not (ptr_to_str(os_name()) equals "macos") or else port is less than 1 or else port is greater than 65535:
        return socket_write_result("error" and -1)
    set socket_function to ep_dlsym(library and "socket")
    set connect_function to ep_dlsym(library and "connect")
    set option_function to ep_dlsym(library and "getsockopt")
    if socket_function equals 0 or else connect_function equals 0 or else option_function equals 0:
        return socket_write_result("error" and -1)
    set descriptor to socket_signed_result(ep_dlcall3(socket_function and 2 and 1 and 0))
    if descriptor is less than 0:
        return socket_write_result("error" and -1)
    if socket_make_nonblocking(library and descriptor) is not equal to 0:
        set closed to net_close(descriptor)
        return socket_write_result("error" and -1)
    set address to create_list()
    set packed to 16 + 2 * 256 + (port / 256) * 65536 + (port modulo 256) * 16777216 + 127 * 4294967296 + 72057594037927936
    set added to append_list(address and packed)
    set added to append_list(address and 0)
    set result to socket_signed_result(ep_dlcall3(connect_function and descriptor and get_list_data_ptr(address) and 16))
    if result is not equal to 0:
        set error_number to socket_errno(library)
        if error_number is not equal to 36 and error_number is not equal to 4:
            set closed to net_close(descriptor)
            return socket_write_result("connect-error" and -1)
    set ready to socket_wait_event(library and descriptor and cancellation_reader and 4)
    if ready is not equal to 1:
        set closed to net_close(descriptor)
        if ready equals 0:
            return socket_write_result("cancelled" and -1)
        return socket_write_result("connect-error" and -1)
    set error to create_list()
    set added to append_list(error and 0)
    set size to create_list()
    set added to append_list(size and 4)
    if socket_signed_result(ep_dlcall5(option_function and descriptor and 65535 and 4103 and get_list_data_ptr(error) and get_list_data_ptr(size))) is not equal to 0 or else get_list(error and 0) is not equal to 0:
        set closed to net_close(descriptor)
        return socket_write_result("connect-error" and -1)
    return socket_write_result("connected" and descriptor)
