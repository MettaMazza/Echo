import "diagnostics"
import "socket_read"

# Each HTTP request and model worker gets a fresh Ernos heap. Only an explicitly
# selected socket and standard output/error cross the process boundary.
define echo_process_start with arguments as List and descriptor as Int returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set actions to create_list()
    set added to append_list(actions and 0)
    set attributes to create_list()
    set added to append_list(attributes and 0)
    set initialize to ep_dlsym(library and "posix_spawn_file_actions_init")
    set initialize_attributes to ep_dlsym(library and "posix_spawnattr_init")
    if ep_dlcall1(initialize and get_list_data_ptr(actions)) is not equal to 0:
        return -1
    if ep_dlcall1(initialize_attributes and get_list_data_ptr(attributes)) is not equal to 0:
        return -1
    set inherit to ep_dlsym(library and "posix_spawn_file_actions_addinherit_np")
    set duplicate to ep_dlsym(library and "posix_spawn_file_actions_adddup2")
    set flags to ep_dlsym(library and "posix_spawnattr_setflags")
    set defaults_function to ep_dlsym(library and "posix_spawnattr_setsigdefault")
    set defaults to create_list()
    set added to append_list(defaults and 4294967295)
    set failed to ep_dlcall2(inherit and get_list_data_ptr(actions) and 1)
    set failed to failed + ep_dlcall2(inherit and get_list_data_ptr(actions) and 2)
    if descriptor >= 0:
        set failed to failed + ep_dlcall3(duplicate and get_list_data_ptr(actions) and descriptor and 3)
    set failed to failed + ep_dlcall2(flags and get_list_data_ptr(attributes) and 16388)
    set failed to failed + ep_dlcall2(defaults_function and get_list_data_ptr(attributes) and get_list_data_ptr(defaults))
    set executable to get_argument(0)
    set argv to create_list()
    set added to append_list(argv and executable)
    set index to 0
    repeat while index < length_list(arguments):
        set added to append_list(argv and get_list(arguments and index))
        set index to index + 1
    set added to append_list(argv and 0)
    set environment to create_list()
    set added to append_list(environment and 0)
    set environment_function to ep_dlsym(library and "_NSGetEnviron")
    set copy_function to ep_dlsym(library and "memcpy")
    set environment_pointer to ep_dlcall0(environment_function)
    set copied to ep_dlcall3(copy_function and get_list_data_ptr(environment) and environment_pointer and 8)
    set process to create_list()
    set added to append_list(process and 0)
    set launch to ep_dlsym(library and "posix_spawn")
    if failed equals 0:
        set failed to ep_dlcall6(launch and get_list_data_ptr(process) and str_to_ptr(executable) and get_list_data_ptr(actions) and get_list_data_ptr(attributes) and get_list_data_ptr(argv) and get_list(environment and 0))
    set destroy to ep_dlsym(library and "posix_spawn_file_actions_destroy")
    set destroyed to ep_dlcall1(destroy and get_list_data_ptr(actions))
    set destroy to ep_dlsym(library and "posix_spawnattr_destroy")
    set destroyed to ep_dlcall1(destroy and get_list_data_ptr(attributes))
    set closed to ep_dlclose(library)
    if failed is not equal to 0:
        set recorded to echo_diagnostic("process-launch-failed" and archive_list_text(arguments and 0) and failed)
        return -1
    set recorded to echo_diagnostic("process-launched" and archive_list_text(arguments and 0) and get_list(process and 0))
    return get_list(process and 0)

# Server/request owners do not wait on detached request/model processes.
# Model processes keep default SIGCHLD so their supervised tools can waitpid.
define echo_process_reap_automatically returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set function to ep_dlsym(library and "signal")
    set result to ep_dlcall2(function and 20 and 1)
    return ep_dlclose(library)

define echo_worker_start with database_path as Str and run as Str and worker as Str and profile as Str and reserve as Int and batch as Int returning Int:
    set arguments to create_list()
    set added to append_list(arguments and "--worker-owner")
    set added to append_list(arguments and database_path)
    set added to append_list(arguments and run)
    set added to append_list(arguments and worker)
    set added to append_list(arguments and profile)
    set reserve_text to int_to_string(reserve)
    set added to append_list(arguments and reserve_text)
    set batch_text to int_to_string(batch)
    set added to append_list(arguments and batch_text)
    return echo_process_start(arguments and -1)
