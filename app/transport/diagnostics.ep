import "socket_read"
import "../providers/json_tokens"

# Append one private JSON record with no prompts, credentials or provider profile.
# A failed diagnostic write is surfaced on stderr; it is never silently ignored.
define echo_diagnostic with event as Str and identity as Str and value as Int returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set path to ptr_to_str(get_env("ECHO_DIAGNOSTIC_LOG"))
    if string_length(path) equals 0:
        set path to "../data/echo-incidents.jsonl"
    set open_function to ep_dlsym(library and "open")
    set descriptor to socket_signed_result(ep_dlcall9(open_function and str_to_ptr(path) and 521 and 0 and 0 and 0 and 0 and 0 and 0 and 384))
    set process_function to ep_dlsym(library and "getpid")
    set process to ep_dlcall0(process_function)
    set line to concat("{\"event\":" and provider_quote(event))
    set line to concat(line and concat(",\"identity\":" and provider_quote(identity)))
    set line to concat(line and concat(",\"pid\":" and int_to_string(process)))
    set line to concat(line and concat(",\"value\":" and int_to_string(value)))
    set line to concat(line and concat(",\"time_ms\":" and int_to_string(ep_time_now_ms())))
    set line to concat(line and "}\n")
    set write_function to ep_dlsym(library and "write")
    set sync_function to ep_dlsym(library and "fsync")
    set result to -1
    if descriptor >= 0:
        set result to ep_dlcall3(write_function and descriptor and str_to_ptr(line) and string_length(line))
        if result equals string_length(line):
            set result to ep_dlcall1(sync_function and descriptor)
        else:
            set result to -1
        set closed to net_close(descriptor)
    if result is not equal to 0:
        set fallback to ep_dlcall3(write_function and 2 and str_to_ptr(line) and string_length(line))
    set closed to ep_dlclose(library)
    return result

define echo_reap_requests returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set wait_function to ep_dlsym(library and "waitpid")
    set status to create_list()
    set added to append_list(status and 0)
    repeat while 1 equals 1:
        set process to socket_signed_result(ep_dlcall3(wait_function and -1 and get_list_data_ptr(status) and 1))
        if process <= 0:
            break
        set identity to int_to_string(process)
        set recorded to echo_diagnostic("request-process-exit" and identity and get_list(status and 0))
    return ep_dlclose(library)
