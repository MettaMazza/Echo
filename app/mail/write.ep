import "authority"
import "read"
import "actions"
import "policy"

# Routine changes within the owned mailbox; outbound correspondence, settings
# and permanent message/draft deletion require the installed reviewed gate.
# Exact method membership, not a heuristic over the user's request or content.
define gmail_ordinary_write with operation as Str returning Int:
    for each allowed in ["drafts.create","drafts.update","labels.create","labels.update","labels.patch","labels.delete","messages.modify","messages.batchModify","messages.trash","messages.untrash","threads.modify","threads.trash","threads.untrash"]:
        if operation equals ptr_to_str(allowed):
            return 1
    return 0

define gmail_action_result with prior as List returning List:
    if not (archive_list_text(prior and 0) equals "observed"):
        return gmail_read_denied(archive_list_text(prior and 0))
    set result to local_json_result(archive_list_text(prior and 1) and string_to_int(archive_list_text(prior and 2)) and archive_list_text(prior and 3))
    set added to append_list(result and 0)
    return result

define gmail_write_account with authority as Int and database as Int and run as Str and call_id as Str and session as Str and request as Str and account as Str and intent as Str and operation as Str and parameters as Str and body as Str and now as Int and system as Int and vault as Int and spool as Int and root as Str and errors as Int and cancellation as Int returning List:
    set owner to gmail_tool_owner(authority and run and call_id)
    if string_length(owner) equals 0 or else gmail_owner_active(authority and database and account and owner) equals 0:
        return gmail_read_denied("mailbox-not-authorized")
    if operation equals "messages.send" or else operation equals "drafts.send":
        return gmail_read_denied("prepared-send-required")
    set reviewed to gmail_ordinary_write(operation) equals 0
    if reviewed:
        if sql_execute(authority and "BEGIN IMMEDIATE;") is not equal to 0:
            return gmail_read_denied("authority-writer-unavailable")
        set decision to gmail_policy_check(authority and run and owner and account and intent and operation and parameters and body)
        set rolled to archive_rollback(authority)
        if not (decision equals "decisions-satisfied"):
            return gmail_read_denied(decision)
    if string_length(intent) equals 0 or else gmail_action_schema(database) is not equal to 0:
        return gmail_read_denied("action-storage-unavailable")
    set prior to gmail_action_read(database and account and intent and operation and parameters and body)
    if not (archive_list_text(prior and 0) equals "new"):
        return gmail_action_result(prior)
    set refresh_identity to concat(request and ":refresh")
    set credential to gmail_refresh_account(database and session and refresh_identity and account and owner and 0 and now and system and vault and spool and root and errors and cancellation)
    if get_list(credential and 2) is not equal to 0:
        return gmail_read_cleanup(archive_list_text(credential and 0) and get_list(credential and 2) and get_list(credential and 3) and refresh_identity and 1)
    if not (archive_list_text(credential and 0) equals "ready"):
        return gmail_read_denied(archive_list_text(credential and 0))
    set tokens to provider_json_tokens(archive_list_text(credential and 1))
    set scopes to create_list()
    set split to retained_text_split(scopes and provider_value(tokens and provider_member(tokens and 0 and "scope")) and " ")
    set plan to gmail_request_plan(operation and parameters and body and scopes)
    if not (archive_list_text(plan and 0) equals "planned") or else archive_list_text(plan and 1) equals "GET":
        return gmail_read_denied(archive_list_text(plan and 0))
    # Freeze admission while committing the mailbox's durable pre-HTTP claim.
    if sql_execute(authority and "BEGIN IMMEDIATE;") is not equal to 0:
        return gmail_read_denied("authority-writer-unavailable")
    if not (gmail_tool_owner(authority and run and call_id) equals owner) or else gmail_owner_active(authority and database and account and owner) equals 0:
        set rolled to archive_rollback(authority)
        return gmail_read_denied("mailbox-authority-changed")
    if reviewed:
        set decision to gmail_policy_check(authority and run and owner and account and intent and operation and parameters and body)
        if not (decision equals "decisions-satisfied"):
            set rolled to archive_rollback(authority)
            return gmail_read_denied(decision)
    if provider_helper_cancelled(system and cancellation) is not equal to 0:
        set rolled to archive_rollback(authority)
        return gmail_read_denied("mailbox-cancelled")
    set claim to gmail_action_claim(database and account and intent and operation and parameters and body)
    if sql_execute(authority and "COMMIT;") is not equal to 0:
        set rolled to archive_rollback(authority)
        return gmail_read_denied("authority-commit-failed")
    if not (archive_list_text(claim and 0) equals "claimed"):
        return gmail_action_result(claim)
    set result to gmail_http_call(database and session and request and provider_value(tokens and provider_member(tokens and 0 and "access_token")) and archive_list_text(plan and 1) and archive_list_text(plan and 2) and body and 0 and system and spool and root and errors and cancellation)
    if get_list(result and 3) is not equal to 0:
        return gmail_read_cleanup(archive_list_text(result and 0) and get_list(result and 3) and -1 and request and string_length(body) > 0)
    set status to archive_list_text(result and 0)
    if status equals "ready" or else status equals "http-error":
        set recorded to gmail_action_observe(database and account and intent and gmail_action_digest(operation and parameters and body) and status and get_list(result and 1) and archive_list_text(result and 2))
        if not (recorded equals "observed"):
            return gmail_read_denied(recorded)
    # A 401 after a write is recorded, not blindly replayed by token refresh.
    if not (gmail_tool_owner(authority and run and call_id) equals owner) or else gmail_owner_active(authority and database and account and owner) equals 0:
        return gmail_read_denied("mailbox-authority-changed")
    return result
