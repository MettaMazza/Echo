import "api_contract"
import "contacts"
import "payload_schemas"
import "../providers/json_access"
import "../providers/archived_stream"

# Return the finite reachable schema graph, retaining recursive references.
# This is exact pinned API metadata, not invented examples or live discovery.
define gmail_request_schema_catalog with operation as Str returning Str:
    set contract to provider_json_tokens(gmail_method_contract(operation))
    set root to provider_value(contract and provider_member(contract and 0 and "request"))
    if string_length(root) equals 0:
        return "null"
    set pending to [root]
    set seen to create_list()
    set result to concat("{\"root\":" and concat(provider_quote(root) and ",\"schemas\":{"))
    set cursor to 0
    repeat while cursor < length_list(pending):
        set name to archive_list_text(pending and cursor)
        set cursor to cursor + 1
        set known to 0
        for each prior in seen:
            if ptr_to_str(prior) equals name:
                set known to 1
        if known:
            continue
        set schema to gmail_payload_schema(name)
        set tokens to provider_json_tokens(schema)
        if tokens equals 0:
            return "null"
        if length_list(seen) > 0:
            set result to concat(result and ",")
        set result to concat(result and concat(provider_quote(name) and concat(":" and schema)))
        set added to append_list(seen and name)
        set index to 0
        repeat while index + 2 < length_list(tokens):
            if provider_kind(tokens and index) equals "string" and also provider_value(tokens and index) equals "$ref" and also provider_kind(tokens and index + 1) equals ":" and also provider_kind(tokens and index + 2) equals "string":
                set added to append_list(pending and provider_value(tokens and index + 2))
            set index to index + 1
    return concat(result and "}}")

# Shared by the real mailbox handler and the focused schema fixture.
define gmail_described_method with operation as Str returning Str:
    if gmail_contacts_method(operation):
        return gmail_contacts_description(operation)
    set contract to gmail_method_contract(operation)
    if string_length(contract) equals 0:
        return "{\"status\":\"unknown-method\"}"
    set result to concat("{\"status\":\"ready\",\"contract\":" and contract)
    return concat(result and concat(",\"request_schema\":" and concat(gmail_request_schema_catalog(operation) and "}")))
