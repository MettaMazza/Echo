import "../security/tool_policy"
import "../memory/private_bridge"

# Reuse existing frozen/current authority and proven private-session identity.
# Neither a claimed admin role nor an admin-only public Discord conversation
# grants mailbox access. Other admins in a shared room are not the owner.
define gmail_tool_owner with database as Int and run as Str and call_id as Str returning Str:
    if tool_policy_allows(database and run and call_id and "mailbox") equals 0:
        return ""
    set owner to private_bridge_identity(database and run)
    if string_length(owner) equals 0:
        return ""
    set row to history_collect_one(checkpoint_prepare(database and "SELECT principal FROM echo_tool_authority WHERE run=?1 AND call_id=?2;" and [run,call_id]))
    if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 1) equals owner):
        return ""
    return owner

# Read actual immutable queued arguments, not another copy supplied to a handler.
# Caller repeats owner validation immediately before effects and before return.
define gmail_tool_request with database as Int and run as Str and call_id as Str returning List:
    set owner to gmail_tool_owner(database and run and call_id)
    if string_length(owner) equals 0:
        return ["not-authorized"]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT r.session,json_extract(e.payload,'$.arguments') FROM echo_tool_calls t JOIN echo_runs r ON r.run=t.run JOIN echo_events e ON e.event=t.request_event AND e.session=t.session WHERE t.run=?1 AND t.call_id=?2 AND t.state='running' AND r.state='tools';" and [run,call_id]))
    if not (archive_list_text(row and 0) equals "found"):
        return ["call-not-running"]
    return ["authorized",owner,archive_list_text(row and 1),archive_list_text(row and 2)]
