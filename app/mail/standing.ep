import "mime"
import "payload"
import "../providers/archived_stream"

# Structural scope only. Policy wording comes from the separately reviewed
# document, never keywords, a second model or an automatic classification.
define gmail_standing_valid with text as Str returning Int:
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return 0
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "terms" or else key equals "recipient_scope" or else key equals "recipients" or else key equals "allow_attachments" or else key equals "max_payload_bytes" or else key equals "expires_at"):
            return 0
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    set terms to provider_member(tokens and 0 and "terms")
    set scope to provider_member(tokens and 0 and "recipient_scope")
    set files to provider_member(tokens and 0 and "allow_attachments")
    set maximum to provider_member(tokens and 0 and "max_payload_bytes")
    set expires to provider_member(tokens and 0 and "expires_at")
    if not (provider_kind(tokens and terms) equals "string") or else string_length(string_trim(provider_value(tokens and terms))) equals 0 or else not (provider_kind(tokens and scope) equals "string") or else not (provider_value(tokens and scope) equals "listed" or else provider_value(tokens and scope) equals "any") or else not (provider_kind(tokens and files) equals "true" or else provider_kind(tokens and files) equals "false"):
        return 0
    if not (provider_kind(tokens and maximum) equals "number") or else gmail_payload_integer(provider_value(tokens and maximum) and "int64") equals 0 or else string_to_int(provider_value(tokens and maximum)) < 1 or else not (provider_kind(tokens and expires) equals "number") or else gmail_payload_integer(provider_value(tokens and expires) and "int64") equals 0 or else string_to_int(provider_value(tokens and expires)) < 0:
        return 0
    set recipients to provider_member(tokens and 0 and "recipients")
    if not (provider_kind(tokens and recipients) equals "["):
        return 0
    set count to 0
    for each entry in provider_items(tokens and recipients):
        if not (provider_kind(tokens and entry) equals "string") or else gmail_address_valid(provider_value(tokens and entry)) equals 0:
            return 0
        set count to count + 1
    if provider_value(tokens and scope) equals "listed" and count equals 0:
        return 0
    if provider_value(tokens and scope) equals "any" and count > 0:
        return 0
    return 1

# The caller supplies the immutable host-produced composition preview joined
# to the exact stored payload. A preview supplied by a tool argument never enters.
define gmail_standing_allows with standing as Str and preview as Str and payload_bytes as Int and now as Int returning Int:
    if gmail_standing_valid(standing) equals 0:
        return 0
    set policy to provider_json_tokens(standing)
    set message to provider_json_tokens(preview)
    if message equals 0 or else provider_unique_objects(message) equals 0 or else not (provider_kind(message and 0) equals "{"):
        return 0
    set maximum to string_to_int(provider_value(policy and provider_member(policy and 0 and "max_payload_bytes")))
    set expires to string_to_int(provider_value(policy and provider_member(policy and 0 and "expires_at")))
    if payload_bytes < 0 or else payload_bytes > maximum or else now < 0 or else (expires > 0 and also now >= expires):
        return 0
    set attachments to provider_member(message and 0 and "attachment_count")
    if not (provider_kind(message and attachments) equals "number") or else gmail_payload_integer(provider_value(message and attachments) and "int32") equals 0 or else string_to_int(provider_value(message and attachments)) < 0:
        return 0
    if not (provider_kind(policy and provider_member(policy and 0 and "allow_attachments")) equals "true") and also string_to_int(provider_value(message and attachments)) > 0:
        return 0
    set count to 0
    for each field in ["to","cc","bcc"]:
        set recipients to provider_member(message and 0 and ptr_to_str(field))
        if not (provider_kind(message and recipients) equals "["):
            return 0
        for each recipient in provider_items(message and recipients):
            set address to provider_value(message and recipient)
            if not (provider_kind(message and recipient) equals "string") or else gmail_address_valid(address) equals 0:
                return 0
            set allowed to provider_value(policy and provider_member(policy and 0 and "recipient_scope")) equals "any"
            for each permitted in provider_items(policy and provider_member(policy and 0 and "recipients")):
                if provider_value(policy and permitted) equals address:
                    set allowed to 1
            if allowed equals 0:
                return 0
            set count to count + 1
    return count > 0

# An explicit routine basis identifies the reviewed policy being used. It is
# not an approval token: the installed grant and latest rights decision must
# independently pass. Protected/consequential actions cannot use this route.
define gmail_standing_basis with parameters as Str and digest as Str returning Int:
    set tokens to provider_json_tokens(parameters)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return 0
    set index to 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set key to provider_value(tokens and index)
        if not (key equals "category" or else key equals "policy_sha256" or else key equals "reason") or else not (provider_kind(tokens and index + 2) equals "string"):
            return 0
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    return provider_value(tokens and provider_member(tokens and 0 and "category")) equals "routine" and also provider_value(tokens and provider_member(tokens and 0 and "policy_sha256")) equals digest and also string_length(string_trim(provider_value(tokens and provider_member(tokens and 0 and "reason")))) > 0
