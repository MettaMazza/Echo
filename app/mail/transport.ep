import "request"
import "../providers/external_discovery"

# Only internally constructed wire plans enter this adapter. The mailbox
# controller must recheck authority and commit a send claim before starting.
# OAuth response bodies are private credentials, never model-visible results.
define gmail_transport_arguments with method as Str and url as Str and body_path as Str and content_type as Str returning List:
    set oauth to url equals "https://oauth2.googleapis.com/token" or else url equals "https://oauth2.googleapis.com/revoke"
    set api to string_index_of(url and "https://gmail.googleapis.com/gmail/v1/users/me/") equals 0
    set contacts to gmail_contacts_endpoint(url)
    if contacts and also (not (method equals "GET") or else string_length(body_path) > 0):
        return 0
    if not (oauth or else api or else contacts):
        return 0
    if oauth and also not (method equals "POST"):
        return 0
    if not (method equals "GET" or else method equals "POST" or else method equals "PUT" or else method equals "PATCH" or else method equals "DELETE"):
        return 0
    set offset to 0
    repeat while offset < string_length(url):
        set byte to get_character(url and offset)
        if byte < 33 or else byte > 126 or else byte equals 35:
            return 0
        set offset to offset + 1
    if string_length(body_path) > 0 and also get_character(body_path and 0) is not equal to 47:
        return 0
    if not (content_type equals "application/json" or else content_type equals "application/x-www-form-urlencoded"):
        return 0
    set arguments to ["--disable","--silent","--show-error","--no-buffer","--raw","--include","--http1.1","--proto","=https","--proto-redir","=https","--max-redirs","0","--retry","0","--proxy","","--request",method,"--header","@/dev/stdin","--header","Accept: application/json","--header","Accept-Encoding: identity","--header","Expect:"]
    if string_length(body_path) > 0:
        set added to append_list(arguments and "--header")
        set added to append_list(arguments and concat("Content-Type: " and content_type))
        set added to append_list(arguments and "--data-binary")
        set added to append_list(arguments and concat("@" and body_path))
    set added to append_list(arguments and "--url")
    set added to append_list(arguments and url)
    return arguments

define gmail_token_valid with token as Str returning Int:
    if string_length(token) equals 0:
        return 0
    set offset to 0
    repeat while offset < string_length(token):
        set byte to get_character(token and offset)
        if byte < 33 or else byte > 126:
            return 0
        set offset to offset + 1
    return 1

define gmail_transport_start with token as Str and method as Str and url as Str and body_path as Str and directory as Int and errors as Int and cancellation as Int returning List:
    if gmail_token_valid(token) equals 0 or else (string_index_of(url and "https://gmail.googleapis.com/gmail/v1/users/me/") is not equal to 0 and also gmail_contacts_endpoint(url) equals 0):
        return external_transport_result("invalid-mail-transport" and 0 and 0)
    set arguments to gmail_transport_arguments(method and url and body_path and "application/json")
    return private_http_start_arguments("/usr/bin/curl" and concat("Authorization: Bearer " and concat(token and "\n")) and arguments and directory and errors and cancellation)

# Token exchange/refresh/revocation sends form data from an immutable private
# file. It deliberately carries no Bearer header to the OAuth endpoint.
define gmail_oauth_start with revoke as Int and body_path as Str and directory as Int and errors as Int and cancellation as Int returning List:
    if string_length(body_path) equals 0:
        return external_transport_result("missing-oauth-request" and 0 and 0)
    set url to "https://oauth2.googleapis.com/token"
    if revoke:
        set url to "https://oauth2.googleapis.com/revoke"
    set arguments to gmail_transport_arguments("POST" and url and body_path and "application/x-www-form-urlencoded")
    return private_http_start_arguments("/usr/bin/curl" and "Accept: application/json\n" and arguments and directory and errors and cancellation)
