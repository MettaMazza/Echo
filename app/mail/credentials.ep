import "oauth"
import "../providers/external_request_file"
import "outbox"

# Credential files are immutable versions, private 0600 under a pinned 0700
# directory. Store the version before atomically replacing its reference.
# This directory must be excluded from every model/host workspace tool.
define gmail_credential_store with system as Int and directory as Int and record as Str returning List:
    set tokens to provider_json_tokens(record)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else gmail_credential_valid(record) equals 0:
        return ["invalid-credential",""]
    set reference to ep_sha256(record)
    set stored to external_request_file(system and directory and reference and record)
    if not (stored equals "stored"):
        return [stored,""]
    return ["stored",reference]

define gmail_credential_read with system as Int and directory as Int and reference as Str returning List:
    if external_vault_reference_valid(reference) equals 0 or else external_vault_inode(system and directory and 1) equals 0:
        return ["credential-unavailable",""]
    set name to concat("request-" and concat(ep_sha256(reference) and ".json"))
    set descriptor to workspace_file_open(system and directory and name and 0)
    if descriptor < 0:
        return ["credential-unavailable",""]
    if external_vault_inode(system and descriptor and 0) equals 0:
        set closed to net_close(descriptor)
        return ["credential-not-private",""]
    set result to file_text_descriptor_window(system and descriptor and "" and -1 and 4096 and 0 and -1)
    set closed to net_close(descriptor)
    set record to archive_list_text(result and 1)
    if closed is not equal to 0 or else not (archive_list_text(result and 0) equals "read") or else not (ep_sha256(record) equals reference) or else gmail_credential_valid(record) equals 0:
        return ["credential-integrity-failed",""]
    return ["ready",record]

# Private mailbox metadata; this schema contains no token/client-secret values.
# Owner is an enrolled principal selected by the authenticated setup handler,
# never a model-supplied identity. Transport profile verification binds email.
define gmail_account_schema with database as Int returning Int:
    return sql_execute(database and "CREATE TABLE IF NOT EXISTS echo_mail_accounts(identity TEXT PRIMARY KEY,principal TEXT NOT NULL,email TEXT NOT NULL,credential_reference TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN ('connected','reconnect-required','revoked'))); CREATE TABLE IF NOT EXISTS echo_mail_credential_events(sequence INTEGER PRIMARY KEY AUTOINCREMENT,identity TEXT NOT NULL REFERENCES echo_mail_accounts(identity),reference TEXT NOT NULL,state TEXT NOT NULL,created TEXT NOT NULL DEFAULT(strftime('%Y-%m-%dT%H:%M:%fZ','now'))); CREATE TRIGGER IF NOT EXISTS echo_mail_account_owner_immutable BEFORE UPDATE ON echo_mail_accounts WHEN NEW.identity != OLD.identity OR NEW.principal != OLD.principal OR NEW.email != OLD.email OR OLD.state='revoked' BEGIN SELECT RAISE(ABORT,'Mailbox ownership/revocation is immutable'); END; CREATE TRIGGER IF NOT EXISTS echo_mail_account_no_delete BEFORE DELETE ON echo_mail_accounts BEGIN SELECT RAISE(ABORT,'Mailbox identity is immutable'); END; CREATE TRIGGER IF NOT EXISTS echo_mail_credential_events_no_update BEFORE UPDATE ON echo_mail_credential_events BEGIN SELECT RAISE(ABORT,'Credential history is immutable'); END; CREATE TRIGGER IF NOT EXISTS echo_mail_credential_events_no_delete BEFORE DELETE ON echo_mail_credential_events BEGIN SELECT RAISE(ABORT,'Credential history is immutable'); END;")

define gmail_account_connect with database as Int and identity as Str and principal as Str and email as Str and reference as Str returning Str:
    if string_length(identity) equals 0 or else string_length(principal) equals 0 or else not (ptr_to_str(string_to_lower(email)) equals "echo.ernos.smith@gmail.com") or else external_vault_reference_valid(reference) equals 0:
        return "invalid-mailbox"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "database-busy"
    set prior to history_collect_one(checkpoint_prepare(database and "SELECT principal,email,credential_reference,state FROM echo_mail_accounts WHERE identity=?1;" and [identity]))
    if archive_list_text(prior and 0) equals "found":
        set ignored to archive_rollback(database)
        if archive_list_text(prior and 1) equals principal and also archive_list_text(prior and 2) equals ptr_to_str(string_to_lower(email)) and also archive_list_text(prior and 3) equals reference and also archive_list_text(prior and 4) equals "connected":
            return "connected"
        return "mailbox-conflict"
    if not (archive_list_text(prior and 0) equals "end"):
        set ignored to archive_rollback(database)
        return "database-error"
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_mail_accounts(identity,principal,email,credential_reference,state) VALUES(?1,?2,?3,?4,'connected');" and [identity,principal,ptr_to_str(string_to_lower(email)),reference]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(database and "INSERT INTO echo_mail_credential_events(identity,reference,state) VALUES(?1,?2,'connected');" and [identity,reference]) and 101) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        set ignored to archive_rollback(database)
        return "database-error"
    return "connected"

# Compare-and-swap rejects stale concurrent refreshes and late results after
# revocation. Reconnection is an explicit credential replacement, not a retry
# loop that forgets Google's invalid_grant. Local revocation happens first;
# remote revocation can then be retried without enabling local mailbox access.
define gmail_account_change with database as Int and identity as Str and principal as Str and expected as Str and reference as Str and state as Str returning Str:
    if external_vault_reference_valid(reference) equals 0 or else not (state equals "connected" or else state equals "reconnect-required" or else state equals "revoked"):
        return "invalid-transition"
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return "database-busy"
    set current to history_collect_one(checkpoint_prepare(database and "SELECT credential_reference,state FROM echo_mail_accounts WHERE identity=?1 AND principal=?2;" and [identity,principal]))
    if not (archive_list_text(current and 0) equals "found") or else not (archive_list_text(current and 1) equals expected) or else archive_list_text(current and 2) equals "revoked":
        set ignored to archive_rollback(database)
        return "stale-or-revoked"
    if archive_finish(checkpoint_prepare(database and "UPDATE echo_mail_accounts SET credential_reference=?3,state=?4 WHERE identity=?1 AND principal=?2;" and [identity,principal,reference,state]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(database and "INSERT INTO echo_mail_credential_events(identity,reference,state) VALUES(?1,?2,?3);" and [identity,reference,state]) and 101) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        set ignored to archive_rollback(database)
        return "database-error"
    return state

# A stored version must contain the complete renewable access-token state.
define gmail_credential_valid with record as Str returning Int:
    set tokens to provider_json_tokens(record)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else string_length(gmail_oauth_refresh_form(record)) equals 0:
        return 0
    for each key in ["client_id","client_secret","access_token","refresh_token","scope"]:
        if not (provider_kind(tokens and provider_member(tokens and 0 and ptr_to_str(key))) equals "string"):
            return 0
    set token to provider_value(tokens and provider_member(tokens and 0 and "access_token"))
    set scope to provider_value(tokens and provider_member(tokens and 0 and "scope"))
    set expiry to provider_index(tokens and provider_member(tokens and 0 and "expires_at"))
    return gmail_token_valid(token) and also string_length(string_trim(scope)) > 0 and also string_length(expiry) > 0 and also string_length(expiry) <= 18 and also string_to_int(expiry) > 0
