import "media/resident_protocol"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else not file_exists("input.txt"):
        return 1
    set config to provider_json_tokens(ptr_to_str(read_file(get_argument(1))))
    set token to provider_value(config and provider_member(config and 0 and "token"))
    set revision to provider_value(config and provider_member(config and 0 and "revision"))
    set port to string_to_int(provider_value(config and provider_member(config and 0 and "port")))
    if string_length(token) < 32 or else string_length(revision) equals 0 or else port < 1 or else port > 65535:
        return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set cwd_function to ep_dlsym(library and "getcwd")
    set free to ep_dlsym(library and "free")
    set cwd to ep_dlcall2(cwd_function and 0 and 0)
    if cwd equals 0:
        return 3
    set body to concat("{\"token\":" and provider_quote(token))
    set body to concat(body and concat(",\"revision\":" and provider_quote(revision)))
    set body to concat(body and concat(",\"directory\":" and provider_quote(ptr_to_str(cwd))))
    set body to concat(body and "}\n")
    set freed to ep_dlcall1(free and cwd)
    set socket to net_connect("127.0.0.1" and port)
    if socket < 0:
        return 4
    set sent to socket_write_all(library and socket and -1 and str_to_ptr(body) and string_length(body))
    if not (archive_list_text(sent and 0) equals "sent"):
        set closed to net_close(socket)
        return 5
    set result to resident_read_line(library and socket and -1)
    set closed to net_close(socket)
    if not (result equals "complete") or else not file_exists("spoken.wav"):
        return 6
    display "Selected Echo voice saved by resident worker."
    return 0
