import "lifecycle/controller_launch"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 7 or else not (get_argument(1) equals "check" or else get_argument(1) equals "run"):
        display "Usage: launch_controller check|run MANIFEST EXPECTED_SHA256 ROOT_OWNED_PARENT EXECUTABLE_NAME CONFIGURATION_NAME. Root bootstrap only; package verification does not authorize protected changes."
        return 1
    if not file_exists(get_argument(2)):
        display "manifest-missing"
        return 1
    set check_only to 0
    if get_argument(1) equals "check":
        set check_only to 1
    return controller_bundle_launch(file_read(get_argument(2)) and get_argument(3) and get_argument(4) and get_argument(5) and get_argument(6) and check_only)
