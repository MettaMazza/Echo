import "memory/archive_recall"
import "web/attachments"

# Host-only import of a closed original file into an existing private scope.
# The expected SHA-256 comes from the pinned source inventory. Repeating the
# same registration is safe; an existing identity never accepts changed bytes.
define main returning Int:
    if get_argument_count() is not equal to 8:
        return 1
    set database to archive_open(get_argument(1))
    set run to get_argument(2)
    set attachment to get_argument(3)
    set path to get_argument(4)
    set digest to get_argument(7)
    if database equals 0 or else string_length(memory_archive_principal(database and run)) equals 0:
        return 2
    set source to file_digest(path and 65536)
    if not (archive_list_text(source and 0) equals "verified") or else not (archive_list_text(source and 1) equals digest):
        display "source-digest-mismatch"
        return 3
    set authority to history_collect_one(checkpoint_prepare(database and "SELECT a.device,r.session FROM echo_run_authority a JOIN echo_runs r ON r.run=a.run WHERE a.run=?;" and [run]))
    if not (archive_list_text(authority and 0) equals "found"):
        return 4
    set device to archive_list_text(authority and 1)
    set session to archive_list_text(authority and 2)
    set existing to web_attachment_owned(database and device and attachment)
    if archive_list_text(existing and 0) equals "found":
        if archive_list_text(existing and 1) equals path and archive_list_text(existing and 2) equals get_argument(5) and archive_list_text(existing and 3) equals get_argument(6) and archive_list_text(existing and 4) equals digest and archive_list_text(existing and 6) equals session:
            display "already-registered"
            return sql_close(database)
        display "attachment-conflict"
        return 5
    if not (archive_list_text(existing and 0) equals "end") or else web_attachment_register(database and device and session and attachment and path and get_argument(5) and get_argument(6)) is not equal to 0:
        display "attachment-registration-failed"
        return 6
    set saved to web_attachment_owned(database and device and attachment)
    if not (archive_list_text(saved and 4) equals digest):
        display "registered-source-changed"
        return 7
    display "registered"
    return sql_close(database)
