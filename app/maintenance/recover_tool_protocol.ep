import "protocol_repair"

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set database to archive_open(get_argument(1))
    set result to recover_legacy_protocol(database and get_argument(2) and get_argument(3) and get_argument(4) and get_argument(5))
    if result equals 0:
        display "Legacy malformed reply reopened; originals retained; fresh worker claimed."
    else:
        display "No recovery claimed: inspect current state, authority and exact legacy final before retrying."
    set closed to sql_close(database)
    return result + closed
