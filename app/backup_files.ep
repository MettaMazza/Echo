import "archive/attachment_snapshot"

define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Supply source database, new snapshot database and an existing private attachment backup directory."
        return 1
    if not file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0:
        return 1
    set result to archive_snapshot(database and get_argument(2))
    set closed to sql_close(database)
    if result is not equal to 0 or else closed is not equal to 0:
        return 1
    set database to sql_open(get_argument(2))
    if database equals 0:
        return 1
    set result to attachment_snapshot_copy(database and get_argument(3))
    if result equals 0:
        set result to attachment_snapshot_verify(database and get_argument(3))
    set closed to sql_close(database)
    if result is not equal to 0 or else closed is not equal to 0:
        display "Attachment backup did not verify. Keep the candidate separate from completed backups."
        return 1
    display "Database and registered attachment bytes verified. Model weights, environment files and unfinished uploads are excluded. Use restore_files for path relocation; restored execution remains held for historical-action reconciliation."
    return 0
