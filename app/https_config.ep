import "web/http_api"
import "fs"

# Generate upstream configuration from Ernos. Default is loopback; explicit
# public host and local bind address enable the configured LAN interface.
define main returning Int:
    if get_argument_count() is not equal to 4 and get_argument_count() is not equal to 6:
        display "Supply HTTPS port, local Echo port and destination configuration path; optionally public hostname and local bind address."
        return 1
    set secure_port to http_decimal(get_argument(1))
    set echo_port to http_decimal(get_argument(2))
    if secure_port is less than 1 or else secure_port is greater than 65535 or else echo_port is less than 1 or else echo_port is greater than 65535 or else secure_port equals echo_port:
        return 1
    set hostname to "localhost"
    set bind_address to "127.0.0.1"
    if get_argument_count() equals 6:
        set hostname to get_argument(4)
        set bind_address to get_argument(5)
        if string_contains(hostname and ":") is not equal to 0 or else string_contains(bind_address and ":") is not equal to 0:
            return 1
        if web_https_origin_valid(concat("https://" and hostname)) equals 0 or else web_https_origin_valid(concat("https://" and bind_address)) equals 0:
            return 1
    set configuration to concat("{\n    admin off\n    auto_https disable_redirects\n    skip_install_trust\n}\nhttps://" and hostname)
    set configuration to concat(configuration and ":")
    set configuration to concat(configuration and int_to_string(secure_port))
    set configuration to concat(configuration and concat(" {\n    bind " and bind_address))
    set configuration to concat(configuration and "\n    tls internal\n    reverse_proxy 127.0.0.1:")
    set configuration to concat(configuration and int_to_string(echo_port))
    set configuration to concat(configuration and " {\n        header_up Host 127.0.0.1:")
    set configuration to concat(configuration and int_to_string(echo_port))
    set configuration to concat(configuration and "\n        flush_interval -1\n    }\n}\n")
    set saved to write_file(get_argument(3) and configuration)
    if not file_exists(get_argument(3)):
        return 1
    if not (ptr_to_str(read_file(get_argument(3))) equals configuration):
        return 1
    return 0
