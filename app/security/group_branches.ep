import "group_session_selection"
import "../archive/snapshot"

# An explicit branch retains the same frozen audience and an exact immutable
# source boundary. It never converts shared history into a privately owned
# session. Editing/regeneration is restricted to the original speaker.
define group_session_branch with database as Int and device as Str and operation as Str and source as Str and endpoint as Str and platform as Str and server as Str and room as Str and mode as Str and replacement as Str returning List:
    if string_length(operation) equals 0 or else group_text_valid(operation) equals 0 or else not (mode equals "continue" or else mode equals "edit" or else mode equals "regenerate"):
        return history_status("invalid-operation")
    if (mode equals "edit" and string_length(replacement) equals 0) or else (not (mode equals "edit") and string_length(replacement) > 0):
        return history_status("invalid-replacement")
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return history_status("writer-lock-unavailable")
    if group_session_allows(database and device and source and platform and server and room and 1) equals 0 or else node_admission_allows(database) equals 0:
        return history_status(migration_fail(database and "audience-not-authorized"))
    set source_keys to create_list()
    set added to append_list(source_keys and source)
    set audience to history_collect_one(checkpoint_prepare(database and "SELECT group_id,revision FROM echo_group_sessions WHERE session=?1 AND NOT EXISTS(SELECT 1 FROM echo_delegations WHERE session=?1);" and source_keys))
    if not (archive_list_text(audience and 0) equals "found"):
        return history_status(migration_fail(database and "source-not-authorized"))
    set group_id to archive_list_text(audience and 1)
    set revision to string_to_int(archive_list_text(audience and 2))
    set keys to create_list()
    set added to append_list(keys and source)
    set added to append_list(keys and endpoint)
    set added to append_list(keys and mode)
    set added to append_list(keys and device)
    set boundary to history_collect_one(checkpoint_prepare(database and "SELECT e.sequence,e.digest FROM echo_events e JOIN echo_runs r ON r.session=e.session JOIN echo_group_run_origins o ON o.run=r.run WHERE e.session=?1 AND e.event=?2 AND ((?3='continue' AND e.kind='assistant_final' AND r.last_event=e.event AND r.state='completed') OR (?3 IN ('edit','regenerate') AND e.kind='user' AND r.objective_event=e.event AND r.state IN ('completed','failed','cancelled') AND o.device=?4 AND NOT EXISTS(SELECT 1 FROM echo_tool_calls t WHERE t.run=r.run AND t.state<>'observed')));" and keys))
    if not (archive_list_text(boundary and 0) equals "found"):
        return history_status(migration_fail(database and "invalid-boundary"))
    if archive_verify(database and source) is not equal to 0:
        return history_status(migration_fail(database and "archive-error"))
    set session to concat("group-conversation:" and ep_sha256(operation))
    set event to concat(session and ":origin")
    set values to create_list()
    set added to append_list(values and source)
    set added to append_list(values and endpoint)
    set added to append_list(values and archive_list_text(boundary and 1))
    set added to append_list(values and archive_list_text(boundary and 2))
    set added to append_list(values and mode)
    set added to append_list(values and replacement)
    set added to append_list(values and device)
    set payload to history_collect_one(checkpoint_prepare(database and "SELECT json_object('source',?1,'endpoint',?2,'sequence',?3,'digest',?4,'mode',?5,'replacement',?6,'device',?7);" and values))
    if not (archive_list_text(payload and 0) equals "found"):
        return history_status(migration_fail(database and "branch-write-failed"))
    set operation_keys to create_list()
    set added to append_list(operation_keys and operation)
    set old to history_collect_one(checkpoint_prepare(database and "SELECT session,group_id,revision,device FROM echo_group_session_choices WHERE operation=?1;" and operation_keys))
    if archive_list_text(old and 0) equals "found":
        set origin to archive_read_event(database and event)
        if not (archive_list_text(old and 1) equals session) or else not (archive_list_text(old and 2) equals group_id) or else not (archive_list_text(old and 3) equals int_to_string(revision)) or else not (archive_list_text(old and 4) equals device) or else origin equals 0 or else not (archive_list_text(origin and 2) equals "session_branch") or else not (archive_list_text(origin and 3) equals archive_list_text(payload and 1)):
            return history_status(migration_fail(database and "operation-identity-conflict"))
        if sql_execute(database and "COMMIT;") is not equal to 0:
            return history_status(migration_fail(database and "commit-failed"))
        set result to history_status("already-created")
        set added to append_list(result and session)
        return result
    if not (archive_list_text(old and 0) equals "end"):
        return history_status(migration_fail(database and "branch-read-failed"))
    set values to create_list()
    set added to append_list(values and operation)
    set added to append_list(values and group_id)
    set added to append_list(values and int_to_string(revision))
    set added to append_list(values and device)
    set added to append_list(values and session)
    set added to append_list(values and int_to_string(ep_time_now_ms()))
    set audience_values to create_list()
    set added to append_list(audience_values and session)
    set added to append_list(audience_values and group_id)
    set added to append_list(audience_values and int_to_string(revision))
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_group_session_choices VALUES(?1,?2,CAST(?3 AS INTEGER),?5,?4,CAST(?6 AS INTEGER));" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(database and "INSERT INTO echo_sessions(session,title,created) VALUES(?5,'Shared conversation — branch','unix-ms:'||?6);" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(database and "INSERT INTO echo_group_sessions VALUES(?1,?2,CAST(?3 AS INTEGER));" and audience_values) and 101) is not equal to 0:
        return history_status(migration_fail(database and "branch-write-failed"))
    set occurred to concat("unix-ms:" and int_to_string(ep_time_now_ms()))
    if archive_append_pending(database and session and event and "session_branch" and archive_list_text(payload and 1) and occurred) is not equal to 0 or else group_session_choice_record(database and device and operation and group_id and revision and session) is not equal to 0:
        return history_status(migration_fail(database and "branch-write-failed"))
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return history_status(migration_fail(database and "commit-failed"))
    set result to history_status("created")
    set added to append_list(result and session)
    return result

# Branch publication and the new run are separately durable. The same command
# identity resumes the exact operation after interruption, never duplicates it.
# Attachment identity is inherited; the existing manifest checks current access.
define group_revision_submit with database as Int and device as Str and operation as Str and source as Str and user_event as Str and platform as Str and server as Str and room as Str and mode as Str and replacement as Str and environment as Str returning List:
    if not (mode equals "edit" or else mode equals "regenerate"):
        return history_status("invalid-operation")
    if group_session_allows(database and device and source and platform and server and room and 1) equals 0:
        return history_status("audience-not-authorized")
    set original to archive_read_event(database and user_event)
    if original equals 0 or else not (archive_list_text(original and 0) equals source) or else not (archive_list_text(original and 2) equals "user"):
        return history_status("invalid-boundary")
    set text to replacement
    if mode equals "regenerate":
        set text to archive_list_text(original and 3)
    set attachments to create_list()
    set binding to turn_attachment_read(database and source and user_event)
    if archive_list_text(binding and 0) equals "found":
        set tokens to provider_json_tokens(archive_list_text(binding and 1))
        if tokens equals 0:
            return history_status("archive-error")
        for each item in provider_items(tokens and provider_member(tokens and 0 and "attachments")):
            set attachment to provider_value(tokens and provider_member(tokens and item and "attachment"))
            set added to append_list(attachments and attachment)
    else if not (archive_list_text(binding and 0) equals "end"):
        return history_status("archive-error")
    set branch to group_session_branch(database and device and operation and source and user_event and platform and server and room and mode and replacement)
    if not (archive_list_text(branch and 0) equals "created" or else archive_list_text(branch and 0) equals "already-created"):
        return branch
    set session to archive_list_text(branch and 1)
    set run to concat("group-revision:" and ep_sha256(operation))
    set status to group_run_submit_environment(database and device and run and session and platform and server and room and text and attachments and environment)
    set result to history_status(status)
    if status equals "accepted" or else status equals "already-accepted":
        set added to append_list(result and session)
        set added to append_list(result and run)
    return result
