import "../archive/history"

# SQL expressions are supplied only by internal callers, never request data.
# This clause supplements private ownership only for a recorded initiating run.
define group_run_scope_sql with database as Int and run_expression as Str and session_expression as Str and device_expression as Str returning Str:
    set schema to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_run_origins';"))
    if not (archive_list_text(schema and 0) equals "found"):
        return "0"
    set clause to concat("EXISTS(SELECT 1 FROM echo_group_run_origins group_origin JOIN echo_group_sessions group_session ON group_session.session=group_origin.session JOIN echo_groups scope_group ON scope_group.identity=group_session.group_id JOIN echo_principal_devices group_link ON group_link.device=group_origin.device JOIN echo_group_audiences group_audience ON group_audience.group_id=group_session.group_id AND group_audience.revision=group_session.revision AND group_audience.principal=group_link.principal JOIN echo_principals scope_principal ON scope_principal.identity=group_link.principal WHERE (scope_group.origin NOT LIKE 'silo:admin:%' OR scope_principal.role IN ('admin','steward')) AND group_origin.run=" and run_expression)
    set clause to concat(clause and concat(" AND group_origin.session=" and session_expression))
    set clause to concat(clause and concat(" AND group_origin.device=" and device_expression))
    return concat(clause and " AND group_session.revision=(SELECT MAX(revision) FROM echo_group_membership WHERE group_id=group_session.group_id) AND (SELECT state FROM echo_group_membership WHERE group_id=group_session.group_id AND principal=group_link.principal ORDER BY revision DESC LIMIT 1)='joined')")

# Supplemental group-session check for dispatchers that also enforce frozen
# run and tool authority. This never substitutes for those permission checks.
define group_run_session_allows with database as Int and run as Str and session as Str returning Int:
    set scope to group_run_scope_sql(database and "r.run" and "r.session" and "a.device")
    if scope equals "0":
        return 0
    set values to [run,session]
    set row to history_collect_one(checkpoint_prepare(database and concat("SELECT r.run FROM echo_runs r JOIN echo_run_authority a ON a.run=r.run WHERE r.run=?1 AND r.session=?2 AND " and concat(scope and ";")) and values))
    return archive_list_text(row and 0) equals "found"

# Current group workspace access is separate from private ownership. Historical
# audience segments remain archived but cannot accept fresh workspace actions.
define group_device_session_sql with database as Int and session_expression as Str and device_expression as Str returning Str:
    set schema to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_sessions';"))
    if not (archive_list_text(schema and 0) equals "found"):
        return "0"
    set clause to concat("EXISTS(SELECT 1 FROM echo_group_sessions gs JOIN echo_groups scope_group ON scope_group.identity=gs.group_id JOIN echo_group_audiences ga ON ga.group_id=gs.group_id AND ga.revision=gs.revision JOIN echo_principal_devices gb ON gb.principal=ga.principal JOIN echo_devices gd ON gd.device=gb.device JOIN echo_principals gp ON gp.identity=ga.principal WHERE (scope_group.origin NOT LIKE 'silo:admin:%' OR gp.role IN ('admin','steward')) AND gs.session=" and session_expression)
    set clause to concat(clause and concat(" AND gd.device=" and device_expression))
    return concat(clause and " AND gd.revoked=0 AND gp.revoked=0 AND gs.revision=(SELECT MAX(revision) FROM echo_group_membership WHERE group_id=gs.group_id) AND (SELECT state FROM echo_group_membership WHERE group_id=gs.group_id AND principal=ga.principal ORDER BY revision DESC LIMIT 1)='joined')")

# A private run keeps its existing policy. A shared privileged result requires
# every recipient to have held admin authority when the run was admitted, with
# unchanged role/revocation revisions now. Missing snapshots never grant access.
define group_privileged_audience_allows with database as Int and run as Str returning Int:
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_run_origins';"))
    if archive_list_text(installed and 0) equals "end":
        return 1
    if not (archive_list_text(installed and 0) equals "found"):
        return 0
    set values to [run]
    set origin to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_group_run_origins WHERE run=?;" and values))
    if archive_list_text(origin and 0) equals "end":
        return 1
    if not (archive_list_text(origin and 0) equals "found") or else group_run_session_allows(database and run and archive_list_text(origin and 1)) equals 0:
        return 0
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_run_recipients';"))
    if not (archive_list_text(installed and 0) equals "found"):
        return 0
    set row to history_collect_one(checkpoint_prepare(database and "SELECT g.run FROM echo_group_run_origins g JOIN echo_group_sessions s ON s.session=g.session WHERE g.run=?1 AND EXISTS(SELECT 1 FROM echo_group_run_recipients WHERE run=g.run) AND NOT EXISTS(SELECT 1 FROM echo_group_audiences a WHERE a.group_id=s.group_id AND a.revision=s.revision AND NOT EXISTS(SELECT 1 FROM echo_group_run_recipients v JOIN echo_principals p ON p.identity=v.principal WHERE v.run=g.run AND v.principal=a.principal AND v.role IN ('admin','steward') AND p.role=v.role AND p.revoked=0 AND v.role_revision=(SELECT COUNT(*) FROM echo_authority_events WHERE principal=v.principal) AND v.revocation_revision=(SELECT COUNT(*) FROM echo_principal_revocations WHERE principal=v.principal)));" and values))
    return archive_list_text(row and 0) equals "found"


# Only the exact immutable source text may be spoken by a direct shared job.
# SQL expressions come from trusted callers, never model or HTTP arguments.
define group_speech_scope_sql with database as Int and run_expression as Str and session_expression as Str and device_expression as Str returning Str:
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_speech_jobs';"))
    if not (archive_list_text(installed and 0) equals "found"):
        return "0"
    set clause to concat("EXISTS(SELECT 1 FROM echo_group_speech_jobs sj JOIN echo_tool_calls st ON st.run=sj.job AND st.session=sj.session AND st.call_id='speak' JOIN echo_events sq ON sq.event=st.request_event AND sq.session=sj.session JOIN echo_events ss ON ss.event=sj.source AND ss.session=sj.session AND ss.kind='assistant_final' WHERE sj.job=" and run_expression)
    set clause to concat(clause and concat(" AND sj.session=" and session_expression))
    set clause to concat(clause and concat(" AND sj.device=" and device_expression))
    set clause to concat(clause and " AND sq.kind='tool_call' AND json_extract(sq.payload,'$.name')='speech_synthesize' AND json_extract(sq.payload,'$.run_id')=sj.job AND json_extract(sq.payload,'$.call_id')='speak' AND json_extract(sq.payload,'$.speech_source')=ss.event AND json_extract(json_extract(sq.payload,'$.arguments'),'$.text')=json_extract(ss.payload,'$.content') AND NOT EXISTS(SELECT 1 FROM echo_runs WHERE run=sj.job) AND ")
    return concat(clause and concat(group_device_session_sql(database and "sj.session" and "sj.device") and ")"))

define group_speech_call_matches with database as Int and run as Str and call_id as Str returning Int:
    if not (call_id equals "speak"):
        return 0
    set scope to group_speech_scope_sql(database and "t.run" and "t.session" and "a.device")
    if scope equals "0":
        return 0
    set values to [run,call_id]
    set row to history_collect_one(checkpoint_prepare(database and concat("SELECT t.run FROM echo_tool_calls t JOIN echo_tool_authority a ON a.run=t.run AND a.call_id=t.call_id WHERE t.run=?1 AND t.call_id=?2 AND " and concat(scope and ";")) and values))
    return archive_list_text(row and 0) equals "found"
