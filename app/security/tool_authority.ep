import "group_gate"
import "node_gate"
import "run_authority"

# Freeze each queued tool request, including direct UI actions without a model
# run. Historical requests are not assigned invented initiating authority.
define tool_authority_schema with database as Int returning Str:
    set prior to run_authority_schema(database)
    if not (prior equals "applied" or else prior equals "already-applied"):
        return prior
    return migration_apply(database and 7 and "frozen-tool-authority" and "CREATE TABLE echo_tool_authority(run TEXT NOT NULL,call_id TEXT NOT NULL,device TEXT NOT NULL REFERENCES echo_devices(device),principal TEXT NOT NULL REFERENCES echo_principals(identity),role TEXT NOT NULL,role_revision INTEGER NOT NULL,revocation_revision INTEGER NOT NULL,link_revision INTEGER NOT NULL,PRIMARY KEY(run,call_id),FOREIGN KEY(run,call_id) REFERENCES echo_tool_calls(run,call_id)); CREATE TRIGGER echo_tool_authority_no_update BEFORE UPDATE ON echo_tool_authority BEGIN SELECT RAISE(ABORT,'Initiating authority is immutable'); END; CREATE TRIGGER echo_tool_authority_no_delete BEFORE DELETE ON echo_tool_authority BEGIN SELECT RAISE(ABORT,'Initiating authority is immutable'); END; CREATE TRIGGER echo_tool_authority_capture AFTER INSERT ON echo_tool_calls BEGIN INSERT INTO echo_tool_authority SELECT NEW.run,NEW.call_id,d.device,p.identity,p.role,(SELECT COUNT(*) FROM echo_authority_events e WHERE e.principal=p.identity),(SELECT COUNT(*) FROM echo_principal_revocations v WHERE v.principal=p.identity),(SELECT COUNT(*) FROM echo_device_link_events l WHERE l.device=d.device) FROM echo_session_owners o JOIN echo_devices d ON d.device=o.device JOIN echo_principal_devices b ON b.device=d.device JOIN echo_principals p ON p.identity=b.principal WHERE o.session=NEW.session AND d.revoked=0 AND p.revoked=0; SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM echo_tool_authority WHERE run=NEW.run AND call_id=NEW.call_id) THEN RAISE(ABORT,'Authenticated initiating authority required') END; END;")

# Revalidate immediately before dispatch, including immutable audit revisions.
# No later grant can elevate an older queued request; even revoke/restore or
# unlink/relink cycles require a new request. Ordinary admin is not charter steward.
define tool_authority_allows with database as Int and run as Str and call_id as Str and required as Str returning Int:
    if node_tool_allows(database and run and call_id) equals 0:
        return 0
    if not (required equals "user" or else required equals "admin" or else required equals "steward"):
        return 0
    set schema to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_tool_authority';"))
    if archive_list_text(schema and 0) equals "end":
        # Unmigrated Phase One retains its existing sandbox only, never admin.
        return required equals "user"
    if not (archive_list_text(schema and 0) equals "found"):
        return 0
    set values to create_list()
    set added to append_list(values and run)
    set added to append_list(values and call_id)
    set added to append_list(values and required)
    # Keep each allocated scope alive while later scope queries allocate.
    set private_scope to principal_session_sql(database and "r.session" and "a.device")
    set group_scope to group_run_scope_sql(database and "r.run" and "r.session" and "a.device")
    set speech_scope to group_speech_scope_sql(database and "r.run" and "r.session" and "a.device")
    set query to "SELECT a.run FROM echo_tool_authority a JOIN echo_tool_calls r ON r.run=a.run AND r.call_id=a.call_id LEFT JOIN echo_session_owners o ON o.session=r.session AND o.device=a.device JOIN echo_devices d ON d.device=a.device JOIN echo_principal_devices b ON b.device=d.device AND b.principal=a.principal JOIN echo_principals p ON p.identity=a.principal WHERE ((o.device=a.device AND "
    set query to concat(query and private_scope)
    set query to concat(query and ") OR ")
    set query to concat(query and group_scope)
    set query to concat(query and " OR ")
    set query to concat(query and speech_scope)
    set query to concat(query and ")")
    set query to concat(query and " AND a.run=?1 AND a.call_id=?2 AND d.revoked=0 AND p.revoked=0 AND p.role=a.role AND a.role_revision=(SELECT COUNT(*) FROM echo_authority_events e WHERE e.principal=a.principal) AND a.revocation_revision=(SELECT COUNT(*) FROM echo_principal_revocations v WHERE v.principal=a.principal) AND a.link_revision=(SELECT COUNT(*) FROM echo_device_link_events l WHERE l.device=a.device) AND (?3='user' OR (?3='admin' AND a.role IN ('admin','steward')) OR (?3='steward' AND a.role='steward'));")
    set result to history_collect_one(checkpoint_prepare(database and query and values))
    return archive_list_text(result and 0) equals "found"
