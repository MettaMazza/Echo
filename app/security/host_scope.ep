import "tool_authority"
import "group_gate"
import "../agent/run_state"

# A host resource grant must bind this server-derived scope, not an asserted
# platform, display name, linked account or model-provided resource label.
# Result: kind (private/audience), platform, immutable scope, session; or empty.
# This identifies a boundary only. It never grants resources by itself.
define host_resource_scope with database as Int and run as Str returning List:
    if run_authority_allows(database and run and "admin") equals 0 or else group_privileged_audience_allows(database and run) equals 0:
        return 0
    set current to agent_run_read(database and run)
    if current equals 0:
        return 0
    set session to archive_list_text(current and 0)
    set owned to history_collect_one(checkpoint_prepare(database and "SELECT principal FROM echo_session_principals WHERE session=?1;" and [session]))
    if archive_list_text(owned and 0) equals "found":
        return ["private","first-party",concat("private:" and archive_list_text(owned and 1)),session]
    if not (archive_list_text(owned and 0) equals "end") or else group_run_session_allows(database and run and session) equals 0:
        return 0
    set shared to history_collect_one(checkpoint_prepare(database and "SELECT g.platform,json_array(s.group_id,s.revision) FROM echo_group_run_origins o JOIN echo_group_sessions s ON s.session=o.session JOIN echo_groups g ON g.identity=s.group_id WHERE o.run=?1 AND o.session=?2;" and [run,session]))
    if not (archive_list_text(shared and 0) equals "found") or else string_length(archive_list_text(shared and 1)) equals 0:
        return 0
    return ["audience",archive_list_text(shared and 1),concat("audience:" and archive_list_text(shared and 2)),session]
