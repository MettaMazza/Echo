import "../archive/history"

# Schema absence preserves the existing installation. Once installed, any
# read failure denies work. Emergency disclosure alone never releases a node.
define node_gate_installed with database as Int returning Int:
    set row to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_node_run_epochs';"))
    if archive_list_text(row and 0) equals "end":
        return 0
    if archive_list_text(row and 0) equals "found":
        return 1
    return -1

define node_admission_allows with database as Int returning Int:
    set installed to node_gate_installed(database)
    if installed equals 0:
        return 1
    if installed is not equal to 1:
        return 0
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events s WHERE s.kind='emergency_started' AND NOT EXISTS(SELECT 1 FROM echo_events r WHERE r.session=s.session AND r.kind='emergency_released');"))
    return archive_list_text(row and 0) equals "found" and also archive_list_text(row and 1) equals "0"

# A release admits fresh work; it cannot revive pre-emergency queued work.
define node_run_status with database as Int and run as Str returning Int:
    set installed to node_gate_installed(database)
    if installed equals 0:
        return 1
    if installed is not equal to 1:
        return -1
    set values to create_list()
    set added to append_list(values and run)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_node_run_epochs WHERE run=? AND epoch=(SELECT COUNT(*) FROM echo_events WHERE kind='emergency_started') AND NOT EXISTS(SELECT 1 FROM echo_events s WHERE s.kind='emergency_started' AND NOT EXISTS(SELECT 1 FROM echo_events r WHERE r.session=s.session AND r.kind='emergency_released'));" and values))
    if archive_list_text(row and 0) equals "error":
        return -1
    return archive_list_text(row and 0) equals "found"

define node_run_allows with database as Int and run as Str returning Int:
    return node_run_status(database and run) equals 1

define node_tool_allows with database as Int and run as Str and call_id as Str returning Int:
    if node_admission_allows(database) equals 0:
        return 0
    if node_gate_installed(database) equals 0:
        return 1
    set values to [run, call_id]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_node_tool_epochs WHERE run=?1 AND call_id=?2 AND epoch=(SELECT COUNT(*) FROM echo_events WHERE kind='emergency_started') AND (NOT EXISTS(SELECT 1 FROM echo_runs WHERE run=?1) OR EXISTS(SELECT 1 FROM echo_node_run_epochs WHERE run=?1 AND epoch=(SELECT COUNT(*) FROM echo_events WHERE kind='emergency_started')));" and values))
    return archive_list_text(row and 0) equals "found"
