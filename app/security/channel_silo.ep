import "group_route"

# Trusted connector routing supplies platform/server/channel and authenticated
# device. The model cannot select a different user or import a private session.
# Length-prefixed fields prevent namespace collisions before hashing.
define channel_silo_identity with platform as Str and server as Str and room as Str and principal as Str returning Str:
    set source to "user-in-channel"
    for each field in [platform,server,room,principal]:
        set source to concat(source and archive_hash_field(ptr_to_str(field)))
    return concat("user-channel:" and ep_sha256(source))

# A personal channel context is an immutable singleton audience. Group storage
# provides its own session, compaction lock, attachment/workspace scope and run
# provenance; no private-history ownership record is added for this context.
define channel_silo_submit with database as Int and device as Str and platform as Str and server as Str and room as Str and run as Str and message as Str and attachments as List returning List:
    if string_length(platform) equals 0 or else string_length(server) equals 0 or else string_length(room) equals 0:
        return history_status("invalid-channel-namespace")
    set principal to principal_for_device(database and device)
    if string_length(principal) equals 0:
        return history_status("not-authorized")
    set identity to channel_silo_identity(platform and server and room and principal)
    set origin to concat("silo:user-in-channel:" and ep_sha256(identity))
    set created to group_create(database and device and identity and platform and server and room and origin)
    if not (created equals "created" or else created equals "already-created"):
        return history_status(created)
    return group_route_submit_files(database and device and identity and platform and server and room and run and message and attachments)
