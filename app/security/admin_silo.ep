import "group_route"

# Host/connector callers choose the explicit administrative context identity.
# Admin role alone does not grant access: the recorded audience still applies.
define admin_silo_create with database as Int and device as Str and identity as Str and platform as Str and server as Str and room as Str returning Str:
    set principal to principal_for_device(database and device)
    set role to principal_role(database and principal)
    if string_length(principal) equals 0 or else not (role equals "admin" or else role equals "steward"):
        return "admin-scope-not-authorized"
    if string_length(identity) equals 0 or else string_length(platform) equals 0:
        return "invalid-admin-scope"
    return group_create(database and device and identity and platform and server and room and concat("silo:admin:" and ep_sha256(identity)))
