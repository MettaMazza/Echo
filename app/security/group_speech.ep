import "group_output_policy"

# Direct UI speech has its own caller; it does not invent a model/user turn.
define group_speech_schema with database as Int returning Str:
    set prior to group_output_schema(database)
    if not (prior equals "applied" or else prior equals "already-applied"):
        return prior
    return migration_apply(database and 21 and "shared-direct-speech-origin" and "CREATE TABLE echo_group_speech_jobs(job TEXT PRIMARY KEY,session TEXT NOT NULL REFERENCES echo_group_sessions(session),device TEXT NOT NULL REFERENCES echo_devices(device),source TEXT NOT NULL REFERENCES echo_events(event)); CREATE TRIGGER echo_group_speech_no_update BEFORE UPDATE ON echo_group_speech_jobs BEGIN SELECT RAISE(ABORT,'Speech origin is immutable'); END; CREATE TRIGGER echo_group_speech_no_delete BEFORE DELETE ON echo_group_speech_jobs BEGIN SELECT RAISE(ABORT,'Speech origin is immutable'); END; CREATE TRIGGER echo_group_speech_before_call BEFORE INSERT ON echo_group_speech_jobs WHEN EXISTS(SELECT 1 FROM echo_tool_calls WHERE run=NEW.job) OR EXISTS(SELECT 1 FROM echo_runs WHERE run=NEW.job) BEGIN SELECT RAISE(ABORT,'Speech origin must precede call'); END; DROP TRIGGER echo_tool_authority_capture; CREATE TRIGGER echo_tool_authority_capture AFTER INSERT ON echo_tool_calls BEGIN INSERT INTO echo_tool_authority SELECT NEW.run,NEW.call_id,d.device,p.identity,p.role,(SELECT COUNT(*) FROM echo_authority_events e WHERE e.principal=p.identity),(SELECT COUNT(*) FROM echo_principal_revocations v WHERE v.principal=p.identity),(SELECT COUNT(*) FROM echo_device_link_events l WHERE l.device=d.device) FROM echo_session_owners o JOIN echo_devices d ON d.device=o.device JOIN echo_principal_devices b ON b.device=d.device JOIN echo_principals p ON p.identity=b.principal WHERE o.session=NEW.session AND d.revoked=0 AND p.revoked=0; INSERT INTO echo_tool_authority SELECT a.run,NEW.call_id,a.device,a.principal,a.role,a.role_revision,a.revocation_revision,a.link_revision FROM echo_run_authority a JOIN echo_group_run_origins g ON g.run=a.run JOIN echo_runs r ON r.run=g.run AND r.session=g.session WHERE a.run=NEW.run AND g.session=NEW.session; INSERT INTO echo_tool_authority SELECT NEW.run,NEW.call_id,d.device,p.identity,p.role,(SELECT COUNT(*) FROM echo_authority_events WHERE principal=p.identity),(SELECT COUNT(*) FROM echo_principal_revocations WHERE principal=p.identity),(SELECT COUNT(*) FROM echo_device_link_events WHERE device=d.device) FROM echo_group_speech_jobs j JOIN echo_devices d ON d.device=j.device JOIN echo_principal_devices b ON b.device=d.device JOIN echo_principals p ON p.identity=b.principal WHERE j.job=NEW.run AND j.session=NEW.session AND NEW.call_id='speak' AND d.revoked=0 AND p.revoked=0; SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM echo_tool_authority WHERE run=NEW.run AND call_id=NEW.call_id) THEN RAISE(ABORT,'Authenticated initiating authority required') END; END;")
