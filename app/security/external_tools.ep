import "external_scope"

# An external session is its own disclosed workspace, not a grant to the local
# principal's other history, host, community-agent identity or privileged tools.
# This gate supplements (never replaces) frozen run/call authority. Local calls
# retain their existing policy, including direct UI actions without a run.
define external_tool_allows with database as Int and run as Str and call_id as Str and session as Str and name as Str and capability as Str returning Int:
    set status to external_scope_session_status(database and session)
    if status equals "local":
        return 1
    if not (status equals "external"):
        return 0
    set principal to history_collect_one(checkpoint_prepare(database and "SELECT a.principal FROM echo_tool_authority a JOIN echo_tool_calls t ON t.run=a.run AND t.call_id=a.call_id JOIN echo_external_scopes s ON s.session=t.session AND s.principal=a.principal WHERE a.run=?1 AND a.call_id=?2 AND t.session=?3 AND NOT EXISTS(SELECT 1 FROM echo_external_revocations v WHERE v.session=s.session);" and [run,call_id,session]))
    if not (archive_list_text(principal and 0) equals "found"):
        return 0
    # These handlers bind their resources to the trusted current session. New
    # capabilities require an outbound-scope review before external admission.
    if capability equals "workspace.read" or else capability equals "workspace.edit" or else capability equals "workspace.create" or else capability equals "workspace.execute-isolated":
        return 1
    if capability equals "session.read" or else capability equals "attachment.read" or else capability equals "media.local" or else capability equals "network.public-read":
        return 1
    if name equals "request_user_input" or else name equals "autoOff" or else name equals "task_checklist" or else name equals "tool_search":
        return 1
    # Cross-session memory/projects, host/system, community actions and child
    # jobs cannot reuse local resources/profiles. Their external-scoped adapters
    # must be connected before they can be exposed in an external profile.
    return 0

define external_tool_denied with database as Int and run as Str and call_id as Str and name as Str and capability as Str returning Int:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_tool_calls WHERE run=?1 AND call_id=?2;" and [run,call_id]))
    if not (archive_list_text(row and 0) equals "found"):
        return 1
    return external_tool_allows(database and run and call_id and archive_list_text(row and 1) and name and capability) equals 0
