import "group_runs"

# No retrospective role snapshots: older group runs remain unable to publish
# privileged host/rights results into a shared audience without this evidence.
define group_output_schema with database as Int returning Str:
    set prior to group_run_schema(database)
    if not (prior equals "applied" or else prior equals "already-applied"):
        return prior
    return migration_apply(database and 20 and "frozen-group-output-audience" and "CREATE TABLE echo_group_run_recipients(run TEXT NOT NULL REFERENCES echo_runs(run),principal TEXT NOT NULL REFERENCES echo_principals(identity),role TEXT NOT NULL,role_revision INTEGER NOT NULL,revocation_revision INTEGER NOT NULL,PRIMARY KEY(run,principal)); CREATE TRIGGER echo_group_recipients_no_update BEFORE UPDATE ON echo_group_run_recipients BEGIN SELECT RAISE(ABORT,'Run audience authority is immutable'); END; CREATE TRIGGER echo_group_recipients_no_delete BEFORE DELETE ON echo_group_run_recipients BEGIN SELECT RAISE(ABORT,'Run audience authority is immutable'); END; CREATE TRIGGER echo_group_recipients_capture AFTER INSERT ON echo_runs BEGIN INSERT INTO echo_group_run_recipients SELECT NEW.run,p.identity,p.role,(SELECT COUNT(*) FROM echo_authority_events WHERE principal=p.identity),(SELECT COUNT(*) FROM echo_principal_revocations WHERE principal=p.identity) FROM echo_group_run_origins g JOIN echo_group_sessions s ON s.session=g.session JOIN echo_group_audiences a ON a.group_id=s.group_id AND a.revision=s.revision JOIN echo_principals p ON p.identity=a.principal WHERE g.run=NEW.run AND g.session=NEW.session; END;")
