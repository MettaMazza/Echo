import "../archive/history"

# Optional for older databases. SQL expressions are trusted caller aliases.
# Deadline is evaluated at every admission/dispatch, not by a best-effort timer.
define group_active_sql with database as Int and group_expression as Str returning Str:
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_lifecycle';"))
    if archive_list_text(installed and 0) equals "end":
        return "1"
    if not (archive_list_text(installed and 0) equals "found"):
        return "0"
    set clause to concat("NOT EXISTS(SELECT 1 FROM echo_group_lifecycle lifecycle WHERE lifecycle.group_id=" and group_expression)
    return concat(clause and " AND lifecycle.revision=(SELECT MAX(newer.revision) FROM echo_group_lifecycle newer WHERE newer.group_id=lifecycle.group_id) AND (lifecycle.state='archived' OR (lifecycle.expires_ms>0 AND lifecycle.expires_ms<=CAST(strftime('%s','now') AS INTEGER)*1000)))")

define group_active with database as Int and group_id as Str returning Int:
    set values to create_list()
    set added to append_list(values and group_id)
    set clause to group_active_sql(database and "g.identity")
    set query to concat("SELECT identity FROM echo_groups g WHERE identity=?1 AND " and concat(clause and ";"))
    set row to history_collect_one(checkpoint_prepare(database and query and values))
    return archive_list_text(row and 0) equals "found"
