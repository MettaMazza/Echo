import "group_route"

# Only host configuration identifies Echo's service principal. A device name,
# role claim, model argument or browser field cannot select this identity.
define system_silo_submit with database as Int and device as Str and context as Str and run as Str and message as Str and attachments as List returning List:
    set expected to ptr_to_str(get_env("ECHO_SYSTEM_PRINCIPAL"))
    set principal to principal_for_device(database and device)
    if string_length(expected) equals 0 or else string_length(principal) equals 0 or else not (principal equals expected):
        return history_status("system-scope-not-authorized")
    if string_length(context) equals 0 or else group_text_valid(context) equals 0:
        return history_status("invalid-system-context")
    set namespace to concat(archive_hash_field(principal) and archive_hash_field(context))
    set identity to concat("echo-system:" and ep_sha256(namespace))
    set status to group_create(database and device and identity and "echo-system" and "local" and context and concat("silo:echo-system:" and ep_sha256(identity)))
    if not (status equals "created" or else status equals "already-created"):
        return history_status(status)
    return group_route_submit_files(database and device and identity and "echo-system" and "local" and context and run and message and attachments)
