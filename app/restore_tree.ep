import "archive/tree_snapshot"

define main returning Int:
    if get_argument_count() is not equal to 5:
        display "Supply absolute backup bundle, independently retained archive SHA256, manifest SHA256 and a new absolute restore directory."
        return 1
    if tree_restore_bundle(get_argument(1) and get_argument(2) and get_argument(3) and get_argument(4)) is not equal to 0:
        display "Restore refused or verification failed. Preserve any candidate and its .evidence directory; do not use it as a completed restore."
        return 1
    display "PASS: independent bundle-only restore; archive and manifest hashes verified before and after extraction, restored tree matches manifest. No restored programs were started."
    return 0
