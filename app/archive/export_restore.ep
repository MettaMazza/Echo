import "export_verify"

# Restore originals only into an empty archive. Application state and device
# authority are deliberately not inferred from arbitrary imported event text.
define archive_export_restore with database as Int and text as Str and trusted_head as Str returning Int:
    if archive_export_verify(text and trusted_head) is not equal to 0:
        return 1
    set format_tokens to provider_json_tokens(text)
    if provider_value(format_tokens and provider_member(format_tokens and 0 and "format")) equals "echo-branch-events-v2":
        return archive_branch_export_restore(database and text)
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    set statement to archive_prepare(database and "SELECT event FROM echo_events LIMIT 1;")
    if statement equals 0:
        return archive_rollback(database)
    set step to ep_sqlite3_step(statement)
    set closed to ep_sqlite3_finalize(statement)
    if step is not equal to 101 or else closed is not equal to 0:
        return archive_rollback(database)
    set tokens to provider_json_tokens(text)
    set session to provider_value(tokens and provider_member(tokens and 0 and "session"))
    set events to provider_items(tokens and provider_member(tokens and 0 and "events"))
    set index to 0
    repeat while index is less than length_list(events):
        set item to get_list(events and index)
        set event to provider_value(tokens and provider_member(tokens and item and "event"))
        set kind to provider_value(tokens and provider_member(tokens and item and "kind"))
        set payload to provider_value(tokens and provider_member(tokens and item and "payload"))
        set occurred to provider_value(tokens and provider_member(tokens and item and "occurred"))
        if archive_append_pending(database and session and event and kind and payload and occurred) is not equal to 0:
            return archive_rollback(database)
        set index to index + 1
    if archive_verify(database and session) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    return 0

# Verification above establishes every complete prefix and its parent anchor.
# Preserve original sequence positions because branch boundaries reference them.
# Restoring does not manufacture device authority, runnable tasks or file bytes.
define archive_branch_export_restore with database as Int and text as Str returning Int:
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    set statement to archive_prepare(database and "SELECT event FROM echo_events LIMIT 1;")
    if statement equals 0:
        return archive_rollback(database)
    set step to ep_sqlite3_step(statement)
    set closed to ep_sqlite3_finalize(statement)
    if step is not equal to 101 or else closed is not equal to 0:
        return archive_rollback(database)
    set tokens to provider_json_tokens(text)
    set chains to provider_items(tokens and provider_member(tokens and 0 and "chains"))
    set fields to ["session", "event", "kind", "payload", "occurred", "previous", "digest"]
    set index to 0
    repeat while index is less than length_list(chains):
        set chain to get_list(chains and index)
        set events to provider_items(tokens and provider_member(tokens and chain and "events"))
        set position to 0
        repeat while position is less than length_list(events):
            set item to get_list(events and position)
            set statement to archive_prepare(database and "INSERT INTO echo_events(sequence,session,event,kind,payload,occurred,previous,digest) VALUES(?,?,?,?,?,?,?,?);")
            if statement equals 0:
                return archive_rollback(database)
            set bound to ep_sqlite3_bind_int(statement and 1 and string_to_int(provider_value(tokens and provider_member(tokens and item and "sequence"))))
            set field to 0
            repeat while field is less than length_list(fields):
                set value to provider_value(tokens and provider_member(tokens and item and ptr_to_str(get_list(fields and field))))
                set bound to bound + archive_bind(statement and field + 2 and value)
                set field to field + 1
            if bound is not equal to 0:
                set closed to ep_sqlite3_finalize(statement)
                return archive_rollback(database)
            if archive_finish(statement and 101) is not equal to 0:
                return archive_rollback(database)
            set position to position + 1
        if archive_verify(database and provider_value(tokens and provider_member(tokens and chain and "session"))) is not equal to 0:
            return archive_rollback(database)
        set index to index + 1
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    return 0
