import "attachment_scope"
import "attachment_lifecycle"
import "../security/principals"
import "../retained_text"
import "../tools/history_tools"

# Resolve selected identities under the submission transaction. The immutable
# receipt records original provenance without placing host paths in context.
define turn_attachment_manifest with database as Int and device as Str and session as Str and event as Str and attachments as List returning Str:
    set builder to create_builder()
    set added to builder_append(builder and concat("{\"user_event\":" and concat(provider_quote(event) and ",\"attachments\":[")))
    set index to 0
    repeat while index is less than length_list(attachments):
        set attachment to archive_list_text(attachments and index)
        if attachment_selectable(database and attachment) equals 0:
            # Exact retries compare the reconstructed manifest with their saved
            # receipt below the caller. Trash must not rewrite an accepted turn.
            set accepted_binding to turn_attachment_read(database and session and event)
            if not (archive_list_text(accepted_binding and 0) equals "found") or else not (archive_list_text(accepted_binding and 2) equals "turn_attachments"):
                return ""
        set earlier to 0
        repeat while earlier is less than index:
            if archive_list_text(attachments and earlier) equals attachment:
                return ""
            set earlier to earlier + 1
        set values to create_list()
        set added to append_list(values and session)
        set added to append_list(values and device)
        set added to append_list(values and attachment)
        set row to history_collect_one(checkpoint_prepare(database and concat(session_scope_sql() and concat("SELECT a.event,a.digest,CAST(a.bytes AS TEXT),a.media_type,a.name FROM scopes s JOIN echo_attachments a ON a.session=s.session JOIN echo_events e ON e.event=a.event AND e.sequence<=s.boundary JOIN echo_session_owners o ON o.session=a.session JOIN echo_devices d ON d.device=o.device WHERE " and concat(principal_session_sql(database and "o.session" and "o.device") and " AND d.device=?2 AND d.revoked=0 AND a.attachment=?3;"))) and values))
        if archive_list_text(row and 0) equals "end" and attachment_shared_session(database and session) equals 1:
            set shared to group_device_session_sql(database and "a.session" and "?2")
            set row to history_collect_one(checkpoint_prepare(database and concat("SELECT a.event,a.digest,CAST(a.bytes AS TEXT),a.media_type,a.name FROM echo_attachments a WHERE a.session=?1 AND a.attachment=?3 AND " and concat(shared and ";")) and values))
        if not (archive_list_text(row and 0) equals "found"):
            return ""
        if index is greater than 0:
            set added to builder_append(builder and ",")
        set added to builder_append(builder and concat("{\"attachment\":" and provider_quote(attachment)))
        set added to builder_append(builder and concat(",\"event\":" and provider_quote(archive_list_text(row and 1))))
        set added to builder_append(builder and concat(",\"sha256\":" and provider_quote(archive_list_text(row and 2))))
        set added to builder_append(builder and concat(",\"bytes\":" and provider_quote(archive_list_text(row and 3))))
        set added to builder_append(builder and concat(",\"media_type\":" and provider_quote(archive_list_text(row and 4))))
        set added to builder_append(builder and concat(",\"name\":" and concat(provider_quote(archive_list_text(row and 5)) and "}")))
        set index to index + 1
    set added to builder_append(builder and "]}")
    return ptr_to_str(builder_to_string(builder))

define turn_attachment_read with database as Int and session as Str and event as Str returning List:
    set values to create_list()
    set added to append_list(values and concat(event and ":attachments"))
    set added to append_list(values and session)
    return history_collect_one(checkpoint_prepare(database and "SELECT payload,kind FROM echo_events WHERE event=?1 AND session=?2;" and values))
