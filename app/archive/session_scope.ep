# Resolve immutable branch ancestry at recorded source endpoints. Every parent
# endpoint predates its branch event; descendants cannot expose later messages.
# UNION also deduplicates repeated ancestry without imposing a depth ceiling.
define session_scope_sql returning Str:
    return "WITH RECURSIVE scopes(session,boundary,omit_user) AS (SELECT ?1,COALESCE((SELECT MAX(sequence) FROM echo_events WHERE session=?1),0),'' UNION SELECT p.session,p.sequence,CASE WHEN p.kind='user' AND json_extract(b.payload,'$.mode') IN ('edit','regenerate') THEN p.event ELSE '' END FROM scopes s JOIN echo_events b ON b.session=s.session AND b.kind='session_branch' AND b.sequence<=s.boundary JOIN echo_events p ON p.event=json_extract(CASE WHEN json_valid(b.payload) THEN b.payload ELSE '{}' END,'$.endpoint') AND p.session=json_extract(CASE WHEN json_valid(b.payload) THEN b.payload ELSE '{}' END,'$.source') AND p.digest=json_extract(CASE WHEN json_valid(b.payload) THEN b.payload ELSE '{}' END,'$.digest') AND CAST(p.sequence AS TEXT)=json_extract(CASE WHEN json_valid(b.payload) THEN b.payload ELSE '{}' END,'$.sequence') AND p.sequence<b.sequence) "
