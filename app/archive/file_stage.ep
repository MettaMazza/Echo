import "../transport/native_open"
import "file_digest"

# Staging paths are generated by the host, never derived from upload names.
# Failed candidates stay unregistered; callers may inspect/remove them later.
define file_stage_open with library as Int and path as Str returning Int:
    set open_function to ep_dlsym(library and "open")
    if open_function equals 0:
        return -1
    # Darwin O_RDWR|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC, mode 0600.
    return native_open_mode(library and path and 16780034 and 384)

define file_stage_write with library as Int and descriptor as Int and pointer as Int and bytes as Int returning Int:
    if descriptor is less than 0 or else bytes is less than 0 or else (bytes is greater than 0 and pointer equals 0):
        return 1
    set write_function to ep_dlsym(library and "write")
    if write_function equals 0:
        return 1
    set offset to 0
    repeat while offset is less than bytes:
        set written to ep_dlcall3(write_function and descriptor and pointer + offset and bytes - offset)
        if written is less than 0 or else written is greater than bytes - offset:
            if socket_errno(library) equals 4:
                continue
            return 1
        if written equals 0:
            return 1
        set offset to offset + written
    return 0

# Always closes the descriptor, including on flush failure. Success means the
# file was flushed; directory publication is a separate storage operation.
define file_stage_finish with library as Int and descriptor as Int returning Int:
    set flush_function to ep_dlsym(library and "fsync")
    set result to 1
    if flush_function is not equal to 0:
        repeat while 1 equals 1:
            set result to socket_signed_result(ep_dlcall1(flush_function and descriptor))
            if result equals 0 or else socket_errno(library) is not equal to 4:
                break
    set closed to net_close(descriptor)
    if result is not equal to 0 or else closed is not equal to 0:
        return 1
    return 0
