import "history"

# Temporary and attached databases are normal SQLite connection state. Select
# the named main archive; do not assume PRAGMA database_list has only one row.
# An in-memory main database intentionally has no reopenable file path.
define archive_main_path with database as Int returning Str:
    set location to history_collect_one(archive_prepare(database and "SELECT file FROM pragma_database_list WHERE name='main';"))
    if not (archive_list_text(location and 0) equals "found"):
        return ""
    return concat(archive_list_text(location and 1) and "")
