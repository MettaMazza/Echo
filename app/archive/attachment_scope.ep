import "../security/group_history"

# Internal readers receive the run's trusted session. Shared sources must be
# in that segment or its verified same-audience branch ancestry. Private
# ancestry is never imported into it.
# HTTP callers separately authenticate the requesting audience member.
define attachment_shared_session with database as Int and session as Str returning Int:
    set installed to history_collect_one(archive_prepare(database and "SELECT name FROM sqlite_master WHERE type='table' AND name='echo_group_sessions';"))
    if not (archive_list_text(installed and 0) equals "found") or else group_history_allows(database and session) equals 0:
        return 0
    set values to [session]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_group_sessions WHERE session=?;" and values))
    return archive_list_text(row and 0) equals "found"

# Caller has checked the current shared session. Restrict every ancestor to
# the same group and membership revision, as well as its saved event boundary.
define attachment_shared_scope_sql returning Str:
    return concat(session_scope_sql() and ", shared_scopes AS (SELECT s.session,s.boundary FROM scopes s JOIN echo_group_sessions p ON p.session=s.session JOIN echo_group_sessions root ON root.session=?1 AND root.group_id=p.group_id AND root.revision=p.revision) ")
