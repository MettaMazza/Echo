import "attachment_scope"
import "../tools/history_tools"

# Trash changes new-selection eligibility, never original historical bytes.
# Scope/authority is checked by the authenticated writer before appending.
define attachment_lifecycle_state with database as Int and attachment as Str returning List:
    return history_collect_one(checkpoint_prepare(database and "SELECT COALESCE((SELECT event FROM echo_events WHERE kind='attachment_lifecycle' AND json_extract(payload,'$.attachment')=?1 ORDER BY sequence DESC LIMIT 1),''),COALESCE((SELECT json_extract(payload,'$.state') FROM echo_events WHERE kind='attachment_lifecycle' AND json_extract(payload,'$.attachment')=?1 ORDER BY sequence DESC LIMIT 1),'active');" and [attachment]))

define attachment_selectable with database as Int and attachment as Str returning Int:
    set state to attachment_lifecycle_state(database and attachment)
    return archive_list_text(state and 0) equals "found" and also archive_list_text(state and 2) equals "active"
