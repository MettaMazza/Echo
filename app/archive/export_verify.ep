import "event_store"
import "../providers/json_access"

# Hash chains detect corruption, not authorship. A separately trusted head can
# also reject a consistently rewritten or shortened export.
define archive_export_verify_single with text as Str and trusted_head as Str returning Int:
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) is not equal to 1:
        return 1
    if not (provider_value(tokens and provider_member(tokens and 0 and "format")) equals "echo-session-events-v1"):
        return 1
    set session to provider_value(tokens and provider_member(tokens and 0 and "session"))
    set events_field to provider_member(tokens and 0 and "events")
    if string_length(session) equals 0 or else not (provider_kind(tokens and events_field) equals "["):
        return 1
    set events to provider_items(tokens and events_field)
    set previous to ""
    set index to 0
    repeat while index is less than length_list(events):
        set item to get_list(events and index)
        set stored_session to provider_value(tokens and provider_member(tokens and item and "session"))
        set event to provider_value(tokens and provider_member(tokens and item and "event"))
        set kind to provider_value(tokens and provider_member(tokens and item and "kind"))
        set payload_field to provider_member(tokens and item and "payload")
        set occurred to provider_value(tokens and provider_member(tokens and item and "occurred"))
        set stored_previous to provider_value(tokens and provider_member(tokens and item and "previous"))
        set digest to provider_value(tokens and provider_member(tokens and item and "digest"))
        if not (stored_session equals session) or else string_length(event) equals 0 or else string_length(kind) equals 0 or else not (provider_kind(tokens and payload_field) equals "string") or else not (stored_previous equals previous):
            return 1
        set expected to archive_digest(session and event and kind and provider_value(tokens and payload_field) and occurred and previous)
        if not (expected equals digest):
            return 1
        set previous to digest
        set index to index + 1
    if not (provider_value(tokens and provider_member(tokens and 0 and "event_count")) equals int_to_string(length_list(events))) or else not (provider_value(tokens and provider_member(tokens and 0 and "head")) equals previous):
        return 1
    if string_length(trusted_head) is greater than 0 and not (trusted_head equals previous):
        return 1
    return 0

# Extract one exact JSON object without reserialising payload strings.
define archive_export_part with text as Str and tokens as List and index as Int returning Str:
    set after to provider_after(tokens and index)
    if after is less than 1:
        return ""
    set start to get_list(get_list(tokens and index) and 1)
    set finish to get_list(get_list(tokens and after - 1) and 2)
    return ptr_to_str(substring(text and start and finish - start))

define archive_export_verify with text as Str and trusted_head as Str returning Int:
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) is not equal to 1:
        return 1
    set format to provider_value(tokens and provider_member(tokens and 0 and "format"))
    if format equals "echo-session-events-v1":
        set standalone_events to provider_items(tokens and provider_member(tokens and 0 and "events"))
        if standalone_events equals 0:
            return 1
        set standalone_index to 0
        repeat while standalone_index is less than length_list(standalone_events):
            set item to get_list(standalone_events and standalone_index)
            if provider_value(tokens and provider_member(tokens and item and "kind")) equals "session_branch":
                return 1
            set standalone_index to standalone_index + 1
        return archive_export_verify_single(text and trusted_head)
    if not (format equals "echo-branch-events-v2"):
        return 1
    set chains to provider_items(tokens and provider_member(tokens and 0 and "chains"))
    if chains equals 0 or else length_list(chains) is less than 2:
        return 1
    set expected_session to provider_value(tokens and provider_member(tokens and 0 and "session"))
    set expected_head to provider_value(tokens and provider_member(tokens and 0 and "head"))
    if string_length(expected_head) equals 0 or else (string_length(trusted_head) is greater than 0 and not (trusted_head equals expected_head)):
        return 1
    set expected_event to ""
    set expected_sequence to ""
    set child_sequence to 0
    set seen to create_map()
    set index to 0
    repeat while index is less than length_list(chains):
        set chain to archive_export_part(text and tokens and get_list(chains and index))
        if archive_export_verify_single(chain and expected_head) is not equal to 0:
            return 1
        set chain_tokens to provider_json_tokens(chain)
        if not (provider_value(chain_tokens and provider_member(chain_tokens and 0 and "session")) equals expected_session):
            return 1
        set events to provider_items(chain_tokens and provider_member(chain_tokens and 0 and "events"))
        if length_list(events) equals 0:
            return 1
        set previous_sequence to 0
        set position to 0
        repeat while position is less than length_list(events):
            set item to get_list(events and position)
            set spelling to provider_value(chain_tokens and provider_member(chain_tokens and item and "sequence"))
            set sequence to string_to_int(spelling)
            set event to provider_value(chain_tokens and provider_member(chain_tokens and item and "event"))
            if sequence <= previous_sequence or else not (int_to_string(sequence) equals spelling) or else map_contains(seen and event) is not equal to 0:
                return 1
            set inserted to map_insert(seen and event and 1)
            if index is greater than 0 and sequence >= child_sequence:
                return 1
            if position is greater than 0 and provider_value(chain_tokens and provider_member(chain_tokens and item and "kind")) equals "session_branch":
                return 1
            set previous_sequence to sequence
            set position to position + 1
        set last to get_list(events and length_list(events) - 1)
        if index is greater than 0:
            if not (provider_value(chain_tokens and provider_member(chain_tokens and last and "event")) equals expected_event) or else not (provider_value(chain_tokens and provider_member(chain_tokens and last and "sequence")) equals expected_sequence):
                return 1
        set first to get_list(events and 0)
        set is_branch to provider_value(chain_tokens and provider_member(chain_tokens and first and "kind")) equals "session_branch"
        if index + 1 equals length_list(chains):
            if is_branch:
                return 1
        else:
            if not is_branch:
                return 1
            set origin to provider_json_tokens(provider_value(chain_tokens and provider_member(chain_tokens and first and "payload")))
            if origin equals 0 or else provider_unique_objects(origin) is not equal to 1:
                return 1
            set expected_session to provider_value(origin and provider_member(origin and 0 and "source"))
            set expected_head to provider_value(origin and provider_member(origin and 0 and "digest"))
            set expected_event to provider_value(origin and provider_member(origin and 0 and "endpoint"))
            set expected_sequence to provider_value(origin and provider_member(origin and 0 and "sequence"))
            set child_sequence to string_to_int(provider_value(chain_tokens and provider_member(chain_tokens and first and "sequence")))
        set index to index + 1
    return 0
