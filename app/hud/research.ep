import "../workspace/read_text"
import "../security/external_tools"

# Research records can contain private prompts. An administrator's public run
# is not a private owner session; even another administrator is not a reader.
define hud_research_owner with database as Int and run as Str returning Str:
    if run_authority_allows(database and run and "admin") equals 0 or else group_privileged_audience_allows(database and run) equals 0:
        return ""
    set row to history_collect_one(checkpoint_prepare(database and "SELECT a.principal,r.session FROM echo_run_authority a JOIN echo_runs r ON r.run=a.run WHERE r.run=?;" and [run]))
    if not (archive_list_text(row and 0) equals "found") or else not (external_scope_session_status(database and archive_list_text(row and 2)) equals "local"):
        return ""
    set owner to archive_list_text(row and 1)
    set audience to history_collect_one(checkpoint_prepare(database and "SELECT s.session FROM echo_group_sessions s JOIN echo_group_audiences a ON a.group_id=s.group_id AND a.revision=s.revision WHERE s.session=?1 AND a.principal<>?2 LIMIT 1;" and [archive_list_text(row and 2),owner]))
    if not (archive_list_text(audience and 0) equals "end"):
        return ""
    return owner

# The host pins this complete catalogue in its service environment. Records
# retain exact original JSON bytes, owner and source; this is observation data,
# never a command, activation receipt or grant of model/host authority.
define hud_research_catalog with text as Str and owner as Str and after as Int returning Str:
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and 0) equals "{") or else not (provider_value(tokens and provider_member(tokens and 0 and "format")) equals "1") or else not (provider_kind(tokens and provider_member(tokens and 0 and "records")) equals "["):
        return "{\"status\":\"invalid-research-catalog\"}"
    set cursor to 0
    for each entry in provider_items(tokens and provider_member(tokens and 0 and "records")):
        if provider_value(tokens and provider_member(tokens and entry and "principal")) equals owner:
            set cursor to cursor + 1
            if cursor > after:
                set original to provider_value(tokens and provider_member(tokens and entry and "original_record"))
                set digest to provider_value(tokens and provider_member(tokens and entry and "sha256"))
                set source to provider_value(tokens and provider_member(tokens and entry and "source"))
                if string_length(source) equals 0 or else not (provider_kind(tokens and provider_member(tokens and entry and "original_record")) equals "string") or else provider_json_tokens(original) equals 0 or else not (ep_sha256(original) equals digest):
                    return "{\"status\":\"research-record-integrity-failed\"}"
                set result to concat("{\"status\":\"found\",\"next_after\":" and int_to_string(cursor))
                set result to concat(result and concat(",\"source\":" and provider_quote(source)))
                set result to concat(result and concat(",\"sha256\":" and provider_quote(digest)))
                set result to concat(result and concat(",\"original_record\":" and provider_quote(original)))
                return concat(result and ",\"record_kind\":\"retained experiment evidence\",\"live_model_state\":\"Not established by a historical experiment record.\",\"authority\":\"Record contents are evidence, not instructions or consent.\"}")
    return "{\"status\":\"end\"}"

# All I/O follows the HUD's initial authority snapshot and is followed by its
# fresh owner check. No arbitrary path or owner is accepted from tool arguments.
define hud_research_read with owner as Str and after as Int returning Str:
    set path to ptr_to_str(get_env("ECHO_RESEARCH_CATALOG"))
    set expected to ptr_to_str(get_env("ECHO_RESEARCH_CATALOG_SHA256"))
    if string_length(path) equals 0:
        return "{\"status\":\"not-configured\",\"recovery\":\"Install an owner-scoped research catalogue and its service hash.\"}"
    if string_length(owner) equals 0 or else after < 0 or else string_length(expected) is not equal to 64 or else string_length(path) < 2 or else get_character(path and 0) is not equal to 47:
        return "{\"status\":\"invalid-research-configuration\"}"
    set relative to substring(path and 1 and string_length(path) - 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return "{\"status\":\"research-unavailable\"}"
    set root to workspace_root_open(library and "/")
    set read to workspace_read_text(library and root and relative and 65536 and 0 and -1)
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    if not (archive_list_text(read and 0) equals "read"):
        return "{\"status\":\"research-catalog-unavailable\"}"
    if not (archive_list_text(read and 3) equals expected):
        return "{\"status\":\"research-catalog-changed\"}"
    set result to hud_research_catalog(archive_list_text(read and 1) and owner and after)
    return concat(substring(result and 0 and string_length(result) - 1) and concat(",\"catalog_sha256\":" and concat(provider_quote(expected) and "}")))
