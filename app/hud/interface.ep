import "state"

define hud_arguments_valid with tokens as List and human as Int returning Int:
    set keys to ["section","after"]
    if human equals 1:
        set added to append_list(keys and "run")
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else project_object_keys(tokens and 0 and keys) equals 0:
        return 0
    set field to provider_member(tokens and 0 and "section")
    if not (provider_kind(tokens and field) equals "string") or else history_tool_integer(tokens and "after") < 0:
        return 0
    set section to provider_value(tokens and field)
    if not (section equals "interaction" or else section equals "context" or else section equals "work" or else section equals "schedules" or else section equals "incidents" or else section equals "community" or else section equals "rights" or else section equals "machine"):
        return 0
    if human equals 1:
        set field to provider_member(tokens and 0 and "run")
        if not (provider_kind(tokens and field) equals "string") or else string_length(provider_value(tokens and field)) equals 0:
            return 0
    return 1

define hud_execute with database as Int and run as Str and arguments as Str returning Str:
    set tokens to provider_json_tokens(arguments)
    if hud_arguments_valid(tokens and 0) equals 0:
        return "{\"status\":\"invalid-arguments\"}"
    return hud_read(database and run and provider_value(tokens and provider_member(tokens and 0 and "section")) and history_tool_integer(tokens and "after"))

define hud_web_read with database as Int and device as Str and tokens as List returning Str:
    if hud_arguments_valid(tokens and 1) equals 0:
        return "{\"status\":\"invalid-arguments\"}"
    return hud_read_for_device(database and device and provider_value(tokens and provider_member(tokens and 0 and "run")) and provider_value(tokens and provider_member(tokens and 0 and "section")) and history_tool_integer(tokens and "after"))
