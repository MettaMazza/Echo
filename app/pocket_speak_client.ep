import "providers/json_access"
import "providers/archived_stream"
import "fs"

# Host-selected loopback service. Text stays in the private job file and is
# encoded by curl, never interpreted as shell syntax. exec preserves the
# supervised helper PID/process group for timeout and cancellation.
define main returning Int:
    if get_argument_count() is not equal to 2 or else not file_exists("input.txt"):
        return 1
    set config to provider_json_tokens(ptr_to_str(read_file(get_argument(1))))
    set port_text to provider_value(config and provider_member(config and 0 and "port"))
    set port to string_to_int(port_text)
    if port < 1 or else port > 65535:
        return 2
    set endpoint to concat("http://127.0.0.1:" and concat(int_to_string(port) and "/tts"))
    set names to ["/usr/bin/curl", "--disable", "--fail", "--silent", "--show-error", "--noproxy", "*", "--connect-timeout", "5", "--max-time", "300", "--data-urlencode", "text@input.txt", "--output", "spoken.wav", endpoint]
    set argv to create_list()
    for each name in names:
        set added to append_list(argv and name)
    set added to append_list(argv and 0)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set execute to ep_dlsym(library and "execv")
    if execute equals 0:
        return 3
    set result to ep_dlcall2(execute and str_to_ptr("/usr/bin/curl") and get_list_data_ptr(argv))
    return 4
