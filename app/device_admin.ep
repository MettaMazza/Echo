import "web/run_store"

# Host-local administration only. Never expose these operations as public routes.
define main returning Int:
    if get_argument_count() is less than 3:
        display "Supply database and invite, list or revoke; revoke also needs a device identity."
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    set command to get_argument(2)
    if command equals "invite":
        set invitation to concat(agent_identity() and agent_identity())
        if web_pairing_invite(database and invitation) is not equal to 0:
            set closed to sql_close(database)
            return 1
        display "One-use invitation. Enter it only in your local Echo pairing form:"
        display invitation
    else if command equals "revoke":
        if get_argument_count() is not equal to 4:
            set closed to sql_close(database)
            return 1
        if web_device_revoke(database and get_argument(3)) is not equal to 0:
            set closed to sql_close(database)
            return 1
        display "Device access revoked. Existing saved conversations remain on disk."
    else if command equals "list":
        set statement to archive_prepare(database and "SELECT device,name,revoked FROM echo_devices ORDER BY device;")
        if statement equals 0:
            set closed to sql_close(database)
            return 1
        repeat while 1 equals 1:
            set step to ep_sqlite3_step(statement)
            if step equals 101:
                break
            if step is not equal to 100:
                set released to ep_sqlite3_finalize(statement)
                set closed to sql_close(database)
                return 1
            set identity to ptr_to_str(ep_sqlite3_column_text(statement and 0))
            set name to ptr_to_str(ep_sqlite3_column_text(statement and 1))
            set revoked to ptr_to_str(ep_sqlite3_column_text(statement and 2))
            display concat(provider_quote(identity) and concat(" " and concat(provider_quote(name) and concat(" revoked=" and revoked))))
        set released to ep_sqlite3_finalize(statement)
    else:
        set closed to sql_close(database)
        return 1
    return sql_close(database)
