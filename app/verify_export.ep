import "archive/export_verify"
import "fs"
import "os"

define main returning Int:
    if get_argument_count() is not equal to 2 and get_argument_count() is not equal to 3:
        display "Supply a conversation export path and optionally its separately saved final hash."
        return 1
    if not file_exists(get_argument(1)):
        return 1
    set trusted_head to ""
    if get_argument_count() equals 3:
        set trusted_head to get_argument(2)
    if archive_export_verify(ptr_to_str(read_file(get_argument(1))) and trusted_head) is not equal to 0:
        display "Export verification failed."
        return 1
    display "Export event contents and hash chain verified. This does not establish authorship or restore application state."
    return 0
