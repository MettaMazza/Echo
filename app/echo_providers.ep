import "providers/registry"
import "fs"

define main returning Int:
    if get_argument_count() is less than 4:
        display "Usage: echo_providers register database identity label profile-file"
        display "Or: echo_providers select database identity"
        return 1
    set mode to get_argument(1)
    if not (mode equals "register" or else mode equals "select"):
        return 1
    if mode equals "register" and get_argument_count() is not equal to 6:
        return 1
    if mode equals "select" and get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(2))
    if database equals 0:
        return 1
    set status to provider_registry_schema(database)
    if status equals 0:
        if mode equals "register":
            set status to provider_registry_register(database and get_argument(3) and get_argument(4) and ptr_to_str(read_file(get_argument(5))))
        else:
            set status to provider_registry_select(database and get_argument(3))
    if sql_close(database) is not equal to 0:
        return 1
    if status equals 0:
        display "Provider configuration saved."
    return status
