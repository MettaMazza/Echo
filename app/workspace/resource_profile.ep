import "host_profile"
import "sandbox_profile"

# The trusted host/controller supplies resource sets, never tool arguments.
# This builder does not grant authority or select a conversation's resources.
# Empty read/write sets are valid; private/protected/secret roots are required.
# No network or blanket host filesystem/process grant is added.
define workspace_resource_profile with readable as Str and writable as Str and private_roots as Str returning Str:
    set protected to host_policy_roots(ptr_to_str(get_env("ECHO_HOST_PROTECTED_ROOTS")))
    set secrets to host_policy_roots(ptr_to_str(get_env("ECHO_HOST_SECRET_ROOTS")))
    set private to host_policy_roots(private_roots)
    if protected equals 0 or else secrets equals 0 or else private equals 0:
        return ""
    set profile to workspace_sandbox_profile()
    set mode to 0
    for each configured in [readable,writable]:
        set tokens to provider_json_tokens(configured)
        if tokens equals 0 or else not (provider_kind(tokens and 0) equals "["):
            return ""
        set items to provider_items(tokens and 0)
        if items equals 0:
            return ""
        if length_list(items) > 0:
            set roots to host_policy_roots(configured)
            if roots equals 0:
                return ""
            set filters to ""
            for each root in roots:
                set filters to concat(filters and concat(" (subpath " and concat(provider_quote(root) and ")")))
            set operations to "file-read*"
            if mode equals 1:
                set operations to "file-read* file-write*"
            set profile to concat(profile and concat("(allow " and concat(operations and concat(filters and ")\n"))))
        set mode to mode + 1
    # Denies win over every resource and workspace allow. Private roots must
    # include all unscoped state; the controller must validate their coverage.
    for each roots in [protected,secrets,private]:
        set filters to ""
        for each root in roots:
            set filters to concat(filters and concat(" (subpath " and concat(provider_quote(root) and ")")))
        set operations to "file-read* file-write* file-map-executable process-exec"
        if roots equals protected:
            set operations to "file-write*"
        set profile to concat(profile and concat("(deny " and concat(operations and concat(filters and ")\n"))))
    return profile
