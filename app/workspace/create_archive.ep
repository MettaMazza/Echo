import "../retained_text"
import "extract_archive"
import "archive_patch"

# Stream only explicitly selected regular workspace files. No recursive host
# traversal, stored links, permissions, external filters or shell commands.
define workspace_archive_write_file with system as Int and library as Int and writer as Int and root as Int and path as Str and buffer as Int returning Int:
    set input to workspace_file_open(system and root and path and 0)
    if input < 0:
        return 1
    set size to ep_dlcall3(ep_dlsym(system and "lseek") and input and 0 and 2)
    if size < 0 or else ep_dlcall3(ep_dlsym(system and "lseek") and input and 0 and 0) is not equal to 0:
        set closed to net_close(input)
        return 1
    set entry to ep_dlcall0(ep_dlsym(library and "archive_entry_new"))
    if entry equals 0:
        set closed to net_close(input)
        return 1
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_pathname") and entry and str_to_ptr(path))
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_size") and entry and size)
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_filetype") and entry and 32768)
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_perm") and entry and 384)
    set status to socket_signed_result(ep_dlcall2(ep_dlsym(library and "archive_write_header") and writer and entry))
    set freed to ep_dlcall1(ep_dlsym(library and "archive_entry_free") and entry)
    set total to 0
    repeat while status equals 0:
        set count to socket_signed_result(ep_dlcall3(ep_dlsym(system and "read") and input and buffer and 65536))
        if count equals 0:
            break
        if count < 0:
            if socket_errno(system) equals 4:
                continue
            set status to 1
            break
        if total > size - count:
            set status to 1
            break
        set offset to 0
        repeat while offset < count:
            set written to ep_dlcall3(ep_dlsym(library and "archive_write_data") and writer and buffer + offset and count - offset)
            if written <= 0 or else written > count - offset:
                set status to 1
                break
            set offset to offset + written
        set total to total + count
    set closed to net_close(input)
    if status is not equal to 0 or else closed is not equal to 0 or else total is not equal to size:
        return 1
    return 0

define workspace_archive_write with system as Int and output as Int and root as Int and paths as List and format as Str returning Int:
    set library to ep_dlopen("/usr/lib/libarchive.2.dylib")
    if library equals 0:
        return 1
    set required to create_list()
    set split_count to retained_text_split(required and "archive_filter_bytes archive_entry_set_pathname_utf8 archive_write_set_options archive_write_new archive_write_set_format_zip archive_write_set_format_pax_restricted archive_write_add_filter_gzip archive_write_open_fd archive_entry_new archive_entry_set_pathname archive_entry_set_size archive_entry_set_filetype archive_entry_set_perm archive_write_header archive_entry_free archive_write_data archive_write_close archive_write_free archive_read_new archive_read_support_format_zip archive_read_set_options archive_read_open_fd archive_read_next_header archive_entry_pathname_utf8 archive_entry_filetype archive_entry_size archive_entry_hardlink archive_entry_symlink archive_entry_clone archive_read_data archive_read_data_skip archive_read_free" and " ")
    for each symbol in required:
        if ep_dlsym(library and ptr_to_str(symbol)) equals 0:
            set closed to ep_dlclose(library)
            return 1
    set writer to ep_dlcall0(ep_dlsym(library and "archive_write_new"))
    if writer equals 0:
        set closed to ep_dlclose(library)
        return 1
    set status to -1
    if format equals "zip" or else format equals "xml-parts" or else format equals "xml-patch":
        set status to socket_signed_result(ep_dlcall1(ep_dlsym(library and "archive_write_set_format_zip") and writer))
        if status equals 0:
            set status to socket_signed_result(ep_dlcall2(ep_dlsym(library and "archive_write_set_options") and writer and str_to_ptr("zip:hdrcharset=UTF-8")))
    else if format equals "tar" or else format equals "tar.gz":
        set status to socket_signed_result(ep_dlcall1(ep_dlsym(library and "archive_write_set_format_pax_restricted") and writer))
        if status equals 0 and format equals "tar.gz":
            set status to socket_signed_result(ep_dlcall1(ep_dlsym(library and "archive_write_add_filter_gzip") and writer))
    set buffer to ep_dlcall1(ep_dlsym(system and "malloc") and 65536)
    if buffer equals 0:
        set status to 1
    if status equals 0:
        set status to socket_signed_result(ep_dlcall2(ep_dlsym(library and "archive_write_open_fd") and writer and output))
        if status equals 0:
            if format equals "xml-patch":
                set status to workspace_archive_patch(system and library and writer and root and paths and buffer)
            else if format equals "xml-parts":
                set index to 0
                repeat while index < length_list(paths):
                    if workspace_archive_write_text(library and writer and archive_list_text(paths and index) and archive_list_text(paths and index + 1)) is not equal to 0:
                        set status to 1
                        break
                    set index to index + 2
            else:
                for each path in paths:
                    if workspace_archive_write_file(system and library and writer and root and ptr_to_str(path) and buffer) is not equal to 0:
                        set status to 1
                        break
            if ep_dlcall1(ep_dlsym(library and "archive_write_close") and writer) is not equal to 0:
                set status to 1
    if buffer is not equal to 0:
        set freed to ep_dlcall1(ep_dlsym(system and "free") and buffer)
    if ep_dlcall1(ep_dlsym(library and "archive_write_free") and writer) is not equal to 0:
        set status to 1
    set closed to ep_dlclose(library)
    return status

define workspace_create_archive with system as Int and root as Int and paths as List and destination as Str and format as Str returning Str:
    if length_list(paths) equals 0 or else not (format equals "zip" or else format equals "tar" or else format equals "tar.gz"):
        return "{\"status\":\"invalid-arguments\"}"
    set seen to create_list()
    for each path in paths:
        if workspace_path_parts(ptr_to_str(path)) equals 0:
            return "{\"status\":\"invalid-source-path\"}"
        for each prior in seen:
            if ptr_to_str(prior) equals ptr_to_str(path):
                return "{\"status\":\"duplicate-source\"}"
        set added to append_list(seen and path)
    return workspace_archive_commit(system and root and paths and destination and format)

define workspace_archive_commit with system as Int and root as Int and paths as List and destination as Str and format as Str returning Str:
    set parts to workspace_path_parts(destination)
    if parts equals 0:
        return "{\"status\":\"invalid-destination\"}"
    set parent to -1
    if length_list(parts) equals 1:
        set parent to socket_signed_result(ep_dlcall1(ep_dlsym(system and "dup") and root))
    else:
        set path to ""
        set index to 0
        repeat while index < length_list(parts) - 1:
            if index > 0:
                set path to concat(path and "/")
            set path to concat(path and archive_list_text(parts and index))
            set index to index + 1
        set parent to workspace_directory_open(system and root and path and 0)
    if parent < 0:
        return "{\"status\":\"parent-unavailable\"}"
    set temporary to concat(".echo-pending-" and ptr_to_str(ep_uuid_v4()))
    set output to workspace_file_open(system and parent and temporary and 1)
    if output < 0:
        set closed to net_close(parent)
        return "{\"status\":\"stage-failed\"}"
    set copied to workspace_archive_write(system and output and root and paths and format)
    set digest to file_digest_result("failed" and "" and 0)
    if copied equals 0 and ep_dlcall3(ep_dlsym(system and "lseek") and output and 0 and 0) equals 0:
        set duplicate to socket_signed_result(ep_dlcall1(ep_dlsym(system and "dup") and output))
        set hash_library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set digest to file_digest_owned_descriptor(hash_library and duplicate and 65536 and 1)
    set finished to file_stage_finish(system and output)
    set status to "archive-write-failed"
    if copied equals 0 and finished equals 0 and archive_list_text(digest and 0) equals "verified":
        set name to archive_list_text(parts and length_list(parts) - 1)
        set renamed to socket_signed_result(ep_dlcall5(ep_dlsym(system and "renameatx_np") and parent and str_to_ptr(temporary) and parent and str_to_ptr(name) and 4))
        if renamed equals 0:
            set status to "created"
            if ep_dlcall1(ep_dlsym(system and "fsync") and parent) is not equal to 0:
                set status to "publication-uncertain"
        else if socket_errno(system) equals 17:
            set status to "already-exists"
        else:
            set status to "publish-failed"
    if not (status equals "created" or else status equals "publication-uncertain"):
        set removed to ep_dlcall3(ep_dlsym(system and "unlinkat") and parent and str_to_ptr(temporary) and 0)
    set closed to net_close(parent)
    set result to concat("{\"status\":" and provider_quote(status))
    set result to concat(result and concat(",\"destination\":" and provider_quote(destination)))
    if status equals "created" or else status equals "publication-uncertain":
        set result to concat(result and concat(",\"archive_sha256\":" and provider_quote(archive_list_text(digest and 1))))
        set result to concat(result and concat(",\"archive_bytes\":" and int_to_string(get_list(digest and 2))))
    return concat(result and "}")

# Internal XML package writer. This mode is never accepted by the archive tool.
define workspace_archive_write_text with library as Int and writer as Int and path as Str and text as Str returning Int:
    set entry to ep_dlcall0(ep_dlsym(library and "archive_entry_new"))
    if entry equals 0:
        return 1
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_pathname") and entry and str_to_ptr(path))
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_size") and entry and string_length(text))
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_filetype") and entry and 32768)
    set assigned to ep_dlcall2(ep_dlsym(library and "archive_entry_set_perm") and entry and 384)
    set status to socket_signed_result(ep_dlcall2(ep_dlsym(library and "archive_write_header") and writer and entry))
    set freed to ep_dlcall1(ep_dlsym(library and "archive_entry_free") and entry)
    set offset to 0
    repeat while status equals 0 and offset < string_length(text):
        set written to ep_dlcall3(ep_dlsym(library and "archive_write_data") and writer and str_to_ptr(text) + offset and string_length(text) - offset)
        if written <= 0 or else written > string_length(text) - offset:
            return 1
        set offset to offset + written
    return status
