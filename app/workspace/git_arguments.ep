import "files"
import "../retained_text"

# Repository and subcommand are separate argv elements, never shell text.
define host_git_arguments with arguments as List returning List:
    set index to 1
    repeat while not (provider_kind(arguments and index) equals "}"):
        set key to provider_value(arguments and index)
        if not (key equals "repository" or else key equals "operation" or else key equals "arguments"):
            return 0
        set index to provider_after(arguments and index + 2)
        if provider_kind(arguments and index) equals ",":
            set index to index + 1
    set repository to provider_member(arguments and 0 and "repository")
    set operation to provider_member(arguments and 0 and "operation")
    set extra to provider_items(arguments and provider_member(arguments and 0 and "arguments"))
    if not (provider_kind(arguments and repository) equals "string") or else not (provider_kind(arguments and operation) equals "string") or else extra equals 0:
        return 0
    set path to provider_value(arguments and repository)
    set command to provider_value(arguments and operation)
    if string_length(path) < 2 or else get_character(path and 0) is not equal to 47 or else workspace_path_parts(substring(path and 1 and string_length(path) - 1)) equals 0 or else string_length(command) equals 0:
        return 0
    set index to 0
    repeat while index < string_length(command):
        set code to get_character(command and index)
        if not ((code >= 97 and code <= 122) or else (index > 0 and ((code >= 48 and code <= 57) or else code equals 45))):
            return 0
        set index to index + 1
    set result to ["--no-pager", "-C", path, command]
    for each item in extra:
        if not (provider_kind(arguments and item) equals "string"):
            return 0
        set added to append_list(result and provider_value(arguments and item))
    return result
