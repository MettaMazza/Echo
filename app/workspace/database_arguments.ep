import "../retained_text"
import "files"

define workspace_database_arguments with arguments as List returning List:
    set index to 1
    repeat while not (provider_kind(arguments and index) equals "}"):
        set key to provider_value(arguments and index)
        if not (key equals "path" or else key equals "sql"):
            return 0
        set index to provider_after(arguments and index + 2)
        if provider_kind(arguments and index) equals ",":
            set index to index + 1
    set path to provider_member(arguments and 0 and "path")
    set sql to provider_member(arguments and 0 and "sql")
    if not (provider_kind(arguments and path) equals "string") or else workspace_path_parts(provider_value(arguments and path)) equals 0 or else not (provider_kind(arguments and sql) equals "string") or else string_length(provider_value(arguments and sql)) equals 0:
        return 0
    return [provider_value(arguments and path), provider_value(arguments and sql)]
