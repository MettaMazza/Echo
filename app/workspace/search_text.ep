import "read_text"

# Literal, case-sensitive search. Full-file validation and digest refer to the
# same observed byte stream. The query and continuation offsets are byte-based.
define workspace_search_text with library as Int and root as Int and path as Str and query as Str and offset as Int and matches as Int returning Str:
    if string_length(query) equals 0 or else offset < 0 or else matches < 1:
        return "{\"status\":\"invalid-arguments\"}"
    set read to workspace_read_text(library and root and path and 65536 and 0 and -1)
    if not (archive_list_text(read and 0) equals "read"):
        return concat("{\"status\":" and concat(provider_quote(archive_list_text(read and 0)) and "}"))
    set text to archive_list_text(read and 1)
    set total to string_length(text)
    set query_size to string_length(query)
    set text_pointer to str_to_ptr(text)
    set query_pointer to str_to_ptr(query)
    set find to ep_dlsym(library and "strstr")
    if find equals 0:
        return "{\"status\":\"platform-error\"}"
    set cursor to offset
    set count to 0
    set positions_builder to create_builder()
    set added to builder_append(positions_builder and "[")
    set ended to "true"
    repeat while cursor <= total - query_size:
        set found_pointer to ep_dlcall2(find and text_pointer + cursor and query_pointer)
        if found_pointer equals 0:
            break
        if count equals matches:
            set ended to "false"
            break
        set found to found_pointer - text_pointer
        if count > 0:
            set added to builder_append(positions_builder and ",")
        set added to builder_append(positions_builder and int_to_string(found))
        set cursor to found + query_size
        set count to count + 1
    set positions to ptr_to_str(builder_to_string(positions_builder))
    set result to concat("{\"status\":\"found\",\"path\":" and provider_quote(path))
    set result to concat(result and concat(",\"sha256\":" and provider_quote(archive_list_text(read and 3))))
    set result to concat(result and concat(",\"bytes\":" and int_to_string(get_list(read and 4))))
    set result to concat(result and concat(",\"byte_offsets\":" and concat(positions and "]")))
    set result to concat(result and concat(",\"next_offset\":" and int_to_string(cursor)))
    return concat(result and concat(",\"end\":" and concat(ended and "}")))
