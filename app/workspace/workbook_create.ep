import "create_archive"
import "workbook_read"

# Escape XML content and attributes without changing literal cell values.
define workbook_xml_escape with text as Str returning Str:
    set text to string_replace(text and "&" and "&amp;")
    set text to string_replace(text and "<" and "&lt;")
    set text to string_replace(text and ">" and "&gt;")
    set text to string_replace(text and "\"" and "&quot;")
    set text to string_replace(text and "'" and "&apos;")
    return string_replace(text and "\r" and "&#13;")

define workbook_column with column as Int returning Str:
    set result to ""
    repeat while column > 0:
        set column to column - 1
        set result to concat(substring("ABCDEFGHIJKLMNOPQRSTUVWXYZ" and column modulo 26 and 1) and result)
        set column to column / 26
    return result

# JSON scalars become typed cells. A formula object has formula and optionally
# cached; cached is an explicit supplied result, never a calculated claim.
define workbook_cell_xml with tokens as List and item as Int and reference as Str returning Str:
    set kind to provider_kind(tokens and item)
    set value to provider_value(tokens and item)
    set attributes to ""
    set body to ""
    if kind equals "string":
        set attributes to " t=\"inlineStr\""
        set body to concat("<is><t xml:space=\"preserve\">" and concat(workbook_xml_escape(value) and "</t></is>"))
    else if kind equals "number":
        set body to concat("<v>" and concat(value and "</v>"))
    else if kind equals "true" or else kind equals "false":
        set attributes to " t=\"b\""
        set body to "<v>0</v>"
        if kind equals "true":
            set body to "<v>1</v>"
    else if kind equals "{":
        set field to provider_member(tokens and item and "formula")
        if not (provider_kind(tokens and field) equals "string"):
            return ""
        set formula to provider_value(tokens and field)
        if string_length(formula) > 0 and substring(formula and 0 and 1) equals "=":
            set formula to substring(formula and 1 and string_length(formula) - 1)
        if string_length(formula) equals 0:
            return ""
        set cursor to item + 1
        repeat while not (provider_kind(tokens and cursor) equals "}"):
            set key to provider_value(tokens and cursor)
            if not (key equals "formula" or else key equals "cached"):
                return ""
            set cursor to provider_after(tokens and cursor + 2)
            if provider_kind(tokens and cursor) equals ",":
                set cursor to cursor + 1
        set body to concat("<f>" and concat(workbook_xml_escape(formula) and "</f>"))
        set cached to provider_member(tokens and item and "cached")
        set cached_kind to provider_kind(tokens and cached)
        if cached >= 0 and not (cached_kind equals "null"):
            set value to provider_value(tokens and cached)
            if cached_kind equals "string":
                set attributes to " t=\"str\""
            else if cached_kind equals "true" or else cached_kind equals "false":
                set attributes to " t=\"b\""
                set value to "0"
                if cached_kind equals "true":
                    set value to "1"
            else if not (cached_kind equals "number"):
                return ""
            set body to concat(body and concat("<v>" and concat(workbook_xml_escape(value) and "</v>")))
    else if not (kind equals "null"):
        return ""
    return concat("<c r=\"" and concat(reference and concat("\"" and concat(attributes and concat(">" and concat(body and "</c>"))))))

define workbook_sheet_xml with tokens as List and rows as List returning Str:
    # These are the XLSX format's row/column capacities, not model limits.
    if rows equals 0 or else length_list(rows) > 1048576:
        return ""
    set output to create_builder()
    set added to builder_append(output and "<?xml version=\"1.0\" encoding=\"UTF-8\"?><worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData>")
    set row_number to 0
    for each row in rows:
        set row_number to row_number + 1
        set cells to provider_items(tokens and row)
        if cells equals 0 or else length_list(cells) > 16384:
            set discarded to builder_to_string(output)
            return ""
        set added to builder_append(output and concat("<row r=\"" and concat(int_to_string(row_number) and "\">")))
        set column to 0
        for each item in cells:
            set column to column + 1
            set cell to workbook_cell_xml(tokens and item and concat(workbook_column(column) and int_to_string(row_number)))
            if string_length(cell) equals 0:
                set discarded to builder_to_string(output)
                return ""
            set added to builder_append(output and cell)
        set added to builder_append(output and "</row>")
    set added to builder_append(output and "</sheetData></worksheet>")
    set text to ptr_to_str(builder_to_string(output))
    if workbook_xml_nodes(text) equals 0:
        return ""
    return text

define workbook_sheet_name_valid with name as Str returning Int:
    if string_length(name) equals 0 or else provider_valid_utf8(name) equals 0 or else ptr_to_str(string_to_lower(name)) equals "history":
        return 0
    if substring(name and 0 and 1) equals "'" or else substring(name and string_length(name) - 1 and 1) equals "'":
        return 0
    set units to 0
    set index to 0
    repeat while index < string_length(name):
        set code to peek_byte(str_to_ptr(name) and index)
        if code < 32 or else code equals 47 or else code equals 92 or else code equals 63 or else code equals 42 or else code equals 58 or else code equals 91 or else code equals 93:
            return 0
        if code < 128 or else code >= 192:
            set units to units + 1
            if code >= 240:
                set units to units + 1
        set index to index + 1
    if units > 31:
        return 0
    return 1

# Input is an array of {name, rows}; output is a new complete XLSX package.
define workbook_create_parts with text as Str returning List:
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 0
    set sheets to provider_items(tokens and 0)
    if sheets equals 0 or else length_list(sheets) equals 0:
        return 0
    set parts to create_list()
    set names to create_list()
    set book to "<?xml version=\"1.0\" encoding=\"UTF-8\"?><workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets>"
    set links to "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
    set types to "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>"
    set number to 0
    for each sheet in sheets:
        if not (provider_kind(tokens and sheet) equals "{"):
            return 0
        set cursor to sheet + 1
        repeat while not (provider_kind(tokens and cursor) equals "}"):
            set key to provider_value(tokens and cursor)
            if not (key equals "name" or else key equals "rows"):
                return 0
            set cursor to provider_after(tokens and cursor + 2)
            if provider_kind(tokens and cursor) equals ",":
                set cursor to cursor + 1
        set field to provider_member(tokens and sheet and "name")
        set name to provider_value(tokens and field)
        if not (provider_kind(tokens and field) equals "string") or else workbook_sheet_name_valid(name) equals 0:
            return 0
        set folded to ptr_to_str(string_to_lower(name))
        for each prior in names:
            if ptr_to_str(prior) equals folded:
                return 0
        set added to append_list(names and folded)
        set rows to provider_items(tokens and provider_member(tokens and sheet and "rows"))
        set xml to workbook_sheet_xml(tokens and rows)
        if string_length(xml) equals 0:
            return 0
        set number to number + 1
        set identity to int_to_string(number)
        set part to concat("worksheets/sheet" and concat(identity and ".xml"))
        set added to append_list(parts and concat("xl/" and part))
        set added to append_list(parts and xml)
        set book to concat(book and concat("<sheet name=\"" and concat(workbook_xml_escape(name) and concat("\" sheetId=\"" and concat(identity and concat("\" r:id=\"r" and concat(identity and "\"/>")))))))
        set links to concat(links and concat("<Relationship Id=\"r" and concat(identity and concat("\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"" and concat(part and "\"/>")))))
        set types to concat(types and concat("<Override PartName=\"/xl/" and concat(part and "\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>")))
    set book to concat(book and "</sheets><calcPr calcId=\"0\" fullCalcOnLoad=\"1\" forceFullCalc=\"1\"/></workbook>")
    if workbook_xml_nodes(book) equals 0:
        return 0
    set added to append_list(parts and "xl/workbook.xml")
    set added to append_list(parts and book)
    set added to append_list(parts and "xl/_rels/workbook.xml.rels")
    set added to append_list(parts and concat(links and "</Relationships>"))
    set added to append_list(parts and "[Content_Types].xml")
    set added to append_list(parts and concat(types and "</Types>"))
    set added to append_list(parts and "_rels/.rels")
    set added to append_list(parts and "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"workbook\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>")
    return parts

define workspace_create_workbook with system as Int and root as Int and path as Str and text as Str returning Str:
    set parts to workbook_create_parts(text)
    if parts equals 0:
        return "{\"status\":\"invalid-workbook-input\",\"effect\":\"unchanged\"}"
    return workspace_archive_commit(system and root and parts and path and "xml-parts")
