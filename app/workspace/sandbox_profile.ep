# Native macOS sandbox configuration, generated from English source. The host
# passes roots as sandbox-exec parameters, never interpolated profile syntax.
# This initial profile is a qualification candidate, not a proven code sandbox.
define workspace_sandbox_profile returning Str:
    return "(version 1)\n(deny default)\n(import \"dyld-support.sb\")\n(allow process-fork)\n(allow process-exec (subpath \"/usr\") (subpath \"/Library/Developer/CommandLineTools\") (subpath \"/bin\") (subpath (param \"ECHO_RUNTIME\")) (subpath (param \"ECHO_WORKSPACE\")))\n(allow file-read-metadata file-read-data (path-ancestors \"/Library/Developer/CommandLineTools\") (path-ancestors (param \"ECHO_RUNTIME\")) (path-ancestors (param \"ECHO_WORKSPACE\")))\n(allow sysctl-read)\n(allow file-read* file-map-executable (subpath \"/System\") (subpath \"/usr\") (subpath \"/Library/Developer/CommandLineTools\") (subpath \"/bin\") (subpath (param \"ECHO_RUNTIME\")) (subpath (param \"ECHO_WORKSPACE\")) (literal \"/dev/null\") (literal \"/dev/urandom\") (literal \"/private/var/select/sh\"))\n(allow file-write* (subpath (param \"ECHO_WORKSPACE\")) (literal \"/dev/null\"))\n"
