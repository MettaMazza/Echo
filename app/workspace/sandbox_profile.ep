# Native macOS sandbox configuration, generated from English source. The host
# passes roots as sandbox-exec parameters, never interpolated profile syntax.
# Runtime roots are not data grants. Only the database worker, pinned compiler
# and its standard library are readable; neighbouring archives/configs are not.
define workspace_sandbox_profile returning Str:
    return "(version 1)\n(deny default)\n(import \"dyld-support.sb\")\n(allow process-fork)\n(allow process-exec (subpath \"/usr\") (subpath \"/Library/Developer/CommandLineTools\") (subpath \"/bin\") (literal (string-append (param \"ECHO_RUNTIME\") \"/workspace_database\")) (literal (string-append (param \"ECHO_ERNOS_RUNTIME\") \"/epc\")) (subpath (param \"ECHO_WORKSPACE\")))\n(allow file-read-metadata (literal (param \"ECHO_RUNTIME\")) (literal (param \"ECHO_ERNOS_RUNTIME\")) (path-ancestors \"/Library/Developer/CommandLineTools\") (path-ancestors (param \"ECHO_RUNTIME\")) (path-ancestors (param \"ECHO_ERNOS_RUNTIME\")) (path-ancestors (param \"ECHO_WORKSPACE\")))\n(allow sysctl-read)\n(allow file-read* file-map-executable (subpath \"/System\") (subpath \"/usr\") (subpath \"/Library/Developer/CommandLineTools\") (subpath \"/bin\") (literal (string-append (param \"ECHO_RUNTIME\") \"/workspace_database\")) (literal (string-append (param \"ECHO_ERNOS_RUNTIME\") \"/epc\")) (subpath (string-append (param \"ECHO_ERNOS_RUNTIME\") \"/stdlib\")) (subpath (param \"ECHO_WORKSPACE\")) (literal \"/dev/null\") (literal \"/dev/urandom\") (literal \"/private/var/select/sh\"))\n(allow file-write* (subpath (param \"ECHO_WORKSPACE\")) (literal \"/dev/null\"))\n"

# Only the digest-pinned compiler with validated compile/check/test-harness
# arguments receives directory-resolution access. Its output program is run
# separately under the ordinary profile; this grants no neighbouring file data.
define workspace_compiler_profile returning Str:
    return concat(workspace_sandbox_profile() and "(allow file-read-data (path-ancestors (param \"ECHO_WORKSPACE\")))\n")
