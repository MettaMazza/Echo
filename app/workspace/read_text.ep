import "files"

# The caller supplies an authorized session directory, never a host path from
# tool arguments. Read through the validated descriptor without reopening.
# The digest describes the bytes observed in this read, not an atomic snapshot
# against concurrent writes by another process.
define workspace_read_text with library as Int and root as Int and path as Str and batch as Int and offset as Int and characters as Int returning List:
    set descriptor to workspace_file_open(library and root and path and 0)
    if descriptor is less than 0:
        return file_text_result("open-failed" and "" and 0)
    set result to file_text_descriptor_window(library and descriptor and "" and -1 and batch and offset and characters)
    if net_close(descriptor) is not equal to 0:
        return file_text_result("close-failed" and "" and 0)
    return result
