import "../retained_text"
import "files"

# Open a relative directory beneath the session descriptor. When requested,
# create missing components with owner-only permissions and flush each parent.
# Existing components must also be directories and must never be symlinks.
# A failure may leave earlier empty directories; a retry can reopen them.
define workspace_directory_open with library as Int and root as Int and path as Str and create_missing as Int returning Int:
    if root is less than 0 or else (create_missing is not equal to 0 and create_missing is not equal to 1):
        return -1
    set parts to workspace_path_parts(path)
    if parts equals 0:
        return -1
    set duplicate to ep_dlsym(library and "dup")
    set open_at to ep_dlsym(library and "openat")
    set make_directory to ep_dlsym(library and "mkdirat")
    set flush to ep_dlsym(library and "fsync")
    if duplicate equals 0 or else open_at equals 0 or else make_directory equals 0 or else flush equals 0:
        return -1
    set parent to socket_signed_result(ep_dlcall1(duplicate and root))
    if parent is less than 0:
        return -1
    set index to 0
    repeat while index is less than length_list(parts):
        set name to archive_list_text(parts and index)
        if create_missing equals 1:
            set made to socket_signed_result(ep_dlcall3(make_directory and parent and str_to_ptr(name) and 448))
            if made is not equal to 0 and socket_errno(library) is not equal to 17:
                set closed to net_close(parent)
                return -1
        set child to socket_signed_result(ep_dlcall3(open_at and parent and str_to_ptr(name) and 17826048))
        if child is less than 0:
            set closed to net_close(parent)
            return -1
        if create_missing equals 1:
            if ep_dlcall1(flush and parent) is not equal to 0:
                set closed to net_close(child)
                set closed to net_close(parent)
                return -1
        set closed to net_close(parent)
        set parent to child
        set index to index + 1
    return parent
