import "read_text"
import "../providers/local_json"

# Select by explicit object keys or canonical array index strings. Keep the
# selected JSON spelling intact, including large numbers and escape sequences.
define workspace_json_select with text as Str and segments as List returning Str:
    if provider_valid_utf8(text) equals 0:
        return "{\"status\":\"invalid-json\"}"
    set tokens to provider_json_tokens(text)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return "{\"status\":\"invalid-or-ambiguous-json\"}"
    set current to 0
    for each segment in segments:
        set key to ptr_to_str(segment)
        set kind to provider_kind(tokens and current)
        if kind equals "{":
            set current to provider_member(tokens and current and key)
        else if kind equals "[":
            set items to provider_items(tokens and current)
            set selected to -1
            set index to 0
            repeat while index < length_list(items):
                if int_to_string(index) equals key:
                    set selected to get_list(items and index)
                    break
                set index to index + 1
            set current to selected
        else:
            return "{\"status\":\"path-type-mismatch\"}"
        if current < 0:
            return "{\"status\":\"not-found\"}"
    set after to provider_after(tokens and current)
    set start to get_list(get_list(tokens and current) and 1)
    set finish to get_list(get_list(tokens and after - 1) and 2)
    set original to substring(text and start and finish - start)
    set result to concat("{\"status\":\"found\",\"sha256\":" and provider_quote(ep_sha256(text)))
    set result to concat(result and concat(",\"json\":" and provider_quote(original)))
    set result to concat(result and concat(",\"byte_offset\":" and int_to_string(start)))
    return concat(result and concat(",\"byte_length\":" and concat(int_to_string(finish - start) and "}")))

define workspace_read_json with library as Int and root as Int and path as Str and segments as List returning Str:
    set original to workspace_read_text(library and root and path and 65536 and 0 and -1)
    if not (archive_list_text(original and 0) equals "read"):
        return concat("{\"status\":" and concat(provider_quote(archive_list_text(original and 0)) and "}"))
    return workspace_json_select(archive_list_text(original and 1) and segments)
