import "../retained_text"

# Convert the exact archived typed request to compiler argv, never shell text.
define workspace_build_arguments with arguments as List returning List:
    set index to 1
    repeat while not (provider_kind(arguments and index) equals "}"):
        set key to provider_value(arguments and index)
        if not (key equals "path" or else key equals "mode"):
            return 0
        set index to provider_after(arguments and index + 2)
        if provider_kind(arguments and index) equals ",":
            set index to index + 1
    set path to provider_member(arguments and 0 and "path")
    set mode to provider_member(arguments and 0 and "mode")
    if not (provider_kind(arguments and path) equals "string") or else string_length(provider_value(arguments and path)) equals 0 or else not (provider_kind(arguments and mode) equals "string"):
        return 0
    set selected to provider_value(arguments and mode)
    if selected equals "compile":
        return [provider_value(arguments and path)]
    if selected equals "check":
        return ["check", provider_value(arguments and path)]
    if selected equals "test-harness":
        return ["test", provider_value(arguments and path)]
    return 0
