import "execute_process"

# A dedicated native guardian owns the child handle and the read end of a
# private owner pipe. The owner alone keeps the writer. The command never
# inherits either end. Owner death therefore wakes this guardian without PID
# lookup, process-name matching or an execution lifetime limit.
define workspace_guard_owned with handle as List and owner as Int returning List:
    if handle equals 0 or else owner < 0:
        return workspace_execution_result("invalid-guardian" and handle and -1 and 0 and 0)
    set library to get_list(handle and 0)
    repeat while 1 equals 1:
        set state to workspace_process_poll(handle)
        if state equals 1:
            return workspace_execution_result("complete" and 0 and get_list(handle and 3) and 0 and 0)
        if state is not equal to 0:
            return workspace_execution_result("guardian-wait-failed" and handle and -1 and 0 and 0)
        set pending to agent_cancellation_pending(library and owner)
        if pending is not equal to 0:
            if workspace_process_abort(handle) is not equal to 0:
                return workspace_execution_result("guardian-cleanup-failed" and handle and -1 and 0 and 0)
            set status to "owner-disconnected"
            if pending < 0:
                set status to "owner-monitor-failed"
            return workspace_execution_result(status and 0 and get_list(handle and 3) and 0 and 0)
        # Monitoring cadence, never a deadline for the command.
        set slept to sleep_ms(10)
    return workspace_execution_result("guardian-error" and handle and -1 and 0 and 0)
