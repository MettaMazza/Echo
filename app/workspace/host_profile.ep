import "../providers/archived_stream"
import "files"

# Both host paths consume the same validated, nonempty root lists. Missing or
# malformed configuration is not an empty deny list. Paths must be absolute,
# canonical component spellings; reject embedded NUL before any native API.
define host_policy_roots with configured as Str returning List:
    set tokens to provider_json_tokens(configured)
    if tokens equals 0 or else not (provider_kind(tokens and 0) equals "["):
        return 0
    set items to provider_items(tokens and 0)
    if items equals 0 or else length_list(items) equals 0:
        return 0
    set roots to create_list()
    for each item in items:
        if not (provider_kind(tokens and item) equals "string"):
            return 0
        set path to provider_value(tokens and item)
        if string_length(path) < 2 or else get_character(path and 0) is not equal to 47 or else workspace_path_parts(ptr_to_str(substring(path and 1 and string_length(path) - 1))) equals 0:
            return 0
        set index to 0
        repeat while index < string_length(path):
            if get_character(path and index) equals 0:
                return 0
            set index to index + 1
        set added to append_list(roots and path)
    return roots

# These paths come only from host configuration, never tool arguments. Ordinary
# admin commands cannot write accepted Echo code/state or read connector secrets.
# Protected modifications use the separate charter controller.
define host_execution_profile returning Str:
    set protected_roots to host_policy_roots(ptr_to_str(get_env("ECHO_HOST_PROTECTED_ROOTS")))
    set secret_roots to host_policy_roots(ptr_to_str(get_env("ECHO_HOST_SECRET_ROOTS")))
    if protected_roots equals 0 or else secret_roots equals 0:
        return ""
    set profile to "(version 1)\n(deny default)\n(import \"dyld-support.sb\")\n(allow process-fork process-exec sysctl-read file-read* file-map-executable file-write* network-outbound)\n"
    for each roots in [protected_roots,secret_roots]:
        set filters to ""
        for each path in roots:
            set filters to concat(filters and concat(" (subpath " and concat(provider_quote(path) and ")")))
        set operation to "file-write*"
        if roots equals secret_roots:
            set operation to "file-read* file-write*"
        set profile to concat(profile and concat("(deny " and concat(operation and concat(filters and ")\n"))))
    return profile

# Descriptor traversal already rejects symlinks; this lexical boundary also
# prevents the separate admin text reader from bypassing connector isolation.
# Invalid configuration denies reads, consistently with process execution.
define host_secret_path with path as Str returning Int:
    set roots to host_policy_roots(ptr_to_str(get_env("ECHO_HOST_SECRET_ROOTS")))
    if roots equals 0:
        return 1
    for each root in roots:
        if path equals root or else string_index_of(path and concat(root and "/")) equals 0:
            return 1
    return 0

# Public-channel source inspection is limited to the explicitly published
# application source tree. It never turns an admin's public run into a private
# host session. Descriptor traversal separately rejects symlinks and hardlinks.
define host_public_source_path with path as Str returning Int:
    set root to ptr_to_str(get_env("ECHO_PUBLIC_SOURCE_ROOT"))
    if string_length(root) < 2 or else get_character(root and 0) is not equal to 47:
        return 0
    set prefix to concat(root and "/app/")
    if string_index_of(path and prefix) is not equal to 0 or else string_length(path) <= string_length(prefix) + 3:
        return 0
    if not (ptr_to_str(substring(path and string_length(path) - 3 and 3)) equals ".ep"):
        return 0
    return workspace_path_parts(ptr_to_str(substring(path and 1 and string_length(path) - 1))) is not equal to 0
