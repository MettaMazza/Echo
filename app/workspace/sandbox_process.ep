import "native_process"
import "sandbox_profile"
import "host_profile"

# Host-only launcher. The owning tool must establish device/session ownership,
# pin the workspace descriptor and supply trusted runtime/workspace roots.
# Arguments are separate native argv entries, never assembled into shell text.
# Pass the generated policy directly: a program cannot rewrite a profile file
# in its writable workspace and thereby alter a subsequent launch's policy.
define workspace_sandbox_start with runtime as Str and workspace as Str and executable as Str and command_arguments as List and environment as List and directory as Int and output as Int and errors as Int returning List:
    return workspace_sandbox_start_profile(runtime and workspace and executable and command_arguments and environment and directory and output and errors and workspace_sandbox_profile())

define workspace_sandbox_start_profile with runtime as Str and workspace as Str and executable as Str and command_arguments as List and environment as List and directory as Int and output as Int and errors as Int and profile as Str returning List:
    if string_length(profile) equals 0:
        return 0
    if string_length(runtime) equals 0 or else string_length(workspace) equals 0 or else string_length(executable) equals 0:
        return 0
    set arguments to create_list()
    set added to append_list(arguments and "-D")
    set added to append_list(arguments and concat("ECHO_RUNTIME=" and runtime))
    set added to append_list(arguments and "-D")
    set added to append_list(arguments and concat("ECHO_WORKSPACE=" and workspace))
    set compiler_runtime to ptr_to_str(get_env("ECHO_ERNOS_RUNTIME"))
    if string_length(compiler_runtime) equals 0:
        set compiler_runtime to runtime
    set added to append_list(arguments and "-D")
    set added to append_list(arguments and concat("ECHO_ERNOS_RUNTIME=" and compiler_runtime))
    set added to append_list(arguments and "-p")
    set added to append_list(arguments and profile)
    set added to append_list(arguments and executable)
    set index to 0
    repeat while index is less than length_list(command_arguments):
        set added to append_list(arguments and get_list(command_arguments and index))
        set index to index + 1
    return workspace_process_start("/usr/bin/sandbox-exec" and arguments and environment and directory and output and errors)
