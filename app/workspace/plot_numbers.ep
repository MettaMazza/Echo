import "../providers/local_json"

define plot_float_bits with bits as Int returning Float:
    return bits

# libc parses the complete JSON numeric token into IEEE-754 binary64 storage.
# Ernos Float values use the same native bits; no integer coercion is applied.
define plot_number with library as Int and text as Str returning Float:
    set memory to ep_dlcall1(ep_dlsym(library and "malloc") and 8)
    if memory equals 0:
        return 0.0 / 0.0
    set read to ep_dlcall3(ep_dlsym(library and "sscanf") and str_to_ptr(text) and str_to_ptr("%lf") and memory)
    set bits to peek_byte(memory and 7)
    if bits >= 128:
        set bits to bits - 256
    set index to 6
    repeat while index >= 0:
        set bits to bits * 256 + peek_byte(memory and index)
        set index to index - 1
    set value to plot_float_bits(bits)
    set freed to ep_dlcall1(ep_dlsym(library and "free") and memory)
    if read is not equal to 1:
        return 0.0 / 0.0
    return value

define plot_finite with value as Float returning Int:
    set remainder to value - value
    return remainder equals 0.0

define plot_number_text with value as Float returning Str:
    return f"{value}"
