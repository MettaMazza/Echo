import "read_text"

# One complete contiguous line-aligned change span, not a minimal edit script.
# Equal prefix/suffix lines are omitted without hiding intervening differences.
define workspace_diff_text with library as Int and root as Int and before_path as Str and after_path as Str returning Str:
    set before to workspace_read_text(library and root and before_path and 65536 and 0 and -1)
    set after to workspace_read_text(library and root and after_path and 65536 and 0 and -1)
    if not (archive_list_text(before and 0) equals "read") or else not (archive_list_text(after and 0) equals "read"):
        return "{\"status\":\"read-failed\"}"
    set left to archive_list_text(before and 1)
    set right to archive_list_text(after and 1)
    set result to concat("{\"status\":\"found\",\"before_sha256\":" and provider_quote(archive_list_text(before and 3)))
    set result to concat(result and concat(",\"after_sha256\":" and provider_quote(archive_list_text(after and 3))))
    if left equals right:
        return concat(result and ",\"changed\":false}")
    set left_size to string_length(left)
    set right_size to string_length(right)
    set left_pointer to str_to_ptr(left)
    set right_pointer to str_to_ptr(right)
    set prefix to 0
    repeat while prefix < left_size and prefix < right_size:
        if peek_byte(left_pointer and prefix) is not equal to peek_byte(right_pointer and prefix):
            break
        set prefix to prefix + 1
    repeat while prefix > 0:
        if peek_byte(left_pointer and prefix - 1) equals 10:
            break
        set prefix to prefix - 1
    set suffix to 0
    repeat while suffix < left_size - prefix and suffix < right_size - prefix:
        if peek_byte(left_pointer and left_size - suffix - 1) is not equal to peek_byte(right_pointer and right_size - suffix - 1):
            break
        set suffix to suffix + 1
    repeat while suffix > 0:
        set left_start to left_size - suffix
        set right_start to right_size - suffix
        if left_start > 0 and right_start > 0 and peek_byte(left_pointer and left_start - 1) equals 10 and peek_byte(right_pointer and right_start - 1) equals 10:
            break
        set suffix to suffix - 1
    set line to 1
    set index to 0
    repeat while index < prefix:
        if peek_byte(left_pointer and index) equals 10:
            set line to line + 1
        set index to index + 1
    set result to concat(result and concat(",\"changed\":true,\"start_line\":" and int_to_string(line)))
    set result to concat(result and concat(",\"before\":" and provider_quote(ptr_to_str(substring(left and prefix and left_size - prefix - suffix)))))
    set result to concat(result and concat(",\"after\":" and provider_quote(ptr_to_str(substring(right and prefix and right_size - prefix - suffix)))))
    return concat(result and ",\"format\":\"contiguous-line-change\"}")
