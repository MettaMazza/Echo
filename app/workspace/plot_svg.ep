import "plot_numbers"
import "create_text"

# Text only: generated SVG contains no scripts, links or external resources.
define plot_xml with text as Str returning Str:
    set text to string_replace(text and "&" and "&amp;")
    set text to string_replace(text and "<" and "&lt;")
    set text to string_replace(text and ">" and "&gt;")
    set text to string_replace(text and "\"" and "&quot;")
    return string_replace(text and "'" and "&apos;")

define plot_label_valid with text as Str returning Int:
    set index to 0
    repeat while index < string_length(text):
        set code to get_character(text and index)
        if code < 32 and code is not equal to 9 and code is not equal to 10 and code is not equal to 13:
            return 0
        set index to index + 1
    return 1

define plot_keys_valid with tokens as List and item as Int and keys as List returning Int:
    if not (provider_kind(tokens and item) equals "{"):
        return 0
    set index to item + 1
    repeat while not (provider_kind(tokens and index) equals "}"):
        set found to 0
        for each key in keys:
            if provider_value(tokens and index) equals key:
                set found to 1
        if found equals 0:
            return 0
        set index to provider_after(tokens and index + 2)
        if provider_kind(tokens and index) equals ",":
            set index to index + 1
    return 1

define plot_coordinate with value as Float and low as Float and high as Float and origin as Float and span as Float returning Float:
    if low equals high:
        return origin + span / 2.0
    return origin + ((value / 2.0 - low / 2.0) / (high / 2.0 - low / 2.0)) * span

# The exact specification is embedded as inert XML metadata for reproduction.
define workspace_plot_svg with library as Int and specification as Str returning List:
    set tokens to provider_json_tokens(specification)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return ["invalid-plot", ""]
    if plot_keys_valid(tokens and 0 and ["title","x_label","y_label","series"]) equals 0:
        return ["invalid-plot", ""]
    set title to provider_member(tokens and 0 and "title")
    set x_label to provider_member(tokens and 0 and "x_label")
    set y_label to provider_member(tokens and 0 and "y_label")
    if not (provider_kind(tokens and title) equals "string") or else not (provider_kind(tokens and x_label) equals "string") or else not (provider_kind(tokens and y_label) equals "string"):
        return ["invalid-plot-labels", ""]
    for each label in [title,x_label,y_label]:
        if plot_label_valid(provider_value(tokens and label)) equals 0:
            return ["invalid-plot-labels", ""]
    set series to provider_items(tokens and provider_member(tokens and 0 and "series"))
    if series equals 0 or else length_list(series) equals 0:
        return ["empty-plot", ""]
    set x_min to 0.0
    set x_max to 0.0
    set y_min to 0.0
    set y_max to 0.0
    set total to 0
    for each item in series:
        if plot_keys_valid(tokens and item and ["name","kind","points"]) equals 0 or else plot_label_valid(provider_value(tokens and provider_member(tokens and item and "name"))) equals 0:
            return ["invalid-plot-series", ""]
        set kind to provider_value(tokens and provider_member(tokens and item and "kind"))
        if not (kind equals "line" or else kind equals "scatter") or else not (provider_kind(tokens and provider_member(tokens and item and "name")) equals "string"):
            return ["invalid-plot-series", ""]
        set points to provider_items(tokens and provider_member(tokens and item and "points"))
        if points equals 0 or else length_list(points) equals 0:
            return ["empty-plot-series", ""]
        for each point in points:
            set pair to provider_items(tokens and point)
            if pair equals 0 or else length_list(pair) is not equal to 2 or else not (provider_kind(tokens and get_list(pair and 0)) equals "number") or else not (provider_kind(tokens and get_list(pair and 1)) equals "number"):
                return ["invalid-plot-point", ""]
            set x to plot_number(library and provider_value(tokens and get_list(pair and 0)))
            set y to plot_number(library and provider_value(tokens and get_list(pair and 1)))
            if plot_finite(x) equals 0 or else plot_finite(y) equals 0:
                return ["plot-number-out-of-range", ""]
            if total equals 0 or else x < x_min:
                set x_min to x
            if total equals 0 or else x > x_max:
                set x_max to x
            if total equals 0 or else y < y_min:
                set y_min to y
            if total equals 0 or else y > y_max:
                set y_max to y
            set total to total + 1
    if (x_min is not equal to x_max and x_max / 2.0 - x_min / 2.0 equals 0.0) or else (y_min is not equal to y_max and y_max / 2.0 - y_min / 2.0 equals 0.0):
        return ["plot-range-not-representable", ""]
    set output to create_builder()
    set height to 620 + length_list(series) * 24
    set added to builder_append(output and concat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1000 " and concat(int_to_string(height) and "\" role=\"img\"><title>")))
    set added to builder_append(output and concat(plot_xml(provider_value(tokens and title)) and "</title><metadata>"))
    set added to builder_append(output and concat(plot_xml(specification) and "</metadata>"))
    set added to builder_append(output and concat("<rect width=\"1000\" height=\"" and concat(int_to_string(height) and "\" fill=\"#ffffff\"/><g font-family=\"system-ui,sans-serif\" fill=\"#18212f\"><text x=\"90\" y=\"42\" font-size=\"24\">")))
    set added to builder_append(output and concat(plot_xml(provider_value(tokens and title)) and "</text><path d=\"M90 80 V520 H950\" fill=\"none\" stroke=\"#607080\"/>"))
    set tick to 0
    repeat while tick <= 4:
        set proportion to int_to_float(tick) / 4.0
        set x to x_min * (1.0 - proportion) + x_max * proportion
        set y to y_min * (1.0 - proportion) + y_max * proportion
        set px to 90.0 + proportion * 860.0
        set py to 520.0 - proportion * 440.0
        set added to builder_append(output and concat("<text text-anchor=\"middle\" font-size=\"12\" x=\"" and concat(plot_number_text(px) and concat("\" y=\"546\">" and concat(plot_number_text(x) and "</text>")))))
        set added to builder_append(output and concat("<text text-anchor=\"end\" font-size=\"12\" x=\"78\" y=\"" and concat(plot_number_text(py) and concat("\">" and concat(plot_number_text(y) and "</text>")))))
        set tick to tick + 1
    set added to builder_append(output and concat("<text x=\"520\" y=\"580\" text-anchor=\"middle\">" and concat(plot_xml(provider_value(tokens and x_label)) and "</text>")))
    set added to builder_append(output and concat("<text transform=\"translate(22 300) rotate(-90)\" text-anchor=\"middle\">" and concat(plot_xml(provider_value(tokens and y_label)) and "</text>")))
    set palette to ["#2463eb", "#d33c38", "#00856a", "#9046c8", "#a36b00", "#c02678"]
    set number to 0
    for each item in series:
        set color to archive_list_text(palette and number modulo length_list(palette))
        set kind to provider_value(tokens and provider_member(tokens and item and "kind"))
        set points to provider_items(tokens and provider_member(tokens and item and "points"))
        set line to create_builder()
        for each point in points:
            set pair to provider_items(tokens and point)
            set x to plot_number(library and provider_value(tokens and get_list(pair and 0)))
            set y to plot_number(library and provider_value(tokens and get_list(pair and 1)))
            set px to plot_coordinate(x and x_min and x_max and 90.0 and 860.0)
            set py to plot_coordinate(y and y_min and y_max and 520.0 and -440.0)
            if plot_finite(px) equals 0 or else plot_finite(py) equals 0:
                return ["plot-range-not-representable", ""]
            set added to builder_append(line and concat(plot_number_text(px) and concat("," and concat(plot_number_text(py) and " "))))
            set added to builder_append(output and concat("<circle r=\"3\" cx=\"" and concat(plot_number_text(px) and concat("\" cy=\"" and concat(plot_number_text(py) and concat("\" fill=\"" and concat(color and "\"><title>")))))))
            set added to builder_append(output and concat(plot_xml(concat(provider_value(tokens and get_list(pair and 0)) and concat(", " and provider_value(tokens and get_list(pair and 1))))) and "</title></circle>"))
        set coordinates to builder_to_string(line)
        if kind equals "line":
            set added to builder_append(output and concat("<polyline fill=\"none\" stroke-width=\"2\" stroke=\"" and concat(color and concat("\" points=\"" and concat(coordinates and "\"/>")))))
        set added to builder_append(output and concat("<text x=\"90\" y=\"" and concat(int_to_string(616 + number * 24) and concat("\" fill=\"" and concat(color and concat("\">" and concat(plot_xml(provider_value(tokens and provider_member(tokens and item and "name"))) and "</text>")))))))
        set number to number + 1
    set added to builder_append(output and "</g></svg>")
    return ["rendered", builder_to_string(output)]
