import "rights/emergency_report"
import "os"

# Host operator inspection only. No migration, new credentials, role grants,
# quarantine release or protected changes occur through this command.
define main returning Int:
    if get_argument_count() is not equal to 3:
        display "Usage: emergency_status EXISTING_DATABASE PINNED_CHARTER. Supply the current steward credential through ECHO_STEWARD_CREDENTIAL, never as a command argument."
        return 1
    set credential to ptr_to_str(get_env("ECHO_STEWARD_CREDENTIAL"))
    if string_length(credential) equals 0:
        display "A current steward credential is required."
        return 1
    if not file_exists(get_argument(1)):
        display "The existing host archive is required."
        return 1
    if string_length(charter_verified_text(get_argument(2))) equals 0:
        display "charter-unavailable-or-altered"
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0:
        return 1
    set ready to history_collect_one(archive_prepare(database and "SELECT version FROM echo_schema_migrations WHERE version=13;"))
    if migration_compatible(database and 15) equals 0 or else not (archive_list_text(ready and 0) equals "found"):
        display "Use the matching protected-controller archive. This command never migrates production."
        set closed to sql_close(database)
        return 1
    set report to protected_emergency_report(database and get_argument(2) and credential)
    set closed to sql_close(database)
    display report
    if closed is not equal to 0 or else string_index_of(report and "{\"status\":\"verified\"") is not equal to 0:
        return 1
    return 0
