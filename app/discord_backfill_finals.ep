import "discord/final_backfill"

# Maintenance on existing Discord stores only. No network or model execution.
define main returning Int:
    if get_argument_count() is not equal to 5 or else not file_exists(get_argument(1)) or else not file_exists(get_argument(2)) or else not (get_argument(4) equals "--apply"):
        return 1
    set journal to discord_store_open(get_argument(1) and get_argument(3))
    set database to discord_agent_open(get_argument(2) and get_argument(3))
    if journal equals 0 or else database equals 0 or else discord_final_binding_schema(journal) is not equal to 0 or else discord_message_actions_schema(journal) is not equal to 0:
        return 2
    set rows to history_collect_one(archive_prepare(journal and "SELECT COALESCE(json_group_array(a.outbox),'[]') FROM discord_message_actions a JOIN discord_outbox o ON o.identity=a.outbox WHERE a.action='speak' AND o.state='sent' AND NOT EXISTS(SELECT 1 FROM discord_final_bindings b WHERE b.outbox=a.outbox);"))
    if not (archive_list_text(rows and 0) equals "found"):
        return 3
    set tokens to provider_json_tokens(archive_list_text(rows and 1))
    set items to provider_items(tokens and 0)
    for each item in items:
        set output to provider_value(tokens and item)
        set result to discord_final_backfill(journal and database and output)
        display concat(output and concat(" " and result))
    set closed to sql_close(database)
    return sql_close(journal)
