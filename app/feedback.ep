import "providers/archived_stream"

# Public feedback supplements original machine statuses and receipts; never
# converts an uncertain outcome into success or promises a safe blind retry.
define feedback_success with status as Str returning Int:
    return string_contains("|materialized|already-materialized|applied|already-recorded|already-saved|already-terminal|comparison-passed|complete|content-already-present|created|current|disclosed|draft|excluded-from-context|extracted|forgotten|found|guidance-received|idle|merged|observed|paired|prepared|ready|recorded|requested|saved|verified|routed|" and concat("|" and concat(status and "|")))

define feedback_recovery with status as Str returning Str:
    if status equals "end":
        return "For a paginated list this is the end: stop paging. For an exact lookup, verify the identifier using the corresponding list/search tool; an empty match does not establish loss of history or a general access failure."
    if status equals "search-challenge":
        return "The search provider returned a challenge instead of results. The response is retained; no results were obtained. Use another accessible search source, an official site/API or a feed. Do not repeat the same challenged request unchanged or treat its page as evidence."
    if status equals "remote-request-failed":
        return "Inspect the retained transfer HTTP status, error and response body. Check the URL and any access or rate-limit requirement; correct the cause or use an accessible source. Capturing an error page does not mean the requested content was retrieved."
    if status equals "unauthorized" or else status equals "not-authorized" or else status equals "revoked" or else string_contains(status and "authority") or else string_contains(status and "authorization") or else status equals "foreign-origin":
        return "Check this device's access in Devices & access and the required role. Use an authorised account or ask its administrator to restore access. Do not bypass the restriction or erase the existing device link."
    if string_contains(status and "conflict") or else string_contains(status and "changed") or else string_contains(status and "cursor") or else string_contains(status and "duplicate"):
        return "Reload the current record or listing, compare it with the intended change, and submit using its current revision or cursor. Preserve existing files and reuse the original submission identity when recovering an uncertain request."
    if string_contains(status and "integrity") or else string_contains(status and "digest") or else string_contains(status and "hash") or else string_contains(status and "verification") or else string_contains(status and "signature"):
        return "Keep the original and failed receipt. Compare the source and stored digests, restore from a verified copy or correct the configured source, then verify again. Do not bypass integrity checks or invent replacement content."
    if string_contains(status and "review") or else status equals "connector-secret-isolated":
        return "Read the returned review or access requirements and complete that supported flow before retrying. Existing permissions remain in force; credentials must stay in their configured secret store."
    if string_contains(status and "busy") or else string_contains(status and "pending") or else string_contains(status and "progress") or else string_contains(status and "queued") or else status equals "retrying":
        return "Check the existing operation's progress before starting another. Wait for its state to change, or use its supported cancel control. If interrupted, resume the same operation identity rather than submitting a duplicate."
    if string_contains(status and "cancel") or else string_contains(status and "interrupt"):
        return "Inspect retained output and any saved changes before resuming. A stop does not undo effects already completed. Resume or retry only the unfinished operation using its existing identity."
    if string_contains(status and "invalid") or else string_contains(status and "malformed") or else string_contains(status and "parse") or else string_contains(status and "ambiguous") or else status equals "post-required":
        return "Check the request against the advertised fields, types and supported format. Correct the reported input or explicitly select the intended resource, then retry. Keep the original input; do not repeat it unchanged."
    if string_contains(status and "not-found") or else string_contains(status and "unavailable") or else string_contains(status and "missing") or else string_contains(status and "unknown") or else string_contains(status and "not-configured") or else string_contains(status and "not-installed"):
        return "Refresh the available resources and verify the exact name, path, ownership and service configuration. Restore or configure the missing resource if needed, then retry. Unavailable access does not prove the underlying data is absent."
    if string_contains(status and "storage") or else string_contains(status and "write") or else string_contains(status and "commit") or else string_contains(status and "copy") or else string_contains(status and "directory"):
        return "Check available disk space, destination permissions and the saved record before retrying. Preserve originals and partial output. Verify what committed; do not blindly repeat a write with an uncertain outcome."
    if string_contains(status and "database") or else string_contains(status and "archive"):
        return "Check service health and the retained archive diagnostics. Reopen the operation after the storage problem is resolved, keeping its original identity. Do not delete history or assume a failed response means nothing committed."
    if status equals "process-exit-nonzero":
        return "Read decoded stdout and stderr with workspace_output_next using the returned run_id and call_id. Interpret the exit status for that command, correct the observed cause and verify the next attempt before claiming success."
    if status equals "checklist-required" or else status equals "requirements-must-be-preserved":
        return "Record the current task's requested outcomes with task_checklist, retaining existing item IDs and requirements. Update evidence or mark a genuine limitation unresolved, then continue the unfinished work."
    if status equals "task-complete-return-result":
        return "Return the completed result and any explicit limitations to the requester now; do not start additional tool work."
    if status equals "restored-archive-read-only":
        return "This archive is open for inspection only. Read or export its retained records; use the supported restore/release process before attempting changes."
    return "Inspect the retained diagnostic and current operation state before retrying. The cause or effects are not fully established. Verify any saved changes first; if the cause persists, report this code and receipt to host maintenance instead of repeating the action unchanged."

define feedback_message with status as Str returning Str:
    if status equals "search-challenge":
        return "The search provider returned an access challenge instead of results."
    if status equals "end":
        return "No matching entry or no further results were returned."
    if status equals "process-exit-nonzero":
        return "The process ended with a nonzero exit status. Its requested work is not verified as successful."
    if status equals "unauthorized" or else status equals "not-authorized" or else status equals "revoked" or else string_contains(status and "authority") or else string_contains(status and "authorization"):
        return "The current identity does not have the required access, or its access changed."
    if string_contains(status and "conflict") or else string_contains(status and "changed") or else string_contains(status and "cursor"):
        return "The saved state no longer matches this request."
    if string_contains(status and "integrity") or else string_contains(status and "digest") or else string_contains(status and "hash") or else string_contains(status and "verification"):
        return "The requested data or executable could not be verified."
    if string_contains(status and "invalid") or else string_contains(status and "malformed") or else string_contains(status and "parse"):
        return "The request or source format was not accepted."
    if string_contains(status and "busy") or else string_contains(status and "pending") or else string_contains(status and "queued") or else string_contains(status and "progress"):
        return "The operation is waiting or still in progress; completion is not confirmed."
    if string_contains(status and "cancel") or else string_contains(status and "interrupt"):
        return "The operation was stopped or interrupted; completed effects may remain."
    if string_contains(status and "not-found") or else string_contains(status and "unavailable") or else string_contains(status and "missing") or else string_contains(status and "not-configured"):
        return "The requested resource or service could not be accessed."
    if string_contains(status and "write") or else string_contains(status and "commit") or else string_contains(status and "storage"):
        return "The requested change could not be confirmed as saved."
    return "The operation needs attention before it can continue."

define feedback_enrich with body as Str and operation as Str and reference as Str returning Str:
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return body
    if provider_member(tokens and 0 and "feedback") >= 0:
        return body
    set status to provider_value(tokens and provider_member(tokens and 0 and "status"))
    if string_length(status) equals 0:
        set status to provider_value(tokens and provider_member(tokens and 0 and "reason"))
    if string_length(status) equals 0:
        return body
    set code to status
    set wait to provider_value(tokens and provider_member(tokens and 0 and "wait_status"))
    if string_length(wait) > 0 and not (wait equals "0"):
        set code to "process-exit-nonzero"
    set transfer to provider_member(tokens and 0 and "transfer")
    if transfer >= 0:
        set hops to provider_items(tokens and provider_member(tokens and transfer and "hops"))
        if hops is not equal to 0:
            set index to 0
            repeat while index < length_list(hops):
                set hop to get_list(hops and index)
                set transport to provider_member(tokens and hop and "transfer")
                set http to provider_value(tokens and provider_member(tokens and transport and "http_status"))
                set curl to provider_value(tokens and provider_member(tokens and transport and "curl_code"))
                if string_to_int(http) >= 400 or else (string_length(curl) > 0 and not (curl equals "0")):
                    set code to "remote-request-failed"
                set index to index + 1
    if feedback_success(code):
        return body
    set message to concat(operation and concat(": " and feedback_message(code)))
    set explanation to provider_value(tokens and provider_member(tokens and 0 and "explanation"))
    if string_length(explanation) > 0:
        set message to explanation
    set recovery to provider_value(tokens and provider_member(tokens and 0 and "recovery"))
    if string_length(recovery) equals 0:
        set recovery to feedback_recovery(code)
    set effects to provider_value(tokens and provider_member(tokens and 0 and "effects"))
    if string_length(effects) equals 0 and code equals "search-challenge":
        set effects to "The challenge response was retained; no search results were obtained."
    if string_length(effects) equals 0 and code equals "end":
        set effects to "This lookup returned no further matching records; it does not establish whether other accessible records exist."
    if string_length(effects) equals 0:
        set effects to "Not established by this response. Check retained output and current state before repeating a change."
    set extra to concat(",\"feedback\":{\"code\":" and provider_quote(code))
    set extra to concat(extra and concat(",\"message\":" and provider_quote(message)))
    set extra to concat(extra and concat(",\"effects\":" and provider_quote(effects)))
    set extra to concat(extra and concat(",\"recovery\":" and provider_quote(recovery)))
    set extra to concat(extra and concat(",\"reference\":" and provider_quote(reference)))
    set end to string_length(body)
    repeat while end > 0 and get_character(body and end - 1) <= 32:
        set end to end - 1
    return concat(substring(body and 0 and end - 1) and concat(extra and "}}"))
