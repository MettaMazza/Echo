import "archive/restore_bundle"

define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Supply absolute bundle directory, independently retained manifest SHA256 and a new absolute restore directory."
        return 1
    if restore_bundle_run(get_argument(1) and get_argument(2) and get_argument(3)) is not equal to 0:
        display "Combined restore did not complete. Preserve any candidate for investigation; do not start it."
        return 1
    display "PASS: combined bundle independently restored and verified. Execution remains held for reconciliation; configuration paths require host review."
    return 0
