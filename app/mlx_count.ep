import "providers/native_python"
import "providers/json_access"
import "providers/archived_stream"
import "fs"

# One-shot native helper; all interpreter-owned objects live until process exit.
# Invoke the pinned upstream server method, including its tools, reasoning tail
# and content normalization. No hand-written substitute chat template.
define main returning Int:
    if get_argument_count() is not equal to 5:
        display "Supply interpreter library, environment executable, model directory and request JSON file."
        return 1
    if not file_exists(concat(get_argument(3) and "/config.json")) or else not file_exists(concat(get_argument(3) and "/tokenizer_config.json")):
        display "The tokenizer requires a local model directory."
        return 1
    set configuration to ptr_to_str(read_file(concat(get_argument(3) and "/config.json")))
    set body to read_file(get_argument(4))
    set tokens to provider_json_tokens(body)
    if tokens equals 0:
        return 2
    if provider_unique_objects(tokens) equals 0 or else not (provider_kind(tokens and provider_member(tokens and 0 and "messages")) equals "["):
        return 2
    set library to native_python_open(get_argument(1) and get_argument(2))
    if library equals 0:
        return 3
    set request_dict to native_python_json(library and body)
    set defaults to native_python_json(library and "{\"request_type\":\"chat\",\"prompt\":\"\",\"tools\":null,\"role_mapping\":null}")
    set request to native_python_namespace(library and defaults)
    set messages to native_python_member(library and request_dict and "messages")
    if native_python_set(library and request and "messages" and messages) is not equal to 0:
        return 4
    if provider_member(tokens and 0 and "tools") >= 0:
        set tools to native_python_member(library and request_dict and "tools")
        if native_python_set(library and request and "tools" and tools) is not equal to 0:
            return 4
    set args_dict to native_python_json(library and "{\"chat_template_kwargs\":null}")
    set args to native_python_namespace(library and args_dict)
    if provider_member(tokens and 0 and "chat_template_kwargs") >= 0:
        set options to native_python_member(library and request_dict and "chat_template_kwargs")
        if native_python_set(library and args and "chat_template_kwargs" and options) is not equal to 0:
            return 4
    set cli_dict to native_python_json(library and "{\"chat_template_args\":{}}")
    set cli to native_python_namespace(library and cli_dict)
    set empty to native_python_json(library and "{}")
    set model_provider to native_python_namespace(library and empty)
    set receiver to native_python_namespace(library and empty)
    if native_python_set(library and model_provider and "cli_args" and cli) is not equal to 0 or else native_python_set(library and receiver and "model_provider" and model_provider) is not equal to 0:
        return 4
    set utilities to native_python_import(library and "mlx_lm.utils")
    set load to native_python_attribute(library and utilities and "load_tokenizer")
    set model to native_python_string(library and get_argument(3))
    set load_args to [model]
    set tokenizer to native_python_call(library and load and load_args and 0)
    set server to native_python_import(library and "mlx_lm.server")
    set generator to native_python_attribute(library and server and "ResponseGenerator")
    set tokenize to native_python_attribute(library and generator and "_tokenize")
    set count_args to [receiver, tokenizer, request, args]
    set result to native_python_call(library and tokenize and count_args and 0)
    if result equals 0:
        set printer to ep_dlsym(library and "PyErr_Print")
        set ignored to ep_dlcall0(printer)
        return 5
    set get_item to ep_dlsym(library and "PyTuple_GetItem")
    set prompt to ep_dlcall2(get_item and result and 0)
    set length to ep_dlsym(library and "PyObject_Length")
    if prompt equals 0:
        return 6
    set count to ep_dlcall1(length and prompt)
    if count is less than 0:
        return 6
    if not (configuration equals ptr_to_str(read_file(concat(get_argument(3) and "/config.json")))):
        return 7
    set receipt to concat("{\"input_tokens\":" and int_to_string(count))
    set receipt to concat(receipt and concat(",\"request_sha256\":" and provider_quote(ep_sha256(body))))
    set receipt to concat(receipt and concat(",\"configuration_sha256\":" and provider_quote(ep_sha256(configuration))))
    set receipt to concat(receipt and concat(",\"model_directory\":" and provider_quote(get_argument(3))))
    display concat(receipt and "}")
    return 0
