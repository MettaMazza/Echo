import "retained_text"
import "discord/activity_archive"

# Explicit maintenance: archive only retained Echo-owned activity threads with
# no active target and no undelivered activity. Content and binding persist.
define main returning Int:
    if get_argument_count() is not equal to 8:
        return 1
    set held to ep_dlopen(get_argument(1))
    set secret to read_file(get_argument(2))
    if held equals 0 or else secret equals 0:
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(4))
    if journal equals 0:
        return 3
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(5) and ",")
    set previous to 0
    repeat while not file_exists(get_argument(7)):
        set row to history_collect_one(checkpoint_prepare(journal and "SELECT t.rowid,t.inbox,t.thread FROM discord_activity_threads t WHERE t.rowid>CAST(? AS INTEGER) AND t.state='ready' AND NOT EXISTS(SELECT 1 FROM discord_activity_targets a WHERE a.inbox=t.inbox AND a.active=1) AND NOT EXISTS(SELECT 1 FROM discord_outbox o WHERE o.channel=t.thread AND o.state<>'sent') ORDER BY t.rowid LIMIT 1;" and [int_to_string(previous)]))
        if archive_list_text(row and 0) equals "end":
            break
        if not (archive_list_text(row and 0) equals "found"):
            return 4
        set previous to http_decimal(archive_list_text(row and 1))
        set outcome to discord_activity_archive_set(get_argument(1) and string_trim(ptr_to_str(secret)) and journal and archive_list_text(row and 2) and 1 and get_argument(4) and admins and get_argument(6) and get_argument(7))
        display concat(archive_list_text(row and 3) and concat(": " and outcome))
    return 0
