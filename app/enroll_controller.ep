import "lifecycle/controller_enrollment"

define main returning Int:
    if get_argument_count() is not equal to 8:
        display "Usage: enroll_controller CONFIGURATION enroll|revoke CHANGE_ID DEVICE LABEL ROOT_PRIVATE_CREDENTIAL_FILE REASON. For revoke use empty label and credential path. Root host authentication required."
        return 1
    set result to controller_enrollment_host(get_argument(1) and get_argument(2) and get_argument(3) and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(7))
    display result
    if result equals "recorded" or else result equals "already-recorded":
        return 0
    return 1
