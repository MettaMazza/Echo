import "../memory/archive_recall"
import "../security/group_gate"

# Scope comes only from a frozen initiating run. Group projects belong to the
# exact audience revision, including isolated children within that audience.
define project_scope with database as Int and run as Str returning Str:
    if run_authority_allows(database and run and "user") equals 0:
        return ""
    set principal to memory_archive_principal(database and run)
    if string_length(principal) > 0:
        return concat("private:" and principal)
    set current to agent_run_read(database and run)
    if current equals 0 or else group_run_session_allows(database and run and archive_list_text(current and 0)) equals 0:
        return ""
    set values to [run]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_array(s.group_id,s.revision) FROM echo_group_run_origins g JOIN echo_group_sessions s ON s.session=g.session WHERE g.run=?;" and values))
    if not (archive_list_text(row and 0) equals "found"):
        return ""
    return concat("audience:" and archive_list_text(row and 1))

# Device linking retains the existing memory union. It does not rewrite project
# provenance or make a private project visible from a shared conversation.
define project_scope_allows with database as Int and run as Str and scope as Str returning Int:
    set current to project_scope(database and run)
    return project_scope_pair_allows(database and current and scope)

define project_scope_pair_allows with database as Int and current as Str and scope as Str returning Int:
    if string_length(current) equals 0:
        return 0
    if current equals scope:
        return 1
    if string_length(scope) < 8 or else not (substring(scope and 0 and 8) equals "private:"):
        return 0
    if string_length(current) < 8 or else not (substring(current and 0 and 8) equals "private:"):
        return 0
    set principal to substring(current and 8 and string_length(current) - 8)
    set values to [principal,substring(scope and 8 and string_length(scope) - 8)]
    set query to memory_scope_query(database and "SELECT identity FROM echo_principals WHERE identity=?2 AND identity IN (__MEMORY_SCOPE__) AND revoked=0;")
    set row to history_collect_one(checkpoint_prepare(database and query and values))
    return archive_list_text(row and 0) equals "found"
