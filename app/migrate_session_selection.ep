import "security/group_session_selection"
import "archive/snapshot"

# Host maintenance only. Stop the connector workers before invoking this tool;
# it is not an online migration protocol. Keep the verified backup on One Touch.
define main returning Int:
    if get_argument_count() is not equal to 3 or else not file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        display "Supply the existing idle database and a new backup destination."
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0:
        return 2
    if migration_compatible(database and 27) equals 0:
        set closed to sql_close(database)
        return 3
    set active to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_runs WHERE state NOT IN ('completed','cancelled','failed'))+(SELECT COUNT(*) FROM echo_web_workers WHERE status='running');"))
    if not (archive_list_text(active and 0) equals "found") or else not (archive_list_text(active and 1) equals "0"):
        display "Active or unresolved work must finish or be reconciled before migration."
        set closed to sql_close(database)
        return 4
    if archive_snapshot(database and get_argument(2)) is not equal to 0:
        set closed to sql_close(database)
        return 5
    set status to group_session_selection_schema(database)
    display status
    set closed to sql_close(database)
    if closed is not equal to 0 or else not (status equals "applied" or else status equals "already-applied"):
        return 6
    return 0
