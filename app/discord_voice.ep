import "discord/voice_service"
import "archive/runtime_lock"
import "retained_text"
import "string"

# Host-only executable: curl, secret file, existing journal, existing archive,
# private spool, stop file, bot, guild CSV, admin CSV, intent identity,
# sodium, DAVE, DAVE callbacks, permission refresh interval in milliseconds,
# optional operator-pinned Opus path enabling queued audio playback.
# No model or Discord payload selects native-library paths or credentials.
define main returning Int:
    if not (get_argument_count() equals 15 or else get_argument_count() equals 16):
        return 1
    if not file_exists(get_argument(3)) or else not file_exists(get_argument(4)) or else discord_snowflake(get_argument(7)) equals 0 or else string_length(get_argument(10)) equals 0:
        return 2
    set interval to http_decimal(get_argument(14))
    if interval < 1 or else interval > 60000:
        return 2
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set token to string_trim(ptr_to_str(credential))
    set guilds to create_list()
    set split_count to retained_text_split(guilds and get_argument(8) and ",")
    set admins to create_list()
    set split_count to retained_text_split(admins and get_argument(9) and ",")
    for each value in guilds:
        if discord_snowflake(ptr_to_str(value)) equals 0:
            return 2
    for each value in admins:
        if discord_snowflake(ptr_to_str(value)) equals 0:
            return 2
    set journal to sql_open(get_argument(3))
    set reader to sql_open(get_argument(3))
    set database to sql_open(get_argument(4))
    if journal equals 0 or else reader equals 0 or else database equals 0:
        return 3
    if sql_execute(journal and "PRAGMA busy_timeout=1000;") is not equal to 0 or else sql_execute(reader and "PRAGMA busy_timeout=1000; PRAGMA query_only=ON;") is not equal to 0 or else sql_execute(database and "PRAGMA busy_timeout=1000; PRAGMA query_only=ON;") is not equal to 0:
        return 3
    if discord_voice_session_schema(journal) is not equal to 0:
        return 3
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set transport_lifetime to ep_dlopen(get_argument(1))
    if system equals 0 or else transport_lifetime equals 0:
        return 4
    set anchor to archive_runtime_anchor(journal and system)
    if string_length(anchor) equals 0:
        return 4
    set lock_path to concat(anchor and concat(".voice." and ep_sha256(get_argument(10))))
    set lock to native_open_mode(system and lock_path and 16777986 and 384)
    if lock < 0 or else socket_signed_result(ep_dlcall2(ep_dlsym(system and "flock") and lock and 6)) is not equal to 0:
        return 5
    set config to create_list()
    set added to append_list(config and get_argument(1))
    set added to append_list(config and token)
    set added to append_list(config and get_argument(3))
    set added to append_list(config and get_argument(4))
    set added to append_list(config and get_argument(10))
    set added to append_list(config and get_argument(7))
    set added to append_list(config and guilds)
    set added to append_list(config and admins)
    set added to append_list(config and get_argument(5))
    set added to append_list(config and get_argument(6))
    set added to append_list(config and 0)
    set paths to create_list()
    set paths to [get_argument(11),get_argument(12),get_argument(13)]
    set stop to channel
    set opus_path to ""
    if get_argument_count() equals 16:
        set opus_path to get_argument(15)
    set outcome to discord_voice_service_run_audio(journal and reader and database and config and paths and interval and stop and opus_path)
    display outcome
    set closed to net_close(lock)
    set closed to sql_close(database)
    set closed to sql_close(reader)
    set closed to sql_close(journal)
    set closed to ep_dlclose(transport_lifetime)
    set closed to ep_dlclose(system)
    if outcome equals "voice-worker-stopped" or else outcome equals "voice-stopped":
        return 0
    return 6
