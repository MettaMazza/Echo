import "memory/automatic"
import "fs"

# Operator backfill from an already generated, private extraction receipt.
# The normal source/quote/owner checks still apply; this never imports SQL or
# transfers another principal's records. Originals must already exist locally.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set tokens to provider_json_tokens(ptr_to_str(read_file(get_argument(3))))
    set items to provider_items(tokens and 0)
    if items equals 0:
        return 3
    set sources to create_list()
    set index to 0
    repeat while index < length_list(items):
        set added to append_list(sources and provider_value(tokens and get_list(items and index)))
        set index to index + 1
    set grounded to memory_ground_extraction(database and get_argument(2) and sources and 0 and length_list(sources) and ptr_to_str(read_file(get_argument(4))))
    set written to write_file(concat(get_argument(4) and ".grounded") and grounded)
    set result to memory_extract_save(database and get_argument(2) and sources and 0 and length_list(sources) and grounded)
    display result
    set closed to sql_close(database)
    if not (result equals "ready"):
        return 4
    return closed
