import "memory/source_import"
import "fs"

# Host operator supplies the target owned run, immutable event ID, and UTF-8
# source envelope. No model-selected host path or cross-principal selector.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set result to memory_source_import(database and get_argument(2) and get_argument(3) and ptr_to_str(read_file(get_argument(4))))
    display result
    set closed to sql_close(database)
    if not (result equals "recorded" or else result equals "already-recorded"):
        return 3
    return closed
