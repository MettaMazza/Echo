import "archive/export_restore"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3 and get_argument_count() is not equal to 4:
        display "Supply an export file, a new archive database path, and optionally a separately trusted final hash."
        return 1
    if not file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        display "The source must exist and the destination must be new."
        return 1
    set text to ptr_to_str(read_file(get_argument(1)))
    set trusted to ""
    if get_argument_count() equals 4:
        set trusted to get_argument(3)
    if archive_export_verify(text and trusted) is not equal to 0:
        display "Export verification failed; destination was not created."
        return 1
    set database to archive_open(get_argument(2))
    if database equals 0:
        return 1
    set result to archive_export_restore(database and text and trusted)
    set closed to sql_close(database)
    if result is not equal to 0 or else closed is not equal to 0:
        display "Restore failed; inspect the destination before retrying."
        return 1
    display "Original events restored and verified. This archive does not resume tools or restore application configuration."
    return 0
