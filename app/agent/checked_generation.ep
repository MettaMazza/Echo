import "external_generation"
import "../providers/external_environment"
import "../providers/external_native"
import "../retained_text"
import "generation"
import "../providers/prepare"

# Context composition supplies the exact body and workload output reserve.
# The ready event captured before discovery must still be current afterwards.
# A non-ready decision leaves the run ready for compaction/configuration work.
define agent_generate_provider_at with database as Int and run as Str and expected_parent as Str and request as Str and body as Str and profile as Str and output_reserve as Int and cancellation_reader as Int and read_size as Int and choice_index as Str returning List:
    set result to create_list()
    set added to append_list(result and "invalid-run")
    set row to agent_run_read(database and run)
    if row equals 0:
        return result
    if not (archive_list_text(row and 2) equals "ready"):
        return result
    set parent to archive_list_text(row and 3)
    if not (parent equals expected_parent):
        set changed to set_list(result and 0 and "stale-context")
        return result
    set selected to provider_json_tokens(profile)
    set external_family to provider_value(selected and provider_member(selected and 0 and "adapter"))
    if external_family equals "anthropic-messages" or else external_family equals "openai-responses":
        return agent_generate_external_checked(database and run and expected_parent and request and body and profile and cancellation_reader and read_size and choice_index)
    set body to agent_closing_report_body(database and run and profile and body)
    set decision to provider_prepare(database and archive_list_text(row and 0) and concat(request and ":preflight") and profile and body and output_reserve and cancellation_reader and read_size)
    if not (archive_list_text(decision and 0) equals "ready"):
        return decision
    if agent_generate_local_at(database and run and parent and request and archive_list_text(decision and 5) and get_list(decision and 7) and archive_list_text(decision and 6) and cancellation_reader and read_size and choice_index) is not equal to 0:
        set changed to set_list(decision and 0 and "generation-failed-or-stale")
        return decision
    set changed to set_list(decision and 0 and "advanced")
    return decision

# Existing callers retain their launch configuration while using the same
# provider contract. New callers pass an authorized profile to the entry above.
define agent_generate_checked_at with database as Int and run as Str and expected_parent as Str and request as Str and body as Str and port as Int and output_reserve as Int and cancellation_reader as Int and read_size as Int and choice_index as Str returning List:
    set tokens to provider_json_tokens(body)
    if tokens equals 0:
        return provider_prepared_error("invalid-request")
    set model to provider_value(tokens and provider_member(tokens and 0 and "model"))
    set profile to provider_llama_profile(model and port)
    return agent_generate_provider_at(database and run and expected_parent and request and body and profile and output_reserve and cancellation_reader and read_size and choice_index)

define agent_generate_checked with database as Int and run as Str and request as Str and body as Str and port as Int and output_reserve as Int and cancellation_reader as Int and read_size as Int and choice_index as Str returning List:
    set row to agent_run_read(database and run)
    if row equals 0:
        set result to create_list()
        set added to append_list(result and "invalid-run")
        return result
    return agent_generate_checked_at(database and run and archive_list_text(row and 3) and request and body and port and output_reserve and cancellation_reader and read_size and choice_index)

# autoOff closes an autonomous interval; its next response is reporting, not
# further tool work. New guidance or re-enabled autonomy restores normal mode.
# Keep the original full conversation; change only the reporting transport mode.
define agent_closing_report_body with database as Int and run as Str and profile as Str and body as Str returning Str:
    set config to provider_json_tokens(profile)
    if not (provider_value(config and provider_member(config and 0 and "adapter")) equals "llama.cpp") or else autonomy_enabled(database and run):
        return body
    set pending to history_collect_one(checkpoint_prepare(database and "SELECT q.event FROM echo_events q WHERE q.kind='autonomy_summary_requested' AND json_extract(q.payload,'$.run_id')=?1 AND NOT EXISTS(SELECT 1 FROM echo_events f WHERE json_extract(f.payload,'$.run_id')=?1 AND f.sequence>q.sequence AND f.kind IN ('assistant_final','user_guidance','guidance_received','autonomy_enabled')) ORDER BY q.sequence DESC LIMIT 1;" and [run]))
    if not (archive_list_text(pending and 0) equals "found"):
        return body
    set rewritten to history_collect_one(checkpoint_prepare(database and "SELECT json_set(json_remove(?1,'$.tools','$.tool_choice'),'$.chat_template_kwargs.enable_thinking',json('false'),'$.echo_background',json('false'));" and [body]))
    if archive_list_text(rewritten and 0) equals "found":
        return archive_list_text(rewritten and 1)
    return body

# Explicit external route: no local endpoint or host-global default is used.
define agent_generate_external_checked with database as Int and run as Str and expected_parent as Str and request as Str and body as Str and profile as Str and cancellation as Int and batch as Int and choice as Str returning List:
    if external_profile_run_allows(database and run and profile) equals 0:
        return provider_prepared_error("not-authorized")
    set row to agent_run_read(database and run)
    if row equals 0 or else not (archive_list_text(row and 2) equals "ready") or else not (archive_list_text(row and 3) equals expected_parent):
        return provider_prepared_error("stale-context")
    set native to external_native_request(database and archive_list_text(row and 0) and profile and body)
    if not (archive_list_text(native and 0) equals "ready"):
        return provider_prepared_error(archive_list_text(native and 0))
    set environment to external_environment_open()
    if not (archive_list_text(environment and 0) equals "ready"):
        return provider_prepared_error(archive_list_text(environment and 0))
    set native_body to archive_list_text(native and 1)
    set root to archive_list_text(environment and 5)
    set system to get_list(environment and 1)
    set spool to get_list(environment and 2)
    set vault to get_list(environment and 3)
    set errors to get_list(environment and 4)
    set decision to external_preflight(database and run and concat(request and ":preflight") and profile and native_body and root and system and spool and vault and errors and cancellation and batch)
    if archive_list_text(decision and 0) equals "ready":
        set status to "advanced"
        if agent_generate_external_at(database and run and expected_parent and request and profile and native_body and root and system and spool and vault and errors and cancellation and batch and choice) is not equal to 0:
            set status to "generation-failed-or-stale"
        set changed to set_list(decision and 0 and status)
    if external_environment_close(environment) is not equal to 0:
        return provider_prepared_error("external-storage-close-failed")
    return decision
