import "../retained_text"
import "generation"
import "../providers/prepare"

# Context composition supplies the exact body and workload output reserve.
# The ready event captured before discovery must still be current afterwards.
# A non-ready decision leaves the run ready for compaction/configuration work.
define agent_generate_provider_at with database as Int and run as Str and expected_parent as Str and request as Str and body as Str and profile as Str and output_reserve as Int and cancellation_reader as Int and read_size as Int and choice_index as Str returning List:
    set result to create_list()
    set added to append_list(result and "invalid-run")
    set row to agent_run_read(database and run)
    if row equals 0:
        return result
    if not (archive_list_text(row and 2) equals "ready"):
        return result
    set parent to archive_list_text(row and 3)
    if not (parent equals expected_parent):
        set changed to set_list(result and 0 and "stale-context")
        return result
    set decision to provider_prepare(database and archive_list_text(row and 0) and concat(request and ":preflight") and profile and body and output_reserve and cancellation_reader and read_size)
    if not (archive_list_text(decision and 0) equals "ready"):
        return decision
    if agent_generate_local_at(database and run and parent and request and archive_list_text(decision and 5) and get_list(decision and 7) and archive_list_text(decision and 6) and cancellation_reader and read_size and choice_index) is not equal to 0:
        set changed to set_list(decision and 0 and "generation-failed-or-stale")
        return decision
    set changed to set_list(decision and 0 and "advanced")
    return decision

# Existing callers retain their launch configuration while using the same
# provider contract. New callers pass an authorized profile to the entry above.
define agent_generate_checked_at with database as Int and run as Str and expected_parent as Str and request as Str and body as Str and port as Int and output_reserve as Int and cancellation_reader as Int and read_size as Int and choice_index as Str returning List:
    set tokens to provider_json_tokens(body)
    if tokens equals 0:
        return provider_prepared_error("invalid-request")
    set model to provider_value(tokens and provider_member(tokens and 0 and "model"))
    set profile to provider_llama_profile(model and port)
    return agent_generate_provider_at(database and run and expected_parent and request and body and profile and output_reserve and cancellation_reader and read_size and choice_index)

define agent_generate_checked with database as Int and run as Str and request as Str and body as Str and port as Int and output_reserve as Int and cancellation_reader as Int and read_size as Int and choice_index as Str returning List:
    set row to agent_run_read(database and run)
    if row equals 0:
        set result to create_list()
        set added to append_list(result and "invalid-run")
        return result
    return agent_generate_checked_at(database and run and archive_list_text(row and 3) and request and body and port and output_reserve and cancellation_reader and read_size and choice_index)
