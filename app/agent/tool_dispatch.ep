# One invocation executes at most the next cursor item. The enclosing run loops
# until the ledger is observed; this is scheduling granularity, not a turn cap.
# Read-only discovery and evidence gathering do not need a bookkeeping turn.
# Authorization still runs first; completed tasks still return their result.
define agent_direct_lookup with database as Int and run as Str and name as Str and arguments as Str returning Int:
    if name equals "request_user_input" or else name equals "autoOff":
        return 1
    if task_checklist_state(database and run) equals "complete":
        return 0
    # Local media decoding derives observations; it does not change the source.
    if name equals "attachment_video" or else name equals "attachment_transcribe":
        return 1
    set capability to tool_capability(name)
    if capability equals "memory.private-read" or else capability equals "session.read" or else capability equals "attachment.read" or else capability equals "workspace.read" or else capability equals "network.public-read" or else capability equals "tool.discover" or else capability equals "system.scoped-inspect" or else name equals "delegation_status":
        return 1
    if name equals "scratchpad":
        set fields to provider_json_tokens(arguments)
        set operation to provider_value(fields and provider_member(fields and 0 and "operation"))
        return operation equals "read" or else operation equals "list"
    return 0

define agent_tool_step_cancellable with database as Int and run as Str and cancellation as Int returning Int:
    set row to agent_run_read(database and run)
    if row equals 0:
        return 1
    if not (archive_list_text(row and 2) equals "tools"):
        return 1
    set session to archive_list_text(row and 0)
    set parent to archive_list_text(row and 3)
    set values to create_list()
    set added to append_list(values and run)
    # Do not advance another queued action past an unresolved earlier effect.
    set unresolved to checkpoint_prepare(database and "SELECT call_id FROM echo_tool_calls WHERE run=? AND state IN ('running','uncertain') LIMIT 1;" and values)
    if unresolved equals 0:
        return 1
    set unresolved_step to ep_sqlite3_step(unresolved)
    set unresolved_closed to ep_sqlite3_finalize(unresolved)
    if unresolved_step is not equal to 101 or else unresolved_closed is not equal to 0:
        return 1
    set statement to checkpoint_prepare(database and "SELECT t.call_id,t.request_event FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run=? AND t.state='queued' ORDER BY e.sequence LIMIT 1;" and values)
    if statement equals 0:
        return 1
    set step to ep_sqlite3_step(statement)
    if step equals 101:
        set closed to ep_sqlite3_finalize(statement)
        if closed is not equal to 0:
            return 1
        set statement to checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls WHERE run=? AND state<>'observed';" and values)
        if statement equals 0:
            return 1
        if ep_sqlite3_step(statement) is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return 1
        set remaining to ptr_to_str(ep_sqlite3_column_text(statement and 0))
        if archive_finish(statement and 101) is not equal to 0 or else not (remaining equals "0"):
            return 1
        set event to concat(parent and ":observed")
        set payload to concat(agent_event_envelope(run and parent) and "}")
        if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
            return 1
        if archive_append_pending(database and session and event and "agent_observation" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0 or else agent_run_transition(database and run and "tools" and parent and "ready" and event) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
            return archive_rollback(database)
        return 0
    if step is not equal to 100:
        set closed to ep_sqlite3_finalize(statement)
        return 1
    set call_id to ptr_to_str(ep_sqlite3_column_text(statement and 0))
    set request_event to ptr_to_str(ep_sqlite3_column_text(statement and 1))
    if archive_finish(statement and 101) is not equal to 0:
        return 1
    set original to archive_read_event(database and request_event)
    if original equals 0:
        return 1
    set tokens to provider_json_tokens(archive_list_text(original and 3))
    if tokens equals 0:
        return 1
    set name_field to provider_member(tokens and 0 and "name")
    set arguments_field to provider_member(tokens and 0 and "arguments")
    if not (provider_kind(tokens and name_field) equals "string") or else not (provider_kind(tokens and arguments_field) equals "string"):
        return 1
    if agent_run_claim_tool(database and run and call_id) is not equal to 0:
        return 1
    set observation to ""
    set session_allowed to principal_session_active(database and session)
    if session_allowed equals 0:
        set session_allowed to group_run_session_allows(database and run and session)
    set authority_denied to session_allowed equals 0 or else run_authority_allows(database and run and "user") equals 0 or else tool_authority_allows(database and run and call_id and "user") equals 0
    set guidance to guidance_pending(database and run)
    if archive_list_text(guidance and 0) equals "found":
        set observation to "{\"status\":\"not-executed\",\"effects\":\"none\",\"cause\":\"mid-turn-guidance\",\"recovery\":\"Reconsider this action with the incoming user guidance before requesting it again.\"}"
    else if archive_list_text(guidance and 0) equals "error":
        set observation to "{\"status\":\"not-executed\",\"effects\":\"none\",\"cause\":\"guidance-read-error\"}"
    else if authority_denied:
        set observation to "{\"status\":\"not-authorized\",\"stage\":\"tool-dispatch\",\"cause\":\"initiating-authority-denied\",\"effects\":\"none\",\"recovery\":\"host-review-required\"}"
    else if tool_policy_allows(database and run and call_id and provider_value(tokens and name_field)) equals 0:
        set observation to tool_policy_denial(database and run and provider_value(tokens and name_field))
    else if provider_value(tokens and name_field) equals "watch_party":
        set observation to watch_party_tool(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "request_user_input" or else provider_value(tokens and name_field) equals "autoOff":
        set observation to interaction_execute(database and run and call_id and provider_value(tokens and name_field) and provider_value(tokens and arguments_field))
    else if not (questions_pending(database and run) equals "null"):
        set observation to "{\"status\":\"not-executed\",\"effects\":\"none\",\"cause\":\"awaiting-user-input\",\"recovery\":\"Reconsider this queued action after the user answers.\"}"
    else if string_index_of(run and "watch-segment:") is not equal to 0 and (task_checklist_state(database and run) equals "missing" or else task_checklist_state(database and run) equals "revise" or else task_checklist_state(database and run) equals "available") and not (provider_value(tokens and name_field) equals "task_checklist") and not agent_direct_lookup(database and run and provider_value(tokens and name_field) and provider_value(tokens and arguments_field)):
        set observation to "{\"status\":\"checklist-required\",\"effects\":\"none\",\"recovery\":\"Record the assigned requirements with task_checklist before executing other work. All normal tools remain available after the checklist is recorded.\"}"
    else if task_checklist_state(database and run) equals "complete":
        set observation to "{\"status\":\"task-complete-return-result\",\"effects\":\"none\",\"recovery\":\"All assigned checklist requirements are resolved. Return the final report to your requester now.\"}"
    else if provider_value(tokens and name_field) equals "protected_change_inspect" or else provider_value(tokens and name_field) equals "protected_change_review":
        set observation to protected_tool_execute(database and run and call_id and provider_value(tokens and name_field))
    else if provider_value(tokens and name_field) equals "memory_timeline" or else provider_value(tokens and name_field) equals "memory_record" or else provider_value(tokens and name_field) equals "memory_graph" or else provider_value(tokens and name_field) equals "memory_status" or else provider_value(tokens and name_field) equals "memory_set_visibility":
        set observation to knowledge_tool_execute(database and run and call_id and provider_value(tokens and name_field))
    else if (provider_value(tokens and name_field) equals "web_fetch" or else provider_value(tokens and name_field) equals "web_search" or else provider_value(tokens and name_field) equals "web_follow"):
        set observation to web_fetch_execute(database and run and call_id and cancellation)
    else if provider_value(tokens and name_field) equals "tool_candidates":
        set observation to candidate_discovery_execute(database and run and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "delegate_task":
        set observation to delegation_tool_execute(database and run and call_id)
    else if provider_value(tokens and name_field) equals "delegation_message":
        set observation to delegation_message_execute(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "task_checklist":
        set observation to task_checklist_save(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "delegation_status":
        set observation to delegation_status_execute(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "schedule":
        set observation to schedule_tool_execute(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "procedure":
        set observation to procedure_tool_execute(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "project":
        set observation to project_tool_execute(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "job_control":
        set observation to job_control_execute(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "scratchpad":
        set observation to scratchpad_execute(database and run and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "trace_search" or else provider_value(tokens and name_field) equals "trace_read":
        set observation to trace_execute(database and run and provider_value(tokens and name_field) and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "memory_sessions" or else provider_value(tokens and name_field) equals "memory_messages" or else provider_value(tokens and name_field) equals "reasoning_read":
        set observation to continuity_execute(database and run and provider_value(tokens and name_field) and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "memory_search" or else provider_value(tokens and name_field) equals "memory_read":
        set observation to memory_tool_execute(database and run and call_id and provider_value(tokens and name_field))
    else if provider_value(tokens and name_field) equals "host_read_text":
        set observation to host_text_execute(database and run and call_id)
    else if provider_value(tokens and name_field) equals "tool_search":
        set observation to tool_discovery_execute(database and run and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "state_inspect":
        set observation to hud_execute(database and run and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "system_inspect":
        set observation to echo_system_inspect(database and run and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "session_rebuild_recap":
        set observation to recap_rebuild_enqueue(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "video_library":
        set observation to video_library_tool(database and run and call_id and provider_value(tokens and arguments_field))
    else if provider_value(tokens and name_field) equals "attachment_video":
        set observation to video_tool_execute(database and run and call_id and cancellation)
    else if provider_value(tokens and name_field) equals "image_generate":
        set observation to image_tool_execute(database and run and call_id and cancellation)
    else if provider_value(tokens and name_field) equals "attachment_transcribe" or else provider_value(tokens and name_field) equals "speech_synthesize":
        set observation to speech_tool_execute(database and run and call_id and cancellation)
    else if (provider_value(tokens and name_field) equals "workspace_plot" or else provider_value(tokens and name_field) equals "workspace_archive_create" or else provider_value(tokens and name_field) equals "workspace_archive_extract" or else provider_value(tokens and name_field) equals "workspace_archive_list" or else provider_value(tokens and name_field) equals "workspace_edit_workbook" or else provider_value(tokens and name_field) equals "workspace_create_workbook" or else provider_value(tokens and name_field) equals "workspace_read_workbook" or else provider_value(tokens and name_field) equals "workspace_read_json" or else provider_value(tokens and name_field) equals "workspace_read_table" or else provider_value(tokens and name_field) equals "workspace_diff" or else provider_value(tokens and name_field) equals "workspace_search" or else provider_value(tokens and name_field) equals "workspace_edit_text" or else provider_value(tokens and name_field) equals "workspace_list" or else provider_value(tokens and name_field) equals "workspace_read_text" or else provider_value(tokens and name_field) equals "workspace_create_text" or else provider_value(tokens and name_field) equals "workspace_make_directory") and group_run_session_allows(database and run and session) equals 1:
        set observation to workspace_tool_execute_owned(database and run and call_id)
    else if (provider_value(tokens and name_field) equals "workspace_database" or else provider_value(tokens and name_field) equals "workspace_build" or else provider_value(tokens and name_field) equals "workspace_execute" or else provider_value(tokens and name_field) equals "host_execute" or else provider_value(tokens and name_field) equals "host_git"):
        set observation to execution_tool_execute(database and run and call_id and cancellation)
    else if provider_value(tokens and name_field) equals "attach_file" and group_run_session_allows(database and run and session) equals 1:
        set observation to attach_file_execute_owned(database and run and call_id)
    else:
        set observation to session_tool_execute(database and session and provider_value(tokens and name_field) and provider_value(tokens and arguments_field))
        if provider_value(tokens and name_field) equals "history_read" or else provider_value(tokens and name_field) equals "history_search":
            set observed_tokens to provider_json_tokens(observation)
            if provider_value(observed_tokens and provider_member(observed_tokens and 0 and "status")) equals "found":
                set observation to memory_correction_wrap(database and run and provider_value(observed_tokens and provider_member(observed_tokens and 0 and "event")) and observation)
    if string_length(observation) equals 0 or else provider_json_tokens(observation) equals 0:
        set raw to provider_quote(observation)
        set observation to concat("{\"status\":\"invalid-tool-result\",\"raw_result\":" and concat(raw and "}"))
    set observation to feedback_enrich(observation and provider_value(tokens and name_field) and request_event)
    set payload to agent_event_envelope(run and parent)
    set payload to concat(payload and concat(",\"call_id\":" and provider_quote(call_id)))
    set payload to concat(payload and concat(",\"request_event\":" and provider_quote(request_event)))
    set payload to concat(payload and concat(",\"result\":" and concat(observation and "}")))
    set event to concat(request_event and ":result")
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if archive_append_pending(database and session and event and "tool_result" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0 or else tool_ledger_observe(database and run and call_id and event) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    set guidance to guidance_pending(database and run)
    if archive_list_text(guidance and 0) equals "found":
        set observation to "{\"status\":\"not-executed\",\"effects\":\"none\",\"cause\":\"mid-turn-guidance\",\"recovery\":\"Reconsider this action with the incoming user guidance before requesting it again.\"}"
    else if archive_list_text(guidance and 0) equals "error":
        set observation to "{\"status\":\"not-executed\",\"effects\":\"none\",\"cause\":\"guidance-read-error\"}"
    else if authority_denied:
        return agent_cancel_run(database and run)
    if (provider_value(tokens and name_field) equals "web_fetch" or else provider_value(tokens and name_field) equals "web_search" or else provider_value(tokens and name_field) equals "web_follow") or else (provider_value(tokens and name_field) equals "workspace_database" or else provider_value(tokens and name_field) equals "workspace_build" or else provider_value(tokens and name_field) equals "workspace_execute" or else provider_value(tokens and name_field) equals "host_execute" or else provider_value(tokens and name_field) equals "host_git") or else provider_value(tokens and name_field) equals "attachment_video" or else provider_value(tokens and name_field) equals "image_generate" or else provider_value(tokens and name_field) equals "attachment_transcribe" or else provider_value(tokens and name_field) equals "speech_synthesize" or else provider_value(tokens and name_field) equals "session_rebuild_recap":
        set result_tokens to provider_json_tokens(observation)
        set result_status to provider_value(result_tokens and provider_member(result_tokens and 0 and "status"))
        if result_status equals "cancelled" or else result_status equals "cancelled-before-launch" or else result_status equals "authorization-changed" or else result_status equals "not-authorized" or else result_status equals "review-required":
            return agent_cancel_run(database and run)
    return 0

# Existing direct callers have no external cancellation descriptor.
define agent_tool_step with database as Int and run as Str returning Int:
    return agent_tool_step_cancellable(database and run and -1)
