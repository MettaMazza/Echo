import "discovery_recovery"
import "../feedback"
import "../context/compaction_lock"
import "../workspace/guardian_receipt"
import "../retained_text"
import "run_state"
import "process_recovery"

# Caller owns the native run lock and has verified the abandoned worker claim.
# Recover saved outcomes, or an explicitly fresh, authorized local catalogue
# observation. Missing outcomes never authorize replay of arbitrary tools.
define agent_recover_tools_owned with database as Int and run as Str returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 1
    set lock to compaction_lock_acquire(database and concat("execution-guardian:" and run) and library)
    if lock < 0:
        set closed to ep_dlclose(library)
        return 1
    set result to agent_recover_tools_locked(database and run)
    set closed to net_close(lock)
    set closed to ep_dlclose(library)
    return result

define agent_recover_tools_locked with database as Int and run as Str returning Int:
    set row to agent_run_read(database and run)
    if row equals 0 or else archive_verify(database and archive_list_text(row and 0)) is not equal to 0:
        return 1
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    set values to create_list()
    set added to append_list(values and run)
    set statement to checkpoint_prepare(database and "SELECT t.call_id,t.state,COALESCE(e.event,'') FROM echo_tool_calls t LEFT JOIN echo_events e ON e.event=t.request_event||':result' AND e.session=t.session AND e.kind='tool_result' AND CASE WHEN json_valid(e.payload) THEN json_extract(e.payload,'$.run_id') END=t.run AND CASE WHEN json_valid(e.payload) THEN json_extract(e.payload,'$.call_id') END=t.call_id AND CASE WHEN json_valid(e.payload) THEN json_extract(e.payload,'$.request_event') END=t.request_event WHERE t.run=? AND t.state IN ('running','uncertain');" and values)
    if statement equals 0:
        return archive_rollback(database)
    set pending to create_list()
    repeat while 1 equals 1:
        set step to ep_sqlite3_step(statement)
        if step equals 101:
            break
        if step is not equal to 100:
            set closed to ep_sqlite3_finalize(statement)
            return archive_rollback(database)
        set item to create_list()
        set index to 0
        repeat while index is less than 3:
            set added to append_list(item and concat(ptr_to_str(ep_sqlite3_column_text(statement and index)) and ""))
            set index to index + 1
        set added to append_list(pending and item)
    if ep_sqlite3_finalize(statement) is not equal to 0:
        return archive_rollback(database)
    set index to 0
    repeat while index is less than length_list(pending):
        set item to get_list(pending and index)
        set call_id to archive_list_text(item and 0)
        set result_event to archive_list_text(item and 2)
        if string_length(result_event) equals 0:
            set result_event to agent_recover_guardian_pending(database and run and call_id)
        if string_length(result_event) equals 0:
            set result_event to agent_recover_process_pending(database and run and call_id)
        if string_length(result_event) equals 0:
            set result_event to agent_recover_discovery_pending(database and run and call_id)
        if string_length(result_event) is greater than 0:
            if tool_ledger_observe(database and run and call_id and result_event) is not equal to 0:
                return archive_rollback(database)
        else:
            if archive_list_text(item and 1) equals "running":
                if tool_ledger_interrupt(database and run and call_id) is not equal to 0:
                    return archive_rollback(database)
        set index to index + 1
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return archive_rollback(database)
    set cancelled to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='tool_result' AND json_extract(payload,'$.run_id')=? AND (json_extract(payload,'$.result.status') IN ('cancelled','cancelled-before-launch','authorization-changed','not-authorized','review-required') OR json_extract(payload,'$.result.execution_status')='cancelled');" and values))
    if not (archive_list_text(cancelled and 0) equals "found"):
        return 1
    if not (archive_list_text(cancelled and 1) equals "0"):
        return agent_cancel_run(database and run)
    return 0

# The original guardian result includes launch failures and cancellation as well
# as normal process exits. Preserve it verbatim in the recovered tool result.
define agent_recover_guardian_pending with database as Int and run as Str and call_id as Str returning Str:
    set result to workspace_guardian_receipt(database and run and call_id)
    if string_length(result) equals 0:
        return ""
    set call to tool_ledger_read(database and run and call_id)
    set current to agent_run_read(database and run)
    if call equals 0 or else current equals 0:
        return ""
    set request to archive_list_text(call and 3)
    set event to concat(request and ":result")
    set payload to agent_event_envelope(run and archive_list_text(current and 3))
    set payload to concat(payload and concat(",\"call_id\":" and provider_quote(call_id)))
    set payload to concat(payload and concat(",\"request_event\":" and provider_quote(request)))
    set result to feedback_enrich(result and "Recovered tool" and request)
    set payload to concat(payload and concat(",\"result\":" and concat(result and "}")))
    if archive_append_pending(database and archive_list_text(current and 0) and event and "tool_result" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return ""
    return event
