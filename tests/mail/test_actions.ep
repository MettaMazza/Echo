import "../../app/mail/actions"

define main returning Int:
    set path to ptr_to_str(get_env("ECHO_MAIL_ACTION_TEST_DB"))
    if string_length(path) equals 0:
        return 1
    set database to archive_open(path)
    if gmail_action_schema(database) is not equal to 0:
        return 2
    set other to archive_open(path)
    if not (archive_list_text(gmail_action_claim(database and "account" and "action" and "messages.modify" and "{\"id\":\"message\"}" and "{\"addLabelIds\":[\"STARRED\"]}") and 0) equals "claimed"):
        return 3
    if not (archive_list_text(gmail_action_claim(other and "account" and "action" and "messages.modify" and "{\"id\":\"message\"}" and "{\"addLabelIds\":[\"STARRED\"]}") and 0) equals "uncertain"):
        return 4
    if not (archive_list_text(gmail_action_claim(other and "account" and "action" and "messages.modify" and "{\"id\":\"other\"}" and "{\"addLabelIds\":[\"STARRED\"]}") and 0) equals "action-identity-conflict"):
        return 5
    set closed to sql_close(database)
    set database to archive_open(path)
    if not (archive_list_text(gmail_action_read(database and "account" and "action" and "messages.modify" and "{\"id\":\"message\"}" and "{\"addLabelIds\":[\"STARRED\"]}") and 0) equals "uncertain"):
        return 6
    set digest to gmail_action_digest("messages.modify" and "{\"id\":\"message\"}" and "{\"addLabelIds\":[\"STARRED\"]}")
    if not (gmail_action_observe(database and "account" and "action" and digest and "cancelled" and 0 and "") equals "incomplete-action-response"):
        return 7
    if not (gmail_action_observe(database and "account" and "action" and digest and "ready" and 204 and "") equals "observed") or else not (gmail_action_observe(other and "account" and "action" and digest and "ready" and 204 and "") equals "observed"):
        return 8
    if not (gmail_action_observe(other and "account" and "action" and digest and "ready" and 200 and "{}") equals "action-receipt-conflict"):
        return 9
    set replay to gmail_action_claim(other and "account" and "action" and "messages.modify" and "{\"id\":\"message\"}" and "{\"addLabelIds\":[\"STARRED\"]}")
    if not (archive_list_text(replay and 0) equals "observed") or else not (archive_list_text(replay and 2) equals "204"):
        return 10
    if sql_execute(database and "DELETE FROM echo_mail_actions;") equals 0 or else sql_execute(database and "UPDATE echo_mail_actions SET state='uncertain';") equals 0:
        return 11
    set closed to sql_close(other)
    set closed to sql_close(database)
    display "PASS: competing mailbox write claims, exact intent binding, restart uncertainty, complete response retention and no replay or erasure."
    return 0
