import "../../app/mail/request"

define main returning Int:
    set scopes to ["https://www.googleapis.com/auth/gmail.modify"]
    set request to gmail_request_plan("messages.list" and "{\"q\":\"from:a@example.com & café\",\"labelIds\":[\"INBOX\",\"UNREAD\"],\"includeSpamTrash\":false}" and "" and scopes)
    if not (archive_list_text(request and 0) equals "planned") or else not (archive_list_text(request and 2) equals "https://gmail.googleapis.com/gmail/v1/users/me/messages?q=from%3Aa%40example.com%20%26%20caf%C3%A9&labelIds=INBOX&labelIds=UNREAD&includeSpamTrash=false"):
        display archive_list_text(request and 0)
        display archive_list_text(request and 2)
        return 1
    for each parameters in ["{\"access_token\":\"secret\"}","{\"userId\":\"other@example.com\"}","{\"q\":\"a\",\"q\":\"b\"}","{\"maxResults\":4294967296}","{\"maxResults\":1.5}","{\"labelIds\":\"INBOX\"}"]:
        set result to gmail_request_plan("messages.list" and ptr_to_str(parameters) and "" and scopes)
        if archive_list_text(result and 0) equals "planned":
            return 2
    set result to gmail_request_plan("messages.get" and "{\"id\":\"abc/../?x\",\"format\":\"full\"}" and "" and scopes)
    if not (archive_list_text(result and 2) equals "https://gmail.googleapis.com/gmail/v1/users/me/messages/abc%2F..%2F%3Fx?format=full"):
        return 3
    set result to gmail_request_plan("messages.get" and "{}" and "" and scopes)
    if not (archive_list_text(result and 0) equals "required-parameter"):
        return 4
    set result to gmail_request_plan("messages.get" and "{\"id\":\"..\"}" and "" and scopes)
    if not (archive_list_text(result and 0) equals "invalid-path-parameter"):
        return 5
    set result to gmail_request_plan("messages.delete" and "{\"id\":\"abc\"}" and "" and scopes)
    if not (archive_list_text(result and 0) equals "scope-required"):
        return 6
    set result to gmail_request_plan("messages.delete" and "{\"id\":\"abc\"}" and "" and ["https://mail.google.com/"])
    if not (archive_list_text(result and 4) equals "permanent-delete"):
        return 7
    set result to gmail_request_plan("messages.list" and "{\"q\":\"x\"}" and "" and ["https://www.googleapis.com/auth/gmail.metadata"])
    if not (archive_list_text(result and 0) equals "search-scope-required"):
        return 8
    set result to gmail_request_plan("messages.send" and "{}" and "{\"raw\":\"YWJj\"}" and scopes)
    if not (archive_list_text(result and 1) equals "POST") or else not (archive_list_text(result and 4) equals "send"):
        return 9
    set result to gmail_request_plan("history.list" and "{\"startHistoryId\":\"18446744073709551615\",\"historyTypes\":[\"messageAdded\"]}" and "" and scopes)
    if not (archive_list_text(result and 0) equals "planned"):
        return 10
    set result to gmail_request_plan("messages.get" and "{\"id\":\"abc\",\"format\":\"invented\"}" and "" and scopes)
    if not (archive_list_text(result and 0) equals "invalid-parameter"):
        return 11
    set result to gmail_request_plan("history.list" and "{\"startHistoryId\":\"18446744073709551616\"}" and "" and scopes)
    if not (archive_list_text(result and 0) equals "invalid-parameter"):
        return 12
    display "PASS: Gmail fixed-origin owned-mailbox routes, exact scopes, encoded repeated queries, malformed arguments, destructive/send effects and lossless history cursor. No network or mailbox mutation."
    return 0
