import "../../app/mail/sync_worker"

define main returning Int:
    set path to ptr_to_str(get_env("ECHO_MAIL_TEST_DB"))
    if string_length(path) equals 0:
        return 1
    set database to archive_open(path)
    if sql_execute(database and "CREATE TABLE echo_mail_accounts(identity TEXT PRIMARY KEY,principal TEXT,state TEXT); INSERT INTO echo_mail_accounts VALUES('mail','owner','connected'); CREATE TABLE echo_principals(identity TEXT PRIMARY KEY,role TEXT,revoked INTEGER); INSERT INTO echo_principals VALUES('owner','admin',0),('guest','user',0);") is not equal to 0 or else gmail_sync_schema(database) is not equal to 0:
        return 2
    set profile_plan to gmail_sync_next(database and "mail")
    set profile to local_json_result("ready" and 200 and "{\"emailAddress\":\"Echo.Ernos.Smith@gmail.com\",\"historyId\":\"9223372036854775811\"}")
    if not (gmail_sync_apply_response(database and "mail" and profile_plan and profile) equals "started"):
        return 3
    if gmail_owner_active(database and database and "mail" and "owner") equals 0 or else gmail_owner_active(database and database and "mail" and "guest") is not equal to 0:
        return 22
    set denied to gmail_read_account(database and database and "fixture" and "not-a-read" and "mail" and "owner" and "messages.send" and "{}" and 1000 and 0 and -1 and -1 and "" and -1 and -1)
    if not (archive_list_text(denied and 0) equals "read-operation-required"):
        return 23
    set first_page to "{\"messages\":[{\"id\":\"a\"},{\"id\":\"b\"},{\"id\":\"d\"}],\"nextPageToken\":\"page-two\"}"
    if not (gmail_sync_stage(database and "mail" and "1" and "full" and "" and first_page) equals "staged") or else not (gmail_sync_advance(database and "mail" and "1" and "full" and "") equals "messages-pending"):
        return 4
    if not (gmail_sync_message(database and "mail" and "1" and "full" and "" and "a" and 200 and "{\"id\":\"a\",\"labelIds\":[\"INBOX\"]}") equals "stored") or else not (gmail_sync_message(database and "mail" and "1" and "full" and "" and "b" and 503 and "offline") equals "fetch-not-complete"):
        return 5
    set closed to sql_close(database)
    set database to archive_open(path)
    set next to gmail_sync_next(database and "mail")
    if not (archive_list_text(next and 1) equals "messages.get") or else not (archive_list_text(next and 2) equals "{\"id\":\"b\",\"format\":\"full\"}"):
        return 6
    if not (gmail_sync_message(database and "mail" and "1" and "full" and "" and "b" and 404 and "{\"error\":\"not found\"}") equals "stored") or else not (gmail_sync_message(database and "mail" and "1" and "full" and "" and "d" and 200 and "{\"id\":\"d\",\"snippet\":\"Retain this original\"}") equals "stored") or else not (gmail_sync_stage(database and "mail" and "1" and "full" and "" and first_page) equals "staged"):
        return 7
    if not (gmail_sync_advance(database and "mail" and "1" and "full" and "") equals "full") or else not (gmail_sync_stage(database and "mail" and "1" and "full" and "page-two" and "{\"messages\":[{\"id\":\"c\"}]}") equals "staged"):
        return 8
    if not (gmail_sync_message(database and "mail" and "1" and "full" and "page-two" and "c" and 200 and "{\"id\":\"c\"}") equals "stored") or else not (gmail_sync_advance(database and "mail" and "1" and "full" and "page-two") equals "history"):
        return 9
    set history to "{\"historyId\":\"9223372036854775820\",\"nextPageToken\":\"h2\",\"history\":[{\"id\":\"9223372036854775812\",\"labelsAdded\":[{\"message\":{\"id\":\"a\"},\"labelIds\":[\"STARRED\"]}]}]}"
    if not (gmail_sync_stage(database and "mail" and "1" and "history" and "" and history) equals "staged"):
        return 10
    if not (gmail_sync_message(database and "mail" and "1" and "full" and "" and "a" and 200 and "{\"id\":\"a\"}") equals "stale-message-result"):
        return 11
    set state to gmail_sync_state(database and "mail")
    if not (archive_list_text(state and 3) equals "9223372036854775811"):
        return 12
    if not (gmail_sync_message(database and "mail" and "1" and "history" and "" and "a" and 200 and "{\"id\":\"a\",\"labelIds\":[\"INBOX\",\"STARRED\"]}") equals "stored") or else not (gmail_sync_advance(database and "mail" and "1" and "history" and "") equals "history"):
        return 13
    set history to "{\"historyId\":\"9223372036854775830\",\"history\":[{\"id\":\"9223372036854775829\",\"messagesDeleted\":[{\"message\":{\"id\":\"c\"}}]}]}"
    if not (gmail_sync_stage(database and "mail" and "1" and "history" and "h2" and history) equals "staged") or else not (gmail_sync_message(database and "mail" and "1" and "history" and "h2" and "c" and 404 and "{}") equals "stored") or else not (gmail_sync_advance(database and "mail" and "1" and "history" and "h2") equals "idle"):
        return 14
    set state to gmail_sync_state(database and "mail")
    if not (archive_list_text(state and 3) equals "9223372036854775830"):
        return 15
    if not (gmail_sync_poll(database and "mail") equals "scheduled") or else not (gmail_sync_history_expired(database and "mail" and "2" and "") equals "full-required"):
        return 16
    set next to gmail_sync_next(database and "mail")
    if not (archive_list_text(next and 1) equals "getProfile"):
        return 17
    if not (gmail_sync_begin(database and "mail" and "9223372036854775900") equals "started") or else not (gmail_sync_stage(database and "mail" and "3" and "full" and "" and "{\"messages\":[{\"id\":\"a\"}]}") equals "staged"):
        return 18
    if not (gmail_sync_message(database and "mail" and "3" and "full" and "" and "a" and 200 and "{\"id\":\"a\",\"labelIds\":[\"STARRED\"]}") equals "stored") or else not (gmail_sync_advance(database and "mail" and "3" and "full" and "") equals "history"):
        return 19
    if not (gmail_sync_stage(database and "mail" and "3" and "history" and "" and "{\"historyId\":\"9223372036854775899\"}") equals "regressed-history-cursor"):
        return 20
    if not (gmail_sync_stage(database and "mail" and "3" and "history" and "" and "{\"historyId\":\"9223372036854775905\"}") equals "staged") or else not (gmail_sync_advance(database and "mail" and "3" and "history" and "") equals "idle"):
        return 21
    set idle to gmail_sync_step(database and database and "fixture" and "idle-step" and "mail" and "owner" and 1000 and 0 and -1 and -1 and "" and -1 and -1)
    if not (archive_list_text(idle and 0) equals "idle"):
        return 24
    set revoked to sql_execute(database and "UPDATE echo_principals SET revoked=1 WHERE identity='owner';")
    set denied to gmail_sync_step(database and database and "fixture" and "revoked-step" and "mail" and "owner" and 1000 and 0 and -1 and -1 and "" and -1 and -1)
    if not (archive_list_text(denied and 0) equals "mailbox-not-authorized"):
        return 25
    set closed to sql_close(database)
    display "PASS: full/history pagination, restart continuation, incomplete fetch preservation, late-response rejection, final-page cursor commit and expired-history full rescan with retained originals."
    return 0
