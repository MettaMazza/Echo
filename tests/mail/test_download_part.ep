import "../../app/mail/download_part"

define main returning Int:
    set source to "{\"id\":\"m1\",\"payload\":{\"partId\":\"\",\"parts\":[{\"partId\":\"0\",\"parts\":[{\"partId\":\"0.1\",\"filename\":\"résumé.bin\",\"mimeType\":\"application/octet-stream\",\"body\":{\"size\":4,\"attachmentId\":\"a1\"}}]}]}}"
    set part to gmail_download_part(source and "m1" and "0.1")
    if not (archive_list_text(part and 0) equals "selected") or else not (archive_list_text(part and 1) equals "résumé.bin") or else not (archive_list_text(part and 4) equals "a1"):
        return 1
    if not (archive_list_text(gmail_download_part(source and "other" and "0.1") and 0) equals "attachment-source-mismatch"):
        return 2
    if not (archive_list_text(gmail_download_part(source and "m1" and "0") and 0) equals "message-part-is-container"):
        return 3
    if not (archive_list_text(gmail_download_part(source and "m1" and "1") and 0) equals "message-part-not-found"):
        return 4
    set duplicate to "{\"id\":\"m1\",\"payload\":{\"partId\":\"0\",\"parts\":[{\"partId\":\"0\"}]}}"
    if not (archive_list_text(gmail_download_part(duplicate and "m1" and "0") and 0) equals "ambiguous-message-part"):
        return 5
    set inline_part to gmail_download_part("{\"id\":\"m1\",\"payload\":{\"partId\":\"\",\"body\":{\"size\":4,\"data\":\"AAH-_w\"}}}" and "m1" and "")
    if not (archive_list_text(inline_part and 0) equals "selected") or else not (archive_list_text(inline_part and 5) equals "AAH-_w"):
        return 6
    if not (archive_list_text(gmail_download_data("{\"size\":4,\"data\":\"AAH-_w\"}" and "4") and 0) equals "ready") or else archive_list_text(gmail_download_data("{\"size\":3,\"data\":\"AAH-_w\"}" and "4") and 0) equals "ready":
        return 7
    display "download part selection passed"
    return 0
