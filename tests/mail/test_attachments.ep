import "os"
import "../../app/mail/attachments"

define main returning Int:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to ptr_to_str(get_env("ECHO_MAIL_ATTACHMENT_ROOT"))
    set directory to workspace_root_open(system and root)
    set saved to gmail_attachment_store(system and directory and root and "mail/message/attachment" and "AAH-_w" and 4)
    if not (archive_list_text(saved and 0) equals "stored"):
        display archive_list_text(saved and 0)
        return 1
    set repeated to gmail_attachment_store(system and directory and root and "mail/message/attachment" and "AAH-_w==" and 4)
    if not (archive_list_text(repeated and 0) equals "stored") or else not (archive_list_text(saved and 2) equals archive_list_text(repeated and 2)):
        return 2
    set changed to gmail_attachment_store(system and directory and root and "mail/message/attachment" and "AAH-AA" and 4)
    if not (archive_list_text(changed and 0) equals "attachment-content-conflict"):
        return 3
    set wrong to gmail_attachment_store(system and directory and root and "mail/other" and "AAH-_w" and 3)
    if not (archive_list_text(wrong and 0) equals "attachment-size-or-encoding-mismatch"):
        return 4
    set empty to gmail_attachment_store(system and directory and root and "mail/empty" and "" and 0)
    if not (archive_list_text(empty and 0) equals "stored"):
        return 5
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    display "PASS: private binary attachment write, exact padded/unpadded retry, conflicting-content rejection, size validation and empty attachment."
    return 0
