import "../../app/mail/policy"

define main returning Int:
    set body to "{\"raw\":\"exact-reviewed-message\"}"
    set digest to gmail_action_digest("messages.send" and "{}" and body)
    set grant to concat("{\"owner\":\"owner\",\"account\":\"account\",\"actions\":[{\"intent\":\"intent\",\"operation\":\"messages.send\",\"parameters\":\"{}\",\"body\":" and concat(provider_quote(body) and concat(",\"sha256\":" and concat(provider_quote(digest) and "}]}"))))
    if gmail_policy_action(grant and "owner" and "account" and "intent" and "messages.send" and "{}" and body) is not equal to 1:
        return 1
    if gmail_policy_action(grant and "other" and "account" and "intent" and "messages.send" and "{}" and body) is not equal to 0 or else gmail_policy_action(grant and "owner" and "other" and "intent" and "messages.send" and "{}" and body) is not equal to 0 or else gmail_policy_action(grant and "owner" and "account" and "other" and "messages.send" and "{}" and body) is not equal to 0:
        return 2
    if gmail_policy_action(grant and "owner" and "account" and "intent" and "drafts.send" and "{}" and body) is not equal to 0 or else gmail_policy_action(grant and "owner" and "account" and "intent" and "messages.send" and "{\"id\":\"changed\"}" and body) is not equal to 0 or else gmail_policy_action(grant and "owner" and "account" and "intent" and "messages.send" and "{}" and concat(body and " ")) is not equal to 0:
        return 3
    if gmail_policy_action("{\"approved\":true}" and "owner" and "account" and "intent" and "messages.send" and "{}" and body) is not equal to 0:
        return 4
    display "PASS: policy binds owner, account, intent, operation, parameters and exact payload; caller approval is not a grant."
    return 0
