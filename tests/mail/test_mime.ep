import "fs"
import "os"
import "../../app/mail/mime"

define main returning Int:
    set decoded to gmail_base64_decode("AAH-_w" and 1)
    if not (archive_list_text(decoded and 0) equals "decoded") or else get_list(decoded and 2) is not equal to 4:
        return 1
    set storage to get_list(decoded and 1)
    set pointer to get_list_data_ptr(storage)
    if peek_byte(pointer and 0) is not equal to 0 or else peek_byte(pointer and 1) is not equal to 1 or else peek_byte(pointer and 2) is not equal to 254 or else peek_byte(pointer and 3) is not equal to 255 or else not (gmail_base64_bytes(pointer and 4) equals "AAH+/w=="):
        return 2
    for each invalid in ["A","AB","AA=","AA===","AAH+/w==","AA H-_w","AAH-_x"]:
        set parsed to gmail_base64_decode(ptr_to_str(invalid) and 1)
        if archive_list_text(parsed and 0) equals "decoded":
            return 3
    set empty to create_list()
    set subject to "Réponse 🌍 — a long subject preserving every UTF-8 character across encoded-word boundaries without loss"
    set name to "résumé 🌍 'quoted' \"file\" with a long filename to verify RFC2231 continuations.bin"
    set result to gmail_mime_compose("fixture-message" and "Wed, 28 Oct 2026 12:00:00 +0000" and ["recipient@example.com"] and ["copy@example.com"] and ["private@example.com"] and subject and "First line\nSecond 🌍 line\n" and 0 and ["<first@example.com>","<parent@example.com>"] and [[name,"application/octet-stream","AAH+/w=="]])
    if not (archive_list_text(result and 0) equals "composed"):
        display archive_list_text(result and 0)
        return 4
    if write_file(ptr_to_str(get_env("ECHO_MAIL_MIME_OUTPUT")) and archive_list_text(result and 1)) is not equal to 1:
        return 5
    set encoded to gmail_base64url(archive_list_text(result and 1))
    set restored to gmail_base64_decode(encoded and 1)
    if not (archive_list_text(restored and 0) equals "decoded") or else get_list(restored and 2) is not equal to string_length(archive_list_text(result and 1)):
        return 6
    set bad to gmail_mime_compose("fixture" and "date" and ["recipient@example.com"] and empty and empty and "subject\r\nBcc: injected@example.com" and "body" and 0 and empty and empty)
    if not (archive_list_text(bad and 0) equals "invalid-message"):
        return 7
    set bad to gmail_mime_compose("fixture" and "date" and ["recipient@example.com\r\nCc: injected@example.com"] and empty and empty and "subject" and "body" and 0 and empty and empty)
    if not (archive_list_text(bad and 0) equals "invalid-canonical-address"):
        return 8
    display "PASS: canonical binary/base64url round trip, malformed encodings, MIME construction, stable message identity and header-injection refusal. Inspect emitted MIME with an independent parser."
    return 0
