import "../../app/mail/response"

define fixture_response with system as Int and wire as Str and method as Str and allow_empty as Int returning List:
    set pair to external_transport_pair(system)
    set sent to socket_write_all(system and get_list(pair and 1) and -1 and str_to_ptr(wire) and string_length(wire))
    set closed to net_close(get_list(pair and 1))
    set reader to http_stream_create(system and get_list(pair and 0) and -1)
    set result to gmail_response_body(reader and method and allow_empty)
    set released to http_stream_release(reader)
    set closed to net_close(get_list(pair and 0))
    return result

define main returning Int:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set result to fixture_response(system and "HTTP/1.1 204 No Content\r\n\r\n" and "DELETE" and 1)
    if not (archive_list_text(result and 0) equals "ready") or else get_list(result and 1) is not equal to 204:
        return 1
    set result to fixture_response(system and "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n" and "POST" and 1)
    if not (archive_list_text(result and 0) equals "ready"):
        return 2
    set result to fixture_response(system and "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n" and "GET" and 0)
    if not (archive_list_text(result and 0) equals "invalid-json"):
        return 3
    set body to "{\"id\":\"fixture\"}"
    set wire to concat("HTTP/1.1 201 Created\r\nContent-Length: " and concat(int_to_string(string_length(body)) and concat("\r\n\r\n" and body)))
    set result to fixture_response(system and wire and "POST" and 0)
    if not (archive_list_text(result and 0) equals "ready") or else not (archive_list_text(result and 2) equals body):
        return 4
    set body to "{\"error\":\"invalid_grant\"}"
    set wire to concat("HTTP/1.1 400 Bad Request\r\nContent-Length: " and concat(int_to_string(string_length(body)) and concat("\r\n\r\n" and body)))
    set result to fixture_response(system and wire and "POST" and 0)
    if not (archive_list_text(result and 0) equals "http-error") or else not (archive_list_text(result and 2) equals body):
        return 5
    set result to fixture_response(system and "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\noops" and "GET" and 0)
    if not (archive_list_text(result and 0) equals "invalid-json"):
        return 6
    set result to fixture_response(system and "HTTP/1.1 204 No Content\r\n\r\n" and "POST" and 0)
    if not (archive_list_text(result and 0) equals "ready"):
        return 7
    set closed to ep_dlclose(system)
    display "PASS: Gmail 204 mutation, empty revocation, JSON-required reads, 201 JSON success, OAuth error preservation and malformed payload rejection over native socket pairs."
    return 0
