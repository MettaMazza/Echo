import "../../app/mail/reply"

define main returning Int:
    set parsed to gmail_header_addresses("\"Family, Alex\" <alex@example.com>, Team: echo.ernos.smith@gmail.com, Bea (team (lead)) <bea@example.com>;")
    if not (archive_list_text(parsed and 0) equals "parsed") or else length_list(parsed) is not equal to 4 or else not (archive_list_text(parsed and 1) equals "alex@example.com") or else not (archive_list_text(parsed and 3) equals "bea@example.com"):
        return 1
    for each header in ["bad@example.com <good@example.com>","Good <one@example.com> <two@example.com>","group: a@example.com","bad@example.com: a@example.com;","a@example.com\r\nBcc: secret@example.com"]:
        if archive_list_text(gmail_header_addresses(ptr_to_str(header)) and 0) equals "parsed":
            return 2
    set folded to gmail_header_addresses("Alex <alex@example.com>,\r\n\tBea <bea@example.com>")
    if not (archive_list_text(folded and 0) equals "parsed") or else length_list(folded) is not equal to 3:
        return 3
    set source to "{\"id\":\"message\",\"threadId\":\"thread\",\"payload\":{\"headers\":[{\"name\":\"From\",\"value\":\"Original <original@example.com>\"},{\"name\":\"Reply-To\",\"value\":\"\"},{\"name\":\"To\",\"value\":\"echo.ernos.smith@gmail.com, Bea <bea@example.com>\"},{\"name\":\"Cc\",\"value\":\"bea@example.com, alex@example.com\"},{\"name\":\"Message-ID\",\"value\":\"<current@example.com>\"},{\"name\":\"References\",\"value\":\"<first@example.com> <prior@example.com>\"}]}}"
    set source to ptr_to_str(string_replace(source and "\"name\":\"Reply-To\",\"value\":\"\"" and "\"name\":\"Reply-To\",\"value\":\"Alex <alex@example.com>\""))
    set plan to gmail_reply_plan(source and 1)
    set tokens to provider_json_tokens(plan)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "planned"):
        display plan
        return 4
    set recipients_to to provider_items(tokens and provider_member(tokens and 0 and "to"))
    set cc to provider_items(tokens and provider_member(tokens and 0 and "cc"))
    set references to provider_items(tokens and provider_member(tokens and 0 and "references"))
    if length_list(recipients_to) is not equal to 1 or else not (provider_value(tokens and get_list(recipients_to and 0)) equals "alex@example.com") or else length_list(cc) is not equal to 1 or else not (provider_value(tokens and get_list(cc and 0)) equals "bea@example.com") or else length_list(references) is not equal to 3:
        display plan
        return 5
    set single to provider_json_tokens(gmail_reply_plan(source and 0))
    if length_list(provider_items(single and provider_member(single and 0 and "cc"))) is not equal to 0:
        return 6
    set own_source to ptr_to_str(string_replace(source and "Alex <alex@example.com>" and "Echo <echo.ernos.smith@gmail.com>"))
    set own_source to ptr_to_str(string_replace(own_source and "Original <original@example.com>" and "Echo <echo.ernos.smith@gmail.com>"))
    set own to provider_json_tokens(gmail_reply_plan(own_source and 0))
    set own_to to provider_items(own and provider_member(own and 0 and "to"))
    if length_list(own_to) is not equal to 1 or else not (provider_value(own and get_list(own_to and 0)) equals "bea@example.com"):
        return 7
    display "PASS: reply source resolution preserves Reply-To, reply-all recipients and reference chain; excludes Echo and duplicates; rejects ambiguous addresses and header injection."
    return 0
