import "../../app/mail/standing"

define main returning Int:
    set policy to "{\"terms\":\"Fixture terms only\",\"recipient_scope\":\"listed\",\"recipients\":[\"recipient@example.com\"],\"allow_attachments\":false,\"max_payload_bytes\":1000,\"expires_at\":200}"
    set preview to "{\"to\":[\"recipient@example.com\"],\"cc\":[],\"bcc\":[],\"attachment_count\":0}"
    if gmail_standing_valid(policy) is not equal to 1 or else gmail_standing_allows(policy and preview and 1000 and 100) is not equal to 1:
        return 1
    if gmail_standing_allows(policy and preview and 1001 and 100) is not equal to 0 or else gmail_standing_allows(policy and preview and 100 and 200) is not equal to 0:
        return 2
    for each changed in ["{\"to\":[\"other@example.com\"],\"cc\":[],\"bcc\":[],\"attachment_count\":0}","{\"to\":[\"recipient@example.com\"],\"cc\":[],\"bcc\":[\"other@example.com\"],\"attachment_count\":0}","{\"to\":[\"recipient@example.com\"],\"cc\":[],\"bcc\":[],\"attachment_count\":1}","{\"to\":[],\"cc\":[],\"bcc\":[],\"attachment_count\":0}"]:
        if gmail_standing_allows(policy and ptr_to_str(changed) and 100 and 100) is not equal to 0:
            return 3
    set unrestricted to "{\"terms\":\"Fixture terms only\",\"recipient_scope\":\"any\",\"recipients\":[],\"allow_attachments\":true,\"max_payload_bytes\":1000,\"expires_at\":0}"
    if gmail_standing_allows(unrestricted and "{\"to\":[\"other@example.com\"],\"cc\":[],\"bcc\":[],\"attachment_count\":1}" and 100 and 99999999) is not equal to 1:
        return 4
    if gmail_standing_valid("{\"approved\":true}") is not equal to 0 or else gmail_standing_valid(ptr_to_str(string_replace(policy and "\"max_payload_bytes\":1000" and "\"max_payload_bytes\":-1"))) is not equal to 0 or else gmail_standing_valid(ptr_to_str(string_replace(policy and "Fixture terms only" and ""))) is not equal to 0:
        return 5
    set digest to ep_sha256(policy)
    set basis to concat("{\"category\":\"routine\",\"reason\":\"Fixture only\",\"policy_sha256\":" and concat(provider_quote(digest) and "}"))
    if gmail_standing_basis(basis and digest) is not equal to 1 or else gmail_standing_basis(basis and "changed") is not equal to 0 or else gmail_standing_basis(ptr_to_str(string_replace(basis and "routine" and "protected")) and digest) is not equal to 0 or else gmail_standing_basis(ptr_to_str(string_replace(basis and "routine" and "consequential")) and digest) is not equal to 0:
        return 6
    display "PASS: standing scope binds all recipient fields, attachment permission, exact byte limit, expiry and explicit routine policy basis."
    return 0
