import "fs"
import "../../app/mail/composition_store"

define main returning Int:
    set root to ptr_to_str(get_env("ECHO_MAIL_COMPOSITION_TEST_ROOT"))
    if string_length(root) equals 0:
        return 1
    set spec to "{\"to\":[\"recipient@example.com\"],\"subject\":\"Unicode caf\\u00e9 \\ud83c\\udf0d\",\"body\":\"New body \\ud83c\\udf0d\",\"attachments\":[]}"
    set source to "{\"id\":\"original\",\"threadId\":\"thread\",\"payload\":{\"headers\":[{\"name\":\"From\",\"value\":\"Author <author@example.com>\"},{\"name\":\"To\",\"value\":\"Echo <echo.ernos.smith@gmail.com>\"},{\"name\":\"Subject\",\"value\":\"=?UTF-8?B?UsOpcG9uc2U=?=\"},{\"name\":\"Message-ID\",\"value\":\"<original@example.com>\"}]}}"
    set forwarded to "{\"id\":\"original\",\"raw\":\"RnJvbTogQXV0aG9yIDxhdXRob3JAZXhhbXBsZS5jb20-_DQo\"}"
    set files to [["binary.bin","application/octet-stream","AAH+/w=="]]
    set date to "28 Oct 2026 12:00:00 +0000"
    set composed to gmail_composition_build("intent" and date and spec and "" and files)
    if not (archive_list_text(composed and 0) equals "composed") or else write_file(concat(root and "/new.eml") and archive_list_text(composed and 5)) is not equal to 1:
        return 2
    set reply to gmail_composition_build("reply-intent" and date and "{\"mode\":\"reply\",\"source_id\":\"original\",\"body\":\"Reply body\"}" and source and create_list())
    if not (archive_list_text(reply and 0) equals "composed") or else not (archive_list_text(reply and 3) equals "thread") or else write_file(concat(root and "/reply.eml") and archive_list_text(reply and 5)) is not equal to 1:
        display archive_list_text(reply and 0)
        return 3
    set forward to gmail_composition_build("forward-intent" and date and "{\"mode\":\"forward\",\"source_id\":\"original\",\"to\":[\"recipient@example.com\"],\"subject\":\"Forwarded original\",\"body\":\"See original\"}" and forwarded and files)
    if not (archive_list_text(forward and 0) equals "composed") or else length_list(files) is not equal to 1 or else write_file(concat(root and "/forward.eml") and archive_list_text(forward and 5)) is not equal to 1:
        return 4
    set mismatch to gmail_composition_build("bad" and date and "{\"mode\":\"reply\",\"source_id\":\"different\",\"body\":\"body\"}" and source and create_list())
    if not (archive_list_text(mismatch and 0) equals "composition-source-mismatch"):
        return 5
    set database to archive_open(concat(root and "/compositions.sqlite"))
    if gmail_outbox_schema(database) is not equal to 0 or else gmail_composition_schema(database) is not equal to 0:
        return 6
    set saved to gmail_composition_save(database and "account" and "intent" and spec and "" and date and "[]" and composed)
    if not (archive_list_text(saved and 0) equals "prepared"):
        return 7
    set closed to sql_close(database)
    set database to archive_open(concat(root and "/compositions.sqlite"))
    set restored to gmail_composition_load(database and "account" and "intent" and spec)
    if not (archive_list_text(restored and 0) equals "prepared") or else not (archive_list_text(restored and 1) equals archive_list_text(composed and 1)) or else not (archive_list_text(gmail_composition_load(database and "account" and "intent" and "{}") and 0) equals "composition-identity-conflict"):
        return 8
    set state to history_collect_one(archive_prepare(database and "SELECT state FROM echo_mail_delivery;"))
    if not (archive_list_text(state and 1) equals "ready"):
        return 9
    set closed to sql_close(database)
    display "PASS: compose/reply/forward MIME, binary attachments, source binding, original subject/thread preservation and restart-stable prepared bytes; no send."
    return 0
