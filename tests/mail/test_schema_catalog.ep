import "../../app/mail/schema_catalog"

define main returning Int:
    set body to gmail_request_schema_catalog("drafts.create")
    set tokens to provider_json_tokens(body)
    set schemas to provider_member(tokens and 0 and "schemas")
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "root")) equals "Draft") or else provider_member(tokens and schemas and "Draft") < 0 or else provider_member(tokens and schemas and "Message") < 0 or else provider_member(tokens and schemas and "MessagePart") < 0 or else provider_member(tokens and schemas and "MessagePartBody") < 0:
        return 1
    if not (gmail_request_schema_catalog("messages.list") equals "null"):
        return 2
    set labels to provider_json_tokens(gmail_request_schema_catalog("labels.create"))
    set schemas to provider_member(labels and 0 and "schemas")
    if provider_member(labels and schemas and "Label") < 0 or else provider_member(labels and schemas and "LabelColor") < 0:
        return 3
    set described to provider_json_tokens(gmail_described_method("drafts.create"))
    if not (provider_value(described and provider_member(described and 0 and "status")) equals "ready") or else not (provider_kind(described and provider_member(described and 0 and "request_schema")) equals "{"):
        return 4
    display "PASS: method lookup returns the complete finite request-schema graph, including recursive MIME references."
    return 0
