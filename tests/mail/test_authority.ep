import "../../app/mail/authority"
import "../../app/web/run_store"
import "../../app/jobs/delegation_schema"

define gmail_fixture_queue with database as Int and run as Str and call_id as Str and name as Str returning Int:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT session FROM echo_runs WHERE run=?1;" and [run]))
    set session to archive_list_text(row and 1)
    set identity to concat(run and concat(":" and call_id))
    set payload to concat("{\"run_id\":" and concat(provider_quote(run) and concat(",\"call_id\":" and provider_quote(call_id))))
    set payload to concat(payload and concat(",\"name\":" and concat(provider_quote(name) and ",\"arguments\":\"{}\"}")))
    if archive_append(database and session and identity and "tool_call" and payload and "fixture") is not equal to 0:
        return 1
    return tool_ledger_queue(database and run and call_id and session and identity)

define main returning Int:
    set path to ptr_to_str(get_env("ECHO_MAIL_TEST_DB"))
    if string_length(path) equals 0:
        return 1
    set database to archive_open(path)
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["admin","guest"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Fixture") equals "recorded"):
        return 4
    set own to web_submit_owned(database and "admin" and "own" and "" and "Read Echo's mailbox")
    set guest to web_submit_owned(database and "guest" and "guest" and "" and "Read Echo's mailbox")
    if gmail_fixture_queue(database and "own" and "mail" and "mailbox") is not equal to 0 or else gmail_fixture_queue(database and "guest" and "mail" and "mailbox") is not equal to 0:
        return 5
    if not (gmail_tool_owner(database and "own" and "mail") equals "device:admin") or else string_length(gmail_tool_owner(database and "guest" and "mail")) > 0:
        return 6
    if gmail_fixture_queue(database and "own" and "different" and "history_read") is not equal to 0 or else string_length(gmail_tool_owner(database and "own" and "different")) > 0:
        return 7
    if not (principal_host_role(database and "grant-other" and "device:guest" and "admin" and "Fixture") equals "recorded") or else string_length(gmail_tool_owner(database and "guest" and "mail")) > 0:
        return 8
    if not (group_create(database and "admin" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "admin" and "invite" and "g" and "device:guest" and "invited" and 1) equals "recorded") or else not (group_change(database and "guest" and "join" and "g" and "device:guest" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "admin" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created") or else not (group_run_submit(database and "admin" and "shared-run" and "shared" and "browser" and "local" and "g" and "Two admins") equals "accepted"):
        return 9
    if gmail_fixture_queue(database and "shared-run" and "mail" and "mailbox") is not equal to 0 or else string_length(gmail_tool_owner(database and "shared-run" and "mail")) > 0:
        return 10
    if not (principal_host_revocation(database and "revoke" and "device:admin" and 1 and "Fixture") equals "recorded") or else string_length(gmail_tool_owner(database and "own" and "mail")) > 0:
        return 11
    display "PASS: private admin frozen call admitted; guest, later elevation, wrong handler, shared-admin audience and revoked identity denied."
    return sql_close(database)
