import "../../app/mail/request"
import "../../app/mail/transport"
import "../../app/mail/schema_catalog"

define main returning Int:
    set contacts to ["https://www.googleapis.com/auth/contacts.readonly"]
    set search to gmail_request_plan("people.searchContacts" and "{\"query\":\"María & Co\",\"pageSize\":30}" and "" and contacts)
    if not (archive_list_text(search and 0) equals "planned") or else string_index_of(archive_list_text(search and 2) and "query=Mar%C3%ADa%20%26%20Co") < 0 or else string_index_of(archive_list_text(search and 2) and "pageSize=30") < 0:
        return 1
    set all_contacts to gmail_request_plan("people.connections.list" and "{\"pageToken\":\"next/+?&\",\"pageSize\":1000}" and "" and contacts)
    if not (archive_list_text(all_contacts and 0) equals "planned") or else string_index_of(archive_list_text(all_contacts and 2) and "pageToken=next%2F%2B%3F%26") < 0:
        return 2
    if not (archive_list_text(gmail_request_plan("people.searchContacts" and "{\"query\":\"Maria\"}" and "" and ["https://www.googleapis.com/auth/gmail.modify"]) and 0) equals "contacts-scope-required"):
        return 3
    for each invalid in ["{}","{\"query\":3}","{\"query\":\"a\",\"query\":\"b\"}","{\"query\":\"a\",\"pageSize\":31}","{\"query\":\"a\",\"pageSize\":1.5}","{\"query\":\"a\",\"access_token\":\"x\"}","{\"query\":\"a\",\"pageToken\":\"x\"}"]:
        if archive_list_text(gmail_request_plan("people.searchContacts" and ptr_to_str(invalid) and "" and contacts) and 0) equals "planned":
            return 4
    for each invalid in ["{\"resourceName\":\"people/other\"}","{\"pageSize\":1001}","{\"pageSize\":0}","{\"pageToken\":false}","{\"personFields\":\"biographies\"}"]:
        if archive_list_text(gmail_request_plan("people.connections.list" and ptr_to_str(invalid) and "" and contacts) and 0) equals "planned":
            return 5
    if archive_list_text(gmail_request_plan("people.connections.list" and "{}" and "{}" and contacts) and 0) equals "planned":
        return 6
    set warm to gmail_request_plan("people.searchContacts" and "{\"query\":\"\"}" and "" and contacts)
    if not (archive_list_text(warm and 0) equals "planned") or else gmail_transport_arguments("GET" and archive_list_text(warm and 2) and "" and "application/json") equals 0:
        return 7
    if gmail_transport_arguments("POST" and archive_list_text(search and 2) and "" and "application/json") is not equal to 0 or else gmail_transport_arguments("GET" and archive_list_text(search and 2) and "/private/body" and "application/json") is not equal to 0:
        return 8
    for each invalid in ["https://people.googleapis.com.evil/v1/people:searchContacts?query=x","https://people.googleapis.com/v1/people/other/connections?x=1","https://people.googleapis.com/v1/people:createContact","https://example.com/"]:
        if gmail_transport_arguments("GET" and ptr_to_str(invalid) and "" and "application/json") is not equal to 0:
            return 9
    set described to provider_json_tokens(gmail_described_method("people.searchContacts"))
    if not (provider_value(described and provider_member(described and 0 and "status")) equals "ready"):
        return 10
    display "PASS: separate Contacts scope, exact read-only endpoints, UTF-8 search, pagination, warmup plan and recipient lookup descriptions."
    return 0
