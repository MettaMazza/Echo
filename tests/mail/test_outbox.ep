import "../../app/mail/outbox"

define main returning Int:
    set path to ptr_to_str(get_env("ECHO_MAIL_TEST_DB"))
    if string_length(path) equals 0:
        return 20
    set database to archive_open(path)
    if database equals 0 or else gmail_outbox_schema(database) is not equal to 0:
        return 1
    if not (gmail_outbox_prepare(database and "owner" and "intent" and "stable@example.com" and "exact RFC bytes") equals "prepared"):
        return 2
    if not (gmail_outbox_prepare(database and "owner" and "intent" and "stable@example.com" and "changed bytes") equals "intent-conflict") or else not (gmail_outbox_prepare(database and "owner" and "second" and "stable@example.com" and "exact RFC bytes") equals "message-id-conflict"):
        return 3
    set other to archive_open(path)
    set first to gmail_outbox_claim(database and "owner" and "intent")
    set second to gmail_outbox_claim(other and "owner" and "intent")
    if not (archive_list_text(first and 0) equals "claimed") or else not (archive_list_text(first and 2) equals "exact RFC bytes") or else not (archive_list_text(second and 0) equals "uncertain"):
        return 4
    set closed to sql_close(other)
    set closed to sql_close(database)
    set database to archive_open(path)
    set resumed to gmail_outbox_claim(database and "owner" and "intent")
    if not (archive_list_text(resumed and 0) equals "uncertain"):
        return 5
    if not (gmail_outbox_receipt(database and "foreign" and "intent" and "stable@example.com" and "remote" and "thread") equals "intent-mismatch") or else not (gmail_outbox_receipt(database and "owner" and "intent" and "wrong@example.com" and "remote" and "thread") equals "intent-mismatch"):
        return 6
    if not (gmail_outbox_receipt(database and "owner" and "intent" and "stable@example.com" and "remote" and "thread") equals "sent") or else not (gmail_outbox_receipt(database and "owner" and "intent" and "stable@example.com" and "remote" and "thread") equals "sent"):
        return 7
    if not (gmail_outbox_receipt(database and "owner" and "intent" and "stable@example.com" and "changed" and "thread") equals "receipt-conflict"):
        return 8
    set resumed to gmail_outbox_claim(database and "owner" and "intent")
    if not (archive_list_text(resumed and 0) equals "sent"):
        return 9
    set closed to sql_close(database)
    display "PASS: exact immutable intent, duplicate Message-ID refusal, competing connection claims, restart uncertainty, mailbox-bound reconciliation and no replay after receipt."
    return 0
