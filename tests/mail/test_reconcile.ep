import "../../app/mail/reconcile"

define main returning Int:
    set result to gmail_sent_identity("{\"id\":\"remote\",\"threadId\":\"thread\",\"labelIds\":[\"SENT\"],\"payload\":{\"headers\":[{\"name\":\"Message-ID\",\"value\":\"<intent@echo.local>\"},{\"name\":\"From\",\"value\":\"Echo <echo.ernos.smith@gmail.com>\"}]}}" and "intent@echo.local")
    if not (archive_list_text(result and 0) equals "matched"):
        display archive_list_text(result and 0)
        return 1
    set result to gmail_sent_identity("{\"id\":\"remote\",\"threadId\":\"thread\",\"labelIds\":[\"INBOX\"],\"payload\":{\"headers\":[{\"name\":\"Message-ID\",\"value\":\"<intent@echo.local>\"},{\"name\":\"From\",\"value\":\"Echo <echo.ernos.smith@gmail.com>\"}]}}" and "intent@echo.local")
    if not (archive_list_text(result and 0) equals "not-a-sent-message"):
        display archive_list_text(result and 0)
        return 2
    set result to gmail_sent_identity("{\"id\":\"\",\"threadId\":\"thread\",\"labelIds\":[\"SENT\"],\"payload\":{\"headers\":[{\"name\":\"Message-ID\",\"value\":\"<intent@echo.local>\"},{\"name\":\"From\",\"value\":\"Echo <echo.ernos.smith@gmail.com>\"}]}}" and "intent@echo.local")
    if not (archive_list_text(result and 0) equals "invalid-sent-message"):
        display archive_list_text(result and 0)
        return 3
    set result to gmail_sent_identity("{\"id\":\"remote\",\"threadId\":\"thread\",\"labelIds\":[\"SENT\"],\"payload\":{\"headers\":[{\"name\":\"Message-ID\",\"value\":\"<different@echo.local>\"},{\"name\":\"From\",\"value\":\"Echo <echo.ernos.smith@gmail.com>\"}]}}" and "intent@echo.local")
    if not (archive_list_text(result and 0) equals "sent-identity-mismatch"):
        display archive_list_text(result and 0)
        return 4
    set result to gmail_sent_identity("{\"id\":\"remote\",\"threadId\":\"thread\",\"labelIds\":[\"SENT\"],\"payload\":{\"headers\":[{\"name\":\"Message-ID\",\"value\":\"<intent@echo.local>\"},{\"name\":\"From\",\"value\":\"Echo <echo.ernos.smith@gmail.com>\"},{\"name\":\"Message-ID\",\"value\":\"<intent@echo.local>\"}]}}" and "intent@echo.local")
    if not (archive_list_text(result and 0) equals "sent-identity-mismatch"):
        display archive_list_text(result and 0)
        return 5
    set result to gmail_sent_identity("{\"id\":\"remote\",\"threadId\":\"thread\",\"labelIds\":[\"SENT\"],\"payload\":{\"headers\":[{\"name\":\"Message-ID\",\"value\":\"<intent@echo.local>\"},{\"name\":\"From\",\"value\":\"other@example.com\"}]}}" and "intent@echo.local")
    if not (archive_list_text(result and 0) equals "sent-sender-mismatch"):
        display archive_list_text(result and 0)
        return 6
    display "PASS: sent receipt requires the exact Message-ID, unique headers, Echo sender, SENT label and remote identifiers."
    return 0
