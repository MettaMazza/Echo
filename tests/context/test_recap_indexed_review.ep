import "../../app/context/recap_review"

define main returning Int:
    set sources to "{\"source_end\":\"two\",\"records\":[{\"event\":\"one\"},{\"event\":\"two\"}]}"
    set candidate to "Fixture candidate"
    set prefix to concat("{\"candidate_digest\":" and concat(provider_quote(ep_sha256(candidate)) and ",\"source_end\":\"two\","))
    set report to concat(prefix and "\"covered\":[0,1],\"issues\":[],\"findings\":[]}")
    set expanded to recap_review_expand(sources and report)
    if not (recap_review_validate(sources and candidate and expanded) equals "review-pass"):
        return 1
    if string_contains(expanded and "no individual explanation was emitted") equals 0:
        return 2
    for each wrong in ["[0]", "[0,0]", "[0,2]", "[-1,1]", "[0,1.0]"]:
        set invalid to ptr_to_str(string_replace(report and "[0,1]" and wrong))
        if not (recap_review_validate(sources and candidate and recap_review_expand(sources and invalid)) equals "invalid-review"):
            return 3
    set issue to concat(prefix and "\"covered\":[0],\"issues\":[{\"index\":1,\"verdict\":\"contradicted\",\"explanation\":\"The candidate reverses the correction.\"}],\"findings\":[]}")
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and issue)) equals "review-repair"):
        return 4
    set duplicate to ptr_to_str(string_replace(issue and "\"covered\":[0]" and "\"covered\":[0,1]"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and duplicate)) equals "invalid-review"):
        return 5
    if not (recap_review_validate(sources and "Changed candidate" and expanded) equals "invalid-review"):
        return 6
    set positional to concat(prefix and "\"verdicts\":[\"covered\",\"covered\"],\"issues\":[],\"findings\":[]}")
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and positional)) equals "review-pass"):
        return 7
    set missing to ptr_to_str(string_replace(positional and "[\"covered\",\"covered\"]" and "[\"covered\"]"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and missing)) equals "invalid-review"):
        return 8
    set defective to ptr_to_str(string_replace(positional and "[\"covered\",\"covered\"]" and "[\"covered\",\"omitted\"]"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and defective)) equals "invalid-review"):
        return 9
    set atomic to concat(prefix and "\"assessments\":[{\"verdict\":\"covered\",\"explanation\":\"\"},{\"verdict\":\"omitted\",\"explanation\":\"The user's correction is missing.\"}],\"findings\":[]}")
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and atomic)) equals "review-repair"):
        return 10
    set unsupported to ptr_to_str(string_replace(atomic and "The user's correction is missing." and ""))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and unsupported)) equals "invalid-review"):
        return 11
    set compact_report to concat(prefix and "\"assessments\":[\"covered\",\"covered\"],\"findings\":[]}")
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and compact_report)) equals "review-pass"):
        return 12
    set unsupported to ptr_to_str(string_replace(compact_report and "covered" and "omitted"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and unsupported)) equals "invalid-review"):
        return 13
    display "PASS: indexed coverage maps to exact source identities; gaps, duplicates, foreign/negative/fractional indices and changed candidates fail; defects require repair; generated coverage labels identify their origin."
    return 0
