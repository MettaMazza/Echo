import "../../app/context/checkpoint"
import "os"
import "fs"

# Run after test_checkpoint. Interrupt changes only its disposable database.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set mode to get_argument(2)
    if not file_exists(path):
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    if mode equals "interrupt":
        if sql_execute(database and "BEGIN IMMEDIATE; UPDATE echo_active_context SET checkpoint='candidate-a' WHERE session='home';") is not equal to 0:
            return 1
        # SIGKILL prevents normal shutdown and SQLite connection cleanup.
        set command to concat("kill -KILL " and int_to_string(get_pid()))
        set killed to run_command(command)
        display "FAIL: interruption did not terminate the process."
        return 1
    if not (mode equals "verify"):
        return 1
    set active to checkpoint_read_active(database and "home")
    if active equals 0:
        return 1
    if not (ptr_to_str(get_list(active and 0)) equals "candidate-c"):
        display "FAIL: unfinished activation replaced the committed context."
        return 1
    if archive_verify(database and "home") is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: committed checkpoint and original history recovered after SIGKILL during an unfinished context switch."
    return 0
