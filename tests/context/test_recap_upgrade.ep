import "../../app/context/compaction_resume"

define save_draft with database as Int and identity as Str and candidate as Str and contract as Str returning Int:
    set payload to concat("{\"source_end\":\"original\",\"candidate\":" and provider_quote(candidate))
    set payload to concat(payload and concat(",\"prompt_contract\":" and concat(provider_quote(contract) and "}")))
    return archive_append(database and "session" and identity and "recap_candidate" and payload and "fixture")

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "original" and "user" and "Remember café." and "fixture") is not equal to 0:
        return 2
    if save_draft(database and "job:old:candidate" and "{}" and "") is not equal to 0:
        return 3
    set saved to compaction_saved_candidate(database and "session" and "original" and "job")
    if not (archive_list_text(saved and 0) equals "no-candidate"):
        return 4
    if save_draft(database and "job:new:candidate" and "{}" and "source-bound-v1") is not equal to 0:
        return 5
    set saved to compaction_saved_candidate(database and "session" and "original" and "job")
    if not (archive_list_text(saved and 0) equals "structure-invalid"):
        return 6
    set candidate to "{\"source_end\":\"original\",\"summary\":\"Remember café.\",\"summary_sources\":[\"original\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    if save_draft(database and "valid:old:candidate" and candidate and "") is not equal to 0:
        return 7
    set saved to compaction_saved_candidate(database and "session" and "original" and "valid")
    if not (archive_list_text(saved and 0) equals "structure-valid"):
        return 8
    if archive_read_event(database and "job:old:candidate") equals 0:
        return 9
    set closed to sql_close(database)
    display "PASS: old invalid draft retained but retried under new contract; new invalid draft still checked; valid historical draft reused."
    return closed
