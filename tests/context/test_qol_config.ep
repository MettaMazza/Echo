import "../../app/context/qol_config"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set mode to get_argument(1)
    if mode equals "timeout":
        set start to ep_time_now_ms()
        set count to qol_token_count("a bounded token request")
        set elapsed to ep_time_now_ms() - start
        display elapsed
        if count is not equal to -1 or else elapsed > 1500:
            return 2
        return 0
    for each flag in ["me_file","recall_awareness","change_notices","disclaimer_flag"]:
        if qol_enabled(flag) is not equal to (mode equals flag):
            return 3
    display "PASS: independently controlled QoL flags."
    return 0
