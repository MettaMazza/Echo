import "../../app/context/recap_review"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 2
    if archive_append(database and "review-validation" and "objective" and "user" and "Review recorded sources and candidate without modifying production context." and "fixture") is not equal to 0:
        return 3
    set sources to ptr_to_str(read_file(get_argument(2)))
    set candidate to ptr_to_str(read_file(get_argument(3)))
    set profile to provider_llama_profile(get_argument(4) and 8080)
    set body to recap_structured_body(recap_review_body(get_argument(4) and sources and candidate) and profile and 1)
    set decision to provider_prepare(database and "review-validation" and "compaction:recorded-review:preflight" and profile and body and 2048 and -1 and 65536)
    if not (archive_list_text(decision and 0) equals "ready"):
        display archive_list_text(decision and 0)
        return 4
    set body to archive_list_text(decision and 5)
    set payload to concat("{\"request_body\":" and concat(provider_quote(body) and "}"))
    if archive_append(database and "review-validation" and "request" and "model_request" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
        return 5
    set response to local_chat_generate(database and "review-validation" and "request" and 8080 and "/v1/chat/completions" and body and -1 and 65536)
    if not (archive_list_text(response and 0) equals "complete"):
        return 6
    set state to get_list(response and 1)
    if get_list(state and 2) is not equal to 2:
        return 7
    set choice to chat_find(get_list(state and 0) and "0")
    if choice equals 0 or else length_list(get_list(choice and 3)) is not equal to 0:
        return 8
    set raw to archive_list_text(choice and 1)
    set report to recap_review_expand(sources and raw)
    set status to recap_review_validate(sources and candidate and report)
    set recorded to archive_append(database and "review-validation" and "result" and "review_validation" and concat("{\"status\":" and concat(provider_quote(status) and concat(",\"report\":" and concat(provider_quote(report) and "}")))) and concat("unix-ms:" and int_to_string(ep_time_now_ms())))
    display status
    if recorded is not equal to 0 or else not (status equals "review-pass"):
        return 9
    return sql_close(database)
