import "../../app/context/recap_review"
import "../../app/context/recap_fragment_review"

define main returning Int:
    set sources to "{\"source_end\":\"two\",\"records\":[{\"event\":\"one\"},{\"event\":\"two\"}]}"
    set candidate to "Fixture candidate"
    set prefix to concat("{\"candidate_digest\":" and concat(provider_quote(ep_sha256(candidate)) and ",\"source_end\":\"two\",\"assessments\":[\"covered\",\"covered\"],\"findings\":"))
    set positive to "[{\"status\":\"supported\",\"explanation\":\"The candidate correctly identifies pending work.\",\"correction\":\"\"}]"
    set report to concat(prefix and concat(positive and "}"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and report)) equals "review-pass"):
        return 1
    set defect to "[{\"status\":\"defect\",\"explanation\":\"Candidate invents file deletion.\",\"correction\":\"State that no file changed.\"}]"
    set report to concat(prefix and concat(defect and "}"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and report)) equals "review-repair"):
        return 2
    for each invalid in ["[{\"status\":\"supported\",\"explanation\":\"Covered\",\"correction\":\"Change it\"}]", "[{\"status\":\"defect\",\"explanation\":\"Missing fact\",\"correction\":\"\"}]", "[{\"status\":\"unknown\",\"explanation\":\"Unknown\",\"correction\":\"\"}]"]:
        set report to concat(prefix and concat(invalid and "}"))
        if not (recap_review_validate(sources and candidate and recap_review_expand(sources and report)) equals "invalid-review"):
            return 3
    set legacy to concat(prefix and "[\"Unsupported claim\"]}")
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and legacy)) equals "review-repair"):
        return 4
    set omitted to ptr_to_str(string_replace(concat(prefix and concat(positive and "}")) and "[\"covered\",\"covered\"]" and "[\"covered\",{\"verdict\":\"omitted\",\"explanation\":\"The correction is absent.\"}]"))
    if not (recap_review_validate(sources and candidate and recap_review_expand(sources and omitted)) equals "review-repair"):
        return 5
    set body to recap_structured_body(recap_review_body("fixture" and sources and candidate) and provider_llama_profile("fixture" and 8080) and 1)
    set scheduled to provider_scheduled_body("task:fixture" and "compaction:fixture:preflight" and body)
    if not (body equals scheduled) or else provider_unique_objects(provider_json_tokens(scheduled)) equals 0 or else string_contains(scheduled and "\"echo_background\":true") equals 0:
        return 6
    if string_contains(provider_scheduled_body("session:fixture" and "compaction:fixture:fragment" and "{}") and "\"echo_background\":true") equals 0:
        return 7
    if not (provider_scheduled_body("session:fixture" and "ordinary" and "{}") equals "{}"):
        return 8
    set fragment to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set fragment to concat(fragment and concat(",\"source_end\":\"two\",\"event\":\"one\",\"source_digest\":\"digest\",\"offset\":0,\"next_offset\":1,\"verdict\":\"covered\",\"explanation\":\"Covered\",\"findings\":" and concat(positive and "}")))
    if not (recap_fragment_review_validate(candidate and "two" and "one" and "digest" and 0 and 1 and fragment) equals "fragment-review-pass"):
        return 9
    display "PASS: positive findings do not rewrite; real defects and omissions still require repair; malformed findings rejected; legacy failures preserved; all compaction scheduling is background and idempotent."
    return 0
