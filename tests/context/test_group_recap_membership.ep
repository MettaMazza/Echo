import "../../app/security/group_speech"
import "../fixtures/runner_provider"
import "../fixtures/generation_fixture"
import "../../app/web/run_store"

define rebuild_provider_fixture with listener as List and objective as Str and completed as Int and start as Int and finish as Int and archive_path as Str returning Int:
    set state to create_list()
    set added to append_list(state and start)
    set added to append_list(state and "")
    # Start beyond the fixture's artificial capacity trigger: this test must
    # rebuild because of an explicit request while ordinary context still fits.
    set added to append_list(state and 1)
    set added to append_list(state and objective)
    set added to append_list(state and -12)
    set added to append_list(state and "")
    set added to append_list(state and "")
    set added to append_list(state and archive_path)
    set failures to 0
    repeat while get_list(state and 0) is less than finish or else (finish equals 2 and get_list(state and 2) is less than 4):
        set failures to failures + runner_fixture_exchange(listener and state)
    send failures to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if not (group_speech_schema(database) equals "applied"):
        return 2
    for each name in ["owner","other","outsider"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "owner" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "owner" and "invite-other" and "g" and "device:other" and "invited" and 1) equals "recorded") or else not (group_change(database and "other" and "join-other" and "g" and "device:other" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "owner" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 4
    set private_run to web_submit_owned(database and "owner" and "private" and "" and "PRIVATE_RECAP_CANARY_91507")
    set private_session to archive_list_text(private_run and 1)
    set session to "shared"
    if not (group_run_submit(database and "other" and "run" and session and "browser" and "local" and "g" and "Remember café.") equals "accepted"):
        return 5
    set row to agent_run_read(database and "run")
    set objective to ptr_to_str(get_list(row and 3))
    if not (recap_rebuild_enqueue(database and "run" and "unknown" and "{\"reason\":\"Recheck originals\"}") equals "{\"status\":\"not-authorized\"}"):
        return 1
    set listener to local_socket_listen(0)
    if agent_provider_bind(database and "run" and provider_llama_profile("fixture" and get_list(listener and 2))) is not equal to 0:
        return 1
    set data to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"rebuild\",\"function\":{\"name\":\"session_rebuild_recap\",\"arguments\":\"{\\\"reason\\\":\\\"Recheck the original request and preserve café.\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set generated_done to channel
    spawn generation_fixture(listener and data and generated_done)
    set generated to agent_generate_local(database and "run" and "request-tool" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 4096 and "0")
    set served to receive from generated_done
    if generated is not equal to 0 or else served is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0:
        return 1
    if not (recap_rebuild_pending(database and "run") equals "required") or else checkpoint_read_active(database and session) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set completed to channel
    set finish to 2
    set first_objective to concat(objective and "")
    spawn rebuild_provider_fixture(listener and first_objective and completed and 0 and finish and get_argument(1))
    set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096)
    display concat("Agent status: " and status)
    if not (status equals "not-authorized"):
        return 11
    set failures to receive from completed
    if failures is not equal to 0 or else checkpoint_read_active(database and session) is not equal to 0 or else checkpoint_read_active(database and private_session) is not equal to 0:
        return 12
    if not (recap_rebuild_pending(database and "run") equals "not-authorized"):
        return 13
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 14
    set database to archive_open(get_argument(1))
    if checkpoint_read_active(database and session) is not equal to 0 or else not (recap_rebuild_pending(database and "run") equals "not-authorized"):
        return 15
    set closed to local_socket_close(listener)
    set closed to sql_close(database)
    display "PASS: membership removed during activation preflight prevents shared checkpoint activation and remains denied after reopen. Scripted provider judgments."
    return 0
