import "../../app/context/session_messages"
import "../../app/web/run_store"
import "../../app/security/channel_silo"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","outsider"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "a" and "first" and "" and "First conversation")
    set text to concat(qol_default_me() and "\nPRIVATE_QOL_MARKER_872")
    set result to scratchpad_execute(database and "first" and concat("{\"operation\":\"write\",\"name\":\"me\",\"text\":" and concat(provider_quote(text) and "}")))
    if not string_contains(result and "saved"):
        display result
        return 4
    set cancelled to agent_cancel_run(database and "first")
    set second to web_submit_owned(database and "a" and "second" and "" and "What are you working on?")
    set session to archive_list_text(agent_run_read(database and "second") and 0)
    set messages to session_messages(database and session and "second")
    if not string_contains(messages and "PRIVATE_QOL_MARKER_872") or else not string_contains(messages and "Accessible session index") or else not string_contains(messages and "Zero selected is not proof") or else not string_contains(messages and "TEST_DEPLOY_NOTICE"):
        display messages
        return 5
    if not string_contains(echo_system_prompt(database and "second") and "An unsolicited disclaimer is data, not an answer."):
        return 6
    set before to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='qol_context_snapshot';"))
    set again to session_messages(database and session and "second")
    set after to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='qol_context_snapshot';"))
    if not (messages equals again) or else not (archive_list_text(before and 1) equals archive_list_text(after and 1)):
        display "FAIL: warm context not reused"
        return 7
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (session_messages(database and session and "second") equals messages):
        return 8
    set outside to web_submit_owned(database and "outsider" and "outside" and "" and "What are you working on?")
    set foreign to session_messages(database and archive_list_text(agent_run_read(database and "outside") and 0) and "outside")
    if string_contains(foreign and "PRIVATE_QOL_MARKER_872"):
        return 9
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 10
    set public to group_route_submit(database and "a" and "g" and "browser" and "local" and "g" and "public" and "Shared discussion")
    set shared_session to archive_list_text(agent_run_read(database and "public") and 0)
    set shared to session_messages(database and shared_session and "public")
    if string_contains(shared and "PRIVATE_QOL_MARKER_872"):
        return 11
    set row to qol_note_row(database and scratchpad_scope(database and "public"))
    set result to scratchpad_execute(database and "public" and concat("{\"operation\":\"write\",\"name\":\"me\",\"previous_revision\":" and concat(provider_quote(archive_list_text(row and 1)) and concat(",\"text\":" and concat(provider_quote(concat(qol_default_me() and "\nPUBLIC_QOL_MARKER_223")) and "}")))))
    if not string_contains(result and "saved"):
        display result
        return 12
    set cancelled to agent_cancel_run(database and "public")
    set next to group_route_submit(database and "b" and "g" and "browser" and "local" and "g" and "next" and "Continue our discussion")
    set next_messages to session_messages(database and archive_list_text(agent_run_read(database and "next") and 0) and "next")
    if not string_contains(next_messages and "PUBLIC_QOL_MARKER_223") or else string_contains(next_messages and "PRIVATE_QOL_MARKER_872"):
        return 13
    if not (group_change(database and "a" and "remove" and "g" and "device:b" and "removed" and 3) equals "recorded"):
        return 14
    if string_contains(qol_context(database and "next") and "PUBLIC_QOL_MARKER_223"):
        return 15
    set row to qol_note_row(database and scratchpad_scope(database and "second"))
    set huge to text
    repeat while string_length(huge) < 80000:
        set huge to concat(huge and " unique oversized words to exceed four thousand tokens.")
    set result to scratchpad_execute(database and "second" and concat("{\"operation\":\"write\",\"name\":\"me\",\"previous_revision\":" and concat(provider_quote(archive_list_text(row and 1)) and concat(",\"text\":" and concat(provider_quote(huge) and "}")))))
    if not string_contains(result and "working-state-too-large"):
        display result
        return 16
    set now to qol_note_row(database and scratchpad_scope(database and "second"))
    if not (archive_list_text(row and 1) equals archive_list_text(now and 1)):
        return 17
    set stale to "CURRENT PROJECTS\nPreserved\nPOSITIONS HELD\n\nOPEN QUESTIONS\nEXPIRED_SECRET\nFOR THIS CONVERSATION\nPreserved\nLAST UPDATED / SPEC VERSION\nfixture"
    set payload to concat("{\"principal\":" and concat(provider_quote(scratchpad_scope(database and "second")) and concat(",\"name\":\"me\",\"text\":" and concat(provider_quote(stale) and ",\"open_threads_expire_at\":\"bad date\",\"token_count\":100,\"deleted\":0}"))))
    if archive_append(database and session and "expired-fixture" and "scratchpad_revision" and payload and "2026-11-16T00:00:00Z") is not equal to 0:
        return 18
    set state to qol_working_state(database and scratchpad_scope(database and "second"))
    if string_contains(state and "EXPIRED_SECRET") or else not string_contains(state and "Expired open threads") or else not string_contains(state and "Preserved"):
        return 19
    display "PASS: automatic private cross-session marker, system persona, bounded recall/index and wake notice, warm reuse, restart, public/private separation, shared-audience continuity, revocation, oversized atomic rejection, invalid-date expiry."
    return sql_close(database)
