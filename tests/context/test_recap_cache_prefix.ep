import "../../app/context/recap_review"

define main returning Int:
    set sources to "{\"source_end\":\"last\",\"records\":[{\"event\":\"last\",\"original_payload\":\"Source with a tail marker: café 🪿\"}]}"
    set candidate to "Candidate one"
    set generated to recap_request_body("fixture" and sources)
    set reviewed to recap_review_body("fixture" and sources and candidate)
    set repair to concat("{\"original_sources\":" and concat(sources and ",\"previous_candidate\":\"Candidate one\",\"feedback\":\"missing fact\"}"))
    set repaired to recap_request_body("fixture" and repair)
    set reference to provider_json_tokens(generated)
    set reference_messages to provider_items(reference and provider_member(reference and 0 and "messages"))
    if length_list(reference_messages) is not equal to 3:
        return 1
    for each body in [generated, reviewed, repaired]:
        set tokens to provider_json_tokens(body)
        set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
        if length_list(messages) is not equal to 3:
            return 2
        set first to provider_value(tokens and provider_member(tokens and get_list(messages and 0) and "content"))
        set expected to provider_value(reference and provider_member(reference and get_list(reference_messages and 0) and "content"))
        if not (first equals expected):
            return 3
        set original to provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content"))
        if not (original equals sources):
            return 4
        set operation to provider_value(tokens and provider_member(tokens and get_list(messages and 2) and "content"))
        if string_contains(operation and "Original source count: 1. Zero-based source positions:\n0: last\n") equals 0:
            return 7
        if body equals reviewed and (string_contains(operation and ep_sha256(candidate)) equals 0 or else string_contains(operation and "Independently compare") equals 0):
            return 5
        if body equals repaired and (string_contains(operation and "missing fact") equals 0 or else string_contains(operation and candidate) equals 0):
            return 6
    display "PASS: identical complete source prefix across generation, independent review and repair; candidate digest and feedback retained; Unicode source bytes unchanged."
    return 0
