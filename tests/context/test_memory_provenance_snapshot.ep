import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() < 3:
        return 1
    set database to archive_open(get_argument(1))
    set run to get_argument(2)
    if database equals 0:
        return 2
    set original to memory_context(database and run)
    if string_contains(original and "Codex diagnostic automation") equals 0:
        return 3
    if memory_context_capture(database and run) is not equal to 0:
        return 4
    set frozen to memory_context_stable(database and run)
    if not (frozen equals original):
        return 5
    if memory_context_capture(database and run) is not equal to 0:
        return 6
    if not (memory_context_stable(database and run) equals original):
        return 7
    print frozen
    return 0
