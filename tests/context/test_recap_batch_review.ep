import "../../app/context/recap_review_synthesis"

define batch_fixture_reply with sources as Str and candidate as Str and assessments as Str returning Str:
    set text to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set text to concat(text and concat(",\"batch_digest\":" and provider_quote(ep_sha256(sources))))
    return concat(text and concat(",\"assessments\":" and concat(assessments and "}")))

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else checkpoint_schema(database) is not equal to 0 or else agent_run_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "one" and "user" and "Keep Aé🌍B." and "fixture") is not equal to 0 or else archive_append(database and "session" and "two" and "user" and "Keep the second instruction." and "fixture") is not equal to 0:
        return 2
    if agent_run_create(database and "prior" and "session" and "one") is not equal to 0:
        return 3
    if agent_run_create(database and "run" and "session" and "two") is not equal to 0 or else recap_job_create(database and "session" and "two" and "job") is not equal to 0:
        return 3
    set candidate to "{\"source_end\":\"two\",\"summary\":\"Keep Aé🌍B and the second instruction.\",\"summary_sources\":[\"one\",\"two\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    set pending to recap_review_pending(database and "session" and "two" and "job" and candidate)
    if pending equals 0 or else length_list(pending) is not equal to 2:
        display "FAIL pending source coverage"
        return 4
    set sources to recap_batch_sources(pending and 2)
    set good to "{\"verdict\":\"covered\",\"explanation\":\"The instruction is preserved.\",\"findings\":[]}"
    set assessments to concat("[" and concat(good and concat("," and concat(good and "]"))))
    set reply to batch_fixture_reply(sources and candidate and assessments)
    set reports to recap_batch_reports("two" and sources and candidate and reply)
    if reports equals 0 or else length_list(reports) is not equal to 2:
        display "FAIL valid report expansion"
        return 5
    if recap_batch_reports("two" and sources and concat(candidate and " ") and reply) is not equal to 0 or else recap_batch_reports("two" and concat(sources and " ") and candidate and reply) is not equal to 0:
        display "FAIL digest binding"
        return 6
    set bad to batch_fixture_reply(sources and candidate and concat("[" and concat(good and "]")))
    if not (recap_batch_store(database and "session" and "two" and "job" and candidate and sources and bad and "invalid") equals "invalid-review") or else archive_read_event(database and "invalid:fragment-review:0") is not equal to 0:
        display "FAIL missing assessment atomicity"
        return 7
    set bad to batch_fixture_reply(sources and candidate and concat("[" and concat(good and ",{\"verdict\":\"covered\",\"explanation\":\"\",\"findings\":[]}]")))
    if not (recap_batch_store(database and "session" and "two" and "job" and candidate and sources and bad and "invalid-last") equals "invalid-review") or else archive_read_event(database and "invalid-last:fragment-review:0") is not equal to 0:
        display "FAIL invalid trailing assessment atomicity"
        return 8
    if not (recap_batch_store(database and "session" and "two" and "job" and candidate and sources and reply and "valid") equals "batch-reviewed"):
        display "FAIL durable batch"
        return 9
    set progress to recap_review_progress(database and "session" and "job" and candidate)
    if not (archive_list_text(progress and 0) equals "fragment-reviews-covered"):
        display "FAIL native range validation"
        return 10
    set pending to recap_review_pending(database and "session" and "two" and "job" and candidate)
    if pending equals 0 or else length_list(pending) is not equal to 0:
        display "FAIL restart reuse"
        return 11
    set other to recap_review_pending(database and "session" and "two" and "job" and concat(candidate and " "))
    if other equals 0 or else length_list(other) is not equal to 2:
        display "FAIL changed candidate must be revalidated"
        return 12
    if string_length(recap_review_package(database and "session" and "job" and candidate)) equals 0 or else archive_verify(database and "session") is not equal to 0:
        return 13
    if not (recap_progress_digest(database and "{\"a\":1,\"b\":2}") equals recap_progress_digest(database and "{ \"b\": 2, \"a\": 1 }")) or else recap_progress_digest(database and "{\"a\":1}") equals recap_progress_digest(database and "{\"a\":2}"):
        display "FAIL semantic progress fingerprint"
        return 14
    display "PASS batch binding, exhaustive coverage, atomic receipts, Unicode, resume and synthesis compatibility"
    return sql_close(database)
