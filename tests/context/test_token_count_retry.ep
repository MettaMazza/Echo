import "../../app/providers/llama_preflight"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set body to ptr_to_str(read_file(get_argument(3)))
    set result to llama_preflight(database and "test" and "count" and string_to_int(get_argument(2)) and body and 2048 and -1 and 65536)
    if not (archive_list_text(result and 0) equals "ready"):
        display archive_list_text(result and 0)
        return 3
    set receipt to archive_read_event(database and "count:empty-count-retry")
    if receipt equals 0:
        return 4
    display "PASS: empty HTTP 400 recorded, identical read-only token count retried, valid count admitted."
    return sql_close(database)
