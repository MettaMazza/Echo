import "../../app/context/recap_repair"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 2
    set original to "The tool read all 56 characters. No file was deleted or changed. The task remains unfinished. Preserve the exact tail marker TAIL_493."
    if archive_append(database and "session" and "original" and "user" and original and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "original") is not equal to 0:
        return 3
    set candidate to "{\"source_end\":\"original\",\"summary\":\"The tool deleted the file and finished the task.\",\"summary_sources\":[\"original\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    set feedback to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set feedback to concat(feedback and ",\"source_end\":\"original\",\"records\":[{\"event\":\"original\",\"verdict\":\"contradicted\",\"explanation\":\"No file changed; the task is unfinished. Preserve the read length and TAIL_493.\"}],\"findings\":[\"Remove the unsupported deletion and completion claims.\"]}")
    set result to recap_repair(database and "session" and "original" and candidate and feedback and "repair" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (archive_list_text(result and 0) equals "structure-valid"):
        display archive_list_text(result and 0)
        return 4
    set receipt to archive_read_event(database and "repair")
    if receipt equals 0 or else not (archive_list_text(receipt and 2) equals "model_request"):
        return 5
    set repaired to archive_list_text(result and 1)
    if string_contains(repaired and "TAIL_493") equals 0 or else string_contains(repaired and "Continuity review corrections:") > 0:
        return 6
    set review to recap_review_generate(database and "session" and "original" and repaired and "review" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (archive_list_text(review and 0) equals "review-pass"):
        display archive_list_text(review and 0)
        return 7
    display "PASS: real repair inference replaces false completion/deletion, preserves the tail marker and passes independent source review."
    return sql_close(database)
