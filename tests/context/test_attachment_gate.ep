import "../../app/agent/runner"
import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "File gate fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Preserve my original.")
    set session to ptr_to_str(get_list(submitted and 1))
    set run to ptr_to_str(get_list(submitted and 2))
    set before to agent_run_read(database and run)
    set original to "Original café 🌍 bytes"
    set saved to write_file(get_argument(2) and original)
    if web_attachment_register(database and "owner" and session and "file" and get_argument(2) and "Original.txt" and "text/plain") is not equal to 0:
        return 1
    if not (compaction_attachments_verify(database and session and "file:attachment") equals "verified"):
        display "FAIL: intact original rejected"
        display compaction_attachments_verify(database and session and "file:attachment")
        set checked to file_digest_durable(get_argument(2) and 65536)
        display ptr_to_str(get_list(checked and 0))
        return 1
    # A branch inherits only its frozen ancestor prefix.
    set source to archive_read_event(database and "file:attachment")
    set payload to concat("{\"source\":" and provider_quote(session))
    set payload to concat(payload and ",\"endpoint\":\"file:attachment\",\"sequence\":")
    set payload to concat(payload and provider_quote(ptr_to_str(get_list(source and 7))))
    set payload to concat(payload and concat(",\"digest\":" and concat(provider_quote(ptr_to_str(get_list(source and 6))) and "}")))
    if archive_append(database and "branch" and "branch-origin" and "session_branch" and payload and "fixture") is not equal to 0:
        return 1
    if not (compaction_attachments_verify(database and "branch" and "branch-origin") equals "verified"):
        return 1
    set saved to write_file(get_argument(2) and "Damaged original")
    if not (compaction_attachments_verify(database and "branch" and "branch-origin") equals "attachment-original-unavailable"):
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set status to context_compact(database and run and "fixture" and 1 and 1 and -1 and 4096 and library)
    if not (status equals "attachment-original-unavailable") or else checkpoint_read_active(database and session) is not equal to 0:
        display "FAIL: corruption did not stop compaction before inference"
        return 1
    set after to agent_run_read(database and run)
    if not (ptr_to_str(get_list(before and 3)) equals ptr_to_str(get_list(after and 3))):
        return 1
    # Repairing the original removes the failure without deleting history.
    set saved to write_file(get_argument(2) and original)
    if not (compaction_attachments_verify(database and session and "file:attachment") equals "verified"):
        return 1
    set remove_function to ep_dlsym(library and "unlink")
    if ep_dlcall1(remove_function and str_to_ptr(get_argument(2))) is not equal to 0:
        return 1
    if not (compaction_attachments_verify(database and session and "file:attachment") equals "attachment-original-unavailable"):
        return 1
    set fifo_function to ep_dlsym(library and "mkfifo")
    if ep_dlcall2(fifo_function and str_to_ptr(get_argument(2)) and 384) is not equal to 0:
        return 1
    if not (compaction_attachments_verify(database and session and "file:attachment") equals "attachment-original-unavailable"):
        return 1
    if ep_dlcall1(remove_function and str_to_ptr(get_argument(2))) is not equal to 0:
        return 1
    # A prefix before the attachment is unaffected by the later missing file.
    set row to history_collect_one(archive_prepare(database and "SELECT objective_event FROM echo_runs LIMIT 1;"))
    if not (compaction_attachments_verify(database and session and ptr_to_str(get_list(row and 1))) equals "verified"):
        return 1
    set link_function to ep_dlsym(library and "symlink")
    set target to concat(get_argument(2) and ".target")
    set saved to write_file(target and original)
    if ep_dlcall2(link_function and str_to_ptr(target) and str_to_ptr(get_argument(2))) is not equal to 0:
        return 1
    if not (compaction_attachments_verify(database and session and "file:attachment") equals "attachment-original-unavailable"):
        return 1
    if archive_verify(database and session) is not equal to 0 or else archive_verify(database and "branch") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set closed to ep_dlclose(library)
    display "PASS: flushed original verified; corruption/missing/symlink/FIFO rejected; branch ancestry covered; earlier prefix unaffected; compaction stopped before inference with original run/context preserved."
    return 0
