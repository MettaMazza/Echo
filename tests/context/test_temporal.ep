import "../../app/context/temporal"

define temporal_test_value with body as Str and key as Str returning Str:
    set fields to provider_json_tokens(body)
    return provider_value(fields and provider_member(fields and 0 and key))

define main returning Int:
    set database to sql_open(":memory:")
    if database equals 0:
        return 1
    set schema to "CREATE TABLE echo_sessions(session TEXT,created TEXT); CREATE TABLE echo_runs(run TEXT,session TEXT,objective_event TEXT); CREATE TABLE echo_events(sequence INTEGER,session TEXT,event TEXT,kind TEXT,payload TEXT,occurred TEXT); INSERT INTO echo_sessions VALUES('fresh','unix-ms:1000000'),('branch','unix-ms:1300000'),('unknown','not-a-clock'); INSERT INTO echo_events VALUES(1,'old','old-user','user','Ancient memory','unix-ms:1000'),(2,'fresh','a','user','Hello','unix-ms:1000000'),(3,'fresh','recap','recap','We started an hour ago','unix-ms:1005000'),(4,'fresh','b','user','Second prompt','unix-ms:1120000'),(5,'fresh','auto','user_guidance','{\"runtime_autonomy\":true}','unix-ms:1150000'),(6,'fresh','c','user','Third prompt','unix-ms:1300000'),(7,'fresh','future','user','Not yet admitted','unix-ms:9000000'),(8,'branch','branch-a','user','Branch first prompt','unix-ms:1300000'),(9,'unknown','unknown-a','user','Unknown date','bad'); INSERT INTO echo_runs VALUES('r','fresh','c'),('fork','branch','branch-a'),('bad','unknown','unknown-a');"
    if sql_execute(database and schema) is not equal to 0:
        return 2
    set result to echo_temporal_observation(database and "r" and 1300000)
    if not (temporal_test_value(result and "scoped_input_count") equals "3") or else not (temporal_test_value(result and "elapsed_since_first_input_ms") equals "300000") or else not (temporal_test_value(result and "gap_before_current_input_ms") equals "180000"):
        display result
        return 3
    set resumed to echo_temporal_observation(database and "r" and 4900000)
    if not (temporal_test_value(resumed and "elapsed_since_first_input_ms") equals "3900000") or else not (temporal_test_value(resumed and "elapsed_since_run_received_ms") equals "3600000"):
        return 4
    set branch to echo_temporal_observation(database and "fork" and 1300000)
    if not (temporal_test_value(branch and "scoped_input_count") equals "1") or else not (temporal_test_value(branch and "elapsed_since_first_input_ms") equals "0"):
        return 5
    set unknown to echo_temporal_observation(database and "bad" and 1300000)
    if not (temporal_test_value(unknown and "session_age_ms") equals "null") or else not (temporal_test_value(unknown and "elapsed_since_first_input_ms") equals "null"):
        return 6
    if not (echo_temporal_elapsed("1500000" and 1300000) equals "null") or else not (echo_temporal_milliseconds("unix-ms:123oops") equals "null"):
        return 7
    if not (result equals echo_temporal_observation(database and "r" and 1300000)):
        return 8
    display "PASS: three inputs in five minutes, scoped count, historical/recap/autonomy exclusion, future isolation, branch, idle gap, stable observation and unknown/backward clock."
    return sql_close(database)
