import "../../app/context/compaction_lock"
import "os"

define main returning Int:
    set database to archive_open(get_argument(1))
    set other to archive_open(get_argument(1))
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if database equals 0 or else other equals 0 or else library equals 0:
        return 1
    set first to compaction_lock_acquire(database and "session" and library)
    if first is less than 0:
        return 1
    if get_argument_count() is greater than 2:
        if not (get_argument(2) equals "interrupt"):
            return 1
        set killed to run_command(concat("kill -KILL " and int_to_string(get_pid())))
        display "FAIL: interruption did not terminate lock owner."
        return 1
    set competing to compaction_lock_acquire(other and "session" and library)
    if competing >= 0:
        display "FAIL: two owners acquired the same session."
        return 1
    set separate to compaction_lock_acquire(other and "different-session" and library)
    if separate is less than 0 or else net_close(separate) is not equal to 0 or else net_close(first) is not equal to 0:
        return 1
    set resumed to compaction_lock_acquire(other and "session" and library)
    if resumed is less than 0 or else net_close(resumed) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0 or else sql_close(other) is not equal to 0 or else ep_dlclose(library) is not equal to 0:
        return 1
    display "PASS: same-session exclusion, independent-session ownership and reacquisition after release."
    return 0
