import "../../app/context/recap_review"

define main returning Int:
    if get_argument_count() is not equal to 4 and also get_argument_count() is not equal to 5:
        return 1
    set sources to ptr_to_str(read_file(get_argument(2)))
    set profile to provider_llama_profile(get_argument(1) and 8080)
    set generated to recap_structured_body(recap_request_body(get_argument(1) and sources) and profile and 0)
    if write_file(concat(get_argument(3) and "-generate.json") and generated) is not equal to 1:
        return 2
    if get_argument_count() equals 5:
        set candidate to ptr_to_str(read_file(get_argument(4)))
        set reviewed to recap_structured_body(recap_review_body(get_argument(1) and sources and candidate) and profile and 1)
        if write_file(concat(get_argument(3) and "-review.json") and reviewed) is not equal to 1:
            return 3
    return 0
