import "../../app/context/recap_accept"

# Synthetic receipts isolate range accounting from model judgment quality.
define coverage_review_fixture with database as Int and job as Str and identity as Str and candidate as Str and start as Int and finish as Int and verdict as Str returning Int:
    set original to archive_read_event(database and "source")
    set digest to ptr_to_str(get_list(original and 6))
    set report to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set report to concat(report and concat(",\"source_end\":\"source\",\"event\":\"source\",\"source_digest\":" and provider_quote(digest)))
    set report to concat(report and concat(",\"offset\":" and int_to_string(start)))
    set report to concat(report and concat(",\"next_offset\":" and int_to_string(finish)))
    set report to concat(report and concat(",\"verdict\":" and provider_quote(verdict)))
    set report to concat(report and ",\"explanation\":\"Synthetic coverage fixture.\",\"findings\":[]}")
    set payload to concat("{\"job\":" and provider_quote(job))
    set payload to concat(payload and concat(",\"candidate_digest\":" and provider_quote(ep_sha256(candidate))))
    set payload to concat(payload and concat(",\"source_end\":\"source\",\"source_event\":\"source\",\"source_digest\":" and provider_quote(digest)))
    set payload to concat(payload and concat(",\"offset\":" and int_to_string(start)))
    set payload to concat(payload and concat(",\"next_offset\":" and int_to_string(finish)))
    set payload to concat(payload and concat(",\"report\":" and concat(provider_quote(report) and "}")))
    return archive_append(database and "session" and identity and "recap_fragment_review" and payload and "fixture")


define synthesis_receipt_fixture with job as Str and candidate as Str returning Str:
    set report to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set report to concat(report and ",\"source_end\":\"source\",\"records\":[{\"event\":\"source\",\"verdict\":\"covered\",\"explanation\":\"Fixture comparison\"}],\"findings\":[]}")
    set payload to concat("{\"job\":" and provider_quote(job))
    set payload to concat(payload and concat(",\"candidate_digest\":" and provider_quote(ep_sha256(candidate))))
    return concat(payload and concat(",\"validation\":\"review-pass\",\"report\":" and concat(provider_quote(report) and "}")))

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "source" and "user" and "Aé🌍B" and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "source") is not equal to 0 or else recap_job_create(database and "session" and "source" and "job") is not equal to 0:
        return 1
    set candidate to "{\"source_end\":\"source\",\"summary\":\"Keep Aé🌍B.\",\"summary_sources\":[\"source\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    set payload to synthesis_receipt_fixture("job" and candidate)
    if not (recap_synthesis_validate(database and "session" and "source" and candidate and payload) equals "coverage-required"):
        display "FAIL: accepted missing ranges."
        return 1
    if coverage_review_fixture(database and "job" and "prefix" and candidate and 0 and 2 and "covered") is not equal to 0 or else coverage_review_fixture(database and "job" and "suffix" and candidate and 2 and 4 and "covered") is not equal to 0:
        return 1
    if not (recap_synthesis_validate(database and "session" and "source" and candidate and payload) equals "review-pass"):
        display "FAIL: rejected complete matching evidence."
        return 1
    if not (recap_synthesis_validate(database and "session" and "source" and concat(candidate and " ") and payload) equals "invalid-review") or else not (recap_synthesis_validate(database and "other" and "source" and candidate and payload) equals "invalid-job"):
        return 1
    if archive_append(database and "session" and "subset" and "recap_job" and "{\"source_end\":\"source\",\"records\":[]}" and "fixture") is not equal to 0:
        return 1
    if not (recap_synthesis_validate(database and "session" and "source" and candidate and synthesis_receipt_fixture("subset" and candidate)) equals "invalid-source"):
        display "FAIL: accepted incomplete original manifest."
        return 1
    if recap_job_create(database and "session" and "source" and "repair-job") is not equal to 0 or else coverage_review_fixture(database and "repair-job" and "uncertain" and candidate and 0 and 4 and "uncertain") is not equal to 0:
        return 1
    set repair_payload to synthesis_receipt_fixture("repair-job" and candidate)
    if not (recap_synthesis_validate(database and "session" and "source" and candidate and repair_payload) equals "review-repair"):
        display "FAIL: synthesis hid a fragment uncertainty."
        return 1
    set saved_candidate to concat("{\"source_end\":\"source\",\"candidate\":" and concat(provider_quote(candidate) and "}"))
    if archive_append(database and "session" and "candidate" and "recap_candidate" and saved_candidate and "fixture") is not equal to 0 or else archive_append(database and "session" and "review" and "recap_review_synthesis" and repair_payload and "fixture") is not equal to 0:
        return 1
    if not (recap_accept(database and "session" and "run" and "candidate" and "review" and "checkpoint" and "fixture" and 1 and 20 and -1 and 4096) equals "review-required") or else checkpoint_read_active(database and "session") is not equal to 0:
        display "FAIL: uncertain synthesis reached activation."
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (recap_synthesis_validate(database and "session" and "source" and candidate and payload) equals "review-pass") or else archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: complete original manifest and contiguous reviews survive reopen; missing ranges, changed candidate, foreign session, subset manifest and concealed uncertainty cannot activate. Synthetic judgments only."
    return 0
