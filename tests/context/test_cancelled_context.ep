import "../../app/context/session_messages"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "old-user" and "user" and "Compare the old audio." and "fixture") is not equal to 0 or else agent_run_create(database and "old-run" and "session" and "old-user") is not equal to 0:
        return 2
    if archive_append(database and "session" and "old-stop" and "agent_cancelled" and "{\"run_id\":\"old-run\",\"parent_event\":\"old-user\"}" and "fixture") is not equal to 0 or else agent_run_transition(database and "old-run" and "ready" and "old-user" and "cancelled" and "old-stop") is not equal to 0:
        return 3
    set old to agent_run_messages_scoped(database and "old-run" and 0 and 0)
    if provider_json_tokens(old) equals 0 or else string_index_of(old and "task was stopped") < 0 or else string_index_of(old and "Compare the old audio.") < 0:
        return 4
    if archive_append(database and "session" and "new-user" and "user" and "Say seven copper lanterns." and "fixture") is not equal to 0 or else agent_run_create(database and "new-run" and "session" and "new-user") is not equal to 0:
        return 5
    set full to session_messages(database and "session" and "new-run")
    if provider_json_tokens(full) equals 0 or else string_index_of(full and "task was stopped") < 0 or else string_index_of(full and "task was stopped") >= string_index_of(full and "Say seven copper lanterns."):
        return 6
    set fresh to agent_run_messages_scoped(database and "new-run" and 0 and 0)
    if string_index_of(fresh and "task was stopped") >= 0:
        return 7
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 8
    display "PASS: cancelled task history retains its stop before the new request; active requests are not labelled cancelled."
    return 0
