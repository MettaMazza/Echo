import "../../app/context/budget"

define main returning Int:
    if context_output_allowance(100 and 30 and -1) is not equal to 70:
        display "FAIL: unrestricted provider output was artificially capped."
        return 1
    if context_output_allowance(100 and 30 and 20) is not equal to 20:
        display "FAIL: actual provider output ceiling was ignored."
        return 1
    if context_output_allowance(100 and 100 and -1) is not equal to 0:
        display "FAIL: occupied context still allowed generation."
        return 1
    if context_output_allowance(100 and 30 and 0) is not equal to -1:
        display "FAIL: unknown output metadata became a fabricated limit."
        return 1
    if context_remaining(0 and 0) is not equal to -1:
        return 1
    if context_remaining(100 and 101) is not equal to -1:
        return 1
    if context_request_fits(100 and 70 and 10 and 5 and 15) is not equal to 1:
        display "FAIL: exact-boundary request was rejected."
        return 1
    if context_request_fits(100 and 70 and 10 and 5 and 16) is not equal to 0:
        display "FAIL: overflowing request was accepted."
        return 1
    if context_request_fits(100 and 70 and -1 and 0 and 0) is not equal to -1:
        return 1
    if context_request_fits(9223372036854775807 and 9223372036854775806 and 2 and 0 and 0) is not equal to 0:
        display "FAIL: integer overflow corrupted budgeting."
        return 1
    if context_loaded_at_maximum(262144 and 8192) is not equal to 0:
        display "FAIL: silently reduced context passed verification."
        return 1
    if context_loaded_at_maximum(262144 and 262144) is not equal to 1:
        return 1
    if context_loaded_at_maximum(262144 and 0) is not equal to -1:
        return 1
    display "PASS: provider-derived output, exact boundaries, unknown metadata rejection, integer overflow resistance and loaded-capacity verification."
    return 0
