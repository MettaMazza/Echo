import "../../app/web/attachments"
import "../../app/agent/run_messages"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "What time is it?")
    set run to archive_list_text(submitted and 2)
    set messages to agent_run_messages(database and run)
    if string_contains(messages and "Host clock observation") equals 0 or else string_contains(messages and "UTC date and time") equals 0 or else string_contains(messages and "What time is it?") equals 0:
        display messages
        return 4
    if not (messages equals agent_run_messages(database and run)):
        return 5
    set current to agent_run_read(database and run)
    set event to archive_read_event(database and archive_list_text(current and 1))
    if not (archive_list_text(event and 3) equals "What time is it?"):
        return 6
    if archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0:
        return 7
    set body to session_request_body_owned(database and run and "fixture" and messages)
    set fields to provider_json_tokens(body)
    set items to provider_items(fields and provider_member(fields and 0 and "messages"))
    set last to get_list(items and length_list(items) - 1)
    set timing to provider_value(fields and provider_member(fields and last and "content"))
    if string_contains(timing and "CURRENT RUNTIME TIME") equals 0 or else string_contains(timing and "first input was admitted:") equals 0 or else string_contains(messages and "CURRENT RUNTIME TIME") is not equal to 0:
        return 8
    display "PASS: clock included alongside original user message, stable reconstruction and unchanged verified archive."
    return sql_close(database)
