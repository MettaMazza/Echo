import "../../app/web/run_store"
import "../../app/agent/control"

# Host-only UI fixture: create a NEW explicitly labelled conversation for an
# existing test device. Never alter or compact an existing conversation.
define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    set device to get_argument(2)
    set identity to get_argument(3)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else agent_run_read(database and identity) is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and device and identity and "" and "Recap viewer acceptance fixture — synthetic data, not a model-quality test.")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted") or else agent_cancel_run(database and identity) is not equal to 0:
        return 1
    set session to ptr_to_str(get_list(submitted and 1))
    set row to agent_run_read(database and identity)
    set first to concat(identity and ":first")
    if checkpoint_stage(database and first and session and ptr_to_str(get_list(row and 3)) and "" and "Fixture only: Aé🌍B. Earlier decision: amber. Literal markup: <b>not HTML</b>." and "{\"facts\":[\"Earlier decision: amber\"]}" and "{\"fixture\":true}") is not equal to 0 or else checkpoint_activate(database and session and first) is not equal to 0:
        return 1
    set second_run to concat(identity and ":correction")
    set corrected to web_submit_owned(database and device and second_run and session and "Fixture correction: violet replaces amber.")
    if not (ptr_to_str(get_list(corrected and 0)) equals "accepted") or else agent_cancel_run(database and second_run) is not equal to 0:
        return 1
    set row to agent_run_read(database and second_run)
    set second to concat(identity and ":second")
    if checkpoint_stage(database and second and session and ptr_to_str(get_list(row and 3)) and first and "Fixture only: revised decision violet. This saved recap tests the viewer and does not claim model-generated continuity." and "{\"corrections\":[\"Violet replaces amber\"],\"pending_work\":[\"Inspect the previous recap\"]}" and "{\"fixture\":true,\"purpose\":\"Browser rendering and navigation\"}") is not equal to 0 or else checkpoint_activate(database and session and second) is not equal to 0:
        return 1
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display session
    return 0
