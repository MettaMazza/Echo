import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() < 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set prompt to echo_system_prompt(database and get_argument(2))
    set identity to ptr_to_str(read_file(ptr_to_str(get_env("ECHO_IDENTITY_FILE"))))
    if not (substring(prompt and 0 and string_length(identity)) equals identity):
        return 3
    if string_contains(prompt and "CURRENT CONTEXT INTERPRETATION") equals 0:
        return 4
    set source_tokens to provider_json_tokens(memory_source_provenance_file())
    set source_items to provider_items(source_tokens and 0)
    set source_item to get_list(source_items and 0)
    set source_session to provider_value(source_tokens and provider_member(source_tokens and source_item and "session"))
    set catalog to concat("[{\"session\":" and concat(provider_quote(source_session) and "}]"))
    set provenance to memory_source_provenance(catalog)
    if string_contains(provenance and "Codex diagnostic automation") equals 0:
        return 5
    if string_length(memory_source_provenance("[{\"session\":\"unrelated-owner\"}]")) > 0:
        return 6
    set current to agent_run_read(database and get_argument(2))
    set correction to memory_current_source_correction(archive_list_text(current and 0))
    if string_contains(correction and "Source evidence:") equals 0:
        return 8
    if string_length(memory_current_source_correction("unrelated-owner-session")) > 0:
        return 9
    print prompt
    return 0
