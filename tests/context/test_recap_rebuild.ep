import "../fixtures/runner_provider"
import "../fixtures/generation_fixture"
import "../../app/web/run_store"

define rebuild_provider_fixture with listener as List and objective as Str and completed as Int and start as Int and finish as Int returning Int:
    set state to create_list()
    set added to append_list(state and start)
    set added to append_list(state and "")
    # Start beyond the fixture's artificial capacity trigger: this test must
    # rebuild because of an explicit request while ordinary context still fits.
    set added to append_list(state and 1)
    set added to append_list(state and objective)
    set added to append_list(state and -12)
    set added to append_list(state and "")
    set added to append_list(state and "")
    set failures to 0
    repeat while get_list(state and 0) is less than finish or else (finish equals 2 and get_list(state and 2) is less than 4):
        set failures to failures + runner_fixture_exchange(listener and state)
    send failures to completed
    return 0

define main returning Int:
    if (get_argument_count() is not equal to 2 and get_argument_count() is not equal to 3) or else file_exists(get_argument(1)):
        return 1
    set gap to 0
    if get_argument_count() equals 3:
        set gap to 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Rebuild fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "run" and "" and "Remember café.")
    set session to ptr_to_str(get_list(submitted and 1))
    set row to agent_run_read(database and "run")
    set objective to ptr_to_str(get_list(row and 3))
    if not (recap_rebuild_enqueue(database and "run" and "unknown" and "{\"reason\":\"Recheck originals\"}") equals "{\"status\":\"not-authorized\"}"):
        return 1
    set listener to local_socket_listen(0)
    if agent_provider_bind(database and "run" and provider_llama_profile("fixture" and get_list(listener and 2))) is not equal to 0:
        return 1
    set data to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"rebuild\",\"function\":{\"name\":\"session_rebuild_recap\",\"arguments\":\"{\\\"reason\\\":\\\"Recheck the original request and preserve café.\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set generated_done to channel
    spawn generation_fixture(listener and data and generated_done)
    set generated to agent_generate_local(database and "run" and "request-tool" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 4096 and "0")
    set served to receive from generated_done
    if generated is not equal to 0 or else served is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0:
        return 1
    if not (recap_rebuild_pending(database and "run") equals "required") or else checkpoint_read_active(database and session) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set completed to channel
    set finish to 3
    if gap equals 1:
        set finish to 2
        if sql_execute(database and "CREATE TRIGGER interrupt_rebuild BEFORE INSERT ON echo_events WHEN NEW.kind='recap_rebuild_completed' BEGIN SELECT RAISE(ABORT,'Injected failure after checkpoint activation'); END;") is not equal to 0:
            return 1
    set first_objective to concat(objective and "")
    spawn rebuild_provider_fixture(listener and first_objective and completed and 0 and finish)
    set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096)
    display concat("Agent status: " and status)
    if gap equals 0 and not (status equals "completed"):
        return 1
    if gap equals 1 and not (status equals "archive-error"):
        return 1
    set failures to receive from completed
    if failures is not equal to 0:
        return 1
    if gap equals 1:
        set before to checkpoint_read_active(database and session)
        if before equals 0 or else sql_execute(database and "DROP TRIGGER interrupt_rebuild;") is not equal to 0 or else sql_close(database) is not equal to 0:
            return 1
        set database to archive_open(get_argument(1))
        if not (recap_rebuild_pending(database and "run") equals "recorded"):
            return 1
        set after to checkpoint_read_active(database and session)
        if not (ptr_to_str(get_list(before and 0)) equals ptr_to_str(get_list(after and 0))):
            return 1
        set resumed_done to channel
        spawn rebuild_provider_fixture(listener and objective and resumed_done and 2 and 3)
        if not (agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096) equals "completed"):
            return 1
        set failures to receive from resumed_done
        if failures is not equal to 0:
            return 1
    set active to checkpoint_read_active(database and session)
    if active equals 0 or else not (recap_rebuild_pending(database and "run") equals "none"):
        return 1
    set receipt to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='recap_rebuild_completed';"))
    if not (ptr_to_str(get_list(receipt and 1)) equals "1") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (recap_rebuild_pending(database and "run") equals "none") or else not (agent_loop(database and "run" and "fixture" and 1 and 20 and -1 and 4096) equals "completed"):
        return 1
    set closed to local_socket_close(listener)
    set closed to sql_close(database)
    display "PASS: observed explicit rebuild survives reopen, compacts below capacity, independently reviews/activates, records completion and continues same run; reopening completed run does not repeat inference. Synthetic model judgments."
    return 0
