import "../../app/web/compaction"
import "../../app/security/group_speech"
import "../../app/security/channel_silo"
import "../../app/security/admin_silo"
import "../../app/security/system_silo"
import "../fixtures/runner_provider"
import "../fixtures/generation_fixture"
import "../../app/web/run_store"

define rebuild_provider_fixture with listener as List and objective as Str and completed as Int and start as Int and finish as Int returning Int:
    set state to create_list()
    set added to append_list(state and start)
    set added to append_list(state and "")
    # Start beyond the fixture's artificial capacity trigger: this test must
    # rebuild because of an explicit request while ordinary context still fits.
    set added to append_list(state and 1)
    set added to append_list(state and objective)
    set added to append_list(state and -12)
    set added to append_list(state and "")
    set added to append_list(state and "")
    set failures to 0
    repeat while get_list(state and 0) is less than finish or else (finish equals 2 and get_list(state and 2) is less than 4):
        set failures to failures + runner_fixture_exchange(listener and state)
    send failures to completed
    return 0

define main returning Int:
    if (get_argument_count() is not equal to 2 and get_argument_count() is not equal to 3 and get_argument_count() is not equal to 4) or else file_exists(get_argument(1)):
        return 1
    set gap to 0
    if get_argument_count() >= 3 and get_argument(2) equals "gap":
        set gap to 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if not (group_speech_schema(database) equals "applied"):
        return 2
    for each name in ["owner","other","outsider"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "owner" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "owner" and "invite-other" and "g" and "device:other" and "invited" and 1) equals "recorded") or else not (group_change(database and "other" and "join-other" and "g" and "device:other" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "owner" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 4
    set private_run to web_submit_owned(database and "owner" and "private" and "" and "PRIVATE_RECAP_CANARY_91507")
    set private_session to archive_list_text(private_run and 1)
    set session to "shared"
    set scope to "group"
    if get_argument_count() equals 4:
        set scope to get_argument(3)
    set routed to create_list()
    if scope equals "channel":
        set routed to channel_silo_submit(database and "other" and "discord" and "server" and "room" and "run" and "Remember café." and create_list())
    else if scope equals "system":
        set routed to system_silo_submit(database and "other" and "continuity" and "run" and "Remember café." and create_list())
    else if scope equals "admin":
        if not (principal_host_role(database and "grant" and "device:other" and "admin" and "fixture") equals "recorded") or else not (admin_silo_create(database and "other" and "admin-context" and "browser" and "local" and "admin-room") equals "created"):
            return 12
        set routed to group_route_submit(database and "other" and "admin-context" and "browser" and "local" and "admin-room" and "run" and "Remember café.")
    else if scope equals "group":
        if not (group_run_submit(database and "other" and "run" and session and "browser" and "local" and "g" and "Remember café.") equals "accepted"):
            return 5
    else:
        return 13
    if not (scope equals "group"):
        if not (archive_list_text(routed and 0) equals "accepted"):
            display archive_list_text(routed and 0)
            return 14
        set session to archive_list_text(routed and 1)
    # Cancelling another live silo must not cancel this run or its recap.
    if agent_cancel_run(database and "private") is not equal to 0:
        return 15
    set row to agent_run_read(database and "run")
    set objective to ptr_to_str(get_list(row and 3))
    if not (recap_rebuild_enqueue(database and "run" and "unknown" and "{\"reason\":\"Recheck originals\"}") equals "{\"status\":\"not-authorized\"}"):
        return 1
    set listener to local_socket_listen(0)
    if agent_provider_bind(database and "run" and provider_llama_profile("fixture" and get_list(listener and 2))) is not equal to 0:
        return 1
    set data to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"rebuild\",\"function\":{\"name\":\"session_rebuild_recap\",\"arguments\":\"{\\\"reason\\\":\\\"Recheck the original request and preserve café.\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set generated_done to channel
    spawn generation_fixture(listener and data and generated_done)
    set generated to agent_generate_local(database and "run" and "request-tool" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 4096 and "0")
    set served to receive from generated_done
    if generated is not equal to 0 or else served is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0:
        return 1
    if not (recap_rebuild_pending(database and "run") equals "required") or else checkpoint_read_active(database and session) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set completed to channel
    set finish to 3
    if gap equals 1:
        set finish to 2
        if sql_execute(database and "CREATE TRIGGER interrupt_rebuild BEFORE INSERT ON echo_events WHEN NEW.kind='recap_rebuild_completed' BEGIN SELECT RAISE(ABORT,'Injected failure after checkpoint activation'); END;") is not equal to 0:
            return 1
    set first_objective to concat(objective and "")
    spawn rebuild_provider_fixture(listener and first_objective and completed and 0 and finish)
    set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096)
    display concat("Agent status: " and status)
    if gap equals 0 and not (status equals "completed"):
        return 1
    if gap equals 1 and not (status equals "archive-error"):
        return 1
    set failures to receive from completed
    if failures is not equal to 0:
        return 1
    if gap equals 1:
        set before to checkpoint_read_active(database and session)
        if before equals 0 or else sql_execute(database and "DROP TRIGGER interrupt_rebuild;") is not equal to 0 or else sql_close(database) is not equal to 0:
            return 1
        set database to archive_open(get_argument(1))
        if not (recap_rebuild_pending(database and "run") equals "recorded"):
            return 1
        set after to checkpoint_read_active(database and session)
        if not (ptr_to_str(get_list(before and 0)) equals ptr_to_str(get_list(after and 0))):
            return 1
        set resumed_done to channel
        spawn rebuild_provider_fixture(listener and objective and resumed_done and 2 and 3)
        if not (agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096) equals "completed"):
            return 1
        set failures to receive from resumed_done
        if failures is not equal to 0:
            return 1
    set active to checkpoint_read_active(database and session)
    if active equals 0 or else not (recap_rebuild_pending(database and "run") equals "none"):
        return 1
    if checkpoint_read_active(database and private_session) is not equal to 0:
        return 6
    set read_arguments to "{\"section\":\"summary\",\"offset\":0,\"characters\":10000}"
    set read_back to web_compaction_read(database and "other" and session and read_arguments)
    if string_contains(read_back and "café") equals 0:
        display read_back
        return 17
    if not (web_compaction_read(database and "outsider" and session and read_arguments) equals "{\"status\":\"not-found\"}"):
        return 18
    set exact_arguments to concat("{\"section\":\"summary\",\"offset\":0,\"characters\":10000,\"checkpoint\":" and concat(provider_quote(archive_list_text(active and 0)) and "}"))
    if string_contains(web_compaction_read(database and "owner" and private_session and exact_arguments) and "café") is not equal to 0:
        return 19
    set assembled to session_messages(database and session and "run")
    if string_contains(assembled and "PRIVATE_RECAP_CANARY_91507") is not equal to 0 or else string_contains(assembled and "café") equals 0:
        return 7
    set leaked to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE session=? AND instr(payload,'PRIVATE_RECAP_CANARY_91507')>0;" and [session]))
    if not (archive_list_text(leaked and 1) equals "0"):
        return 8
    set receipt to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='recap_rebuild_completed';"))
    if not (ptr_to_str(get_list(receipt and 1)) equals "1") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (recap_rebuild_pending(database and "run") equals "none") or else not (agent_loop(database and "run" and "fixture" and 1 and 20 and -1 and 4096) equals "completed"):
        return 1
    if not (archive_list_text(agent_run_read(database and "private") and 2) equals "cancelled") or else checkpoint_read_active(database and private_session) is not equal to 0:
        return 16
    display concat("Qualified silo: " and scope)
    set closed to local_socket_close(listener)
    set closed to sql_close(database)
    display "PASS: shared observed explicit rebuild survives reopen, compacts below capacity, independently reviews/activates, records completion and continues same run; reopening completed run does not repeat inference. Synthetic model judgments."
    return 0
