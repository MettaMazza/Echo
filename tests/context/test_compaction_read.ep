import "../../app/web/compaction"
import "../../app/web/run_store"

define recap_read_field with body as Str and name as Str returning Str:
    set tokens to provider_json_tokens(body)
    return provider_value(tokens and provider_member(tokens and 0 and name))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Original facts")
    set session to ptr_to_str(get_list(submitted and 1))
    set row to agent_run_read(database and "request")
    set endpoint to ptr_to_str(get_list(row and 3))
    set arguments to "{\"section\":\"summary\",\"offset\":1,\"characters\":2}"
    if not (recap_read_field(web_compaction_read(database and "owner" and session and arguments) and "status") equals "end"):
        return 1
    if checkpoint_stage(database and "first" and session and endpoint and "" and "Aé🌍B" and "{\"facts\":[\"retained\"]}" and "{\"review\":\"fixture\"}") is not equal to 0 or else checkpoint_activate(database and session and "first") is not equal to 0:
        return 1
    set result to web_compaction_read(database and "owner" and session and arguments)
    if not (recap_read_field(result and "text") equals "é🌍") or else not (recap_read_field(result and "next_offset") equals "3") or else not (recap_read_field(result and "total_characters") equals "4") or else not (recap_read_field(result and "active") equals "true"):
        display result
        return 1
    if archive_append(database and session and "later" and "user" and "A correction" and "fixture") is not equal to 0 or else checkpoint_stage(database and "second" and session and "later" and "first" and "Updated summary" and "{}" and "{}") is not equal to 0 or else checkpoint_activate(database and session and "second") is not equal to 0:
        return 1
    set result to web_compaction_read(database and "owner" and session and arguments)
    if not (recap_read_field(result and "checkpoint") equals "second") or else not (recap_read_field(result and "previous") equals "first"):
        return 1
    set old to "{\"checkpoint\":\"first\",\"section\":\"state\",\"offset\":0,\"characters\":10000}"
    set result to web_compaction_read(database and "owner" and session and old)
    if not (recap_read_field(result and "text") equals "{\"facts\":[\"retained\"]}") or else not (recap_read_field(result and "active") equals "false"):
        return 1
    if not (recap_read_field(web_compaction_read(database and "foreign" and session and old) and "status") equals "not-found"):
        return 1
    set other to web_submit_owned(database and "owner" and "other-request" and "" and "Separate conversation")
    if not (recap_read_field(compaction_tool_read(database and ptr_to_str(get_list(other and 1)) and old) and "status") equals "end"):
        return 1
    if not (recap_read_field(compaction_tool_read(database and session and "{\"session\":\"foreign\",\"section\":\"summary\",\"offset\":0,\"characters\":1}") and "status") equals "invalid-arguments"):
        return 1
    if not (recap_read_field(compaction_tool_read(database and session and "{\"section\":\"summary\",\"offset\":-1,\"characters\":1}") and "status") equals "invalid-arguments"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (recap_read_field(compaction_tool_read(database and session and old) and "checkpoint") equals "first"):
        return 1
    if web_device_revoke(database and "owner") is not equal to 0:
        return 1
    if not (recap_read_field(compaction_tool_read(database and session and old) and "status") equals "end") or else not (recap_read_field(web_compaction_read(database and "owner" and session and old) and "status") equals "not-found"):
        return 1
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: active/previous recap inspection, Unicode cursor, exact structured state, reopen, foreign session/device and revoked-device rejection; arbitrary session arguments rejected."
    return 0
