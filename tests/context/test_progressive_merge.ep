import "../fixtures/runner_provider"

define merge_note_fixture with database as Int and identity as Str and start as Int and finish as Int and notes as Str returning Int:
    set original to archive_read_event(database and "objective")
    set payload to concat("{\"job\":\"job\",\"source_end\":\"objective\",\"source_event\":\"objective\",\"source_digest\":" and provider_quote(ptr_to_str(get_list(original and 6))))
    set payload to concat(payload and concat(",\"offset\":" and int_to_string(start)))
    set payload to concat(payload and concat(",\"next_offset\":" and int_to_string(finish)))
    set payload to concat(payload and concat(",\"notes\":" and concat(provider_quote(notes) and "}")))
    return archive_append(database and "session" and identity and "recap_fragment_notes" and payload and "fixture")

define merge_provider_fixture with listener as List and completed as Int returning Int:
    set state to create_list()
    set added to append_list(state and 0)
    set added to append_list(state and "")
    set added to append_list(state and 0)
    set added to append_list(state and "objective")
    set added to append_list(state and -10)
    set added to append_list(state and "")
    set added to append_list(state and "objective")
    set failures to 0
    repeat while get_list(state and 0) is less than 3:
        set failures to failures + runner_fixture_exchange(listener and state)
    if get_list(state and 2) is not equal to 5:
        set failures to failures + 1
    send failures to completed
    return 0

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "objective" and "user" and "Aé🌍BXYZ" and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "objective") is not equal to 0 or else recap_job_create(database and "session" and "objective" and "job") is not equal to 0:
        return 1
    if merge_note_fixture(database and "note-one" and 0 and 4 and "Aé🌍B") is not equal to 0 or else merge_note_fixture(database and "note-two" and 4 and 7 and "XYZ") is not equal to 0:
        return 1
    # This stray note is not a manifest member and must never be processed.
    if archive_append(database and "session" and "stray" and "recap_fragment_notes" and "{\"job\":\"job\",\"source_event\":\"foreign\",\"notes\":\"DO NOT INCLUDE\"}" and "fixture") is not equal to 0:
        return 1
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set completed to channel
    spawn merge_provider_fixture(listener and completed)
    set result to recap_merge(database and "session" and "job" and "job:merge" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096)
    if not (ptr_to_str(get_list(result and 0)) equals "structure-valid"):
        display concat("FAIL: progressive merge returned " and ptr_to_str(get_list(result and 0)))
        return 1
    set failures to receive from completed
    if failures is not equal to 0:
        display "FAIL: incorrect fragments, cumulative draft or preflight count."
        return 1
    set saved to compaction_saved_candidate(database and "session" and "objective" and "job")
    if not (ptr_to_str(get_list(saved and 0)) equals "structure-valid") or else not (ptr_to_str(get_list(saved and 1)) equals ptr_to_str(get_list(result and 1))) or else length_list(get_list(saved and 3)) is not equal to 0:
        display "FAIL: intermediate draft confused with final job candidate."
        return 1
    set candidate to provider_json_tokens(ptr_to_str(get_list(saved and 1)))
    if not (provider_value(candidate and provider_member(candidate and 0 and "summary")) equals "Cumulative fixture stage 3") or else checkpoint_read_active(database and "session") is not equal to 0:
        return 1
    if archive_verify(database and "session") is not equal to 0 or else local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: oversized combined notes and oversized individual note adapt to provider preflight; Unicode ranges cover all notes, prior drafts accumulate, stray notes stay excluded, only final candidate is recoverable and nothing activates without review. Synthetic judgments."
    return 0
