import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is less than 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "first-user" and "user" and "Remember the original word café." and "fixture") is not equal to 0 or else agent_run_create(database and "first-run" and "session" and "first-user") is not equal to 0:
        return 1
    if archive_append(database and "session" and "first-request" and "model_request" and "{\"run_id\":\"first-run\",\"parent_event\":\"first-user\"}" and "fixture") is not equal to 0 or else agent_run_transition(database and "first-run" and "ready" and "first-user" and "generating" and "first-request") is not equal to 0:
        return 1
    if archive_append(database and "session" and "first-final" and "assistant_final" and "{\"run_id\":\"first-run\",\"parent_event\":\"first-request\",\"content\":\"The word is saved.\",\"reasoning_content\":\"\",\"tool_calls\":[]}" and "fixture") is not equal to 0 or else agent_run_transition(database and "first-run" and "generating" and "first-request" and "completed" and "first-final") is not equal to 0:
        return 1
    if checkpoint_stage(database and "checkpoint-one" and "session" and "first-final" and "" and "The user asked to remember café. Original source: first-user. The assistant confirmed it was saved." and "{\"facts\":[{\"value\":\"café\",\"source\":\"first-user\"}]}" and "fixture coverage record, not semantic model evaluation") is not equal to 0:
        return 1
    if archive_append(database and "session" and "next-user" and "user" and "What word did I ask you to remember?" and "fixture") is not equal to 0 or else agent_run_create(database and "next-run" and "session" and "next-user") is not equal to 0:
        return 1
    if agent_provider_bind(database and "next-run" and provider_llama_profile("selected-model-fixture" and 8080)) is not equal to 0:
        return 1
    set system_prompt to echo_system_prompt(database and "next-run")
    set system_count to 0
    if string_length(system_prompt) > 0:
        set system_count to 1
        set identity_path to ptr_to_str(get_env("ECHO_IDENTITY_FILE"))
        if string_length(identity_path) > 0:
            set original to ptr_to_str(read_file(identity_path))
            if not (substring(system_prompt and 0 and string_length(original)) equals original):
                display "FAIL: identity not preserved verbatim."
                return 1
        if string_index_of(system_prompt and "selected-model-fixture") < 0:
            return 1
    set full to session_messages(database and "session" and "next-run")
    set tokens to provider_json_tokens(full)
    if tokens equals 0:
        return 1
    set items to provider_items(tokens and 0)
    if items equals 0 or else length_list(items) is not equal to 3 + system_count:
        display "FAIL: prior conversation context."
        return 1
    if checkpoint_activate(database and "session" and "checkpoint-one") is not equal to 0:
        return 1
    set compact to session_messages(database and "session" and "next-run")
    set tokens to provider_json_tokens(compact)
    if tokens equals 0:
        return 1
    set items to provider_items(tokens and 0)
    if items equals 0 or else length_list(items) is not equal to 2 + system_count:
        display "FAIL: checkpoint plus suffix."
        return 1
    set last to get_list(items and 1 + system_count)
    if not (provider_value(tokens and provider_member(tokens and last and "content")) equals "What word did I ask you to remember?"):
        return 1
    if system_count equals 1:
        set system_item to get_list(items and 0)
        if not (provider_value(tokens and provider_member(tokens and system_item and "role")) equals "system") or else not (provider_value(tokens and provider_member(tokens and system_item and "content")) equals system_prompt):
            display "FAIL: system identity changed through compaction."
            return 1
    set first to get_list(items and system_count)
    set recap to provider_value(tokens and provider_member(tokens and first and "content"))
    if string_index_of(recap and "checkpoint-one") is less than 0 or else string_index_of(recap and "café") is less than 0 or else string_index_of(recap and "first-user") is less than 0:
        return 1
    if not (session_messages(database and "other" and "next-run") equals ""):
        return 1
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (session_messages(database and "session" and "next-run") equals compact) or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: earlier accepted conversation included, checkpoint recap/source identity plus later user preserved, wrong-session rejection and identical context after reopen."
    return 0
