import "../../app/agent/run_messages"

define main returning Int:
    set prompt to "Exact system text, including identity."
    set original to concat("{\"clock\":\"now\",\"architecture\":" and concat(provider_quote(prompt) and ",\"other\":7}"))
    set projected to agent_observation_without_duplicate_system(original and prompt)
    if projected equals original:
        return 1
    set tokens to provider_json_tokens(projected)
    if tokens equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "clock")) equals "now") or else not (provider_index(tokens and provider_member(tokens and 0 and "other")) equals "7"):
        return 2
    if string_contains(provider_value(tokens and provider_member(tokens and 0 and "architecture")) and ep_sha256(prompt)) equals 0:
        return 3
    if not (agent_observation_without_duplicate_system(original and "different current prompt") equals original):
        return 4
    if not (agent_observation_without_duplicate_system(original and "") equals original):
        return 5
    print "PASS: only exact duplicate system text projected; dynamic fields and differing original text preserved."
    return 0
