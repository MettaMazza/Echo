import "../../app/context/recap_review"

# Accept equivalent prose and arithmetic grounded in the record, but reject an
# invented side effect. Uses the actual model and unchanged review validator.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 2
    set original to "The reader returned choice_index=\"0\", total_characters=\"56\", offset=\"0\", characters=56 and next_offset=56. No file was changed."
    if archive_append(database and "session" and "original" and "user" and original and "2026-10-17T00:00:00Z") is not equal to 0 or else agent_run_create(database and "run" and "session" and "original") is not equal to 0:
        return 3
    set candidate to "{\"source_end\":\"original\",\"summary\":\"The user reports a read with choice index 0 that returned all 56 characters from offset 0 and reached the end at offset 56. No file changed.\",\"summary_sources\":[\"original\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[{\"text\":\"The user reports choice index 0 and a complete 56-character read from offset 0 to the end at 56; no file changed.\",\"sources\":[\"original\"]}],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    set reviewed to recap_review_generate(database and "session" and "original" and candidate and "faithful-review" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    display concat("Faithful paraphrase: " and archive_list_text(reviewed and 0))
    if not (archive_list_text(reviewed and 0) equals "review-pass"):
        return 4
    set invented to ptr_to_str(string_replace(candidate and "No file changed." and "The reader deleted the original file successfully."))
    set rejected to recap_review_generate(database and "session" and "original" and invented and "invented-review" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    display concat("Invented side effect: " and archive_list_text(rejected and 0))
    if not (archive_list_text(rejected and 0) equals "review-repair") or else archive_verify(database and "session") is not equal to 0:
        return 5
    display "PASS: actual reviewer accepts faithful numeric paraphrase and deterministic read completion, rejects invented deletion, and preserves archive evidence."
    return sql_close(database)
