import "../../app/context/system_awareness"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0:
        return 2
    set first to echo_system_prompt(database and get_argument(2))
    set second to echo_system_prompt(database and get_argument(3))
    if string_length(first) equals 0 or else not (ep_sha256(first) equals ep_sha256(second)):
        return 3
    if write_file(get_argument(4) and first) is not equal to 1 or else sql_close(database) is not equal to 0:
        return 4
    display "PASS: different runs with the same installed provider and identity produce identical system prompt bytes."
    return 0
