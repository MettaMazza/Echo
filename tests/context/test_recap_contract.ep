import "../../app/context/recap_contract"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 1
    if archive_append(database and "home" and "first" and "user" and "Keep café and build Echo." and "fixture") is not equal to 0 or else archive_append(database and "elsewhere" and "private" and "user" and "Other device" and "fixture") is not equal to 0 or else archive_append(database and "home" and "future" and "user" and "Later correction" and "fixture") is not equal to 0:
        return 1
    set candidate to "{\"source_end\":\"first\",\"summary\":\"The user wants Echo built and café retained.\",\"summary_sources\":[\"first\"],\"state\":{\"objectives\":[{\"text\":\"Build Echo\",\"sources\":[\"first\"]}],\"constraints\":[],\"facts\":[{\"text\":\"Retain café\",\"sources\":[\"first\"]}],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[{\"text\":\"Build remains unfinished\",\"sources\":[\"first\"]}],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    if recap_validate_structure(database and "home" and "first" and candidate) is not equal to 0:
        return 1
    set foreign to ptr_to_str(string_replace(candidate and "[\"first\"]" and "[\"private\"]"))
    set future to ptr_to_str(string_replace(candidate and "[\"first\"]" and "[\"future\"]"))
    set invented to ptr_to_str(string_replace(candidate and "[\"first\"]" and "[\"invented\"]"))
    set omitted to ptr_to_str(string_replace(candidate and "\"corrections\":[]" and "\"other\":[]"))
    if recap_validate_structure(database and "home" and "first" and foreign) equals 0 or else recap_validate_structure(database and "home" and "first" and future) equals 0 or else recap_validate_structure(database and "home" and "first" and invented) equals 0 or else recap_validate_structure(database and "home" and "first" and omitted) equals 0:
        return 1
    if recap_validate_structure(database and "elsewhere" and "first" and candidate) equals 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: recap fields and provenance; foreign, future, invented and incomplete references rejected. Semantic coverage is not established by this test."
    return 0
