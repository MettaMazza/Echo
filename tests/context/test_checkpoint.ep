import "../../app/context/checkpoint"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set path to get_argument(1)
    if file_exists(path):
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    if checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "home" and "first" and "user" and "Keep original source." and "now") is not equal to 0:
        return 1
    if checkpoint_stage(database and "candidate-a" and "home" and "first" and "" and "Keep original source [first]." and "Pending: build Echo." and "Fixture coverage checked against first.") is not equal to 0:
        return 1
    if checkpoint_read_active(database and "home") is not equal to 0:
        display "FAIL: staging replaced the live context."
        return 1
    if checkpoint_stage(database and "candidate-b" and "home" and "first" and "" and "Competing recap [first]." and "Pending: build Echo." and "Fixture coverage checked.") is not equal to 0:
        return 1
    # Close and reopen between preparation and activation, as after a restart.
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    if archive_append(database and "home" and "second" and "user" and "A correction arriving during summarisation." and "later") is not equal to 0:
        return 1
    if checkpoint_activate(database and "other-session" and "candidate-a") equals 0:
        return 1
    if checkpoint_activate(database and "home" and "candidate-a") is not equal to 0:
        return 1
    if checkpoint_activate(database and "home" and "candidate-b") equals 0:
        display "FAIL: stale candidate overwrote newer context."
        return 1
    set active to checkpoint_read_active(database and "home")
    if active equals 0:
        return 1
    if not (ptr_to_str(get_list(active and 0)) equals "candidate-a"):
        return 1
    if not (ptr_to_str(get_list(active and 1)) equals "first"):
        return 1
    if archive_read_event(database and "second") equals 0:
        display "FAIL: appended suffix disappeared."
        return 1
    if checkpoint_stage(database and "candidate-c" and "home" and "first" and "candidate-a" and "Outdated source." and "state" and "validation") equals 0:
        display "FAIL: repeated checkpoint did not advance the source prefix."
        return 1
    set captured to checkpoint_capture(database and "home")
    if captured equals 0:
        return 1
    if not (ptr_to_str(get_list(captured and 0)) equals "second") or else not (ptr_to_str(get_list(captured and 3)) equals "candidate-a"):
        return 1
    if archive_append(database and "home" and "third" and "user" and "New work while recap is generated." and "later") is not equal to 0:
        return 1
    if checkpoint_stage(database and "candidate-c" and "home" and "second" and "candidate-a" and "Original and correction [first, second]." and "Pending: build Echo." and "Both fixture sources checked.") is not equal to 0:
        return 1
    if checkpoint_activate(database and "home" and "candidate-c") is not equal to 0:
        return 1
    if archive_read_event(database and "third") equals 0:
        display "FAIL: work appended during recap generation disappeared."
        return 1
    if checkpoint_stage(database and "backward" and "home" and "first" and "candidate-c" and "Old" and "state" and "validation") equals 0:
        return 1
    if sql_execute(database and "UPDATE echo_checkpoints SET summary='changed' WHERE identity='candidate-a';") equals 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    set active to checkpoint_read_active(database and "home")
    if active equals 0:
        return 1
    if not (ptr_to_str(get_list(active and 0)) equals "candidate-c") or else not (ptr_to_str(get_list(active and 3)) equals "candidate-a"):
        return 1
    if archive_verify(database and "home") is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: staged recovery, atomic activation, competing candidate rejection, session isolation, retained suffix, complete prefix, immutable checkpoints and repeated activation persistence."
    return 0
