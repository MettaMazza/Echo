import "../../app/context/recap_review_coverage"

# Synthetic receipts isolate range accounting from model judgment quality.
define coverage_review_fixture with database as Int and job as Str and identity as Str and candidate as Str and start as Int and finish as Int and verdict as Str returning Int:
    set original to archive_read_event(database and "source")
    set digest to ptr_to_str(get_list(original and 6))
    set report to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set report to concat(report and concat(",\"source_end\":\"source\",\"event\":\"source\",\"source_digest\":" and provider_quote(digest)))
    set report to concat(report and concat(",\"offset\":" and int_to_string(start)))
    set report to concat(report and concat(",\"next_offset\":" and int_to_string(finish)))
    set report to concat(report and concat(",\"verdict\":" and provider_quote(verdict)))
    set report to concat(report and ",\"explanation\":\"Synthetic coverage fixture.\",\"findings\":[]}")
    set payload to concat("{\"job\":" and provider_quote(job))
    set payload to concat(payload and concat(",\"candidate_digest\":" and provider_quote(ep_sha256(candidate))))
    set payload to concat(payload and concat(",\"source_end\":\"source\",\"source_event\":\"source\",\"source_digest\":" and provider_quote(digest)))
    set payload to concat(payload and concat(",\"offset\":" and int_to_string(start)))
    set payload to concat(payload and concat(",\"next_offset\":" and int_to_string(finish)))
    set payload to concat(payload and concat(",\"report\":" and concat(provider_quote(report) and "}")))
    return archive_append(database and "session" and identity and "recap_fragment_review" and payload and "fixture")

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "source" and "user" and "Aé🌍B" and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "source") is not equal to 0 or else recap_job_create(database and "session" and "source" and "job") is not equal to 0:
        return 1
    set candidate to "{\"source_end\":\"source\",\"summary\":\"Keep Aé🌍B.\",\"summary_sources\":[\"source\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}"
    set initial to recap_review_progress(database and "session" and "job" and candidate)
    if not (ptr_to_str(get_list(initial and 0)) equals "fragment-reviews-required") or else get_list(initial and 1) is not equal to 0:
        return 1
    if coverage_review_fixture(database and "job" and "prefix" and candidate and 0 and 2 and "covered") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set resumed to recap_review_progress(database and "session" and "job" and candidate)
    if not (ptr_to_str(get_list(resumed and 0)) equals "fragment-reviews-required") or else get_list(resumed and 1) is not equal to 2:
        return 1
    set other_candidate to recap_review_progress(database and "session" and "job" and concat(candidate and " "))
    if not (ptr_to_str(get_list(other_candidate and 0)) equals "fragment-reviews-required") or else get_list(other_candidate and 1) is not equal to 0:
        return 1
    if coverage_review_fixture(database and "job" and "suffix" and candidate and 2 and 4 and "uncertain") is not equal to 0:
        return 1
    set finished to recap_review_progress(database and "session" and "job" and candidate)
    if not (ptr_to_str(get_list(finished and 0)) equals "fragment-reviews-repair"):
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if not (recap_review_collect(database and "session" and "source" and "job" and candidate and "fixture" and 1 and 100 and -1 and 4096 and library) equals "fragment-reviews-repair") or else ep_dlclose(library) is not equal to 0:
        return 1
    if recap_job_create(database and "session" and "source" and "gap-job") is not equal to 0 or else coverage_review_fixture(database and "gap-job" and "gap" and candidate and 2 and 4 and "covered") is not equal to 0:
        return 1
    set gap to recap_review_progress(database and "session" and "gap-job" and candidate)
    if not (ptr_to_str(get_list(gap and 0)) equals "coverage-conflict"):
        return 1
    if coverage_review_fixture(database and "job" and "overlap" and candidate and 2 and 4 and "covered") is not equal to 0:
        return 1
    set overlap to recap_review_progress(database and "session" and "job" and candidate)
    if not (ptr_to_str(get_list(overlap and 0)) equals "coverage-conflict"):
        return 1
    set foreign to recap_review_progress(database and "other" and "job" and candidate)
    if not (ptr_to_str(get_list(foreign and 0)) equals "invalid-job") or else checkpoint_read_active(database and "session") is not equal to 0 or else archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: durable contiguous review ranges, candidate/session isolation, retained repair verdict, gap/overlap rejection and covered-job return without provider requests. No semantic completeness claim."
    return 0
