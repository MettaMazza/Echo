import "../../app/context/recap_jobs"

# Synthetic notes isolate range-accounting tests; they are not model evaluation.
define fixture_note with database as Int and identity as Str and job as Str and digest as Str and start as Int and finish as Int returning Int:
    set payload to concat("{\"job\":" and provider_quote(job))
    set payload to concat(payload and concat(",\"source_end\":\"original\",\"source_event\":\"original\",\"source_digest\":" and provider_quote(digest)))
    set payload to concat(payload and concat(",\"offset\":" and int_to_string(start)))
    set payload to concat(payload and concat(",\"next_offset\":" and int_to_string(finish)))
    return archive_append(database and "session" and identity and "recap_fragment_notes" and concat(payload and ",\"notes\":\"Fixture notes\"}") and "fixture")

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "original" and "user" and "Aé🌍B" and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "original") is not equal to 0:
        return 1
    if recap_job_create(database and "session" and "original" and "job") is not equal to 0 or else recap_job_create(database and "session" and "original" and "gap-job") is not equal to 0:
        return 1
    set original to archive_read_event(database and "original")
    set digest to ptr_to_str(get_list(original and 6))
    set progress to recap_job_progress(database and "session" and "job")
    if not (ptr_to_str(get_list(progress and 0)) equals "notes-required") or else get_list(progress and 1) is not equal to 0:
        return 1
    if fixture_note(database and "first-note" and "job" and digest and 0 and 2) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set progress to recap_job_progress(database and "session" and "job")
    if not (ptr_to_str(get_list(progress and 0)) equals "notes-required") or else get_list(progress and 1) is not equal to 2 or else not (ptr_to_str(get_list(progress and 2)) equals "original"):
        return 1
    if fixture_note(database and "last-note" and "job" and digest and 2 and 4) is not equal to 0:
        return 1
    set progress to recap_job_progress(database and "session" and "job")
    if not (ptr_to_str(get_list(progress and 0)) equals "source-ranges-covered"):
        return 1
    if fixture_note(database and "gap-note" and "gap-job" and digest and 2 and 4) is not equal to 0 or else fixture_note(database and "overlap-note" and "job" and digest and 0 and 2) is not equal to 0:
        return 1
    set gap to recap_job_progress(database and "session" and "gap-job")
    set overlap to recap_job_progress(database and "session" and "job")
    if not (ptr_to_str(get_list(gap and 0)) equals "coverage-conflict") or else not (ptr_to_str(get_list(overlap and 0)) equals "coverage-conflict"):
        return 1
    set foreign to recap_job_progress(database and "other" and "job")
    if not (ptr_to_str(get_list(foreign and 0)) equals "invalid-job"):
        return 1
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: frozen manifest, resumed Unicode cursor, complete range accounting, gap/overlap rejection and session isolation."
    return 0
