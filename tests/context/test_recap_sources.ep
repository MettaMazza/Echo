import "../../app/context/recap_sources"
import "../fixtures/runner_provider"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "objective" and "user" and "Remember café." and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "objective") is not equal to 0:
        return 1
    set listener to local_socket_listen(0)
    set completed to channel
    spawn runner_fixture(listener and "objective" and completed)
    set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 65536)
    set fixture_result to receive from completed
    if not (status equals "completed") or else fixture_result is not equal to 0:
        return 1
    if archive_append(database and "session" and "unaccepted" and "assistant_final" and "Unaccepted branch must not be summarised as an answer." and "fixture") is not equal to 0:
        return 1
    if archive_append(database and "session" and "future" and "user" and "Future correction" and "fixture") is not equal to 0 or else agent_run_create(database and "future-run" and "session" and "future") is not equal to 0:
        return 1
    set packet to recap_sources(database and "session" and "unaccepted")
    set tokens to provider_json_tokens(packet)
    if tokens equals 0:
        return 1
    set records to provider_items(tokens and provider_member(tokens and 0 and "records"))
    if records equals 0 or else length_list(records) is not equal to 5:
        display "FAIL: wrong accepted source record count."
        return 1
    set kinds to ""
    set index to 0
    repeat while index is less than length_list(records):
        set record to get_list(records and index)
        set identity to provider_value(tokens and provider_member(tokens and record and "event"))
        if identity equals "future" or else identity equals "unaccepted":
            return 1
        set kind to provider_value(tokens and provider_member(tokens and record and "kind"))
        set kinds to concat(kinds and concat(kind and ","))
        set original to archive_read_event(database and identity)
        if original equals 0 or else not (provider_value(tokens and provider_member(tokens and record and "original_payload")) equals ptr_to_str(get_list(original and 3))) or else not (provider_value(tokens and provider_member(tokens and record and "digest")) equals ptr_to_str(get_list(original and 6))):
            return 1
        if not (kind equals echo_record_label(archive_list_text(original and 2))):
            return 1
        set index to index + 1
    if not (kinds equals "user,Echo_tool_calls,tool_call,tool_result,Echo,"):
        display kinds
        return 1
    set early to provider_json_tokens(recap_sources(database and "session" and "objective"))
    if length_list(provider_items(early and provider_member(early and 0 and "records"))) is not equal to 1:
        return 1
    if not (recap_sources(database and "other-session" and "unaccepted") equals ""):
        return 1
    if local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: frozen accepted-source packet, exact originals/digests, tool call/results, no nested requests, no stale branches or future events."
    return 0
