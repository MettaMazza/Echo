import "../../app/context/recap_review"

define main returning Int:
    set sources to "{\"source_end\":\"second\",\"records\":[{\"event\":\"first\"},{\"event\":\"second\"}]}"
    set candidate to "Fixture candidate"
    set prefix to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(candidate)))
    set report to concat(prefix and ",\"source_end\":\"second\",\"records\":[{\"event\":\"first\",\"verdict\":\"covered\",\"explanation\":\"Fixture comparison one\"},{\"event\":\"second\",\"verdict\":\"covered\",\"explanation\":\"Fixture comparison two\"}],\"findings\":[]}")
    if not (recap_review_validate(sources and candidate and report) equals "review-pass"):
        return 1
    if not (recap_review_validate(sources and "Changed candidate" and report) equals "invalid-review"):
        return 1
    set omitted to ptr_to_str(string_replace(report and "covered" and "omitted"))
    if not (recap_review_validate(sources and candidate and omitted) equals "review-repair"):
        return 1
    set duplicate to ptr_to_str(string_replace(report and "\"event\":\"second\"" and "\"event\":\"first\""))
    if not (recap_review_validate(sources and candidate and duplicate) equals "invalid-review"):
        return 1
    set foreign to ptr_to_str(string_replace(report and "\"event\":\"second\"" and "\"event\":\"other\""))
    if not (recap_review_validate(sources and candidate and foreign) equals "invalid-review"):
        return 1
    set unsupported to ptr_to_str(string_replace(report and "\"findings\":[]" and "\"findings\":[\"Unsupported completion claim\"]"))
    if not (recap_review_validate(sources and candidate and unsupported) equals "review-repair"):
        return 1
    set changed_endpoint to ptr_to_str(string_replace(report and "\"source_end\":\"second\"" and "\"source_end\":\"later\""))
    if not (recap_review_validate(sources and candidate and changed_endpoint) equals "invalid-review"):
        return 1
    display "PASS: review candidate hash and boundary binding, exhaustive unique source accounting and repair verdicts. Model judgment accuracy is unproven."
    return 0
