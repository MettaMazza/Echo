import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to sql_open(get_argument(1))
    set run to get_argument(2)
    set state to agent_run_read(database and run)
    if state equals 0:
        return 2
    set messages to session_messages_snapshot(database and archive_list_text(state and 0) and run)
    if string_length(messages) < 3:
        return 3
    if write_file(get_argument(3) and messages) is not equal to 1:
        return 4
    return sql_close(database)
