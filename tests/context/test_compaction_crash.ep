import "../fixtures/runner_provider"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    set requested_port to 0
    if get_argument(2) equals "resume" or else get_argument(2) equals "resume-fragments":
        set profile to provider_json_tokens(agent_provider_read(database and "run"))
        if profile equals 0:
            return 1
        set requested_port to http_decimal(provider_index(profile and provider_member(profile and 0 and "port")))
    set listener to local_socket_listen(requested_port)
    if listener equals 0:
        return 1
    set completed to channel
    if get_argument(2) equals "interrupt" or else get_argument(2) equals "interrupt-fragments":
        if archive_append(database and "session" and "objective" and "user" and "Remember café." and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "objective") is not equal to 0:
            return 1
        set mode to -6
        if get_argument(2) equals "interrupt-fragments":
            set mode to -9
        spawn compaction_fixture(listener and mode and completed)
        set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096)
        display concat("FAIL: process was not interrupted: " and status)
        return 1
    if not (get_argument(2) equals "resume" or else get_argument(2) equals "resume-fragments") or else checkpoint_read_active(database and "session") is not equal to 0:
        return 1
    set captured to checkpoint_capture(database and "session")
    set binding to compaction_job(database and "session" and "run" and "objective" and captured)
    if not (ptr_to_str(get_list(binding and 0)) equals "ready"):
        return 1
    set endpoint to ptr_to_str(get_list(binding and 2))
    set job to ptr_to_str(get_list(binding and 1))
    set saved to compaction_saved_candidate(database and "session" and endpoint and job)
    if not (ptr_to_str(get_list(saved and 0)) equals "structure-valid"):
        return 1
    set candidate to ptr_to_str(get_list(saved and 1))
    set review to compaction_saved_review(database and "session" and endpoint and job and candidate)
    if get_argument(2) equals "resume-fragments":
        set review to compaction_saved_synthesis(database and "session" and endpoint and job and candidate)
    if not (ptr_to_str(get_list(review and 0)) equals "review-pass"):
        return 1
    set mismatched to compaction_saved_review(database and "session" and endpoint and job and concat(candidate and " "))
    if get_argument(2) equals "resume-fragments":
        set mismatched to compaction_saved_synthesis(database and "session" and endpoint and job and concat(candidate and " "))
    if not (ptr_to_str(get_list(mismatched and 0)) equals "no-review"):
        return 1
    spawn compaction_recovery_fixture(listener and candidate and endpoint and 1 and completed)
    set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 4096)
    if not (status equals "completed"):
        display concat("FAIL: resume returned " and status)
        return 1
    set fixture_result to receive from completed
    if fixture_result is not equal to 0 or else not (status equals "completed") or else checkpoint_read_active(database and "session") equals 0:
        display concat("FAIL: post-crash recovery " and status)
        return 1
    set counts to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_events WHERE kind='recap_candidate'),(SELECT COUNT(*) FROM echo_events WHERE kind IN ('recap_review','recap_review_synthesis')),(SELECT COUNT(*) FROM echo_events WHERE kind='compaction_binding');"))
    if not (ptr_to_str(get_list(counts and 0)) equals "found") or else not (ptr_to_str(get_list(counts and 1)) equals "1") or else not (ptr_to_str(get_list(counts and 2)) equals "1") or else not (ptr_to_str(get_list(counts and 3)) equals "1"):
        return 1
    if archive_verify(database and "session") is not equal to 0 or else local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: SIGKILL before activation recovered the same job, candidate and passing review, rejected changed-candidate review reuse, reacquired ownership, rechecked capacity and completed the original run."
    return 0
