import "../../app/transport/socket_read"
define cancel_blocked_reader with writer as Int and completed as Int returning Int:
    # This delay is a test synchronisation fixture, not a request deadline.
    set slept to sleep_ms(100)
    set closed to net_close(writer)
    send closed to completed
    return 0

define main returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set library to get_list(listener and 0)
    set pair to socket_cancellation_create(library)
    if pair equals 0:
        return 1
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    if client is less than 0:
        return 1
    set accepted to local_socket_accept(listener)
    if accepted is less than 0:
        return 1
    # Three raw bytes: A, zero, B. A C-string read would silently lose B.
    set payload to create_list()
    set added to append_list(payload and 4325441)
    set pointer to get_list_data_ptr(payload)
    if ep_net_send_raw(client and pointer and 3) is not equal to 3:
        return 1
    set compare_function to ep_dlsym(library and "memcmp")
    if compare_function equals 0:
        return 1
    set total to 0
    repeat while total is less than 3:
        set chunk to socket_read_chunk(library and accepted and get_list(pair and 0))
        if not (ptr_to_str(get_list(chunk and 0)) equals "data"):
            return 1
        set count to get_list(chunk and 2)
        if count is less than 1 or else count is greater than 3 - total:
            return 1
        if socket_signed_result(ep_dlcall3(compare_function and get_list(chunk and 1) and pointer + total and count)) is not equal to 0:
            return 1
        if socket_release_buffer(library and get_list(chunk and 1)) is not equal to 0:
            return 1
        set total to total + count
    if net_close(client) is not equal to 0:
        return 1
    set chunk to socket_read_chunk(library and accepted and get_list(pair and 0))
    if not (ptr_to_str(get_list(chunk and 0)) equals "eof"):
        return 1
    if socket_cancel(pair) is not equal to 0:
        return 1
    set chunk to socket_read_chunk(library and accepted and get_list(pair and 0))
    if not (ptr_to_str(get_list(chunk and 0)) equals "cancelled"):
        return 1
    if socket_cancel(pair) is not equal to 0:
        return 1
    if socket_cancellation_close(pair) is not equal to 0 or else net_close(accepted) is not equal to 0:
        return 1
    set pair to socket_cancellation_create(library)
    if pair equals 0:
        return 1
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    if client is less than 0:
        return 1
    set accepted to local_socket_accept(listener)
    if accepted is less than 0:
        return 1
    set completed to channel
    spawn cancel_blocked_reader(get_list(pair and 1) and completed)
    set chunk to socket_read_chunk(library and accepted and get_list(pair and 0))
    if not (ptr_to_str(get_list(chunk and 0)) equals "cancelled"):
        return 1
    set closed to receive from completed
    set changed to set_list(pair and 1 and -1)
    if closed is not equal to 0:
        return 1
    if socket_cancellation_close(pair) is not equal to 0 or else net_close(accepted) is not equal to 0 or else net_close(client) is not equal to 0:
        return 1
    if local_socket_close(listener) is not equal to 0:
        return 1
    display "PASS: exact binary socket transfer including NUL, explicit EOF, cancellation precedence, repeat cancellation, native buffer release and asynchronous cancellation of a blocked read."
    return 0
