import "../../app/transport/http_head"

define head_expect with head as Str and expected as Str returning Int:
    set parsed to http_parse_head(head)
    set actual to ptr_to_str(get_list(parsed and 0))
    if not (actual equals expected):
        display "FAIL: unexpected HTTP head result."
        display actual
        display expected
        return 1
    return 0

define main returning Int:
    set failures to 0
    set failures to failures + head_expect("GET / HTTP/1.1\r\nHost: localhost:8080\r\n\r\n" and "ready")
    set failures to failures + head_expect("POST /upload HTTP/1.1\r\nHost: localhost\r\nContent-Length: 10737418240\r\n\r\n" and "ready")
    set failures to failures + head_expect("POST /chat HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n" and "ready")
    set failures to failures + head_expect("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\nContent-Length: 4\r\n\r\n" and "ready")
    set failures to failures + head_expect("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 9223372036854775808\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: -1\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("GET / HTTP/1.1\r\nHost : localhost\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("GET / HTTP/1.1\r\nHost: localhost\r\n folded: invalid\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("GET / HTTP/1.1\r\nHost: localhost\r\nHost: other\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("GET / HTTP/1.1\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("GET / HTTP/1.1\nHost: localhost\n\n" and "bad-request")
    set failures to failures + head_expect("GET / HTTP/1.1\r\nHost: localhost\r\nX-Test: bad\nvalue\r\n\r\n" and "bad-request")
    set failures to failures + head_expect("POST / HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: gzip, chunked\r\n\r\n" and "unsupported-transfer")
    if http_decimal("9223372036854775807") is not equal to 9223372036854775807:
        return 1
    if failures is not equal to 0:
        return 1
    display "PASS: HTTP head framing, large declared bodies, chunked metadata, duplicate-length consistency, ambiguous framing rejection and integer-overflow rejection."
    return 0
