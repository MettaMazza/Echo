import "../../app/transport/server_events"

define events_feed with state as List and wire as Str returning List:
    set events to create_list()
    set index to 0
    repeat while index is less than string_length(wire):
        set result to server_events_byte(state and get_character(wire and index))
        set status to ptr_to_str(get_list(result and 0))
        if status equals "event":
            set added to append_list(events and result)
        else if not (status equals "pending"):
            set added to append_list(events and result)
            return events
        set index to index + 1
    return events

define event_matches with events as List and index as Int and kind as Str and data as Str and identity as Str returning Int:
    if length_list(events) is less than index + 1:
        return 0
    set event to get_list(events and index)
    if not (ptr_to_str(get_list(event and 0)) equals "event"):
        return 0
    if not (ptr_to_str(get_list(event and 1)) equals kind) or else not (ptr_to_str(get_list(event and 2)) equals data) or else not (ptr_to_str(get_list(event and 3)) equals identity):
        return 0
    return 1

define main returning Int:
    set state to server_events_create()
    set events to events_feed(state and "﻿: comment\r\nid: first\revent: tool\ndata: {\"arguments\":\"hé🌍\"}\r\ndata: second\r\n\r\ndata:\n\nid:\nevent: unused\n\ndata: [DONE]\n\nretry: 123456789012345678901234567890\nretry: invalid\nunknown: ignored\ndata: unfinished")
    if length_list(events) is not equal to 3:
        display "FAIL: event count."
        return 1
    if event_matches(events and 0 and "tool" and "{\"arguments\":\"hé🌍\"}\nsecond" and "first") equals 0 or else event_matches(events and 1 and "message" and "" and "first") equals 0 or else event_matches(events and 2 and "message" and "[DONE]" and "") equals 0:
        display "FAIL: event data."
        return 1
    if not (ptr_to_str(get_list(state and 10)) equals "123456789012345678901234567890") or else not (ptr_to_str(get_list(server_events_end(state) and 0)) equals "eof"):
        return 1
    set state to server_events_create()
    set events to events_feed(state and "data: one\r\rdata:  two\n\n")
    if event_matches(events and 0 and "message" and "one" and "") equals 0 or else event_matches(events and 1 and "message" and " two" and "") equals 0:
        return 1
    set state to server_events_create()
    set result to server_events_byte(state and 240)
    if not (ptr_to_str(get_list(server_events_end(state) and 0)) equals "invalid-event-stream"):
        return 1
    set state to server_events_create()
    set result to server_events_byte(state and 237)
    set result to server_events_byte(state and 160)
    if not (ptr_to_str(get_list(result and 0)) equals "invalid-event-stream"):
        return 1
    set result to server_events_byte(state and 65)
    if not (ptr_to_str(get_list(result and 0)) equals "invalid-event-stream"):
        return 1
    set state to server_events_create()
    set result to server_events_byte(state and 0)
    if not (ptr_to_str(get_list(result and 0)) equals "invalid-event-stream"):
        return 1
    display "PASS: byte-split Unicode, BOM, CR/LF/CRLF, comments, multiline data, empty events, persistent/reset ids, retry metadata, completion-marker preservation, incomplete EOF and invalid UTF-8 rejection."
    return 0
