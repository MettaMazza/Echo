import "../../app/transport/http_response"
import "../../app/transport/socket_write"

define response_fixture_sender with library as Int and descriptor as Int and wire as Str and completed as Int returning Int:
    set written to socket_write_all(library and descriptor and -1 and str_to_ptr(wire) and string_length(wire))
    set failed to 0
    if not (ptr_to_str(get_list(written and 0)) equals "sent"):
        set failed to 1
    set closed to net_close(descriptor)
    send failed + closed to completed
    return 0

define response_case with listener as List and wire as Str and method as Str and expected_status as Int and expected_framing as Str and expected_body as Str and expected_terminal as Str returning Int:
    set library to get_list(listener and 0)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    if client is less than 0 or else accepted is less than 0:
        return 1
    set completed to channel
    spawn response_fixture_sender(library and client and wire and completed)
    set reader to http_stream_create(library and accepted and -1)
    set head to http_response_head(reader and method)
    if expected_status equals -1:
        if not (ptr_to_str(get_list(head and 0)) equals "bad-response"):
            return 1
    else:
        if not (ptr_to_str(get_list(head and 0)) equals "ready"):
            return 1
        repeat while get_list(head and 1) is less than 200:
            set head to http_response_head(reader and method)
            if not (ptr_to_str(get_list(head and 0)) equals "ready"):
                return 1
        if get_list(head and 1) is not equal to expected_status or else not (ptr_to_str(get_list(head and 2)) equals expected_framing):
            return 1
        set body to http_body_create(ptr_to_str(get_list(head and 2)) and get_list(head and 3))
        set compare_function to ep_dlsym(library and "memcmp")
        set count to 0
        set finished to 0
        repeat while finished equals 0:
            set piece to http_body_next(reader and body and string_length(expected_body) + 1)
            set status to ptr_to_str(get_list(piece and 0))
            if status equals "data":
                set size to get_list(piece and 2)
                if size is greater than string_length(expected_body) - count:
                    return 1
                if socket_signed_result(ep_dlcall3(compare_function and get_list(piece and 1) and str_to_ptr(expected_body) + count and size)) is not equal to 0:
                    return 1
                set count to count + size
            else:
                if not (status equals expected_terminal):
                    return 1
                set finished to 1
        if count is not equal to string_length(expected_body):
            return 1
    set sender_result to receive from completed
    if sender_result is not equal to 0 or else http_stream_release(reader) is not equal to 0 or else net_close(accepted) is not equal to 0:
        return 1
    return 0

define main returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set failures to 0
    set failures to failures + response_case(listener and "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nok\r\n0\r\n\r\n" and "POST" and 200 and "chunked" and "ok" and "done")
    set failures to failures + response_case(listener and "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 4\r\n\r\nfail" and "POST" and 500 and "length" and "fail" and "done")
    set failures to failures + response_case(listener and "HTTP/1.0 200 OK\r\n\r\nclose" and "GET" and 200 and "eof" and "close" and "done")
    set failures to failures + response_case(listener and "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nab" and "POST" and 200 and "length" and "ab" and "incomplete")
    set failures to failures + response_case(listener and "HTTP/1.1 200 OK\r\nContent-Length: 999\r\n\r\n" and "HEAD" and 200 and "length" and "" and "done")
    set failures to failures + response_case(listener and "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nTransfer-Encoding: chunked\r\n\r\n" and "POST" and -1 and "" and "" and "")
    if local_socket_close(listener) is not equal to 0 or else failures is not equal to 0:
        display "FAIL: HTTP response cases."
        display failures
        return 1
    display "PASS: interim responses, chunked completion, preserved HTTP errors, close-delimited bodies, truncation, HEAD semantics and ambiguous-framing rejection over live sockets."
    return 0
