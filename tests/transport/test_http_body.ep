import "../../app/transport/http_body"
import "../../app/transport/socket_write"

define body_send_text with library as Int and descriptor as Int and text as Str returning Int:
    set result to socket_write_all(library and descriptor and -1 and str_to_ptr(text) and string_length(text))
    if not (ptr_to_str(get_list(result and 0)) equals "sent"):
        return 1
    return 0

define body_fixture_sender with library as Int and descriptor as Int and completed as Int and truncated as Int returning Int:
    set failed to 0
    if truncated equals 1:
        set failed to body_send_text(library and descriptor and "4\r\nab")
    else:
        set failed to body_send_text(library and descriptor and "3;name=\"a; b\"\r\n")
        set binary to create_list()
        set added to append_list(binary and 4325441)
        set result to socket_write_all(library and descriptor and -1 and get_list_data_ptr(binary) and 3)
        if not (ptr_to_str(get_list(result and 0)) equals "sent"):
            set failed to 1
        set failed to failed + body_send_text(library and descriptor and "\r\n2\r\nxy\r\n0\r\nX-Checksum: fixture\r\n\r\nPOST /next HTTP/1.1\r\nHost: localhost\r\nContent-Length: 2\r\n\r\nhi")
    set closed to net_close(descriptor)
    send failed + closed to completed
    return 0

define main returning Int:
    if http_chunk_size("7fffffffffffffff") is not equal to 9223372036854775807:
        return 1
    if http_chunk_size("8000000000000000") is not equal to -1 or else http_chunk_size("+2") is not equal to -1:
        return 1
    if http_chunk_size(" 3;name=value") is not equal to -1:
        return 1
    if http_chunk_size("3;name=\"a; b\"") is not equal to 3 or else http_chunk_size("3;name=\"unfinished") is not equal to -1:
        return 1
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set library to get_list(listener and 0)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    if client is less than 0 or else accepted is less than 0:
        return 1
    set completed to channel
    spawn body_fixture_sender(library and client and completed and 0)
    set reader to http_stream_create(library and accepted and -1)
    set body to http_body_create("chunked" and 0)
    set expected to create_list()
    set added to append_list(expected and 65 + 66 * 65536 + 120 * 16777216 + 121 * 4294967296)
    set compare_function to ep_dlsym(library and "memcmp")
    set count to 0
    set finished to 0
    repeat while finished equals 0:
        set piece to http_body_next(reader and body and 2)
        set status to ptr_to_str(get_list(piece and 0))
        if status equals "done":
            set finished to 1
        else:
            if not (status equals "data") or else get_list(piece and 2) is greater than 5 - count:
                return 1
            if socket_signed_result(ep_dlcall3(compare_function and get_list(piece and 1) and get_list_data_ptr(expected) + count and get_list(piece and 2))) is not equal to 0:
                return 1
            set count to count + get_list(piece and 2)
    if count is not equal to 5 or else length_list(get_list(body and 3)) is not equal to 1:
        return 1
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready") or else not (ptr_to_str(get_list(head and 2)) equals "/next"):
        return 1
    set body to http_body_create(ptr_to_str(get_list(head and 3)) and get_list(head and 4))
    set count to 0
    repeat while count is less than 2:
        set piece to http_body_next(reader and body and 2)
        if not (ptr_to_str(get_list(piece and 0)) equals "data"):
            return 1
        if socket_signed_result(ep_dlcall3(compare_function and get_list(piece and 1) and str_to_ptr("hi") + count and get_list(piece and 2))) is not equal to 0:
            return 1
        set count to count + get_list(piece and 2)
    set piece to http_body_next(reader and body and 2)
    if not (ptr_to_str(get_list(piece and 0)) equals "done"):
        return 1
    set result to receive from completed
    if result is not equal to 0 or else http_stream_release(reader) is not equal to 0 or else net_close(accepted) is not equal to 0:
        return 1
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    if client is less than 0 or else accepted is less than 0:
        return 1
    set completed to channel
    spawn body_fixture_sender(library and client and completed and 1)
    set reader to http_stream_create(library and accepted and -1)
    set body to http_body_create("chunked" and 0)
    set finished to 0
    repeat while finished equals 0:
        set piece to http_body_next(reader and body and 4)
        set status to ptr_to_str(get_list(piece and 0))
        if status equals "incomplete":
            set finished to 1
        else if not (status equals "data"):
            return 1
    set result to receive from completed
    if result is not equal to 0 or else http_stream_release(reader) is not equal to 0 or else net_close(accepted) is not equal to 0 or else local_socket_close(listener) is not equal to 0:
        return 1
    display "PASS: streamed chunked binary body, quoted extensions, trailers, following request, fixed-length body, overflow rejection and truncated-body detection."
    return 0
