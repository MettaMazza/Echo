import "../../app/transport/event_stream"
import "../../app/transport/socket_write"

define event_sender with library as Int and descriptor as Int and wire as Str and completed as Int returning Int:
    set result to socket_write_all(library and descriptor and -1 and str_to_ptr(wire) and string_length(wire))
    set failure to 0
    if not (ptr_to_str(get_list(result and 0)) equals "sent"):
        set failure to 1
    set closed to net_close(descriptor)
    send failure + closed to completed
    return 0

define event_case with listener as List and wire as Str and read_size as Int and expected_terminal as Str returning Int:
    set library to get_list(listener and 0)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    if client is less than 0 or else accepted is less than 0:
        return 1
    set completed to channel
    spawn event_sender(library and client and wire and completed)
    set reader to http_stream_create(library and accepted and -1)
    set head to http_response_head(reader and "POST")
    if not (ptr_to_str(get_list(head and 0)) equals "ready") or else get_list(head and 1) is not equal to 200:
        return 1
    set body to http_body_create(ptr_to_str(get_list(head and 2)) and get_list(head and 3))
    set stream to event_stream_create(reader and body)
    set first to event_stream_next(stream and read_size)
    set second to event_stream_next(stream and read_size)
    if not (ptr_to_str(get_list(first and 0)) equals "event") or else not (ptr_to_str(get_list(second and 0)) equals "event"):
        return 1
    if not (ptr_to_str(get_list(first and 2)) equals "hé🌍") or else not (ptr_to_str(get_list(second and 2)) equals "[DONE]"):
        return 1
    set ended to event_stream_next(stream and read_size)
    set repeated to event_stream_next(stream and read_size)
    if not (ptr_to_str(get_list(ended and 0)) equals expected_terminal) or else not (ptr_to_str(get_list(repeated and 0)) equals expected_terminal):
        return 1
    set sent to receive from completed
    if sent is not equal to 0 or else http_stream_release(reader) is not equal to 0 or else net_close(accepted) is not equal to 0:
        return 1
    return 0

define main returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set complete to "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\n\r\n7\r\ndata: h\r\n6\r\né🌍\r\n10\r\n\n\ndata: [DONE]\n\n\r\n0\r\n\r\n"
    set truncated to "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: 999\r\n\r\ndata: hé🌍\n\ndata: [DONE]\n\n"
    set failure to event_case(listener and complete and 1 and "eof")
    set failure to failure + event_case(listener and complete and 65536 and "eof")
    set failure to failure + event_case(listener and truncated and 65536 and "incomplete")
    if local_socket_close(listener) is not equal to 0 or else failure is not equal to 0:
        display "FAIL: live event stream."
        return 1
    display "PASS: live HTTP chunk boundaries, Unicode events, one-byte and bulk reads, retained subsequent events, sticky EOF and truncated framing despite a completion marker."
    return 0
