import "../../app/transport/http_stream"
import "../../app/transport/socket_write"

define fragmented_request with library as Int and descriptor as Int and completed as Int returning Int:
    set head to "POST /upload HTTP/1.1\r\nHost: localhost\r\nContent-Length: 3\r\n\r\n"
    set offset to 0
    repeat while offset is less than string_length(head):
        set written to socket_write_all(library and descriptor and -1 and str_to_ptr(head) + offset and 1)
        if not (ptr_to_str(get_list(written and 0)) equals "sent"):
            send 1 to completed
            return 1
        set offset to offset + 1
    set body to create_list()
    set added to append_list(body and 4325441)
    set written to socket_write_all(library and descriptor and -1 and get_list_data_ptr(body) and 3)
    if not (ptr_to_str(get_list(written and 0)) equals "sent"):
        send 1 to completed
        return 1
    set next_head to "GET /next HTTP/1.1\r\nHost: localhost\r\n\r\n"
    set written to socket_write_all(library and descriptor and -1 and str_to_ptr(next_head) and string_length(next_head))
    if not (ptr_to_str(get_list(written and 0)) equals "sent"):
        send 1 to completed
        return 1
    set closed to net_close(descriptor)
    send closed to completed
    return 0

define main returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set library to get_list(listener and 0)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    if client is less than 0 or else accepted is less than 0:
        return 1
    set completed to channel
    spawn fragmented_request(library and client and completed)
    set reader to http_stream_create(library and accepted and -1)
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready") or else get_list(head and 4) is not equal to 3:
        return 1
    set expected to create_list()
    set added to append_list(expected and 4325441)
    set compare_function to ep_dlsym(library and "memcmp")
    set consumed to 0
    repeat while consumed is less than 3:
        set piece to http_stream_take(reader and 3 - consumed)
        if not (ptr_to_str(get_list(piece and 0)) equals "data"):
            return 1
        if socket_signed_result(ep_dlcall3(compare_function and get_list(piece and 1) and get_list_data_ptr(expected) + consumed and get_list(piece and 2))) is not equal to 0:
            return 1
        set consumed to consumed + get_list(piece and 2)
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready") or else not (ptr_to_str(get_list(head and 2)) equals "/next"):
        return 1
    set end to http_stream_head(reader)
    if not (ptr_to_str(get_list(end and 0)) equals "eof"):
        return 1
    set result to receive from completed
    if result is not equal to 0:
        return 1
    if http_stream_release(reader) is not equal to 0 or else net_close(accepted) is not equal to 0 or else local_socket_close(listener) is not equal to 0:
        return 1
    display "PASS: fragmented HTTP head, exact NUL-bearing body, preserved following request and clean EOF over live sockets."
    return 0
