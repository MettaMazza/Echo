import "../../app/transport/local_socket"
import "string"

define main returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        display "FAIL: local listener did not open."
        return 1
    set port to get_list(listener and 2)
    if port is less than 1 or else port is greater than 65535:
        return 1
    display "Assigned loopback port:"
    display port
    set address to create_list()
    set added to append_list(address and 0)
    set added to append_list(address and 0)
    set size to create_list()
    set added to append_list(size and 16)
    set name_function to ep_dlsym(get_list(listener and 0) and "getsockname")
    if socket_signed_result(ep_dlcall3(name_function and get_list(listener and 1) and get_list_data_ptr(address) and get_list_data_ptr(size))) is not equal to 0:
        return 1
    # Native address bytes must be exactly 127.0.0.1, never 0.0.0.0.
    if get_list(address and 0) / 4294967296 is not equal to 16777343:
        display "FAIL: socket is not bound to IPv4 loopback."
        return 1
    if local_socket_listen(port) is not equal to 0:
        display "FAIL: occupied port unexpectedly succeeded."
        return 1
    set client to net_connect("127.0.0.1" and port)
    if client is less than 0:
        return 1
    set accepted to local_socket_accept(listener)
    if accepted is less than 0:
        return 1
    set payload to "Echo on this Mac: café → home."
    if net_send(client and payload) is not equal to string_length(payload):
        return 1
    set received to ""
    repeat while string_length(received) is less than string_length(payload):
        set piece to net_recv(accepted and string_length(payload) - string_length(received))
        if string_length(piece) equals 0:
            return 1
        set received to concat(received and piece)
    if not (received equals payload):
        return 1
    if net_close(client) is not equal to 0 or else net_close(accepted) is not equal to 0:
        return 1
    if local_socket_close(listener) is not equal to 0:
        return 1
    if local_socket_listen(-1) is not equal to 0:
        return 1
    display "PASS: kernel-confirmed loopback binding, assigned port, collision rejection, native accept and exact live socket transfer."
    return 0
