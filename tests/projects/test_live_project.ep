import "../../app/agent/runner"
import "../../app/projects/context"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "project-create" and "" and "Use the project tool to create a project named Orchard. Its instructions must be exactly: When resuming this project, report orchard-cobalt-619. Give it one task with id inspect, title Inspect the source, status todo, and no files. Do not select it yet. After the create result, return created.")
    if not (archive_list_text(first and 0) equals "accepted") or else not (agent_loop(database and "project-create" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 4
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set resumed to web_submit_owned(database and "owner" and "project-resume" and "" and "Find my saved Orchard project with the project tool, select it for this new conversation, then follow its saved resumption instructions. Use the actual record; do not invent project details.")
    if not (archive_list_text(resumed and 0) equals "accepted") or else not (agent_loop(database and "project-resume" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 5
    set current to agent_run_read(database and "project-resume")
    set final to archive_read_event(database and archive_list_text(current and 3))
    if string_contains(archive_list_text(final and 3) and "orchard-cobalt-619") equals 0 or else string_contains(project_context(database and "project-resume") and "orchard-cobalt-619") equals 0:
        return 6
    set injected to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='model_request' AND json_extract(payload,'$.run_id')='project-resume' AND instr(json_extract(payload,'$.request_body'),'Selected project record.')>0;"))
    if string_to_int(archive_list_text(injected and 1)) < 1 or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(resumed and 1)) is not equal to 0:
        return 7
    display "PASS: actual model created a project, reopened a separate conversation, discovered and selected the saved project, received automatic context and returned its source-only marker."
    return sql_close(database)
