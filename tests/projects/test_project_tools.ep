import "../../app/web/attachment_visibility"
import "../../app/agent/tool_dispatch"
import "../../app/jobs/delegation_schema"
import "../fixtures/generation_fixture"

define project_fixture_step with database as Int and run as Str and step as Int and name as Str and arguments as Str returning Int:
    set identity to concat("step-" and int_to_string(step))
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and run and concat(run and concat(":" and identity)) and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    repeat while archive_list_text(agent_run_read(database and run) and 2) equals "tools":
        if agent_tool_step(database and run) is not equal to 0:
            return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "Create a project")
    set next to web_submit_owned(database and "owner" and "next" and "" and "Resume a project")
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Other user")
    if write_file(get_argument(2) and "project-file-canary") is not equal to 1 or else web_attachment_register(database and "owner" and archive_list_text(first and 1) and "project-file" and get_argument(2) and "notes.txt" and "text/plain") is not equal to 0:
        return 4
    set manifest to concat("{\"name\":\"Orchard\",\"instructions\":\"Retain orchard-cobalt-619.\",\"tasks\":[{\"id\":\"task-1\",\"title\":\"Inspect source\",\"status\":\"todo\"}],\"files\":[{\"attachment\":\"project-file\",\"sha256\":" and concat(provider_quote(ep_sha256("project-file-canary")) and ",\"label\":\"Source notes\"}]}"))
    if project_fixture_step(database and "first" and 0 and "project" and concat("{\"operation\":\"create\",\"manifest\":" and concat(manifest and "}"))) is not equal to 0:
        return 5
    if project_fixture_step(database and "next" and 0 and "project" and "{\"operation\":\"list\",\"after\":0}") is not equal to 0 or else project_fixture_step(database and "next" and 1 and "project" and "{\"operation\":\"select\",\"project\":\"project:first:step-0\"}") is not equal to 0:
        return 6
    set context to project_context(database and "next")
    if string_contains(context and "orchard-cobalt-619") equals 0 or else string_contains(context and "project-file") equals 0 or else string_length(project_context(database and "foreign")) > 0:
        return 7
    if project_manifest_valid(database and "foreign" and manifest) is not equal to 0 or else project_manifest_valid(database and "next" and ptr_to_str(string_replace(manifest and "todo" and "made-up-status"))) is not equal to 0:
        return 8
    if project_fixture_step(database and "foreign" and 0 and "project" and "{\"operation\":\"read\",\"project\":\"project:first:step-0\"}") is not equal to 0:
        return 9
    set denied to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='foreign' AND t.call_id='step-0';"))
    if not (archive_list_text(denied and 1) equals "not-authorized"):
        return 10
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (project_context(database and "next") equals context) or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(next and 1)) is not equal to 0:
        return 11
    set change to provider_json_tokens("{\"action\":\"exclude\",\"attachment\":\"project-file\",\"identity\":\"hide-project-file\",\"previous\":\"\"}")
    if not (web_attachment_visibility(database and "owner" and change) equals "recorded"):
        return 13
    set hidden to project_context(database and "next")
    if string_contains(hidden and "project-file") > 0 or else string_contains(hidden and "orchard-cobalt-619") equals 0 or else string_contains(hidden and "forgotten attachment references omitted") equals 0:
        display hidden
        return 14
    set preserved to project_latest(database and "next" and "project:first:step-0")
    if string_contains(archive_list_text(preserved and 2) and "project-file") equals 0 or else project_manifest_valid(database and "next" and manifest) equals 0:
        return 15
    set change to provider_json_tokens("{\"action\":\"restore\",\"attachment\":\"project-file\",\"identity\":\"restore-project-file\",\"previous\":\"attachment-visibility:owner:hide-project-file\"}")
    if not (web_attachment_visibility(database and "owner" and change) equals "recorded") or else not (project_context(database and "next") equals context):
        return 16
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else string_length(project_context(database and "next")) > 0:
        return 12
    display "PASS: streamed project creation, file references, cross-session listing/selection, persistent context, invalid-state and foreign-file denial, archive chains and revocation."
    return sql_close(database)
