import "../../app/projects/store"
import "../../app/jobs/delegation_schema"
import "../fixtures/delegation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "Create project")
    set next to web_submit_owned(database and "owner" and "next" and "" and "Resume project")
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Other user")
    set manifest to "{\"name\":\"Café project\",\"instructions\":\"Preserve exact text.\",\"tasks\":[],\"files\":[]}"
    if not (project_revision_save(database and "first" and "project-one" and "revision-one" and "" and manifest) equals "recorded"):
        return 4
    if not (project_revision_save(database and "first" and "project-one" and "revision-one" and "" and manifest) equals "already-recorded") or else not (project_revision_save(database and "first" and "project-one" and "revision-one" and "" and "{\"name\":\"Other\",\"instructions\":\"\",\"tasks\":[],\"files\":[]}") equals "event-conflict"):
        return 5
    set revision to project_latest(database and "next" and "project-one")
    set fields to provider_json_tokens(archive_list_text(revision and 2))
    if not (archive_list_text(revision and 0) equals "found") or else not (provider_value(fields and provider_member(fields and 0 and "manifest")) equals manifest) or else not (provider_value(fields and provider_member(fields and 0 and "manifest_sha256")) equals ep_sha256(manifest)):
        return 6
    if not (archive_list_text(project_latest(database and "foreign" and "project-one") and 0) equals "not-authorized") or else not (project_revision_save(database and "foreign" and "project-one" and "forged" and "revision-one" and manifest) equals "not-authorized"):
        return 7
    if not (project_revision_save(database and "next" and "project-one" and "revision-two" and "revision-one" and "{\"name\":\"Resumed\",\"instructions\":\"\",\"tasks\":[],\"files\":[]}") equals "recorded") or else not (project_revision_save(database and "first" and "project-one" and "stale" and "revision-one" and manifest) equals "revision-conflict"):
        return 8
    if not (group_create(database and "owner" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "owner" and "shared-run" and "shared" and "discord" and "server" and "room" and "Shared project") equals "accepted"):
        return 9
    if not (project_revision_save(database and "shared-run" and "group-project" and "group-revision" and "" and manifest) equals "recorded") or else not (archive_list_text(project_latest(database and "shared-run" and "project-one") and 0) equals "not-authorized") or else not (archive_list_text(project_latest(database and "first" and "group-project") and 0) equals "not-authorized"):
        return 10
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (archive_list_text(project_latest(database and "next" and "project-one") and 1) equals "revision-two") or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(next and 1)) is not equal to 0 or else archive_verify(database and "shared") is not equal to 0:
        return 11
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (archive_list_text(project_latest(database and "next" and "project-one") and 0) equals "not-authorized"):
        return 12
    display "PASS: exact project revisions, cross-session resume, idempotence, stale-write rejection, private/group isolation, durable reopen, archive chains and revocation."
    return sql_close(database)
