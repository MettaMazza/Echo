import "../fixtures/delegation_fixture"
import "../../app/tools/delegation_tool"
import "../../app/tools/job_control"
import "../../app/agent/generation"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    for each name in ["owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "owner" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "owner" and "parent" and "shared" and "discord" and "server" and "room" and "Group delegation") equals "accepted"):
        return 4
    if delegation_fixture_request(database and "parent" and "shared" and "child" and "{\"instruction\":\"Wait for cancellation fixture\"}") is not equal to 0 or else string_contains(delegation_tool_execute(database and "parent" and "child") and "materialized") equals 0:
        return 5
    set target to "{\"run\":\"parent:delegate:child\"}"
    if delegation_fixture_call(database and "parent" and "shared" and "status" and "delegation_status" and target) is not equal to 0:
        return 6
    set result to delegation_status_execute(database and "parent" and "status" and target)
    if string_contains(result and "\"state\":\"ready\"") equals 0:
        display result
        return 7
    if sql_execute(database and "UPDATE echo_tool_calls SET state='observed',result_event=request_event WHERE run='parent'; UPDATE echo_runs SET state='completed' WHERE run='parent';") is not equal to 0:
        return 30
    if not (group_run_submit(database and "owner" and "later" and "shared" and "discord" and "server" and "room" and "Inspect my earlier agent") equals "accepted"):
        return 31
    if delegation_fixture_call(database and "later" and "shared" and "later-status" and "delegation_status" and target) is not equal to 0 or else string_contains(delegation_status_execute(database and "later" and "later-status" and target) and "\"state\":\"ready\"") equals 0:
        return 32
    set child_session to "task:parent:delegate:child"
    if archive_append(database and child_session and "live-context" and "model_request" and "{\"messages\":[\"café live context tail\"]}" and "fixture") is not equal to 0:
        return 40
    set inspect to "{\"run\":\"parent:delegate:child\",\"history\":\"{\\\"event\\\":\\\"live-context\\\",\\\"offset\\\":0,\\\"characters\\\":200}\"}"
    if delegation_fixture_call(database and "later" and "shared" and "inspect" and "delegation_status" and inspect) is not equal to 0:
        return 41
    set inspected to delegation_status_execute(database and "later" and "inspect" and inspect)
    if string_contains(inspected and "café live context tail") equals 0 or else string_contains(inspected and "latest_context_event") equals 0 or else string_contains(inspected and "activity") equals 0:
        display inspected
        return 42
    set forbidden to "{\"run\":\"parent:delegate:child\",\"history\":\"{\\\"event\\\":\\\"parent:user\\\",\\\"offset\\\":0,\\\"characters\\\":200}\"}"
    if delegation_fixture_call(database and "later" and "shared" and "forbidden" and "delegation_status" and forbidden) is not equal to 0 or else string_contains(delegation_status_execute(database and "later" and "forbidden" and forbidden) and "Group delegation") > 0:
        return 43
    set separate to web_submit_owned(database and "owner" and "other-conversation" and "" and "Same owner, other conversation")
    if delegation_fixture_call(database and "other-conversation" and archive_list_text(separate and 1) and "other-status" and "delegation_status" and target) is not equal to 0 or else not (delegation_status_execute(database and "other-conversation" and "other-status" and target) equals "{\"status\":\"not-found\"}"):
        return 33
    set foreign to web_submit_owned(database and "foreign" and "foreign-run" and "" and "Foreign isolation")
    if not (archive_list_text(foreign and 0) equals "accepted") or else delegation_fixture_call(database and "foreign-run" and archive_list_text(foreign and 1) and "status" and "delegation_status" and target) is not equal to 0 or else not (delegation_status_execute(database and "foreign-run" and "status" and target) equals "{\"status\":\"not-found\"}"):
        return 8
    set guidance to "{\"run\":\"parent:delegate:child\",\"message\":\"Retain this exact instruction: orchid guidance.\"}"
    if delegation_fixture_call(database and "later" and "shared" and "message" and "delegation_message" and guidance) is not equal to 0:
        return 15
    set result to delegation_message_execute(database and "later" and "message" and guidance)
    if string_contains(result and "queued") equals 0 or else not (delegation_message_execute(database and "later" and "message" and guidance) equals result):
        display result
        return 16
    set result to delegation_status_execute(database and "parent" and "status" and target)
    if string_contains(result and "\"pending_messages\":1") equals 0 or else agent_guidance_apply(database and "parent:delegate:child") is not equal to 0:
        return 17
    set result to delegation_status_execute(database and "parent" and "status" and target)
    if string_contains(result and "\"pending_messages\":0") equals 0 or else string_contains(result and ":applied") equals 0 or else string_contains(delegation_message_execute(database and "later" and "message" and guidance) and "applied") equals 0:
        return 18
    if delegation_fixture_call(database and "foreign-run" and archive_list_text(foreign and 1) and "message" and "delegation_message" and guidance) is not equal to 0 or else not (delegation_message_execute(database and "foreign-run" and "message" and guidance) equals "{\"status\":\"not-found\"}"):
        return 19
    set cancellation to "{\"operation\":\"cancel\",\"run\":\"parent:delegate:child\"}"
    if delegation_fixture_call(database and "parent" and "shared" and "cancel" and "job_control" and cancellation) is not equal to 0:
        return 9
    set result to job_control_execute(database and "parent" and "cancel" and cancellation)
    if string_contains(result and "cancellation-requested") equals 0:
        display result
        return 10
    set result to delegation_status_execute(database and "parent" and "status" and target)
    if string_contains(result and "\"state\":\"cancelled\"") equals 0 or else string_contains(result and "result_digest") equals 0:
        display result
        return 11
    set child to agent_run_read(database and "parent:delegate:child")
    if archive_verify(database and "shared") is not equal to 0 or else archive_verify(database and archive_list_text(child and 0)) is not equal to 0:
        return 12
    if delegation_fixture_call(database and "parent" and "shared" and "late-message" and "delegation_message" and guidance) is not equal to 0 or else string_contains(delegation_message_execute(database and "parent" and "late-message" and guidance) and "not-delivered") equals 0:
        return 20
    display "PASS: idempotent child guidance, queued/applied receipts, foreign denial and terminal-task rejection."
    display "PASS: shared parent inspects and cancels isolated child, receives terminal provenance; foreign caller cannot inspect the child."
    set private_session to archive_list_text(separate and 1)
    if delegation_fixture_request(database and "other-conversation" and private_session and "private-child" and "{\"instruction\":\"Private child\"}") is not equal to 0 or else string_contains(delegation_tool_execute(database and "other-conversation" and "private-child") and "materialized") equals 0:
        return 34
    if sql_execute(database and "UPDATE echo_tool_calls SET state='observed',result_event=request_event WHERE run='other-conversation'; UPDATE echo_runs SET state='completed' WHERE run='other-conversation';") is not equal to 0:
        return 35
    set private_next to web_submit_owned(database and "owner" and "private-next" and private_session and "Inspect previous child")
    if not (archive_list_text(private_next and 0) equals "accepted"):
        return 36
    set private_target to "{\"run\":\"other-conversation:delegate:private-child\"}"
    if delegation_fixture_call(database and "private-next" and private_session and "status" and "delegation_status" and private_target) is not equal to 0 or else string_contains(delegation_status_execute(database and "private-next" and "status" and private_target) and "\"state\":\"ready\"") equals 0:
        return 37
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='owner';") is not equal to 0 or else string_contains(delegation_status_execute(database and "private-next" and "status" and private_target) and "not-authorized") equals 0:
        return 38
    display "PASS: private continuation and immediate device revocation."
    display "PASS: live context inspection and child-scoped history. Subsequent-turn status and guidance work; other conversations and foreign owners remain excluded."
    return sql_close(database)
