import "../fixtures/delegation_fixture"
import "../../app/agent/runner"
import "../../app/jobs/delegation_return"
import "../../app/jobs/task_checklist"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "parent" and "" and "Two tasks are already delegated by the application. When a child result arrives, immediately report its numeric answer. If another child is still running, say it is pending and return now. Do not wait, poll, start new tasks, or do further research.")
    set session to archive_list_text(submitted and 1)
    for each name in ["one","two"]:
        set instruction to "Compute 17 times 19 and return the answer 323 to Echo. This is the sole requirement. Use your task checklist; no research or other work is required."
        if name equals "two":
            set instruction to "Compute 23 times 29 and return the answer 667 to Echo. This is the sole requirement. Use your task checklist; no research or other work is required."
        set args to concat("{\"instruction\":" and concat(provider_quote(instruction) and "}"))
        if delegation_fixture_request(database and "parent" and session and name and args) is not equal to 0 or else not (delegation_materialize(database and "parent" and name) equals "materialized"):
            return 4
    if sql_execute(database and "UPDATE echo_tool_calls SET state='observed',result_event=request_event WHERE run='parent';") is not equal to 0:
        return 5
    set profile to provider_llama_profile(get_argument(2) and string_to_int(get_argument(3)))
    for each name in ["one","two"]:
        set child to concat("parent:delegate:" and name)
        set status to agent_loop_provider(database and child and profile and 2048 and -1 and 65536)
        if not (status equals "completed"):
            display status
            return 6
        if not (task_checklist_state(database and child) equals "complete"):
            display "Child returned without resolving its checklist."
            return 7
        if not (delegation_collect(database and "parent") equals "collected"):
            return 8
        if name equals "one" and not (archive_list_text(agent_run_read(database and "parent:delegate:two") and 2) equals "ready"):
            return 9
        set status to agent_loop_provider(database and "parent" and profile and 2048 and -1 and 65536)
        if not (status equals "completed"):
            display status
            return 10
        set parent to agent_run_read(database and "parent")
        set final to archive_read_event(database and archive_list_text(parent and 3))
        set expected to "323"
        if name equals "two":
            set expected to "667"
        if string_contains(archive_list_text(final and 3) and expected) equals 0:
            return 11
        display concat("PASS live child and parent report: " and name)
    set deliveries to history_collect_one(archive_prepare(database and "SELECT COUNT(*),COUNT(DISTINCT json_extract(j.value,'$.run')) FROM echo_events e,json_each(e.payload,'$.results') j WHERE e.kind='delegation_results';"))
    if not (archive_list_text(deliveries and 1) equals "2") or else not (archive_list_text(deliveries and 2) equals "2") or else not (delegation_collect(database and "parent") equals "none"):
        return 12
    if archive_verify(database and session) is not equal to 0:
        return 13
    display "PASS: actual local model used durable checklists and returned; parent reported first result with second child unfinished, then second result exactly once."
    return sql_close(database)
