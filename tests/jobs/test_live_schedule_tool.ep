import "../../app/agent/runner"
import "../../app/jobs/schedule_store"
import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set message to "Isolated schedule acceptance. Use only the schedule tool. Create a once-only schedule with instruction 'cedar schedule fixture', first_due 4102444800000 UTC milliseconds, interval_ms 0 and missed_policy catch-up. Inspect the identity returned by creation, then cancel that schedule. Do not request another task or tool. Once cancellation is confirmed, reply with schedule-interface-complete."
    set submitted to web_submit_owned(database and "owner" and "live-schedule" and "" and message)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "live-schedule" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set evidence to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(CASE WHEN c.status='cancelled' THEN 1 ELSE 0 END) FROM echo_schedules s JOIN echo_schedule_state c ON c.identity=s.identity WHERE s.origin_run='live-schedule' AND s.instruction='cedar schedule fixture' AND s.first_due=4102444800000 AND s.interval_ms=0;"))
    set inspected to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='live-schedule' AND json_extract(q.payload,'$.name')='schedule' AND json_extract(json_extract(q.payload,'$.arguments'),'$.operation')='inspect' AND json_extract(e.payload,'$.result.status')='found';"))
    if not (archive_list_text(evidence and 1) equals "1") or else not (archive_list_text(evidence and 2) equals "1") or else string_to_int(archive_list_text(inspected and 1)) < 1:
        return 6
    set final to agent_run_read(database and "live-schedule")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if reply equals 0 or else string_contains(archive_list_text(reply and 3) and "schedule-interface-complete") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual local model created, inspected and cancelled one exact schedule through the normal ReAct tool loop, then completed with the requested marker."
    return sql_close(database)
