import "../../app/jobs/delegation"
import "../../app/jobs/schedule_store"

import "../fixtures/delegation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied"):
        return 2
    for each name in ["owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set submitted to web_submit_owned(database and "owner" and "parent" and "" and "Delegate an isolated task")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    set instruction to "Read the exact source; preserve Unicode café, newlines\nand the final marker cedar-97."
    set arguments to concat("{\"instruction\":" and concat(provider_quote(instruction) and "}"))
    if delegation_fixture_request(database and "parent" and session and "child" and arguments) is not equal to 0 or else not (delegation_record(database and "parent" and "child") equals "recorded") or else not (delegation_record(database and "parent" and "child") equals "already-recorded"):
        return 5
    set record to archive_read_event(database and "parent:delegate:child:requested")
    set tokens to provider_json_tokens(archive_list_text(record and 3))
    set source to archive_read_event(database and "parent:call:child")
    if not (provider_value(tokens and provider_member(tokens and 0 and "instruction")) equals instruction) or else not (provider_value(tokens and provider_member(tokens and 0 and "request_digest")) equals archive_list_text(source and 6)):
        return 6
    set forged to "{\"instruction\":\"Do work\",\"role\":\"admin\"}"
    if delegation_fixture_request(database and "parent" and session and "forged" and forged) is not equal to 0 or else not (delegation_record(database and "parent" and "forged") equals "invalid-arguments") or else not (delegation_record(database and "foreign" and "child") equals "not-authorized"):
        return 7
    if not (group_create(database and "owner" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "owner" and "shared-parent" and "shared" and "discord" and "server" and "room" and "Shared task") equals "accepted"):
        return 8
    if delegation_fixture_request(database and "shared-parent" and "shared" and "child" and arguments) is not equal to 0 or else not (delegation_record(database and "shared-parent" and "child") equals "recorded"):
        return 9
    set record to archive_read_event(database and "shared-parent:delegate:child:requested")
    if not (archive_list_text(record and 0) equals "shared"):
        return 10
    if sql_close(database) is not equal to 0:
        return 11
    set database to archive_open(get_argument(1))
    if not (delegation_record(database and "parent" and "child") equals "already-recorded") or else archive_verify(database and session) is not equal to 0 or else archive_verify(database and "shared") is not equal to 0:
        return 12
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='delegation_requested';"))
    if not (archive_list_text(count and 1) equals "2"):
        return 13
    if not (principal_host_role(database and "promote" and "device:owner" and "admin" and "fixture") equals "recorded") or else not (delegation_record(database and "parent" and "child") equals "not-authorized") or else not (delegation_record(database and "shared-parent" and "child") equals "not-authorized"):
        return 14
    display "PASS: exact private/shared delegation requests, source digests, no asserted roles, durable idempotent reopen and no authority elevation. Admission records only; no child execution claimed."
    return sql_close(database)
