import "../fixtures/delegation_fixture"
import "../../app/web/worker"
import "../../app/security/group_route"
import "../../app/context/session_messages"

define main returning Int:
    if (get_argument_count() is not equal to 2 and get_argument_count() is not equal to 4) or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "parent" and "" and "Private parent context excluded: private-parent-secret-marker")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if not (group_create(database and "owner" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "owner" and "group-parent" and "shared" and "discord" and "server" and "room" and "Group parent context excluded: group-parent-secret-marker") equals "accepted"):
        return 5
    # Migrate populated groups, preserving existing origins and all references.
    if not (delegation_schema(database) equals "applied") or else not (delegation_schema(database) equals "already-applied"):
        return 6
    set mode to history_collect_one(archive_prepare(database and "PRAGMA foreign_keys;"))
    set integrity to history_collect_one(archive_prepare(database and "PRAGMA foreign_key_check;"))
    if not (archive_list_text(mode and 1) equals "1") or else not (archive_list_text(integrity and 0) equals "end"):
        return 7
    set instruction to "Isolated delegated task: reply exactly delegation-worker-cedar. Use no tools."
    set arguments to concat("{\"instruction\":" and concat(provider_quote(instruction) and "}"))
    for each item in ["parent","group-parent"]:
        set parent to ptr_to_str(item)
        set parent_run to agent_run_read(database and parent)
        if delegation_fixture_request(database and parent and archive_list_text(parent_run and 0) and "child" and arguments) is not equal to 0 or else not (delegation_materialize(database and parent and "child") equals "materialized") or else not (delegation_materialize(database and parent and "child") equals "already-materialized"):
            return 8
        set child to concat(parent and ":delegate:child")
        set row to agent_run_read(database and child)
        if not (archive_list_text(row and 0) equals concat("task:" and child)) or else run_authority_allows(database and child and "user") is not equal to 1 or else run_authority_allows(database and child and "admin") is not equal to 0:
            return 9
        set messages to session_messages(database and archive_list_text(row and 0) and child)
        if string_length(messages) equals 0 or else string_contains(messages and "parent-secret-marker") is not equal to 0 or else string_contains(messages and "delegation-worker-cedar") is not equal to 1:
            return 10
        if get_argument_count() equals 4:
            if web_worker_claim(database and child and concat(child and ":worker")) is not equal to 0 or else web_worker_run_owned(get_argument(1) and child and concat(child and ":worker") and get_argument(2) and string_to_int(get_argument(3)) and 2048 and 65536) is not equal to 0:
                return 11
            set final to agent_run_read(database and child)
            set reply to archive_read_event(database and archive_list_text(final and 3))
            if not (archive_list_text(final and 2) equals "completed") or else string_contains(archive_list_text(reply and 3) and "delegation-worker-cedar") equals 0:
                return 12
        if archive_verify(database and archive_list_text(row and 0)) is not equal to 0:
            return 13
    set route to group_route(database and "owner" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(route and 0) equals "routed") or else not (archive_list_text(route and 1) equals "shared") or else string_length(memory_archive_principal(database and "group-parent:delegate:child")) is not equal to 0:
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    if not (delegation_materialize(database and "parent" and "child") equals "already-materialized") or else not (delegation_materialize(database and "group-parent" and "child") equals "already-materialized"):
        return 16
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_delegations;"))
    if not (archive_list_text(count and 1) equals "2"):
        return 17
    if not (principal_host_role(database and "promote" and "device:owner" and "admin" and "fixture") equals "recorded") or else run_authority_allows(database and "parent:delegate:child" and "user") is not equal to 0 or else run_authority_allows(database and "group-parent:delegate:child" and "user") is not equal to 0:
        return 18
    display "PASS: populated group migration, independent private/shared child context, canonical routing, exact authority, idempotent reopen, archive integrity and later authority invalidation."
    if get_argument_count() equals 4:
        display "PASS: both private and shared child runs completed through the ordinary worker with the actual local model while parent runs remained active."
    return sql_close(database)
