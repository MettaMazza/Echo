import "../fixtures/tool_call_fixture"
import "../../app/jobs/schedule_run"

define schedule_fixture_status with result as Str returning Str:
    set tokens to provider_json_tokens(result)
    return provider_value(tokens and provider_member(tokens and 0 and "status"))

# The current dispatch contract requires assigned work before tool execution.
define schedule_test_call with database as Int and device as Str and run as Str and name as Str and arguments as Str returning Str:
    set submitted to web_submit_owned(database and device and run and "" and "Verify my schedule controls.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return "submit-failed"
    set checklist to "{\"items\":[{\"id\":\"schedule\",\"requirement\":\"Verify my schedule controls\",\"status\":\"pending\",\"evidence\":\"\"}]}"
    set saved to task_checklist_save(database and run and "plan" and checklist)
    if string_contains(saved and "\"status\":\"saved\"") equals 0:
        return saved
    return tool_fixture_call(database and device and run and name and arguments)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    for each name in ["owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set created to schedule_test_call(database and "owner" and "create" and "schedule" and "{\"operation\":\"create\",\"instruction\":\"Remember the cedar marker\",\"first_due\":1000,\"interval_ms\":100,\"missed_policy\":\"coalesce\"}")
    if not (schedule_fixture_status(created) equals "created"):
        display created
        return 4
    set origin to agent_run_read(database and "create")
    set created_fields to provider_json_tokens(created)
    if not (provider_value(created_fields and provider_member(created_fields and 0 and "session")) equals archive_list_text(origin and 0)):
        return 13
    set listed to schedule_test_call(database and "owner" and "list" and "schedule" and "{\"operation\":\"list\",\"after\":0}")
    if not (schedule_fixture_status(listed) equals "found") or else string_contains(listed and "Remember the cedar marker") equals 0:
        display listed
        return 5
    set listed_fields to provider_json_tokens(listed)
    if not (provider_value(listed_fields and provider_member(listed_fields and 0 and "session")) equals archive_list_text(origin and 0)):
        return 14
    set hidden to schedule_test_call(database and "foreign" and "hidden" and "schedule" and "{\"operation\":\"inspect\",\"identity\":\"create:schedule:jobs\"}")
    if not (schedule_fixture_status(hidden) equals "end"):
        return 6
    set due to schedule_take_due(database and "create:schedule:jobs" and 1450)
    if not (due equals "create:schedule:jobs:due:1400"):
        return 7
    set occurrences to schedule_test_call(database and "owner" and "occurrences" and "schedule" and "{\"operation\":\"occurrences\",\"identity\":\"create:schedule:jobs\",\"after\":0}")
    if not (schedule_fixture_status(occurrences) equals "found") or else string_contains(occurrences and "reserved") equals 0 or else string_contains(occurrences and "1400") equals 0:
        return 8
    set forged to schedule_test_call(database and "owner" and "forged" and "schedule" and "{\"operation\":\"list\",\"after\":0,\"principal\":\"device:foreign\"}")
    if not (schedule_fixture_status(forged) equals "invalid-arguments"):
        return 9
    set cancelled to schedule_test_call(database and "owner" and "cancel" and "schedule" and "{\"operation\":\"cancel\",\"identity\":\"create:schedule:jobs\"}")
    if not (schedule_fixture_status(cancelled) equals "cancelled") or else not (schedule_take_due(database and "create:schedule:jobs" and 1500) equals "cancelled"):
        return 10
    set discovery to tool_discovery_execute(database and "list" and "{\"query\":\"schedule\",\"after\":0,\"catalog_digest\":\"\"}")
    if string_contains(discovery and "jobs.schedule") equals 0:
        display discovery
        return 11
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (schedule_fixture_status(schedule_tool_execute(database and "list" and "jobs" and "{\"operation\":\"list\",\"after\":0}")) equals "not-authorized"):
        return 12
    display "PASS: schedule create/list/inspect/occurrences/cancel through real streamed tool dispatch, foreign isolation, scoped discovery contract, rejected forged scope and revocation."
    return sql_close(database)
