import "../../app/jobs/schedule_run"
import "../../app/agent/control"
import "../fixtures/schedule_fixture"

# Optional model/port runs the actual normal worker after native admission checks.
define main returning Int:
    if (get_argument_count() is not equal to 2 and get_argument_count() is not equal to 4) or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0 or else schedule_fixture_origin(database and "owner" and "origin") is not equal to 0:
        return 3
    set instruction to "This is an isolated scheduling test. Reply exactly with the marker: schedule-worker-cedar."
    if not (schedule_create(database and "origin" and "schedule" and instruction and 1000 and 0 and "catch-up") equals "created"):
        return 4
    set occurrence to schedule_take_due(database and "origin:schedule:schedule" and 1000)
    if not (schedule_materialize(database and occurrence) equals "session-active") or else agent_cancel_run(database and "origin") is not equal to 0:
        return 5
    if not (schedule_materialize(database and occurrence) equals "materialized") or else not (schedule_materialize(database and occurrence) equals "already-materialized"):
        return 6
    set row to agent_run_read(database and occurrence)
    set original to archive_read_event(database and archive_list_text(row and 1))
    if not (archive_list_text(row and 0) equals "session:origin") or else not (archive_list_text(original and 3) equals instruction) or else run_authority_allows(database and occurrence and "admin") is not equal to 0:
        return 7
    if sql_close(database) is not equal to 0:
        return 8
    set database to archive_open(get_argument(1))
    if not (schedule_materialize(database and occurrence) equals "already-materialized") or else web_worker_claim(database and occurrence and "schedule-fixture-worker") is not equal to 0:
        return 9
    if get_argument_count() equals 4:
        if web_worker_run_owned(get_argument(1) and occurrence and "schedule-fixture-worker" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and 65536) is not equal to 0:
            return 10
        set final to agent_run_read(database and occurrence)
        set reply to archive_read_event(database and archive_list_text(final and 3))
        if not (archive_list_text(final and 2) equals "completed") or else string_contains(archive_list_text(reply and 3) and "schedule-worker-cedar") equals 0:
            return 11
        display "PASS: actual primary-model worker completed the scheduled occurrence and archived its marker."
    if not (group_create(database and "owner" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "owner" and "shared-origin" and "shared" and "discord" and "server" and "room" and "Shared schedule") equals "accepted"):
        return 14
    if archive_append(database and "shared" and "shared-call" and "tool_call" and "{\"run_id\":\"shared-origin\",\"call_id\":\"schedule\",\"name\":\"schedule_fixture\",\"arguments\":\"{}\"}" and "fixture") is not equal to 0 or else tool_ledger_queue(database and "shared-origin" and "schedule" and "shared" and "shared-call") is not equal to 0:
        return 15
    if not (schedule_create(database and "shared-origin" and "schedule" and "Shared reminder" and 1000 and 0 and "catch-up") equals "created") or else agent_cancel_run(database and "shared-origin") is not equal to 0:
        return 16
    set shared_due to schedule_take_due(database and "shared-origin:schedule:schedule" and 1000)
    if not (schedule_materialize(database and shared_due) equals "materialized") or else group_run_session_allows(database and shared_due and "shared") is not equal to 1:
        return 17
    set shared_run to agent_run_read(database and shared_due)
    if not (archive_list_text(shared_run and 0) equals "shared") or else string_length(memory_archive_principal(database and shared_due)) is not equal to 0:
        return 18
    if not (principal_host_role(database and "promote" and "device:owner" and "admin" and "fixture") equals "recorded") or else run_authority_allows(database and occurrence and "user") is not equal to 0 or else not (schedule_materialize(database and occurrence) equals "authority-changed"):
        return 12
    if archive_verify(database and "session:origin") is not equal to 0:
        return 13
    display "PASS: atomic scheduled-run admission, busy-session deferral, exact instruction/provenance, retry/reopen without duplicate run, normal worker claim and no later permission elevation."
    return sql_close(database)
