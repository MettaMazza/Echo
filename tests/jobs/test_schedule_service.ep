import "../../app/jobs/schedule_service"
import "../../app/agent/control"
import "../fixtures/schedule_fixture"

define main returning Int:
    if get_argument_count() < 3:
        return 1
    set mode to get_argument(1)
    if mode equals "prepare":
        if get_argument_count() is not equal to 6 or else file_exists(get_argument(2)) or else file_exists(get_argument(5)):
            return 2
        set database to archive_open(get_argument(2))
        if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
            return 3
        set profile to provider_llama_profile(get_argument(3) and string_to_int(get_argument(4)))
        if provider_registry_initialize(database and profile) is not equal to 0 or else write_file(get_argument(5) and profile) is not equal to 1:
            return 4
        if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0 or else schedule_fixture_origin(database and "owner" and "origin") is not equal to 0:
            return 5
        if not (schedule_create(database and "origin" and "schedule" and "Isolated scheduler process test: reply exactly scheduler-process-cedar and use no tools." and ep_time_now_ms() and 0 and "catch-up") equals "created") or else agent_cancel_run(database and "origin") is not equal to 0:
            return 6
        display "PREPARED: isolated due schedule and exact provider profile."
        return sql_close(database)
    if not (mode equals "verify") or else get_argument_count() is not equal to 3:
        return 7
    set database to archive_open(get_argument(2))
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(CASE WHEN r.state='completed' AND w.status='completed' AND instr(e.payload,'scheduler-process-cedar')>0 THEN 1 ELSE 0 END) FROM echo_schedule_occurrences o JOIN echo_runs r ON r.run=o.identity JOIN echo_web_workers w ON w.run=r.run JOIN echo_events e ON e.event=r.last_event;"))
    if not (archive_list_text(row and 1) equals "1") or else not (archive_list_text(row and 2) equals "1"):
        display "Scheduled worker is not yet complete or occurrence count is wrong."
        return 8
    set origins to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='scheduled_run_origin';"))
    set diagnostics to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='schedule_dispatch_status' AND json_extract(payload,'$.status')='worker-started';"))
    if not (archive_list_text(origins and 1) equals "1") or else not (archive_list_text(diagnostics and 1) equals "1") or else archive_verify(database and "session:origin") is not equal to 0:
        return 9
    display "PASS: automatic scheduler reserved one occurrence, created one run, launched its owned OS worker, completed with the local model marker and retained dispatch provenance without duplicates."
    return sql_close(database)
