import "../fixtures/delegation_fixture"
import "../../app/jobs/delegation_return"
import "../../app/context/session_messages"
import "../../app/web/work_status"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "parent" and "" and "Combine both delegated results.")
    set session to archive_list_text(submitted and 1)
    for each name in ["one","two"]:
        if delegation_fixture_request(database and "parent" and session and name and "{\"instruction\":\"Return the full result.\"}") is not equal to 0 or else not (delegation_materialize(database and "parent" and name) equals "materialized"):
            return 4
    if not (delegation_collect(database and "parent") equals "pending"):
        return 5
    if sql_execute(database and "UPDATE echo_tool_calls SET state='observed',result_event=request_event WHERE run='parent';") is not equal to 0:
        return 6
    for each name in ["one","two"]:
        set child to concat("parent:delegate:" and name)
        set row to agent_run_read(database and child)
        set event to concat(child and ":final")
        set payload to concat(agent_event_envelope(child and archive_list_text(row and 3)) and concat(",\"content\":" and concat(provider_quote(concat("Full café result " and name)) and "}")))
        if archive_append(database and archive_list_text(row and 0) and event and "assistant_final" and payload and "fixture") is not equal to 0:
            return 7
        if archive_finish(checkpoint_prepare(database and "UPDATE echo_runs SET state='completed',last_event=? WHERE run=?;" and [event,child]) and 101) is not equal to 0:
            return 8
        if name equals "one" and not (delegation_collect(database and "parent") equals "collected"):
            return 9
        if name equals "one" and not (delegation_collect(database and "parent") equals "none"):
            return 18
    # A parent that already answered must also wake once its outstanding children finish.
    set prior to agent_run_read(database and "parent")
    set final_payload to concat(agent_event_envelope("parent" and archive_list_text(prior and 3)) and ",\"content\":\"Delegated work is still running.\"}")
    if archive_append(database and session and "parent:early-final" and "assistant_final" and final_payload and "fixture") is not equal to 0 or else sql_execute(database and "UPDATE echo_runs SET state='completed',last_event='parent:early-final' WHERE run='parent';") is not equal to 0:
        return 16
    if not (delegation_collect(database and "parent") equals "collected") or else not (delegation_collect(database and "parent") equals "none"):
        return 10
    set deliveries to history_collect_one(archive_prepare(database and "SELECT COUNT(*),COUNT(DISTINCT json_extract(j.value,'$.run')) FROM echo_events e,json_each(e.payload,'$.results') j WHERE e.kind='delegation_results';"))
    if not (archive_list_text(deliveries and 1) equals "2") or else not (archive_list_text(deliveries and 2) equals "2"):
        return 17
    set messages to agent_run_messages(database and "parent")
    if string_contains(messages and "Full café result one") equals 0 or else string_contains(messages and "Full café result two") equals 0 or else string_contains(messages and "not a new user message") equals 0:
        return 11
    set sessions to web_device_sessions(database and "owner")
    if string_contains(sessions and "task:parent") > 0 or else string_contains(sessions and session) equals 0:
        return 12
    set current to agent_run_read(database and "parent")
    if string_contains(recap_sources(database and session and archive_list_text(current and 3)) and "Full café result two") equals 0 or else archive_verify(database and session) is not equal to 0:
        return 13
    if sql_close(database) is not equal to 0:
        return 14
    set database to archive_open(get_argument(1))
    if not (delegation_collect(database and "parent") equals "none"):
        return 15
    display "PASS: first child returns while its sibling runs; parent receives each complete Unicode result once in durable context and compaction sources, survives reopen without duplicate delivery, and child sessions stay out of the chat list. Synthetic child completion."
    return sql_close(database)
