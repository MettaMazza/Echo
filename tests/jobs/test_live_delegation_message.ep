import "../fixtures/delegation_fixture"
import "../../app/tools/delegation_tool"
import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set mode to get_argument(1)
    set path to get_argument(2)
    if mode equals "prepare":
        if file_exists(path):
            return 2
        set database to archive_open(path)
        if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
            return 3
        if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
            return 4
        set parent to web_submit_owned(database and "owner" and "parent" and "" and "Delegation messaging acceptance")
        if not (archive_list_text(parent and 0) equals "accepted"):
            return 5
        set arguments to "{\"instruction\":\"Use no tools. Write a detailed explanation of the history of mathematics, discussing each historical period.\"}"
        if delegation_fixture_request(database and "parent" and archive_list_text(parent and 1) and "child" and arguments) is not equal to 0 or else not (delegation_materialize(database and "parent" and "child") equals "materialized"):
            return 6
        return sql_close(database)
    if not file_exists(path):
        return 7
    set database to archive_open(path)
    if database equals 0:
        return 8
    if mode equals "message":
        set child to agent_run_read(database and "parent:delegate:child")
        if not (archive_list_text(child and 2) equals "generating"):
            return 9
        set message to "{\"run\":\"parent:delegate:child\",\"message\":\"New guidance from the parent task: abandon the historical explanation and reply exactly guided-nectarine-583. Use no tools.\"}"
        if delegation_fixture_call(database and "parent" and "session:parent" and "mid-turn" and "delegation_message" and message) is not equal to 0:
            return 10
        set result to delegation_message_execute(database and "parent" and "mid-turn" and message)
        display result
        if string_contains(result and "queued") equals 0 and string_contains(result and "applied") equals 0:
            return 11
        return sql_close(database)
    if not (mode equals "verify"):
        return 12
    set child to agent_run_read(database and "parent:delegate:child")
    set final to archive_read_event(database and archive_list_text(child and 3))
    set final_payload to provider_json_tokens(archive_list_text(final and 3))
    if not (archive_list_text(child and 2) equals "completed") or else not (string_trim(provider_value(final_payload and provider_member(final_payload and 0 and "content"))) equals "guided-nectarine-583"):
        return 13
    set evidence to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events g JOIN echo_events a ON a.kind='user_guidance' AND json_extract(a.payload,'$.source_event')=g.event WHERE g.kind='guidance_received' AND json_extract(g.payload,'$.run_id')='parent:delegate:child' AND EXISTS(SELECT 1 FROM echo_events q WHERE q.kind='model_request' AND json_extract(q.payload,'$.run_id')='parent:delegate:child' AND q.sequence<g.sequence AND instr(q.payload,'guided-nectarine-583')=0) AND EXISTS(SELECT 1 FROM echo_events q WHERE q.kind='model_request' AND json_extract(q.payload,'$.run_id')='parent:delegate:child' AND q.sequence>a.sequence AND instr(q.payload,'guided-nectarine-583')>0);"))
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_runs;"))
    if not (archive_list_text(evidence and 1) equals "1") or else not (archive_list_text(counts and 1) equals "2") or else archive_verify(database and archive_list_text(child and 0)) is not equal to 0:
        return 14
    display "PASS: message arrived during child generation, was applied once in the same run, entered the next request and changed the actual local-model final reply."
    return sql_close(database)
