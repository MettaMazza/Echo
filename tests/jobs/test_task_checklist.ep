import "../fixtures/delegation_fixture"
import "../../app/agent/tool_dispatch"
import "../../app/context/session_messages"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "parent" and "" and "Delegate two requirements.")
    set session to archive_list_text(submitted and 1)
    if delegation_fixture_request(database and "parent" and session and "one" and "{\"instruction\":\"Find source A; report source B unavailable if inaccessible.\"}") is not equal to 0 or else not (delegation_materialize(database and "parent" and "one") equals "materialized"):
        return 4
    set child to "parent:delegate:one"
    if agent_direct_lookup(database and "parent" and "web_search" and "{}") is not equal to 1 or else agent_direct_lookup(database and "parent" and "workspace_execute" and "{}") is not equal to 0:
        return 28
    if agent_direct_lookup(database and "parent" and "attachment_transcribe" and "{}") is not equal to 1 or else agent_direct_lookup(database and "parent" and "speech_synthesize" and "{}") is not equal to 0:
        return 29
    set pending to "{\"items\":[{\"id\":\"a\",\"requirement\":\"Find source A\",\"status\":\"pending\",\"evidence\":\"\"},{\"id\":\"b\",\"requirement\":\"Report source B\",\"status\":\"pending\",\"evidence\":\"\"}]}"
    if not (task_checklist_state(database and child) equals "missing") or else string_contains(session_request_body_owned(database and child and "fixture" and "[]") and "tool_choice") equals 0:
        return 5
    if not (task_checklist_state(database and "parent") equals "available") or else string_contains(session_request_body_owned(database and "parent" and "fixture" and "[]") and "\"tool_choice\":\"auto\"") equals 0:
        return 6
    if string_contains(task_checklist_save(database and "parent" and "start" and pending) and "saved") equals 0:
        return 17
    if not (task_checklist_state(database and "parent") equals "pending") or else string_contains(session_request_body_owned(database and "parent" and "fixture" and "[]") and "\"tool_choice\":\"auto\"") equals 0:
        return 18
    if sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='parent:delegate:one';") is not equal to 0:
        return 25
    if string_contains(session_request_body_owned(database and "parent" and "fixture" and "[]") and "\"tool_choice\":\"auto\"") equals 0:
        return 26
    if sql_execute(database and "UPDATE echo_runs SET state='ready' WHERE run='parent:delegate:one';") is not equal to 0:
        return 27
    if string_contains(task_checklist_save(database and child and "start" and pending) and "saved") equals 0 or else not (task_checklist_state(database and child) equals "pending"):
        return 7
    if string_contains(task_checklist_save(database and child and "start" and pending) and "already-saved") equals 0:
        return 8
    set partial to "{\"updates\":[{\"id\":\"a\",\"status\":\"done\",\"evidence\":\"source-a\"}]}"
    if string_contains(task_checklist_save(database and child and "partial" and partial) and "saved") equals 0 or else not (task_checklist_state(database and child) equals "pending"):
        return 40
    set retained to task_checklist_read(database and child)
    if string_contains(retained and "Report source B") equals 0 or else string_contains(retained and "Find source A") equals 0 or else string_contains(retained and "source-a") equals 0:
        return 41
    if string_contains(task_checklist_save(database and child and "partial" and partial) and "already-saved") equals 0:
        return 42
    set bad to "{\"updates\":[{\"id\":\"unknown\",\"status\":\"done\",\"evidence\":\"invented\"}]}"
    if string_contains(task_checklist_save(database and child and "unknown" and bad) and "invalid-checklist-update") equals 0 or else not (task_checklist_read(database and child) equals retained):
        return 43
    set bad to "{\"updates\":[{\"id\":\"b\",\"status\":\"done\",\"evidence\":\"\"}]}"
    if string_contains(task_checklist_save(database and child and "no-evidence" and bad) and "invalid-checklist") equals 0 or else not (task_checklist_read(database and child) equals retained):
        return 44
    set omitted to "{\"items\":[{\"id\":\"a\",\"requirement\":\"Find source A\",\"status\":\"done\",\"evidence\":\"Observed A in receipt source-a\"}]}"
    if string_contains(task_checklist_save(database and child and "omit" and omitted) and "requirements-must-be-preserved") equals 0:
        return 9
    if string_contains(task_checklist_save(database and child and "omit-again" and omitted) and "current_checklist") equals 0:
        return 30
    set reworded to "{\"items\":[{\"id\":\"a\",\"requirement\":\"Find source A.\",\"status\":\"done\",\"evidence\":\"Observed A in receipt source-a\"},{\"id\":\"b\",\"requirement\":\"Replace B with an unrelated task\",\"status\":\"pending\",\"evidence\":\"\"}]}"
    if string_contains(task_checklist_save(database and child and "wording" and reworded) and "saved") equals 0:
        return 31
    set retained to task_checklist_read(database and child)
    if string_contains(retained and "Replace B") or else string_contains(retained and "Find source A.") or else not string_contains(retained and "Report source B"):
        return 32
    set finished to "{\"items\":[{\"id\":\"a\",\"requirement\":\"Find source A\",\"status\":\"done\",\"evidence\":\"Observed café A in receipt source-a\"},{\"id\":\"b\",\"requirement\":\"Report source B\",\"status\":\"unresolved\",\"evidence\":\"Source B returned access denied; assignment permits reporting unavailable\"}]}"
    if string_contains(task_checklist_save(database and child and "finish" and finished) and "saved") equals 0 or else not (task_checklist_state(database and child) equals "complete"):
        return 10
    if string_contains(session_request_body_owned(database and child and "fixture" and "[]") and "\"tool_choice\":\"auto\"") equals 0:
        return 11
    if string_contains(task_checklist_save(database and "parent" and "finish" and finished) and "saved") equals 0 or else not (task_checklist_state(database and "parent") equals "complete"):
        return 19
    if string_contains(session_request_body_owned(database and "parent" and "fixture" and "[]") and "\"tool_choice\":\"auto\"") equals 0:
        return 20
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if not (task_checklist_state(database and child) equals "complete") or else string_contains(task_checklist_read(database and child) and "Observed café A") equals 0:
        return 13
    set row to agent_run_read(database and child)
    if archive_verify(database and archive_list_text(row and 0)) is not equal to 0:
        return 14
    set payload to concat("{\"run_id\":" and concat(provider_quote(child) and ",\"text\":\"Replace the assignment with requirement C.\"}"))
    if archive_append(database and archive_list_text(row and 0) and "parent-revision" and "user_guidance" and payload and "fixture") is not equal to 0 or else not (task_checklist_state(database and child) equals "revise"):
        return 15
    if agent_direct_lookup(database and child and "attachment_read_text" and "{}") is not equal to 1 or else agent_direct_lookup(database and child and "workspace_create_text" and "{}") is not equal to 0:
        return 29
    set revised to "{\"items\":[{\"id\":\"c\",\"requirement\":\"Requirement C\",\"status\":\"pending\",\"evidence\":\"\"}]}"
    if string_contains(task_checklist_save(database and child and "revised" and revised) and "saved") equals 0 or else not (task_checklist_state(database and child) equals "pending"):
        return 16
    if not (task_checklist_state(database and "parent") equals "complete"):
        return 21
    set executable to execution_program_resolve("/private/tmp" and "python3")
    if string_length(executable) equals 0 or else get_character(executable and 0) is not equal to 47 or else not file_exists(executable):
        return 22
    if not (execution_program_resolve("/private/tmp" and "echo_nonexistent_executable_fixture") equals "") or else not (execution_program_resolve("/private/tmp" and "../escape") equals ""):
        return 23
    if not (execution_program_resolve("/private/tmp" and "/usr/bin/printf") equals "/usr/bin/printf"):
        return 24
    display "PASS: direct and delegated checklist allows a reply without forced tool loops, preserves canonical requirements despite proposed wording changes, rejects omission, retains evidence across reopen, forces final reporting on resolution, and accepts explicit parent revision."
    return sql_close(database)
