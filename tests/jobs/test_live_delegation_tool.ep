import "../../app/agent/runner"
import "../../app/jobs/delegation_schema"
import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set message to "Acceptance task: use delegate_task exactly once with the instruction 'Reply exactly child-orchid-729. Use no tools.' Keep its returned run identity. Use delegation_status to inspect that child until completed (the scheduler launches it automatically). Only after reading its completed result, reply parent-received-orchid-729. Do not use any other tools or invent completion."
    set submitted to web_submit_owned(database and "owner" and "delegation-parent" and "" and message)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "delegation-parent" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set children to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(CASE WHEN r.state='completed' AND w.status='completed' AND instr(e.payload,'child-orchid-729')>0 THEN 1 ELSE 0 END) FROM echo_delegations d JOIN echo_runs r ON r.run=d.child JOIN echo_events e ON e.event=r.last_event JOIN echo_web_workers w ON w.run=r.run WHERE d.parent='delegation-parent';"))
    set readback to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='delegation-parent' AND json_extract(q.payload,'$.name')='delegation_status' AND json_extract(e.payload,'$.result.state')='completed' AND instr(json_extract(e.payload,'$.result.result_payload'),'child-orchid-729')>0;"))
    if not (archive_list_text(children and 1) equals "1") or else not (archive_list_text(children and 2) equals "1") or else string_to_int(archive_list_text(readback and 1)) < 1:
        return 6
    set final to agent_run_read(database and "delegation-parent")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if string_contains(archive_list_text(reply and 3) and "parent-received-orchid-729") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual model delegated once; scheduler launched isolated child; parent retrieved complete child result and finished with expected marker."
    return sql_close(database)
