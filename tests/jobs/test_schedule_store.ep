import "../fixtures/schedule_fixture"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied"):
        return 2
    for each name in ["owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    for each name in ["once","catchup","coalesce","cancel","revoked"]:
        if schedule_fixture_origin(database and "owner" and ptr_to_str(name)) is not equal to 0:
            return 4
    if schedule_fixture_origin(database and "foreign" and "foreign-run") is not equal to 0:
        return 5
    if not (schedule_create(database and "once" and "schedule" and "One reminder" and 1000 and 0 and "catch-up") equals "created") or else not (schedule_create(database and "once" and "schedule" and "One reminder" and 1000 and 0 and "catch-up") equals "already-created") or else not (schedule_create(database and "once" and "schedule" and "Changed" and 1000 and 0 and "catch-up") equals "schedule-conflict"):
        return 6
    if not (schedule_take_due(database and "once:schedule:schedule" and 999) equals "not-due") or else not (schedule_take_due(database and "once:schedule:schedule" and 1000) equals "once:schedule:schedule:due:1000") or else not (schedule_take_due(database and "once:schedule:schedule" and 2000) equals "exhausted"):
        return 7
    if not (schedule_create(database and "catchup" and "schedule" and "Every interval" and 1000 and 100 and "catch-up") equals "created") or else not (schedule_create(database and "coalesce" and "schedule" and "Latest interval" and 1000 and 100 and "coalesce") equals "created"):
        return 8
    if not (schedule_take_due(database and "catchup:schedule:schedule" and 1450) equals "catchup:schedule:schedule:due:1000") or else not (schedule_take_due(database and "coalesce:schedule:schedule" and 1450) equals "coalesce:schedule:schedule:due:1400") or else not (schedule_take_due(database and "coalesce:schedule:schedule" and 1450) equals "not-due"):
        return 9
    if not (schedule_cancel(database and "foreign-run" and "schedule" and "catchup:schedule:schedule") equals "not-found") or else not (schedule_cancel(database and "cancel" and "schedule" and "catchup:schedule:schedule") equals "cancelled") or else not (schedule_cancel(database and "cancel" and "schedule" and "catchup:schedule:schedule") equals "already-cancelled") or else not (schedule_take_due(database and "catchup:schedule:schedule" and 1450) equals "cancelled"):
        return 10
    set rows to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(missed_intervals) FROM echo_schedule_occurrences;"))
    if not (archive_list_text(rows and 1) equals "3") or else not (archive_list_text(rows and 2) equals "4"):
        return 11
    if not (schedule_create(database and "revoked" and "schedule" and "No authority escalation" and 2000 and 100 and "catch-up") equals "created"):
        return 12
    if sql_close(database) is not equal to 0:
        return 13
    set database to archive_open(get_argument(1))
    if not (schedule_schema(database) equals "already-applied") or else not (schedule_take_due(database and "coalesce:schedule:schedule" and 1500) equals "coalesce:schedule:schedule:due:1500"):
        return 14
    if not (principal_host_role(database and "promote" and "device:owner" and "admin" and "fixture") equals "recorded") or else not (schedule_take_due(database and "revoked:schedule:schedule" and 2000) equals "authority-changed"):
        return 15
    if sql_execute(database and "UPDATE echo_schedules SET instruction='changed';") equals 0 or else sql_execute(database and "DELETE FROM echo_schedule_occurrences;") equals 0:
        return 16
    if not (schedule_create(database and "foreign-run" and "schedule" and "" and 0 and 0 and "catch-up") equals "invalid-schedule"):
        return 17
    display "PASS: schedule persistence, exact retries/conflicts, once/recurring due times, explicit catch-up/coalescing, cancellation isolation, immutable occurrence recovery after reopen, and no promotion of queued authority. Storage only; no scheduled model execution claimed."
    return sql_close(database)
