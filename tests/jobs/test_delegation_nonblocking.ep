import "../fixtures/delegation_fixture"
import "../../app/agent/runner"
import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "parent" and "" and "Chat while the child is working.")
    set session to archive_list_text(submitted and 1)
    if delegation_fixture_request(database and "parent" and session and "one" and "{\"instruction\":\"Work independently.\"}") is not equal to 0 or else not (delegation_materialize(database and "parent" and "one") equals "materialized"):
        return 4
    if sql_execute(database and "UPDATE echo_tool_calls SET state='observed',result_event=request_event WHERE run='parent';") is not equal to 0:
        return 5
    set profile to provider_llama_profile(get_argument(2) and string_to_int(get_argument(3)))
    if not (agent_loop_provider(database and "parent" and profile and 2048 and -1 and 65536) equals "completed"):
        return 6
    if not (archive_list_text(agent_run_read(database and "parent:delegate:one") and 2) equals "ready"):
        return 7
    if not (delegation_collect(database and "parent") equals "pending"):
        return 8
    display "PASS: parent answered while child remained unfinished; result collection remains pending."
    return sql_close(database)
