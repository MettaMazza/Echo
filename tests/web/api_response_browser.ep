# Browser fixture linked with client.ep after renaming its application main.
# It exercises the real echo_api path with gateway and truncated-body failures.
define main:
    set original_fetch to window.fetch
    set window.echoToken to "synthetic-test-credential"
    set retained to window.localStorage.getItem("echo.pending")
    set response to Object()
    set response.status to 502
    set response.ok to false
    set response.json to given ignored:
        return Promise.reject("JSON decoder must not run for a gateway failure")
    set window.fetch to given path and options:
        return Promise.resolve(response)
    set failed to echo_api("/fixture" and Object())
    set catcher to get_list(failed and "catch")
    set tested to catcher.call(failed and given error:
        if String(error).indexOf("HTTP 502") < 0:
            return Promise.reject("Gateway failure was not explained")
        set response.status to 200
        set response.ok to true
        set response.json to given ignored:
            return Promise.reject("Unexpected end of JSON input")
        set incomplete to echo_api("/fixture" and Object())
        set incomplete_catch to get_list(incomplete and "catch")
        return incomplete_catch.call(incomplete and given error:
            if String(error).indexOf("incomplete response") < 0:
                return Promise.reject("Incomplete response was not explained")
            if window.localStorage.getItem("echo.pending") != retained:
                return Promise.reject("Pending submission changed")
            set result to document.getElementById("result")
            set result.textContent to "PASS: HTTP 502 bypasses JSON parsing; truncated HTTP 200 is explained; pending submission is unchanged."
            return 0
        )
    )
    set finished to get_list(tested and "catch")
    finished.call(tested and given error:
        set result to document.getElementById("result")
        set result.textContent to "FAIL: " + error
    )
    set reconciled to tested.then(given ignored:
        set echo_busy to given busy:
            return 0
        set echo_note to given text:
            return 0
        set echo_history to given ignored:
            return 0
        set echo_sessions to given ignored:
            return 0
        set saved to Object()
        set saved.submission to "fixture-original-id"
        set saved.session to "fixture-session"
        set saved.message to "earlier message"
        window.localStorage.setItem("echo.pending" and JSON.stringify(saved))
        set input to document.getElementById("message")
        set input.value to "NEW DRAFT MUST SURVIVE"
        set window.fetch to given path and options:
            set response to Object()
            set response.status to 200
            set response.ok to true
            set body to Object()
            if path == "/api/runs":
                if JSON.parse(options.body).submission != saved.submission:
                    return Promise.reject("Submission identity changed")
                set body.status to "accepted"
                set body.session to saved.session
                set body.run to saved.submission
            else:
                set body.status to "found"
                set body.state to "completed"
            set response.json to given ignored:
                return Promise.resolve(body)
            return Promise.resolve(response)
        return echo_reconcile_pending().then(given previous:
            if previous.state != "completed" || window.localStorage.getItem("echo.pending") || input.value != "NEW DRAFT MUST SURVIVE" || window.echoRun != saved.submission:
                return Promise.reject("Pending reconciliation failed")
            set result to document.getElementById("result")
            set result.textContent to "PASS: gateway and truncated JSON failures explained; original submission reconciled; new draft preserved; pending lock cleared."
            set window.fetch to original_fetch
            return 0
        )
    )
    set reconcile_failure to get_list(reconciled and "catch")
    reconcile_failure.call(reconciled and given error:
        set result to document.getElementById("result")
        set result.textContent to "FAIL: " + error
    )
    return 0
