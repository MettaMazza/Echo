import "../../app/web/worker"

# Disposable local fixture: invitation and credentials are test values.
define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0:
        return 1
    if get_argument(2) equals "invite":
        if web_pairing_invite(database and "fixture-retry-invite") is not equal to 0:
            return 1
        return sql_close(database)
    set paired to history_collect_one(archive_prepare(database and "SELECT device FROM echo_devices WHERE revoked=0 ORDER BY rowid LIMIT 1;"))
    if not (ptr_to_str(get_list(paired and 0)) equals "found"):
        return 1
    set submitted to web_submit_owned(database and ptr_to_str(get_list(paired and 1)) and "browser-retry" and "" and "Remember café.")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted") or else web_worker_claim(database and "browser-retry" and "browser-first-worker") is not equal to 0:
        return 1
    if web_worker_run(get_argument(1) and "browser-retry" and "browser-first-worker" and "fixture" and 1 and 20 and 4096) is not equal to 0:
        return 1
    return sql_close(database)
