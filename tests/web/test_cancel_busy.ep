import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "busy-run" and "" and "Hello")
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set cancellation to socket_cancellation_create(library)
    set stop to socket_cancellation_create(library)
    set completed to channel
    spawn web_cancel_monitor(get_argument(1) and "busy-run" and get_list(stop and 0) and get_list(cancellation and 1) and completed)
    set idle to channel
    set waits to create_list()
    set added to append_list(waits and idle)
    set waited to select(waits and 1000)
    set reader to sql_open(get_argument(1))
    if sql_execute(database and "BEGIN EXCLUSIVE;") is not equal to 0:
        return 4
    if node_run_status(reader and "busy-run") is not equal to -1:
        return 5
    set waited to select(waits and 6500)
    if agent_cancellation_pending(library and get_list(cancellation and 0)) is not equal to 0:
        display "FAIL: busy read cancelled the run."
        return 6
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return 7
    set waited to select(waits and 500)
    if node_run_status(reader and "busy-run") is not equal to 1:
        return 8
    set closed to net_close(get_list(stop and 1))
    set status to receive from completed
    if status is not equal to 0:
        return 9
    set closed to net_close(get_list(cancellation and 0))
    set closed to sql_close(reader)
    set closed to sql_close(database)
    set closed to ep_dlclose(library)
    display "PASS: exclusive database lock produces read-error, not denial; monitor survives beyond busy timeout without cancelling; observation resumes after unlock."
    return 0
