import "../../app/web/http_api"
import "../../app/agent/provider_profile"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    set first to provider_llama_profile("first" and 8080)
    set second to provider_llama_profile("second" and 8081)
    if provider_registry_register(database and "one" and "First" and first) is not equal to 0 or else provider_registry_register(database and "two" and "Second" and second) is not equal to 0:
        return 3
    if provider_registry_initialize(database and first) is not equal to 0 or else provider_registry_initialize(database and second) is not equal to 0:
        return 13
    set implicit_request to "{\"submission\":\"implicit\",\"message\":\"Keep my default model.\"}"
    set implicit to web_submit_json(database and provider_json_tokens(implicit_request))
    if not (ptr_to_str(get_list(implicit and 0)) equals "accepted") or else not (agent_provider_read(database and "implicit") equals first):
        display "FAIL: omitted selection was not bound before worker launch."
        return 14
    set request to "{\"submission\":\"run\",\"message\":\"Remember this.\",\"provider\":\"one\"}"
    set result to web_submit_json(database and provider_json_tokens(request))
    if not (ptr_to_str(get_list(result and 0)) equals "accepted") or else get_list(result and 3) is not equal to 1:
        display ptr_to_str(get_list(result and 0))
        return 4
    if not (agent_provider_read(database and "run") equals first):
        return 5
    if provider_registry_select(database and "two") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 6
    set database to archive_open(get_argument(1))
    set implicit to web_submit_json(database and provider_json_tokens(implicit_request))
    if not (ptr_to_str(get_list(implicit and 0)) equals "accepted") or else get_list(implicit and 3) is not equal to 0 or else not (agent_provider_read(database and "implicit") equals first):
        display "FAIL: changed default altered an accepted run on reopen."
        return 15
    if agent_provider_bind(database and "implicit" and second) is not equal to 2 or else archive_verify(database and "session:implicit") is not equal to 0:
        return 16
    set fresh to web_submit_json(database and provider_json_tokens("{\"submission\":\"new-default\",\"message\":\"Use the new default.\"}"))
    if not (ptr_to_str(get_list(fresh and 0)) equals "accepted") or else not (agent_provider_read(database and "new-default") equals second):
        return 17
    set result to web_submit_json(database and provider_json_tokens(request))
    if not (ptr_to_str(get_list(result and 0)) equals "accepted") or else get_list(result and 3) is not equal to 0 or else not (agent_provider_read(database and "run") equals first):
        return 7
    set result to web_submit_json(database and provider_json_tokens("{\"submission\":\"run\",\"message\":\"Remember this.\",\"provider\":\"two\"}"))
    if not (ptr_to_str(get_list(result and 0)) equals "submission-conflict"):
        return 8
    set result to web_submit_json(database and provider_json_tokens("{\"submission\":\"run\",\"message\":\"Remember this.\"}"))
    if not (ptr_to_str(get_list(result and 0)) equals "submission-conflict"):
        return 9
    set result to web_submit_json(database and provider_json_tokens("{\"submission\":\"absent\",\"message\":\"No side effects.\",\"provider\":\"missing\"}"))
    if not (ptr_to_str(get_list(result and 0)) equals "unknown-provider") or else agent_run_read(database and "absent") is not equal to 0:
        return 10
    if archive_read_event(database and "absent:user") is not equal to 0 or else archive_verify(database and "session:run") is not equal to 0:
        return 11
    if agent_provider_bind(database and "run" and first) is not equal to 0 or else agent_provider_bind(database and "run" and second) is not equal to 2 or else sql_close(database) is not equal to 0:
        return 12
    display "PASS: explicit and default profiles commit before worker launch; initialization preserves existing default; reopen retry retains original profile after default change; new runs use new default; conflicting selections rejected; unknown provider leaves no run or user event; archives verify."
    return 0
