import "../../app/web/run_store"
import "../../app/jobs/delegation_schema"
import "../../app/web/attachments"
import "../../app/web/branches"

define fixture_reply with database as Int and run as Str and event as Str and text as Str returning Int:
    set row to agent_run_read(database and run)
    set payload to concat(agent_event_envelope(run and archive_list_text(row and 3)) and concat(",\"content\":" and concat(provider_quote(text) and "}")))
    if archive_append(database and archive_list_text(row and 0) and event and "assistant_final" and payload and "fixture") is not equal to 0:
        return 1
    return archive_finish(checkpoint_prepare(database and "UPDATE echo_runs SET state='completed',last_event=?1 WHERE run=?2;" and [event,run]) and 101)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "parent" and "" and "Delegate two tasks.")
    set session to archive_list_text(first and 1)
    if fixture_reply(database and "parent" and "parent-first" and "Both children started.") is not equal to 0:
        return 4
    set fork to web_branch_session(database and "owner" and session and "parent-first" and "frozen-parent")
    if not (archive_list_text(fork and 0) equals "accepted"):
        return 11
    set next to web_submit_owned(database and "owner" and "later-chat" and session and "Meanwhile hello.")
    if fixture_reply(database and "later-chat" and "later-final" and "Hello while they work.") is not equal to 0:
        return 5
    set before to web_device_sessions(database and "owner")
    set delivery to concat(agent_event_envelope("parent" and "parent-first") and ",\"results\":[{\"state\":\"completed\",\"result_payload\":\"First child result café.\"}]}")
    if archive_append(database and session and "delivered-one" and "delegation_results" and delivery and "fixture") is not equal to 0:
        return 13
    if sql_execute(database and "UPDATE echo_runs SET state='ready',last_event='delivered-one' WHERE run='parent';") is not equal to 0 or else not (session_delegation_wake(database and "parent") equals delivery):
        return 14
    set continuation to concat(agent_event_envelope("parent" and "delivered-one") and "}")
    if archive_append(database and session and "delivery-continuation" and "model_request" and continuation and "fixture") is not equal to 0:
        return 16
    if sql_execute(database and "UPDATE echo_runs SET last_event='delivery-continuation' WHERE run='parent';") is not equal to 0 or else not (session_delegation_wake(database and "parent") equals delivery):
        return 17
    if fixture_reply(database and "parent" and "child-one-report" and "First child result café.") is not equal to 0:
        return 6
    if string_length(session_delegation_wake(database and "parent")) > 0:
        return 15
    set after to web_device_sessions(database and "owner")
    if before equals after or else string_contains(after and "\"run\":\"later-chat\"") equals 0:
        return 7
    if fixture_reply(database and "parent" and "child-two-report" and "Second child result orchid.") is not equal to 0:
        return 8
    set transcript to web_session_transcript(database and session)
    if string_contains(transcript and "Both children started.") equals 0 or else string_contains(transcript and "First child result café.") equals 0 or else string_contains(transcript and "Second child result orchid.") equals 0 or else string_contains(transcript and "Hello while they work.") equals 0 or else string_contains(transcript and "\"revision\":") equals 0:
        display transcript
        return 9
    set frozen to web_session_transcript(database and "branch:frozen-parent")
    if string_contains(frozen and "Both children started.") equals 0 or else string_contains(frozen and "First child result") > 0 or else string_contains(frozen and "Second child result") > 0:
        display frozen
        return 12
    if archive_verify(database and session) is not equal to 0:
        return 10
    display "PASS: late older-parent replies change conversation revision without changing latest run; all accepted parent replies and intervening chat remain visible; branch isolation and result-wake continuation/consumption pass."
    return sql_close(database)
