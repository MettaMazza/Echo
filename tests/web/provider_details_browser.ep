# Append this entry point to echo_capability_label and echo_provider_details
# extracted unchanged from the production client for isolated rendering.
define main:
    set panel to document.createElement("section")
    set panel.id to "provider-controls"
    document.body.appendChild(panel)
    set provider to Object()
    set provider.adapter to "llama.cpp"
    set provider.status to "ready"
    set provider.supported_context to 262144
    set provider.loaded_context to 262144
    set provider.vision to true
    set provider.video to null
    set provider.audio to false
    set provider.research to "Public web search, fetch and static link navigation configured"
    set provider.output_policy to "Available context after exact input counting"
    echo_provider_details(provider)
