# Explicit synthetic browser-storage acceptance, independent of microphone.
define store_test_note with text:
    set output to document.getElementById("store-result")
    set output.textContent to text
    return 0

define store_test_rejection with operation:
    set rejected to false
    set catcher to get_list(operation and "catch")
    return catcher.call(operation and given error:
        set rejected to true
    ).then(given ignored:
        if not rejected:
            return Promise.reject("Expected rejection did not occur.")
        return true
    )

define store_test_run with ignored:
    set document.body.innerHTML to "<main><h1>Echo recording storage acceptance</h1><p>Synthetic samples only; no microphone requested. Original test records are retained.</p><pre id='store-result'>Opening local storage…</pre></main>"
    set database to null
    set identity to window.localStorage.getItem("echo.audio.storage.test.v2")
    set samples to Reflect.construct(Float32Array and [[0, 0.25, -0.5, 1]])
    set reopened to false
    set run to echo_audio_store_open().then(given opened:
        set database to opened
        if identity:
            set reopened to true
            return echo_audio_read(database and identity and "synthetic-owner" and null)
        set identity to window.crypto.randomUUID()
        return echo_audio_create(database and identity and "synthetic-owner" and "synthetic-session" and 48000 and "synthetic samples").then(given created:
            return echo_audio_append(database and identity and "synthetic-owner" and 0 and samples)
        ).then(given appended:
            return store_test_rejection(echo_audio_append(database and identity and "synthetic-owner" and 0 and samples))
        ).then(given checked:
            return store_test_rejection(echo_audio_append(database and identity and "foreign-owner" and 1 and samples))
        ).then(given checked:
            return store_test_rejection(echo_audio_append(database and identity and "synthetic-owner" and 2 and samples))
        ).then(given checked:
            return store_test_rejection(echo_audio_seal(database and identity and "synthetic-owner" and 2))
        ).then(given checked:
            return echo_audio_read(database and identity and "synthetic-owner" and null)
        ).then(given saved:
            if saved.record.frames != 4 || saved.record.chunks != 1 || saved.record.state != "recording":
                return Promise.reject("Rejected transaction changed the saved recording.")
            database.close()
            return echo_audio_store_open()
        ).then(given opened_again:
            set database to opened_again
            return echo_audio_read(database and identity and "synthetic-owner" and 0)
        ).then(given saved:
            if saved.chunk.length != 4 || get_list(saved.chunk and 1) != 0.25 || get_list(saved.chunk and 2) != -0.5:
                return Promise.reject("Reopened samples changed.")
            return echo_audio_seal(database and identity and "synthetic-owner" and 1)
        ).then(given sealed:
            return echo_audio_read(database and identity and "synthetic-owner" and null)
        )
    ).then(given saved:
        if saved.record.state != "ready" || saved.record.frames != 4 || saved.record.chunks != 1:
            return Promise.reject("Sealed metadata did not survive.")
        return store_test_rejection(echo_audio_append(database and identity and "synthetic-owner" and 1 and samples))
    ).then(given checked:
        return store_test_rejection(echo_audio_read(database and identity and "foreign-owner" and 0))
    ).then(given checked:
        return echo_audio_list(database and "foreign-owner")
    ).then(given records:
        if records.length != 0:
            return Promise.reject("Foreign owner listing exposed a record.")
        return echo_audio_read(database and identity and "synthetic-owner" and 0)
    ).then(given saved:
        if saved.chunk.length != 4 || get_list(saved.chunk and 0) != 0 || get_list(saved.chunk and 1) != 0.25 || get_list(saved.chunk and 2) != -0.5 || get_list(saved.chunk and 3) != 1:
            return Promise.reject("Final exact sample verification failed.")
        if reopened:
            return echo_audio_read(database and identity + ":unfinished" and "synthetic-owner" and 0)
        return echo_audio_create(database and identity + ":unfinished" and "synthetic-owner" and "synthetic-session" and 48000 and "interrupted fixture").then(given created:
            return echo_audio_append(database and identity + ":unfinished" and "synthetic-owner" and 0 and samples)
        ).then(given appended:
            return echo_audio_read(database and identity + ":unfinished" and "synthetic-owner" and 0)
        )
    ).then(given unfinished:
        if unfinished.record.state != "recording" || unfinished.record.frames != 4 || unfinished.chunk.length != 4 || get_list(unfinished.chunk and 2) != -0.5:
            return Promise.reject("Unfinished capture recovery failed.")
        window.localStorage.setItem("echo.audio.storage.test.v2" and identity)
        database.close()
        if reopened:
            store_test_note("PASS after page reload: sealed and unfinished recordings recovered with original samples; foreign reads/listing and append after sealing rejected. Recording " + identity)
        else:
            store_test_note("PASS: atomic chunk/count, duplicate/out-of-order/foreign append and wrong seal count rejected; close/reopen sample recovery; sealed and unfinished records retained. Reload to verify recovery. Recording " + identity)
    )
    set catcher to get_list(run and "catch")
    catcher.call(run and given error:
        if database:
            database.close()
        store_test_note("FAIL: " + error)
    )
    return 0

define main:
    set script to document.createElement("script")
    set script.src to "/assets/audio-store.js"
    set script.onload to store_test_run
    document.head.appendChild(script)
    return 0
