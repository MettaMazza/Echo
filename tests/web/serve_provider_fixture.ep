import "../fixtures/runner_provider"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set saved to write_file(get_argument(1) and int_to_string(get_list(listener and 2)))
    set completed to channel
    set objective to get_argument(2)
    spawn runner_fixture(listener and objective and completed)
    set result to receive from completed
    set closed to local_socket_close(listener)
    if result is not equal to 0 or else closed is not equal to 0:
        display "FAIL: web provider fixture."
        return 1
    display "PASS: actual web worker submitted checked generation requests and received the scripted tool/final responses."
    return 0
