import "../../app/rights/quarantine"
import "../../app/web/worker"

define request_stop_later with path as Str and charter as Str and completed as Int returning Int:
    set slept to sleep_ms(100)
    set database to archive_open(path)
    set decision to protected_emergency_begin(database and charter and "credential-a" and "monitor-emergency" and "fixture-node" and "quarantine" and "Interrupt blocked native read")
    set result to 0
    if not (decision equals "recorded"):
        set result to 1
    set result to result + sql_close(database)
    send result to completed
    return result

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invitation-a") is not equal to 0 or else web_pairing_invite(database and "invitation-b") is not equal to 0:
        return 1
    if web_device_pair(database and "invitation-a" and "a" and "A" and "credential-a") is not equal to 0 or else web_device_pair(database and "invitation-b" and "b" and "B" and "credential-b") is not equal to 0:
        return 1
    if not (protected_quarantine_schema(database) equals "applied") or else not (principal_host_role(database and "enrol" and "device:a" and "steward" and "Fixture") equals "recorded"):
        return 2
    set submitted to web_submit_owned(database and "a" and "stop-run" and "" and "Stop this fixture")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    if web_cancel_request(database and "b" and "stop-run") equals 0:
        display "FAIL: another device cancelled the run."
        return 1
    set listener to local_socket_listen(0)
    set library to get_list(listener and 0)
    set cancellation to socket_cancellation_create(library)
    set stop to socket_cancellation_create(library)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    set monitored to channel
    set requested to channel
    set monitor_path to concat(get_argument(1) and "")
    set request_path to concat(get_argument(1) and "")
    spawn web_cancel_monitor(monitor_path and "stop-run" and get_list(stop and 0) and get_list(cancellation and 1) and monitored)
    set charter_path to concat(get_argument(2) and "")
    spawn request_stop_later(request_path and charter_path and requested)
    # The connected peer sends nothing. Only cancellation can wake this read.
    set chunk to socket_read_chunk(library and accepted and get_list(cancellation and 0))
    if not (ptr_to_str(get_list(chunk and 0)) equals "cancelled"):
        return 1
    set result to receive from requested
    set monitor_result to receive from monitored
    if result is not equal to 0 or else monitor_result is not equal to 0:
        return 1
    set closed to net_close(get_list(stop and 1))
    set closed to net_close(get_list(cancellation and 0))
    set closed to net_close(client)
    set closed to net_close(accepted)
    set closed to local_socket_close(listener)
    if web_worker_claim(database and "stop-run" and "test-worker") is not equal to 0:
        return 1
    # A saved cancellation survives reopening and reaches terminal run state.
    if web_worker_run(get_argument(1) and "stop-run" and "test-worker" and "fixture" and 1 and 100 and 4096) is not equal to 0:
        return 1
    set row to agent_run_read(database and "stop-run")
    if not (ptr_to_str(get_list(row and 2)) equals "cancelled"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: authenticated quarantine from another database connection interrupts a blocked native socket read and the worker records terminal cancellation without a user stop request."
    return 0
