# Link after generated client.ep with its application main disabled. No real
# account/API is used; this exercises pagination and exact retry in the UI.
define discovery_browser_tick:
    set ready to given resolve:
        window.setTimeout(resolve and 0)
    return Reflect.construct(Promise and [ready])

define main:
    set output to document.getElementById("result")
    set window.discoveryRequests to JSON.parse("[]")
    set window.profileRequests to JSON.parse("[]")
    set result to null
    set window.echo_api to given path and payload:
        if path == "/api/external-profile":
            window.profileRequests.push(JSON.parse(JSON.stringify(payload)))
            if payload.action != "register" || payload.model != "first" || payload.account != "account-fixture" || payload.discovery != get_list(window.discoveryRequests and 1).identity || payload.options != "":
                return Promise.reject("Profile did not retain its exact discovery source")
            if window.profileRequests.length == 1:
                return Promise.reject("fixture-profile-transient-error")
            return Promise.resolve(JSON.parse("{\"status\":\"registered\"}"))
        window.discoveryRequests.push(JSON.parse(JSON.stringify(payload)))
        if path != "/api/external-discovery" || Object.keys(payload).length != 4 || payload.account != "account-fixture" || payload.model != "":
            return Promise.reject("Unexpected metadata request fields")
        if window.discoveryRequests.length == 1:
            return Promise.reject("fixture-transient-error")
        set result to JSON.parse("{\"status\":\"found\",\"models\":[{\"id\":\"first\",\"label\":\"First model\",\"input_limit\":123456,\"output_limit\":7890}],\"next_cursor\":\"opaque&cursor\"}")
        if payload.cursor != "":
            set result to JSON.parse("{\"status\":\"found\",\"models\":[{\"id\":\"second\",\"label\":\"Second model\",\"input_limit\":null,\"output_limit\":null}],\"next_cursor\":\"\"}")
        return Promise.resolve(result)
    set account to Object()
    set account.identity to "account-fixture"
    set panel to echo_external_models(account)
    document.body.appendChild(panel)
    set discover to panel.querySelector("button")
    set more to panel.lastElementChild
    set records to null
    set save to null
    discover.click()
    set pending to discovery_browser_tick().then(given ignored:
        if discover.disabled || window.discoveryRequests.length != 1:
            return Promise.reject("Discovery failure did not release the control")
        discover.click()
        return discovery_browser_tick()
    ).then(given ignored:
        set records to window.discoveryRequests
        if records.length != 2 || get_list(records and 0).identity != get_list(records and 1).identity:
            return Promise.reject("Uncertain discovery retry changed identity")
        if more.hidden || panel.textContent.indexOf("First model") < 0:
            return Promise.reject("First page or continuation cursor missing")
        more.click()
        return discovery_browser_tick()
    ).then(given ignored:
        if window.discoveryRequests.length != 3 || get_list(window.discoveryRequests and 2).cursor != "opaque&cursor" || get_list(window.discoveryRequests and 2).identity == get_list(window.discoveryRequests and 1).identity:
            return Promise.reject("Pagination did not use a distinct request and exact cursor")
        if not more.hidden || panel.textContent.indexOf("First model") < 0 || panel.textContent.indexOf("Second model") < 0 || panel.textContent.indexOf("unreported") < 0:
            return Promise.reject("Pagination lost models or invented a missing limit")
        set save to panel.querySelectorAll("button").item(1)
        save.click()
        return discovery_browser_tick()
    ).then(given ignored:
        if save.disabled || window.profileRequests.length != 1:
            return Promise.reject("Profile retry was not available")
        save.click()
        return discovery_browser_tick()
    ).then(given ignored:
        if not save.disabled || window.profileRequests.length != 2 || get_list(window.profileRequests and 0).identity != get_list(window.profileRequests and 1).identity || save.textContent != "Profile saved":
            return Promise.reject("Profile retry or completion failed")
        set output.textContent to "PASS: metadata-only discovery, exact retries, pagination, unreported limits and profile registration bound to its original discovery."
    )
    get_list(pending and "catch").call(pending and given error:
        set output.textContent to "FAIL: " + String(error)
    )
