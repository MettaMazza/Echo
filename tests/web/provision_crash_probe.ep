import "../../app/web/run_store"
import "../../app/agent/control"
import "fs"

# Host-only provisioner for an isolated acceptance-test device. Its credential
# is saved to the caller's private runtime file, never printed into a log.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    set invite to agent_identity()
    set device to agent_identity()
    set credential to agent_identity()
    if web_pairing_invite(database and invite) is not equal to 0 or else web_device_pair(database and invite and device and "Concurrent acceptance test" and credential) is not equal to 0:
        return 3
    set saved to write_file_content(get_argument(2) and credential)
    set closed to sql_close(database)
    return closed
