import "../../app/web/attachment_usage"
import "../../app/jobs/delegation_schema"
import "../../app/tools/attachment_text"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "a" and "first" and "" and "Usage fixture")
    set foreign to web_submit_owned(database and "b" and "foreign" and "" and "Other fixture")
    set session to archive_list_text(first and 1)
    if agent_cancel_run(database and "first") is not equal to 0 or else write_file(get_argument(2) and "Usage marker: indigo-pine-613") is not equal to 1 or else web_attachment_register(database and "a" and session and "source" and get_argument(2) and "notes.txt" and "text/plain") is not equal to 0:
        return 4
    set submitted to web_submit_owned_files(database and "a" and "with-file" and session and "Read file" and ["source"])
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 5
    set observation to attachment_text_execute(database and session and "{\"attachment\":\"source\",\"offset\":0,\"characters\":1000}")
    set payload to concat("{\"result\":" and concat(observation and "}"))
    if archive_append(database and session and "original-read" and "tool_result" and payload and "fixture") is not equal to 0 or else archive_append(database and archive_list_text(foreign and 1) and "foreign-copy" and "tool_result" and payload and "fixture") is not equal to 0:
        return 6
    set before to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events;"))
    set report to web_attachment_usage(database and "a" and "source")
    if string_contains(report and "with-file:user:attachments") equals 0 or else string_contains(report and "original-read") equals 0 or else string_contains(report and "foreign-copy") is not equal to 0 or else string_contains(report and "indigo-pine-613") is not equal to 0:
        display report
        return 7
    if not (web_attachment_usage(database and "b" and "source") equals "{\"status\":\"not-authorized\"}"):
        return 8
    set after to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events;"))
    if not (archive_list_text(before and 1) equals archive_list_text(after and 1)) or else archive_verify(database and session) is not equal to 0:
        return 9
    display "PASS: read-only attachment binding and digest-bound read inventory, no text export, foreign attachment/reference isolation, unchanged event count and intact source archive."
    return sql_close(database)
