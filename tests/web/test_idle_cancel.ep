import "../../app/web/worker"

define main returning Int:
    if get_argument_count() equals 3:
        set database to archive_open(get_argument(1))
        if database equals 0 or else web_worker_cancel_idle(database and get_argument(2)) is not equal to 0:
            return 2
        set row to agent_run_read(database and get_argument(2))
        if not (archive_list_text(row and 2) equals "cancelled") or else sql_close(database) is not equal to 0:
            return 3
        display "PASS: retained unclaimed cancellation settled without starting a worker."
        return 0
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "run" and "" and "Cancel this paused run")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted") or else web_worker_claim(database and "run" and "worker") is not equal to 0:
        return 1
    if web_cancel_request(database and "foreign" and "run") equals 0:
        return 1
    if web_worker_cancel_idle(database and "run") is not equal to 0:
        return 1
    set row to agent_run_read(database and "run")
    if not (ptr_to_str(get_list(row and 2)) equals "ready"):
        return 1
    if web_cancel_request(database and "owner" and "run") is not equal to 0 or else web_worker_cancel_idle(database and "run") is not equal to 0:
        return 1
    set row to agent_run_read(database and "run")
    if not (ptr_to_str(get_list(row and 2)) equals "ready"):
        display "FAIL: cancelled a running worker directly"
        return 1
    if sql_execute(database and "UPDATE echo_web_workers SET status='discovery-failed' WHERE run='run';") is not equal to 0:
        return 1
    if web_worker_cancel_idle(database and "run") is not equal to 0 or else web_worker_cancel_idle(database and "run") is not equal to 0:
        return 1
    set row to agent_run_read(database and "run")
    if not (ptr_to_str(get_list(row and 2)) equals "cancelled") or else archive_verify(database and "session:run") is not equal to 0:
        return 1
    set next to web_submit_owned(database and "owner" and "next" and "session:run" and "Continue")
    if not (ptr_to_str(get_list(next and 0)) equals "accepted") or else web_cancel_request(database and "owner" and "next") is not equal to 0 or else web_worker_cancel_idle(database and "next") is not equal to 0:
        return 1
    set unclaimed to agent_run_read(database and "next")
    if not (archive_list_text(unclaimed and 2) equals "cancelled") or else web_worker_ensure_claim(database and "owner" and "next" and "late-worker") is not equal to 2 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: foreign cancellation rejected, running worker preserved, idle cancellation durable/idempotent and conversation unblocked."
    return 0
