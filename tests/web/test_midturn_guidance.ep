import "../../app/web/routes"
import "../../app/agent/run_messages"
import "../fixtures/generation_fixture"
import "fs"

define guidance_arrival_fixture with listener as List and data as Str and completed as Int and database_path as Str returning Int:
    set descriptor to local_socket_accept(listener)
    if descriptor is less than 0:
        send 1 to completed
        return 1
    set reader to http_stream_create(get_list(listener and 0) and descriptor and -1)
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready"):
        send 1 to completed
        return 1
    set body to http_body_create(ptr_to_str(get_list(head and 3)) and get_list(head and 4))
    repeat while 1 equals 1:
        set piece to http_body_next(reader and body and 65536)
        set status to ptr_to_str(get_list(piece and 0))
        if status equals "done":
            break
        if not (status equals "data"):
            send 1 to completed
            return 1
    set database to archive_open(database_path)
    if web_guidance_request(database and "phone" and "phone" and "one" and "Return silly goose") is not equal to 0 or else web_guidance_request(database and "phone" and "phone" and "one" and "Return silly goose") is not equal to 0:
        send 1 to completed
        return 1
    set closed_database to sql_close(database)
    # Deliberately send no HTTP headers or SSE events. Guidance must wake the
    # blocked client itself; EOF proves it retired the obsolete connection.
    set waiting to socket_read_chunk(get_list(listener and 0) and descriptor and -1)
    set failed to 0
    if not (archive_list_text(waiting and 0) equals "eof"):
        set failed to 1
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    send failed + released + closed to completed
    return 0


define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (ptr_to_str(device_link_schema(database)) equals "applied"):
        return 2
    for each device in ["phone", "mac", "stranger"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
        set submitted to web_submit_owned(database and device and device and "" and concat("Hello from " and device))
        if not (archive_list_text(submitted and 0) equals "accepted"):
            return 4
    if device_link_merge(database and "phone" and "mac") is not equal to 0:
        return 5
    set recalled to continuity_execute(database and "mac" and "memory_messages" and "{\"session\":\"session:phone\",\"after\":0}")
    if string_contains(recalled and "found") equals 0:
        display recalled
        return 6
    if string_contains(continuity_execute(database and "stranger" and "memory_messages" and "{\"session\":\"session:phone\",\"after\":0}") and "end") equals 0:
        return 7
    if web_guidance_request(database and "stranger" and "phone" and "bad" and "foreign") equals 0:
        return 8
    # Actual streaming collection sees the pending guidance and closes only this attempt.
    set listener to local_socket_listen(0)
    set completed to channel
    spawn guidance_arrival_fixture(listener and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"obsolete\"},\"finish_reason\":\"stop\"}]}" and completed and get_argument(1))
    set generated to agent_generate_local(database and "phone" and "attempt-one" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture to receive from completed
    if generated is not equal to 0 or else fixture is not equal to 0:
        return 10
    set row to agent_run_read(database and "phone")
    if not (archive_list_text(row and 2) equals "ready"):
        return 11
    if agent_guidance_apply(database and "phone") is not equal to 0:
        return 12
    set messages to agent_run_messages(database and "phone")
    if string_contains(messages and "Hello from phone") equals 0 or else string_contains(messages and "Return silly goose") equals 0 or else provider_json_tokens(messages) equals 0:
        display messages
        return 13
    # A second update in the same run must be applied once and follow the first.
    if web_guidance_request(database and "phone" and "phone" and "two" and "Use exactly silly goose, with no explanation") is not equal to 0 or else agent_guidance_apply(database and "phone") is not equal to 0:
        return 22
    set messages to agent_run_messages(database and "phone")
    if string_contains(messages and "Use exactly silly goose, with no explanation") equals 0:
        return 23
    set receipts to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='user_guidance';"))
    if not (archive_list_text(receipts and 1) equals "2"):
        return 24
    set listener to local_socket_listen(0)
    spawn generation_fixture(listener and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"silly goose\"},\"finish_reason\":\"stop\"}]}" and completed)
    set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and "}"))
    set generated to agent_generate_local(database and "phone" and "attempt-two" and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture to receive from completed
    if generated is not equal to 0 or else fixture is not equal to 0:
        return 14
    set row to agent_run_read(database and "phone")
    if not (archive_list_text(row and 2) equals "completed"):
        return 15
    set count to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='agent_cancelled' OR (kind='assistant_final' AND json_extract(payload,'$.content')='obsolete');"))
    if not (archive_list_text(count and 1) equals "0"):
        return 16
    if not (archive_list_text(guidance_pending(database and "phone") and 0) equals "end"):
        return 17
    # Guidance between tool calls preserves the first observation and skips the unlaunched action.
    set listener to local_socket_listen(0)
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"I have an update before continuing. café 🌍\",\"reasoning_content\":\"INTERNAL_TRACE_ONLY\",\"tool_calls\":[{\"index\":0,\"id\":\"read-first\",\"function\":{\"name\":\"memory_sessions\",\"arguments\":\"{\\\"after\\\":0}\"}},{\"index\":1,\"id\":\"write-later\",\"function\":{\"name\":\"scratchpad\",\"arguments\":\"{\\\"operation\\\":\\\"write\\\",\\\"name\\\":\\\"must-not-write\\\",\\\"text\\\":\\\"obsolete\\\",\\\"previous_revision\\\":\\\"\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "mac" and "tool-attempt" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Tools\"}]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture to receive from completed
    if generated is not equal to 0 or else fixture is not equal to 0 or else agent_tool_step(database and "mac") is not equal to 0:
        return 18
    # A text reply accompanying tools must become a durable transcript update.
    set transcript to web_session_transcript(database and "session:mac")
    if string_contains(transcript and "I have an update before continuing. café 🌍") equals 0 or else string_contains(transcript and "INTERNAL_TRACE_ONLY") > 0 or else string_contains(transcript and "\"interim\":true") equals 0:
        display transcript
        return 25
    if web_guidance_request(database and "mac" and "mac" and "tool-update" and "Do not write the note") is not equal to 0 or else agent_tool_step(database and "mac") is not equal to 0 or else agent_tool_step(database and "mac") is not equal to 0 or else agent_guidance_apply(database and "mac") is not equal to 0:
        return 19
    set skipped to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.cause') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='mac' AND t.call_id='write-later';"))
    if not (archive_list_text(skipped and 1) equals "mid-turn-guidance"):
        return 20
    set notes to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='scratchpad_revision';"))
    if not (archive_list_text(notes and 1) equals "0") or else provider_json_tokens(agent_run_messages(database and "mac")) equals 0:
        return 21
    set transcript to web_session_transcript_window(database and "session:mac" and 0 and 1)
    if string_contains(transcript and "I have an update before continuing. café 🌍") equals 0:
        return 26
    if agent_cancel_run(database and "mac") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 27
    set database to archive_open(get_argument(1))
    set transcript to web_session_transcript(database and "session:mac")
    if string_contains(transcript and "I have an update before continuing. café 🌍") equals 0 or else string_contains(transcript and "INTERNAL_TRACE_ONLY") > 0:
        return 28
    display "PASS: accepted interim response remains after tools, guidance, pagination, cancellation and database reopen; reasoning remains outside transcript."
    display "PASS: linked recall and outsider isolation; idempotent guidance; blocked HTTP generation interrupted before headers; same run resumes with original objective and guidance; one final reply and no cancellation."
    return sql_close(database)
