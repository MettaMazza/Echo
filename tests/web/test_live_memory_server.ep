import "../fixtures/echo_http_client"
import "../../app/web/run_store"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set port to string_to_int(get_argument(1))
    set database to archive_open(get_argument(2))
    set device to concat("memory-http:" and agent_identity())
    set credential to agent_identity()
    set foreign to concat("memory-http:" and agent_identity())
    set foreign_credential to agent_identity()
    if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and "Temporary memory acceptance" and credential) is not equal to 0:
        return 2
    if web_pairing_invite(database and foreign) is not equal to 0 or else web_device_pair(database and foreign and foreign and "Temporary isolation acceptance" and foreign_credential) is not equal to 0:
        return 3
    set seed to concat("memory-seed:" and agent_identity())
    set marker to concat("garden-sensor-" and agent_identity())
    set prior to web_submit_owned(database and device and seed and "" and concat("My name is Rowan. Our shared project is " and concat(marker and ". I prefer brief replies. Before editing files, read them.")))
    if not (archive_list_text(prior and 0) equals "accepted") or else agent_cancel_run(database and seed) is not equal to 0:
        return 4
    set run to concat("memory-http-run:" and agent_identity())
    set payload to concat("{\"submission\":" and provider_quote(run))
    set payload to concat(payload and ",\"message\":\"What is my name and the exact identifier of our shared project from the earlier conversation? Reply briefly.\"}")
    set submitted to fixture_echo_request(port and "/api/runs" and payload and credential)
    if not (archive_list_text(submitted and 0) equals "ready"):
        return 5
    set query to concat("{\"run\":" and concat(provider_quote(run) and "}"))
    set denied to fixture_echo_request(port and "/api/run" and query and foreign_credential)
    if get_list(denied and 1) is not equal to 404:
        return 6
    repeat while 1 equals 1:
        set response to fixture_echo_request(port and "/api/run" and query and credential)
        if not (archive_list_text(response and 0) equals "ready"):
            return 7
        set tokens to provider_json_tokens(archive_list_text(response and 2))
        set state to provider_value(tokens and provider_member(tokens and 0 and "state"))
        if state equals "completed":
            set text to provider_value(tokens and provider_member(tokens and 0 and "text"))
            if string_contains(text and marker) equals 0 or else string_contains(text and "Rowan") equals 0:
                return 8
            break
        if state equals "cancelled" or else state equals "failed":
            return 9
        set slept to sleep_ms(1000)
    set values to create_list()
    set added to append_list(values and concat(seed and ":user"))
    set claims to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_memory_claims WHERE source_event=?;" and values))
    if string_to_int(archive_list_text(claims and 1)) < 1:
        return 10
    if web_device_revoke(database and device) is not equal to 0 or else web_device_revoke(database and foreign) is not equal to 0:
        return 11
    display "PASS: live HTTP submission automatically learns and recalls a prior-session name and unique project identifier; foreign-device access denied; temporary credentials revoked."
    return sql_close(database)
