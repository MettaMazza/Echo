import "../../app/web/worker"
import "fs"

# Disposable browser acceptance fixture. These are explicitly seeded stages,
# not a model compaction result. Never run this against a user archive.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    if string_index_of(path and "compaction-preview") < 0:
        return 2
    set database to archive_open(path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0:
        return 3
    set operation to get_argument(2)
    if operation equals "invite":
        if web_pairing_invite(database and "compaction-preview-invitation") is not equal to 0:
            return 4
    else if operation equals "seed":
        set device to history_collect_one(archive_prepare(database and "SELECT device FROM echo_devices WHERE name='Compaction preview' AND revoked=0;"))
        if not (archive_list_text(device and 0) equals "found"):
            return 5
        set submitted to web_submit_owned(database and archive_list_text(device and 1) and "compaction-preview-run" and "" and "Compaction preview: preserved original message.")
        if not (archive_list_text(submitted and 0) equals "accepted"):
            display archive_list_text(submitted and 0)
            return 6
        set session to archive_list_text(submitted and 1)
        set row to agent_run_read(database and "compaction-preview-run")
        set payload to concat("{\"run_id\":\"compaction-preview-run\",\"job\":\"preview-job\",\"parent_event\":" and concat(provider_quote(archive_list_text(row and 3)) and "}"))
        if archive_append(database and session and "preview-binding" and "compaction_binding" and payload and "preview") is not equal to 0 or else web_worker_claim(database and "compaction-preview-run" and "preview-worker") is not equal to 0:
            return 7
    else if operation equals "review":
        if archive_append(database and "session:compaction-preview-run" and "preview-job:review:receipt" and "provider_event" and "{}" and "preview") is not equal to 0:
            return 8
    else if operation equals "pause":
        if sql_execute(database and "UPDATE echo_web_workers SET status='helper-failed' WHERE run='compaction-preview-run';") is not equal to 0:
            return 9
    else if operation equals "resume":
        if sql_execute(database and "UPDATE echo_web_workers SET status='running' WHERE run='compaction-preview-run';") is not equal to 0:
            return 9
    else if operation equals "cancel":
        if agent_cancel_run(database and "compaction-preview-run") is not equal to 0:
            return 10
    else:
        return 11
    return sql_close(database)
