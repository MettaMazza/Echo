import "../../app/web/progress"

define progress_piece with database as Int and request as Str and sequence as Int and data as Str returning Int:
    set payload to concat("{\"request_event\":" and provider_quote(request))
    set payload to concat(payload and concat(",\"data\":" and concat(provider_quote(data) and "}")))
    return provider_archive_piece(database and "session:r" and request and sequence and "provider_event" and payload)

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    set submitted to web_submit(database and "r" and "" and "Draft fixture")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    if archive_append(database and "session:r" and "generation" and "model_request" and "{\"run_id\":\"r\",\"parent_event\":\"r:user\"}" and "fixture") is not equal to 0 or else agent_run_transition(database and "r" and "ready" and "r:user" and "generating" and "generation") is not equal to 0:
        return 1
    if progress_piece(database and "generation" and 0 and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello \"}},{\"index\":1,\"delta\":{\"content\":\"Must not appear\"}}]}") is not equal to 0:
        return 1
    set tokens to provider_json_tokens(web_run_progress(database and "r" and "old-generation" and 999))
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "Hello "):
        return 1
    set cursor to http_decimal(provider_value(tokens and provider_member(tokens and 0 and "after")))
    if progress_piece(database and "unrelated" and 0 and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Other generation\"}}]}") is not equal to 0:
        return 1
    if progress_piece(database and "generation" and 1 and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"café 🌍\"}}]}") is not equal to 0:
        return 1
    set tokens to provider_json_tokens(web_run_progress(database and "r" and "generation" and cursor))
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "café 🌍"):
        return 1
    set cursor to http_decimal(provider_value(tokens and provider_member(tokens and 0 and "after")))
    set tokens to provider_json_tokens(web_run_progress(database and "r" and "generation" and cursor))
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals ""):
        return 1
    set row to agent_run_read(database and "r")
    if not (ptr_to_str(get_list(row and 2)) equals "generating"):
        return 1
    if agent_cancel_run(database and "r") is not equal to 0:
        return 1
    set tokens to provider_json_tokens(web_run_progress(database and "r" and "generation" and cursor))
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "idle"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: committed incremental draft, Unicode, no repeat bytes, generation reset, alternative exclusion and no false completion."
    return 0
