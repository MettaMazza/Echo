import "../../app/web/device_links"
import "../../app/web/run_store"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0:
        return 2
    if not (ptr_to_str(device_link_schema(database)) equals "applied"):
        return 3
    if web_pairing_invite(database and "owner-invite") is not equal to 0 or else web_device_pair(database and "owner-invite" and "owner" and "Phone" and "owner-secret") is not equal to 0:
        return 4
    if web_pairing_invite(database and "other-invite") is not equal to 0 or else web_device_pair(database and "other-invite" and "other" and "Other" and "other-secret") is not equal to 0:
        return 5
    set submitted to web_submit_owned(database and "owner" and "first" and "" and "Linked history marker")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 6
    if device_link_create(database and "owner" and "one-use-code") is not equal to 0:
        return 7
    if string_length(device_link_redeem(database and "wrong-code" and "bad" and "Bad" and "bad-secret")) > 0:
        return 8
    if not (device_link_redeem(database and "one-use-code" and "mac" and "Mac" and "mac-secret") equals "owner"):
        return 9
    if string_length(device_link_redeem(database and "one-use-code" and "again" and "Again" and "again-secret")) > 0:
        return 10
    if not (web_device_authenticate(database and "mac-secret") equals "owner"):
        return 11
    if web_device_session_allowed(database and web_device_authenticate(database and "mac-secret") and "session:first") is not equal to 1 or else web_device_session_allowed(database and "other" and "session:first") is not equal to 0:
        return 12
    if device_link_revoke(database and "other" and "mac") is not equal to 0 or else not (web_device_authenticate(database and "mac-secret") equals "owner"):
        return 13
    if device_link_revoke(database and "owner" and "mac") is not equal to 0 or else string_length(web_device_authenticate(database and "mac-secret")) > 0:
        return 14
    if not (web_device_authenticate(database and "owner-secret") equals "owner"):
        return 15
    if device_link_create(database and "owner" and "expired") is not equal to 0:
        return 16
    if sql_execute(database and "UPDATE echo_device_link_codes SET expires=0;") is not equal to 0:
        return 17
    if string_length(device_link_redeem(database and "expired" and "expired" and "Expired" and "expired-secret")) > 0:
        return 18
    if device_link_create(database and "owner" and "revoked-code") is not equal to 0 or else web_device_revoke(database and "owner") is not equal to 0:
        return 19
    if string_length(device_link_redeem(database and "revoked-code" and "revoked" and "Revoked" and "revoked-secret")) > 0:
        return 20
    if sql_close(database) is not equal to 0:
        return 21
    set database to archive_open(get_argument(1))
    if string_length(web_device_authenticate(database and "mac-secret")) > 0:
        return 22
    display "PASS: one-use and expired codes, linked history access, unrelated-user denial, independent browser revocation, account revocation and restart."
    return sql_close(database)
