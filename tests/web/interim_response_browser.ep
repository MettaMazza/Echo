# Link with the actual client after renaming its startup main. No model calls.
define main:
    set transcript to document.getElementById("transcript")
    set message to Object()
    set message.event to "generation-one:response"
    set message.run to "fixture-run"
    set message.role to "assistant"
    set message.text to "I have an update before continuing. café 🌍"
    set message.interim to true
    set message.attachments to Array()
    set first to echo_render_message(message)
    echo_commit_messages(transcript and Array(first) and "0")
    set later to Object.assign(Object() and message)
    set later.event to "generation-two:response"
    set later.text to "The next step is now complete."
    set second to echo_render_message(later)
    echo_commit_messages(transcript and Array(echo_render_message(message) and second) and "0")
    set result to document.getElementById("result")
    if transcript.children.length != 2 || transcript.firstChild != first || not transcript.textContent.includes(message.text):
        set result.textContent to "FAIL: a later tool turn removed or duplicated the earlier reply."
        return 1
    if first.textContent.includes("Regenerate") || first.textContent.includes("Branch from here") || not first.textContent.includes("Echo · update"):
        set result.textContent to "FAIL: an interim reply has final-only controls or lacks its update label."
        return 2
    # Simulate a fresh history render from the same durable server records.
    set transcript.textContent to ""
    echo_commit_messages(transcript and Array(echo_render_message(message) and echo_render_message(later)) and "0")
    if transcript.children.length != 2 || not transcript.textContent.includes(message.text):
        set result.textContent to "FAIL: fresh history lost the saved reply."
        return 3
    set result.textContent to "PASS: saved replies remain across continued tool turns and fresh history rendering; no duplicates or final-only controls."
    return 0
