# Uses the actual playback and card functions; byte loading is a local fixture.
define echo_fixture_bytes with file:
    return window.fetch("/tone.wav").then(given response:
        return response.arrayBuffer()
    )

define main:
    echo_playback_setup()
    set window.echoToken to "fixture"
    set a to Object()
    set a.attachment to "a"
    set a.name to "Audio A"
    set a.media_type to "audio/wav"
    set b to Object()
    set b.attachment to "b"
    set b.name to "Audio B"
    set b.media_type to "audio/wav"
    set first to Object()
    set first.event to "message-a"
    set first.role to "user"
    set first.text to "Audio A message"
    set first.attachments to Array(a)
    set second to Object()
    set second.event to "message-b"
    set second.role to "user"
    set second.text to "Audio B message"
    set second.attachments to Array(b)
    set one to echo_render_message(first)
    set two to echo_render_message(second)
    document.getElementById("transcript").appendChild(one)
    document.getElementById("transcript").appendChild(two)
    document.getElementById("redraw").addEventListener("click" and given event:
        set updated to Array(echo_render_message(first) and echo_render_message(second))
        set next to document.createElement("article")
        set next.textContent to "A new message arrived."
        updated.push(next)
        echo_commit_messages(document.getElementById("transcript") and updated and "0")
        set result to document.getElementById("result")
        set result.textContent to "New message committed; original inline players stayed connected."
    )
    document.getElementById("play-a").addEventListener("click" and given event:
        one.querySelector("audio").play()
    )
    document.getElementById("play-b").addEventListener("click" and given event:
        two.querySelector("audio").play()
    )
    return 0
