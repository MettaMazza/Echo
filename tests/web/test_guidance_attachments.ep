import "../../app/web/cancellation"
import "../../app/web/attachments"
import "../../app/agent/run_messages"
import "../../app/context/recap_sources"
import "fs"

# Real local audio bytes, durable intake and canonical guidance application.
# No inference response is fabricated; this tests request reconstruction.
define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    for each device in ["owner","outsider"]:
        if web_pairing_invite(database and ptr_to_str(device)) is not equal to 0 or else web_device_pair(database and ptr_to_str(device) and ptr_to_str(device) and "Fixture" and concat(ptr_to_str(device) and "-secret")) is not equal to 0:
            return 3
        set submitted to web_submit_owned(database and ptr_to_str(device) and ptr_to_str(device) and "" and "Keep this task")
        if not (archive_list_text(submitted and 0) equals "accepted"):
            return 4
    if web_attachment_register(database and "owner" and "session:owner" and "sound" and get_argument(2) and "fixture.wav" and "audio/wav") is not equal to 0 or else web_attachment_register(database and "outsider" and "session:outsider" and "foreign" and concat(get_argument(2) and ".foreign") and "foreign.wav" and "audio/wav") is not equal to 0:
        return 5
    if web_guidance_files_environment(database and "outsider" and "owner" and "bad-actor" and "Listen" and ["sound"] and "") equals 0 or else web_guidance_files_environment(database and "owner" and "owner" and "bad-source" and "Listen" and ["foreign"] and "") equals 0:
        return 6
    if web_guidance_files_environment(database and "owner" and "owner" and "missing" and "Listen" and ["missing"] and "") equals 0 or else web_guidance_files_environment(database and "owner" and "owner" and "duplicate" and "Listen" and ["sound","sound"] and "") equals 0:
        return 7
    if sql_execute(database and "CREATE TRIGGER reject_guidance_binding BEFORE INSERT ON echo_events WHEN NEW.kind='turn_attachments' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 8
    if web_guidance_files_environment(database and "owner" and "owner" and "rollback" and "Listen" and ["sound"] and "") equals 0:
        return 9
    if archive_read_event(database and "owner:guidance:rollback") is not equal to 0 or else sql_execute(database and "DROP TRIGGER reject_guidance_binding;") is not equal to 0:
        return 10
    if web_guidance_files_environment(database and "owner" and "owner" and "audio" and "Listen now" and ["sound"] and "") is not equal to 0 or else web_guidance_files_environment(database and "owner" and "owner" and "audio" and "Listen now" and ["sound"] and "") is not equal to 0:
        return 11
    if web_guidance_request(database and "owner" and "owner" and "audio" and "Listen now") equals 0 or else web_guidance_files_environment(database and "owner" and "owner" and "audio" and "Changed" and ["sound"] and "") equals 0:
        return 12
    if agent_guidance_apply(database and "owner") is not equal to 0:
        return 13
    set messages to agent_run_messages(database and "owner")
    set native to attachment_audio_part(database and "session:owner" and "sound")
    if not (archive_list_text(native and 0) equals "ready") or else string_contains(messages and archive_list_text(native and 1)) equals 0 or else string_contains(messages and "Keep this task") equals 0 or else string_contains(messages and "Listen now") equals 0 or else string_contains(messages and "sound:attachment") equals 0 or else string_contains(messages and get_argument(2)) is not equal to 0:
        return 14
    set applied to archive_read_event(database and "owner:guidance:audio:applied")
    set boundary to http_decimal(archive_list_text(applied and 7))
    if string_contains(agent_run_messages_scoped(database and "owner" and boundary and 1) and archive_list_text(native and 1)) equals 0 or else string_contains(agent_run_messages_scoped(database and "owner" and boundary and 0) and "Listen now") is not equal to 0:
        return 22
    set recap to recap_sources_snapshot(database and "session:owner" and "owner:guidance:audio:applied")
    if string_contains(recap and "Listen now") equals 0 or else string_contains(recap and "sound:attachment") equals 0 or else string_contains(recap and get_argument(2)) is not equal to 0:
        return 23
    if web_guidance_files_environment(database and "owner" and "owner" and "audio-only" and "" and ["sound"] and "") is not equal to 0 or else agent_guidance_apply(database and "owner") is not equal to 0:
        return 15
    if web_guidance_request(database and "owner" and "owner" and "text" and "Continue") is not equal to 0 or else web_guidance_files_environment(database and "owner" and "owner" and "text" and "Continue" and ["sound"] and "") equals 0:
        return 16
    if agent_guidance_apply(database and "owner") is not equal to 0 or else agent_cancel_run(database and "owner") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 17
    set database to archive_open(get_argument(1))
    if web_guidance_files_environment(database and "owner" and "owner" and "audio" and "Listen now" and ["sound"] and "") is not equal to 0 or else web_guidance_files_environment(database and "owner" and "owner" and "late" and "Listen" and ["sound"] and "") equals 0:
        return 18
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='guidance_received';"))
    if not (archive_list_text(count and 1) equals "3") or else archive_verify(database and "session:owner") is not equal to 0:
        return 19
    if string_contains(agent_run_messages(database and "owner") and archive_list_text(native and 1)) equals 0:
        return 20
    if write_file(get_argument(2) and "changed fixture") is not equal to 1 or else string_length(agent_run_messages(database and "owner")) is not equal to 0:
        return 21
    print "PASS: atomic audio guidance, exact native bytes, same task, access isolation, attachment replay conflicts, rollback, reopen, terminal denial and changed-file failure"
    return sql_close(database)
