define reuse_browser_tick:
    set ready to given resolve:
        window.setTimeout(resolve and 0)
    return Reflect.construct(Promise and [ready])

define main:
    set output to document.getElementById("result")
    set window.reuseCalls to JSON.parse("[]")
    set window.echo_api to given path and payload:
        window.reuseCalls.push(JSON.parse(JSON.stringify(payload)))
        if path != "/api/external-profile" || payload.action != "list" || payload.account != "account-fixture":
            return Promise.reject("Unexpected saved-profile request")
        return Promise.resolve(JSON.parse("{\"status\":\"found\",\"profiles\":[{\"identity\":\"saved-profile\",\"label\":\"Saved <profile>\",\"model\":\"snapshot\"}]}"))
    set account to Object()
    set account.identity to "account-fixture"
    set panel to echo_external_saved(account)
    document.body.appendChild(panel)
    panel.querySelector("button").click()
    set pending to reuse_browser_tick().then(given ignored:
        if window.reuseCalls.length != 1 || panel.textContent.indexOf("Saved <profile>") < 0 || panel.querySelectorAll("button").length != 3 || panel.querySelector("profile"):
            return Promise.reject("Saved profile not safely reusable")
        set input to document.createElement("textarea")
        set input.id to "message"
        set input.value to "follow-up"
        document.body.appendChild(input)
        set picker to document.createElement("select")
        set picker.id to "provider-picker"
        set option to document.createElement("option")
        set option.value to "local-model"
        set option.textContent to "Local model"
        picker.appendChild(option)
        document.body.appendChild(picker)
        set window.echoToken to "fixture"
        set window.echoSession to "external-session"
        set window.echoReadOnly to false
        set window.echoUploading to false
        set window.echoGroup to null
        set window.echoExternal to true
        set window.echo_selected_files to given ignored:
            return JSON.parse("[]")
        set window.echo_queue_key to given ignored:
            return "fixture-queue"
        set window.echo_queue_read to given ignored:
            return JSON.parse("[]")
        set window.echo_queue_render to given ignored:
            return 0
        set window.echo_note to given ignored:
            return 0
        echo_queue_add(false)
        set saved to JSON.parse(window.localStorage.getItem("fixture-queue"))
        if saved.length != 1 || get_list(saved and 0).provider:
            return Promise.reject("External queue included hidden local provider")
        set window.echoExternal to false
        set input.value to "local follow-up"
        echo_queue_add(false)
        set saved to JSON.parse(window.localStorage.getItem("fixture-queue"))
        if get_list(saved and 0).provider != "local-model":
            return Promise.reject("Local queue lost its selected provider")
        set output.textContent to "PASS: saved profile listing/reuse uses text-safe labels; external queue omits hidden local selection and local queue retains it."
    )
    get_list(pending and "catch").call(pending and given error:
        set output.textContent to "FAIL: " + String(error)
    )
