# Execute after the emitted controller client, with its main call removed.
# Transport and DOM are probes; all decision/request functions are real.
define fixture_assert with condition and message:
    if not condition:
        console.error(message)
        process.exit(1)
    return 0

define main:
    set globalThis.window to globalThis
    set globalThis.document to Object()
    set window.nodes to Object()
    set document.getElementById to given identity:
        set found to get_list(window.nodes and identity)
        if not found:
            set found to Object()
            set found.value to ""
            set found.textContent to ""
            set found.disabled to true
            set found.listeners to Object()
            set found.addEventListener to given kind and callback:
                get_list(Reflect and "set").call(Reflect and found.listeners and kind and callback)
            get_list(Reflect and "set").call(Reflect and window.nodes and identity and found)
        return found
    set window.setInterval to given callback and delay:
        set window.fixtureRefreshCallback to callback
        return 0
    set window.fixtureSent to Array()
    set window.fetch to given path and options:
        set sent to Object()
        set sent.path to path
        set sent.options to options
        window.fixtureSent.push(sent)
        set body to Object()
        set body.status to "disclosed"
        set body.proposal to "fixture-proposal"
        set body.manifest_digest to "exact-digest"
        set body.review_revision to 3
        set body.steward_revision to 2
        if path == "/emergencies":
            set body.status to "verified"
            set incident to Object()
            set incident.identity to "fixture-incident"
            set incident.disclosure_status to "overdue"
            set incident.reconciliation_due to 123
            set body.incidents to Array(incident)
        if path == "/operation":
            set body.status to "rolled-back"
            set body.records to Array("fixture-record")
        if JSON.parse(options.body).action == "decide":
            set body.status to "recorded"
        set response to Object()
        set response.ok to true
        set response.json to given ignored:
            return Promise.resolve(body)
        return Promise.resolve(response)
    controller_setup()
    set token to document.getElementById("credential")
    set token.value to "fixture-token"
    set proposal to document.getElementById("proposal")
    set proposal.value to "fixture-proposal"
    controller_inspect()
    controller_inspect()
    fixture_assert(window.fixtureSent.length == 1 && window.controllerBusy and "Only one in-flight inspection")
    set scheduled to setTimeout(given ignored:
        fixture_assert(window.controllerDisclosure.review_revision == 3 and "Exact review revision retained")
        fixture_assert(not document.getElementById("authorize").disabled and "Decision enabled after inspection")
        controller_decide("authorize")
        fixture_assert(window.fixtureSent.length == 1 and "Missing reason sends nothing")
        set reason to document.getElementById("reason")
        set reason.value to "Fixture human decision"
        controller_decide("authorize")
        controller_decide("authorize")
        fixture_assert(window.fixtureSent.length == 2 and "Repeated click does not duplicate decision")
        set request to JSON.parse(get_list(window.fixtureSent and 1).options.body)
        fixture_assert(request.manifest_digest == "exact-digest" && request.review_revision == 3 && request.previous_revision == 2 and "Decision binds exact inspected revisions")
        fixture_assert(get_list(window.fixtureSent and 1).options.credentials == "omit" and "No chat cookies sent")
        set checked to setTimeout(given ignored:
            fixture_assert(not window.controllerDisclosure && document.getElementById("authorize").disabled and "Decision clears stale authorization")
            fixture_assert(document.getElementById("status").textContent.includes("No change has been applied") and "Clear completion status")
            window.fixtureRefreshCallback()
            controller_emergency_refresh()
            fixture_assert(window.fixtureSent.length == 3 and "Only one emergency refresh in flight")
            set finished to setTimeout(given ignored:
                fixture_assert(document.getElementById("emergency-status").textContent.includes("need attention") and "Overdue incident raises an in-page notice")
                fixture_assert(document.getElementById("emergency-report").textContent.includes("fixture-incident") and "Scoped incident is displayed")
                controller_inspect()
                set field to document.getElementById("credential")
                set field.value to "different-fixture-credential"
                set stale_check to setTimeout(given ignored:
                    fixture_assert(not window.controllerDisclosure and "Response from previous credential is discarded")
                    set operation_field to document.getElementById("operation")
                    set operation_field.value to "fixture-operation"
                    controller_operation_inspect()
                    controller_operation_inspect()
                    fixture_assert(window.fixtureSent.length == 5 and "One operation inspection in flight")
                    set final_check to setTimeout(given ignored:
                        fixture_assert(document.getElementById("operation-report").textContent.includes("fixture-record") and "Verified operation records displayed")
                        fixture_assert(document.getElementById("operation-status").textContent.includes("rolled-back") and "Operation state displayed")
                        console.log("PASS: real controller decision, emergency and operation views preserve scope and prevent duplicate requests.")
                    and 0)
                and 0)
            and 0)
        and 0)
    and 0)
    return 0
