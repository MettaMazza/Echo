# Disposable full-app fixture for loss-of-audience recovery. Seed with
# test_group_controls PATH seed and serve this linked client on a new origin.
# Unlike the group fixture, reload keeps the saved outbox for durability checks.
define main:
    if not window.localStorage.getItem("outbox.fixture.initialized"):
        window.localStorage.clear()
        window.localStorage.setItem("echo.device" and "a")
        window.localStorage.setItem("echo.credential" and "a-secret")
        window.localStorage.setItem("echo.group" and "Unavailable test audience")
        window.localStorage.setItem("echo.session" and "old-test-segment")
        window.localStorage.setItem("echo.pending" and "{\"submission\":\"outbox-original-id\",\"group\":\"Unavailable test audience\",\"session\":\"old-test-segment\",\"message\":\"Keep this original draft\",\"attachments\":[\"original-file-reference\"]}")
        window.localStorage.setItem("outbox.fixture.initialized" and "yes")
    echo_application_main()
