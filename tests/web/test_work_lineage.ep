import "../../app/web/work_status"
import "../../app/web/cancellation"
import "../fixtures/schedule_fixture"
import "../fixtures/delegation_fixture"

define work_fixture_page with database as Int and device as Str and session as Str and family as Str returning Str:
    set request to concat("{\"session\":" and concat(provider_quote(session) and concat(",\"family\":" and concat(provider_quote(family) and ",\"after\":0,\"amount\":100}"))))
    return web_work_page(database and device and provider_json_tokens(request))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_cancel_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if schedule_fixture_origin(database and "a" and "scheduled") is not equal to 0 or else schedule_fixture_origin(database and "b" and "foreign") is not equal to 0:
        return 4
    if not (schedule_create(database and "scheduled" and "schedule" and "Visible scheduled instruction" and 9999999999999 and 0 and "catch-up") equals "created") or else not (schedule_create(database and "foreign" and "schedule" and "Foreign scheduled secret" and 9999999999999 and 0 and "catch-up") equals "created"):
        return 5
    set parent to agent_run_read(database and "scheduled")
    set session to archive_list_text(parent and 0)
    set schedules to work_fixture_page(database and "a" and session and "schedules")
    if string_contains(schedules and "Visible scheduled instruction") equals 0 or else string_contains(schedules and "Foreign scheduled secret") is not equal to 0 or else string_contains(schedules and "9999999999999") equals 0:
        display schedules
        return 6
    if delegation_fixture_request(database and "scheduled" and session and "child" and "{\"instruction\":\"Isolated child task\"}") is not equal to 0 or else not (delegation_materialize(database and "scheduled" and "child") equals "materialized"):
        return 7
    set jobs to work_fixture_page(database and "a" and session and "runs")
    if string_contains(jobs and "scheduled:delegate:child") equals 0 or else string_contains(jobs and "foreign") is not equal to 0:
        display jobs
        return 8
    if not (group_create(database and "a" and "g" and "local" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "a" and "shared" and "g" and "local" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "a" and "group-parent" and "shared" and "local" and "server" and "room" and "Group work") equals "accepted"):
        return 9
    if delegation_fixture_request(database and "group-parent" and "shared" and "child" and "{\"instruction\":\"Shared child task\"}") is not equal to 0 or else not (delegation_materialize(database and "group-parent" and "child") equals "materialized"):
        return 10
    set jobs to work_fixture_page(database and "a" and "shared" and "runs")
    if string_contains(jobs and "group-parent:delegate:child") equals 0 or else string_contains(jobs and "scheduled:delegate:child") is not equal to 0 or else not (work_fixture_page(database and "b" and "shared" and "runs") equals "{\"status\":\"not-authorized\"}"):
        display jobs
        return 11
    if not (group_change(database and "a" and "leave" and "g" and "device:a" and "left" and 1) equals "recorded"):
        return 12
    if not (work_fixture_page(database and "a" and "shared" and "runs") equals "{\"status\":\"not-authorized\"}") or else archive_verify(database and session) is not equal to 0 or else archive_verify(database and "shared") is not equal to 0:
        return 13
    display "PASS: populated schedules, due time and instruction, private/shared delegated children, cross-silo exclusion, nonmember denial and membership departure revocation. No workers launched."
    return sql_close(database)
