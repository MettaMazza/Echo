import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is less than 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    set first to web_submit(database and "submission" and "" and "Hello café 🌍")
    if not (ptr_to_str(get_list(first and 0)) equals "accepted") or else get_list(first and 3) is not equal to 1:
        return 1
    set session to ptr_to_str(get_list(first and 1))
    set retry to web_submit(database and "submission" and "" and "Hello café 🌍")
    if not (ptr_to_str(get_list(retry and 0)) equals "accepted") or else get_list(retry and 3) is not equal to 0:
        return 1
    set conflict to web_submit(database and "submission" and "" and "Different text")
    if not (ptr_to_str(get_list(conflict and 0)) equals "submission-conflict"):
        return 1
    set busy to web_submit(database and "next" and session and "Another message")
    if not (ptr_to_str(get_list(busy and 0)) equals "session-active"):
        return 1
    set unknown to web_submit(database and "unknown" and "not-a-session" and "Another message")
    if not (ptr_to_str(get_list(unknown and 0)) equals "unknown-session"):
        return 1
    # Inject run creation failure after the pending message/session inserts.
    if sql_execute(database and "CREATE TRIGGER reject_fixture_run BEFORE INSERT ON echo_runs WHEN NEW.run='broken' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 1
    set rejected to web_submit(database and "broken" and "" and "Must roll back")
    if not (ptr_to_str(get_list(rejected and 0)) equals "database-error"):
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_events WHERE event='broken:user')+(SELECT COUNT(*) FROM echo_sessions WHERE session='session:broken');"))
    if not (ptr_to_str(get_list(count and 0)) equals "found") or else not (ptr_to_str(get_list(count and 1)) equals "0"):
        display "FAIL: partial submission survived rollback."
        return 1
    set tokens to provider_json_tokens(web_run_status(database and "submission"))
    if tokens equals 0:
        return 1
    if not (provider_value(tokens and provider_member(tokens and 0 and "state")) equals "ready"):
        return 1
    if agent_cancel_run(database and "submission") is not equal to 0:
        return 1
    set next to web_submit(database and "next" and session and "Continue after cancellation")
    if not (ptr_to_str(get_list(next and 0)) equals "accepted"):
        return 1
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set retry to web_submit(database and "submission" and "" and "Hello café 🌍")
    if not (ptr_to_str(get_list(retry and 0)) equals "accepted") or else get_list(retry and 3) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: atomic session/message/run submission, idempotent retry, conflicting retry rejection, active-session guard, injected rollback, durable status and retry after reopen."
    return 0
