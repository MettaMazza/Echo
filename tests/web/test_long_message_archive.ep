import "../../app/web/attachments"
import "../../app/web/http_api"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "seed" and "" and "Start")
    set session to archive_list_text(first and 1)
    if agent_cancel_run(database and "seed") is not equal to 0:
        return 4
    if write_file(get_argument(2) and "Separate attachment with its own provenance") is not equal to 1 or else web_attachment_register(database and "owner" and session and "source" and get_argument(2) and "source.txt" and "text/plain") is not equal to 0:
        return 5
    set message to "Beginning of the complete multipart submission.\n"
    set index to 0
    repeat while index < 1500:
        set message to concat(message and "Part: café, quoted \"text\", newline\n")
        set index to index + 1
    set tail to "FINAL-100-CHARACTERS-MUST-SURVIVE: Ω end of the original complete message."
    set message to concat(message and tail)
    set body to concat("{\"submission\":\"long\",\"session\":" and provider_quote(session))
    set quoted to provider_quote(message)
    set body to concat(body and concat(",\"message\":" and quoted))
    set body to concat(body and ",\"attachments\":[\"source\"]}")
    set tokens to provider_json_tokens(body)
    set result to web_submit_json_owned(database and "owner" and tokens)
    if not (archive_list_text(result and 0) equals "accepted"):
        return 6
    if sql_close(database) is not equal to 0:
        return 7
    set database to archive_open(get_argument(1))
    set row to archive_read_event(database and "long:user")
    set stored to archive_list_text(row and 3)
    if not (stored equals message) or else string_contains(stored and tail) equals 0:
        return 8
    set occurred to archive_list_text(row and 4)
    set previous to archive_list_text(row and 5)
    set digest to archive_digest(session and "long:user" and "user" and stored and occurred and previous)
    if not (digest equals archive_list_text(row and 6)) or else archive_verify(database and session) is not equal to 0:
        return 9
    set binding to turn_attachment_read(database and session and "long:user")
    if string_contains(archive_list_text(binding and 1) and "source:attachment") equals 0:
        return 10
    set result to web_submit_json_owned(database and "owner" and provider_json_tokens(body))
    if not (archive_list_text(result and 0) equals "accepted") or else get_list(result and 3) is not equal to 0:
        return 11
    display "PASS: long Unicode multi-part text plus attachment survives submission JSON, canonical archive reopen, exact tail and full digest verification, and idempotent retry."
    return sql_close(database)
