import "../../app/tools/attachment_tools"
import "../../app/web/attachments"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submission to web_submit_owned(database and "owner" and "request" and "" and "Read text")
    set session to ptr_to_str(get_list(submission and 1))
    if write_file(get_argument(2) and "café ☕ end") is not equal to 1 or else web_attachment_register(database and "owner" and session and "text" and get_argument(2) and "note.txt" and "text/plain") is not equal to 0:
        return 1
    set arguments to "{\"attachment\":\"text\",\"offset\":3,\"characters\":3}"
    set tokens to provider_json_tokens(session_tool_execute(database and session and "attachment_read_text" and arguments))
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "é ☕") or else not (provider_value(tokens and provider_member(tokens and 0 and "characters")) equals "3") or else not (provider_value(tokens and provider_member(tokens and 0 and "event")) equals "text:attachment"):
        return 1
    if not (session_tool_execute(database and "foreign" and "attachment_read_text" and arguments) equals "{\"status\":\"end\"}"):
        return 1
    if write_file(get_argument(2) and "changed") is not equal to 1:
        return 1
    if not (session_tool_execute(database and session and "attachment_read_text" and arguments) equals "{\"status\":\"integrity-failed\"}"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: verified Unicode character range, source reference, foreign session exclusion and changed-file rejection."
    return 0
