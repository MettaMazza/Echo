import "../../app/tools/attachment_tools"
import "../../app/web/attachments"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (session_principal_schema(database) equals "applied"):
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submission to web_submit_owned(database and "owner" and "request" and "" and "Read text")
    set session to ptr_to_str(get_list(submission and 1))
    if write_file(get_argument(2) and "café ☕ end") is not equal to 1 or else web_attachment_register(database and "owner" and session and "text" and get_argument(2) and "note.txt" and "text/plain") is not equal to 0:
        return 1
    set arguments to "{\"attachment\":\"text\",\"offset\":3,\"characters\":3}"
    set tokens to provider_json_tokens(session_tool_execute(database and session and "attachment_read_text" and arguments))
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "é ☕") or else not (provider_value(tokens and provider_member(tokens and 0 and "characters")) equals "3") or else not (provider_value(tokens and provider_member(tokens and 0 and "event")) equals "text:attachment"):
        return 1
    if not (session_tool_execute(database and "foreign" and "attachment_read_text" and arguments) equals "{\"status\":\"end\"}"):
        return 1
    set text to "café ☕ end"
    if attachment_text_find(text and "search" and "☕" and 0) is not equal to 5 or else attachment_text_find(text and "search" and "absent" and 0) is not equal to -1:
        return 2
    set searched to session_tool_execute(database and session and "attachment_read_text" and "{\"attachment\":\"text\",\"mode\":\"search\",\"query\":\"☕\",\"offset\":0,\"characters\":5}")
    if string_contains(searched and "☕ end") equals 0 or else string_contains(searched and "\"next_offset\":6") equals 0:
        display searched
        return 3
    if string_contains(session_tool_execute(database and session and "attachment_read_text" and "{\"attachment\":\"text\",\"mode\":\"search\",\"query\":\"☕\",\"offset\":6,\"characters\":5}") and "\"status\":\"end\"") equals 0:
        return 4
    if attachment_text_find("é\n## Topic\nbody\n# Next" and "headings" and "" and 0) is not equal to 2 or else attachment_text_find("é\n## Topic\nbody\n# Next" and "headings" and "" and 3) is not equal to 16:
        return 5
    set foreign to session_tool_execute(database and "foreign" and "attachment_read_text" and "{\"attachment\":\"text\",\"mode\":\"search\",\"query\":\"☕\",\"offset\":0,\"characters\":5}")
    if not (foreign equals "{\"status\":\"end\"}"):
        return 6
    if write_file(get_argument(2) and "changed") is not equal to 1:
        return 1
    if not (session_tool_execute(database and session and "attachment_read_text" and arguments) equals "{\"status\":\"integrity-failed\"}"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: Unicode read/search cursors, heading discovery, end-of-search, foreign session exclusion and changed-file rejection."
    return 0
