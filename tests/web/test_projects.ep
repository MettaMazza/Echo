import "../../app/web/projects"
import "../../app/jobs/delegation_schema"

define browser_project_query with operation as Str and session as Str and identity as Str and project as Str and expected as Str and manifest as Str returning Str:
    set output to concat("{\"operation\":" and provider_quote(operation))
    for each pair in [["session",session],["identity",identity],["project",project],["expected_revision",expected]]:
        set output to concat(output and concat("," and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1))))))
    return concat(output and concat(",\"manifest\":" and concat(manifest and "}")))

define browser_project_status with result as Str returning Str:
    set tokens to provider_json_tokens(result)
    return provider_value(tokens and provider_member(tokens and 0 and "status"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "Project fixture")
    set second to web_submit_owned(database and "owner" and "second" and "" and "Resume project")
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Foreign fixture")
    set session to archive_list_text(first and 1)
    set next_session to archive_list_text(second and 1)
    set manifest to "{\"name\":\"Café browser project\",\"instructions\":\"Preserve the amber marker.\",\"tasks\":[{\"id\":\"one\",\"title\":\"Read original\",\"status\":\"todo\"}],\"files\":[]}"
    set create_query to browser_project_query("create" and session and "create" and "" and "" and manifest)
    set result to web_project_request(database and "owner" and create_query)
    if not (browser_project_status(result) equals "recorded"):
        display result
        return 4
    set tokens to provider_json_tokens(result)
    set project to provider_value(tokens and provider_member(tokens and 0 and "project"))
    set revision to provider_value(tokens and provider_member(tokens and 0 and "revision"))
    if not (browser_project_status(web_project_request(database and "owner" and create_query)) equals "already-recorded"):
        return 5
    set list to web_project_request(database and "owner" and browser_project_query("list" and next_session and "" and "" and "" and "{}"))
    if string_contains(list and project) equals 0 or else string_contains(list and "Café browser project") equals 0:
        display list
        return 6
    if not (browser_project_status(web_project_request(database and "foreign" and create_query)) equals "not-authorized") or else string_contains(web_project_request(database and "foreign" and browser_project_query("list" and archive_list_text(foreign and 1) and "" and "" and "" and "{}")) and project) is not equal to 0:
        return 7
    set selected to web_project_request(database and "owner" and browser_project_query("select" and next_session and "selection" and project and "" and "{}"))
    if not (browser_project_status(selected) equals "recorded") or else string_contains(project_context(database and "second") and "amber marker") equals 0:
        display selected
        return 8
    set update to browser_project_query("update" and next_session and "update" and project and revision and manifest)
    if not (browser_project_status(web_project_request(database and "owner" and update)) equals "recorded") or else not (browser_project_status(web_project_request(database and "owner" and update)) equals "already-recorded"):
        return 9
    if not (browser_project_status(web_project_request(database and "owner" and browser_project_query("update" and session and "stale" and project and revision and manifest))) equals "revision-conflict"):
        return 10
    if not (group_create(database and "owner" and "group" and "browser" and "local" and "group" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "group" and "browser" and "local" and "group" and 1) equals "created"):
        return 11
    if not (browser_project_status(web_project_request(database and "owner" and browser_project_query("select" and "shared" and "private-to-group" and project and "" and "{}"))) equals "not-authorized"):
        return 12
    set shared to web_project_request(database and "owner" and browser_project_query("create" and "shared" and "shared-create" and "" and "" and manifest))
    if not (browser_project_status(shared) equals "recorded"):
        display shared
        return 13
    set fields to provider_json_tokens(shared)
    set shared_project to provider_value(fields and provider_member(fields and 0 and "project"))
    if not (browser_project_status(web_project_request(database and "owner" and browser_project_query("select" and session and "group-to-private" and shared_project and "" and "{}"))) equals "not-authorized"):
        return 14
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if archive_verify(database and session) is not equal to 0 or else archive_verify(database and next_session) is not equal to 0 or else archive_verify(database and "shared") is not equal to 0 or else string_contains(project_context(database and "second") and "amber marker") equals 0:
        return 15
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (browser_project_status(web_project_request(database and "owner" and create_query)) equals "not-authorized"):
        return 16
    display "PASS: authenticated browser project records, exact retries, cross-session selection consumed by model context, stale edit refusal, foreign/group isolation, durable reopen, archive integrity and revoked device denial."
    return sql_close(database)
