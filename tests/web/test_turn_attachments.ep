import "../../app/web/attachments"
import "../../app/web/http_api"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set first to web_submit_owned(database and "owner" and "seed" and "" and "Start")
    set session to ptr_to_str(get_list(first and 1))
    if agent_cancel_run(database and "seed") is not equal to 0:
        return 1
    if web_attachment_register(database and "owner" and session and "source" and get_argument(2) and "source.bin" and "application/octet-stream") is not equal to 0:
        return 1
    set selected to create_list()
    set added to append_list(selected and "source")
    set accepted to web_submit_owned_files(database and "owner" and "turn" and session and "Read this" and selected)
    if not (ptr_to_str(get_list(accepted and 0)) equals "accepted"):
        display "FAIL: selected submission"
        return 1
    set binding to turn_attachment_read(database and session and "turn:user")
    if not (ptr_to_str(get_list(binding and 0)) equals "found") or else string_contains(ptr_to_str(get_list(binding and 1)) and "source:attachment") equals 0:
        return 1
    set transcript to web_session_transcript(database and session)
    if string_contains(transcript and "source:attachment") equals 0 or else string_contains(transcript and "source.bin") equals 0 or else string_contains(transcript and "Read this") equals 0:
        display "FAIL: transcript source provenance"
        return 1
    set messages to agent_run_messages(database and "turn")
    if string_contains(messages and "source:attachment") equals 0 or else string_contains(messages and "Read this") equals 0 or else string_contains(messages and "application/octet-stream") equals 0:
        display "FAIL: reconstructed source receipt"
        return 1
    if string_length(turn_attachment_manifest(database and "foreign-owner" and session and "turn:user" and selected)) is not equal to 0:
        return 1
    set retry to web_submit_owned_files(database and "owner" and "turn" and session and "Read this" and selected)
    if not (ptr_to_str(get_list(retry and 0)) equals "accepted") or else get_list(retry and 3) is not equal to 0:
        return 1
    set parsed to web_submit_json_owned(database and "owner" and provider_json_tokens("{\"submission\":\"turn\",\"session\":\"session:seed\",\"message\":\"Read this\",\"attachments\":[\"source\"]}"))
    if not (ptr_to_str(get_list(parsed and 0)) equals "accepted") or else get_list(parsed and 3) is not equal to 0:
        return 1
    set bad to web_submit_json_owned(database and "owner" and provider_json_tokens("{\"submission\":\"bad\",\"message\":\"Read\",\"attachments\":[42]}"))
    if not (ptr_to_str(get_list(bad and 0)) equals "invalid-request"):
        return 1
    set changed to web_submit_owned(database and "owner" and "turn" and session and "Read this")
    if not (ptr_to_str(get_list(changed and 0)) equals "submission-conflict"):
        return 1
    if agent_cancel_run(database and "turn") is not equal to 0:
        return 1
    set added to append_list(selected and "source")
    set duplicate to web_submit_owned_files(database and "owner" and "duplicate" and session and "Read" and selected)
    if not (ptr_to_str(get_list(duplicate and 0)) equals "invalid-attachments"):
        return 1
    set selected to create_list()
    set added to append_list(selected and "missing")
    set absent to web_submit_owned_files(database and "owner" and "absent" and session and "Read" and selected)
    if not (ptr_to_str(get_list(absent and 0)) equals "invalid-attachments"):
        return 1
    set selected to create_list()
    set added to append_list(selected and "source")
    if sql_execute(database and "CREATE TRIGGER reject_binding BEFORE INSERT ON echo_events WHEN NEW.kind='turn_attachments' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 1
    set failed to web_submit_owned_files(database and "owner" and "broken" and session and "Read" and selected)
    if not (ptr_to_str(get_list(failed and 0)) equals "database-error"):
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_events WHERE event='broken:user')+(SELECT COUNT(*) FROM echo_runs WHERE run='broken');"))
    if not (ptr_to_str(get_list(count and 1)) equals "0") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set retry to web_submit_owned_files(database and "owner" and "turn" and session and "Read this" and selected)
    if not (ptr_to_str(get_list(retry and 0)) equals "accepted") or else get_list(retry and 3) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: atomic attachment provenance, unchanged retry after reopen, changed/duplicate/missing selection rejection and injected binding rollback."
    return 0
