# Linked with the actual client after renaming startup main. No model calls.
define main:
    set target to document.getElementById("result")
    set sample to document.getElementById("sample")
    set sample.innerHTML to renderAiMarkdown("42. And yes, the conversation works.\n43. The next item.\n\n7) Another starting number.\n\n<script>not executable</script>")
    set lists to sample.querySelectorAll("ol")
    if lists.length != 2 || lists.item(0).start != 42 || lists.item(1).start != 7:
        set target.textContent to "FAIL: source numbering was changed."
        return 1
    if lists.item(0).children.length != 2 || sample.querySelector("script"):
        set target.textContent to "FAIL: list structure or HTML escaping."
        return 2
    set target.textContent to "PASS: source list starts 42 and 7 retained; consecutive items and HTML escaping preserved."
    return 0
