import "../../app/web/attachments"
import "../../app/jobs/delegation_schema"

define research_fixture_call with database as Int and session as Str and identity as Str and digest as Str and receipt as Str returning Int:
    set request to concat("{\"name\":\"web_fetch\",\"run_id\":\"first\",\"call_id\":" and concat(provider_quote(identity) and "}"))
    set result to concat("{\"result\":{\"status\":\"complete\",\"receipt\":" and concat(provider_quote(receipt) and concat(",\"sources\":[{\"url\":\"https://example.org/retained\",\"body\":\"body\",\"body_sha256\":" and concat(provider_quote(digest) and "}]}}"))))
    if archive_append(database and session and concat(identity and ":request") and "tool_call" and request and "fixture") is not equal to 0 or else archive_append(database and session and concat(identity and ":result") and "tool_result" and result and "fixture") is not equal to 0:
        return 1
    return web_device_write(database and "INSERT INTO echo_tool_calls(run,call_id,session,request_event,state,result_event) VALUES('first',?,?,?,'observed',?);" and [identity,session,concat(identity and ":request"),concat(identity and ":result")])

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set own to web_submit_owned(database and "a" and "first" and "" and "Research fixture")
    set other to web_submit_owned(database and "b" and "other" and "" and "Other fixture")
    set session to archive_list_text(own and 1)
    set foreign to archive_list_text(other and 1)
    if write_file(get_argument(2) and "retained-page-marker") is not equal to 1 or else web_attachment_register(database and "a" and session and "body" and get_argument(2) and "Original page" and "text/html") is not equal to 0:
        return 4
    set file to web_attachment_owned(database and "a" and "body")
    set digest to archive_list_text(file and 4)
    if archive_append(database and session and "receipt" and "web_fetch_receipt" and "{}" and "fixture") is not equal to 0 or else archive_append(database and foreign and "foreign-receipt" and "web_fetch_receipt" and "{}" and "fixture") is not equal to 0:
        return 5
    if research_fixture_call(database and session and "valid" and digest and "receipt") is not equal to 0 or else research_fixture_call(database and session and "bad-digest" and "wrong" and "receipt") is not equal to 0 or else research_fixture_call(database and session and "foreign-receipt-call" and digest and "foreign-receipt") is not equal to 0 or else research_fixture_call(database and foreign and "foreign-body-call" and digest and "foreign-receipt") is not equal to 0:
        return 6
    set report to web_run_research_sources(database and session and "first")
    set fields to provider_json_tokens(report)
    if fields equals 0 or else length_list(provider_items(fields and 0)) is not equal to 1 or else string_contains(report and "valid:result") equals 0 or else string_contains(report and "retained-page-marker") is not equal to 0:
        display report
        return 7
    if not (web_run_research_sources(database and foreign and "first") equals "[]") or else not (web_run_research_sources(database and session and "other") equals "[]") or else archive_verify(database and session) is not equal to 0:
        return 8
    display "PASS: retained research body and receipt binding, digest mismatch exclusion, foreign receipt/body isolation, run isolation and original archive integrity."
    return sql_close(database)
