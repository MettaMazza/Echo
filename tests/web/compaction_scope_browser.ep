# Append to production client with its main renamed. No provider calls.
define main:
    set composer to document.createElement("div")
    set composer.id to "composer"
    document.body.appendChild(composer)
    set progress to document.createElement("p")
    set progress.id to "progress"
    document.body.appendChild(progress)
    set window.echoSession to "scope-a"
    set observation to Object()
    set observation.session to "scope-a"
    set observation.state to "pending"
    set result to Object()
    set result.compaction to observation
    set result.worker_status to "running"
    set result.activity to "Preparing the detailed recap."
    echo_compaction_progress(result)
    set panel to document.getElementById("compaction-progress")
    set started to not panel.hidden
    set observation.session to "scope-b"
    echo_compaction_progress(result)
    set output to document.createElement("pre")
    set output.id to "fixture-result"
    if started && panel.hidden && panel.getAttribute("data-active") == "false":
        set output.textContent to "PASS: another conversation cannot retain the current compaction indicator with identical activity text."
    else:
        set output.textContent to "FAIL: stale compaction indicator survives a foreign conversation observation."
    document.body.appendChild(output)
    set style to document.createElement("style")
    set style.textContent to echo_layout_style()
    document.head.appendChild(style)
    set button to document.createElement("button")
    set button.textContent to "Show current conversation compaction"
    button.addEventListener("click" and given ignored:
        set observation.session to "scope-a"
        echo_compaction_progress(result)
    )
    document.body.appendChild(button)
