# Link after client.ep with its main renamed to echo_application_main.
# Use a disposable test origin: no credentials or real messages are supplied.
define main:
    window.localStorage.clear()
    window.localStorage.setItem("echo.device" and "fixture-device")
    set original to "{\"submission\":\"fixed-original-id\",\"group\":\"Original audience\",\"session\":\"original-segment\",\"message\":\"Kept verbatim <b>not markup</b>\",\"attachments\":[\"file-original\"]}"
    window.localStorage.setItem("echo.pending" and original)
    set window.echoOutboxCalls to 0
    set window.fetch to given path and options:
        set window.echoOutboxCalls to window.echoOutboxCalls + 1
        return Promise.reject("Parking and restoring must not send requests")
    set key to echo_outbox_prefix() + "fixed-original-id"
    set checked to Promise.resolve().then(given ignored:
        return echo_outbox_park()
    ).then(given payload:
        if window.localStorage.getItem("echo.pending") || window.localStorage.getItem(key) != original || payload.session != "original-segment":
            return Promise.reject("Original bytes or pending-lock release failed")
        return echo_outbox_restore(key)
    ).then(given payload:
        if window.localStorage.getItem("echo.pending") != original || payload.group != "Original audience" || payload.submission != "fixed-original-id":
            return Promise.reject("Restore changed submission identity or audience")
        window.localStorage.setItem("echo.pending" and "newer draft must not be replaced")
        set conflict to echo_outbox_restore(key)
        set catcher to get_list(conflict and "catch")
        return catcher.call(conflict and given error:
            if window.localStorage.getItem("echo.pending") != "newer draft must not be replaced":
                return Promise.reject("Restore overwrote newer pending work")
            window.localStorage.setItem("echo.device" and "other-device")
            return 0
        )
    ).then(given ignored:
        set denied to echo_outbox_restore(key)
        set catcher to get_list(denied and "catch")
        return catcher.call(denied and given error:
            if window.localStorage.getItem("echo.pending") != "newer draft must not be replaced" || window.echoOutboxCalls != 0:
                return Promise.reject("Cross-device restore mutated pending work or sent a request")
            window.localStorage.setItem("echo.device" and "fixture-device")
            window.localStorage.setItem("echo.pending" and original)
            echo_outbox_setup()
            set result to document.getElementById("result")
            set result.textContent to "PASS: original bytes, audience, files and submission ID preserved; pending lock released only after saved copy; newer pending and other-device restore protected; no network requests."
            return 0
        )
    )
    set catcher to get_list(checked and "catch")
    catcher.call(checked and given error:
        set result to document.getElementById("result")
        set result.textContent to "FAIL: " + error
    )
    return 0
