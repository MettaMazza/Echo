import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 1
    set created to web_create_session(database and "owner" and "rename")
    set session to ptr_to_str(get_list(created and 1))
    if not (web_rename_session(database and "other" and session and "New conversation" and "Intruder") equals "not-found"):
        return 1
    if not (web_rename_session(database and "owner" and session and "New conversation" and "") equals "invalid-title"):
        return 1
    if not (web_rename_session(database and "owner" and session and "New conversation" and "My renamed conversation") equals "renamed"):
        return 1
    if not (web_rename_session(database and "owner" and session and "New conversation" and "My renamed conversation") equals "renamed"):
        return 1
    if not (web_rename_session(database and "owner" and session and "New conversation" and "Stale tab") equals "title-changed"):
        return 1
    set submitted to web_submit_owned(database and "owner" and "first-rename-turn" and session and "First message")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    set row to history_collect_one(archive_prepare(database and "SELECT title FROM echo_sessions WHERE session='draft:rename';"))
    if not (ptr_to_str(get_list(row and 1)) equals "My renamed conversation"):
        return 1
    if sql_execute(database and "CREATE TRIGGER reject_rename BEFORE INSERT ON echo_events WHEN NEW.kind='session_title' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 1
    if not (web_rename_session(database and "owner" and session and "My renamed conversation" and "Must roll back") equals "database-error"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set row to history_collect_one(archive_prepare(database and "SELECT title FROM echo_sessions WHERE session='draft:rename';"))
    if not (ptr_to_str(get_list(row and 1)) equals "My renamed conversation"):
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='session_title';"))
    if not (ptr_to_str(get_list(count and 1)) equals "1") or else archive_verify(database and session) is not equal to 0:
        return 1
    if web_device_revoke(database and "owner") is not equal to 0 or else not (web_rename_session(database and "owner" and session and "My renamed conversation" and "Revoked") equals "not-found"):
        return 1
    set closed to sql_close(database)
    display "PASS: owned rename, retry, stale-tab rejection, first-message preservation, rollback, reopen and revocation."
    return 0
