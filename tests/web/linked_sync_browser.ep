# Browser fixture uses the real watcher and queue functions. Only transport,
# history rendering and worker cancellation are replaced with visible probes.
define echo_api with path and query:
    set response to Object()
    set response.status to "found"
    set response.sessions to window.fixtureSessions
    return Promise.resolve(response)

define echo_history:
    set document_text to document.getElementById("observed")
    set document_text.textContent to "Automatically received: " + window.echoRun
    return 0

define echo_poll:
    return 0

define echo_stop with event:
    set target to document.getElementById("cancel-observed")
    set target.textContent to "Stop requested for " + window.echoRun
    return 0

define echo_note with text:
    set target to document.getElementById("status")
    set target.textContent to text
    return 0

define echo_selected_files:
    return Array()

define main:
    window.localStorage.clear()
    window.localStorage.setItem("echo.device" and "fixture-device")
    set window.echoToken to "fixture"
    set window.echoSession to "shared-conversation"
    set window.echoRun to "first-turn"
    set window.echoBusy to true
    set window.echoCanStop to true
    set window.fixtureSessions to Array()
    echo_queue_setup()
    echo_queue_render()
    document.getElementById("queue-message").addEventListener("click" and given event:
        echo_queue_add(false)
    )
    document.getElementById("remote-message").addEventListener("click" and given event:
        set session to Object()
        set session.session to "shared-conversation"
        set session.title to "Shared conversation updated from other device"
        set session.run to "second-turn"
        set other to Object()
        set other.session to "new-conversation"
        set other.title to "New chat from other device"
        set other.run to ""
        set window.fixtureSessions to Array(session and other)
    )
    window.setInterval(echo_linked_session_watch and 300)
