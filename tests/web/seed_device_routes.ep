import "../../app/web/run_store"

# Public test credentials, only for a disposable loopback fixture database.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "fixture-invite-a") is not equal to 0 or else web_pairing_invite(database and "fixture-invite-b") is not equal to 0 or else web_pairing_invite(database and "fixture-invite-c") is not equal to 0:
        return 1
    if web_device_pair(database and "fixture-invite-a" and "a" and "Phone fixture" and "fixture-token-a") is not equal to 0 or else web_device_pair(database and "fixture-invite-b" and "b" and "Tablet fixture" and "fixture-token-b") is not equal to 0:
        return 1
    set first to web_submit_owned(database and "a" and "route-a" and "" and "Only device A may read this.")
    if not (ptr_to_str(get_list(first and 0)) equals "accepted"):
        return 1
    return sql_close(database)
