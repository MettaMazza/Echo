import "../../app/web/export"
import "../../app/archive/export_verify"
import "fs"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "submission" and "" and "Exact café\nwith a second line.")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    set session to ptr_to_str(get_list(submitted and 1))
    set exported to web_session_export(database and "owner" and session)
    if get_argument_count() equals 3:
        if write_file(get_argument(2) and exported) is not equal to 1:
            return 1
    set tokens to provider_json_tokens(exported)
    if archive_export_verify(exported and "") is not equal to 0 or else archive_export_verify(exported and "wrong-head") equals 0:
        return 1
    set damaged to ptr_to_str(string_replace(exported and "Exact café" and "Altered café"))
    if archive_export_verify(damaged and "") equals 0:
        return 1
    set damaged to ptr_to_str(string_replace(exported and "\"event_count\":\"1\"" and "\"event_count\":\"2\""))
    if archive_export_verify(damaged and "") equals 0:
        return 1
    if tokens equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found"):
        return 1
    set events to provider_items(tokens and provider_member(tokens and 0 and "events"))
    if length_list(events) is less than 1:
        return 1
    set first to get_list(events and 0)
    if not (provider_value(tokens and provider_member(tokens and first and "payload")) equals "Exact café\nwith a second line."):
        return 1
    set original to archive_read_event(database and provider_value(tokens and provider_member(tokens and first and "event")))
    if not (provider_value(tokens and provider_member(tokens and first and "digest")) equals ptr_to_str(get_list(original and 6))):
        return 1
    if not (web_session_export(database and "other" and session) equals "{\"status\":\"not-found\"}") or else not (web_session_export(database and "owner" and "missing") equals "{\"status\":\"not-found\"}"):
        return 1
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='owner';") is not equal to 0 or else not (web_session_export(database and "owner" and session) equals "{\"status\":\"not-found\"}"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: verified export preserves original Unicode payload and digest; foreign, missing and revoked access rejected."
    return 0
