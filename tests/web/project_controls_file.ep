import "../../app/web/attachments"

# Adds one inert source to the disposable share_controls_seed archive only.
define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    set run to agent_run_read(database and "share-source")
    if run equals 0 or else not (web_device_authenticate(database and "a-secret") equals "a"):
        return 2
    if write_file(get_argument(2) and "Project browser file marker: orchard-file-813") is not equal to 1:
        return 3
    if web_attachment_register(database and "a" and archive_list_text(run and 0) and "project-browser-file" and get_argument(2) and "Orchard notes.txt" and "text/plain") is not equal to 0:
        return 4
    return sql_close(database)
