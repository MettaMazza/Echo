import "../../app/web/run_store"
import "fs"

# Synthetic UI acceptance content, never claimed as a model response.
define main returning Int:
    if get_argument_count() is not equal to 3 and get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    set run to "rendering-fixture"
    if get_argument_count() equals 5:
        set run to get_argument(3)
    set request to concat(run and ":request")
    set answer to concat(run and ":answer")
    set parent to concat(run and ":user")
    set submitted to web_submit_owned(database and get_argument(2) and run and "" and "Rendering acceptance fixture — synthetic math and code")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    set session to ptr_to_str(get_list(submitted and 1))
    set request_payload to concat("{\"run_id\":" and provider_quote(run))
    set request_payload to concat(request_payload and concat(",\"parent_event\":" and concat(provider_quote(parent) and "}")))
    if archive_append(database and session and request and "model_request" and request_payload and "fixture") is not equal to 0 or else agent_run_transition(database and run and "ready" and parent and "generating" and request) is not equal to 0:
        return 1
    set content to "Synthetic renderer test. Inline \\(a^2+b^2=c^2\\).\n\n$$\n\\int_0^1 x^2\\,dx=\\frac{1}{3}\n$$\n\n```python\ndef square(x):\n    # Keep literal source when copying\n    return x * x\nprint(square(7))\n```\n\n```json\n{\"value\": 49, \"safe\": true}\n```\n\nLiteral HTML: <img src=x onerror=alert(1)>\n\nUnsupported command: \\(\\notARealCommand{x}\\).\n\n```text\n\\(This stays literal inside code.\\)\n```"
    if get_argument_count() equals 5:
        set content to ptr_to_str(read_file(get_argument(4)))
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"parent_event\":" and provider_quote(request)))
    set payload to concat(payload and concat(",\"content\":" and provider_quote(content)))
    set payload to concat(payload and ",\"reasoning_content\":\"\",\"tool_calls\":[]}")
    if archive_append(database and session and answer and "assistant_final" and payload and "fixture") is not equal to 0 or else agent_run_transition(database and run and "generating" and request and "completed" and answer) is not equal to 0:
        return 1
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display session
    return 0
