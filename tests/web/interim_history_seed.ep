import "../../app/web/run_store"

# An offline display fixture. The streaming/dispatch test covers real tool intake.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "fixture" and "Fixture" and "fixture-secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "fixture" and "fixture-run" and "" and "Please keep task replies visible.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    set parent to "fixture-run:user"
    for each identity in ["one","two"]:
        set request to concat(identity and ":request")
        set payload to concat(agent_event_envelope("fixture-run" and parent) and "}")
        if archive_append(database and session and request and "model_request" and payload and "fixture") is not equal to 0 or else agent_run_transition(database and "fixture-run" and "ready" and parent and "generating" and request) is not equal to 0:
            return 5
        set response to concat(identity and ":response")
        set payload to concat(agent_event_envelope("fixture-run" and request) and concat(",\"content\":" and concat(provider_quote(concat("Saved update " and identity)) and ",\"tool_calls\":[],\"reasoning_content\":\"PRIVATE REASONING\"}")))
        if archive_append(database and session and response and "assistant_tool_calls" and payload and "fixture") is not equal to 0 or else agent_run_transition(database and "fixture-run" and "generating" and request and "tools" and response) is not equal to 0:
            return 6
        set parent to concat(identity and ":observed")
        if archive_append(database and session and parent and "agent_observation" and concat(agent_event_envelope("fixture-run" and response) and "}") and "fixture") is not equal to 0 or else agent_run_transition(database and "fixture-run" and "tools" and response and "ready" and parent) is not equal to 0:
            return 7
    if agent_cancel_run(database and "fixture-run") is not equal to 0:
        return 8
    set transcript to web_session_transcript(database and session)
    if string_contains(transcript and "Saved update one") equals 0 or else string_contains(transcript and "Saved update two") equals 0 or else string_contains(transcript and "PRIVATE REASONING") > 0:
        return 9
    display transcript
    return sql_close(database)
