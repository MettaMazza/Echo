# Append to production client with its main renamed for isolated rendering.
define main:
    set source to Object()
    set source.url to "https://example.org/retained?text=<script>unsafe</script>"
    set source.status to "search-challenge"
    set source.observation to "fixture-result"
    set source.sha256 to "fixture-digest"
    set source.name to "Original fetched page"
    set source.attachment to "fixture-body"
    set source.bytes to "20"
    set source.media_type to "text/html"
    document.body.appendChild(echo_research_panel(Array(source)))
