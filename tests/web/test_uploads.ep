import "../../app/web/uploads"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_upload_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submission to web_submit_owned(database and "owner" and "request" and "" and "Attach a file")
    set session to ptr_to_str(get_list(submission and 1))
    if string_length(web_upload_prepare(database and "foreign" and session and get_argument(2) and "x" and "application/octet-stream")) is not equal to 0:
        return 1
    set identity to web_upload_prepare(database and "owner" and session and get_argument(2) and "../café.bin" and "application/octet-stream")
    if string_length(identity) equals 0 or else web_upload_claim(database and "foreign" and identity) equals 0 or else web_upload_register(database and "owner" and identity) equals 0 or else web_upload_claim(database and "owner" and identity) is not equal to 0 or else web_upload_claim(database and "owner" and identity) equals 0:
        return 1
    set row to web_upload_owned(database and "owner" and identity)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to file_stage_open(library and ptr_to_str(get_list(row and 2)))
    set content to "café"
    if descriptor is less than 0 or else file_stage_write(library and descriptor and str_to_ptr(content) and string_length(content)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0 or else ep_dlclose(library) is not equal to 0:
        return 1
    if web_upload_register(database and "owner" and identity) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if web_upload_register(database and "owner" and identity) is not equal to 0:
        return 1
    set row to web_upload_owned(database and "owner" and identity)
    set other to web_upload_owned(database and "foreign" and identity)
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='attachment';"))
    if not (ptr_to_str(get_list(row and 5)) equals "complete") or else not (ptr_to_str(get_list(other and 0)) equals "end") or else not (ptr_to_str(get_list(count and 1)) equals "1"):
        return 1
    if web_upload_fail(database and "owner" and identity) equals 0:
        return 1
    set failed to web_upload_prepare(database and "owner" and session and get_argument(2) and "interrupted" and "application/octet-stream")
    if web_upload_claim(database and "owner" and failed) is not equal to 0 or else web_upload_fail(database and "foreign" and failed) equals 0 or else web_upload_fail(database and "owner" and failed) is not equal to 0 or else web_upload_claim(database and "owner" and failed) equals 0 or else web_upload_register(database and "owner" and failed) equals 0:
        return 1
    set abandoned to web_upload_prepare(database and "owner" and session and get_argument(2) and "abandoned" and "text/plain")
    set prepared to web_upload_prepare(database and "owner" and session and get_argument(2) and "prepared" and "text/plain")
    if string_length(abandoned) equals 0 or else string_length(prepared) equals 0 or else web_upload_claim(database and "owner" and abandoned) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if web_upload_recover(database) is not equal to 0 or else web_upload_recover(database) is not equal to 0:
        return 1
    set row to web_upload_owned(database and "owner" and abandoned)
    if not (ptr_to_str(get_list(row and 5)) equals "failed") or else web_upload_register(database and "owner" and abandoned) equals 0:
        return 1
    set row to web_upload_owned(database and "owner" and prepared)
    if not (ptr_to_str(get_list(row and 5)) equals "prepared"):
        return 1
    set row to web_upload_owned(database and "owner" and identity)
    if not (ptr_to_str(get_list(row and 5)) equals "complete"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: owner-only upload preparation/claim, generated storage path, duplicate claim rejection and idempotent completion after reopen, abandoned-upload recovery and preserved prepared/completed uploads."
    return 0
