import "../../app/web/worker"
import "../fixtures/runner_provider"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite-a") is not equal to 0 or else web_pairing_invite(database and "invite-b") is not equal to 0 or else web_device_pair(database and "invite-a" and "a" and "A" and "credential-a") is not equal to 0 or else web_device_pair(database and "invite-b" and "b" and "B" and "credential-b") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "a" and "retry-run" and "" and "Remember café.")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted") or else web_worker_claim(database and "retry-run" and "first-worker") is not equal to 0:
        return 1
    if web_worker_retry_claim(database and "a" and "retry-run" and "first-worker" and "too-early") equals 0:
        return 1
    if web_worker_run(get_argument(1) and "retry-run" and "first-worker" and "fixture" and 1 and 20 and 4096) is not equal to 0:
        return 1
    set status to provider_json_tokens(web_worker_status(database and "retry-run"))
    if not (provider_value(status and provider_member(status and 0 and "retry_allowed")) equals "true") or else not (provider_value(status and provider_member(status and 0 and "worker")) equals "first-worker"):
        return 1
    if web_worker_retry_claim(database and "b" and "retry-run" and "first-worker" and "foreign-worker") equals 0:
        return 1
    if web_worker_retry_claim(database and "a" and "retry-run" and "stale-worker" and "bad-worker") equals 0:
        return 1
    if web_worker_retry_claim(database and "a" and "retry-run" and "first-worker" and "second-worker") is not equal to 0 or else web_worker_retry_claim(database and "a" and "retry-run" and "first-worker" and "duplicate-worker") equals 0:
        return 1
    set listener to local_socket_listen(0)
    set completed to channel
    spawn runner_fixture(listener and "retry-run:user" and completed)
    if web_worker_run(get_argument(1) and "retry-run" and "second-worker" and "fixture" and get_list(listener and 2) and 20 and 4096) is not equal to 0:
        return 1
    set failed to receive from completed
    set row to agent_run_read(database and "retry-run")
    if failed is not equal to 0 or else not (ptr_to_str(get_list(row and 2)) equals "completed") or else web_worker_retry_claim(database and "a" and "retry-run" and "second-worker" and "after-completion") equals 0:
        return 1
    set counts to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_events WHERE kind='user'),(SELECT COUNT(*) FROM echo_events WHERE kind='worker_retry');"))
    if not (ptr_to_str(get_list(counts and 1)) equals "1") or else not (ptr_to_str(get_list(counts and 2)) equals "1"):
        return 1
    set cancelled to web_submit_owned(database and "a" and "cancel-retry" and "" and "Cancellation fixture")
    if not (ptr_to_str(get_list(cancelled and 0)) equals "accepted") or else web_worker_claim(database and "cancel-retry" and "cancel-worker") is not equal to 0 or else web_worker_run(get_argument(1) and "cancel-retry" and "cancel-worker" and "fixture" and 1 and 20 and 4096) is not equal to 0 or else web_cancel_request(database and "a" and "cancel-retry") is not equal to 0:
        return 1
    if web_worker_retry_claim(database and "a" and "cancel-retry" and "cancel-worker" and "ignores-cancel") equals 0:
        return 1
    if archive_verify(database and ptr_to_str(get_list(submitted and 1))) is not equal to 0 or else local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: owner-only retry of a returned worker, stale/duplicate/running/completed/cancelled rejection, same-run model/tool completion and no duplicate user message."
    return 0
