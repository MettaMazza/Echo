import "../../app/security/group_speech"
import "../../app/web/export"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if not (group_speech_schema(database) equals "applied"):
        return 2
    for each name in ["owner","other","outsider"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "owner" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "owner" and "invite-other" and "g" and "device:other" and "invited" and 1) equals "recorded") or else not (group_change(database and "other" and "join-other" and "g" and "device:other" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "owner" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 4
    set private_run to web_submit_owned(database and "owner" and "private" and "" and "PRIVATE_RECAP_CANARY_91507")
    set private_session to archive_list_text(private_run and 1)
    set session to "shared"
    if not (group_run_submit(database and "other" and "run" and session and "browser" and "local" and "g" and "Remember café.") equals "accepted"):
        return 5
    set denied to "{\"status\":\"not-found\"}"
    set exported to web_session_export(database and "other" and session)
    if archive_export_verify(exported and "") is not equal to 0 or else string_contains(exported and "café") equals 0 or else string_contains(exported and "PRIVATE_RECAP_CANARY_91507") is not equal to 0 or else string_contains(exported and "other-secret") is not equal to 0:
        return 6
    if not (web_session_export(database and "owner" and session) equals exported) or else not (web_session_export(database and "outsider" and session) equals denied) or else not (web_session_export(database and "other" and private_session) equals denied):
        return 7
    if archive_export_verify(ptr_to_str(string_replace(exported and "café" and "altered")) and "") equals 0:
        return 8
    if not (group_change(database and "owner" and "invite-outsider" and "g" and "device:outsider" and "invited" and 3) equals "recorded") or else not (group_change(database and "outsider" and "join-outsider" and "g" and "device:outsider" and "joined" and 4) equals "recorded"):
        return 9
    if not (web_session_export(database and "outsider" and session) equals denied) or else not (web_session_export(database and "other" and session) equals exported):
        return 10
    if not (group_change(database and "other" and "leave-other" and "g" and "device:other" and "left" and 5) equals "recorded") or else not (web_session_export(database and "other" and session) equals denied):
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if not (web_session_export(database and "owner" and session) equals exported) or else not (web_session_export(database and "other" and session) equals denied) or else not (web_session_export(database and "outsider" and session) equals denied):
        return 13
    if write_file(concat(get_argument(1) and ".export.json") and exported) is not equal to 1:
        return 14
    display "PASS: shared export preserves verified original bytes, excludes private data and credentials, denies outsiders/new members/departed members, preserves eligible historical reads and survives reopen."
    return sql_close(database)
