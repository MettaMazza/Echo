import "../../app/web/attachment_lifecycle"
import "../../app/jobs/delegation_schema"

define lifecycle_query with action as Str and attachment as Str and identity as Str and previous as Str returning List:
    set output to "{"
    for each pair in [["action",action],["attachment",attachment],["identity",identity],["previous",previous]]:
        if string_length(output) > 1:
            set output to concat(output and ",")
        set output to concat(output and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1)))))
    return provider_json_tokens(concat(output and "}"))

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "a" and "first" and "" and "Attachment lifecycle fixture")
    set session to archive_list_text(first and 1)
    if agent_cancel_run(database and "first") is not equal to 0 or else write_file(get_argument(2) and "Original attachment marker: copper-fern-891") is not equal to 1 or else web_attachment_register(database and "a" and session and "source" and get_argument(2) and "notes.txt" and "text/plain") is not equal to 0:
        return 4
    set sent to web_submit_owned_files(database and "a" and "with-file" and session and "Read the notes" and ["source"])
    if not (archive_list_text(sent and 0) equals "accepted"):
        return 5
    set query to lifecycle_query("trash" and "source" and "trash" and "")
    if not (web_attachment_lifecycle(database and "b" and query) equals "not-authorized") or else not (web_attachment_lifecycle(database and "a" and query) equals "recorded") or else not (web_attachment_lifecycle(database and "a" and query) equals "already-recorded"):
        return 6
    if attachment_selectable(database and "source") is not equal to 0 or else string_contains(web_attachment_list(database and "a" and session) and "trashed") equals 0:
        return 7
    set retry to web_submit_owned_files(database and "a" and "with-file" and session and "Read the notes" and ["source"])
    if not (archive_list_text(retry and 0) equals "accepted"):
        return 8
    set denied to web_submit_owned_files(database and "a" and "new-file" and session and "Reuse the notes" and ["source"])
    if not (archive_list_text(denied and 0) equals "invalid-attachments"):
        return 9
    set owned to web_attachment_owned(database and "a" and "source")
    if not (archive_list_text(owned and 0) equals "found") or else not (ptr_to_str(read_file(get_argument(2))) equals "Original attachment marker: copper-fern-891"):
        return 10
    if not (web_attachment_lifecycle(database and "a" and lifecycle_query("restore" and "source" and "stale" and "")) equals "revision-conflict"):
        return 11
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if attachment_selectable(database and "source") is not equal to 0 or else not (web_attachment_lifecycle(database and "a" and lifecycle_query("restore" and "source" and "restore" and "attachment-lifecycle:a:trash")) equals "recorded") or else attachment_selectable(database and "source") is not equal to 1:
        return 12
    if archive_verify(database and session) is not equal to 0:
        return 13
    display "PASS: durable reversible attachment trash, foreign denial, exact retries, new-selection refusal, accepted-turn retry preservation, unchanged historical bytes, stale-restore rejection, reopened restore and archive integrity."
    return sql_close(database)
