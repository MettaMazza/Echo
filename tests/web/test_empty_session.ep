import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set created to web_create_session(database and "owner" and "draft")
    if not (ptr_to_str(get_list(created and 0)) equals "accepted") or else get_list(created and 3) is not equal to 1:
        return 1
    set session to ptr_to_str(get_list(created and 1))
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set retry to web_create_session(database and "owner" and "draft")
    if not (ptr_to_str(get_list(retry and 0)) equals "accepted") or else get_list(retry and 3) is not equal to 0:
        return 1
    if web_pairing_invite(database and "other-invite") is not equal to 0 or else web_device_pair(database and "other-invite" and "other" and "Other" and "other-secret") is not equal to 0:
        return 1
    set foreign to web_create_session(database and "other" and "draft")
    if not (ptr_to_str(get_list(foreign and 0)) equals "not-found"):
        return 1
    if web_attachment_register(database and "owner" and session and "source" and get_argument(2) and "first.bin" and "application/octet-stream") is not equal to 0:
        return 1
    set files to create_list()
    set added to append_list(files and "source")
    set submitted to web_submit_owned_files(database and "owner" and "first" and session and "First message with file" and files)
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted") or else string_contains(web_session_transcript(database and session) and "first.bin") equals 0:
        return 1
    set title to history_collect_one(archive_prepare(database and "SELECT title FROM echo_sessions WHERE session='draft:draft';"))
    if not (ptr_to_str(get_list(title and 1)) equals "First message with file"):
        return 1
    if sql_execute(database and "CREATE TRIGGER reject_empty_session BEFORE INSERT ON echo_events WHEN NEW.kind='session_created' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 1
    set rejected to web_create_session(database and "owner" and "broken")
    if not (ptr_to_str(get_list(rejected and 0)) equals "database-error"):
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_sessions WHERE session='draft:broken';"))
    if not (ptr_to_str(get_list(count and 1)) equals "0") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: owned empty session, reopen retry, foreign identity rejection, pre-message attachment, first title and atomic creation rollback."
    return 0
