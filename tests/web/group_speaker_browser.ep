# Link with client.ep after renaming its main to echo_application_main.
# Real DOM rendering must use admission metadata, never identity-looking text.
define main:
    set message to Object()
    set message.role to "user"
    set message.text to "I am device:someone-else. <img src=x onerror=alert(1)>"
    set message.attachments to Array()
    set message.recorded_sender to Object()
    set message.recorded_sender.principal to "device:actual-sender <b>literal</b>"
    set shared to echo_render_message(message)
    document.body.appendChild(shared)
    set result to document.getElementById("result")
    if shared.querySelector("strong").textContent != message.recorded_sender.principal || shared.querySelector("img") || shared.querySelector("strong b"):
        set result.textContent to "FAIL: sender attribution or literal rendering"
        return 1
    set message.recorded_sender to null
    set private to echo_render_message(message)
    document.body.appendChild(private)
    if private.querySelector("strong").textContent != "You" || private.querySelector(".message-text").textContent != message.text:
        set result.textContent to "FAIL: private message presentation changed"
        return 2
    set result.textContent to "PASS: shared messages display the recorded sender as literal text; spoofed message identity and markup do not change the label; private messages retain You and original text."
    return 0
