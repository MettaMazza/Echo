import "../../app/web/device_links"
import "../../app/web/run_store"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (ptr_to_str(device_link_schema(database)) equals "applied"):
        return 2
    for each device in ["phone", "mac", "stranger"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
        set created to web_create_session(database and device and device)
        if not (archive_list_text(created and 0) equals "accepted"):
            return 4
    if device_link_create(database and "phone" and "merge-code") is not equal to 0:
        return 5
    if string_length(device_link_redeem_merge(database and "merge-code" and "bad" and "Bad" and "bad-secret" and "invalid")) > 0:
        return 6
    if not (device_link_redeem_merge(database and "merge-code" and "linked-mac" and "Mac" and "linked-secret" and "mac-secret") equals "phone"):
        return 7
    for each device in ["phone", "mac"]:
        set listing to web_device_sessions(database and device)
        if string_index_of(listing and "draft:phone") < 0 or else string_index_of(listing and "draft:mac") < 0 or else string_index_of(listing and "draft:stranger") >= 0:
            return 8
        if not (web_account_session_device(database and device and "draft:mac") equals "mac") or else not (web_account_session_device(database and device and "draft:phone") equals "phone"):
            return 9
    if not (web_account_session_device(database and "stranger" and "draft:mac") equals "stranger"):
        return 10
    set owned to web_account_session_device(database and "phone" and "draft:mac")
    set submitted to web_submit_owned(database and owned and "continuation" and "draft:mac" and "Continue the Mac conversation from the phone")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 11
    if not (web_account_resource_device(database and "phone" and "run" and archive_list_text(submitted and 2)) equals "mac"):
        return 12
    set original to history_collect_one(archive_prepare(database and "SELECT principal FROM echo_session_principals WHERE session='draft:mac';"))
    if not (archive_list_text(original and 1) equals "device:mac"):
        return 13
    if device_link_revoke(database and "phone" and "linked-mac") is not equal to 0 or else string_length(web_device_authenticate(database and "linked-secret")) > 0:
        return 14
    if string_index_of(web_device_sessions(database and "phone") and "draft:mac") < 0:
        return 15
    if sql_close(database) is not equal to 0:
        return 16
    set database to archive_open(get_argument(1))
    if string_index_of(web_device_sessions(database and "mac") and "draft:phone") < 0:
        return 17
    display "PASS: atomic authenticated merge, rollback on bad credential, combined libraries, unrelated-user isolation, continuation from either device, original principal preserved, unlink and reopen."
    return sql_close(database)
