import "../../app/tools/attachment_tools"
import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_create_session(database and "owner" and "pdf")
    set session to ptr_to_str(get_list(submitted and 1))
    if web_attachment_register(database and "owner" and session and "pdf" and get_argument(2) and "fixture.pdf" and "application/pdf") is not equal to 0:
        return 1
    set arguments to "{\"attachment\":\"pdf\",\"page\":1,\"offset\":0,\"characters\":6}"
    set result to session_tool_execute(database and session and "attachment_read_text" and arguments)
    set tokens to provider_json_tokens(result)
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "Second") or else not (provider_value(tokens and provider_member(tokens and 0 and "pages")) equals "2") or else not (provider_value(tokens and provider_member(tokens and 0 and "representation")) equals "pdfkit-page-text") or else not (provider_value(tokens and provider_member(tokens and 0 and "event")) equals "pdf:attachment"):
        display result
        return 1
    set result to session_tool_execute(database and session and "attachment_read_text" and "{\"attachment\":\"pdf\",\"page\":2,\"offset\":0,\"characters\":6}")
    if string_contains(result and "page-out-of-range") equals 0:
        return 1
    if not (session_tool_execute(database and "foreign" and "attachment_read_text" and arguments) equals "{\"status\":\"end\"}"):
        return 1
    set window to attachment_unicode_window("café ☕." and 3 and 3)
    if not (ptr_to_str(get_list(window and 1)) equals "é ☕") or else get_list(window and 2) is not equal to 3:
        return 1
    set window to attachment_unicode_window("café ☕." and 9007199254740993 and 3)
    if string_length(ptr_to_str(get_list(window and 1))) is not equal to 0 or else get_list(window and 2) is not equal to 0:
        return 1
    if provider_json_tokens(session_tool_schemas()) equals 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: PDF page ranges and original source receipt, page bounds, foreign exclusion, Unicode slicing and huge offset."
    return 0
