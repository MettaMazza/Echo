import "../../app/web/run_store"

define queue_cancel_fixture with database as Int and run as Str and session as Str and call_id as Str returning Int:
    set event to concat(run and concat(":" and call_id))
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"call_id\":" and provider_quote(call_id)))
    set payload to concat(payload and ",\"name\":\"workspace_write_text\",\"arguments\":\"{}\"}")
    if archive_append(database and session and event and "tool_call" and payload and "fixture") is not equal to 0:
        return 1
    return tool_ledger_queue(database and run and call_id and session and event)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 2
    set submitted to web_submit_owned(database and "owner" and "queued" and "" and "Queued cancellation")
    set session to archive_list_text(submitted and 1)
    if not (archive_list_text(submitted and 0) equals "accepted") or else queue_cancel_fixture(database and "queued" and session and "first") is not equal to 0 or else queue_cancel_fixture(database and "queued" and session and "second") is not equal to 0:
        return 3
    if agent_cancel_run(database and "queued") is not equal to 0 or else agent_cancel_run(database and "queued") is not equal to 0:
        return 4
    set first to tool_ledger_read(database and "queued" and "first")
    set second to tool_ledger_read(database and "queued" and "second")
    if not (archive_list_text(first and 1) equals "observed") or else not (archive_list_text(second and 1) equals "observed"):
        return 5
    set result to archive_read_event(database and archive_list_text(first and 4))
    if string_contains(archive_list_text(result and 3) and "cancelled-before-launch") equals 0 or else string_contains(archive_list_text(result and 3) and "\"effects\":\"none\"") equals 0:
        return 6
    set next_run to web_submit_owned(database and "owner" and "running" and session and "Continue same conversation")
    if not (archive_list_text(next_run and 0) equals "accepted") or else queue_cancel_fixture(database and "running" and session and "active") is not equal to 0 or else tool_ledger_claim(database and "running" and "active") is not equal to 0 or else queue_cancel_fixture(database and "running" and session and "pending") is not equal to 0:
        return 7
    if agent_cancel_run(database and "running") is not equal to 0:
        return 8
    set active to tool_ledger_read(database and "running" and "active")
    set pending to tool_ledger_read(database and "running" and "pending")
    if not (archive_list_text(active and 1) equals "running") or else not (archive_list_text(pending and 1) equals "observed") or else string_length(archive_list_text(active and 4)) is not equal to 0:
        return 9
    set blocked to web_submit_owned(database and "owner" and "unsafe-continuation" and session and "Must wait for real effect reconciliation")
    if not (archive_list_text(blocked and 0) equals "session-active"):
        return 10
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 11
    set database to archive_open(get_argument(1))
    if agent_cancel_run(database and "running") is not equal to 0 or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 12
    display "PASS: cancellation records every unlaunched call without effects, is idempotent across reopen, allows same-session continuation when settled and retains running effects for real reconciliation."
    return 0
