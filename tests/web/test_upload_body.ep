import "../../app/web/upload_body"

define upload_sender with library as Int and descriptor as Int and bytes as Int and completed as Int returning Int:
    set head to "POST /api/upload HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/octet-stream\r\nContent-Length: 8\r\n\r\n"
    set count to bytes
    if bytes equals 9:
        set head to "POST /api/upload HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/octet-stream\r\nTransfer-Encoding: chunked\r\n\r\n8\r\n"
        set count to 8
    set sent to socket_write_all(library and descriptor and -1 and str_to_ptr(head) and string_length(head))
    set packed to create_list()
    set added to append_list(packed and 748550131841696000)
    set result to 1
    if ptr_to_str(get_list(sent and 0)) equals "sent":
        set sent to socket_write_all(library and descriptor and -1 and get_list_data_ptr(packed) and count)
        if ptr_to_str(get_list(sent and 0)) equals "sent":
            set result to 0
            if bytes equals 9:
                set ending to "\r\n0\r\n\r\n"
                set sent to socket_write_all(library and descriptor and -1 and str_to_ptr(ending) and string_length(ending))
                if not (ptr_to_str(get_list(sent and 0)) equals "sent"):
                    set result to 1
    set closed to net_close(descriptor)
    send result + closed to completed
    return 0

define upload_case with path as Str and bytes as Int returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    set completed to channel
    spawn upload_sender(get_list(listener and 0) and client and bytes and completed)
    set reader to http_stream_create(get_list(listener and 0) and accepted and -1)
    set request to http_stream_head(reader)
    set staged to web_upload_stage(reader and request and path and 1)
    set sent to receive from completed
    if sent is not equal to 0:
        return 1
    if bytes equals 8 or else bytes equals 9:
        if not (ptr_to_str(get_list(staged and 0)) equals "verified") or else not (ptr_to_str(get_list(staged and 1)) equals "b3bdf9421b66360aeaf64533a1ab16be8f50e2c68d5a5376589d1abd106b6955") or else get_list(staged and 2) is not equal to 8:
            return 1
    else:
        if ptr_to_str(get_list(staged and 0)) equals "verified" or else get_list(staged and 2) is not equal to bytes:
            return 1
    if http_stream_release(reader) is not equal to 0 or else net_close(accepted) is not equal to 0 or else local_socket_close(listener) is not equal to 0:
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    if upload_case(get_argument(1) and 8) is not equal to 0 or else upload_case(concat(get_argument(1) and ".partial") and 7) is not equal to 0 or else upload_case(concat(get_argument(1) and ".chunked") and 9) is not equal to 0:
        return 1
    display "PASS: live HTTP binary body staged byte-by-byte with exact hash; early EOF kept incomplete and unverified."
    return 0
