import "../../app/context/compaction_resume"
import "../../app/web/work_status"
import "../../app/web/worker"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set own to web_submit_owned(database and "a" and "first" and "" and "Own work")
    set foreign to web_submit_owned(database and "b" and "foreign" and "" and "Foreign work")
    set session to archive_list_text(own and 1)
    set report to web_work_status(database and "a" and session and "runs" and 0)
    set tokens to provider_json_tokens(report)
    if not (provider_value(tokens and provider_member(tokens and 0 and "run")) equals "first") or else string_contains(report and "foreign") is not equal to 0:
        display report
        return 4
    set cursor to string_to_int(provider_value(tokens and provider_member(tokens and 0 and "next_after")))
    if cursor < 1 or else not (web_work_status(database and "a" and session and "runs" and cursor) equals "{\"status\":\"end\"}") or else not (web_work_status(database and "a" and session and "schedules" and 0) equals "{\"status\":\"end\"}"):
        return 5
    if not (web_work_status(database and "b" and session and "runs" and 0) equals "{\"status\":\"not-authorized\"}"):
        return 6
    if web_worker_claim(database and "first" and "worker") is not equal to 0:
        return 9
    set captured to checkpoint_capture(database and session)
    set bound to compaction_job(database and session and "first" and "first:user" and captured)
    set report to web_work_status(database and "a" and session and "runs" and 0)
    if string_contains(report and "pending") equals 0 or else string_contains(report and "running") equals 0 or else string_contains(report and "Preparing the conversation recap") equals 0:
        display report
        return 10
    if agent_cancel_run(database and "first") is not equal to 0 or else string_contains(web_work_status(database and "a" and session and "runs" and 0) and "cancelled") equals 0:
        return 7
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture") equals "recorded") or else not (web_work_status(database and "a" and session and "runs" and 0) equals "{\"status\":\"not-authorized\"}") or else archive_verify(database and session) is not equal to 0:
        return 8
    display "PASS: current work state, exact cursor exhaustion, empty schedules, foreign-device isolation, cancellation refresh, revoked-device denial and archive integrity."
    return sql_close(database)
