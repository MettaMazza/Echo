import "../../app/web/groups"
import "../../app/security/group_output_policy"

define main returning Int:
    if (get_argument_count() is not equal to 2 and get_argument_count() is not equal to 3) or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_output_schema(database) equals "applied"):
        return 2
    for each name in ["a","b","c"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if get_argument_count() equals 3:
        return sql_close(database)
    set created to web_group_manage(database and "a" and "create" and provider_json_tokens("{\"group\":\"controls\"}"))
    if not (created equals "{\"status\":\"created\"}"):
        return 4
    if not (group_change(database and "a" and "invite-b" and "controls" and "device:b" and "invited" and 1) equals "recorded"):
        return 5
    set invited to provider_json_tokens(web_group_list(database and "b"))
    set invitations to provider_items(invited and provider_member(invited and 0 and "groups"))
    if length_list(invitations) is not equal to 1:
        return 6
    set members to provider_items(invited and provider_member(invited and get_list(invitations and 0) and "members"))
    if length_list(members) is not equal to 0 or else not (provider_value(invited and provider_member(invited and 0 and "principal")) equals "device:b"):
        return 7
    if not (group_change(database and "b" and "decline-b" and "controls" and "device:b" and "left" and 2) equals "recorded"):
        return 8
    if not (group_change(database and "a" and "invite-b-again" and "controls" and "device:b" and "invited" and 3) equals "recorded") or else not (group_change(database and "b" and "join-b" and "controls" and "device:b" and "joined" and 4) equals "recorded"):
        return 9
    set joined to provider_json_tokens(web_group_list(database and "b"))
    set groups to provider_items(joined and provider_member(joined and 0 and "groups"))
    set members to provider_items(joined and provider_member(joined and get_list(groups and 0) and "members"))
    if length_list(members) is not equal to 2:
        return 10
    set outsider to provider_json_tokens(web_group_list(database and "c"))
    if length_list(provider_items(outsider and provider_member(outsider and 0 and "groups"))) is not equal to 0:
        return 11
    set opened to provider_json_tokens(web_group_manage(database and "b" and "open" and provider_json_tokens("{\"group\":\"controls\"}")))
    set session to provider_value(opened and provider_member(opened and 0 and "session"))
    if string_length(session) equals 0 or else not (provider_value(opened and provider_member(opened and 0 and "run")) equals ""):
        return 12
    # Even an invitation changes the frozen audience revision. A prepared draft
    # must not be silently routed to that new segment by the browser endpoint.
    if not (group_change(database and "a" and "invite-c" and "controls" and "device:c" and "invited" and 5) equals "recorded"):
        return 13
    set payload to concat("{\"group\":\"controls\",\"session\":" and concat(provider_quote(session) and ",\"submission\":\"stale\",\"message\":\"Old audience draft\"}"))
    if not (archive_list_text(web_group_submit(database and "b" and provider_json_tokens(payload)) and 0) equals "audience-not-authorized") or else agent_run_read(database and "stale") is not equal to 0:
        return 14
    set opened to provider_json_tokens(web_group_manage(database and "b" and "open" and provider_json_tokens("{\"group\":\"controls\"}")))
    set current to provider_value(opened and provider_member(opened and 0 and "session"))
    if current equals session:
        return 15
    set payload to concat("{\"group\":\"controls\",\"session\":" and concat(provider_quote(current) and ",\"submission\":\"current\",\"message\":\"Current audience draft\"}"))
    set accepted to web_group_submit(database and "b" and provider_json_tokens(payload))
    if not (archive_list_text(accepted and 0) equals "accepted") or else not (archive_list_text(accepted and 1) equals current) or else get_list(accepted and 3) is not equal to 1:
        return 16
    set repeated to web_group_submit(database and "b" and provider_json_tokens(payload))
    if not (archive_list_text(repeated and 0) equals "accepted") or else get_list(repeated and 3) is not equal to 0:
        return 17
    set opened to provider_json_tokens(web_group_manage(database and "b" and "open" and provider_json_tokens("{\"group\":\"controls\"}")))
    if not (provider_value(opened and provider_member(opened and 0 and "run")) equals "current"):
        return 18
    display "PASS: member roster, invitation privacy/decline/reinvite, outsider isolation, stale prepared submission rejected, pinned current segment and exact retry, latest run discovery."
    return sql_close(database)
