import "../fixtures/runner_provider"
import "../../app/web/http_api"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set saved to write_file(get_argument(1) and int_to_string(get_list(listener and 2)))
    set state to create_list()
    set added to append_list(state and 0)
    set added to append_list(state and "")
    set added to append_list(state and 0)
    set added to append_list(state and "")
    set added to append_list(state and 2)
    set index to 0
    repeat while index is less than 3:
        if runner_fixture_exchange(listener and state) is not equal to 0:
            return 1
        set index to index + 1
    set descriptor to local_socket_accept(listener)
    set reader to http_stream_create(get_list(listener and 0) and descriptor and -1)
    set head to http_stream_head(reader)
    set parsed to web_read_json(reader and head and 4096)
    if not (ptr_to_str(get_list(parsed and 0)) equals "ready") or else not (ptr_to_str(get_list(parsed and 1)) equals ptr_to_str(get_list(state and 1))):
        return 1
    set data to "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Partial café 🌍 — waiting for Stop.\"}}]}\n\n"
    # EOF framing permits an unfinished response with no arbitrary body cap.
    # The fixture deliberately withholds DONE and natural completion.
    set wire to concat("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\n" and data)
    set written to socket_write_all(get_list(listener and 0) and descriptor and -1 and str_to_ptr(wire) and string_length(wire))
    if not (ptr_to_str(get_list(written and 0)) equals "sent"):
        return 1
    set result to socket_read_chunk(get_list(listener and 0) and descriptor and -1)
    if not (ptr_to_str(get_list(result and 0)) equals "eof"):
        return 1
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    set closed to local_socket_close(listener)
    display "PASS: partial text sent without DONE; cancellation closed the provider connection."
    return 0
