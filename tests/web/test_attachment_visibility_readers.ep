import "../../app/web/attachment_visibility"
import "../../app/jobs/delegation_schema"
import "../../app/tools/attachment_text"
import "../../app/tools/attachment_image"
import "../../app/media/speech_request"

define visibility_query with action as Str and attachment as Str and identity as Str and previous as Str returning List:
    set output to "{"
    for each pair in [["action",action],["attachment",attachment],["identity",identity],["previous",previous]]:
        if string_length(output) > 1:
            set output to concat(output and ",")
        set output to concat(output and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1)))))
    return provider_json_tokens(concat(output and "}"))

define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "a" and "first" and "" and "Attachment lifecycle fixture")
    set session to archive_list_text(first and 1)
    if agent_cancel_run(database and "first") is not equal to 0 or else write_file(get_argument(2) and "Original attachment marker: copper-fern-891") is not equal to 1 or else web_attachment_register(database and "a" and session and "source" and get_argument(2) and "notes.txt" and "text/plain") is not equal to 0:
        return 4
    set read_arguments to "{\"attachment\":\"source\",\"offset\":0,\"characters\":1000}"
    if string_contains(attachment_text_execute(database and session and read_arguments) and "copper-fern-891") equals 0:
        return 14
    set sent to web_submit_owned_files(database and "a" and "with-file" and session and "Read the notes" and ["source"])
    if not (archive_list_text(sent and 0) equals "accepted"):
        return 5
    set query to visibility_query("exclude" and "source" and "exclude" and "")
    if not (web_attachment_visibility(database and "b" and query) equals "not-authorized") or else not (web_attachment_visibility(database and "a" and query) equals "recorded") or else not (web_attachment_visibility(database and "a" and query) equals "already-recorded"):
        return 6
    if attachment_context_included(database and "source") is not equal to 0:
        return 7
    if string_contains(attachment_text_execute(database and session and read_arguments) and "copper-fern-891") equals 0:
        return 15
    if string_contains(attachment_text_execute(database and "foreign" and read_arguments) and "excluded-from-context") is not equal to 0 or else string_contains(attachment_text_execute(database and "foreign" and read_arguments) and "copper-fern-891") is not equal to 0:
        return 16
    if not (web_attachment_visibility(database and "a" and visibility_query("exclude" and "source" and "trash" and "wrong")) equals "revision-conflict"):
        return 8
    if not (web_attachment_visibility(database and "a" and visibility_query("restore" and "source" and "exclude" and "")) equals "identity-conflict"):
        return 9
    set owned to web_attachment_owned(database and "a" and "source")
    if not (archive_list_text(owned and 0) equals "found") or else not (ptr_to_str(read_file(get_argument(2))) equals "Original attachment marker: copper-fern-891"):
        return 10
    if not (web_attachment_visibility(database and "a" and visibility_query("restore" and "source" and "stale" and "")) equals "revision-conflict"):
        return 11
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if attachment_context_included(database and "source") is not equal to 0 or else not (web_attachment_visibility(database and "a" and visibility_query("restore" and "source" and "restore" and "attachment-visibility:a:exclude")) equals "recorded") or else attachment_context_included(database and "source") is not equal to 1:
        return 12
    if string_contains(attachment_text_execute(database and session and read_arguments) and "copper-fern-891") equals 0:
        return 17
    for each item in [["image",get_argument(3),"image/png"],["audio",get_argument(4),"audio/wav"]]:
        set identity to archive_list_text(item and 0)
        if web_attachment_register(database and "a" and session and identity and archive_list_text(item and 1) and identity and archive_list_text(item and 2)) is not equal to 0:
            return 18
        if not (web_attachment_visibility(database and "a" and visibility_query("exclude" and identity and identity and "")) equals "recorded"):
            return 19
    set image to attachment_image_part(database and session and "image")
    set audio_arguments to "{\"attachment\":\"audio\",\"language\":\"en\"}"
    set audio to speech_request_source(database and session and audio_arguments)
    if not (archive_list_text(image and 0) equals "excluded-from-context") or else string_length(archive_list_text(image and 1)) is not equal to 0 or else not (archive_list_text(audio and 0) equals "found"):
        return 20
    if string_contains(attachment_image_execute(database and session and "{\"attachment\":\"image\"}") and "ready") equals 0:
        return 21
    for each identity in ["image","audio"]:
        if not (web_attachment_visibility(database and "a" and visibility_query("restore" and identity and concat(identity and "-restore") and concat("attachment-visibility:a:" and identity))) equals "recorded"):
            return 22
    set image to attachment_image_part(database and session and "image")
    set audio to speech_request_source(database and session and audio_arguments)
    if not (archive_list_text(image and 0) equals "ready") or else string_contains(archive_list_text(image and 1) and "data:image/png;base64,") equals 0 or else not (archive_list_text(audio and 0) equals "found"):
        return 23
    if archive_verify(database and session) is not equal to 0:
        return 24
    display "PASS: forgotten attachments allow explicit text, image-tool and audio-source reads while automatic image parts stay excluded; foreign text reads reveal neither contents nor exclusion; restoration and archive integrity pass."
    return sql_close(database)
