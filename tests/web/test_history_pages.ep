import "../../app/web/branches"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Paging test" and "secret") is not equal to 0:
        return 1
    set session to ""
    set endpoint to ""
    set index to 0
    repeat while index is less than 7:
        set run to concat("run:" and int_to_string(index))
        set submitted to web_submit_owned(database and "owner" and run and session and concat("Message café " and int_to_string(index)))
        if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
            return 1
        set session to ptr_to_str(get_list(submitted and 1))
        set row to agent_run_read(database and run)
        set endpoint to concat(ptr_to_str(get_list(row and 1)) and "")
        if agent_cancel_run(database and run) is not equal to 0:
            return 1
        set index to index + 1
    set branch to web_branch_at(database and "owner" and session and endpoint and "page-branch" and "regenerate" and "")
    if not (ptr_to_str(get_list(branch and 0)) equals "accepted"):
        return 1
    set future to web_submit_owned(database and "owner" and "future" and session and "FUTURE MUST NOT APPEAR")
    if not (ptr_to_str(get_list(future and 0)) equals "accepted") or else agent_cancel_run(database and "future") is not equal to 0:
        return 1
    set cursor to 0
    set expected to 5
    set found to 0
    repeat while 1 equals 1:
        set page to web_session_transcript_window(database and "branch:page-branch" and cursor and 4)
        if string_contains(page and "FUTURE") is not equal to 0:
            return 1
        set tokens to provider_json_tokens(page)
        set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
        if messages equals 0:
            display page
            return 1
        set index to length_list(messages) - 1
        repeat while index >= 0:
            set item to get_list(messages and index)
            set content to provider_value(tokens and provider_member(tokens and item and "text"))
            if not (content equals concat("Message café " and int_to_string(expected))):
                display content
                return 1
            set expected to expected - 1
            set found to found + 1
            set index to index - 1
        if provider_kind(tokens and provider_member(tokens and 0 and "older_possible")) equals "false":
            break
        set next to http_decimal(provider_value(tokens and provider_member(tokens and 0 and "next_before")))
        if next <= 0 or else (cursor > 0 and next >= cursor):
            return 1
        set cursor to next
    if found is not equal to 6 or else expected is not equal to -1:
        return 1
    set all to provider_json_tokens(web_session_transcript(database and session))
    if length_list(provider_items(all and provider_member(all and 0 and "messages"))) is not equal to 8:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set page to web_session_transcript_window(database and "branch:page-branch" and cursor and 4)
    if string_contains(page and "Message café 0") equals 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: progressive transcript pages preserve every Unicode message once, newest batches remain chronological, branch excludes later parent records, whole-history compatibility and reopen cursor work."
    return 0
