# Link after client.ep with its main renamed to echo_application_main.
# Isolated browser fixture: upstream API is mocked; no real key or request.
define main:
    set window.echoToken to "fixture"
    set window.accountRequests to JSON.parse("[]")
    set window.fixtureAccounts to JSON.parse("[{\"identity\":\"one\",\"family\":\"openai-chat\",\"label\":\"First\",\"status\":\"connected\"},{\"identity\":\"two\",\"family\":\"anthropic-messages\",\"label\":\"Second\",\"status\":\"connected\"}]")
    set result to null
    set window.echo_api to given path and payload:
        window.accountRequests.push(JSON.parse(JSON.stringify(payload)))
        if payload.action == "revoke":
            for each account in window.fixtureAccounts:
                if account.identity == payload.identity:
                    set account.status to "revoked"
        set result to Object()
        set result.status to "connected"
        if payload.action == "list":
            set result.accounts to window.fixtureAccounts
        return Promise.resolve(result)
    set dialog to document.createElement("dialog")
    set navigation to document.createElement("nav")
    set content to document.createElement("main")
    dialog.appendChild(navigation)
    dialog.appendChild(content)
    document.body.appendChild(dialog)
    dialog.showModal()
    set load to echo_external_accounts_setup(navigation and content and dialog)
    set output to document.getElementById("result")
    set input to content.querySelector("input[type=text]")
    set revocations to null
    set first to null
    set key to null
    set form to null
    set pending to load().then(given ignored:
        set first to content.querySelector("button[type=button]")
        first.click()
        return Promise.resolve()
    ).then(given ignored:
        return load()
    ).then(given ignored:
        content.querySelector("button[type=button]").click()
        return Promise.resolve()
    ).then(given ignored:
        set revocations to window.accountRequests.filter(given item:
            return item.action == "revoke"
        )
        if get_list(revocations and 0).identity != "one" || get_list(revocations and 1).identity != "two":
            return Promise.reject("Disconnect targeted the wrong account")
        set key to content.querySelector("input[type=password]")
        set key.value to "fake-test-key"
        set input.value to "Fixture"
        set form to content.querySelector("form")
        form.requestSubmit()
        if key.value != "":
            return Promise.reject("Key retained after submission")
        return Promise.resolve()
    ).then(given ignored:
        set key.value to "fake-close-key"
        dialog.addEventListener("close" and given ignored:
            if key.value != "":
                set output.textContent to "FAIL: key retained on closing settings"
            else:
                set output.textContent to "PASS: account-specific disconnects; connect; password cleared after submission and dialog close."
        )
        dialog.close()
    )
    get_list(pending and "catch").call(pending and given error:
        set output.textContent to "FAIL: " + String(error)
    )
