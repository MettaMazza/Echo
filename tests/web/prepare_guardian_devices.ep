import "../../app/web/run_store"
import "fs"

# Host-only acceptance setup. Random credentials are written only to the
# operator-supplied private file, never printed or embedded in the repository.
define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set payload to "{"
    set labels to ["a", "b"]
    set index to 0
    repeat while index < 2:
        set label to archive_list_text(labels and index)
        set device to concat("guardian-verification-" and agent_identity())
        set credential to concat(agent_identity() and agent_identity())
        set invite to concat(agent_identity() and agent_identity())
        if web_pairing_invite(database and invite) is not equal to 0 or else web_device_pair(database and invite and device and "Phase Two guardian verification" and credential) is not equal to 0:
            return 3
        if index > 0:
            set payload to concat(payload and ",")
        set payload to concat(payload and concat(provider_quote(concat("device_" and label)) and concat(":" and provider_quote(device))))
        set payload to concat(payload and concat("," and concat(provider_quote(concat("credential_" and label)) and concat(":" and provider_quote(credential)))))
        set index to index + 1
    set payload to concat(payload and "}")
    if write_file(get_argument(2) and payload) is not equal to 1 or else sql_close(database) is not equal to 0:
        return 4
    display "Two ordinary verification devices prepared; credentials saved privately."
    return 0
