import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submission to web_submit_owned(database and "owner" and "request" and "" and "Read my attachment.")
    if not (ptr_to_str(get_list(submission and 0)) equals "accepted"):
        return 1
    set session to ptr_to_str(get_list(submission and 1))
    if web_attachment_register(database and "foreign" and session and "stolen" and get_argument(2) and "x" and "application/octet-stream") equals 0:
        return 1
    if web_attachment_register(database and "owner" and session and "file" and get_argument(2) and "../../café.bin" and "application/octet-stream") is not equal to 0:
        return 1
    if web_attachment_register(database and "owner" and session and "duplicate-path" and get_argument(2) and "duplicate" and "application/octet-stream") equals 0:
        return 1
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='attachment';"))
    if not (ptr_to_str(get_list(counts and 1)) equals "1"):
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set listed to provider_json_tokens(web_attachment_list(database and "owner" and session))
    if length_list(provider_items(listed and provider_member(listed and 0 and "attachments"))) is not equal to 1 or else not (web_attachment_list(database and "foreign" and session) equals "{\"status\":\"not-found\"}"):
        return 1
    set own to web_attachment_owned(database and "owner" and "file")
    set other to web_attachment_owned(database and "foreign" and "file")
    if not (ptr_to_str(get_list(own and 0)) equals "found") or else not (ptr_to_str(get_list(own and 2)) equals "../../café.bin") or else not (ptr_to_str(get_list(own and 4)) equals "b3bdf9421b66360aeaf64533a1ab16be8f50e2c68d5a5376589d1abd106b6955") or else not (ptr_to_str(get_list(other and 0)) equals "end"):
        return 1
    if web_device_revoke(database and "owner") is not equal to 0:
        return 1
    set revoked to web_attachment_owned(database and "owner" and "file")
    if not (ptr_to_str(get_list(revoked and 0)) equals "end") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: staged binary registered with verified hash, owner-only lookup, inert filename metadata, duplicate rollback and revoked-device rejection."
    return 0
