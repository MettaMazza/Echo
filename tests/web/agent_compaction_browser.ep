define main:
    set window.echoSession to "test-session"
    set window.echoAgentPanels to Reflect.construct(Map and Array())
    set transcript to document.createElement("div")
    set transcript.id to "transcript"
    document.body.appendChild(transcript)
    set holder to document.createElement("div")
    set holder.id to "delegated-agents"
    document.body.appendChild(holder)
    set window.fetch to given path and options:
        set result to Object()
        set result.ok to true
        set result.status to 200
        set result.json to given ignored:
            set payload to Object()
            set item to Object()
            set item.run to "child"
            set item.parent_run to "parent"
            set item.session to "child-session"
            set item.state to "ready"
            set item.activity to "Checking the recap against original records"
            set item.worker_status to "running"
            set item.compaction to Object()
            set item.compaction.state to "pending"
            set payload.entries to Array(item)
            return Promise.resolve(payload)
        return Promise.resolve(result)
    echo_agents_refresh()
    set verify to given ignored:
        set panel to get_list(window.echoAgentPanels and "get").call(window.echoAgentPanels and "child")
        set result to document.createElement("pre")
        set result.id to "fixture-result"
        set result.textContent to "FAIL"
        if panel && panel.echoHeading.textContent == "Agent · Compacting context" && panel.echoStatus.textContent.includes("Checking the recap"):
            set result.textContent to "PASS: running compaction is visible instead of stale Ready."
        document.body.appendChild(result)
    window.setTimeout(verify and 100)
