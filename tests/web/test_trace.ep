import "../../app/web/trace"

define progress_piece with database as Int and request as Str and sequence as Int and data as Str returning Int:
    set payload to concat("{\"request_event\":" and provider_quote(request))
    set payload to concat(payload and concat(",\"data\":" and concat(provider_quote(data) and "}")))
    return provider_archive_piece(database and "session:r" and request and sequence and "provider_event" and payload)

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    set submitted to web_submit(database and "r" and "" and "Trace fixture")
    if archive_append(database and "session:r" and "generation" and "model_request" and "{\"run_id\":\"r\",\"parent_event\":\"r:user\"}" and "fixture") is not equal to 0:
        return 1
    if progress_piece(database and "generation" and 0 and "{\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"Inspect the source café.\"}}]}") is not equal to 0:
        return 1
    if progress_piece(database and "unrelated" and 0 and "{\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"OTHER_RUN_SECRET\"}}]}") is not equal to 0:
        return 1
    if archive_append(database and "session:r" and "call" and "tool_call" and "{\"run_id\":\"r\",\"name\":\"history_read\",\"arguments\":\"{}\"}" and "fixture") is not equal to 0:
        return 1
    if archive_append(database and "session:r" and "r:vision-profile" and "run_vision_profile" and "{\"model\":\"/private/TRACE_PATH_CANARY/models/Thinking.gguf\"}" and "fixture") is not equal to 0:
        return 1
    set first to web_run_trace(database and "r" and 0 and 1)
    if string_index_of(first and "Requesting the next model response") < 0 or else string_index_of(first and "Inspect the source") >= 0:
        return 1
    set tokens to provider_json_tokens(first)
    set cursor to http_decimal(provider_index(tokens and provider_member(tokens and 0 and "after")))
    set rest to web_run_trace(database and "r" and cursor and 100)
    if string_index_of(rest and "Inspect the source café.") < 0 or else string_index_of(rest and "history_read") < 0 or else string_index_of(rest and "OTHER_RUN_SECRET") >= 0:
        return 1
    if string_index_of(rest and "Media context routed to the local multimodal provider: Thinking.gguf") < 0 or else string_index_of(rest and "TRACE_PATH_CANARY") >= 0 or else string_index_of(rest and "Image context") >= 0:
        return 1
    if not (web_trace_model_label("Thinking.gguf") equals "Thinking.gguf") or else not (web_trace_model_label("") equals "local model"):
        return 1
    if archive_append(database and "session:r" and "recap:r:binding" and "compaction_binding" and "{\"run_id\":\"r\",\"job\":\"recap:r\"}" and "fixture") is not equal to 0:
        return 20
    if archive_append(database and "session:r" and "recap:r:candidate:0" and "recap_candidate" and "{\"draft\":\"RECAP_DRAFT_CANARY\"}" and "fixture") is not equal to 0:
        return 21
    if archive_append(database and "session:r" and "recap:other:binding" and "compaction_binding" and "{\"run_id\":\"other\",\"job\":\"recap:other\"}" and "fixture") is not equal to 0:
        return 22
    if archive_append(database and "session:r" and "recap:other:notes:0" and "recap_fragment_notes" and "{\"notes\":\"OTHER_RECAP_CANARY\"}" and "fixture") is not equal to 0:
        return 23
    set compacted to web_run_trace(database and "r" and 0 and 100)
    if string_contains(compacted and "Original messages and source records remain saved") equals 0 or else string_contains(compacted and "Recap draft recorded; review is still required") equals 0:
        return 24
    if string_contains(compacted and "RECAP_DRAFT_CANARY") > 0 or else string_contains(compacted and "OTHER_RECAP_CANARY") > 0 or else string_contains(compacted and "recap:other") > 0:
        return 25
    set rest to compacted
    set tokens to provider_json_tokens(rest)
    set cursor to http_decimal(provider_index(tokens and provider_member(tokens and 0 and "after")))
    set tail to web_run_trace(database and "r" and cursor and 100)
    if string_index_of(tail and "\"entries\":[]") < 0:
        return 1
    if string_index_of(web_run_trace(database and "r" and -1 and 100) and "invalid-cursor") < 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: trace pagination, original Unicode model reasoning and tool request, unrelated generation exclusion, no duplicate entries and invalid cursor rejection."
    return 0
