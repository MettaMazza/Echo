define consent_browser_tick:
    set ready to given resolve:
        window.setTimeout(resolve and 0)
    return Reflect.construct(Promise and [ready])

define main:
    set output to document.getElementById("result")
    set window.consentCalls to JSON.parse("[]")
    set window.consentOpened to null
    set window.consentGrants to 0
    set window.echoBusy to false
    set window.echoUploading to false
    set window.echo_open_session to given session:
        set window.consentOpened to session
    set window.echo_api to given path and payload:
        window.consentCalls.push(JSON.parse(JSON.stringify(payload)))
        if path == "/api/session-create":
            return Promise.resolve(JSON.parse("{\"status\":\"accepted\",\"session\":\"draft:fixture\"}"))
        if path != "/api/external-session" || payload.profile != "profile-fixture":
            return Promise.reject("Unexpected request")
        if payload.action == "preview":
            return Promise.resolve(JSON.parse("{\"status\":\"preview\",\"disclosure\":\"Fixture disclosure: sends this conversation externally.\",\"disclosure_digest\":\"exact-digest\"}"))
        if payload.action != "grant" || payload.disclosure_digest != "exact-digest" || payload.session != "draft:fixture":
            return Promise.reject("Consent lost its exact disclosure/session binding")
        set window.consentGrants to window.consentGrants + 1
        if window.consentGrants == 1:
            return Promise.reject("Fixture uncertain response")
        return Promise.resolve(JSON.parse("{\"status\":\"already-granted\"}"))
    set panel to echo_external_start("profile-fixture")
    document.body.appendChild(panel)
    set review to panel.querySelector("button")
    set start to panel.querySelectorAll("button").item(1)
    set agree to panel.querySelector("input")
    if window.consentCalls.length != 0 || not start.disabled:
        set output.textContent to "FAIL: consent requested before interaction"
        return 0
    review.click()
    set pending to consent_browser_tick().then(given ignored:
        if window.consentCalls.length != 1 || panel.textContent.indexOf("Fixture disclosure") < 0 || not start.disabled:
            return Promise.reject("Preview sent data or failed to display disclosure")
        agree.click()
        start.click()
        return consent_browser_tick()
    ).then(given ignored:
        if window.consentOpened || start.disabled || window.consentGrants != 1:
            return Promise.reject("Uncertain grant opened session or prevented retry")
        start.click()
        return consent_browser_tick()
    ).then(given ignored:
        if not window.consentOpened || window.consentOpened.external_mode != "external" || window.consentOpened.session != "draft:fixture" || get_list(window.consentCalls and 1).identity != get_list(window.consentCalls and 3).identity:
            return Promise.reject("Retry changed session identity or lost external mode")
        set output.textContent to "PASS: explicit preview and checkbox consent, exact disclosure binding, idempotent creation/grant retry and external-session opening."
    )
    get_list(pending and "catch").call(pending and given error:
        set output.textContent to "FAIL: " + String(error)
    )
