import "../../app/web/routes"
import "../../app/jobs/delegation_schema"

# Fixture count is an argument, not an application or retention limit.
define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set count to string_to_int(get_argument(2))
    if count < 1:
        return 2
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 3
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "a" and "a-secret") is not equal to 0:
        return 4
    set session to ""
    set index to 0
    repeat while index < count:
        set identity to concat("history:" and int_to_string(index))
        set message to concat("History row " and concat(int_to_string(index) and " — café, 日本語, retained original."))
        set submitted to web_submit_owned(database and "a" and identity and session and message)
        if not (archive_list_text(submitted and 0) equals "accepted") or else agent_cancel_run(database and identity) is not equal to 0:
            return 5
        set session to archive_list_text(submitted and 1)
        set index to index + 1
    if archive_verify(database and session) is not equal to 0:
        return 6
    display "PASS: requested fixture count archived and cancelled; no inference launched."
    return sql_close(database)
