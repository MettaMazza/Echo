import "../../app/web/run_store"
import "../../app/security/revocation"

define main returning Int:
    if get_argument_count() is less than 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if get_argument_count() equals 3 and get_argument(2) equals "--principals":
        if not (principal_revocation_schema(database) equals "applied"):
            return 2
    if web_pairing_invite(database and "fixture-invitation-a") is not equal to 0 or else web_pairing_invite(database and "fixture-invitation-b") is not equal to 0:
        return 1
    if web_device_pair(database and "fixture-invitation-a" and "a" and "Phone" and "fixture-secret-a") is not equal to 0:
        return 1
    if web_device_pair(database and "fixture-invitation-a" and "intruder" and "Other" and "fixture-secret-other") equals 0:
        display "FAIL: consumed invitation accepted."
        return 1
    if web_device_pair(database and "fixture-invitation-b" and "b" and "Tablet" and "fixture-secret-b") is not equal to 0:
        return 1
    if not (web_device_authenticate(database and "fixture-secret-a") equals "a") or else not (web_device_authenticate(database and "wrong") equals ""):
        return 1
    set submitted to web_submit_owned(database and "a" and "a-run" and "" and "Private phone conversation")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 1
    set stolen to web_submit_owned(database and "b" and "a-run" and "" and "Private phone conversation")
    if not (ptr_to_str(get_list(stolen and 0)) equals "not-found"):
        display "FAIL: cross-device retry accepted."
        return 1
    set stolen to web_submit_owned(database and "b" and "new-run" and "session:a-run" and "Intrude")
    if not (ptr_to_str(get_list(stolen and 0)) equals "not-found"):
        return 1
    set retry to web_submit_owned(database and "a" and "a-run" and "" and "Private phone conversation")
    if not (ptr_to_str(get_list(retry and 0)) equals "accepted") or else get_list(retry and 3) is not equal to 0:
        return 1
    set separate to web_submit_owned(database and "b" and "b-run" and "" and "Independent tablet conversation")
    if not (ptr_to_str(get_list(separate and 0)) equals "accepted"):
        return 1
    set listing to provider_json_tokens(web_device_sessions(database and "a"))
    if archive_append(database and "session:a-run" and "search-body" and "assistant_final" and "{\"content\":\"A unique café answer\"}" and "fixture") is not equal to 0:
        return 1
    set searched to provider_json_tokens(web_device_sessions_search(database and "a" and "unique café"))
    if length_list(provider_items(searched and provider_member(searched and 0 and "sessions"))) is not equal to 1:
        return 1
    set searched to provider_json_tokens(web_device_sessions_search(database and "b" and "unique café"))
    if length_list(provider_items(searched and provider_member(searched and 0 and "sessions"))) is not equal to 0:
        return 1
    set searched to provider_json_tokens(web_device_sessions_search(database and "a" and "tablet"))
    if length_list(provider_items(searched and provider_member(searched and 0 and "sessions"))) is not equal to 0:
        return 1
    set searched to provider_json_tokens(web_device_sessions_search(database and "a" and "phone"))
    if length_list(provider_items(searched and provider_member(searched and 0 and "sessions"))) is not equal to 1:
        return 1
    set searched to provider_json_tokens(web_device_sessions_search(database and "a" and "%"))
    if length_list(provider_items(searched and provider_member(searched and 0 and "sessions"))) is not equal to 0:
        return 1
    set entries to provider_items(listing and provider_member(listing and 0 and "sessions"))
    if length_list(entries) is not equal to 1:
        display "FAIL: device list includes another device's session."
        return 1
    if not (provider_value(listing and provider_member(listing and get_list(entries and 0) and "session")) equals "session:a-run"):
        return 1
    if not (provider_value(listing and provider_member(listing and get_list(entries and 0) and "run")) equals "a-run"):
        return 1
    if sql_execute(database and "CREATE TRIGGER reject_owned_run BEFORE INSERT ON echo_runs WHEN NEW.run='broken-owned' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 1
    set broken to web_submit_owned(database and "a" and "broken-owned" and "" and "Must roll back together")
    if not (ptr_to_str(get_list(broken and 0)) equals "database-error"):
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_sessions WHERE session='session:broken-owned')+(SELECT COUNT(*) FROM echo_session_owners WHERE session='session:broken-owned')+(SELECT COUNT(*) FROM echo_events WHERE event='broken-owned:user');"))
    if not (ptr_to_str(get_list(count and 0)) equals "found") or else not (ptr_to_str(get_list(count and 1)) equals "0"):
        display "FAIL: ownership or message survived failed submission."
        return 1
    if web_device_session_allowed(database and "a" and "session:a-run") is not equal to 1 or else web_device_run_allowed(database and "a" and "a-run") is not equal to 1:
        return 1
    if web_device_session_allowed(database and "b" and "session:a-run") is not equal to 0 or else web_device_run_allowed(database and "b" and "a-run") is not equal to 0 or else web_device_session_allowed(database and "" and "session:a-run") is not equal to 0:
        display "FAIL: cross-device access accepted."
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (web_device_authenticate(database and "fixture-secret-a") equals "a") or else web_device_session_allowed(database and "a" and "session:a-run") is not equal to 1:
        return 1
    if web_device_revoke(database and "a") is not equal to 0 or else not (web_device_authenticate(database and "fixture-secret-a") equals "") or else web_device_run_allowed(database and "a" and "a-run") is not equal to 0:
        return 1
    if not (web_device_authenticate(database and "fixture-secret-b") equals "b"):
        return 1
    set listing to provider_json_tokens(web_device_sessions(database and "a"))
    if length_list(provider_items(listing and provider_member(listing and 0 and "sessions"))) is not equal to 0:
        display "FAIL: revoked device can list sessions."
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: one-use pairing, hashed authentication, durable device ownership, cross-device denial and revocation. HTTP enforcement remains a separate integration gate."
    return 0
