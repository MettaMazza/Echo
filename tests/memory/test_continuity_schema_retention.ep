import "../../app/agent/run_messages"
import "../../app/tools/continuity_tools"
external define ep_gc_get_minor_count returning Int

define main returning Int:
    set expected to continuity_shared_schemas()
    if string_contains(expected and "scratchpad") is not equal to 0 or else string_contains(expected and "private") is not equal to 0 or else string_contains(expected and "reasoning_read") equals 0:
        return 1
    set before to ep_gc_get_minor_count()
    set index to 0
    repeat while index < 1000:
        set actual to continuity_shared_schemas()
        if not (actual equals expected):
            return 2
        set parsed to provider_json_tokens(actual)
        if parsed equals 0 or else provider_unique_objects(parsed) equals 0 or else length_list(provider_items(parsed and 0)) is not equal to 3:
            return 3
        set index to index + 1
    if ep_gc_get_minor_count() equals before:
        return 4
    display "PASS: 1000 exact shared-schema projections across real garbage collections; three retained history/reasoning tools, no private scratchpad schema."
    return 0
