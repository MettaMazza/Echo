import "../../app/security/channel_silo"
import "../../app/web/run_store"
import "../../app/memory/context_snapshot"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)) or else not (ptr_to_str(get_env("ECHO_EMBEDDING_PROFILE")) equals get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to channel_silo_submit(database and "a" and "discord" and "server" and "general" and "one" and "Consent original" and create_list())
    set other to channel_silo_submit(database and "b" and "discord" and "server" and "general" and "other" and "Other user" and create_list())
    set target to channel_silo_submit(database and "a" and "discord" and "server" and "cog" and "two" and "Find my consent" and create_list())
    set guild to channel_silo_submit(database and "a" and "discord" and "foreign" and "general" and "guild" and "Other guild" and create_list())
    set dm to channel_silo_submit(database and "a" and "discord" and "dm:bot" and "dm" and "dm" and "Private DM" and create_list())
    set browser to channel_silo_submit(database and "a" and "browser" and "server" and "general" and "browser" and "Private browser" and create_list())
    for each row in [first,target,other,guild,dm,browser]:
        if not (archive_list_text(row and 0) equals "accepted"):
            return 4
    set current to archive_list_text(target and 1)
    set source to archive_list_text(first and 1)
    set query to concat("SELECT 1 WHERE " and concat(memory_retrieval_session_sql(database and "?1" and "?2") and ";"))
    if not (archive_list_text(history_collect_one(checkpoint_prepare(database and query and [current,source])) and 0) equals "found"):
        return 5
    for each row in [guild,dm,browser]:
        if not (archive_list_text(history_collect_one(checkpoint_prepare(database and query and [current,archive_list_text(row and 1)])) and 0) equals "end"):
            return 6
    # Candidate identity is insufficient without the bound connector and live checks.
    if memory_retrieval_session_allowed(database and "two" and source) is not equal to 0:
        return 7
    set old to concat("SELECT 1 WHERE " and concat(group_memory_session_sql(database and "?1" and "?2") and ";"))
    if not (archive_list_text(history_collect_one(checkpoint_prepare(database and old and [current,source])) and 0) equals "end"):
        return 8
    set source_run to agent_run_read(database and "one")
    set original to archive_read_event(database and archive_list_text(source_run and 1))
    set claim to knowledge_record(database and "one" and "semantic" and "device:a" and "preference" and "learned-previous-channel" and "source-account" and archive_list_text(source_run and 1) and archive_list_text(original and 6) and "" and "" and "")
    if not string_contains(claim and "recorded:"):
        return 9
    if discord_memory_prepare(database and "two") is not equal to 0 or else string_contains(group_memory_records(database and "two") and "Consent original"):
        return 10
    # Isolated fixture represents a successful bound-host live permission check.
    if archive_finish(checkpoint_prepare(database and "INSERT INTO temp.echo_discord_memory_access VALUES(?1,?2);" and [current,source]) and 101) is not equal to 0:
        return 11
    set community_run to agent_run_read(database and "other")
    set community_source to archive_read_event(database and archive_list_text(community_run and 1))
    set community_claim to knowledge_record(database and "other" and "semantic" and "device:b" and "preference" and "community-author-b-marker" and "source-account" and archive_list_text(community_run and 1) and archive_list_text(community_source and 6) and "" and "" and "")
    if not string_contains(community_claim and "recorded:"):
        return 30
    if archive_finish(checkpoint_prepare(database and "INSERT INTO temp.echo_discord_memory_access VALUES(?1,?2);" and [current,archive_list_text(other and 1)]) and 101) is not equal to 0:
        return 31
    set attributed to memory_recall_claims(database and "two")
    if not string_contains(attributed and "community-author-b-marker") or else not string_contains(attributed and "device:b") or else not string_contains(attributed and "source_channel"):
        display attributed
        return 32
    set revision to memory_context_revision(database and "two")
    set records to group_memory_records(database and "two")
    if string_contains(records and "Consent original") or else not string_contains(records and "learned-previous-channel"):
        display records
        return 12
    set selected to memory_semantic_select(database and "two" and memory_recall_claims(database and "two"))
    set context to memory_context(database and "two")
    if not string_contains(selected and "learned-previous-channel") or else not string_contains(context and "learned-previous-channel") or else string_contains(context and "Consent original"):
        return 17
    # Isolated vector fixtures exercise the production selector and rendering.
    set relevant to knowledge_record(database and "one" and "episodic" and "device:a" and "milestone" and "selected passage. excluded remainder." and "source-account" and archive_list_text(source_run and 1) and archive_list_text(original and 6) and "" and "" and "")
    set unrelated to knowledge_record(database and "one" and "episodic" and "device:a" and "milestone" and "unrelated quotation" and "source-account" and archive_list_text(source_run and 1) and archive_list_text(original and 6) and "" and "" and "")
    if not string_contains(relevant and "recorded:") or else not string_contains(unrelated and "recorded:") or else memory_semantic_schema(database) is not equal to 0:
        return 18
    if write_file(get_argument(2) and "{\"port\":0,\"model_sha256\":\"fixture-model\",\"query_prefix\":\"\",\"relevance_standard_deviations\":2}") is not equal to 1:
        return 19
    if sql_execute(database and "INSERT INTO echo_recall_vectors VALUES('fixture-model','selected','selected passage.','[1,0]'),('fixture-model','unrelated','unrelated quotation','[0,1]'); INSERT INTO echo_recall_passages VALUES('selected passage. excluded remainder.','selected passage.','selected'),('unrelated quotation','unrelated quotation','unrelated');") is not equal to 0:
        return 20
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_recall_vectors VALUES('fixture-model',?1,'Find my consent','[1,0]');" and [ep_sha256("Find my consent")]) and 101) is not equal to 0:
        return 21
    set normalised to memory_recall_claims(database and "two")
    set identities to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM json_each(?1) WHERE json_extract(value,'$.id') IS NULL OR json_extract(value,'$.identity')<>json_extract(value,'$.id');" and [normalised]))
    if not (archive_list_text(identities and 1) equals "0"):
        return 23
    set context to memory_context(database and "two")
    if not string_contains(context and "selected passage.") or else not string_contains(context and "learned-previous-channel") or else string_contains(context and "excluded remainder") or else string_contains(context and "unrelated quotation") or else string_contains(context and "Consent original"):
        display context
        return 22
    if string_contains(records and "Other user") or else string_contains(records and "Private DM") or else string_contains(records and "Other guild"):
        return 13
    if sql_execute(database and "DELETE FROM temp.echo_discord_memory_access;") is not equal to 0 or else memory_context_revision(database and "two") equals revision:
        return 14
    if string_contains(group_memory_records(database and "two") and "learned-previous-channel") or else string_contains(group_memory_records(database and "two") and "Consent original"):
        return 15
    if string_contains(memory_context(database and "two") and "learned-previous-channel") or else string_contains(memory_context(database and "two") and "selected passage."):
        return 24
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if string_contains(group_memory_records(database and "two") and "Consent original"):
        return 16
    display "PASS: authorised cross-channel standing claims selected; unindexed originals excluded; no model tool required; revocation changes snapshot revision and removes claims; grants do not survive restart; cross-user public claims attributed; foreign guilds/DMs/browser excluded."
    return sql_close(database)
