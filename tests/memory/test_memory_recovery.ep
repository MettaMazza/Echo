import "../../app/archive/snapshot"
import "../../app/memory/episodes"
import "../../app/projects/context"
import "../../app/agent/tool_dispatch"
import "../../app/jobs/delegation_schema"
import "../../app/agent/runner"
import "../fixtures/generation_fixture"

define procedure_fixture_step with database as Int and run as Str and step as Int and name as Str and arguments as Str returning Int:
    set identity to concat("step-" and int_to_string(step))
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and run and concat(run and concat(":" and identity)) and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    repeat while archive_list_text(agent_run_read(database and run) and 2) equals "tools":
        if agent_tool_step(database and run) is not equal to 0:
            return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "The source verification marker is orchard-procedure-527.")
    if procedure_fixture_step(database and "first" and 0 and "tool_search" and "{\"query\":\"memory_read\",\"after\":0,\"catalog_digest\":\"\"}") is not equal to 0 or else procedure_fixture_step(database and "first" and 1 and "memory_read" and "{\"event\":\"first:user\",\"offset\":0,\"characters\":1000}") is not equal to 0:
        return 4
    set discovery to history_collect_one(archive_prepare(database and "SELECT e.event,e.digest,json_extract(e.payload,'$.result.contract_sha256') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='first' AND t.call_id='step-0';"))
    set observation to history_collect_one(archive_prepare(database and "SELECT e.event,e.digest FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='first' AND t.call_id='step-1';"))
    set manifest to concat("{\"name\":\"Inspect source\",\"purpose\":\"Recover the original verification marker\",\"prerequisites\":\"Access to first:user\",\"failure_lessons\":\"If the original is unavailable report that; do not guess\",\"steps\":[{\"action\":\"Use memory_read with event first:user, offset 0 and characters 1000; return its verification marker.\",\"tool\":\"memory_read\",\"contract_sha256\":" and provider_quote(archive_list_text(discovery and 3)))
    for each pair in [["result_event",archive_list_text(observation and 1)],["result_digest",archive_list_text(observation and 2)],["discovery_event",archive_list_text(discovery and 1)],["discovery_digest",archive_list_text(discovery and 2)]]:
        set manifest to concat(manifest and ",")
        set manifest to concat(manifest and provider_quote(archive_list_text(pair and 0)))
        set manifest to concat(manifest and ":")
        set manifest to concat(manifest and provider_quote(archive_list_text(pair and 1)))
    set manifest to concat(manifest and ",\"checks\":[{\"path\":\"$.result.status\",\"equals\":\"found\"}]}]}")
    if procedure_fixture_step(database and "first" and 2 and "procedure" and concat("{\"operation\":\"save\",\"manifest\":" and concat(manifest and "}"))) is not equal to 0:
        return 5
    set saved to procedure_read(database and "first" and "procedure:first:step-2" and session_tool_schemas_owned(database and "first"))
    if string_contains(saved and "\"assessment\":\"demonstrated\"") equals 0:
        display saved
        return 6
    set milestone to web_submit_owned(database and "owner" and "milestone" and "" and "On 2026-03-12 we completed the amber-garden-468 milestone together.")
    set source to archive_read_event(database and "milestone:user")
    set episode to knowledge_record(database and "milestone" and "episodic" and "user" and "milestone" and "Completed amber-garden-468 together" and "source-account" and "milestone:user" and archive_list_text(source and 6) and "2026-03-12" and "" and "")
    set old to web_submit_owned(database and "owner" and "old-name" and "" and "The laboratory is named south-lab-824.")
    set source to archive_read_event(database and "old-name:user")
    set old_claim to knowledge_record(database and "old-name" and "semantic" and "laboratory" and "name" and "south-lab-824" and "source-account" and "old-name:user" and archive_list_text(source and 6) and "2026-01-01" and "" and "")
    set changed to web_submit_owned(database and "owner" and "new-name" and "" and "Correction: the laboratory is now named north-lab-641.")
    set source to archive_read_event(database and "new-name:user")
    set corrected to knowledge_record(database and "new-name" and "semantic" and "laboratory" and "name" and "north-lab-641" and "source-account" and "new-name:user" and archive_list_text(source and 6) and "2026-04-01" and "" and substring(old_claim and 9 and string_length(old_claim) - 9))
    if string_contains(episode and "recorded:") is not equal to 1 or else string_contains(corrected and "recorded:") is not equal to 1:
        return 7
    set project_manifest to "{\"name\":\"Recovery project\",\"instructions\":\"Report project marker archive-restore-project-318 when resuming.\",\"tasks\":[{\"id\":\"check\",\"title\":\"Read the original evidence\",\"status\":\"todo\"}],\"files\":[]}"
    if not (project_revision_save(database and "first" and "recovery-project" and "recovery-project-r1" and "" and project_manifest) equals "recorded") or else not (project_select(database and "first" and "recovery-project" and "recovery-project-selection") equals "selected"):
        return 8
    set before_project to project_context(database and "first")
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set compacted to context_compact(database and "first" and get_argument(4) and string_to_int(get_argument(5)) and 2048 and -1 and 65536 and library)
    set unloaded to ep_dlclose(library)
    display concat("Compaction: " and compacted)
    if not (compacted equals "activated") or else checkpoint_read_active(database and archive_list_text(first and 1)) equals 0 or else not (project_context(database and "first") equals before_project):
        return 9
    if archive_snapshot(database and get_argument(2)) is not equal to 0:
        return 10
    # This source-only change must not leak into the independently restored copy.
    if not (procedure_visibility_set(database and "first" and "source-only-forget" and "procedure:first:step-2" and 0 and "forgotten" and "Verify independent snapshot") equals "recorded"):
        return 11
    set closed to sql_close(database)
    if archive_restore(get_argument(2) and get_argument(3)) is not equal to 0:
        return 12
    set restored to archive_open(get_argument(3))
    if restored equals 0 or else archive_verify_all(restored) is not equal to 0 or else checkpoint_read_active(restored and archive_list_text(first and 1)) equals 0 or else not (project_context(restored and "first") equals before_project):
        return 13
    set resumed to web_submit_owned(restored and "owner" and "recovered" and "" and "We have restored a backup. Use memory_timeline to recover our dated shared milestone, memory_graph to follow the laboratory name correction, project tools to select Recovery project and read its instructions, and procedure tools to find Inspect source and execute its reading step again. Return the milestone name/date, current laboratory name, project marker and the source verification marker. Use actual saved records.")
    set timeline to episode_page(restored and "recovered" and "" and 100 and "milestone")
    if string_contains(timeline and "amber-garden-468") equals 0 or else string_contains(timeline and "2026-03-12") equals 0 or else string_contains(procedure_read(restored and "recovered" and "procedure:first:step-2" and session_tool_schemas_owned(restored and "recovered")) and "\"assessment\":\"demonstrated\"") equals 0:
        return 14
    if not (agent_loop(restored and "recovered" and get_argument(4) and string_to_int(get_argument(5)) and 2048 and -1 and 65536) equals "completed"):
        return 15
    set state to agent_run_read(restored and "recovered")
    set final to archive_read_event(restored and archive_list_text(state and 3))
    set content to memory_source_text(final)
    for each marker in ["amber-garden-468","2026-03-12","north-lab-641","archive-restore-project-318","orchard-procedure-527"]:
        if string_contains(content and marker) equals 0:
            display content
            return 16
    set calls to history_collect_one(archive_prepare(restored and "SELECT count(DISTINCT json_extract(payload,'$.name')) FROM echo_events WHERE kind='tool_call' AND json_extract(payload,'$.run_id')='recovered' AND json_extract(payload,'$.name') IN ('memory_timeline','memory_graph','project','procedure','memory_read');"))
    if not (archive_list_text(calls and 1) equals "5") or else archive_verify_all(restored) is not equal to 0:
        return 17
    display "PASS: actual compaction/review activated; independent snapshot restored projects, episode dates, corrected facts, demonstrated procedures and original evidence; the local model used all five tool families in a new session and returned every marker. Source-only forgetting did not alter the backup."
    return sql_close(restored)
