import "../../app/agent/runner"
import "../../app/memory/episodes"
import "../../app/memory/knowledge_lifecycle"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "episode-source" and "" and "Remember our milestones with their original evidence.")
    set session to archive_list_text(first and 1)
    if archive_append(database and session and "milestone-source" and "user" and "On 2026-02-03 we finished the copper-orchard-812 observatory together." and "2026-10-16T12:00:00Z") is not equal to 0:
        return 4
    set source to archive_read_event(database and "milestone-source")
    set recorded to knowledge_record(database and "episode-source" and "episodic" and "user" and "milestone" and archive_list_text(source and 3) and "source-account" and "milestone-source" and archive_list_text(source and 6) and "2026-02-03" and "" and "")
    if string_contains(recorded and "recorded:") is not equal to 1:
        return 5
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set resumed to web_submit_owned(database and "owner" and "episode-recall" and "" and "Use memory_timeline to retrieve my saved milestones in chronological order. Tell me what we finished together and its event date, distinguishing that from when the account was recorded. Include the exact source event ID. Do not guess; read the stored episode.")
    if not (archive_list_text(resumed and 0) equals "accepted") or else not (agent_loop(database and "episode-recall" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 6
    set current to agent_run_read(database and "episode-recall")
    set final to archive_read_event(database and archive_list_text(current and 3))
    set body to archive_list_text(final and 3)
    if string_contains(body and "copper-orchard-812") equals 0 or else string_contains(body and "milestone-source") equals 0:
        display body
        return 7
    set used to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='episode-recall' AND json_extract(e.payload,'$.result.status')='found' AND instr(e.payload,'copper-orchard-812')>0;"))
    if string_to_int(archive_list_text(used and 1)) < 1 or else archive_verify(database and session) is not equal to 0 or else archive_verify(database and archive_list_text(resumed and 1)) is not equal to 0:
        return 8
    display "PASS: actual model retrieved a dated episode through tools in a fresh session after database reopen, returned its source-only marker and event ID, with intact source and destination archive chains."
    return sql_close(database)
