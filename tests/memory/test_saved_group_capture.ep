import "../../app/memory/context_snapshot"

# Run only on an operator-created disposable private archive copy. This appends
# a new revision snapshot to the copy; it never sends model or Discord requests.
define main returning Int:
    if get_argument_count() is not equal to 3 or else not file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set run to get_argument(2)
    if string_length(group_memory_scope(database and run)) equals 0:
        return 3
    if memory_context_capture(database and run) is not equal to 0:
        return 4
    set revision to memory_context_revision(database and run)
    set identity to concat(run and concat(":memory-context:" and revision))
    set event to archive_read_event(database and identity)
    set payload to archive_list_text(event and 3)
    set tokens to provider_json_tokens(payload)
    if tokens equals 0 or else not (provider_kind(tokens and 0) equals "{"):
        return 5
    set records_index to provider_member(tokens and 0 and "records")
    if records_index < 0 or else not (provider_kind(tokens and records_index) equals "["):
        return 6
    set records to group_memory_records(database and run)
    set expected to group_memory_selected_context(records)
    set content to provider_value(tokens and provider_member(tokens and 0 and "content"))
    if string_length(expected) equals 0 or else not (content equals expected):
        return 7
    if memory_context_capture(database and run) is not equal to 0:
        return 8
    display "PASS: saved-archive capture produced valid records and exact matching shared content; idempotent recapture passed. No inference or delivery performed."
    return sql_close(database)
