import "../../app/agent/run_messages"
import "../../app/memory/private_bridge"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0:
        return 2
    set output to private_bridge_read(database and get_argument(2) and "memory_sessions" and "{\"archive\":\"linked\",\"after\":0,\"limit\":1}")
    set fields to provider_json_tokens(output)
    set status to provider_value(fields and provider_member(fields and 0 and "status"))
    set count to provider_value(fields and provider_member(fields and 0 and "count"))
    set result to concat("{\"status\":" and provider_quote(status))
    set result to concat(result and concat(",\"count\":" and provider_quote(count)))
    set result to concat(result and concat(",\"result_sha256\":" and concat(provider_quote(ep_sha256(output)) and "}")))
    if write_file(get_argument(3) and result) is not equal to 1:
        return 3
    return sql_close(database)
