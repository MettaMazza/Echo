import "../fixtures/memory_tool_fixture"
import "../../app/security/group_session_selection"
import "../../app/memory/automatic_context"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    for each name in ["a","b"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set original to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "original" and "My milestone is Café 🌍")
    if not (archive_list_text(original and 0) equals "accepted") or else agent_cancel_run(database and "original") is not equal to 0:
        return 5
    set next to group_session_restart(database and "a" and "new" and "g" and "discord" and "server" and "room" and 1)
    set recall to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "recall" and "Recall an original.")
    if not (archive_list_text(next and 0) equals "created") or else not (archive_list_text(recall and 0) equals "accepted"):
        return 6
    # Original is unindexed and must remain retrievable without bulk injection.
    if length_list(memory_pending(database and "recall")) is not equal to 1 or else string_contains(memory_context(database and "recall") and "Café") is not equal to 0:
        return 7
    if recall_fixture_call(database and "recall" and "search-request" and "search" and "memory_search" and "{\"query\":\"milestone\",\"after\":0}") is not equal to 0:
        return 8
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.event'),json_extract(e.payload,'$.result.source_session'),json_extract(e.payload,'$.result.next_search') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='search' AND t.state='observed';"))
    if not (archive_list_text(result and 1) equals "original:user") or else not (archive_list_text(result and 2) equals archive_list_text(original and 1)):
        return 9
    set continuation to archive_list_text(result and 3)
    if recall_fixture_call(database and "recall" and "read-request" and "read" and "memory_read" and "{\"event\":\"original:user\",\"offset\":16,\"characters\":6}") is not equal to 0:
        return 10
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.text'),json_extract(e.payload,'$.result.next_offset'),json_extract(e.payload,'$.result.historical_source') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='read' AND t.state='observed';"))
    if not (archive_list_text(result and 1) equals "Café 🌍") or else not (archive_list_text(result and 2) equals "22") or else not (archive_list_text(result and 3) equals "1"):
        return 11
    # The captured boundary does not move when a new source arrives.
    if not (group_run_submit(database and "a" and "late" and archive_list_text(original and 1) and "discord" and "server" and "room" and "A later milestone must not enter the earlier search snapshot.") equals "accepted"):
        return 12
    if recall_fixture_call(database and "recall" and "next-request" and "next" and "memory_search" and continuation) is not equal to 0:
        return 13
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='next' AND t.state='observed';"))
    if not (archive_list_text(result and 1) equals "end"):
        return 14
    set private to web_submit_owned(database and "a" and "private" and "" and "Private milestone must stay private.")
    if recall_fixture_call(database and "recall" and "private-request" and "private" and "memory_read" and "{\"event\":\"private:user\",\"offset\":0,\"characters\":100}") is not equal to 0:
        return 15
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='private' AND t.state='observed';"))
    if not (archive_list_text(result and 1) equals "not-authorized"):
        return 16
    if not (group_create(database and "b" and "other" and "discord" and "server" and "room" and "other-user") equals "created"):
        return 17
    set other to group_route_submit(database and "b" and "other" and "discord" and "server" and "room" and "other" and "Other audience.")
    if not (archive_list_text(other and 0) equals "accepted") or else not (archive_list_text(memory_scoped_read(database and "other" and "original:user" and 0 and 100) and 0) equals "not-authorized") or else not (archive_list_text(memory_scoped_next(database and "other" and "milestone" and 0 and 9223372036854775807) and 0) equals "end"):
        return 18
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (archive_list_text(memory_scoped_read(database and "recall" and "original:user" and 16 and 6) and 7) equals "Café 🌍"):
        return 19
    if not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (archive_list_text(memory_scoped_read(database and "recall" and "original:user" and 0 and 100) and 0) equals "not-authorized"):
        return 20
    display "PASS: real queued shared memory search/read dispatch, Unicode original evidence, fixed cursor boundary, unindexed originals without wholesale context, private/other-user isolation, reopen and membership invalidation. Streaming provider is a fixture; real-model acceptance remains separate."
    return sql_close(database)
