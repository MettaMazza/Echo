import "../../app/archive/snapshot"
import "../../app/memory/procedures"
import "../../app/context/session_messages"
import "../../app/web/run_store"

# Operates only on an isolated copy of the demonstrated workflow fixture.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    set schemas to session_tool_schemas_owned(database and "resume")
    set before to procedure_read(database and "resume" and "procedure:first:step-2" and schemas)
    set fields to provider_json_tokens(before)
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "found"):
        return 2
    set manifest to agent_json_source(before and fields and provider_member(fields and 0 and "manifest"))
    if not (procedure_visibility_set(database and "resume" and "forget-procedure" and "procedure:first:step-2" and 0 and "forgotten" and "Withdraw workflow") equals "recorded") or else not (procedure_visibility_set(database and "resume" and "forget-procedure" and "procedure:first:step-2" and 0 and "forgotten" and "Withdraw workflow") equals "already-recorded"):
        return 3
    set hidden to procedure_read(database and "resume" and "procedure:first:step-2" and schemas)
    set fields to provider_json_tokens(hidden)
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "forgotten") or else string_contains(hidden and "Inspect source") > 0 or else not (procedure_search(database and "resume" and "" and 0 and schemas) equals "{\"status\":\"end\"}"):
        return 4
    if not (procedure_save(database and "resume" and "duplicate-procedure" and manifest and schemas) equals "duplicate-version"):
        return 5
    if not (procedure_visibility_set(database and "resume" and "stale-restore" and "procedure:first:step-2" and 0 and "visible" and "Stale restore") equals "revision-conflict"):
        return 6
    set revision to history_tool_integer(fields and "visibility_revision")
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (procedure_read(database and "resume" and "procedure:first:step-2" and schemas) equals hidden):
        return 7
    set snapshot to concat(get_argument(1) and ".snapshot")
    set restored_path to concat(get_argument(1) and ".restored")
    if archive_snapshot(database and snapshot) is not equal to 0 or else archive_restore(snapshot and restored_path) is not equal to 0:
        return 13
    set restored_database to archive_open(restored_path)
    if restored_database equals 0 or else not (procedure_read(restored_database and "resume" and "procedure:first:step-2" and schemas) equals hidden) or else not (procedure_search(restored_database and "resume" and "" and 0 and schemas) equals "{\"status\":\"end\"}") or else archive_verify_all(restored_database) is not equal to 0:
        return 14
    set closed_restore to sql_close(restored_database)
    if not (procedure_visibility_set(database and "resume" and "restore-procedure" and "procedure:first:step-2" and revision and "visible" and "Explicit restoration") equals "recorded"):
        return 8
    set restored to procedure_read(database and "resume" and "procedure:first:step-2" and schemas)
    if string_contains(restored and "Inspect source") equals 0:
        return 9
    if web_pairing_invite(database and "foreign") is not equal to 0 or else web_device_pair(database and "foreign" and "foreign" and "Foreign" and "foreign-secret") is not equal to 0:
        return 10
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Other owner")
    if not (procedure_visibility_set(database and "foreign" and "foreign-forget" and "procedure:first:step-2" and revision and "forgotten" and "Foreign") equals "not-authorized"):
        return 11
    if archive_verify(database and "session:first") is not equal to 0 or else archive_verify(database and "session:resume") is not equal to 0:
        return 12
    display "PASS: workflow forgetting hides reads and discovery, survives reopen and independent backup/restore, prevents exact-content relearning, rejects stale/foreign changes, restores explicitly and preserves source archive chains."
    return sql_close(database)
