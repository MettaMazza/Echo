import "../../app/memory/source_import"
import "../../app/archive/snapshot"
import "../../app/jobs/delegation_schema"
import "../../app/agent/runner"

# Actual pinned repository text is supplied as the same envelope used by the
# host importer. A fresh session must find it through tools, not this prompt.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "source" and "" and "Preserve the attributed original source.")
    set payload to ptr_to_str(read_file(get_argument(4)))
    if not (memory_source_import(database and "source" and "imported-citation" and payload) equals "recorded"):
        return 4
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set resumed to web_submit_owned(database and "owner" and "resume" and "" and "Find the imported CITATION.cff for Smithian-Fold-Theory using memory_search, then inspect its original record with memory_read. Report the author's full name and the exact imported repository revision. Distinguish the source's attribution from independent verification. Use the saved record, not a web lookup.")
    if not (agent_loop(database and "resume" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 5
    set state to agent_run_read(database and "resume")
    set final to archive_read_event(database and archive_list_text(state and 3))
    set content to memory_source_text(final)
    set fields to provider_json_tokens(payload)
    if string_contains(content and "Maria Smith") equals 0 or else string_contains(content and provider_value(fields and provider_member(fields and 0 and "revision"))) equals 0:
        display content
        return 6
    set calls to history_collect_one(archive_prepare(database and "SELECT count(DISTINCT json_extract(payload,'$.name')) FROM echo_events WHERE kind='tool_call' AND json_extract(payload,'$.run_id')='resume' AND json_extract(payload,'$.name') IN ('memory_search','memory_read');"))
    if not (archive_list_text(calls and 1) equals "2") or else archive_verify_all(database) is not equal to 0:
        return 7
    display "PASS: after reopen the actual local model discovered and read the imported original in a new session and returned its author and exact pinned revision, with intact archive chains."
    return sql_close(database)
