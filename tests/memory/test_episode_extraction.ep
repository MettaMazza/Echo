import "../../app/web/run_store"
import "../../app/memory/automatic"
import "../../app/memory/episodes"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "On 3 February 2026 we completed the observatory. Another milestone happened sometime before that.")
    set next to web_submit_owned(database and "owner" and "next" and "" and "Recall our milestones.")
    set sources to memory_pending(database and "next")
    set response to "{\"memories\":[{\"source_event\":\"first:user\",\"kind\":\"episodic\",\"category\":\"milestone\",\"quote\":\"On 3 February 2026 we completed the observatory.\",\"event_time\":\"2026-02-03\",\"time_quote\":\"3 February 2026\"},{\"source_event\":\"first:user\",\"kind\":\"episodic\",\"category\":\"milestone\",\"quote\":\"Another milestone happened sometime before that.\",\"event_time\":\"\",\"time_quote\":\"\"}]}"
    set bare to substring(response and 12 and string_length(response) - 13)
    set grounded_array to memory_ground_extraction(database and "next" and sources and 0 and length_list(sources) and bare)
    if not (memory_extract_save(database and "next" and sources and 0 and length_list(sources) and grounded_array) equals "ready"):
        return 12
    for each payload in [response,bare]:
        set fenced to concat("```json\n" and concat(payload and "\n```\n"))
        set grounded_fence to memory_ground_extraction(database and "next" and sources and 0 and length_list(sources) and fenced)
        if not (memory_extract_save(database and "next" and sources and 0 and length_list(sources) and grounded_fence) equals "ready"):
            return 13
    set alias to ptr_to_str(string_replace(response and "\"kind\":\"episodic\"" and "\"kind\":\"milestone\""))
    set normalized to memory_ground_extraction(database and "next" and sources and 0 and length_list(sources) and alias)
    if string_contains(normalized and "\"kind\":\"episodic\"") equals 0:
        return 11
    set grounded to memory_ground_extraction(database and "next" and sources and 0 and length_list(sources) and response)
    if not (memory_extract_save(database and "next" and sources and 0 and length_list(sources) and grounded) equals "ready"):
        return 4
    set records to history_collect_one(archive_prepare(database and "SELECT count(*),sum(event_time='2026-02-03'),sum(event_time='') FROM echo_memory_claims;"))
    if not (archive_list_text(records and 1) equals "2") or else not (archive_list_text(records and 2) equals "1") or else not (archive_list_text(records and 3) equals "1"):
        return 5
    for each invalid in ["2026-02-30", "invented", "2026-13-01"]:
        set changed to ptr_to_str(string_replace(response and "2026-02-03" and invalid))
        set grounded to memory_ground_extraction(database and "next" and sources and 0 and length_list(sources) and changed)
        if string_contains(grounded and concat("\"event_time\":\"" and invalid)) > 0:
            return 6
    set changed to ptr_to_str(string_replace(response and "\"time_quote\":\"3 February 2026\"" and "\"time_quote\":\"5 March 2024\""))
    set grounded to memory_ground_extraction(database and "next" and sources and 0 and length_list(sources) and changed)
    if string_contains(grounded and "2026-02-03") > 0 or else string_contains(grounded and "completed the observatory") equals 0:
        return 7
    if not (memory_extract_save(database and "next" and sources and 0 and length_list(sources) and response) equals "ready"):
        return 8
    set records to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_memory_claims;"))
    if not (archive_list_text(records and 1) equals "2"):
        return 9
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set timeline to episode_page(database and "next" and "" and 10 and "milestone")
    if string_contains(timeline and "2026-02-03") equals 0 or else string_contains(timeline and "source-recording-time") equals 0 or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0:
        return 10
    display "PASS: automatic ingestion retains a source-quoted normalized event date, leaves undated experiences unknown, drops invalid/unbacked dates without dropping source text, deduplicates retries and survives reopen."
    return sql_close(database)
