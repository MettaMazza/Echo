import "../../app/archive/snapshot"
import "../../app/memory/automatic"
import "../../app/memory/automatic_context"
import "../../app/memory/episodes"
import "../../app/memory/knowledge_lifecycle"
import "../../app/security/group_runs"
import "../../app/security/group_session_selection"
import "../../app/agent/runner"

define main returning Int:
    if (get_argument_count() is not equal to 4 and get_argument_count() is not equal to 5) or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    for each name in ["a","b","c"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set private to web_submit_owned(database and "a" and "private" and "" and "Private source must stay private.")
    if not (group_session_create(database and "a" and "s3" and "g" and "discord" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "b" and "group-run" and "s3" and "discord" and "server" and "room" and "On 2026-03-12 our shared milestone was amber-group-741.") equals "accepted"):
        return 5
    set state to agent_run_read(database and "group-run")
    set source_event to archive_list_text(state and 1)
    set source to archive_read_event(database and source_event)
    set digest to archive_list_text(source and 6)


    set destination to "s3"
    if get_argument_count() equals 5:
        set next to group_session_restart(database and "a" and "cross-session" and "g" and "discord" and "server" and "room" and 3)
        if not (archive_list_text(next and 0) equals "created"):
            return 24
        set destination to archive_list_text(next and 1)
    if agent_cancel_run(database and "group-run") is not equal to 0 or else not (group_run_submit(database and "a" and "extract" and destination and "discord" and "server" and "room" and "Recall our milestone.") equals "accepted"):
        return 6
    if get_argument_count() equals 4:
        if length_list(memory_pending(database and "extract")) is not equal to 0:
            return 7
        # Seed only the recap boundary to test extraction scheduling. This fixture
        # does not claim model-generated compaction or semantic recap acceptance.
        if checkpoint_stage(database and "seed" and "s3" and source_event and "" and "Shared milestone source retained in archive." and "{}" and "fixture-boundary") is not equal to 0 or else checkpoint_activate(database and "s3" and "seed") is not equal to 0:
            return 8
    set sources to memory_pending(database and "extract")
    if length_list(sources) is not equal to 1 or else not (archive_list_text(sources and 0) equals source_event):
        return 9
    if not (memory_extract_save(database and "extract" and ["private:user"] and 0 and 1 and "{\"memories\":[]}") equals "memory-source-not-authorized"):
        return 10
    set profile to provider_llama_profile(get_argument(2) and string_to_int(get_argument(3)))
    set outcome to memory_prepare(database and "extract" and profile and 2048 and -1 and 65536)
    if not (outcome equals "ready") or else length_list(memory_pending(database and "extract")) is not equal to 0:
        display outcome
        return 11
    set page to episode_page(database and "extract" and "" and 10 and "")
    if string_contains(page and "amber-group-741") equals 0 or else string_contains(page and "2026-03-12") equals 0 or else string_contains(page and "device:b") equals 0 or else string_contains(page and digest) equals 0:
        display page
        return 12
    set row to knowledge_next(database and "extract" and "device:b" and 0)
    if not (archive_list_text(row and 0) equals "found"):
        return 13
    set identity to archive_list_text(row and 1)
    if not (knowledge_visibility_set(database and "extract" and "forget-extracted" and identity and 0 and "forgotten" and "Explicit withdrawal") equals "recorded"):
        return 14
    set before to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='model_request';"))
    if not (memory_prepare(database and "extract" and profile and 2048 and -1 and 65536) equals "ready"):
        return 15
    set after to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='model_request';"))
    if not (archive_list_text(before and 1) equals archive_list_text(after and 1)) or else not (archive_list_text(knowledge_visibility_read(database and "extract" and identity) and 1) equals "forgotten"):
        return 16
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if length_list(memory_pending(database and "extract")) is not equal to 0 or else archive_verify_all(database) is not equal to 0:
        return 17
    if not (group_change(database and "a" and "invite-c" and "g" and "device:c" and "invited" and 3) equals "recorded") or else not (memory_extract_save(database and "extract" and sources and 0 and 1 and "{\"memories\":[]}") equals "memory-source-not-authorized"):
        return 18
    display "PASS: actual model extracted dated shared episode with authenticated speaker and digest; seeded recap boundary skips ordinary-turn extraction; private and revoked sources denied; receipts survive reopen and prevent repeat requests or forgotten-memory resurrection. Compaction boundary was fixture-seeded."
    if get_argument_count() equals 5:
        display "PASS: repeated in a newly selected conversation with the same audience, without copying its old messages into the new session."
    return sql_close(database)
