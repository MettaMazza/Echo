import "../../app/tools/attachment_tools"
import "../../app/web/attachments"

# Inspect the actual imported originals through the existing scope and reader
# functions. The PDF reader may create its normal digest-bound derived cache.
define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    set run to get_argument(2)
    if database equals 0 or else string_length(memory_archive_principal(database and run)) equals 0:
        return 2
    set authority to history_collect_one(checkpoint_prepare(database and "SELECT a.device,r.session FROM echo_run_authority a JOIN echo_runs r ON r.run=a.run WHERE a.run=?;" and [run]))
    set tokens to provider_json_tokens(ptr_to_str(read_file(get_argument(3))))
    set items to provider_items(tokens and 0)
    if items equals 0 or else length_list(items) is not equal to 3:
        return 3
    for each item in items:
        set attachment to provider_value(tokens and provider_member(tokens and item and "attachment"))
        set digest to provider_value(tokens and provider_member(tokens and item and "sha256"))
        set row to web_attachment_owned(database and archive_list_text(authority and 1) and attachment)
        if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 4) equals digest):
            return 4
        set original to file_digest(archive_list_text(row and 1) and 65536)
        if not (archive_list_text(original and 0) equals "verified") or else not (archive_list_text(original and 1) equals digest):
            return 5
        if archive_list_text(row and 3) equals "application/pdf":
            set arguments to concat("{\"attachment\":" and concat(provider_quote(attachment) and ",\"offset\":0,\"characters\":1000,\"page\":0}"))
            set read to attachment_text_execute(database and archive_list_text(authority and 2) and arguments)
            set fields to provider_json_tokens(read)
            if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "found") or else not (provider_value(fields and provider_member(fields and 0 and "representation")) equals "pdfkit-page-text") or else string_length(provider_value(fields and provider_member(fields and 0 and "text"))) equals 0:
                display "PDF original could not be extracted through the scoped reader."
                return 6
    display "PASS: all three imported binary originals resolve through owner scope with matching file digests; the original PDF yields nonempty text through the scoped PDFKit reader."
    return sql_close(database)
