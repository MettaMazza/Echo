import "../fixtures/memory_tool_fixture"
import "../../app/security/group_session_selection"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "a" and "secret") is not equal to 0 or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 3
    set submitted to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "record" and "Remember marker silver-fixture-42.")
    if not (archive_list_text(submitted and 0) equals "accepted") or else recall_fixture_call(database and "record" and "check-request" and "check" and "task_checklist" and "{\"items\":[{\"id\":\"save\",\"requirement\":\"Record marker\",\"status\":\"pending\",\"evidence\":\"\"}]}") is not equal to 0:
        return 4
    set arguments to "{\"kind\":\"episodic\",\"subject\":\"a\",\"predicate\":\"marker\",\"object\":\"silver-fixture-42\",\"evidence\":\"source-account\",\"source_event\":\"record:user\",\"source_digest\":\"wrong\",\"event_time\":\"\",\"valid_until\":\"\",\"supersedes\":\"\"}"
    if recall_fixture_call(database and "record" and "bad-request" and "bad" and "memory_record" and arguments) is not equal to 0:
        return 5
    set row to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.effects'),json_extract(e.payload,'$.result.feedback.message'),json_extract(e.payload,'$.result.feedback.recovery') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='bad';"))
    if not (archive_list_text(row and 1) equals "source-digest-mismatch") or else not (archive_list_text(row and 2) equals "none") or else string_contains(archive_list_text(row and 3) and "not an account-role restriction") equals 0 or else string_contains(archive_list_text(row and 4) and "memory_read") equals 0:
        return 6
    set source to archive_read_event(database and "record:user")
    set corrected to ptr_to_str(string_replace(arguments and "wrong" and archive_list_text(source and 6)))
    if recall_fixture_call(database and "record" and "good-request" and "good" and "memory_record" and corrected) is not equal to 0:
        return 7
    set row to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='good';"))
    if not (archive_list_text(row and 1) equals "recorded"):
        return 8
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='group_memory_claim';"))
    if not (archive_list_text(row and 1) equals "1"):
        return 9
    display "PASS: actual queued memory_record rejects wrong digest with no effects and precise recovery; verified digest records exactly one scoped claim."
    return sql_close(database)
