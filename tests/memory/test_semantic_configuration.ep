import "../../app/memory/recall_selection"
import "../../app/agent/run_state"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)) or else not (ptr_to_str(get_env("ECHO_EMBEDDING_PROFILE")) equals get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 2
    set claims to "[{\"id\":\"standing\",\"source_kind\":\"user\",\"category\":\"preference\",\"quotation\":\"standing-choice\",\"source_sequence\":1},{\"id\":\"semantic\",\"source_kind\":\"source-account\",\"category\":\"project\",\"quotation\":\"topicquote\",\"source_sequence\":2},{\"id\":\"unmatched\",\"source_kind\":\"inference\",\"category\":\"project\",\"quotation\":\"unmatched-claim\",\"source_sequence\":3}]"
    set fallback to memory_semantic_select(database and "run" and claims)
    if string_contains(fallback and "standing-choice") equals 0 or else string_contains(fallback and "topicquote") or else string_contains(fallback and "unmatched-claim"):
        return 3
    if memory_semantic_prepare(database and "run") is not equal to 1:
        return 4
    set schema to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name IN ('echo_recall_vectors','echo_recall_passages','echo_recall_indexed');"))
    if not (archive_list_text(schema and 1) equals "3"):
        return 5
    if archive_append(database and "session" and "objective" and "user" and "query" and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "objective") is not equal to 0:
        return 6
    if write_file(get_argument(2) and "{\"port\":0,\"model_sha256\":\"fixture-model\",\"query_prefix\":\"\",\"relevance_standard_deviations\":2}") is not equal to 1:
        return 7
    set values to create_list()
    set added to append_list(values and ep_sha256("query"))
    set added to append_list(values and ep_sha256("topicquote"))
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_recall_vectors VALUES('fixture-model',?1,'query','[1,0]'),('fixture-model',?2,'topicquote','[1,0]');" and values) and 101) is not equal to 0:
        return 8
    set passage_values to create_list()
    set added to append_list(passage_values and ep_sha256("topicquote"))
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_recall_passages VALUES('topicquote','topicquote',?1);" and passage_values) and 101) is not equal to 0:
        return 9
    set selected to memory_semantic_select(database and "run" and claims)
    if string_contains(selected and "standing-choice") equals 0 or else string_contains(selected and "topicquote") equals 0 or else string_contains(selected and "unmatched-claim"):
        return 10
    display "PASS: absent profile uses standing context without missing-table query; configured cached semantic selection includes relevant evidence and excludes unmatched claims."
    return sql_close(database)
