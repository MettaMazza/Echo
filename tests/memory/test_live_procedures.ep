import "../../app/agent/tool_dispatch"
import "../../app/jobs/delegation_schema"
import "../../app/agent/runner"
import "../fixtures/generation_fixture"

define procedure_fixture_step with database as Int and run as Str and step as Int and name as Str and arguments as Str returning Int:
    set identity to concat("step-" and int_to_string(step))
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and run and concat(run and concat(":" and identity)) and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    repeat while archive_list_text(agent_run_read(database and run) and 2) equals "tools":
        if agent_tool_step(database and run) is not equal to 0:
            return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "The source verification marker is orchard-procedure-527.")
    if procedure_fixture_step(database and "first" and 0 and "tool_search" and "{\"query\":\"memory_read\",\"after\":0,\"catalog_digest\":\"\"}") is not equal to 0 or else procedure_fixture_step(database and "first" and 1 and "memory_read" and "{\"event\":\"first:user\",\"offset\":0,\"characters\":1000}") is not equal to 0:
        return 4
    set discovery to history_collect_one(archive_prepare(database and "SELECT e.event,e.digest,json_extract(e.payload,'$.result.contract_sha256') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='first' AND t.call_id='step-0';"))
    set observation to history_collect_one(archive_prepare(database and "SELECT e.event,e.digest FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='first' AND t.call_id='step-1';"))
    set manifest to concat("{\"name\":\"Inspect source\",\"purpose\":\"Recover the original verification marker\",\"prerequisites\":\"Access to first:user\",\"failure_lessons\":\"If the original is unavailable report that; do not guess\",\"steps\":[{\"action\":\"Use memory_read with event first:user, offset 0 and characters 1000; return its verification marker.\",\"tool\":\"memory_read\",\"contract_sha256\":" and provider_quote(archive_list_text(discovery and 3)))
    for each pair in [["result_event",archive_list_text(observation and 1)],["result_digest",archive_list_text(observation and 2)],["discovery_event",archive_list_text(discovery and 1)],["discovery_digest",archive_list_text(discovery and 2)]]:
        set manifest to concat(manifest and ",")
        set manifest to concat(manifest and provider_quote(archive_list_text(pair and 0)))
        set manifest to concat(manifest and ":")
        set manifest to concat(manifest and provider_quote(archive_list_text(pair and 1)))
    set manifest to concat(manifest and ",\"checks\":[{\"path\":\"$.result.status\",\"equals\":\"found\"}]}]}")
    if procedure_fixture_step(database and "first" and 2 and "procedure" and concat("{\"operation\":\"save\",\"manifest\":" and concat(manifest and "}"))) is not equal to 0:
        return 5
    set saved to procedure_read(database and "first" and "procedure:first:step-2" and session_tool_schemas_owned(database and "first"))
    if string_contains(saved and "\"assessment\":\"demonstrated\"") equals 0:
        display saved
        return 6
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set resumed to web_submit_owned(database and "owner" and "resume" and "" and "Find my saved Inspect source procedure using tool_search or procedure search. Read it, check its current assessment, and actually carry out its authorized reading step. Return the verification marker from that fresh read. Do not just quote the stored workflow.")
    if not (agent_loop(database and "resume" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 7
    set state to agent_run_read(database and "resume")
    set final to archive_read_event(database and archive_list_text(state and 3))
    if string_contains(memory_source_text(final) and "orchard-procedure-527") equals 0:
        return 8
    set calls to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='tool_call' AND json_extract(payload,'$.run_id')='resume' AND json_extract(payload,'$.name')='memory_read';"))
    if string_to_int(archive_list_text(calls and 1)) < 1 or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(resumed and 1)) is not equal to 0:
        return 9
    display "PASS: real discovery/read tool execution became an immutable demonstrated procedure; after reopen the actual model discovered it in a new session, rechecked it, executed a fresh read and returned the source marker."
    return sql_close(database)
