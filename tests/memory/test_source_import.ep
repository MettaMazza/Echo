import "../../app/memory/source_import"
import "../../app/memory/knowledge"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "Import original records")
    set next to web_submit_owned(database and "owner" and "next" and "" and "Recall imported evidence")
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Other principal")
    set content to "Original UTF-8 source: café. "
    set count to 0
    repeat while count < 1000:
        set content to concat(content and "A complete source paragraph. ")
        set count to count + 1
    set content to concat(content and "TAIL-import-orchid-682")
    set payload to concat("{\"origin\":\"https://github.com/example/source\",\"revision\":\"immutable-revision\",\"path\":\"record.txt\",\"attribution\":\"Original author account; not a direct experience\",\"content\":" and provider_quote(content))
    set payload to concat(payload and concat(",\"sha256\":" and concat(provider_quote(ep_sha256(content)) and "}")))
    if not (memory_source_import(database and "first" and "import-1" and payload) equals "recorded") or else not (memory_source_import(database and "first" and "import-1" and payload) equals "already-recorded"):
        return 4
    set bad to ptr_to_str(string_replace(payload and "TAIL-import-orchid-682" and "CORRUPTED"))
    if not (memory_source_import(database and "first" and "bad-import" and bad) equals "digest-mismatch") or else not (memory_source_import(database and "foreign" and "import-1" and payload) equals "event-conflict"):
        return 5
    set boundary to memory_archive_boundary(database and "next")
    set found to memory_archive_next(database and "next" and "TAIL-import-orchid-682" and 0 and string_to_int(archive_list_text(boundary and 1)))
    if not (archive_list_text(found and 1) equals "import-1") or else not (archive_list_text(found and 4) equals "source_import"):
        return 6
    set read to memory_archive_read(database and "next" and "import-1" and 0 and string_length(payload))
    if not (archive_list_text(read and 7) equals payload) or else not (archive_list_text(memory_archive_read(database and "foreign" and "import-1" and 0 and 100) and 0) equals "end"):
        return 7
    set source to archive_read_event(database and "import-1")
    set claim to knowledge_record(database and "next" and "semantic" and "source" and "marker" and "TAIL-import-orchid-682" and "source-account" and "import-1" and archive_list_text(source and 6) and "" and "" and "")
    if string_contains(claim and "recorded:") is not equal to 1:
        display claim
        return 8
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (archive_list_text(memory_archive_read(database and "next" and "import-1" and 0 and string_length(payload)) and 7) equals payload) or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0:
        return 9
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (archive_list_text(memory_archive_read(database and "next" and "import-1" and 0 and 100) and 0) equals "not-authorized"):
        return 10
    display "PASS: full attributed UTF-8 import, exact digest, idempotence, corruption rejection, cross-session search/read, source-backed claim, foreign denial, reopen and revocation."
    return sql_close(database)
