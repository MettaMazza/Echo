import "../../app/memory/knowledge_lifecycle"
import "../../app/agent/user_content"
import "../../app/memory/episodes"
import "../../app/security/group_runs"
import "../../app/jobs/delegation_schema"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each name in ["a","b","c"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set private to web_submit_owned(database and "a" and "private" and "" and "Private source must stay private.")
    if not (group_session_create(database and "a" and "s3" and "g" and "discord" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "b" and "group-run" and "s3" and "discord" and "server" and "room" and "On 2026-03-12 our shared milestone was amber-group-741.") equals "accepted"):
        return 5
    set state to agent_run_read(database and "group-run")
    set source_event to archive_list_text(state and 1)
    set source to archive_read_event(database and source_event)
    set digest to archive_list_text(source and 6)
    set content to agent_user_content(database and "s3" and source_event and "On 2026-03-12 our shared milestone was amber-group-741.")
    if string_contains(content and digest) equals 0 or else string_contains(content and source_event) equals 0 or else string_contains(content and "source-account") equals 0:
        return 33
    if string_length(agent_user_content(database and "s3" and "private:user" and "private")) is not equal to 0:
        return 34
    if not (knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "observation" and "tool-observation" and source_event and digest and "" and "" and "") equals "evidence-kind-mismatch"):
        return 35

    if not (knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "amber-group-741" and "source-account" and source_event and "wrong-digest" and "2026-03-12" and "" and "") equals "source-digest-mismatch"):
        return 31
    if not (knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "hidden" and "source-account" and "private:user" and "wrong-digest" and "" and "" and "") equals "not-authorized"):
        return 32
    set saved to knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "amber-group-741" and "source-account" and source_event and digest and "2026-03-12" and "" and "")
    if string_contains(saved and "recorded:") is not equal to 1:
        display saved
        return 6
    set identity to substring(saved and 9 and string_length(saved) - 9)
    if not (knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "amber-group-741" and "source-account" and source_event and digest and "2026-03-12" and "" and "") equals concat("already-recorded:" and identity)):
        return 7
    set read to group_memory_lookup(database and "group-run" and identity)
    if not (archive_list_text(read and 0) equals "found") or else string_contains(archive_list_text(read and 2) and "amber-group-741") equals 0 or else not (archive_list_text(group_memory_lookup(database and "private" and identity) and 0) equals "not-authorized"):
        return 8
    if not (archive_list_text(knowledge_next(database and "group-run" and "group" and 0) and 1) equals identity) or else not (knowledge_visibility_set(database and "group-run" and "forget" and identity and 0 and "forgotten" and "Explicit group decision") equals "recorded") or else not (knowledge_visibility_set(database and "group-run" and "forget" and identity and 0 and "forgotten" and "Explicit group decision") equals "already-recorded"):
        return 14
    if not (archive_list_text(knowledge_next(database and "group-run" and "" and 0) and 0) equals "end") or else not (knowledge_visibility_set(database and "group-run" and "stale" and identity and 0 and "visible" and "Stale restore") equals "revision-conflict"):
        return 15
    set visibility to knowledge_visibility_read(database and "group-run" and identity)
    if not (knowledge_visibility_set(database and "group-run" and "restore" and identity and string_to_int(archive_list_text(visibility and 2)) and "visible" and "Explicit restoration") equals "recorded") or else not (archive_list_text(knowledge_next(database and "group-run" and "group" and 0) and 1) equals identity):
        return 16
    set private_source to archive_read_event(database and "private:user")
    if not (knowledge_record(database and "group-run" and "semantic" and "private" and "leak" and "forbidden" and "source-account" and "private:user" and archive_list_text(private_source and 6) and "" and "" and "") equals "not-authorized") or else not (knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "bad date" and "source-account" and source_event and digest and "2026-02-30" and "" and "") equals "invalid-date-range"):
        return 9
    set corrected to knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "Corrected interpretation" and "inference" and source_event and digest and "2026-03-12" and "" and identity)
    if string_contains(corrected and "recorded:") is not equal to 1 or else not (knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "Conflicting successor" and "inference" and source_event and digest and "2026-03-12" and "" and identity) equals "correction-conflict"):
        return 10
    set earlier to knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "Earlier shared milestone" and "source-account" and source_event and digest and "2025-12-10" and "" and "")
    set page to episode_page(database and "group-run" and "" and 1 and "milestone")
    if string_contains(earlier and "recorded:") is not equal to 1 or else string_contains(page and "Earlier shared milestone") equals 0 or else string_contains(page and "amber-group-741") is not equal to 0 or else string_contains(page and "device:a") equals 0 or else string_contains(page and "device:b") equals 0 or else string_contains(page and "source_digest") equals 0 or else string_contains(page and "room") equals 0:
        display page
        return 20
    set fields to provider_json_tokens(page)
    set cursor to provider_value(fields and provider_member(fields and 0 and "next_cursor"))
    if string_contains(episode_page(database and "private" and cursor and 1 and "milestone") and "cursor-scope-changed") equals 0 or else string_contains(episode_page(database and "group-run" and cursor and 1 and "different") and "cursor-scope-changed") equals 0:
        return 21
    set late to knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "Inserted after cursor boundary" and "source-account" and source_event and digest and "2026-02-01" and "" and "")
    set page to episode_page(database and "group-run" and cursor and 10 and "milestone")
    if string_contains(page and "Inserted after cursor boundary") is not equal to 0 or else string_contains(page and "amber-group-741") equals 0 or else string_contains(page and "Corrected interpretation") equals 0:
        display page
        return 22
    set hidden to knowledge_visibility_set(database and "group-run" and "timeline-forget" and identity and string_to_int(archive_list_text(knowledge_visibility_read(database and "group-run" and identity) and 2)) and "forgotten" and "Timeline withdrawal")
    if not (hidden equals "recorded") or else string_contains(episode_page(database and "group-run" and cursor and 10 and "milestone") and "amber-group-741") is not equal to 0:
        return 23
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set reopened to group_memory_lookup(database and "group-run" and identity)
    if not (archive_list_text(reopened and 0) equals "found") or else not (archive_list_text(reopened and 2) equals archive_list_text(read and 2)) or else archive_verify(database and "s3") is not equal to 0:
        return 11
    if not (group_change(database and "a" and "invite-c" and "g" and "device:c" and "invited" and 3) equals "recorded") or else not (archive_list_text(group_memory_lookup(database and "group-run" and identity) and 0) equals "not-authorized"):
        return 12
    if not (group_session_create(database and "a" and "s4" and "g" and "discord" and "server" and "room" and 4) equals "created") or else not (group_run_submit(database and "a" and "new-group-run" and "s4" and "discord" and "server" and "room" and "New audience") equals "accepted") or else not (archive_list_text(group_memory_lookup(database and "new-group-run" and identity) and 0) equals "end"):
        return 13
    if string_contains(episode_page(database and "group-run" and cursor and 10 and "milestone") and "not-authorized") equals 0 or else string_contains(episode_page(database and "new-group-run" and cursor and 10 and "milestone") and "cursor-scope-changed") equals 0:
        return 24
    display "PASS: immutable audience-owned claims, source isolation, retry deduplication, correction conflicts, date validation, graph traversal, explicit forgetting/restoration, stale-change rejection, reopen and membership-change denial. Chronological pagination, source/audience provenance, fixed ingestion boundary, cursor scope and forgotten-row filtering verified. Common memory entry points verified; streamed tool acceptance remains separate."
    return sql_close(database)
