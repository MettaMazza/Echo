import "../../app/agent/runner"
import "../../app/web/run_store"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "Preserve original marker pending-memory-937.")
    set second to web_submit_owned(database and "owner" and "second" and "" and "Recall my previous conversation.")
    set principal to memory_archive_principal(database and "first")
    if string_length(principal) equals 0 or else not (principal equals memory_archive_principal(database and "second")):
        return 4
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to compaction_lock_acquire(database and concat("memory-extraction:" and principal) and library)
    if descriptor is less than 0:
        return 5
    # No inference service exists here: the competing pass must defer before
    # provider work, while its original source remains accessible in context.
    set status to memory_prepare(database and "second" and provider_llama_profile("fixture" and 1) and 2048 and -1 and 65536)
    if not (status equals "memory-extraction-deferred"):
        display status
        return 6
    if string_contains(memory_pending_context(database and "second") and "pending-memory-937") equals 0:
        return 7
    if net_close(descriptor) is not equal to 0:
        return 8
    set resumed to compaction_lock_acquire(database and concat("memory-extraction:" and principal) and library)
    if resumed is less than 0 or else net_close(resumed) is not equal to 0:
        return 9
    display "PASS: overlapping account extraction defers without inference; original memory remains available; ownership releases for retry."
    return sql_close(database)
