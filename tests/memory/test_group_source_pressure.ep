import "../../app/memory/group_knowledge"
import "../../app/security/group_session_selection"
import "../../app/web/run_store"

external define ep_gc_get_minor_count returning Int

# Exercise the actual authorization path, including its allocating argument,
# repeatedly through collections; no model or network is involved.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "a" and "secret") is not equal to 0:
        return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set admitted to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "run" and "Preserve this source.")
    if not (archive_list_text(admitted and 0) equals "accepted"):
        return 5
    set source to archive_read_event(database and "run:user")
    set digest to archive_list_text(source and 6)
    set before to ep_gc_get_minor_count()
    set count to 0
    repeat while count < 1000:
        if group_memory_source_allowed(database and "run" and "run:user" and digest) is not equal to 1:
            return 6
        if group_memory_source_allowed(database and "run" and "run:user" and "wrong-digest") is not equal to 0:
            return 7
        set count to count + 1
    if ep_gc_get_minor_count() <= before:
        return 8
    display "PASS: 1000 authorized and rejected source checks across garbage collections."
    return sql_close(database)
