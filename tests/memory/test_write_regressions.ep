import "../../app/web/run_store"
import "../../app/security/channel_silo"
import "../../app/tools/scratchpad"
import "../../app/memory/linked_record"

define record_fixture with database as Int and run as Str and event as Str and digest as Str and evidence as Str returning Str:
    return knowledge_record_linked(database and run and "semantic" and "owner" and "lives in" and "Scotland" and evidence and event and digest and "" and "" and "")

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set local to archive_open(get_argument(1))
    set remote to archive_open(get_argument(2))
    for each database in [local,remote]:
        if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied") :
            return 2
        for each device in ["owner","other"]:
            if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
                return 3
    set source to web_submit_owned(remote and "owner" and "source" and "" and "Scotland 🌺, not London")
    set secret to web_submit_owned(remote and "other" and "secret" and "" and "Other user's private marker")
    set dm to channel_silo_submit(local and "owner" and "discord" and "dm:bot" and "dm" and "dm" and "Recall my web history" and create_list())
    set public to channel_silo_submit(local and "owner" and "discord" and "server" and "general" and "public" and "Public" and create_list())
    set foreign to channel_silo_submit(local and "other" and "discord" and "dm:bot" and "other" and "foreign" and "Other" and create_list())
    set web to web_submit_owned(local and "owner" and "web" and "" and "Private")
    for each row in [source,secret,dm,public,foreign,web]:
        if not (archive_list_text(row and 0) equals "accepted"):
            return 4
    for each run in ["public","dm","web"]:
        set first to scratchpad_execute(local and run and "{\"operation\":\"write\",\"name\":\"audit\",\"text\":\"original\"}")
        if not string_contains(first and "\"status\":\"saved\""):
            display first
            return 10
        if not string_contains(scratchpad_execute(local and run and "{\"operation\":\"write\",\"name\":\"audit\",\"text\":\"clobber\"}") and "revision-conflict"):
            return 11
        if not string_contains(scratchpad_execute(local and run and "{\"operation\":\"delete\",\"name\":\"audit\"}") and "revision-conflict"):
            return 12
        if not string_contains(scratchpad_execute(local and run and "{\"operation\":\"write\",\"name\":\"new\",\"text\":\"bad\",\"previous_revision\":null}") and "invalid-arguments"):
            return 13
        set fields to provider_json_tokens(first)
        set revision to provider_value(fields and provider_member(fields and 0 and "revision"))
        set update to concat("{\"operation\":\"write\",\"name\":\"audit\",\"text\":\"updated\",\"previous_revision\":" and concat(provider_quote(revision) and "}"))
        if not string_contains(scratchpad_execute(local and run and update) and "saved") or else not string_contains(scratchpad_execute(local and run and update) and "revision-conflict"):
            return 14
    display "PASS: omitted revision creates; revisions protect updates/deletes; invalid types rejected."
    set config to concat("{\"links\":[{\"enabled\":true,\"local_database\":" and provider_quote(get_argument(1)))
    set config to concat(config and concat(",\"remote_database\":" and provider_quote(get_argument(2))))
    set config to concat(config and ",\"local_principals\":[\"device:owner\"],\"remote_principals\":[\"device:owner\"]}]}")
    if write_file(get_argument(3) and config) is not equal to 1:
        return 20
    set original to archive_read_event(remote and "source:user")
    set digest to archive_list_text(original and 6)
    set other_digest to archive_list_text(archive_read_event(remote and "secret:user") and 6)
    for each run in ["public","foreign"]:
        if not (record_fixture(local and run and "source:user" and digest and "source-account") equals "linked-source-not-authorized"):
            return 21
    if not (record_fixture(local and "dm" and "secret:user" and other_digest and "source-account") equals "linked-source-not-authorized"):
        return 22
    if not (record_fixture(local and "dm" and "source:user" and "wrong" and "source-account") equals "source-digest-mismatch"):
        return 23
    if not (record_fixture(local and "dm" and "source:user" and digest and "tool-observation") equals "evidence-kind-mismatch"):
        return 24
    set none to history_collect_one(archive_prepare(local and "SELECT COUNT(*) FROM echo_events WHERE kind='source_import';"))
    if not (archive_list_text(none and 1) equals "0"):
        return 25
    for each run in ["dm","web"]:
        set result to record_fixture(local and run and "source:user" and digest and "source-account")
        if not string_contains(result and "recorded:"):
            display result
            return 26
        if not (record_fixture(local and run and "source:user" and digest and "source-account") equals concat("already-" and result)):
            return 27
        set claim to knowledge_next(local and run and "owner" and 0)
        if not (archive_list_text(claim and 0) equals "found") or else not (archive_list_text(claim and 6) equals "Scotland"):
            display claim
            return 28
    set copy to history_collect_one(archive_prepare(local and "SELECT json_extract(payload,'$.original_payload'),json_extract(payload,'$.source_event'),json_extract(payload,'$.source_digest') FROM echo_events WHERE kind='source_import' ORDER BY sequence LIMIT 1;"))
    if not (archive_list_text(copy and 1) equals "Scotland 🌺, not London" and archive_list_text(copy and 2) equals "source:user" and archive_list_text(copy and 3) equals digest):
        return 29
    set appended to archive_append(remote and archive_list_text(source and 1) and "reply" and "assistant_final" and "{\"content\":\"A model guess\"}" and "unix-ms:1")
    set assistant_digest to archive_list_text(archive_read_event(remote and "reply") and 6)
    if not (record_fixture(local and "dm" and "reply" and assistant_digest and "source-account") equals "evidence-kind-mismatch"):
        return 30
    if not string_contains(record_fixture(local and "dm" and "reply" and assistant_digest and "inference") and "recorded:"):
        return 31
    set correction to web_submit_owned(remote and "owner" and "correction" and "" and "Correction: Wales")
    if memory_correction_record(remote and "correction" and "source:user" and "correction:user") is not equal to 0:
        return 32
    if not string_contains(record_fixture(local and "dm" and "source:user" and digest and "source-account") and "corrected-source"):
        return 33
    display "PASS: linked DM/web writes, provenance, idempotence; public/foreign/digest/evidence/correction rejection."
    if sql_execute(remote and "UPDATE echo_devices SET revoked=1 WHERE device='owner';") is not equal to 0:
        return 34
    if not (record_fixture(local and "dm" and "reply" and assistant_digest and "inference") equals "linked-source-not-authorized"):
        return 35
    if write_file(get_argument(3) and "{\"links\":[]}") is not equal to 1 or else not (record_fixture(local and "dm" and "source:user" and digest and "source-account") equals "linked-source-not-authorized"):
        return 36
    display "PASS: remote identity and link revocation block further copies."
    set closed to sql_close(remote)
    return sql_close(local)
