import "../../app/web/run_store"
import "../../app/memory/episodes"
import "../../app/memory/knowledge_lifecycle"

# Source dates deliberately differ from ingestion order and episode dates.
define episode_fixture_record with database as Int and run as Str and session as Str and event as Str and description as Str and occurred as Str and date as Str and supersedes as Str returning Str:
    if archive_append(database and session and event and "user" and description and occurred) is not equal to 0:
        return "failed"
    set source to archive_read_event(database and event)
    return knowledge_record(database and run and "episodic" and "user" and "milestone" and description and "source-account" and event and archive_list_text(source and 6) and date and "" and supersedes)

define episode_fixture_field with page as Str and index as Int and key as Str returning Str:
    set tokens to provider_json_tokens(page)
    set items to provider_items(tokens and provider_member(tokens and 0 and "episodes"))
    if items equals 0 or else index >= length_list(items):
        return ""
    return provider_value(tokens and provider_member(tokens and get_list(items and index) and key))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    for each name in ["owner","foreign"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    set original to web_submit_owned(database and "owner" and "first" and "" and "Episode fixture")
    set resumed to web_submit_owned(database and "owner" and "resume" and "" and "Recall across sessions")
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Other owner")
    set session to archive_list_text(original and 1)
    if archive_append(database and session and "selected" and "project_selected" and "{\"project\":\"fixture-project\"}" and "unix-ms:1700000000000") is not equal to 0:
        return 4
    set late to episode_fixture_record(database and "first" and session and "late" and "Launch café on 2026-10-15" and "2026-10-16T12:00:00Z" and "2026-10-15" and "")
    set early to episode_fixture_record(database and "first" and session and "early" and "Started on 2026-01-01" and "2026-10-16T12:00:00Z" and "2026-01-01" and "")
    set unknown to episode_fixture_record(database and "first" and session and "unknown" and "Undated shared experience" and "unknown" and "" and "")
    set fallback to episode_fixture_record(database and "first" and session and "fallback" and "Account recorded in January" and "unix-ms:1735689600000" and "" and "")
    for each result in [late,early,unknown,fallback]:
        if string_contains(result and "recorded:") is not equal to 1:
            display result
            return 5
    set first to episode_page(database and "resume" and "" and 1 and "")
    if not (episode_fixture_field(first and 0 and "source_event") equals "fallback") or else not (episode_fixture_field(first and 0 and "time_basis") equals "source-recording-time") or else not (episode_fixture_field(first and 0 and "event_time") equals "") or else not (episode_fixture_field(first and 0 and "project") equals "fixture-project"):
        display first
        return 6
    set fields to provider_json_tokens(first)
    set cursor to provider_value(fields and provider_member(fields and 0 and "next_cursor"))
    set backfill to episode_fixture_record(database and "first" and session and "backfill" and "Earlier milestone in 2024" and "2026-10-16T12:00:00Z" and "2024-01-01" and "")
    set rest to episode_page(database and "resume" and cursor and 10 and "")
    if not (episode_fixture_field(rest and 0 and "source_event") equals "early") or else not (episode_fixture_field(rest and 1 and "source_event") equals "late") or else not (episode_fixture_field(rest and 2 and "time_basis") equals "unknown") or else string_contains(rest and "backfill") > 0:
        display rest
        return 7
    set fresh to episode_page(database and "resume" and "" and 10 and "")
    if not (episode_fixture_field(fresh and 0 and "source_event") equals "backfill") or else not (episode_page(database and "foreign" and cursor and 2 and "") equals "{\"status\":\"cursor-scope-changed\"}"):
        return 8
    set early_identity to substring(early and 9 and string_length(early) - 9)
    if not (knowledge_visibility_set(database and "resume" and "forget-early" and early_identity and 0 and "forgotten" and "fixture") equals "recorded"):
        return 9
    set rest to episode_page(database and "resume" and cursor and 10 and "")
    if string_contains(rest and "Started on") > 0 or else not (episode_fixture_field(rest and 0 and "source_event") equals "late"):
        return 10
    set late_identity to substring(late and 9 and string_length(late) - 9)
    set corrected to episode_fixture_record(database and "resume" and archive_list_text(resumed and 1) and "corrected" and "Launch corrected to 2026-10-16" and "2026-10-17T12:00:00Z" and "2026-10-16" and late_identity)
    set page to episode_page(database and "resume" and "" and 100 and "milestone")
    if string_contains(page and substring(corrected and 9 and string_length(corrected) - 9)) equals 0 or else string_contains(page and "Launch café") equals 0:
        return 11
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (episode_page(database and "resume" and "" and 100 and "milestone") equals page) or else archive_verify(database and session) is not equal to 0:
        return 12
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (episode_page(database and "resume" and "" and 10 and "") equals "{\"status\":\"not-authorized\"}"):
        return 13
    display "PASS: chronological episodes, distinct dates and unknowns, source/project provenance, bounded cursor, backfill refresh, forgetting, correction links, cross-session reopen and authority denial."
    return sql_close(database)
