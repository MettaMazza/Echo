import "../../app/archive/snapshot"
import "../../app/agent/runner"
import "../../app/security/group_session_selection"
import "../../app/memory/context_snapshot"
import "../../app/discord/cancel_control"

# Isolated synthetic shared audience; real local model and ordinary tool loop.
# No Discord REST delivery, production database or external tool is invoked.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "fixture" and "fixture" and "fixture-secret") is not equal to 0 or else not (group_create(database and "fixture" and "fixture-group" and "discord" and "fixture-server" and "fixture-room" and "fixture-origin") equals "created"):
        return 3
    set journal_path to concat(get_argument(1) and ".journal")
    set journal to discord_store_open(journal_path and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0:
        return 4
    set closed to sql_close(journal)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set cancellation to socket_cancellation_create(library)
    set stop to socket_cancellation_create(library)
    set completed to channel
    set monitor_path to concat(journal_path and "")
    set stop_path to concat(journal_path and ".stop")
    spawn discord_turn_monitor(monitor_path and "900" and 0 and "100" and "300" and "200" and stop_path and get_list(stop and 0) and get_list(cancellation and 1) and completed)
    set first to group_route_submit(database and "fixture" and "fixture-group" and "discord" and "fixture-server" and "fixture-room" and "record" and "Synthetic qualification: the fictional marker is willow-comet-527 dated 2026-10-21. Record a task checklist, use memory_read on record:user, and use its exact digest with memory_record to save that marker and date. Report the actual tool result.")
    if not (archive_list_text(first and 0) equals "accepted") or else not (agent_loop(database and "record" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and get_list(cancellation and 0) and 65536) equals "completed"):
        return 5
    set base to memory_context_stable(database and "record")
    set saved to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='tool_result' AND json_extract(payload,'$.result.status')='recorded';"))
    if string_to_int(archive_list_text(saved and 1)) < 1:
        return 6
    set next to group_route_submit(database and "fixture" and "fixture-group" and "discord" and "fixture-server" and "fixture-room" and "recall" and "Which fictional marker and date did we just record? Reply in one sentence without creating a new record.")
    if not (archive_list_text(next and 0) equals "accepted") or else not (agent_loop(database and "recall" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and get_list(cancellation and 0) and 65536) equals "completed"):
        return 7
    set state to agent_run_read(database and "recall")
    set final to archive_read_event(database and archive_list_text(state and 3))
    set content to memory_source_text(final)
    if string_contains(content and "willow-comet-527") equals 0 or else string_contains(content and "2026-10-21") equals 0 or else not (memory_context_stable(database and "recall") equals base):
        display content
        return 8
    set next to group_route_submit(database and "fixture" and "fixture-group" and "discord" and "fixture-server" and "fixture-room" and "unrelated" and "What is 24 plus 19? Reply only with the number; no tools needed.")
    if not (archive_list_text(next and 0) equals "accepted") or else not (agent_loop(database and "unrelated" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and get_list(cancellation and 0) and 65536) equals "completed"):
        return 9
    set state to agent_run_read(database and "unrelated")
    set final to archive_read_event(database and archive_list_text(state and 3))
    if not (memory_source_text(final) equals "43") or else not (memory_context_stable(database and "unrelated") equals base):
        return 10
    set closed to net_close(get_list(stop and 1))
    set monitored to receive from completed
    if monitored is not equal to 0 or else archive_verify_all(database) is not equal to 0:
        return 11
    set closed to net_close(get_list(cancellation and 0))
    set closed to ep_dlclose(library)
    display "PASS: actual model tool recording, recall and unrelated turn with production Discord monitor and memory preparation; stable shared base and complete archive integrity."
    return sql_close(database)
