import "../../app/memory/context_snapshot"

# Read-only diagnostic against an operator-created private database copy.
# No model, tools, Discord transport or archive mutation is performed.
define main returning Int:
    if get_argument_count() is not equal to 3 or else not file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set count to 0
    repeat while count < 20:
        set records to group_memory_records(database and get_argument(2))
        set tokens to provider_json_tokens(records)
        if tokens equals 0 or else not (provider_kind(tokens and 0) equals "["):
            display concat("Invalid records at iteration " and int_to_string(count))
            display concat("Record bytes: " and int_to_string(string_length(records)))
            return 3
        set count to count + 1
    display "PASS: twenty fresh shared-record reads returned JSON arrays from the saved archive; no inference or delivery occurred."
    return sql_close(database)
