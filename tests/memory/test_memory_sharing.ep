import "../../app/web/routes"
import "../../app/security/group_runs"
import "../../app/jobs/delegation_schema"
import "../../app/archive/snapshot"
import "../../app/memory/archive_recall"

define sharing_route with config as List and target as Str and body as Str and credential as Str and origin as Str returning List:
    set listener to local_socket_listen(0)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    set wire to concat("POST " and concat(target and " HTTP/1.1\r\nHost: 127.0.0.1:8123\r\nOrigin: ORIGIN\r\nX-Echo-Token: CREDENTIAL\r\nContent-Type: application/json\r\nContent-Length: "))
    set wire to ptr_to_str(string_replace(wire and "ORIGIN" and origin))
    set wire to ptr_to_str(string_replace(wire and "CREDENTIAL" and credential))
    set wire to concat(wire and concat(int_to_string(string_length(body)) and concat("\r\n\r\n" and body)))
    set sent to socket_write_all(get_list(listener and 0) and client and -1 and str_to_ptr(wire) and string_length(wire))
    set reader to http_stream_create(get_list(listener and 0) and accepted and -1)
    set request to http_stream_head(reader)
    set reply to web_route(reader and request and 8123 and config)
    set closed to http_stream_release(reader)
    set closed to net_close(accepted)
    set closed to net_close(client)
    set closed to local_socket_close(listener)
    return reply

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each name in ["a","b","c"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set private to web_submit_owned(database and "a" and "private" and "" and "Private source must stay private.")
    if not (group_session_create(database and "a" and "s3" and "g" and "discord" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "b" and "group-run" and "s3" and "discord" and "server" and "room" and "On 2026-03-12 our shared milestone was amber-group-741.") equals "accepted"):
        return 5
    set state to agent_run_read(database and "group-run")
    set source_event to archive_list_text(state and 1)
    set source to archive_read_event(database and source_event)
    set digest to archive_list_text(source and 6)


    set source to archive_read_event(database and "private:user")
    set source_digest to archive_list_text(source and 6)
    set preview to memory_share_preview(database and "a" and "private:user" and "s3")
    set tokens to provider_json_tokens(preview)
    set review to provider_value(tokens and provider_member(tokens and 0 and "review_digest"))
    if string_length(review) is not equal to 64 or else string_contains(preview and "Private source must stay private.") equals 0 or else string_contains(preview and source_digest) equals 0:
        display preview
        return 6
    if string_contains(memory_share_preview(database and "b" and "private:user" and "s3") and "not-authorized") equals 0 or else not (memory_share_commit(database and "b" and "foreign" and "private:user" and "s3" and review) equals "not-authorized"):
        return 7
    if not (memory_share_commit(database and "a" and "wrong-review" and "private:user" and "s3" and ep_sha256("different")) equals "review-changed"):
        return 8
    if not (memory_share_commit(database and "a" and "selected-copy" and "private:user" and "s3" and review) equals "recorded") or else not (memory_share_commit(database and "a" and "selected-copy" and "private:user" and "s3" and review) equals "already-recorded"):
        return 9
    set transcript to web_session_transcript_window(database and "s3" and 0 and 1)
    if string_contains(transcript and "shared-source:selected-copy") equals 0 or else string_contains(transcript and "\"role\":\"source\"") equals 0 or else string_contains(transcript and "Private source must stay private.") equals 0:
        display transcript
        return 31
    set page to provider_json_tokens(transcript)
    set earlier to web_session_transcript_window(database and "s3" and string_to_int(provider_value(page and provider_member(page and 0 and "next_before"))) and 1)
    if string_contains(earlier and "shared-source:selected-copy") is not equal to 0 or else string_contains(earlier and "amber-group-741") equals 0:
        display earlier
        return 32
    set copied to archive_read_event(database and "shared-source:selected-copy")
    set payload to provider_json_tokens(archive_list_text(copied and 3))
    if not (archive_list_text(copied and 0) equals "s3") or else not (provider_value(payload and provider_member(payload and 0 and "content")) equals archive_list_text(source and 3)) or else not (provider_value(payload and provider_member(payload and 0 and "source_digest")) equals source_digest):
        return 10
    set remembered to knowledge_record(database and "group-run" and "semantic" and "shared source" and "selection" and "Private source must stay private." and "source-account" and "shared-source:selected-copy" and archive_list_text(copied and 6) and "" and "" and "")
    if string_contains(remembered and "recorded:") is not equal to 1:
        return 20
    set mine to web_submit_owned(database and "b" and "private-b" and "" and "My private library")
    set destination to archive_list_text(mine and 1)
    set preview to memory_share_preview(database and "b" and "shared-source:selected-copy" and destination)
    set fields to provider_json_tokens(preview)
    set review_b to provider_value(fields and provider_member(fields and 0 and "review_digest"))
    if not (memory_share_commit(database and "b" and "saved-to-own-library" and "shared-source:selected-copy" and destination and review_b) equals "recorded"):
        display preview
        return 11
    if not (archive_list_text(memory_archive_read(database and "private-b" and "shared-source:saved-to-own-library" and 0 and 10000) and 0) equals "found") or else not (archive_list_text(memory_archive_read(database and "private" and "shared-source:saved-to-own-library" and 0 and 10000) and 0) equals "end"):
        return 12
    set confirmed to provider_json_tokens(concat("{\"action\":\"commit\",\"source_event\":\"private:user\",\"destination\":\"s3\",\"identity\":\"selected-copy\",\"review_digest\":" and concat(provider_quote(review) and "}")))
    if string_contains(web_memory_share(database and "a" and confirmed) and "already-recorded") equals 0:
        return 13
    if archive_append(database and archive_list_text(source and 0) and "echo-original" and "assistant_final" and "{\"content\":\"I believe the distant lamp is green.\"}" and "2026-10-17") is not equal to 0:
        return 21
    set echo_preview to provider_json_tokens(memory_share_preview(database and "a" and "echo-original" and "s3"))
    if not (memory_share_commit(database and "a" and "echo-copy" and "echo-original" and "s3" and provider_value(echo_preview and provider_member(echo_preview and 0 and "review_digest"))) equals "recorded"):
        return 22
    set echo_copy to archive_read_event(database and "shared-source:echo-copy")
    if not (knowledge_record(database and "group-run" and "semantic" and "lamp" and "colour" and "green" and "source-account" and "shared-source:echo-copy" and archive_list_text(echo_copy and 6) and "" and "" and "") equals "evidence-kind-mismatch"):
        return 23
    set copy_preview to provider_json_tokens(memory_share_preview(database and "b" and "shared-source:echo-copy" and destination))
    if not (memory_share_commit(database and "b" and "echo-private-copy" and "shared-source:echo-copy" and destination and provider_value(copy_preview and provider_member(copy_preview and 0 and "review_digest"))) equals "recorded"):
        return 24
    set copy to archive_read_event(database and "shared-source:echo-private-copy")
    if not (knowledge_record(database and "private-b" and "semantic" and "lamp" and "colour" and "green" and "source-account" and "shared-source:echo-private-copy" and archive_list_text(copy and 6) and "" and "" and "") equals "evidence-kind-mismatch") or else string_contains(knowledge_record(database and "private-b" and "semantic" and "lamp" and "colour" and "green" and "inference" and "shared-source:echo-private-copy" and archive_list_text(copy and 6) and "" and "" and "") and "recorded:") is not equal to 1:
        return 25
    set config to create_list()
    set added to append_list(config and get_argument(1))
    set added to append_list(config and "fixture")
    set added to append_list(config and 8080)
    set added to append_list(config and 2048)
    set added to append_list(config and 65536)
    set preview_body to "{\"action\":\"preview\",\"source_event\":\"private:user\",\"destination\":\"s3\"}"
    set http_preview to sharing_route(config and "/api/memory-share" and preview_body and "a-secret" and "http://127.0.0.1:8123")
    if not (archive_list_text(http_preview and 0) equals "200 OK") or else string_contains(archive_list_text(http_preview and 1) and "destination_audience") equals 0:
        display archive_list_text(http_preview and 1)
        return 17
    set foreign to sharing_route(config and "/api/memory-share" and preview_body and "b-secret" and "http://127.0.0.1:8123")
    set cross_origin to sharing_route(config and "/api/memory-share" and preview_body and "a-secret" and "https://foreign.example")
    if not (archive_list_text(foreign and 0) equals "403 Forbidden") or else not (archive_list_text(cross_origin and 0) equals "403 Forbidden"):
        return 18
    set commit_body to concat("{\"action\":\"commit\",\"source_event\":\"private:user\",\"destination\":\"s3\",\"identity\":\"http-copy\",\"review_digest\":" and concat(provider_quote(review) and "}"))
    set http_commit to sharing_route(config and "/api/memory-share" and commit_body and "a-secret" and "http://127.0.0.1:8123")
    if not (archive_list_text(http_commit and 0) equals "200 OK") or else string_contains(archive_list_text(http_commit and 1) and "recorded") equals 0:
        display archive_list_text(http_commit and 1)
        return 19
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if archive_verify_all(database) is not equal to 0 or else not (archive_list_text(archive_read_event(database and "private:user") and 6) equals source_digest):
        return 14
    if not (group_change(database and "a" and "invite-c" and "g" and "device:c" and "invited" and 3) equals "recorded") or else not (memory_share_commit(database and "a" and "stale-audience" and "private:user" and "s3" and review) equals "not-authorized"):
        return 15
    if not (group_session_create(database and "a" and "s4" and "g" and "discord" and "server" and "room" and 4) equals "created") or else not (memory_share_commit(database and "a" and "changed-destination" and "private:user" and "s4" and review) equals "review-changed"):
        return 16
    display "PASS: explicit private-to-group and group-to-private selected copies, exact review binding, foreign denial, idempotence, unchanged originals, provenance, private recall, reopen integrity and audience-change rejection. Authenticated native HTTP preview/commit, foreign-source and cross-origin denial passed; browser UI acceptance remains."
    return sql_close(database)
