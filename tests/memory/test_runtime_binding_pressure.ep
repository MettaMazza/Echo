import "../../app/web/attachments"
import "../../app/context/runtime_binding"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "run" and "" and "Check runtime binding")
    set expected to echo_runtime_binding(database and "run")
    set iteration to 0
    repeat while iteration < 2000:
        set actual to echo_runtime_binding(database and "run")
        if not (actual equals expected):
            return 4
        set expression to memory_runtime_status_sql("e" and "?3")
        if string_contains(expression and "identity") equals 0:
            return 5
        set iteration to iteration + 1
    display "PASS: 2000 repeated runtime bindings and capability expressions remain stable under allocation pressure."
    return sql_close(database)
