import "../../app/memory/procedures"
import "../../app/context/session_messages"

# Read an isolated completed fixture under a supplied runtime build identity.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set result to procedure_read(database and get_argument(2) and get_argument(3) and session_tool_schemas_owned(database and get_argument(2)))
    set tokens to provider_json_tokens(result)
    if not (provider_value(tokens and provider_member(tokens and 0 and "assessment")) equals get_argument(4)):
        display result
        return 3
    display concat("PASS: procedure reassessment is " and get_argument(4))
    return sql_close(database)
