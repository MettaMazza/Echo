import "../../app/web/run_store"
import "../../app/memory/automatic_context"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "The observatory is named copper-orchard-812.")
    set source to archive_read_event(database and "first:user")
    set recorded to knowledge_record(database and "first" and "semantic" and "observatory" and "name" and "copper-orchard-812" and "source-account" and "first:user" and archive_list_text(source and 6) and "2026-02-03" and "" and "")
    set identity to substring(recorded and 9 and string_length(recorded) - 9)
    set changed to web_submit_owned(database and "owner" and "changed" and "" and "Correction: the observatory is now named silver-harbour-926.")
    set source to archive_read_event(database and "changed:user")
    set correction to knowledge_record(database and "changed" and "semantic" and "observatory" and "name" and "silver-harbour-926" and "source-account" and "changed:user" and archive_list_text(source and 6) and "2026-04-09" and "" and identity)
    if string_contains(correction and "recorded:") is not equal to 1:
        display correction
        return 4
    set current to web_submit_owned(database and "owner" and "current" and "" and "What is the current observatory name?")
    set outsider to web_submit_owned(database and "foreign" and "foreign" and "" and "What do you remember?")
    # Check canonical recall candidates, whose IDs/dates are preserved. The
    # compact prompt intentionally factors IDs out and retains correction
    # history separately; it is no longer the old full-claim JSON interface.
    set recalled to memory_recall_claims(database and "current")
    if string_contains(recalled and "silver-harbour-926") equals 0 or else string_contains(recalled and "copper-orchard-812") > 0 or else string_contains(recalled and "2026-04-09") equals 0 or else string_contains(recalled and identity) equals 0 or else string_contains(memory_recall_claims(database and "foreign") and "silver-harbour-926") > 0:
        return 5
    set historical to knowledge_next(database and "current" and "copper-orchard-812" and 0)
    if not (archive_list_text(historical and 14) equals substring(correction and 9 and string_length(correction) - 9)):
        return 6
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (memory_recall_claims(database and "current") equals recalled):
        return 7
    set correction_identity to substring(correction and 9 and string_length(correction) - 9)
    if not (knowledge_visibility_set(database and "current" and "forget" and correction_identity and 0 and "forgotten" and "User withdrew the derived fact") equals "recorded"):
        return 8
    set forgotten to memory_recall_claims(database and "current")
    if string_contains(forgotten and "silver-harbour-926") > 0 or else string_contains(forgotten and "copper-orchard-812") > 0:
        return 9
    if not (knowledge_visibility_set(database and "current" and "restore" and correction_identity and 1 and "visible" and "Restore derived recall") equals "recorded") or else not (memory_recall_claims(database and "current") equals recalled):
        return 10
    if archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(changed and 1)) is not equal to 0:
        return 11
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (memory_recall_claims(database and "current") equals "[]"):
        return 12
    display "PASS: current recall uses the corrected fact and date, links original history, excludes foreign memory, survives reopen, forgets without resurrecting superseded facts, restores explicitly and respects revocation."
    return sql_close(database)
