import "../../app/web/run_store"
import "../../app/jobs/delegation_schema"
import "../../app/memory/procedures"
import "../../app/web/attachment_visibility"

# An isolated observed-ledger fixture verifies persistence and proof checks.
# Actual dispatcher/model acceptance is separate from this storage regression.
define procedure_fixture_event with database as Int and session as Str and event as Str and kind as Str and payload as Str returning Int:
    return archive_append(database and session and event and kind and payload and "2026-10-17T00:00:00Z")

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "Demonstrate a read")
    set next to web_submit_owned(database and "owner" and "next" and "" and "Recall a workflow")
    set foreign to web_submit_owned(database and "foreign" and "foreign" and "" and "Other owner")
    set session to archive_list_text(first and 1)
    if write_file(get_argument(2) and "source-canary") is not equal to 1 or else web_attachment_register(database and "owner" and session and "note" and get_argument(2) and "note.txt" and "text/plain") is not equal to 0:
        return 20
    set schema to "{\"type\":\"function\",\"function\":{\"name\":\"attachment_read_text\",\"description\":\"Read a scoped original\",\"parameters\":{\"type\":\"object\"}}}"
    set schemas to concat("[" and concat(schema and "]"))
    set contract to tool_contract("attachment_read_text" and schema)
    set discovery to concat("{\"run_id\":\"first\",\"call_id\":\"discover\",\"result\":{\"status\":\"found\",\"contract\":" and concat(contract and "}}"))
    if procedure_fixture_event(database and session and "discover-call" and "tool_call" and "{\"run_id\":\"first\",\"call_id\":\"discover\",\"name\":\"tool_search\",\"arguments\":\"{}\"}") is not equal to 0 or else tool_ledger_queue(database and "first" and "discover" and session and "discover-call") is not equal to 0 or else tool_ledger_claim(database and "first" and "discover") is not equal to 0 or else procedure_fixture_event(database and session and "discovery" and "tool_result" and discovery) is not equal to 0 or else tool_ledger_observe(database and "first" and "discover" and "discovery") is not equal to 0:
        return 4
    if procedure_fixture_event(database and session and "read-call" and "tool_call" and "{\"run_id\":\"first\",\"call_id\":\"read\",\"name\":\"attachment_read_text\",\"arguments\":\"{\\\"attachment\\\":\\\"note\\\"}\"}") is not equal to 0 or else tool_ledger_queue(database and "first" and "read" and session and "read-call") is not equal to 0 or else tool_ledger_claim(database and "first" and "read") is not equal to 0 or else procedure_fixture_event(database and session and "read-result" and "tool_result" and "{\"run_id\":\"first\",\"call_id\":\"read\",\"result\":{\"status\":\"found\",\"text\":\"source-canary\",\"verified\":true}}") is not equal to 0 or else tool_ledger_observe(database and "first" and "read" and "read-result") is not equal to 0:
        return 5
    set result to archive_read_event(database and "read-result")
    set discovered to archive_read_event(database and "discovery")
    set manifest to concat("{\"name\":\"Read original\",\"purpose\":\"Inspect evidence\",\"prerequisites\":\"Authorized source\",\"failure_lessons\":\"Do not invent absent text\",\"steps\":[{\"action\":\"Read the original record\",\"tool\":\"attachment_read_text\",\"contract_sha256\":" and provider_quote(ep_sha256(contract)))
    set manifest to concat(manifest and concat(",\"result_event\":\"read-result\",\"result_digest\":" and provider_quote(archive_list_text(result and 6))))
    set manifest to concat(manifest and concat(",\"discovery_event\":\"discovery\",\"discovery_digest\":" and provider_quote(archive_list_text(discovered and 6))))
    set manifest to concat(manifest and ",\"checks\":[{\"path\":\"$.result.status\",\"equals\":\"found\"},{\"path\":\"$.result.text\",\"equals\":\"source-canary\"},{\"path\":\"$.result.verified\",\"equals\":true}]}]}")
    if not (procedure_assess(database and "next" and manifest and schemas) equals "demonstrated") or else not (procedure_save(database and "next" and "procedure-1" and manifest and schemas) equals "recorded") or else not (procedure_save(database and "next" and "procedure-1" and manifest and schemas) equals "already-recorded"):
        display procedure_assess(database and "next" and manifest and schemas)
        return 6
    if not (procedure_assess(database and "foreign" and manifest and schemas) equals "evidence-not-authorized"):
        return 7
    set bad to ptr_to_str(string_replace(manifest and "source-canary" and "invented-success"))
    if not (procedure_assess(database and "next" and bad and schemas) equals "expected-outcome-not-demonstrated"):
        return 8
    set bad to ptr_to_str(string_replace(manifest and "\"discovery_event\":\"discovery\"" and "\"discovery_event\":\"missing\""))
    if not (procedure_assess(database and "next" and bad and schemas) equals "tool-version-evidence-required"):
        return 9
    if not (procedure_assess(database and "next" and manifest and "[]") equals "stale-tool"):
        return 10
    set saved to procedure_read(database and "next" and "procedure-1" and schemas)
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (procedure_read(database and "next" and "procedure-1" and schemas) equals saved) or else archive_verify(database and session) is not equal to 0 or else archive_verify(database and archive_list_text(next and 1)) is not equal to 0:
        return 11
    set exclusion to provider_json_tokens("{\"action\":\"exclude\",\"attachment\":\"note\",\"identity\":\"exclude\",\"previous\":\"\"}")
    if not (web_attachment_visibility(database and "owner" and exclusion) equals "recorded") or else not (procedure_read(database and "next" and "procedure-1" and schemas) equals "{\"status\":\"source-excluded-from-context\"}") or else not (procedure_search(database and "next" and "" and 0 and schemas) equals "{\"status\":\"end\"}"):
        return 21
    if not (procedure_save(database and "next" and "excluded-copy" and manifest and schemas) equals "source-excluded-from-context"):
        return 22
    set restore to provider_json_tokens("{\"action\":\"restore\",\"attachment\":\"note\",\"identity\":\"restore\",\"previous\":\"attachment-visibility:owner:exclude\"}")
    if not (web_attachment_visibility(database and "owner" and restore) equals "recorded") or else not (procedure_read(database and "next" and "procedure-1" and schemas) equals saved):
        return 23
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (procedure_read(database and "next" and "procedure-1" and schemas) equals "{\"status\":\"not-authorized\"}"):
        return 12
    display "PASS: procedure read/search/save exclude attachment-derived expected outcomes, restoration reproduces the original procedure, source authority and archive checks remain intact."
    return sql_close(database)
