import "../../app/agent/runner"
import "../../app/jobs/delegation_schema"
import "../../app/memory/automatic_context"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["owner","foreign"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "owner" and "first" and "" and "The observatory is named copper-orchard-812.")
    set source to archive_read_event(database and "first:user")
    set recorded to knowledge_record(database and "first" and "semantic" and "observatory" and "name" and "copper-orchard-812" and "source-account" and "first:user" and archive_list_text(source and 6) and "2026-02-03" and "" and "")
    set identity to substring(recorded and 9 and string_length(recorded) - 9)
    set changed to web_submit_owned(database and "owner" and "changed" and "" and "Correction: the observatory is now named silver-harbour-926.")
    set source to archive_read_event(database and "changed:user")
    set correction to knowledge_record(database and "changed" and "semantic" and "observatory" and "name" and "silver-harbour-926" and "source-account" and "changed:user" and archive_list_text(source and 6) and "2026-04-09" and "" and identity)
    if string_contains(correction and "recorded:") is not equal to 1:
        display correction
        return 4
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set current to web_submit_owned(database and "owner" and "current" and "" and "Use memory_graph with node observatory to follow the correction chain. Read both records. Return only the current observatory name, its event/valid-from date and its exact source event ID. Do not treat source-recording time as the event date.")
    if not (agent_loop(database and "current" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 5
    set state to agent_run_read(database and "current")
    set final to archive_read_event(database and archive_list_text(state and 3))
    set content to memory_source_text(final)
    if string_contains(content and "silver-harbour-926") equals 0 or else string_contains(content and "2026-04-09") equals 0 or else string_contains(content and "changed:user") equals 0:
        display content
        return 6
    set failures to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='memory_failure';"))
    if string_to_int(archive_list_text(failures and 1)) > 0 or else length_list(memory_pending(database and "current")) > 0:
        return 8
    set calls to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='tool_call' AND json_extract(payload,'$.name')='memory_graph';"))
    if string_to_int(archive_list_text(calls and 1)) < 2 or else archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(changed and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(current and 1)) is not equal to 0:
        return 7
    display "PASS: actual model followed the source-backed graph correction chain in a new session after reopen and returned the current fact, date and original source ID."
    return sql_close(database)
