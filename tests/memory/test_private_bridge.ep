import "../fixtures/memory_tool_fixture"
import "../../app/memory/private_bridge"
import "../../app/security/channel_silo"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set local to archive_open(get_argument(1))
    set remote to archive_open(get_argument(2))
    for each database in [local,remote]:
        if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
            return 2
        if web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
            return 20
        for each device in ["owner","other"]:
            if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
                return 3
    set source to web_submit_owned(remote and "owner" and "source" and "" and "A🌺BCDEF")
    set secret to web_submit_owned(remote and "other" and "secret" and "" and "Other user's private marker")
    set dm to channel_silo_submit(local and "owner" and "discord" and "dm:bot" and "dm" and "dm" and "Recall my web history" and create_list())
    set public to channel_silo_submit(local and "owner" and "discord" and "server" and "general" and "public" and "Recall my web history" and create_list())
    set foreign to channel_silo_submit(local and "other" and "discord" and "dm:bot" and "dm-other" and "foreign" and "Recall web history" and create_list())
    set web to web_submit_owned(local and "owner" and "web" and "" and "Recall linked")
    for each row in [source,secret,dm,public,foreign,web]:
        if not (archive_list_text(row and 0) equals "accepted"):
            return 4
    set config to concat("{\"links\":[{\"enabled\":true,\"local_database\":" and provider_quote(get_argument(1)))
    set config to concat(config and concat(",\"remote_database\":" and provider_quote(get_argument(2))))
    set config to concat(config and ",\"local_principals\":[\"device:owner\"],\"remote_principals\":[\"device:owner\"]}]}")
    if write_file(get_argument(3) and config) is not equal to 1:
        return 5
    if not (private_bridge_identity(local and "dm") equals "device:owner") or else string_length(private_bridge_identity(local and "public")) > 0:
        return 6
    set sessions to private_bridge_read(local and "dm" and "memory_sessions" and "{\"archive\":\"linked\",\"after\":0}")
    if not string_contains(sessions and archive_list_text(source and 1)) or else string_contains(sessions and archive_list_text(secret and 1)):
        display sessions
        return 7
    if not string_contains(private_bridge_read(local and "public" and "memory_sessions" and "{\"archive\":\"linked\"}") and "linked-archive-not-authorized") or else not string_contains(private_bridge_read(local and "foreign" and "memory_sessions" and "{\"archive\":\"linked\"}") and "linked-archive-not-authorized"):
        return 8
    set args to concat("{\"archive\":\"linked\",\"session\":" and concat(provider_quote(archive_list_text(source and 1)) and ",\"after\":0,\"characters\":3}"))
    set page to private_bridge_read(local and "dm" and "memory_messages" and args)
    if not string_contains(page and "A🌺B") or else string_contains(page and "CDEF") or else not string_contains(page and "\"complete\":false"):
        display page
        return 9
    set fields to provider_json_tokens(page)
    set next to agent_json_source(page and fields and provider_member(fields and 0 and "next"))
    set page to private_bridge_read(local and "web" and "memory_messages" and next)
    if not string_contains(page and "CDE") or else string_contains(page and "A🌺B"):
        display page
        return 10
    set fields to provider_json_tokens(page)
    set next to agent_json_source(page and fields and provider_member(fields and 0 and "next"))
    set page to private_bridge_read(local and "dm" and "memory_messages" and next)
    if not string_contains(page and "\"text\":\"F\"") or else not string_contains(page and "\"complete\":true"):
        display page
        return 11
    set remote_dm to channel_silo_submit(remote and "owner" and "discord" and "dm:bot" and "remote-dm" and "remote-dm" and "Owned DM original" and create_list())
    set remote_public to channel_silo_submit(remote and "owner" and "discord" and "server" and "public" and "remote-public" and "Owned public original" and create_list())
    set remote_other to channel_silo_submit(remote and "other" and "discord" and "dm:bot" and "remote-other" and "remote-other" and "Foreign DM original" and create_list())
    set sessions to private_bridge_read(local and "web" and "memory_sessions" and "{\"archive\":\"linked\",\"after\":0}")
    if not string_contains(sessions and archive_list_text(remote_dm and 1)) or else not string_contains(sessions and archive_list_text(remote_public and 1)) or else string_contains(sessions and archive_list_text(remote_other and 1)):
        display sessions
        return 21
    set schemas to session_tool_schemas_owned(local and "web")
    if not string_contains(schemas and "Select your explicitly linked private archive") or else string_contains(session_tool_schemas_owned(local and "public") and "Select your explicitly linked private archive"):
        return 22
    if recall_fixture_call(local and "web" and "linked-request" and "linked-call" and "memory_messages" and args) is not equal to 0:
        return 23
    set observed to history_collect_one(archive_prepare(local and "SELECT json_extract(e.payload,'$.result.records[0].text') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='linked-call' AND t.state='observed';"))
    if not (archive_list_text(observed and 1) equals "A🌺B"):
        display observed
        return 24
    set opened to private_bridge_open(local and "dm")
    if length_list(opened) is not equal to 3:
        return 12
    set handle to get_list(opened and 0)
    if sql_execute(handle and "CREATE TABLE unauthorized_write(x);") equals 0:
        return 13
    set closed to sql_close(handle)
    if sql_execute(remote and "UPDATE echo_devices SET revoked=1 WHERE device='owner';") is not equal to 0:
        return 14
    set page to private_bridge_read(local and "dm" and "memory_messages" and args)
    if string_contains(page and "A🌺B"):
        return 15
    if write_file(get_argument(3) and "{\"links\":[]}") is not equal to 1 or else not string_contains(private_bridge_read(local and "dm" and "memory_sessions" and "{\"archive\":\"linked\"}") and "linked-archive-not-authorized"):
        return 16
    display "PASS: explicit owner link, public/foreign denial, web and DM readers, Unicode continuation, read-only archive, device and config revocation."
    set closed to sql_close(remote)
    return sql_close(local)
