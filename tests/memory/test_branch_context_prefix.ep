import "../../app/archive/snapshot"
import "../../app/memory/context_snapshot"
import "../../app/memory/automatic"
import "../../app/memory/automatic_context"
import "../../app/memory/episodes"
import "../../app/memory/knowledge_lifecycle"
import "../../app/security/group_session_selection"
import "../../app/security/group_branches"
import "../../app/web/run_store"
import "../fixtures/delegation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    if string_length(group_memory_selected_context("")) > 0 or else string_length(group_memory_selected_context("{\"records\":}")) > 0 or else string_length(group_memory_selected_context("{}")) > 0:
        return 52
    if string_contains(group_memory_selected_context("[]") and "Memories: []") is not equal to 1:
        return 53
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    for each name in ["a","b"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set original to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "old-run" and "On 2026-03-12 the milestone was amber-cross-741.")
    if not (archive_list_text(original and 0) equals "accepted"):
        return 5
    set old_session to archive_list_text(original and 1)
    set state to agent_run_read(database and "old-run")
    set event to archive_list_text(state and 1)
    set source to archive_read_event(database and event)
    set digest to archive_list_text(source and 6)
    set claim to knowledge_record(database and "old-run" and "episodic" and "device:a" and "milestone" and "amber-cross-741" and "source-account" and event and digest and "2026-03-12" and "" and "")
    if string_contains(claim and "recorded:") is not equal to 1:
        return 6
    # A child shares its recorded audience but must not become automatic memory
    # for its parent or sibling. The ordinary delegation path constructs it.
    if delegation_fixture_request(database and "old-run" and old_session and "child" and "{\"instruction\":\"Isolated child marker cedar-child-94.\"}") is not equal to 0 or else not (delegation_materialize(database and "old-run" and "child") equals "materialized"):
        return 7
    set child_run to "old-run:delegate:child"
    set child to agent_run_read(database and child_run)
    set child_event to archive_list_text(child and 1)
    set child_source to archive_read_event(database and child_event)
    set child_digest to archive_list_text(child_source and 6)
    if group_memory_source_allowed(database and child_run and event and digest) is not equal to 0:
        return 8
    set child_claim to knowledge_record(database and child_run and "episodic" and "child" and "milestone" and "cedar-child-94" and "source-account" and child_event and child_digest and "" and "" and "")
    if string_contains(child_claim and "recorded:") is not equal to 1:
        return 9
    if agent_cancel_run(database and "old-run") is not equal to 0:
        return 10
    set next to group_session_restart(database and "a" and "new-conversation" and "g" and "discord" and "server" and "room" and 1)
    if not (archive_list_text(next and 0) equals "created"):
        return 11
    set submitted to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "recall" and "Recall our milestone.")
    if not (archive_list_text(submitted and 0) equals "accepted") or else archive_list_text(submitted and 1) equals old_session:
        return 12
    if group_run_session_allows(database and "recall" and old_session) is not equal to 0 or else group_memory_source_allowed(database and "recall" and event and digest) is not equal to 1 or else group_memory_source_allowed(database and "recall" and event and "wrong-digest") is not equal to 0 or else group_memory_source_allowed(database and "recall" and child_event and child_digest) is not equal to 0:
        return 13
    set pending to memory_pending(database and "recall")
    if length_list(pending) is not equal to 1 or else not (archive_list_text(pending and 0) equals event):
        return 14
    set context to memory_context(database and "recall")
    set timeline to episode_page(database and "recall" and "" and 10 and "")
    set graph to knowledge_next(database and "recall" and "" and 0)
    if string_contains(context and "amber-cross-741") equals 0 or else string_contains(timeline and "amber-cross-741") equals 0 or else not (archive_list_text(graph and 0) equals "found"):
        display context
        display timeline
        return 15
    if string_contains(context and "cedar-child-94") is not equal to 0 or else string_contains(timeline and "cedar-child-94") is not equal to 0 or else not (archive_list_text(knowledge_next(database and "recall" and "child" and 0) and 0) equals "end"):
        return 16
    # Same user in another channel/server or DM, and another user in the same
    # channel, have distinct audiences. Private browser history also stays out.
    set private to web_submit_owned(database and "a" and "private" and "" and "Private canary violet-private-19.")
    set private_run to agent_run_read(database and "private")
    set private_source to archive_read_event(database and archive_list_text(private_run and 1))
    if group_memory_source_allowed(database and "recall" and archive_list_text(private_run and 1) and archive_list_text(private_source and 6)) is not equal to 0:
        return 17
    for each item in ["channel","server","dm","person"]:
        set other to ptr_to_str(item)
        set actor to "a"
        set server to "server"
        set room to "room"
        if other equals "person":
            set actor to "b"
        else if other equals "server":
            set server to "other-server"
        else if other equals "dm":
            set server to "dm"
            set room to "private-room"
        else:
            set room to "other-room"
        if not (group_create(database and actor and other and "discord" and server and room and concat("silo:" and other)) equals "created"):
            return 18
        set foreign to group_route_submit(database and actor and other and "discord" and server and room and other and "Other scope canary.")
        if not (archive_list_text(foreign and 0) equals "accepted") or else group_memory_source_allowed(database and other and event and digest) is not equal to 0 or else length_list(memory_pending(database and other)) is not equal to 0 or else string_contains(memory_context(database and other) and "amber-cross-741") is not equal to 0:
            return 19
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (memory_context(database and "recall") equals context) or else length_list(memory_pending(database and "recall")) is not equal to 1:
        return 20
    # Historical malformed receipts remain immutable and must not poison a
    # fresh capture or become an eligible retained base.
    if archive_append(database and archive_list_text(submitted and 1) and "fixture-malformed-snapshot" and "memory_context_snapshot" and "{\"records\":,\"base\":\"MALFORMED-BASE\"}" and "fixture-only") is not equal to 0:
        return 54
    if memory_context_capture(database and "recall") is not equal to 0:
        return 24
    set base to memory_context_stable(database and "recall")
    set recalled_source to archive_read_event(database and "recall:user")
    set new_claim to knowledge_record(database and "recall" and "episodic" and "device:a" and "marker" and "Recall our milestone." and "source-account" and "recall:user" and archive_list_text(recalled_source and 6) and "" and "" and "")
    if string_contains(new_claim and "recorded:") equals 0 or else agent_cancel_run(database and "recall") is not equal to 0:
        return 25
    set newer to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "recall-two" and "Inspect all earlier claims.")
    if not (archive_list_text(newer and 0) equals "accepted") or else memory_context_capture(database and "recall-two") is not equal to 0:
        return 26
    set revision to memory_context_revision(database and "recall-two")
    set delta to memory_context_delta(database and "recall-two" and "recall-two" and revision)
    if not (memory_context_stable(database and "recall-two") equals base) or else string_contains(delta and "Recall our milestone.") equals 0 or else string_contains(delta and "amber-cross-741") is not equal to 0:
        return 27
    if memory_context_capture(database and "recall-two") is not equal to 0 or else not (memory_context_delta(database and "recall-two" and "recall-two" and revision) equals delta):
        return 28
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (memory_context_stable(database and "recall-two") equals base):
        return 29
    if agent_cancel_run(database and "recall-two") is not equal to 0:
        return 40
    set omitted_source to archive_read_event(database and "recall-two:user")
    set omitted_claim to knowledge_record(database and "recall-two" and "episodic" and "device:a" and "omitted" and "Inspect all earlier claims." and "source-account" and "recall-two:user" and archive_list_text(omitted_source and 6) and "" and "" and "")
    if string_contains(omitted_claim and "recorded:") equals 0:
        return 41
    set regenerated to group_revision_submit(database and "a" and "branch-recall" and archive_list_text(newer and 1) and "recall-two:user" and "discord" and "server" and "room" and "regenerate" and "" and "")
    if not (archive_list_text(regenerated and 0) equals "accepted"):
        display archive_list_text(regenerated and 0)
        return 42
    set branch_run to archive_list_text(regenerated and 2)
    if memory_context_capture(database and branch_run) is not equal to 0 or else not (memory_context_stable(database and branch_run) equals base):
        return 43
    set branch_revision to memory_context_revision(database and branch_run)
    set branch_delta to memory_context_delta(database and branch_run and branch_run and branch_revision)
    if string_contains(branch_delta and "Recall our milestone.") equals 0 or else string_contains(branch_delta and "amber-cross-741") > 0 or else string_contains(branch_delta and "Inspect all earlier claims.") > 0:
        display branch_delta
        return 44
    if string_length(memory_context_delta(database and branch_run and "recall-two" and branch_revision)) > 0:
        return 45
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (memory_context_stable(database and branch_run) equals base) or else not (memory_context_delta(database and branch_run and branch_run and branch_revision) equals branch_delta):
        return 46
    # A nested revision retains the earlier delta in its original position.
    if agent_cancel_run(database and branch_run) is not equal to 0 or else not (group_run_submit(database and "a" and "third" and archive_list_text(regenerated and 1) and "discord" and "server" and "room" and "NEXT_BRANCH_QUESTION") equals "accepted") or else agent_cancel_run(database and "third") is not equal to 0:
        return 47
    set nested to group_revision_submit(database and "a" and "nested-recall" and archive_list_text(regenerated and 1) and "third:user" and "discord" and "server" and "room" and "regenerate" and "" and "")
    if not (archive_list_text(nested and 0) equals "accepted"):
        return 48
    set nested_run to archive_list_text(nested and 2)
    if memory_context_capture(database and nested_run) is not equal to 0 or else not (memory_context_stable(database and nested_run) equals base):
        return 49
    set nested_revision to memory_context_revision(database and nested_run)
    if not (memory_context_delta(database and nested_run and branch_run and nested_revision) equals branch_delta) or else string_length(memory_context_delta(database and nested_run and nested_run and nested_revision)) > 0:
        return 50
    # Exercise the real checkpoint switch, with explicitly fixture-only summary.
    set current_session to archive_list_text(newer and 1)
    if checkpoint_schema(database) is not equal to 0 or else checkpoint_stage(database and "fixture-rebase" and current_session and "recall:user" and "" and "Fixture recap." and "{}" and "fixture-only") is not equal to 0 or else checkpoint_activate(database and current_session and "fixture-rebase") is not equal to 0 or else memory_context_capture(database and "recall-two") is not equal to 0:
        return 31
    if memory_context_revision(database and "recall-two") equals revision or else string_contains(memory_context_stable(database and "recall-two") and "Recall our milestone.") equals 0 or else string_contains(memory_context_stable(database and "recall-two") and "amber-cross-741") equals 0:
        return 32
    set revision to memory_context_revision(database and "recall-two")
    if string_length(memory_context_delta(database and "recall-two" and "recall-two" and revision)) is not equal to 0:
        return 33
    set identity to substring(claim and 9 and string_length(claim) - 9)
    if not (knowledge_visibility_set(database and "recall-two" and "forget" and identity and 0 and "forgotten" and "Withdraw milestone") equals "recorded") or else string_contains(memory_context(database and "recall-two") and "amber-cross-741") is not equal to 0:
        return 21
    if memory_context_capture(database and "recall-two") is not equal to 0 or else string_contains(memory_context_stable(database and "recall-two") and "amber-cross-741") is not equal to 0 or else memory_context_revision(database and "recall-two") equals revision:
        return 30
    if memory_context_capture(database and nested_run) is not equal to 0 or else string_contains(memory_context_stable(database and nested_run) and "amber-cross-741") > 0 or else string_length(memory_context_delta(database and nested_run and branch_run and memory_context_revision(database and nested_run))) > 0:
        return 51
    if not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else group_memory_source_allowed(database and "recall-two" and event and digest) is not equal to 0 or else string_length(memory_context(database and "recall-two")) is not equal to 0:
        return 22
    if archive_verify_all(database) is not equal to 0:
        return 23
    display "PASS: inherited branch base, relocated omitted-turn delta, omitted source excluded and reopen durable; stable shared base and exact novel delta, idempotence, reopen, checkpoint rebase and forget rebase; cross-session recall/ingestion, graph and timeline; unchanged ordinary history gate; source digest, child, user, channel, server, DM and private isolation; reopen, forgetting and audience invalidation. No model or Discord UI acceptance claimed."
    return sql_close(database)
