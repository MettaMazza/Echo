import "../../app/archive/snapshot"
import "../../app/memory/automatic_context"
import "../../app/memory/knowledge_lifecycle"
import "../../app/security/group_runs"
import "../../app/security/group_session_selection"
import "../../app/agent/runner"

define main returning Int:
    if (get_argument_count() is not equal to 4 and get_argument_count() is not equal to 5) or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    for each name in ["a","b","c"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set private to web_submit_owned(database and "a" and "private" and "" and "Private source must stay private.")
    if not (group_session_create(database and "a" and "s3" and "g" and "discord" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "b" and "group-run" and "s3" and "discord" and "server" and "room" and "On 2026-03-12 our shared milestone was amber-group-741.") equals "accepted"):
        return 5
    set state to agent_run_read(database and "group-run")
    set source_event to archive_list_text(state and 1)
    set source to archive_read_event(database and source_event)
    set digest to archive_list_text(source and 6)

    set episode to knowledge_record(database and "group-run" and "episodic" and "group" and "milestone" and "amber-group-741" and "source-account" and source_event and digest and "2026-03-12" and "" and "")
    set old to knowledge_record(database and "group-run" and "semantic" and "project" and "name" and "old-harbour-319" and "inference" and source_event and digest and "" and "" and "")
    set corrected to knowledge_record(database and "group-run" and "semantic" and "project" and "name" and "new-harbour-842" and "inference" and source_event and digest and "" and "" and substring(old and 9 and string_length(old) - 9))
    set expired to knowledge_record(database and "group-run" and "semantic" and "project" and "temporary" and "expired-marker-193" and "inference" and source_event and digest and "2020-01-01" and "2020-01-02" and "")
    set forgotten to knowledge_record(database and "group-run" and "semantic" and "project" and "temporary" and "forgotten-marker-627" and "inference" and source_event and digest and "" and "" and "")
    for each saved in [episode,old,corrected,expired,forgotten]:
        if string_contains(saved and "recorded:") is not equal to 1:
            display saved
            return 6
    if not (knowledge_visibility_set(database and "group-run" and "forget-context" and substring(forgotten and 9 and string_length(forgotten) - 9) and 0 and "forgotten" and "Explicit withdrawal") equals "recorded"):
        return 7
    if string_contains(memory_context(database and "group-run") and "amber-group-741") is not equal to 0:
        return 8
    set destination to "s3"
    if get_argument_count() equals 5:
        set next to group_session_restart(database and "a" and "cross-session" and "g" and "discord" and "server" and "room" and 3)
        if not (archive_list_text(next and 0) equals "created"):
            return 24
        set destination to archive_list_text(next and 1)
    if agent_cancel_run(database and "group-run") is not equal to 0 or else not (group_run_submit(database and "a" and "recall" and destination and "discord" and "server" and "room" and "Use memory_timeline to inspect our shared milestone and memory_graph to inspect the project name correction. Reply with the milestone marker, its date, and current project-name marker. Distinguish source accounts from inference; do not invent completed work.") equals "accepted"):
        return 9
    if string_contains(session_tool_schemas_owned(database and "recall") and "memory_timeline") equals 0 or else string_contains(session_tool_schemas_owned(database and "recall") and "memory_graph") equals 0:
        return 19
    set context to memory_context(database and "recall")
    for each present in ["amber-group-741","2026-03-12","new-harbour-842",source_event,digest]:
        if string_contains(context and present) equals 0:
            display context
            return 10
    for each absent in ["old-harbour-319","expired-marker-193","forgotten-marker-627","Private source must stay private."]:
        if string_contains(context and absent) is not equal to 0:
            display context
            return 11
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (memory_context(database and "recall") equals context):
        return 12
    if not (agent_loop(database and "recall" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536) equals "completed"):
        return 13
    set state to agent_run_read(database and "recall")
    set final to archive_read_event(database and archive_list_text(state and 3))
    set answer to memory_source_text(final)
    for each present in ["amber-group-741","2026-03-12","new-harbour-842"]:
        if string_contains(answer and present) equals 0:
            display answer
            return 14
    set calls to history_collect_one(archive_prepare(database and "SELECT count(DISTINCT json_extract(payload,'$.name')) FROM echo_events WHERE kind='tool_call' AND json_extract(payload,'$.run_id')='recall' AND json_extract(payload,'$.name') IN ('memory_timeline','memory_graph');"))
    if not (archive_list_text(calls and 1) equals "2") or else archive_verify_all(database) is not equal to 0:
        return 15
    set current to knowledge_visibility_read(database and "recall" and substring(corrected and 9 and string_length(corrected) - 9))
    if not (knowledge_visibility_set(database and "recall" and "forget-successor" and substring(corrected and 9 and string_length(corrected) - 9) and string_to_int(archive_list_text(current and 2)) and "forgotten" and "Withdraw corrected claim") equals "recorded"):
        return 16
    set context to memory_context(database and "recall")
    if string_contains(context and "old-harbour-319") is not equal to 0 or else string_contains(context and "new-harbour-842") is not equal to 0:
        return 17
    if not (group_change(database and "a" and "invite-c" and "g" and "device:c" and "invited" and 3) equals "recorded") or else string_length(memory_context(database and "recall")) is not equal to 0:
        return 18
    display "PASS: automatic shared recall after reopen; prior-objective boundary, correction, expiry, forgetting and private-source exclusion; actual model used timeline and graph and returned dated markers; forgotten successor did not resurrect old fact; changed audience denied recall."
    if get_argument_count() equals 5:
        display "PASS: repeated in a newly selected conversation with the same audience, without copying its old messages into the new session."
    return sql_close(database)
