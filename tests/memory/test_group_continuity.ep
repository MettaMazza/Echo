import "../fixtures/memory_tool_fixture"
import "../../app/security/group_session_selection"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    for each name in ["a","b"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set original to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "original" and "Shared source.")
    if not (archive_list_text(original and 0) equals "accepted") or else recall_fixture_call(database and "original" and "source-request" and "source-call" and "memory_search" and "{\"query\":\"Shared\",\"after\":0}") is not equal to 0 or else agent_cancel_run(database and "original") is not equal to 0:
        return 5
    set next to group_session_restart(database and "a" and "new" and "g" and "discord" and "server" and "room" and 1)
    set recall to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "recall" and "Inspect earlier reasoning.")
    if not (archive_list_text(next and 0) equals "created") or else not (archive_list_text(recall and 0) equals "accepted"):
        return 6
    set schema to session_tool_schemas_owned(database and "recall")
    if string_contains(schema and "reasoning_read") equals 0 or else string_contains(continuity_shared_schemas() and "scratchpad") is not equal to 0 or else string_contains(continuity_shared_schemas() and "private") is not equal to 0:
        return 7
    if recall_fixture_call(database and "recall" and "sessions-request" and "sessions" and "memory_sessions" and "{\"after\":0}") is not equal to 0:
        return 8
    set row to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.session') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='sessions';"))
    if not (archive_list_text(row and 1) equals archive_list_text(original and 1)):
        return 9
    set arguments to concat("{\"session\":" and concat(provider_quote(archive_list_text(original and 1)) and ",\"after\":0}"))
    if recall_fixture_call(database and "recall" and "messages-request" and "messages" and "memory_messages" and arguments) is not equal to 0:
        return 10
    set row to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.event') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='messages';"))
    if not (archive_list_text(row and 1) equals "original:user"):
        return 11
    set arguments to "{\"event\":\"source-request\",\"offset\":19,\"characters\":6}"
    if recall_fixture_call(database and "recall" and "reason-request" and "reason" and "reasoning_read" and arguments) is not equal to 0:
        return 12
    set row to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.reasoning_text'),json_extract(e.payload,'$.result.event') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='reason';"))
    if not (archive_list_text(row and 1) equals "Café 🌍") or else not (archive_list_text(row and 2) equals "source-request:response"):
        return 13
    # A newer response now exists in recall. Selecting original must still
    # identify original's response and echo the exact requested selector.
    set selected to continuity_execute(database and "recall" and "reasoning_read" and "{\"event\":\"original\",\"offset\":0,\"characters\":200}")
    set fields to provider_json_tokens(selected)
    if not (provider_value(fields and provider_member(fields and 0 and "run")) equals "original") or else not (provider_value(fields and provider_member(fields and 0 and "event")) equals "source-request:response") or else not (provider_value(fields and provider_member(fields and 0 and "requested_id")) equals "original") or else not (provider_value(fields and provider_member(fields and 0 and "parent_event")) equals "source-request") or else not (provider_value(fields and provider_member(fields and 0 and "session")) equals archive_list_text(original and 1)):
        return 20
    set private to web_submit_owned(database and "a" and "private" and "" and "Private source.")
    if recall_fixture_call(database and "private" and "private-request" and "private-call" and "memory_search" and "{\"query\":\"Private\",\"after\":0}") is not equal to 0:
        return 14
    if string_contains(continuity_execute(database and "recall" and "reasoning_read" and "{\"event\":\"private-request\",\"offset\":0,\"characters\":200}") and "not-found") equals 0:
        return 15
    if not (group_create(database and "b" and "other" and "discord" and "server" and "room" and "other") equals "created"):
        return 16
    set other to group_route_submit(database and "b" and "other" and "discord" and "server" and "room" and "other" and "Other audience.")
    if not (archive_list_text(other and 0) equals "accepted") or else string_contains(continuity_execute(database and "other" and "reasoning_read" and arguments) and "not-found") equals 0:
        return 17
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if string_contains(continuity_execute(database and "recall" and "reasoning_read" and arguments) and "Café 🌍") equals 0:
        return 18
    if not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else string_contains(continuity_execute(database and "recall" and "reasoning_read" and arguments) and "not-authorized") equals 0:
        return 19
    display "PASS: queued shared session listing, original-message enumeration and Unicode captured-reasoning reads across sessions; private and other-user denial, reopen, membership invalidation. Reasoning was a labelled streaming fixture, not a real-model introspection claim."
    return sql_close(database)
