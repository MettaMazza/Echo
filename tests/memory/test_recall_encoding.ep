import "../../app/memory/group_context"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set original to ptr_to_str(read_file(get_argument(1)))
    set encoded to group_memory_encoded_records(original)
    if string_length(encoded) equals 0:
        return 2
    print encoded
    return 0
