import "../../app/archive/snapshot"
import "../../app/memory/automatic_context"
import "../../app/security/group_session_selection"
import "../../app/agent/runner"

# Isolate original retrieval from concurrent extraction: real inference and
# production inner loop, with deliberately unindexed prior-session evidence.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "a" and "Fixture" and "secret") is not equal to 0:
        return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set source to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "original" and "Our fictional milestone is maple-comet-628. Its date is 2026-03-19. Its inscription is Café 🌍.")
    if not (archive_list_text(source and 0) equals "accepted") or else agent_cancel_run(database and "original") is not equal to 0:
        return 5
    set next to group_session_restart(database and "a" and "new" and "g" and "discord" and "server" and "room" and 1)
    if not (archive_list_text(next and 0) equals "created"):
        return 6
    set profile to provider_llama_profile(get_argument(2) and string_to_int(get_argument(3)))
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 7
    for each run in ["recall","followup"]:
        set prompt to "Find our earlier fictional milestone using memory_search and read its original with memory_read. Give the milestone, date and exact inscription, retaining the source event. Do not invent missing details."
        if run equals "followup":
            set closed to sql_close(database)
            set database to archive_open(get_argument(1))
            set prompt to "Recheck the original using memory_read, then repeat only its exact inscription."
        set submitted to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and run and prompt)
        if not (archive_list_text(submitted and 0) equals "accepted"):
            return 8
        if run equals "recall" and (string_contains(memory_context(database and run) and "maple-comet-628") is not equal to 0 or else length_list(memory_pending(database and run)) is not equal to 1):
            return 9
        if agent_provider_bind(database and run and profile) is not equal to 0 or else not (agent_loop_inner_provider(database and run and profile and 2048 and -1 and 65536 and library) equals "completed"):
            return 10
        set state to agent_run_read(database and run)
        set final to archive_read_event(database and archive_list_text(state and 3))
        set answer to memory_source_text(final)
        if string_contains(answer and "Café 🌍") equals 0:
            display answer
            return 11
        if run equals "recall" and (string_contains(answer and "maple-comet-628") equals 0 or else string_contains(answer and "2026-03-19") equals 0):
            display answer
            return 12
        set calls to history_collect_one(checkpoint_prepare(database and "SELECT count(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run=?1 AND t.state='observed' AND json_extract(e.payload,'$.name')='memory_read';" and [run]))
        if string_to_int(archive_list_text(calls and 1)) < 1:
            return 13
    set searched to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run='recall' AND t.state='observed' AND json_extract(e.payload,'$.name')='memory_search';"))
    if string_to_int(archive_list_text(searched and 1)) < 1 or else archive_verify_all(database) is not equal to 0:
        return 14
    if ep_dlclose(library) is not equal to 0:
        return 15
    display "PASS: actual model searched and read unindexed shared original across conversations, returned dated marker and Unicode inscription, then re-read after database reopen. Extraction intentionally excluded to isolate original retrieval; transport/UI and latency acceptance remain separate."
    return sql_close(database)
