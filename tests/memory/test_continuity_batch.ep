import "../fixtures/memory_tool_fixture"

define batch_field with output as Str and key as Str returning Str:
    set tokens to provider_json_tokens(output)
    return provider_value(tokens and provider_member(tokens and 0 and key))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set original to web_submit_owned(database and "owner" and "original" and "" and "Café 🌍")
    set session to archive_list_text(original and 1)
    if archive_append(database and session and "reply" and "assistant_final" and "{\"content\":\"Second message\",\"reasoning_content\":\"Hidden trace\"}" and "unix-ms:1000000") is not equal to 0:
        return 4
    set later to web_submit_owned(database and "owner" and "recall" and "" and "Read the session")
    set args to concat("{\"session\":" and concat(provider_quote(session) and ",\"after\":0}"))
    if recall_fixture_call(database and "recall" and "batch-request" and "batch" and "memory_messages" and args) is not equal to 0:
        return 5
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.count'),json_extract(e.payload,'$.result.messages[0].text'),json_extract(e.payload,'$.result.messages[1].text'),json_extract(e.payload,'$.result.complete'),json_extract(e.payload,'$.result.next'),json_extract(e.payload,'$.result.messages[1].occurred_clock') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='batch' AND t.state='observed';"))
    if not (archive_list_text(result and 1) equals "2") or else not (archive_list_text(result and 2) equals "Café 🌍") or else not (archive_list_text(result and 3) equals "Second message") or else not (archive_list_text(result and 4) equals "1") or else not (archive_list_text(result and 5) equals ""):
        display result
        return 6
    if string_contains(archive_list_text(result and 6) and "UTC date and time: Thursday, 1970-01-01 00:16:40 UTC") equals 0:
        return 17
    set args to concat("{\"session\":" and concat(provider_quote(session) and ",\"after\":0,\"characters\":5}"))
    set page to continuity_execute(database and "recall" and "memory_messages" and args)
    set tokens to provider_json_tokens(page)
    set next to agent_json_source(page and tokens and provider_member(tokens and 0 and "next"))
    if string_contains(page and "Café ") equals 0 or else not (batch_field(page and "complete") equals "false"):
        return 7
    # Appends after the first page must not enter that scan.
    if archive_append(database and session and "late" and "user" and "Later append" and "2026-10-23T12:01:00Z") is not equal to 0:
        return 8
    set reconstructed to "Café "
    set pages to 0
    repeat while not (next equals "null"):
        set page to continuity_execute(database and "recall" and "memory_messages" and next)
        if string_contains(page and "Later append") is not equal to 0:
            return 9
        set tokens to provider_json_tokens(page)
        set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
        for each item in messages:
            set reconstructed to concat(reconstructed and provider_value(tokens and provider_member(tokens and item and "text")))
        set next to agent_json_source(page and tokens and provider_member(tokens and 0 and "next"))
        set pages to pages + 1
        if pages > 10:
            return 10
    if not (reconstructed equals "Café 🌍Second message"):
        display reconstructed
        return 11
    set sessions to continuity_execute(database and "recall" and "memory_sessions" and "{\"after\":0}")
    if not (batch_field(sessions and "count") equals "2"):
        return 12
    set args to concat("{\"session\":" and concat(provider_quote(session) and ",\"after\":0,\"limit\":1}"))
    set page to continuity_execute(database and "recall" and "memory_messages" and args)
    if not (batch_field(page and "count") equals "1") or else not (batch_field(page and "complete") equals "false"):
        return 13
    if web_pairing_invite(database and "other-invite") is not equal to 0 or else web_device_pair(database and "other-invite" and "other" and "Other" and "other-secret") is not equal to 0:
        return 14
    set other to web_submit_owned(database and "other" and "other-run" and "" and "Other user")
    set denied to continuity_execute(database and "other-run" and "memory_messages" and args)
    if string_contains(denied and "Café") is not equal to 0 or else not (batch_field(denied and "count") equals "0"):
        return 15
    if string_contains(continuity_execute(database and "recall" and "memory_messages" and "{\"session\":\"x\",\"after\":0,\"characters\":0}") and "invalid-arguments") equals 0:
        return 16
    display "PASS: queued full-session text batch, Unicode continuation, immutable scan boundary, caller-sized pages, batch discovery and owner isolation."
    return sql_close(database)
