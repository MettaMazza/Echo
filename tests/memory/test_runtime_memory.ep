import "../../app/archive/snapshot"
import "../../app/memory/automatic_context"
import "../../app/memory/knowledge_lifecycle"
import "../../app/context/system_awareness"
import "../../app/security/group_runs"
import "../../app/jobs/delegation_schema"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each name in ["a","b","c"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set private to web_submit_owned(database and "a" and "private" and "" and "Private source must stay private.")
    if not (group_session_create(database and "a" and "s3" and "g" and "discord" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "b" and "group-run" and "s3" and "discord" and "server" and "room" and "On 2026-03-12 our shared milestone was amber-group-741.") equals "accepted"):
        return 5
    set state to agent_run_read(database and "group-run")
    set source_event to archive_list_text(state and 1)
    set source to archive_read_event(database and source_event)
    set digest to archive_list_text(source and 6)


    set profile to provider_llama_profile(get_argument(2) and 8080)
    if agent_provider_bind(database and "private" and profile) is not equal to 0 or else agent_provider_bind(database and "group-run" and profile) is not equal to 0:
        return 6
    set binding to echo_runtime_binding(database and "private")
    set observed to echo_system_inspect(database and "private" and "{}")
    if string_contains(observed and binding) equals 0:
        return 7
    set private_state to agent_run_read(database and "private")
    for each key in ["current","build","provider","identity","missing"]:
        set recorded_binding to binding
        set expected to "current"
        if not (key equals "current"):
            set path to concat("$." and key)
            if key equals "missing":
                set path to "$.build"
            set value to "changed"
            if key equals "missing":
                set value to ""
            set modified to history_collect_one(checkpoint_prepare(database and "SELECT json_set(?1,?2,?3);" and [binding,path,value]))
            set recorded_binding to archive_list_text(modified and 1)
            set expected to "stale-runtime"
            if key equals "missing":
                set expected to "unavailable"
        for each run in ["private","group-run"]:
            set current to agent_run_read(database and run)
            set event to concat(run and concat(":" and key))
            set body to concat("{\"result\":{\"runtime_binding\":" and concat(recorded_binding and "}}"))
            if archive_append(database and archive_list_text(current and 0) and event and "tool_result" and body and "2026-10-17") is not equal to 0:
                return 8
            set source to archive_read_event(database and event)
            set result to knowledge_record(database and run and "semantic" and key and "capability" and "Recorded capability observation" and "tool-observation" and event and archive_list_text(source and 6) and "" and "" and "")
            if string_contains(result and "recorded:") is not equal to 1:
                display result
                return 9
            set row to knowledge_next(database and run and key and 0)
            if not (archive_list_text(row and 15) equals expected):
                display concat(key and concat(":" and archive_list_text(row and 15)))
                return 10
    set next to web_submit_owned(database and "a" and "next-private" and "" and "Recall capabilities")
    if agent_provider_bind(database and "next-private" and profile) is not equal to 0 or else agent_cancel_run(database and "group-run") is not equal to 0 or else not (group_run_submit(database and "a" and "next-group" and "s3" and "discord" and "server" and "room" and "Recall capabilities") equals "accepted") or else agent_provider_bind(database and "next-group" and profile) is not equal to 0:
        return 11
    for each run in ["next-private","next-group"]:
        set context to memory_context(database and run)
        if string_contains(context and "stale-runtime") equals 0 or else string_contains(context and "unavailable") equals 0 or else string_contains(context and "current") equals 0:
            display context
            return 12
    if archive_verify_all(database) is not equal to 0:
        return 13
    display "PASS: actual system inspection emits runtime identity; private/shared graph and automatic recall mark changed build, model/profile and identity/config hashes stale, missing identity unavailable and matching observations current. Historical evidence remains intact."
    return sql_close(database)
