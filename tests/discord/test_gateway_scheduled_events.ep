import "../../app/discord/gateway_intake"

define gateway_fixture with sequence as Int and id as Str and author as Str and extra as Str and content as Str returning Str:
    set text to concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and ",\"t\":\"MESSAGE_CREATE\",\"d\":{\"type\":0,\"id\":"))
    set text to concat(text and provider_quote(id))
    set text to concat(text and concat(",\"channel_id\":\"300\",\"author\":{\"id\":" and concat(provider_quote(author) and "},\"content\":")))
    return concat(text and concat(provider_quote(content) and concat(extra and "}}")))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 2
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"session-a\",\"resume_gateway_url\":\"wss://gateway-us-east1-b.discord.gg\"}}"
    if not (discord_gateway_ready_record(database and "socket-a" and "901" and ready) equals "invalid-ready"):
        return 3
    if not (discord_gateway_ready_record(database and "socket-a" and "900" and ready) equals "recorded"):
        return 4
    set resumed to discord_gateway_resume_read(database)
    if not (archive_list_text(resumed and 1) equals "session-a") or else not (archive_list_text(resumed and 3) equals "1"):
        return 5
    set public to gateway_fixture(2 and "100" and "500" and ",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]" and "Admitted public")
    if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and ["400"] and public) equals "recorded"):
        return 6
    set private to gateway_fixture(3 and "101" and "400" and ",\"mentions\":[]" and "Admitted admin DM")
    if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and ["400"] and private) equals "recorded"):
        return 7
    set guest to gateway_fixture(4 and "102" and "500" and ",\"mentions\":[]" and "GUEST_DM_MUST_NOT_BE_RETAINED")
    if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and ["400"] and guest) equals "recorded"):
        return 8
    set foreign to gateway_fixture(5 and "103" and "500" and ",\"guild_id\":\"201\",\"mentions\":[{\"id\":\"900\"}]" and "FOREIGN_GUILD_MUST_NOT_BE_RETAINED")
    if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and ["400"] and foreign) equals "recorded"):
        return 9
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(instr(payload,'MUST_NOT_BE_RETAINED')) FROM discord_inbox;"))
    if not (archive_list_text(count and 1) equals "3") or else not (archive_list_text(count and 2) equals "0"):
        return 10
    set redirect to history_collect_one(archive_prepare(database and "SELECT json_extract(payload,'$.admission'),json_extract(payload,'$.author_id') FROM discord_inbox WHERE identity='message:redirect:102';"))
    if not (archive_list_text(redirect and 1) equals "redirect-dm") or else not (archive_list_text(redirect and 2) equals "500"):
        return 11
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "900")
    set resumed to discord_gateway_resume_read(database)
    if not (archive_list_text(resumed and 3) equals "5"):
        return 12
    if not (discord_gateway_bind(database and "socket-b" and "session-a") equals "bound") or else not (discord_gateway_intake(database and "socket-b" and "900" and ["200"] and ["400"] and foreign) equals "already-recorded"):
        return 13
    if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and ["400"] and public) equals "stale-connection"):
        return 14
    set kinds to ["GUILD_SCHEDULED_EVENT_CREATE","GUILD_SCHEDULED_EVENT_UPDATE","GUILD_SCHEDULED_EVENT_DELETE","GUILD_SCHEDULED_EVENT_USER_ADD","GUILD_SCHEDULED_EVENT_USER_REMOVE"]
    set sequence to 6
    for each item in kinds:
        set kind to ptr_to_str(item)
        set event_body to concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":" and concat(provider_quote(kind) and ",\"d\":{\"id\":\"800\",\"guild_scheduled_event_id\":\"800\",\"user_id\":\"500\",\"guild_id\":\"200\",\"name\":\"PRIVATE_EVENT_TEXT\",\"description\":\"PRIVATE_EVENT_TEXT\",\"entity_metadata\":{\"location\":\"PRIVATE_EVENT_TEXT\"}}}"))))
        if not (discord_gateway_intake(database and "socket-b" and "900" and ["200"] and ["400"] and event_body) equals "recorded"):
            return 20
        if not (discord_gateway_intake(database and "socket-b" and "900" and ["200"] and ["400"] and event_body) equals "already-recorded"):
            return 21
        set sequence to sequence + 1
    set events to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(CASE WHEN payload='{\"guild_id\":\"200\",\"event_id\":\"800\"}' THEN 1 ELSE 0 END),SUM(instr(payload,'PRIVATE_EVENT_TEXT')),SUM(instr(payload,'user_id')) FROM discord_inbox WHERE identity LIKE 'event-change:%';"))
    if not (archive_list_text(events and 1) equals "5") or else not (archive_list_text(events and 2) equals "5") or else not (archive_list_text(events and 3) equals "0") or else not (archive_list_text(events and 4) equals "0"):
        return 22
    set foreign_event to "{\"op\":0,\"s\":11,\"t\":\"GUILD_SCHEDULED_EVENT_CREATE\",\"d\":{\"id\":\"801\",\"guild_id\":\"201\",\"name\":\"PRIVATE_EVENT_TEXT\"}}"
    if not (discord_gateway_intake(database and "socket-b" and "900" and ["200"] and ["400"] and foreign_event) equals "recorded"):
        return 23
    set total to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity LIKE 'event-change:%';"))
    if not (archive_list_text(total and 1) equals "5"):
        return 24
    if sql_execute(database and "UPDATE discord_gateway_intents SET mask=46593;") is not equal to 0 or else not (archive_list_text(discord_gateway_resume_read(database) and 0) equals "end"):
        return 25
    if sql_execute(database and "DELETE FROM discord_gateway_intents;") is not equal to 0 or else not (archive_list_text(discord_gateway_resume_read(database) and 0) equals "end"):
        return 26
    if sql_execute(database and "INSERT INTO discord_gateway_intents(singleton,mask) VALUES(1,112137);") is not equal to 0 or else not (archive_list_text(discord_gateway_resume_read(database) and 3) equals "11"):
        return 27
    set closed to sql_close(database)
    display "PASS: five scheduled-event markers deduplicated, metadata and subscriber identity excluded, foreign guild excluded, old/missing intent profile requires fresh Identify; atomic READY/resume state, authenticated identity, scoped public/admin-DM intake, content-free guest redirect, foreign-guild exclusion, reopen cursor and stale socket fencing."
    return 0
