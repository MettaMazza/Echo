import "../../app/discord/access"
import "../../app/discord/audit_view"

# Read-only native transport qualification. This is not a model tool and grants
# no conversation permission; the caller provides an existing private spool.
define main returning Int:
    if get_argument_count() is not equal to 8 or else discord_snowflake(get_argument(6)) equals 0:
        return 1
    set options to discord_audit_options(get_argument(7))
    if not (archive_list_text(options and 0) equals "valid"):
        return 2
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 3
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 4
    set route to concat("/guilds/" and concat(get_argument(6) and concat("/audit-logs" and archive_list_text(options and 1))))
    set response to discord_access_get(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and route and "GET:guild-audit-log" and get_argument(6))
    if not (archive_list_text(response and 0) equals "observed"):
        display archive_list_text(response and 0)
        return 5
    set projected to discord_audit_page(archive_list_text(response and 1) and options)
    if string_length(projected) equals 0:
        return 6
    set target to concat(get_argument(4) and "/audit-projection.json")
    if file_exists(target) or else write_file(target and projected) is not equal to 1:
        return 7
    set fields to provider_json_tokens(projected)
    display concat("Verified audit entries: " and provider_value(fields and provider_member(fields and 0 and "count")))
    return sql_close(journal)
