import "../../app/discord/background_controller"
import "../fixtures/delegation_fixture"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Schedule the public reminder.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set claimed to discord_worker_claim(journal)
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if delegation_fixture_call(database and "discord-message:100" and archive_list_text(submitted and 1) and "schedule" and "schedule_fixture" and "{}") is not equal to 0 or else not (schedule_create(database and "discord-message:100" and "schedule" and "Public reminder" and 1000 and 0 and "catch-up") equals "created"):
        return 5
    if agent_cancel_run(database and "discord-message:100") is not equal to 0 or else discord_background_prepare(journal and database and 1000) is not equal to 0:
        return 6
    # A due occurrence may be recorded, but the foreground claim must prevent
    # admission into the shared conversation until that claim is released.
    set pending to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_schedule_occurrences o JOIN echo_runs r ON r.run=o.identity;"))
    if not (archive_list_text(pending and 1) equals "0"):
        return 7
    if not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "recorded") or else discord_background_prepare(journal and database and 1001) is not equal to 0:
        return 8
    set admitted to history_collect_one(archive_prepare(database and "SELECT COUNT(*),MIN(r.state),MIN(o.identity) FROM echo_schedule_occurrences o JOIN echo_runs r ON r.run=o.identity;"))
    if not (archive_list_text(admitted and 1) equals "1") or else not (archive_list_text(admitted and 2) equals "ready") or else discord_background_is_reserved(journal and archive_list_text(admitted and 3)) equals 0:
        return 9
    set closed to sql_close(database)
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if discord_background_prepare(journal and database and 2000) is not equal to 0:
        return 10
    set repeated to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_schedule_occurrences;"))
    if not (archive_list_text(repeated and 1) equals "1") or else discord_background_is_reserved(journal and archive_list_text(admitted and 3)) equals 0:
        return 11
    display "PASS: due schedule waits for foreground ownership, admits once, and preserves reservation across reopen."
    return sql_close(database)
