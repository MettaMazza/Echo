import "../../app/discord/voice_service"
import "../../app/discord/worker_store"
import "../../app/discord/gateway_journal"
import "../fixtures/tool_call_fixture"

define voice_service_fixture returning Int:
    if get_argument_count() is not equal to 7 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else web_cancel_schema(database) is not equal to 0:
        return 6
    if not (delegation_schema(database) equals "applied"):
        return 26
    set admin_ids to ["500"]
    set admin_device to discord_agent_principal(database and "500" and admin_ids)
    set journal to discord_store_open(get_argument(2) and "900")
    set source_body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Join authorised voice\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source_body) equals "recorded"):
        return 12
    if discord_worker_schema(journal) is not equal to 0:
        return 21
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:100"):
        return 22
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and admin_ids)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 12
    set listener to local_socket_listen(0)
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"voice-call\",\"function\":{\"name\":\"discord_voice\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "discord-message:100" and "voice-request" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0 or else discord_voice_intent_schema(journal) is not equal to 0:
        return 16
    set requested to discord_voice_intent_request(journal and "voice-intent" and "200" and "600" and "500" and "discord-message:100" and "voice-call" and ep_sha256("fixture-access"))
    if not (requested equals "queued"):
        return 17
    set allowed to discord_voice_request_guard(journal and database and "voice-intent" and "900" and ["200"] and admin_ids and "/absent-fixture-stop")
    if not (archive_list_text(allowed and 0) equals "allowed"):
        display archive_list_text(allowed and 0)
        return 18
    if discord_gateway_schema(journal) is not equal to 0:
        return 27
    set bound to discord_gateway_bind(journal and "generation" and "session")
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set fixture to ep_dlopen(get_argument(3))
    set mode to 0
    repeat while mode < 3:
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and mode and str_to_ptr(get_argument(2)))
        set proof to discord_voice_request_proof(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "voice-intent" and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop" and 1)
        if mode equals 0:
            if not (archive_list_text(proof and 0) equals "allowed") or else get_list(proof and 3) is not equal to 1 or else string_length(archive_list_text(proof and 4)) is not equal to 64:
                display archive_list_text(proof and 0)
                return 28
        if mode equals 0:
            if not (discord_voice_worker_check(journal and database and "voice-intent" and proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1) equals "allowed"):
                return 32
            set changed to set_list(proof and 5 and "other-intent")
            if not (discord_voice_worker_check(journal and database and "voice-intent" and proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1) equals "voice-proof-binding-denied"):
                return 33
            set changed to set_list(proof and 5 and "voice-intent")
            set changed to set_list(proof and 6 and 0)
            if not (discord_voice_worker_check(journal and database and "voice-intent" and proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1) equals "voice-proof-operation-denied"):
                return 34
            set changed to set_list(proof and 6 and 1)
            set retained_proof to proof
        if mode equals 1 and also not (archive_list_text(proof and 0) equals "voice-speak-denied"):
            display archive_list_text(proof and 0)
            return 29
        if mode equals 2 and also not (archive_list_text(proof and 0) equals "voice-authorization-refresh-required"):
            display archive_list_text(proof and 0)
            return 30
        if ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 11:
            return 31
        set mode to mode + 1
    if not (discord_voice_worker_check(journal and database and "voice-intent" and retained_proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1) equals "voice-authorization-refresh-required"):
        return 35
    # Complete the durable join/handoff using fixture-authenticated events.
    # The socket ABI is local; no TLS or Discord connection is claimed here.
    if discord_voice_session_schema(journal) is not equal to 0:
        return 36
    set baseline to "{\"id\":\"200\",\"voice_states\":[]}"
    set recorded to discord_gateway_dispatch_voice(journal and "generation" and "session" and 3 and "GUILD_CREATE" and ep_sha256(baseline) and "" and "" and baseline)
    set rejected_claim to discord_voice_worker_claim(journal and database and "voice-intent" and retained_proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1)
    if not (archive_list_text(rejected_claim and 0) equals "voice-authorization-refresh-required"):
        return 43
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set claim_proof to discord_voice_request_proof(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "voice-intent" and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop" and 1)
    set claimed_voice to discord_voice_worker_claim(journal and database and "voice-intent" and claim_proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1)
    if not (archive_list_text(claimed_voice and 0) equals "claimed"):
        return 44
    set marked to discord_voice_intent_written(journal and "voice-intent" and archive_list_text(claimed_voice and 1) and 1)
    set own to "{\"guild_id\":\"200\",\"user_id\":\"900\",\"channel_id\":\"600\",\"session_id\":\"voice-session\"}"
    set recorded to discord_gateway_dispatch_voice(journal and "generation" and "session" and 4 and "VOICE_STATE_UPDATE" and ep_sha256(own) and "" and "" and own)
    set server to "{\"guild_id\":\"200\",\"token\":\"fixture-token\",\"endpoint\":\"fixture.discord.media:443\"}"
    set recorded to discord_gateway_dispatch_private_voice(journal and "generation" and "session" and 5 and "VOICE_SERVER_UPDATE" and ep_sha256(server) and "" and "" and "" and server and "900")
    if discord_voice_recording_offer_schema(journal) is not equal to 0:
        return 57
    if not (discord_voice_recording_request(journal and "old-recording" and "voice-intent" and "500" and "300" and "old-owner-request") equals "pending-notice"):
        return 58
    if discord_voice_service_recording_recover(journal and "voice-intent") is not equal to 0:
        return 59
    set recovered to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_recordings WHERE identity='old-recording';"))
    if not (archive_list_text(recovered and 1) equals "interrupted"):
        return 60
    set handoff to discord_voice_handoff_claim(journal and "voice-intent" and "generation" and "900" and ep_time_now_ms() and 1 and 0)
    if handoff equals 0:
        return 37
    set credentials to discord_voice_handoff_take(handoff)
    set socket_library to ep_dlopen(get_argument(5))
    set reset to ep_dlcall1(ep_dlsym(socket_library and "fixture_reset") and 0)
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and ep_dlopen(get_argument(5)))
    set added to append_list(socket and 1)
    set prepared to create_list()
    set added to append_list(prepared and socket)
    set added to append_list(prepared and credentials)
    set added to append_list(prepared and "600")
    set added to append_list(prepared and 0)
    set binding to create_list()
    set added to append_list(binding and prepared)
    set added to append_list(binding and "voice-intent")
    set added to append_list(binding and "generation")
    set added to append_list(binding and "900")
    set paths to create_list()
    set paths to ["unused","unused","unused"]
    if get_argument(6) equals "stale":
        set rejected_owner to discord_voice_worker_activate(journal and database and binding and claim_proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop" and 1 and paths and 1 and 100)
        set terminal to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_intents WHERE identity='voice-intent';"))
        if rejected_owner is not equal to 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_cleanups")) is not equal to 1 or else not (archive_list_text(terminal and 1) equals "leave-required") or else string_length(archive_list_text(credentials and 3)) is not equal to 0:
            return 45
        display "PASS: stale post-preparation proof prevents Identify, disposes credentials/socket and requires leave."
        return 0
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set observer_config to create_list()
    set added to append_list(observer_config and get_argument(3))
    set added to append_list(observer_config and "fixture-token-no-network-123456")
    set added to append_list(observer_config and get_argument(2))
    set added to append_list(observer_config and get_argument(1))
    set added to append_list(observer_config and "voice-intent")
    set added to append_list(observer_config and "900")
    set observer_guilds to create_list()
    set added to append_list(observer_guilds and "200")
    set added to append_list(observer_config and observer_guilds)
    set added to append_list(observer_config and admin_ids)
    set added to append_list(observer_config and get_argument(4))
    set added to append_list(observer_config and "/absent-fixture-stop")
    set added to append_list(observer_config and 1)
    if get_argument(6) equals "denied":
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 1 and str_to_ptr(get_argument(2)))
    if get_argument(6) equals "refresh":
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 22 and str_to_ptr(get_argument(2)))
    else if get_argument(6) equals "refresh-denied":
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 23 and str_to_ptr(get_argument(2)))
    else if get_argument(6) equals "deadline":
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 2 and str_to_ptr(get_argument(2)))
    set diagnostic to create_list()
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set worker to discord_voice_service_activate(journal and database and binding and observer_config and paths and 1000 and system and diagnostic)
    if get_argument(6) equals "refresh":
        if worker equals 0 or else length_list(diagnostic) is not equal to 0 or else ep_dlcall0(ep_dlsym(fixture and "fixture_activation_source_reads")) is not equal to 2:
            return 57
    if get_argument(6) equals "deadline":
        if worker is not equal to 0 or else not (archive_list_text(diagnostic and 0) equals "voice-activation-refresh-deadline") or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 0:
            return 58
    else if get_argument(6) equals "refresh-denied":
        if worker is not equal to 0 or else ep_dlcall0(ep_dlsym(fixture and "fixture_activation_source_reads")) is not equal to 2 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 0 or else not (archive_list_text(diagnostic and 0) equals "voice-speak-denied"):
            return 59
    else if get_argument(6) equals "denied":
        if worker is not equal to 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 0:
            return 50
    else:
        if worker equals 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 1:
            return 51
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 2 and str_to_ptr(get_argument(2)))
        set duplicate to discord_voice_service_activate(journal and database and binding and observer_config and paths and 1000 and system and diagnostic)
        if duplicate is not equal to 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 1 or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 0:
            return 52
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
        set reader to discord_store_open(get_argument(2) and "900")
        set stop to channel
        set opus_path to ""
        set expected to "voice-worker-stopped"
        if get_argument(6) equals "audio-stop" or else get_argument(6) equals "audio-deadline":
            set opus_path to "unused-no-audio-jobs"
        if get_argument(6) equals "loop-deadline" or else get_argument(6) equals "audio-deadline":
            set expected to "voice-handshake-timeout"
        else:
            send 1 to stop
        set loop_outcome to discord_voice_service_owned_loop(journal and reader and database and worker and observer_config and opus_path and stop)
        display loop_outcome
        if not (loop_outcome equals expected):
            return 53
        if not (discord_voice_service_join(get_list(worker and 1)) equals "permission-observer-stopped") or else not (discord_voice_service_join(get_list(worker and 1)) equals "permission-observer-stopped"):
            return 54
        set closed to sql_close(reader)
    set terminal to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_intents WHERE identity='voice-intent';"))
    if not (archive_list_text(terminal and 1) equals "leave-required") or else string_length(archive_list_text(credentials and 3)) is not equal to 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_cleanups")) is not equal to 1:
        return 55
    set failed_requests to channel
    set failed_replies to channel
    set failed_completion to channel
    set failed_mailbox to discord_voice_permission_mailbox_new(failed_requests and failed_replies and failed_completion)
    send 1 to failed_completion
    if not (discord_voice_permission_mailbox_poll(failed_mailbox) equals "permission-observer-failed") or else get_list(failed_mailbox and 6) is not equal to 4 or else not (discord_voice_service_join(failed_mailbox) equals "permission-observer-failed"):
        return 56
    set closed to ep_dlclose(system)
    set closed to ep_dlclose(socket_library)
    set closed to ep_dlclose(fixture)
    display "PASS: service interrupts prior-owner recording authority, rechecks post-TLS permissions, activates once, closes on stop/denial and joins recording and permission controllers."
    return 0

# Match the production owner thread with nested permission/controller workers.
define voice_service_fixture_thread with completed as Int returning Int:
    set status to voice_service_fixture()
    send status to completed
    return status

define main returning Int:
    set completed to channel
    spawn voice_service_fixture_thread(completed)
    set waits to create_list()
    set added to append_list(waits and completed)
    # Poll like the production supervisor; a blocking receive suppresses GC.
    repeat while select(waits and 20) < 0:
        set waiting to 1
    set status to receive from completed
    return status
