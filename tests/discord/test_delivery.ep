import "../../app/discord/delivery"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_delivery_schema(database) is not equal to 0:
        return 2
    if not (discord_inbox_record(database and "source" and "MESSAGE_CREATE" and "{}") equals "recorded") or else not (discord_outbox_enqueue(database and "reply" and "source" and "300" and "{\"content\":\"hello\",\"allowed_mentions\":{\"parse\":[]}}") equals "enqueued"):
        return 3
    set headers to "HTTP/1.1 100 Continue\r\nX-RateLimit-Remaining: 9\r\n\r\nHTTP/2 200\r\nX-RateLimit-Bucket: shared\r\nX-RateLimit-Remaining: 0\r\nX-RateLimit-Reset-After: 1.5\r\n\r\n"
    if not (discord_rate_observe(database and "POST:messages" and "300" and "200" and headers and "{}" and 1000) equals "recorded"):
        return 4
    if discord_rate_deadline(database and "POST:messages" and "300") < 2500 or else discord_rate_deadline(database and "POST:messages" and "301") is not equal to 0:
        return 5
    if not (discord_rate_observe(database and "PATCH:message" and "300" and "200" and "HTTP/2 200\r\nX-RateLimit-Bucket: shared\r\n\r\n" and "{}" and 1000) equals "recorded") or else discord_rate_deadline(database and "PATCH:message" and "300") < 2500:
        return 6
    if not (discord_rate_observe(database and "POST:messages" and "301" and "429" and "HTTP/2 429\r\nRetry-After: 4.1\r\n\r\n" and "{\"retry_after\":4.1,\"global\":true}" and 1000) equals "recorded") or else discord_rate_deadline(database and "GET:messages" and "999") < 5100:
        return 7
    set claim to discord_outbox_claim(database and "reply" and "attempt-a")
    set nonce to archive_list_text(claim and 3)
    if string_length(discord_delivery_body("{\"content\":\"x\",\"nonce\":\"injected\"}" and nonce)) > 0:
        return 8
    if not (discord_outbox_finish(database and "reply" and "attempt-a" and "uncertain" and "" and "lost HTTP response") equals "recorded"):
        return 9
    set wrong to concat("{\"id\":\"700\",\"channel_id\":\"301\",\"author\":{\"id\":\"900\"},\"nonce\":" and concat(provider_quote(nonce) and "}"))
    if not (discord_delivery_reconcile(database and "reply" and wrong) equals "not-proven") or else not (archive_list_text(discord_outbox_claim(database and "reply" and "blind-retry") and 0) equals "not-pending"):
        return 10
    set correct to concat("{\"id\":\"700\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"},\"nonce\":" and concat(provider_quote(nonce) and "}"))
    if discord_gateway_runtime_schema(database) is not equal to 0 or else not (discord_gateway_ready_record(database and "socket" and "900" and "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"delivery-session\",\"resume_gateway_url\":\"wss://gateway.discord.gg\"}}") equals "recorded"):
        return 11
    set observed to concat("{\"op\":0,\"s\":2,\"t\":\"MESSAGE_CREATE\",\"d\":" and concat(correct and "}"))
    if not (discord_gateway_intake(database and "socket" and "900" and ["200"] and ["400"] and observed) equals "recorded"):
        return 15
    set receipt to history_collect_one(archive_prepare(database and "SELECT payload FROM discord_inbox WHERE identity='delivery:observed:700';"))
    if not (archive_list_text(receipt and 1) equals correct) or else not (discord_delivery_reconcile(database and "reply" and archive_list_text(receipt and 1)) equals "reconciled") or else not (discord_delivery_reconcile(database and "reply" and correct) equals "already-reconciled"):
        return 16
    if not (discord_outbox_enqueue(database and "reply2" and "source" and "300" and "{\"content\":\"retry\"}") equals "enqueued") or else not (archive_list_text(discord_outbox_claim(database and "reply2" and "attempt-b") and 0) equals "claimed"):
        return 12
    if not (discord_delivery_rate_retry(database and "reply2" and "stale") equals "stale-attempt") or else not (discord_delivery_rate_retry(database and "reply2" and "attempt-b") equals "retry-scheduled"):
        return 13
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "900")
    if discord_rate_deadline(database and "POST:messages" and "301") < 5100 or else not (discord_reply_channel(database and "700" and "300") equals "300"):
        return 14
    print "PASS: shared/global cooldowns, major isolation, persistent deadlines, nonce binding and no blind resend"
    return 0
