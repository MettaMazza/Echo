import "../../app/discord/voice_pcm_reader"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 90
    set state to discord_voice_pcm_open(get_argument(1) and get_argument(2) and string_to_int(get_argument(3)))
    if get_argument(4) equals "reject":
        if state is not equal to 0:
            set closed to discord_voice_pcm_close(state)
            return 1
        display "PASS: invalid PCM source rejected."
        return 0
    if state equals 0:
        return 2
    set total to 0
    set frames to 0
    repeat while total < 4000:
        set row to discord_voice_pcm_next(state)
        if not (archive_list_text(row and 0) equals "frame"):
            return 3
        set blob to get_list(row and 1)
        set valid to get_list(row and 2)
        if get_list(blob and 1) is not equal to 3840 or else valid < 1 or else valid > 3840:
            return 4
        set index to 0
        repeat while index < valid:
            if peek_byte(get_list(blob and 0) and index) is not equal to (total + index) % 251:
                return 5
            set index to index + 1
        repeat while index < 3840:
            if peek_byte(get_list(blob and 0) and index) is not equal to 0:
                return 6
            set index to index + 1
        set total to total + valid
        set frames to frames + 1
        set released to discord_voice_blob_release(blob)
    if total is not equal to 4000 or else frames is not equal to 2 or else not (archive_list_text(discord_voice_pcm_next(state) and 0) equals "end"):
        return 7
    if discord_voice_pcm_close(state) is not equal to 1 or else discord_voice_pcm_close(state) is not equal to 1 or else not (archive_list_text(discord_voice_pcm_next(state) and 0) equals "pcm-reader-closed"):
        return 8
    if discord_voice_pcm_open(get_argument(1) and ep_sha256("wrong") and string_to_int(get_argument(3))) is not equal to 0:
        return 9
    display "PASS: verified inode streams exact PCM bytes in 20ms frames, pads final frame, preserves duration and closes idempotently."
    return 0
