import "../../app/discord/voice_connection_io"

define fixture_io with library as Int and path as Str returning List:
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and ep_dlopen(path))
    set added to append_list(socket and 1)
    set paths to create_list()
    set paths to ["unused","unused","unused"]
    return discord_voice_io_new(discord_voice_transport_new(socket and paths and 1234 and "5678" and 1) and 100)

define fixture_queue with library as Int and body as Str returning Int:
    return ep_dlcall3(ep_dlsym(library and "fixture_receive") and str_to_ptr(body) and string_length(body) and 1)

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 90
    set library to ep_dlopen(get_argument(1))
    set state to fixture_io(library and get_argument(1))
    set queued to fixture_queue(library and "{\"op\":8,\"d\":{\"heartbeat_interval\":5000}}")
    set result to discord_voice_io_tick(state and 100 and 10000 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "heartbeat-ready"):
        return 1
    set result to discord_voice_io_tick(state and 101 and 10001 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "pending") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 2
    set queued to fixture_queue(library and "{\"op\":6,\"d\":10001}")
    set result to discord_voice_io_tick(state and 200 and 10100 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "heartbeat-acknowledged"):
        return 3
    set result to discord_voice_io_tick(state and 201 and 10101 and 2 and 0 and 1)
    if not (archive_list_text(result and 0) equals "stale-or-closed-voice-socket") or else get_list(state and 4) is not equal to 0:
        return 4
    set result to discord_voice_io_tick(state and 202 and 10102 and 1 and 0 and 0)
    if not (archive_list_text(result and 0) equals "voice-authorization-revoked") or else ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 5
    set state to fixture_io(library and get_argument(1))
    set result to discord_voice_io_tick(state and 30100 and 10000 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "voice-handshake-timeout"):
        return 6
    set state to fixture_io(library and get_argument(1))
    set handshake to get_list(get_list(state and 0) and 0)
    set changed to set_list(handshake and 0 and 4)
    if discord_voice_io_deadline(state and 30099) is not equal to 0:
        return 14
    set result to discord_voice_io_tick(state and 30100 and 10000 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "voice-handshake-timeout") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 15
    set state to fixture_io(library and get_argument(1))
    set result to discord_voice_io_tick(state and 101 and 10000 and 1 and 1 and 1)
    if not (archive_list_text(result and 0) equals "voice-cancelled") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0:
        return 7
    set state to fixture_io(library and get_argument(1))
    set queued to fixture_queue(library and "{\"op\":8,\"d\":{\"heartbeat_interval\":5000}}")
    set result to discord_voice_io_tick(state and 100 and 10000 and 1 and 1 and 0)
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 1)
    set result to discord_voice_io_tick(state and 101 and 10001 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "voice-heartbeat-write-failed") or else get_list(state and 4) is not equal to 1:
        return 8
    set state to fixture_io(library and get_argument(1))
    set queued to fixture_queue(library and "{\"op\":8,\"d\":{\"heartbeat_interval\":5000}}")
    set result to discord_voice_io_tick(state and 100 and 10000 and 1 and 1 and 0)
    set result to discord_voice_io_tick(state and 101 and 10001 and 1 and 1 and 0)
    set result to discord_voice_io_tick(state and 5101 and 15001 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "reconnect-missing-ack"):
        return 9
    set state to fixture_io(library and get_argument(1))
    set transport to get_list(state and 0)
    set handshake to get_list(transport and 0)
    set changed to set_list(handshake and 0 and 4)
    set binary to research_native_words(1)
    set written to poke_byte(get_list_data_ptr(binary) and 0 and 65)
    set written to poke_byte(get_list_data_ptr(binary) and 2 and 255)
    set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and get_list_data_ptr(binary) and 3 and 2)
    set result to discord_voice_io_tick(state and 101 and 10001 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "binary-mls"):
        return 10
    set blob to get_list(result and 1)
    if get_list(blob and 1) is not equal to 3 or else peek_byte(get_list(blob and 0) and 1) is not equal to 0 or else peek_byte(get_list(blob and 0) and 2) is not equal to 255:
        return 11
    set released to discord_voice_blob_release(blob)
    set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and get_list_data_ptr(binary) and 3 and 1)
    set result to discord_voice_io_tick(state and 102 and 10002 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "nul-in-voice-json") or else get_list(state and 4) is not equal to 1:
        return 12
    set closed to ep_dlclose(library)
    display "PASS: integrated receive/framing/heartbeat loop enforces ACK deadlines, generation, cancellation, authorization, handshake timeout and partial-write cleanup."
    return 0
