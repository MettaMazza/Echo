import "../../app/discord/activity_private"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"400\"}}") equals "recorded"):
        return 2
    set admins to create_list()
    set added to append_list(admins and "400")
    set no_admins to create_list()
    set dm to "{\"id\":\"800\",\"type\":1,\"recipients\":[{\"id\":\"400\"}]}"
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and no_admins and dm) equals "not-admin-source"):
        return 3
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and admins and "{\"id\":\"800\",\"type\":1,\"recipients\":[{\"id\":\"401\"}]}") equals "foreign-recipient"):
        return 4
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and admins and "{\"id\":\"800\",\"type\":3,\"recipients\":[{\"id\":\"400\"}]}") equals "not-private-dm"):
        return 5
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and admins and dm) equals "800"):
        return 6
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and admins and dm) equals "800") or else not (discord_activity_private_observe(journal and "message:create:100" and "900" and no_admins and dm) equals "not-admin-source"):
        return 7
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and admins and "{\"id\":\"801\",\"type\":1,\"recipients\":[{\"id\":\"400\"}]}") equals "binding-conflict"):
        return 8
    if not (discord_activity_private_observe(journal and "message:create:100" and "900" and admins and "{\"id\":\"800\",\"type\":1,\"recipients\":[{\"id\":\"400\"},{\"id\":\"401\"}]}") equals "foreign-recipient"):
        return 9
    display "PASS: original-admin-only private activity, exact DM audience, restart binding, revocation and foreign/group DM rejection"
    return 0
