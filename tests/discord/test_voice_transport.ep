import "../../app/discord/voice_transport"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 90
    set fixture to ep_dlopen(get_argument(4))
    if fixture equals 0:
        return 1
    set paths to create_list()
    set paths to [get_argument(1),get_argument(2),get_argument(3)]
    set round to 0
    repeat while round < 2:
        set reset to ep_dlcall1(ep_dlsym(fixture and "fixture_reset") and round)
        set owned to ep_dlopen(get_argument(4))
        set socket to create_list()
        set added to append_list(socket and "connected")
        set added to append_list(socket and owned)
        set added to append_list(socket and 1)
        set state to discord_voice_transport_new(socket and paths and 1234567890 and "1234123412341234" and 1)
        if state equals 0:
            return 2
        set handshake to get_list(state and 0)
        # Fixture starts at the already-qualified post-selection phase.
        set changed to set_list(handshake and 0 and 3)
        set key to research_native_words(4)
        set changed to set_list(key and 0 and 123456)
        set values to create_list()
        set values to [1,key]
        set installed to discord_voice_transport_install(state and values)
        if ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 1 or else ep_dlcall0(ep_dlsym(fixture and "fixture_opcode")) is not equal to 26:
            return 3
        if get_list(key and 0) is not equal to 0:
            return 4
        if round equals 0:
            if installed is not equal to 1 or else get_list(handshake and 0) is not equal to 4 or else get_list(state and 3) equals 0 or else get_list(state and 4) equals 0:
                return 5
            set cipher to get_list(state and 3)
            if peek_byte(get_list(cipher and 1) and 0) is not equal to 64:
                return 6
        else:
            if installed is not equal to 0 or else get_list(handshake and 0) is not equal to -1 or else get_list(state and 3) is not equal to 0 or else get_list(state and 4) is not equal to 0:
                return 7
        set closed to discord_voice_transport_close(state)
        set closed to discord_voice_transport_close(state)
        if ep_dlcall0(ep_dlsym(fixture and "fixture_cleanups")) is not equal to 1:
            return 8
        set round to round + 1
    set closed to ep_dlclose(fixture)
    display "PASS: negotiated transport key copied and input wiped; real DAVE key package sent; uncertain partial write tears down all native state without retry."
    return 0
