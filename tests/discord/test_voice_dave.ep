import "../../app/discord/voice_dave"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 90
    set path to get_argument(1)
    set callbacks to get_argument(2)
    if discord_dave_open(path and callbacks and 0 and 100 and "200") is not equal to 0:
        return 1
    if discord_dave_open(path and callbacks and 65535 and 100 and "200") is not equal to 0:
        return 2
    if discord_dave_open(path and callbacks and 1 and 0 and "200") is not equal to 0:
        return 3
    if discord_dave_open(path and callbacks and 1 and 100 and "bad-user") is not equal to 0:
        return 4
    if discord_dave_open("/usr/lib/libSystem.B.dylib" and callbacks and 1 and 100 and "200") is not equal to 0:
        return 5
    set round to 0
    repeat while round < 10:
        set state to discord_dave_open(path and callbacks and 1 and 100 and "200")
        if state equals 0:
            return 6
        set blob to discord_dave_key_package(state)
        if blob equals 0 or else get_list(blob and 1) < 32:
            return 7
        set before to peek_byte(get_list(blob and 0) and 0)
        if discord_dave_close(state) is not equal to 1 or else discord_dave_close(state) is not equal to 1:
            return 8
        if discord_dave_key_package(state) is not equal to 0:
            return 9
        if peek_byte(get_list(blob and 0) and 0) is not equal to before:
            return 10
        if discord_voice_blob_release(blob) is not equal to 1 or else discord_voice_blob_release(blob) is not equal to 1:
            return 11
        if get_list(blob and 0) is not equal to 0 or else get_list(blob and 1) is not equal to 0:
            return 12
        set round to round + 1
    set left to discord_dave_open(path and callbacks and 1 and 100 and "200")
    set right to discord_dave_open(path and callbacks and 1 and 100 and "201")
    if left equals 0 or else right equals 0:
        return 13
    set closed to discord_dave_close(left)
    set blob to discord_dave_key_package(right)
    if blob equals 0:
        return 14
    set released to discord_voice_blob_release(blob)
    set adapter to get_list(right and 2)
    set notified to ep_dlcall3(ep_dlsym(adapter and "echo_voice_failure_callback") and str_to_ptr("fixture") and str_to_ptr("fixture failure") and get_list(right and 3))
    if discord_dave_failures(right) is not equal to 1 or else discord_dave_key_package(right) is not equal to 0:
        return 15
    set closed to discord_dave_close(right)
    display "PASS: native DAVE session/version binding, malformed identity rejection, missing symbols, binary key package ownership and repeat-safe cleanup across ten sessions, overlapping logger lifetimes and native failure callback denial."
    return 0
