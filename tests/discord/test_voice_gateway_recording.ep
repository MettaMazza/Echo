import "../../app/discord/voice_recording_gate_confirmation"
import "../../app/discord/gateway_journal"
import "../../app/discord/voice_gateway_tick"
import "../../app/discord/voice_playback_confirmation"

define fixture_own_state with journal as Int and sequence as Int and muted as Int and deafened as Int returning Int:
    set body to concat("{\"guild_id\":\"100\",\"user_id\":\"900\",\"channel_id\":\"200\",\"session_id\":\"bot-session\",\"mute\":false,\"suppress\":false,\"deaf\":false,\"self_mute\":" and int_to_string(muted))
    set body to concat(body and concat(",\"self_deaf\":" and concat(int_to_string(deafened) and "}")))
    # JSON booleans, not integer surrogates, are required by the real boundary.
    set body to string_replace(body and ":0" and ":false")
    set body to string_replace(body and ":1" and ":true")
    set recorded to discord_gateway_dispatch_voice(journal and "generation" and "session" and sequence and "VOICE_STATE_UPDATE" and ep_sha256(body) and "" and "" and body)
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 90
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_gateway_schema(journal) is not equal to 0 or else discord_voice_leave_schema(journal) is not equal to 0 or else discord_voice_gateway_send_schema(journal) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(journal and "generation" and "session")
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set library to ep_dlopen(get_argument(2))
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and library)
    set added to append_list(socket and 1)
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set evidence to ep_sha256("access")
    set requested to discord_voice_intent_request(journal and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claimed to discord_voice_intent_claim(journal and "join" and "generation" and 1 and evidence)
    if not (discord_voice_gateway_send(journal and socket and "join" and archive_list_text(claimed and 1) and "generation" and 0 and 1 and 0 and "/absent-fixture-stop") equals "sent"):
        return 2
    set owned to fixture_own_state(journal and 2 and 1 and 1)
    set setup to sql_execute(journal and "CREATE TABLE discord_voice_connections(identity TEXT PRIMARY KEY,generation TEXT,state TEXT); INSERT INTO discord_voice_connections VALUES('join','generation','identified'); INSERT INTO discord_voice_recordings VALUES('record','join','400','300','request','active','700','receipt'); INSERT INTO discord_voice_recording_gates VALUES('record','join','generation','session',2,'proof','900','bot-session','pending');")
    if setup is not equal to 0:
        return 3
    if not (discord_voice_recording_gate_send(journal and socket and "record" and "old" and "/absent-fixture-stop") equals "stale-recording-gateway") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 4
    set setup to sql_execute(journal and "INSERT INTO discord_voice_playback_gates VALUES('join','generation','session',2,'play-proof','pending');")
    if not (discord_voice_gateway_tick(journal and socket and "generation" and "/absent-fixture-stop" and "900") equals "sent"):
        return 5
    if not (ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text"))) equals discord_voice_gateway_state_body("100" and "200" and 1 and 0)):
        return 6
    if not (discord_voice_recording_gate_send(journal and socket and "record" and "generation" and "/absent-fixture-stop") equals "recording-gate-already-attempted") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 2:
        return 7
    if not (discord_voice_playback_gate_send(journal and socket and "join" and "generation" and "/absent-fixture-stop") equals "voice-media-awaiting-confirmation") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 2:
        return 19
    set owned to fixture_own_state(journal and 3 and 1 and 0)
    if not (discord_voice_playback_gate_send(journal and socket and "join" and "generation" and "/absent-fixture-stop") equals "voice-playback-gate-revoked") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 2:
        return 20
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_intents WHERE identity='join';"))
    if not (archive_list_text(row and 1) equals "sent"):
        return 21
    # Native proof renewal is covered by test_voice_playback_gate. This fixture
    # supplies the renewed durable projection to exercise sole-owner dispatch.
    set setup to sql_execute(journal and "UPDATE discord_voice_playback_gates SET state='pending',after_sequence=3,evidence='fresh-play-proof' WHERE identity='join';")
    if not (discord_voice_gateway_tick(journal and socket and "generation" and "/absent-fixture-stop" and "900") equals "sent"):
        return 8
    if not (ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text"))) equals discord_voice_gateway_state_body("100" and "200" and 0 and 0)):
        return 9
    set owned to fixture_own_state(journal and 4 and 0 and 0)
    set credentials to ["100","900","bot-session",""]
    set connection to create_list()
    set added to append_list(connection and 0)
    set added to append_list(connection and credentials)
    set added to append_list(connection and "200")
    set added to append_list(connection and 0)
    set owner to create_list()
    set added to append_list(owner and connection)
    set added to append_list(owner and "join")
    set added to append_list(owner and "generation")
    set added to append_list(owner and "900")
    if discord_voice_playback_gate_confirmed(journal and owner) is not equal to 1:
        return 10
    if discord_voice_recording_gate_confirmed(journal and owner and "record") is not equal to 1 or else discord_voice_recording_gate_confirmed(journal and owner and "other-recording") is not equal to -1:
        return 22
    set server_deaf to "{\"guild_id\":\"100\",\"user_id\":\"900\",\"channel_id\":\"200\",\"session_id\":\"bot-session\",\"self_mute\":false,\"self_deaf\":false,\"deaf\":true,\"mute\":false,\"suppress\":false}"
    set recorded to discord_gateway_dispatch_voice(journal and "generation" and "session" and 5 and "VOICE_STATE_UPDATE" and ep_sha256(server_deaf) and "" and "" and server_deaf)
    if discord_voice_recording_gate_confirmed(journal and owner and "record") is not equal to -1:
        return 23
    set owned to fixture_own_state(journal and 6 and 0 and 0)
    if discord_voice_recording_gate_confirmed(journal and owner and "record") is not equal to 1:
        return 24
    set stopped to discord_voice_recording_stop(journal and "record")
    if not (discord_voice_gateway_tick(journal and socket and "generation" and "/absent-fixture-stop" and "900") equals "close-sent"):
        return 11
    if not (ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text"))) equals discord_voice_gateway_state_body("100" and "200" and 0 and 1)) or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 4:
        return 12
    set reconciled to discord_voice_recording_gate_reconcile(journal)
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_recording_gates WHERE recording='record';"))
    if not (archive_list_text(row and 1) equals "close-sent") or else discord_voice_playback_gate_confirmed(journal and owner) is not equal to 1:
        return 13
    set owned to fixture_own_state(journal and 7 and 0 and 1)
    set reconciled to discord_voice_recording_gate_reconcile(journal)
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_recording_gates WHERE recording='record';"))
    if not (archive_list_text(row and 1) equals "closed") or else discord_voice_playback_gate_confirmed(journal and owner) is not equal to 1:
        return 14
    set setup to sql_execute(journal and "INSERT INTO discord_voice_recordings VALUES('second','join','400','300','request2','active','701','receipt2'); INSERT INTO discord_voice_recording_gates VALUES('second','join','generation','session',7,'proof','900','bot-session','pending');")
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 1)
    if not (discord_voice_recording_gate_send(journal and socket and "second" and "generation" and "/absent-fixture-stop") equals "uncertain"):
        return 15
    if not (discord_voice_gateway_recover(journal and "generation") equals "voice-recovered"):
        return 16
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_intents WHERE identity='join';"))
    if not (archive_list_text(row and 1) equals "leave-required") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 17
    if not (discord_voice_recording_gate_send(journal and socket and "second" and "generation" and "/absent-fixture-stop") equals "recording-gate-already-attempted") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 18
    display "PASS: sole Gateway owner undeafens once while preserving mute, playback preserves recording, stop restores deafening without muting playback, closing waits for server state, and uncertain writes require leave without replay."
    return 0
