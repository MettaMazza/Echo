import "../../app/discord/agent_bridge"

# Runs only on the isolated database produced by test_group_offers. This is
# checkpoint storage/context acceptance, not a model-generated recap verdict.
define main returning Int:
    if get_argument_count() is not equal to 2 or else not file_exists(get_argument(1)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set run to agent_run_read(database and "discord-message:101")
    if database equals 0 or else run equals 0:
        return 2
    set session to archive_list_text(run and 0)
    set seed to concat("discord-public-seed:" and ep_sha256(session))
    if checkpoint_stage(database and "public-seed-checkpoint" and session and seed and "" and "Fixture recap intentionally omits the seed words to verify retained source context." and "{}" and "{\"fixture\":true}") is not equal to 0 or else checkpoint_activate(database and session and "public-seed-checkpoint") is not equal to 0:
        return 3
    set messages to session_messages_snapshot(database and session and "discord-message:101")
    if string_contains(messages and "public-seed-checkpoint") equals 0 or else string_contains(messages and "amber-lantern") equals 0 or else string_contains(messages and "What public exchange started this conversation?") equals 0:
        return 4
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(1) and "900")
    if not (session_messages_snapshot(database and session and "discord-message:101") equals messages):
        return 5
    set values to create_list()
    set added to append_list(values and session)
    set origin to history_collect_one(checkpoint_prepare(database and "SELECT group_id FROM echo_group_sessions WHERE session=?1;" and values))
    set principal to principal_for_device(database and "discord:500")
    if not (discord_joined_change(database and "discord:500" and "200" and "300" and "leave-after-checkpoint" and archive_list_text(origin and 1) and principal and "left" and 5) equals "recorded"):
        return 6
    if string_length(public_group_seed_context(database and "discord-message:101" and session)) is not equal to 0:
        return 7
    display "PASS: attributed public seed and current request survive checkpoint/reopen; departed member loses seed-context access. No model recap was claimed."
    return 0
