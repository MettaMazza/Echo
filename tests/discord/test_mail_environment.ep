import "../../app/discord/process"

define main returning Int:
    if get_argument_count() > 1:
        set expected to get_argument(1)
        set voice to ptr_to_str(get_env("ECHO_MAIL_ROOT"))
        set scoped to ptr_to_str(get_env("ECHO_DISCORD_MAIL_ROOT"))
        if not (voice equals expected) or else not (scoped equals expected):
            return 2
        set expected_policy to ""
        set expected_digest to ""
        if string_length(expected) > 0:
            set expected_policy to "/protected/mail-policy.json"
            set expected_digest to "fixture-digest"
        if not (ptr_to_str(get_env("ECHO_MAIL_POLICY_PATH")) equals expected_policy) or else not (ptr_to_str(get_env("ECHO_DISCORD_MAIL_POLICY_PATH")) equals expected_policy) or else not (ptr_to_str(get_env("ECHO_MAIL_POLICY_SHA256")) equals expected_digest) or else not (ptr_to_str(get_env("ECHO_DISCORD_MAIL_POLICY_SHA256")) equals expected_digest):
            return 6
        if string_length(ptr_to_str(get_env("ECHO_TEST_PRIVATE_SECRET"))) > 0:
            return 3
        if get_argument_count() equals 3:
            return check_child([expected])
        return 0
    set configured to set_env("ECHO_MAIL_ROOT" and "/generic/mail")
    set configured to set_env("ECHO_MAIL_POLICY_PATH" and "/generic/policy.json")
    set configured to set_env("ECHO_MAIL_POLICY_SHA256" and "generic-digest")
    set configured to set_env("ECHO_TEST_PRIVATE_SECRET" and "must-not-cross")
    if check_child([""]) is not equal to 0:
        return 4
    set configured to set_env("ECHO_DISCORD_MAIL_ROOT" and "/private/mail")
    set configured to set_env("ECHO_DISCORD_MAIL_POLICY_PATH" and "/protected/mail-policy.json")
    set configured to set_env("ECHO_DISCORD_MAIL_POLICY_SHA256" and "fixture-digest")
    if check_child(["/private/mail", "recursive"]) is not equal to 0:
        return 5
    display "PASS: generic mailbox configuration is excluded; explicit mailbox root and policy bindings reach child and grandchild; unrelated secrets remain excluded."
    return 0

define check_child with arguments as List returning Int:
    set child to discord_process_start(arguments and -1)
    if child < 0:
        return 1
    repeat while 1 equals 1:
        set state to discord_process_poll(child)
        if state equals 1:
            return 0
        if state is not equal to 0:
            return 1
        set slept to sleep_ms(10)
    return 1
