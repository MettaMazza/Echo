import "../../app/discord/gateway_intake"

define reaction_envelope with sequence as Int and kind as Str and data as Str returning Str:
    return concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":" and concat(provider_quote(kind) and concat(",\"d\":" and concat(data and "}"))))))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 2
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"reaction-session\",\"resume_gateway_url\":\"wss://gateway.discord.gg\"}}"
    if not (discord_gateway_ready_record(database and "reaction-socket" and "900" and ready) equals "recorded"):
        return 3
    set created to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"queued\"}"
    if not (discord_gateway_intake(database and "reaction-socket" and "900" and ["200"] and ["400"] and reaction_envelope(2 and "MESSAGE_CREATE" and created)) equals "recorded"):
        return 4
    set reaction to "{\"message_id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"user_id\":\"500\",\"emoji\":{\"id\":null,\"name\":\"✅\"},\"member\":{\"nick\":\"PRIVATE_EXTRA_FIELD\"}}"
    set normalized to discord_reaction_observation(database and "900" and reaction and ["200"] and ["400"])
    if not (normalized equals "{\"channel_id\":\"300\",\"message_id\":\"100\",\"user_id\":\"500\",\"guild_id\":\"200\",\"emoji_id\":\"\",\"emoji_name\":\"✅\"}"):
        return 5
    set event to reaction_envelope(3 and "MESSAGE_REACTION_ADD" and reaction)
    if not (discord_gateway_intake(database and "reaction-socket" and "900" and ["200"] and ["400"] and event) equals "recorded"):
        return 6
    if not (discord_gateway_intake(database and "reaction-socket" and "900" and ["200"] and ["400"] and event) equals "already-recorded"):
        return 7
    for each invalid in ["{\"message_id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"user_id\":\"900\",\"emoji\":{\"id\":null,\"name\":\"✅\"}}","{\"message_id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"user_id\":\"501\",\"emoji\":{\"id\":null,\"name\":\"✅\"}}","{\"message_id\":\"100\",\"channel_id\":\"301\",\"guild_id\":\"200\",\"user_id\":\"500\",\"emoji\":{\"id\":null,\"name\":\"✅\"}}","{\"message_id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"201\",\"user_id\":\"500\",\"emoji\":{\"id\":null,\"name\":\"✅\"}}","{\"message_id\":\"999\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"user_id\":\"500\",\"emoji\":{\"id\":null,\"name\":\"✅\"}}"]:
        if string_length(discord_reaction_observation(database and "900" and ptr_to_str(invalid) and ["200"] and ["400"])) > 0:
            return 8
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE kind='MESSAGE_REACTION_ADD';"))
    if not (archive_list_text(count and 1) equals "1"):
        return 9
    set leaked to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE payload LIKE '%PRIVATE_EXTRA_FIELD%';"))
    if not (archive_list_text(leaked and 1) equals "0"):
        return 10
    display "PASS: scoped reaction observation, bot/foreign-source rejection, minimal payload and replay deduplication; no control execution."
    return 0
