import "../../app/discord/voice_connection_owner"

define fixture_prepare with library as Int and path as Str returning List:
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and ep_dlopen(path))
    set added to append_list(socket and 1)
    set credentials to create_list()
    set credentials to ["100","300","fixture-session","fixture-token","voice.example.discord.media"]
    set prepared to create_list()
    set added to append_list(prepared and socket)
    set added to append_list(prepared and credentials)
    set added to append_list(prepared and "200")
    set added to append_list(prepared and 0)
    return prepared

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 90
    set library to ep_dlopen(get_argument(1))
    set paths to create_list()
    set paths to ["unused","unused","unused"]
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set prepared to fixture_prepare(library and get_argument(1))
    set credentials to get_list(prepared and 1)
    set owner to discord_voice_connection_activate(prepared and paths and 1 and 100 and 1 and 0)
    if owner equals 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 1
    set sent to ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text")))
    if not (sent equals discord_voice_identify_body("100" and "300" and "fixture-session" and "fixture-token" and 1)):
        return 2
    if discord_voice_connection_activate(prepared and paths and 1 and 100 and 1 and 0) is not equal to 0:
        return 3
    set closed to discord_voice_prepared_close(prepared)
    if not (archive_list_text(credentials and 3) equals "fixture-token"):
        return 4
    set result to discord_voice_connection_tick(owner and 101 and 10001 and 1 and 1 and 1)
    if not (archive_list_text(result and 0) equals "voice-cancelled") or else not (archive_list_text(credentials and 3) equals ""):
        return 5
    set closed to discord_voice_connection_close(owner)
    if ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 6
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set prepared to fixture_prepare(library and get_argument(1))
    set credentials to get_list(prepared and 1)
    if discord_voice_connection_activate(prepared and paths and 1 and 100 and 0 and 0) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0 or else not (archive_list_text(credentials and 3) equals ""):
        return 7
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 1)
    set prepared to fixture_prepare(library and get_argument(1))
    set credentials to get_list(prepared and 1)
    if discord_voice_connection_activate(prepared and paths and 1 and 100 and 1 and 0) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1 or else not (archive_list_text(credentials and 3) equals ""):
        return 8
    set closed to discord_voice_prepared_close(prepared)
    if ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 9
    set closed to ep_dlclose(library)
    display "PASS: Identify activation transfers socket/credentials once; fresh authorization gates writes; partial write and cancellation clear private owner and close once."
    return 0
