import "../../app/discord/voice_recording_status"
import "../../app/discord/voice_recording_artifact"
import "../../app/discord/voice_recording_transcript_publication"
import "../../app/discord/voice_options"
import "../../app/discord/agent_bridge"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    if database equals 0 or else journal equals 0:
        return 2
    set mode to get_argument(3)
    set owner to history_collect_one(archive_prepare(journal and "SELECT identity,request,state FROM discord_voice_recordings LIMIT 1;"))
    if mode equals "no-audio":
        if discord_voice_recording_artifact_schema(journal) is not equal to 0 or else discord_voice_recording_publication_schema(database) is not equal to 0 or else discord_recording_transcript_publication_schema(database) is not equal to 0:
            return 3
        if not (discord_voice_recording_artifact_discover(journal) equals "recording-artifact-discovered"):
            return 4
    set call to history_collect_one(checkpoint_prepare(database and "SELECT run,call_id FROM echo_tool_calls WHERE request_event=?1;" and [archive_list_text(owner and 2)]))
    if not (archive_list_text(call and 0) equals "found"):
        return 5
    set output to discord_recording_status_assets(journal and database and archive_list_text(call and 1) and archive_list_text(call and 2) and archive_list_text(owner and 1) and archive_list_text(owner and 2) and archive_list_text(owner and 3) and "0" and 1)
    display output
    set tokens to provider_json_tokens(output)
    if tokens equals 0:
        return 6
    if mode equals "normal":
        if not (provider_value(tokens and provider_member(tokens and 0 and "stage")) equals "complete") or else not (provider_value(tokens and provider_member(tokens and 0 and "has_more")) equals "true"):
            return 7
        set after to provider_value(tokens and provider_member(tokens and 0 and "next_after"))
        set next to discord_recording_status_assets(journal and database and archive_list_text(call and 1) and archive_list_text(call and 2) and archive_list_text(owner and 1) and archive_list_text(owner and 2) and archive_list_text(owner and 3) and after and 1)
        display next
        set full to discord_recording_status_assets(journal and database and archive_list_text(call and 1) and archive_list_text(call and 2) and archive_list_text(owner and 1) and archive_list_text(owner and 2) and archive_list_text(owner and 3) and "0" and 100)
        display full
        set denied to discord_recording_status_assets(journal and database and "unrelated-run" and "unrelated-call" and archive_list_text(owner and 1) and archive_list_text(owner and 2) and archive_list_text(owner and 3) and "0" and 100)
        if not (denied equals "{\"stage\":\"unavailable\"}"):
            return 8
    if mode equals "options":
        set base to "{\"operation\":\"status\",\"intent\":\"x\",\"recording\":\"r\""
        for each tail in [",\"limit\":0}",",\"limit\":101}",",\"limit\":1.5}",",\"limit\":\"1\"}",",\"after\":\"-1\"}",",\"after\":\"01\"}",",\"after\":\"1; DROP TABLE x\"}",",\"after\":1}"]:
            if archive_list_text(discord_voice_options(concat(base and tail)) and 0) equals "valid":
                return 9
        set selected to discord_voice_options(concat(base and ",\"after\":\"123\",\"limit\":100}"))
        if not (archive_list_text(selected and 0) equals "valid") or else not (archive_list_text(selected and 5) equals "123") or else not (archive_list_text(selected and 6) equals "100"):
            return 10
        for each invalid in ["{\"operation\":\"stop\",\"intent\":\"x\",\"recording\":\"r\",\"limit\":1}","{\"operation\":\"status\",\"intent\":\"x\",\"limit\":1}","{\"operation\":\"play\",\"intent\":\"x\",\"attachment\":\"a\",\"after\":\"0\"}"]:
            if archive_list_text(discord_voice_options(invalid) and 0) equals "valid":
                return 11
        display "PASS: typed recording-only pagination arguments."
    set closed to sql_close(database)
    set closed to sql_close(journal)
    return 0
