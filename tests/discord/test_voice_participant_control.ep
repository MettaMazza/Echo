import "../../app/discord/voice_participant_control"

define main returning Int:
    set participants to discord_voice_participants_new("100" and "200" and "300" and 7)
    set changed to discord_voice_participants_update(participants and 7 and "100" and "200" and "300" and "bot")
    set changed to discord_voice_participants_update(participants and 7 and "100" and "200" and "400" and "member")
    set handshake to discord_voice_handshake_new(2)
    set changed to set_list(handshake and 0 and 4)
    set action to discord_voice_handshake_receive(handshake and "{\"op\":5,\"seq\":10,\"d\":{\"user_id\":\"400\",\"ssrc\":1234,\"speaking\":1}}" and 100 and 2)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 1) equals "stale-participant-control") or else not (discord_voice_participants_user(participants and 7 and 1234) equals ""):
        return 1
    if not (discord_voice_participant_control(participants and handshake and action and 6 and 2) equals "stale-participant-control") or else not (discord_voice_participants_user(participants and 7 and 1234) equals ""):
        return 12
    set changed to set_list(handshake and 0 and 3)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 2) equals "participant-control-before-session") or else not (discord_voice_participants_user(participants and 7 and 1234) equals ""):
        return 13
    set changed to set_list(handshake and 0 and 4)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 2) equals "audio-identity-mapped") or else not (discord_voice_participants_user(participants and 7 and 1234) equals "400") or else get_list(get_list(handshake and 1) and 5) is not equal to 10:
        return 2
    set action to discord_voice_handshake_receive(handshake and "{\"op\":5,\"seq\":11,\"d\":{\"user_id\":\"999\",\"ssrc\":4321,\"speaking\":1}}" and 100 and 2)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 2) equals "unknown-voice-participant") or else length_list(discord_voice_participants_roster(participants and 7)) is not equal to 2 or else get_list(get_list(handshake and 1) and 5) is not equal to 10:
        return 3
    set action to discord_voice_handshake_receive(handshake and "{\"op\":13,\"seq\":12,\"d\":{\"user_id\":\"400\"}}" and 100 and 2)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 2) equals "audio-identity-retired") or else not (discord_voice_participants_user(participants and 7 and 1234) equals "") or else length_list(discord_voice_participants_roster(participants and 7)) is not equal to 2:
        return 4
    set action to discord_voice_handshake_receive(handshake and "{\"op\":5,\"seq\":13,\"d\":{\"user_id\":\"400\",\"ssrc\":1234,\"speaking\":0}}" and 100 and 2)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 2) equals "audio-identity-mapped"):
        return 5
    set action to discord_voice_handshake_receive(handshake and "{\"op\":5,\"seq\":14,\"d\":{\"user_id\":\"300\",\"ssrc\":1234,\"speaking\":1}}" and 100 and 2)
    if not (discord_voice_participant_control(participants and handshake and action and 7 and 2) equals "ambiguous-audio-identity") or else discord_voice_participants_valid(participants and 7) is not equal to 0 or else get_list(get_list(handshake and 1) and 5) is not equal to 13:
        return 6
    if not (archive_list_text(discord_voice_control_decode("{\"op\":5,\"d\":{\"user_id\":400,\"ssrc\":1234,\"speaking\":1}}") and 0) equals "invalid-voice-control"):
        return 7
    if not (archive_list_text(discord_voice_control_decode("{\"op\":5,\"d\":{\"user_id\":\"400\",\"ssrc\":0,\"speaking\":1}}") and 0) equals "invalid-voice-control"):
        return 8
    if not (archive_list_text(discord_voice_control_decode("{\"op\":5,\"d\":{\"user_id\":\"400\",\"ssrc\":4294967296,\"speaking\":1}}") and 0) equals "invalid-voice-control"):
        return 9
    if not (archive_list_text(discord_voice_control_decode("{\"op\":5,\"d\":{\"user_id\":\"400\",\"ssrc\":1234,\"speaking\":8}}") and 0) equals "invalid-voice-control"):
        return 10
    if not (archive_list_text(discord_voice_control_decode("{\"op\":5,\"d\":{\"user_id\":\"400\",\"ssrc\":1234,\"speaking\":-1}}") and 0) equals "invalid-voice-control"):
        return 11
    display "PASS: speaking identity uses current Gateway membership and socket generation; unknown users, collisions and malformed controls rejected; disconnect retires SSRC without inventing membership or consent."
    return 0
