import "../../app/discord/agent_bridge"
import "../../app/discord/job_provision"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0:
        return 2
    if not (discord_job_provision(database and "901" and get_argument(2)) equals "discord-binding-mismatch") or else file_exists(get_argument(2)):
        return 3
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set owner to archive_runtime_lock(database and library)
    if owner < 0:
        return 4
    if not (discord_job_provision(database and "900" and get_argument(2)) equals "runtime-active") or else file_exists(get_argument(2)):
        return 5
    set closed to net_close(owner)
    set closed to ep_dlclose(library)
    set status to discord_job_provision(database and "900" and get_argument(2))
    if not (status equals "provisioned"):
        display status
        return 6
    set version to history_collect_one(archive_prepare(database and "SELECT MAX(version) FROM echo_schema_migrations;"))
    if not (archive_list_text(version and 1) equals "26"):
        return 7
    set backup to sql_open(get_argument(2))
    set absent to history_collect_one(archive_prepare(backup and "SELECT COUNT(*) FROM sqlite_master WHERE name='echo_delegations';"))
    if not (archive_list_text(absent and 1) equals "0") or else archive_verify_all(backup) is not equal to 0:
        return 8
    set closed to sql_close(backup)
    # A repeated operation cannot overwrite the original recovery snapshot.
    if not (discord_job_provision(database and "900" and get_argument(2)) equals "backup-failed"):
        return 9
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else archive_verify_all(database) is not equal to 0:
        return 10
    set journal_path to concat(get_argument(1) and ".journal")
    set journal to discord_store_open(journal_path and "900")
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Job provisioning must wait for this run.\"}"
    if journal equals 0 or else not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original) equals "recorded"):
        return 11
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 12
    set second_backup to concat(get_argument(2) and ".active")
    if not (discord_job_provision(database and "900" and second_backup) equals "runs-unresolved") or else file_exists(second_backup):
        return 13
    display "PASS: bound Discord job migration, exclusive ownership, preserved recovery snapshot and reopen."
    return sql_close(database)
