import "../../app/discord/cancel_control"
import "../../app/transport/local_socket"

define cancel_source_later with path as Str and completed as Int returning Int:
    set waited to sleep_ms(150)
    set journal to discord_store_open(path and "900")
    set result to discord_cancel_source(journal and "message:create:100" and "500" and "300" and "200" and "socket-test")
    set closed to sql_close(journal)
    send result to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_worker_schema(journal) is not equal to 0:
        return 2
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:100"):
        return 3
    set listener to local_socket_listen(0)
    set library to get_list(listener and 0)
    set cancellation to socket_cancellation_create(library)
    set stop to socket_cancellation_create(library)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    set monitored to channel
    set requested to channel
    set monitor_path to concat(get_argument(1) and "")
    set request_path to concat(get_argument(1) and "")
    set stop_path to concat(get_argument(1) and ".stop")
    spawn discord_turn_monitor(monitor_path and "900" and 99999 and "100" and "300" and "200" and stop_path and get_list(stop and 0) and get_list(cancellation and 1) and monitored)
    spawn cancel_source_later(request_path and requested)
    set chunk to socket_read_chunk(library and accepted and get_list(cancellation and 0))
    if not (ptr_to_str(get_list(chunk and 0)) equals "cancelled"):
        return 4
    set result to receive from requested
    set monitor_result to receive from monitored
    if not (ptr_to_str(result) equals "cancel-requested") or else monitor_result is not equal to 0:
        return 5
    set closed to net_close(get_list(stop and 1))
    set closed to net_close(get_list(cancellation and 0))
    set closed to net_close(client)
    set closed to net_close(accepted)
    set closed to local_socket_close(listener)
    set closed to sql_close(journal)
    display "PASS: durable Discord cancellation wakes a blocked native socket read through the production turn monitor."
    return 0
