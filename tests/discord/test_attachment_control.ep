import "../../app/discord/attachment_control"
import "../../app/jobs/delegation_schema"

define attachment_control_arguments with action as Str and source as Str and identity as Str and previous as Str returning Str:
    set output to "{"
    for each pair in [["action",action],["attachment",source],["identity",identity],["previous",previous]]:
        if string_length(output) > 1:
            set output to concat(output and ",")
        set output to concat(output and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1)))))
    return concat(output and "}")

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)) or else file_exists(concat(get_argument(2) and ".shared")):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","c"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set private to web_submit_owned(database and "a" and "private" and "" and "Private attachment fixture")
    if agent_cancel_run(database and "private") is not equal to 0 or else write_file(get_argument(2) and "Retained original copper fern") is not equal to 1 or else web_attachment_register(database and "a" and archive_list_text(private and 1) and "host-file" and get_argument(2) and "host.txt" and "text/plain") is not equal to 0:
        return 4
    if not (group_create(database and "a" and "g" and "discord" and "100" and "200" and "g") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "discord" and "100" and "200" and 3) equals "created"):
        return 5
    if write_file(concat(get_argument(2) and ".shared") and "Retained original copper fern") is not equal to 1 or else web_attachment_register(database and "a" and "shared" and "source" and concat(get_argument(2) and ".shared") and "shared.txt" and "text/plain") is not equal to 0:
        return 6
    set listing to discord_attachment_list(database and "b" and "100" and "200" and "shared")
    if string_contains(listing and "shared.txt") equals 0 or else string_contains(listing and "host.txt") is not equal to 0 or else string_contains(discord_attachment_list(database and "a" and "100" and "200" and archive_list_text(private and 1)) and "not-authorized") equals 0:
        return 16
    set query to attachment_control_arguments("trash" and "source" and "trash" and "")
    if not (discord_attachment_request(database and "c" and "100" and "200" and "lifecycle" and query) equals "not-authorized") or else not (discord_attachment_request(database and "a" and "101" and "200" and "lifecycle" and query) equals "not-authorized") or else not (discord_attachment_request(database and "a" and "100" and "201" and "lifecycle" and query) equals "not-authorized"):
        return 7
    if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and attachment_control_arguments("trash" and "host-file" and "host" and "")) equals "not-authorized"):
        return 8
    if not (discord_attachment_request(database and "b" and "100" and "200" and "lifecycle" and query) equals "recorded") or else not (discord_attachment_request(database and "b" and "100" and "200" and "lifecycle" and query) equals "already-recorded") or else attachment_selectable(database and "source") is not equal to 0 or else attachment_context_included(database and "source") is not equal to 1:
        return 9
    if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and attachment_control_arguments("restore" and "source" and "stale" and "")) equals "revision-conflict"):
        return 10
    set query to attachment_control_arguments("exclude" and "source" and "exclude" and "")
    if not (discord_attachment_request(database and "a" and "100" and "200" and "visibility" and query) equals "recorded") or else attachment_context_included(database and "source") is not equal to 0:
        return 11
    for each arguments in ["{}","{\"action\":\"trash\",\"attachment\":\"source\",\"identity\":\"x\",\"previous\":\"\",\"device\":\"a\"}"]:
        if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and arguments) equals "invalid-arguments"):
            return 12
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and attachment_control_arguments("restore" and "source" and "restore" and "attachment-lifecycle:b:trash")) equals "recorded") or else not (discord_attachment_request(database and "a" and "100" and "200" and "visibility" and attachment_control_arguments("restore" and "source" and "include" and "attachment-visibility:a:exclude")) equals "recorded"):
        return 13
    if attachment_selectable(database and "source") is not equal to 1 or else attachment_context_included(database and "source") is not equal to 1 or else not (ptr_to_str(read_file(concat(get_argument(2) and ".shared"))) equals "Retained original copper fern") or else archive_verify(database and "shared") is not equal to 0:
        return 14
    if not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded") or else not (discord_attachment_request(database and "b" and "100" and "200" and "visibility" and query) equals "not-authorized"):
        return 15
    display "PASS: Discord attachment namespace isolation, owner/member changes, immutable retry, stale revision, distinct trash/context policy, retained bytes, restart restore and removed-member denial."
    return sql_close(database)
