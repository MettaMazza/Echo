import "../../app/discord/voice_recording_transcription"
import "../../app/discord/agent_bridge"

define main returning Int:
    if get_argument_count() is not equal to 8:
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    if database equals 0 or else journal equals 0:
        return 2
    if get_argument(7) equals "recording-publication-authority-denied":
        set fixture to ep_dlopen(get_argument(3))
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 18 and str_to_ptr(get_argument(2)))
        set configured to ep_dlcall1(ep_dlsym(fixture and "fixture_recording_archive") and str_to_ptr(get_argument(1)))
    set config to create_list()
    set added to append_list(config and get_argument(3))
    set added to append_list(config and "fixture-token-no-network-123456")
    set added to append_list(config and get_argument(2))
    set added to append_list(config and get_argument(1))
    set added to append_list(config and get_argument(5))
    set added to append_list(config and "900")
    set guilds to ["200"]
    set admins to ["500"]
    set added to append_list(config and guilds)
    set added to append_list(config and admins)
    set added to append_list(config and get_argument(4))
    set added to append_list(config and concat(get_argument(5) and "/stop"))
    set row to history_collect_one(archive_prepare(journal and "SELECT identity FROM discord_voice_recording_artifacts ORDER BY after_nonce LIMIT 1;"))
    if not (archive_list_text(row and 0) equals "found"):
        return 3
    set result to discord_recording_transcribe(journal and database and config and archive_list_text(row and 1) and ptr_to_str(read_file(get_argument(6))) and get_argument(5))
    display result
    if not (result equals get_argument(7)):
        return 4
    if result equals "recording-transcription-staged":
        set repeated to discord_recording_transcribe(journal and database and config and archive_list_text(row and 1) and ptr_to_str(read_file(get_argument(6))) and get_argument(5))
        if not (repeated equals result):
            return 5
    set closed to sql_close(journal)
    set closed to sql_close(database)
    return 0
