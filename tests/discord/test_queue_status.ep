import "../../app/discord/queue_control_store"
import "../../app/discord/worker_delivery"

define queue_status_response with actor as Str and source as Str and position as Int returning Str:
    return concat("{\"id\":\"999\",\"author\":{\"id\":" and concat(provider_quote(actor) and concat("},\"message_reference\":{\"message_id\":" and concat(provider_quote(source) and concat("},\"content\":" and concat(provider_quote(discord_queue_status_text(position)) and "}"))))))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_queue_control_schema(journal) is not equal to 0:
        return 2
    set index to 1
    repeat while index <= 12:
        set message to int_to_string(100 + index)
        set body to concat("{\"id\":" and concat(provider_quote(message) and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}"))
        if not (discord_inbox_record(journal and concat("message:create:" and message) and "MESSAGE_CREATE" and body) equals "recorded"):
            return 3
        set index to index + 1
    set source to "message:create:112"
    set output to "queue-status:message:create:112"
    if not (discord_queue_status_plan(journal and "message:create:110" and 10) equals "not-needed") or else not (discord_queue_status_plan(journal and source and 12) equals "tracked") or else not (discord_queue_status_plan(journal and source and 12) equals "tracked"):
        return 4
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(count and 1) equals "1") or else not (archive_list_text(discord_reply_due(journal and ep_time_now_ms()) and 0) equals "end"):
        return 5
    if not (archive_list_text(discord_outbox_claim(journal and output and "attempt") and 0) equals "claimed") or else not (discord_outbox_finish(journal and output and "attempt" and "sent" and "999" and "synthetic confirmed transport") equals "recorded"):
        return 6
    if not (discord_queue_status_observe(journal and source and "900" and 12 and queue_status_response("901" and "112" and 12)) equals "queue-status-unconfirmed") or else not (discord_queue_status_observe(journal and source and "900" and 12 and queue_status_response("900" and "111" and 12)) equals "queue-status-unconfirmed"):
        return 7
    if not (discord_queue_status_observe(journal and source and "900" and 12 and queue_status_response("900" and "112" and 12)) equals "observed"):
        return 8
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT applied,output FROM discord_queue_status WHERE source=?1;" and [source]))
    if not (archive_list_text(row and 1) equals "12") or else not (archive_list_text(row and 2) equals output):
        return 9
    # A delayed acknowledgement records what was shown, not the newer rank.
    set claimed to discord_worker_claim(journal)
    if discord_queue_position(journal and source) is not equal to 11:
        return 10
    if not (discord_queue_status_observe(journal and source and "900" and 11 and queue_status_response("900" and "112" and 12)) equals "queue-status-unconfirmed") or else not (discord_queue_status_observe(journal and source and "900" and 11 and queue_status_response("900" and "112" and 11)) equals "observed"):
        return 11
    if string_index_of(discord_queue_status_text(1234) and "1234") < 0 or else not (discord_queue_status_text(0) equals "This message has left the queue."):
        return 12
    if sql_execute(journal and "UPDATE discord_queue_status SET source='message:create:111';") equals 0:
        return 13
    if not (discord_queue_status_close(journal and source and "status-message-missing") equals "queue-status-closed") or else not (discord_queue_status_tick("" and "" and journal and source and "900" and ["200"] and [] and "" and "") equals "queue-status-closed"):
        return 14
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(count and 1) equals "1"):
        return 15
    # Reopen with a durable POST intent but no status binding: the queue may
    # have fallen below ten before recovery. Reuse, never abandon or duplicate.
    set body to "{\"content\":\"Queue position updating…\",\"allowed_mentions\":{\"parse\":[],\"replied_user\":false},\"message_reference\":{\"message_id\":\"111\",\"fail_if_not_exists\":true}}"
    if not (discord_outbox_enqueue(journal and "queue-status:message:create:111" and "message:create:111" and "300" and body) equals "enqueued"):
        return 16
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_queue_status_plan(journal and "message:create:111" and 9) equals "tracked"):
        return 17
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(count and 1) equals "2"):
        return 18
    display "PASS: exact overflow rank, one durable reply, conversation sender exclusion, observed author/source/content binding, restart retention, stale acknowledgement rejection and immutable binding. Live HTTP remains pending."
    return 0
