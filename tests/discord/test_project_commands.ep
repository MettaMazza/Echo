import "../../app/discord/project_delivery"
import "../../app/discord/command_registration"
import "../../app/security/group_session_selection"
import "../../app/web/uploads"

# Native authenticated intake fixture; no network or live account is involved.
define project_command_fixture with journal as Int and identity as Str and arguments as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT json_group_array(json_object('type',3,'name',key,'value',value)) FROM json_each(?1);" and [arguments]))
    set options to archive_list_text(row and 1)
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT json_object('id',?1,'type',2,'application_id','900','guild_id','200','channel_id','300','member',json('{\"user\":{\"id\":\"400\"}}'),'data',json_object('type',1,'id','805','name','project','options',json(?2)));" and [identity,options]))
    set body to archive_list_text(source and 1)
    set inbox to concat("interaction:" and identity)
    if not (discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledged',CAST(?2 AS INTEGER),'fixture');" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_project_credential_1234','fixture',CAST(?2 AS INTEGER),CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define project_command_run with journal as Int and database as Int and identity as Str and arguments as Str returning Str:
    set body to project_command_fixture(journal and identity and arguments)
    set result to discord_project_prepare(journal and database and concat("interaction:" and identity) and body and "900" and ["200"] and create_list())
    if archive_list_text(result and 0) equals "found":
        return archive_list_text(result and 1)
    return concat("{\"status\":" and concat(provider_quote(archive_list_text(result and 0)) and "}"))

define project_command_field with result as Str and name as Str returning Str:
    set tokens to provider_json_tokens(result)
    return provider_value(tokens and provider_member(tokens and 0 and name))

define project_command_args with database as Int and action as Str and session as Str and project as Str and revision as Str and extra as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_patch(json_object('action',?1,'session',?2,'project',?3,'revision',?4),json(?5));" and [action,session,project,revision,extra]))
    return archive_list_text(row and 1)

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied") or else web_upload_schema(database) is not equal to 0:
        return 2
    if discord_control_command_matches(discord_control_command_definition("project") and "project") is not equal to 1 or else discord_control_command_matches(string_replace(discord_control_command_definition("project") and "\"type\":3" and "\"type\":4") and "project") is not equal to 0:
        return 3
    if not (discord_command_observe(journal and "{\"id\":\"805\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"project\"}" and "900" and "200") equals "registered"):
        return 4
    set device to discord_agent_principal(database and "400" and create_list())
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "project-first" and "Project test" and create_list())
    set session to archive_list_text(first and 1)
    set args to project_command_args(database and "create" and session and "" and "" and "{\"name\":\"Café garden\",\"instructions\":\"Keep violet flowers.\"}")
    set created to project_command_run(journal and database and "701" and args)
    if not (project_command_field(created and "status") equals "recorded"):
        display created
        return 5
    set project to project_command_field(created and "project")
    set revision to project_command_field(created and "revision")
    set args to project_command_args(database and "task" and session and project and revision and "{\"task\":\"one\",\"title\":\"Read the original\",\"status\":\"doing\"}")
    set changed to project_command_run(journal and database and "702" and args)
    if not (project_command_field(changed and "status") equals "recorded"):
        display changed
        return 6
    set revision to project_command_field(changed and "revision")
    set task_revision to revision
    set args to project_command_args(database and "edit" and session and project and revision and "{\"instructions\":\"Preserve café and Unicode 🌿.\"}")
    set changed to project_command_run(journal and database and "703" and args)
    if not (project_command_field(changed and "status") equals "recorded"):
        return 7
    set revision to project_command_field(changed and "revision")
    set args to project_command_args(database and "read" and session and project and "" and "{}")
    set readback to project_command_run(journal and database and "704" and args)
    if string_contains(readback and "Read the original") equals 0 or else string_contains(readback and "Unicode 🌿") equals 0:
        return 8
    set prior to history_collect_one(checkpoint_prepare(journal and "SELECT payload FROM discord_inbox WHERE identity='interaction:702';" and create_list()))
    set retry to discord_project_prepare(journal and database and "interaction:702" and archive_list_text(prior and 1) and "900" and ["200"] and create_list())
    if not (archive_list_text(retry and 0) equals "found") or else not (project_command_field(archive_list_text(retry and 1) and "revision") equals task_revision):
        return 9
    set stale to project_command_run(journal and database and "706" and project_command_args(database and "edit" and session and project and project_command_field(created and "revision") and "{\"name\":\"Stale\"}"))
    if not (project_command_field(stale and "status") equals "project-rejected:revision-conflict"):
        return 10
    set upload to web_upload_prepare(database and device and session and get_argument(3) and "notes.txt" and "text/plain")
    if string_length(upload) equals 0 or else web_upload_claim(database and device and upload) is not equal to 0:
        return 11
    set staging to web_upload_owned(database and device and upload)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to file_stage_open(library and archive_list_text(staging and 2))
    set text to "Project file café"
    if descriptor < 0 or else file_stage_write(library and descriptor and str_to_ptr(text) and string_length(text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0 or else web_upload_register(database and device and upload) is not equal to 0:
        return 12
    set extra to history_collect_one(checkpoint_prepare(database and "SELECT json_object('attachment',?1);" and [upload]))
    set changed to project_command_run(journal and database and "707" and project_command_args(database and "file" and session and project and revision and archive_list_text(extra and 1)))
    if not (project_command_field(changed and "status") equals "recorded"):
        display changed
        return 13
    set revision to project_command_field(changed and "revision")
    set files to project_command_run(journal and database and "708" and project_command_args(database and "files" and session and "" and "" and "{}"))
    if string_contains(files and upload) equals 0 or else string_contains(files and ep_sha256(text)) equals 0:
        return 14
    set changed to project_command_run(journal and database and "709" and project_command_args(database and "remove-file" and session and project and revision and archive_list_text(extra and 1)))
    set revision to project_command_field(changed and "revision")
    if not (project_command_field(changed and "status") equals "recorded"):
        return 15
    set changed to project_command_run(journal and database and "710" and project_command_args(database and "remove-task" and session and project and revision and "{\"task\":\"one\"}"))
    if not (project_command_field(changed and "status") equals "recorded"):
        return 16
    for each action in ["use","clear"]:
        set action_identity to "712"
        if action equals "clear":
            set action_identity to "713"
        set changed to project_command_run(journal and database and action_identity and project_command_args(database and ptr_to_str(action) and session and project and "" and "{}"))
        if not (project_command_field(changed and "status") equals "recorded"):
            return 17
    set files to project_command_run(journal and database and "711" and project_command_args(database and "files" and session and "" and "" and "{}"))
    if string_contains(files and upload) equals 0:
        return 18
    set forbidden to string_replace(archive_list_text(prior and 1) and "\"id\":\"400\"" and "\"id\":\"401\"")
    if not (archive_list_text(discord_project_prepare(journal and database and "interaction:702" and forbidden and "900" and ["200"] and create_list()) and 0) equals "project-not-authorized"):
        return 19
    if archive_verify(database and session) is not equal to 0:
        return 20
    display "PASS: registered project commands, Unicode edits, task and file add/remove, immutable retry response, stale-edit refusal, use/clear, source retention, actor substitution denial and archive integrity"
    return 0
