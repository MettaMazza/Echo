import "../../app/discord/audit_audience"

define audit_test_mask with choice as Int returning Str:
    if choice equals 1:
        return "128"
    if choice equals 2:
        return "1024"
    if choice equals 3:
        return "1152"
    return "0"

define audit_test_role with identity as Str and choice as Int returning Str:
    return concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"permissions\":" and concat(provider_quote(audit_test_mask(choice)) and "}"))))

define audit_test_overwrite with identity as Str and choice as Int returning Str:
    set allow to "0"
    set deny to "0"
    if choice equals 1:
        set allow to "1024"
    if choice equals 2:
        set deny to "1024"
    return concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":0,\"allow\":" and concat(provider_quote(allow) and concat(",\"deny\":" and concat(provider_quote(deny) and "}"))))))

define audit_role_combinations_test returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"900\"}"
    set selections to create_list()
    set selections to ["[]","[\"201\"]","[\"202\"]","[\"201\",\"202\"]"]
    set scenario to 0
    repeat while scenario < 1728:
        set permission_choices to scenario modulo 64
        set overwrite_choices to scenario / 64
        set roles to concat("[" and audit_test_role("200" and permission_choices modulo 4))
        set roles to concat(roles and concat("," and audit_test_role("201" and (permission_choices / 4) modulo 4)))
        set roles to concat(roles and concat("," and concat(audit_test_role("202" and permission_choices / 16) and "]")))
        set overwrites to concat("[" and audit_test_overwrite("200" and overwrite_choices modulo 3))
        set overwrites to concat(overwrites and concat("," and audit_test_overwrite("201" and (overwrite_choices / 3) modulo 3)))
        set overwrites to concat(overwrites and concat("," and concat(audit_test_overwrite("202" and overwrite_choices / 9) and "]")))
        set room_body to concat("{\"id\":\"300\",\"guild_id\":\"200\",\"permission_overwrites\":" and concat(overwrites and "}"))
        set safe to 1
        for each selected in selections:
            set member to concat("{\"user\":{\"id\":\"400\"},\"roles\":" and concat(ptr_to_str(selected) and "}"))
            if discord_channel_permission(server and roles and member and room_body and "200" and "400" and "300" and 10) equals 1 and also discord_member_guild_permission(server and roles and member and "200" and "400" and 7) is not equal to 1:
                set safe to 0
        if discord_audit_role_audience(server and roles and room_body and "200" and "300") is not equal to safe:
            display scenario
            return 1
        set scenario to scenario + 1
    display "PASS: audit role-audience proof matches all member role combinations across 1728 permission/overwrite scenarios."
    return 0
