import "../../app/discord/scheduled_event_view"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"1024\",\"managed\":false}]"
    set member to "{\"user\":{\"id\":\"500\"},\"roles\":[]}"
    set channel_body to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":2,\"permission_overwrites\":[]}"
    set event_body to "{\"id\":\"700\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"name\":\"Visible event\",\"entity_type\":2,\"status\":1,\"creator\":{\"email\":\"secret\"},\"unknown\":\"secret\",\"entity_metadata\":null,\"recurrence_rule\":null}"
    set visible to discord_event_view(event_body and "200" and server and roles and member and "500" and channel_body)
    if string_length(visible) equals 0 or else string_contains(visible and "secret") equals 1 or else string_contains(visible and "creator") equals 1:
        return 1
    set denied_channel to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":2,\"permission_overwrites\":[{\"id\":\"500\",\"type\":1,\"allow\":\"0\",\"deny\":\"1024\"}]}"
    if string_length(discord_event_view(event_body and "200" and server and roles and member and "500" and denied_channel)) > 0:
        return 2
    set other_channel to "{\"id\":\"301\",\"guild_id\":\"200\",\"type\":2,\"permission_overwrites\":[]}"
    if string_length(discord_event_view(event_body and "200" and server and roles and member and "500" and other_channel)) > 0:
        return 3
    if string_length(discord_event_view(event_body and "201" and server and roles and member and "500" and channel_body)) > 0:
        return 4
    if string_length(discord_event_view(event_body and "200" and server and roles and member and "501" and channel_body)) > 0:
        return 5
    set external_body to "{\"id\":\"701\",\"guild_id\":\"200\",\"channel_id\":null,\"name\":\"Outside\",\"entity_type\":3,\"status\":1,\"entity_metadata\":{\"location\":\"Garden\",\"secret\":\"hidden\"}}"
    set visible to discord_event_view(external_body and "200" and server and roles and member and "500" and "")
    if string_length(visible) equals 0 or else string_contains(visible and "hidden") equals 1 or else string_contains(visible and "Garden") equals 0:
        return 6
    set users to "[{\"guild_scheduled_event_id\":\"700\",\"user\":{\"id\":\"501\",\"username\":\"alice\",\"global_name\":\"Alice\",\"email\":\"hidden\"},\"member\":{\"roles\":[\"secret\"],\"joined_at\":\"hidden\"}}]"
    set projected to discord_event_users_view(users and "700")
    if not (projected equals "[{\"id\":\"501\",\"username\":\"alice\",\"global_name\":\"Alice\"}]"):
        return 7
    if string_length(discord_event_users_view(users and "701")) > 0:
        return 8
    set duplicate_users to "[{\"guild_scheduled_event_id\":\"700\",\"user\":{\"id\":\"501\",\"username\":\"a\"}},{\"guild_scheduled_event_id\":\"700\",\"user\":{\"id\":\"501\",\"username\":\"b\"}}]"
    if string_length(discord_event_users_view(duplicate_users and "700")) > 0:
        return 9
    if not (discord_event_users_view("[]" and "700") equals "[]") or else string_length(discord_event_users_view("{}" and "700")) > 0:
        return 10
    set malformed to "{\"id\":\"701\",\"guild_id\":\"200\",\"channel_id\":null,\"name\":\"Outside\",\"entity_type\":3,\"status\":1,\"entity_metadata\":{\"location\":\"Garden\"},\"image\":{\"secret\":\"hidden\"}}"
    if string_length(discord_event_view(malformed and "200" and server and roles and member and "500" and "")) > 0:
        return 11
    set malformed to "{\"id\":\"701\",\"id\":\"702\",\"guild_id\":\"200\",\"channel_id\":null,\"name\":\"Outside\",\"entity_type\":3,\"status\":1}"
    if string_length(discord_event_view(malformed and "200" and server and roles and member and "500" and "")) > 0:
        return 12
    set recurrence_body to "{\"start\":\"2026-10-23T18:00:00Z\",\"end\":\"2026-11-23T18:00:00Z\",\"frequency\":1,\"interval\":1,\"by_n_weekday\":[{\"n\":2,\"day\":3}],\"count\":3}"
    set recurrence_fields to provider_json_tokens(recurrence_body)
    if discord_event_recurrence_view_valid(recurrence_fields and 0) is not equal to 1:
        return 13
    set recurrence_body to "{\"start\":\"2026-10-23T18:00:00Z\",\"frequency\":1,\"interval\":1,\"by_n_weekday\":[{\"n\":2,\"day\":3,\"private_profile\":\"secret\"}]}"
    set recurrence_fields to provider_json_tokens(recurrence_body)
    if discord_event_recurrence_view_valid(recurrence_fields and 0) is not equal to 0:
        return 14
    set recurrence_body to "{\"start\":\"2026-10-23T18:00:00Z\",\"frequency\":1,\"interval\":1,\"by_month\":[{\"private_profile\":\"secret\"}]}"
    set recurrence_fields to provider_json_tokens(recurrence_body)
    if discord_event_recurrence_view_valid(recurrence_fields and 0) is not equal to 0:
        return 15
    set iteration to 0
    repeat while iteration < 200:
        set visible to discord_event_view(event_body and "200" and server and roles and member and "500" and channel_body)
        if string_length(visible) equals 0 or else string_contains(visible and "secret") equals 1:
            return 16
        set projected to discord_event_users_view(users and "700")
        if not (projected equals "[{\"id\":\"501\",\"username\":\"alice\",\"global_name\":\"Alice\"}]"):
            return 17
        set iteration to iteration + 1
    display "PASS: scheduled-event current audience/channel/guild binding, public field projection, private profile omission, interested-user identity and duplicate-event rejection."
    return 0
