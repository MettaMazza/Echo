import "../../app/discord/scheduled_event_effective"

define main returning Int:
    set flat to "{\"operation\":\"create\",\"reason\":\"Fixture\",\"entity_type\":2,\"scheduled_start_time\":\"2026-11-01T12:00:00Z\",\"channel_id\":\"300\",\"description\":\"Exact late description\",\"name\":\"Fixture\"}"
    set options to discord_event_options(flat)
    if not (archive_list_text(options and 0) equals "valid"):
        return 1
    set payload to archive_list_text(options and 5)
    set fields to provider_json_tokens(payload)
    if not (provider_value(fields and provider_member(fields and 0 and "description")) equals "Exact late description"):
        return 2
    set effective to discord_event_effective("{}" and payload and 1 and discord_event_timestamp("2026-10-22T00:00:00Z"))
    if not (archive_list_text(effective and 0) equals "valid") or else not (archive_list_text(effective and 3) equals "300"):
        return 3
    set nested to concat("{\"operation\":\"create\",\"reason\":\"Fixture\",\"changes\":" and concat(payload and "}"))
    if not (archive_list_text(discord_event_options(nested) and 5) equals payload):
        return 4
    set invalid_cases to ["{\"operation\":\"edit\",\"changes\":{},\"image\":null}","{\"operation\":\"list\",\"image\":null}","{\"operation\":\"create\",\"name\":\"a\",\"name\":\"b\"}","{\"operation\":\"create\",\"unrecognised\":1}"]
    for each item in invalid_cases:
        if archive_list_text(discord_event_options(ptr_to_str(item)) and 0) equals "valid":
            return 5
    set cleared to discord_event_options("{\"operation\":\"edit\",\"event\":\"400\",\"reason\":\"Fixture\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"image\":null,\"description\":null,\"recurrence_rule\":null}")
    if not (archive_list_text(cleared and 0) equals "valid"):
        return 6
    set fields to provider_json_tokens(archive_list_text(cleared and 5))
    set cleared_keys to ["image","description","recurrence_rule"]
    for each item in cleared_keys:
        if not (provider_kind(fields and provider_member(fields and 0 and ptr_to_str(item))) equals "null"):
            return 7
    set explicit_clear to discord_event_options("{\"operation\":\"edit\",\"event\":\"400\",\"reason\":\"Fixture\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"clear_fields\":[\"image\",\"description\",\"recurrence_rule\"]}")
    if not (archive_list_text(explicit_clear and 0) equals "valid") or else not (archive_list_text(explicit_clear and 5) equals archive_list_text(cleared and 5)):
        return 8
    set bad_clears to ["{\"operation\":\"edit\",\"clear_fields\":[\"name\"]}","{\"operation\":\"edit\",\"clear_fields\":[\"image\",\"image\"]}","{\"operation\":\"edit\",\"clear_fields\":[]}","{\"operation\":\"edit\",\"clear_fields\":[\"image\"],\"image\":null}","{\"operation\":\"edit\",\"clear_fields\":[\"image\"],\"changes\":{}}"]
    for each item in bad_clears:
        if string_length(discord_event_normalize(ptr_to_str(item))) > 0:
            return 9
    display "PASS: unordered flat event fields, archived nested compatibility, explicit clearing and ambiguous/unknown/duplicate rejection."
    return 0
