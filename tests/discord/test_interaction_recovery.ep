import "../../app/discord/interaction_recovery"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    if discord_interaction_original_matches("{\"id\":\"700\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"},\"flags\":192}" and "900" and "300") is not equal to 1:
        return 2
    for each body in ["{}", "{\"id\":\"700\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"},\"flags\":0}", "{\"id\":\"700\",\"channel_id\":\"301\",\"author\":{\"id\":\"900\"},\"flags\":64}", "{\"id\":\"700\",\"channel_id\":\"300\",\"author\":{\"id\":\"901\"},\"flags\":64}"]:
        if discord_interaction_original_matches(ptr_to_str(body) and "900" and "300") is not equal to 0:
            return 3
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_interaction_schema(journal) is not equal to 0:
        return 4
    set saved to discord_inbox_record(journal and "interaction:800" and "INTERACTION_CREATE" and "{}")
    if sql_execute(journal and "INSERT INTO discord_interaction_jobs VALUES('interaction:800','uncertain',0,'uncertain');") is not equal to 0:
        return 5
    # No continuation credential: expire without opening network or retrying
    # the original callback. Reopen keeps that terminal evidence.
    if not (discord_interaction_recover("" and "" and journal and "interaction:800" and "900" and "") equals "ack-expired"):
        return 6
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set row to history_collect_one(archive_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity='interaction:800';"))
    if not (archive_list_text(row and 1) equals "expired") or else not (archive_list_text(row and 2) equals "unresolved-ack-credential-expired"):
        return 7
    display "PASS: only private bot response in original channel proves acceptance; missing credentials expire without callback replay; reopen retains evidence"
    return 0
