import "../../app/discord/gateway_discovery"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_budget_schema(database) is not equal to 0:
        return 2
    set body to "{\"url\":\"wss://gateway.discord.gg\",\"session_start_limit\":{\"total\":1000,\"remaining\":2,\"reset_after\":20000,\"max_concurrency\":1}}"
    set discovery to discord_gateway_discovery(body and 1000)
    if not (archive_list_text(discovery and 0) equals "discovered"):
        return 3
    if not (discord_gateway_identify_reserve(database and 1000) equals "discovery-required"):
        return 4
    if discord_gateway_budget_record(database and discovery and 1000) is not equal to 0:
        return 5
    if not (discord_gateway_identify_reserve(database and 1000) equals "reserved"):
        return 6
    if not (discord_gateway_identify_reserve(database and 5999) equals "identify-rate-limited"):
        return 7
    if discord_gateway_budget_record(database and discovery and 5999) is not equal to 0:
        return 8
    if not (discord_gateway_identify_reserve(database and 6000) equals "reserved") or else not (discord_gateway_identify_reserve(database and 11000) equals "budget-exhausted"):
        return 9
    if not (discord_gateway_identify_reserve(database and 21000) equals "discovery-expired"):
        return 10
    set refreshed to discord_gateway_discovery(body and 21000)
    if discord_gateway_budget_record(database and refreshed and 21000) is not equal to 0 or else not (discord_gateway_identify_reserve(database and 21000) equals "reserved"):
        return 11
    set invalid to discord_gateway_discovery("{\"url\":\"wss://attacker.example\",\"session_start_limit\":{\"total\":10,\"remaining\":2,\"reset_after\":20000,\"max_concurrency\":1}}" and 1000)
    if not (archive_list_text(invalid and 0) equals "invalid-discovery"):
        return 12
    set zero to discord_gateway_discovery("{\"url\":\"wss://gateway.discord.gg\",\"session_start_limit\":{\"total\":1000,\"remaining\":1000,\"reset_after\":0,\"max_concurrency\":1}}" and 50000)
    if not (archive_list_text(zero and 0) equals "discovered") or else not (archive_list_text(zero and 2) equals "1") or else not (archive_list_text(zero and 3) equals "0"):
        return 13
    if discord_gateway_budget_record(database and zero and 50000) is not equal to 0 or else not (discord_gateway_identify_reserve(database and 50001) equals "reserved") or else not (discord_gateway_identify_reserve(database and 56000) equals "budget-exhausted"):
        return 14
    if discord_gateway_budget_record(database and zero and 51000) is not equal to 0 or else not (discord_gateway_identify_reserve(database and 51000) equals "identify-rate-limited") or else not (discord_gateway_identify_reserve(database and 56001) equals "reserved"):
        return 15
    print "PASS: discovery origin, durable Identify reservations, rate limit, exhaustion and fresh reset"
    return 0
