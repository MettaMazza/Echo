import "../../app/discord/activity_stream"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"The prompt remains in the channel.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    if archive_append(database and session and "first-activity" and "model_request" and "{\"run_id\":\"discord-message:100\"}" and "fixture") is not equal to 0:
        return 5
    set stream to discord_activity_stream_open(journal and "message:create:100" and "discord-message:100" and "100" and 0)
    if string_length(stream) equals 0 or else not (discord_activity_stream_step(journal and database and stream) equals "waiting"):
        return 6
    set first to discord_activity_stream_pending(journal and stream)
    if not (archive_list_text(first and 0) equals "found"):
        return 7
    # A later event must not alter the already frozen page on restart.
    if archive_append(database and session and "second-activity" and "tool_result" and "{\"run_id\":\"discord-message:100\",\"result\":\"Later receipt.\"}" and "fixture") is not equal to 0:
        return 8
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_activity_stream_open(journal and "message:create:100" and "discord-message:100" and "100" and 0) equals stream) or else not (discord_activity_stream_step(journal and database and stream) equals "waiting"):
        return 9
    set again to discord_activity_stream_pending(journal and stream)
    if not (archive_list_text(again and 1) equals archive_list_text(first and 1)):
        return 10
    # Fixture receipt states exercise transport boundaries without network.
    if sql_execute(journal and "UPDATE discord_outbox SET state='uncertain';") is not equal to 0 or else not (discord_activity_stream_commit(journal and stream) equals "waiting"):
        return 11
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='';") is not equal to 0 or else not (discord_activity_stream_commit(journal and stream) equals "waiting"):
        return 12
    if sql_execute(journal and "UPDATE discord_outbox SET message='700';") is not equal to 0 or else not (discord_activity_stream_step(journal and database and stream) equals "advanced"):
        return 13
    if not (discord_activity_stream_step(journal and database and stream) equals "waiting"):
        return 14
    set later to discord_activity_stream_pending(journal and stream)
    if not (archive_list_text(later and 0) equals "found") or else archive_list_text(later and 1) equals archive_list_text(first and 1):
        return 15
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*),MIN(channel),MAX(channel),SUM(instr(body,'The prompt remains')>0) FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "2") or else not (archive_list_text(row and 2) equals "100") or else not (archive_list_text(row and 3) equals "100") or else not (archive_list_text(row and 4) equals "0"):
        return 16
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='701' WHERE state='pending';") is not equal to 0 or else not (discord_activity_stream_step(journal and database and stream) equals "advanced") or else not (discord_activity_stream_step(journal and database and stream) equals "caught-up"):
        return 17
    # Full trace backlog uses a separate destination, preserving earlier fixtures.
    set stream to discord_activity_stream_open(journal and "message:create:100" and "discord-message:100" and "101" and 1)
    set count to 0
    repeat while count < 600:
        set marker to concat("[fragment-" and concat(int_to_string(count) and "-🎧] "))
        set wire to concat("{\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":" and concat(provider_quote(marker) and "}}]}"))
        set payload to concat("{\"request_event\":\"first-activity\",\"data\":" and concat(provider_quote(wire) and "}"))
        if archive_append(database and session and concat("fragment-" and int_to_string(count)) and "provider_event" and payload and "fixture") is not equal to 0:
            return 19
        set count to count + 1
    set pages to 0
    repeat while pages < 3:
        if not (discord_activity_stream_step(journal and database and stream) equals "waiting"):
            return 20
        set frozen to discord_activity_stream_pending(journal and stream)
        set closed to sql_close(journal)
        set journal to discord_store_open(get_argument(1) and "900")
        if not (discord_activity_stream_step(journal and database and stream) equals "waiting"):
            return 21
        set retained to discord_activity_stream_pending(journal and stream)
        if not (archive_list_text(frozen and 1) equals archive_list_text(retained and 1)):
            return 22
        if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE state='pending';") is not equal to 0 or else not (discord_activity_stream_step(journal and database and stream) equals "advanced"):
            return 23
        set pages to pages + 1
    if not (discord_activity_stream_step(journal and database and stream) equals "caught-up"):
        return 24
    set count to 0
    repeat while count < 600:
        set marker to concat("[fragment-" and concat(int_to_string(count) and "-🎧] "))
        set row to history_collect_one(checkpoint_prepare(journal and "SELECT SUM((length(content)-length(replace(content,?1,'')))/length(?1)) FROM discord_activity_pages WHERE destination='101';" and [marker]))
        if not (archive_list_text(row and 1) equals "1"):
            return 25
        set count to count + 1
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_activity_pages p WHERE p.content<>(SELECT group_concat(text,'') FROM (SELECT json_extract(o.body,'$.content') AS text FROM discord_outbox o WHERE substr(o.identity,1,length(p.identity)+1)=p.identity||':' ORDER BY o.rowid));"))
    if not (archive_list_text(row and 1) equals "0"):
        return 26
    set row to history_collect_one(archive_prepare(journal and "SELECT MAX(length(CAST(json_extract(body,'$.content') AS BLOB))),COUNT(*) FROM discord_outbox WHERE channel='101';"))
    if http_decimal(archive_list_text(row and 1)) > 1800 or else http_decimal(archive_list_text(row and 2)) >= 19:
        return 27
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else not (discord_activity_stream_step(journal and database and stream) equals "scope-denied"):
        return 28
    display "PASS: 600 reasoning deltas, three bounded pages, exact UTF-8 reconstruction, frozen restart and revocation"
    return 0
