import "../../app/discord/activity_transport"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"400\"}}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded") or else not (discord_activity_plan(journal and "message:create:100") equals "planned"):
        return 2
    set wrong to "{\"id\":\"101\",\"parent_id\":\"300\",\"guild_id\":\"200\",\"owner_id\":\"900\",\"type\":11}"
    if not (discord_activity_observe(journal and "message:create:100" and wrong) equals "thread-binding-mismatch"):
        return 3
    set wrong to "{\"id\":\"100\",\"parent_id\":\"301\",\"guild_id\":\"200\",\"owner_id\":\"900\",\"type\":11}"
    if not (discord_activity_observe(journal and "message:create:100" and wrong) equals "thread-binding-mismatch"):
        return 4
    set wrong to "{\"id\":\"100\",\"parent_id\":\"300\",\"guild_id\":\"200\",\"owner_id\":\"901\",\"type\":11}"
    if not (discord_activity_observe(journal and "message:create:100" and wrong) equals "thread-binding-mismatch"):
        return 5
    set observed_channel to "{\"id\":\"100\",\"parent_id\":\"300\",\"guild_id\":\"200\",\"owner_id\":\"900\",\"type\":11,\"thread_metadata\":{\"archived\":false}}"
    if not (discord_activity_observe(journal and "message:create:100" and observed_channel) equals "ready") or else not (discord_activity_observe(journal and "message:create:100" and observed_channel) equals "ready"):
        return 6
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_activity_plan(journal and "message:create:100") equals "ready"):
        return 7
    set row to history_collect_one(archive_prepare(journal and "SELECT source,thread,COUNT(*) FROM discord_activity_threads;"))
    if not (archive_list_text(row and 1) equals "100") or else not (archive_list_text(row and 2) equals "100") or else not (archive_list_text(row and 3) equals "1"):
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_activity_thread_events;"))
    if not (archive_list_text(row and 1) equals "1"):
        return 9
    set dm to "{\"id\":\"102\",\"channel_id\":\"302\",\"author\":{\"id\":\"400\"}}"
    if not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and dm) equals "recorded") or else not (discord_activity_plan(journal and "message:create:102") equals "native-thread-unavailable"):
        return 10
    display "PASS: exact originating-message thread binding, foreign owner/channel rejection, duplicate observation and restart persistence"
    return 0
