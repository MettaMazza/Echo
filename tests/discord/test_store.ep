import "../../app/discord/store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set path to get_argument(1)
    set database to discord_store_open(path and "900")
    if database equals 0:
        return 2
    if not (discord_inbox_record(database and "message:100" and "MESSAGE_CREATE" and "{\"id\":\"100\"}") equals "recorded"):
        return 3
    if not (discord_inbox_record(database and "message:100" and "MESSAGE_CREATE" and "{\"id\":\"100\"}") equals "already-recorded") or else not (discord_inbox_record(database and "message:100" and "MESSAGE_CREATE" and "{\"id\":\"101\"}") equals "identity-conflict"):
        return 4
    set body to "{\"content\":\"Hello\",\"allowed_mentions\":{\"parse\":[]}}"
    if not (discord_outbox_enqueue(database and "reply:100:0" and "message:100" and "300" and body) equals "enqueued") or else not (discord_outbox_enqueue(database and "reply:100:0" and "message:100" and "300" and body) equals "already-enqueued"):
        return 5
    if not (discord_outbox_enqueue(database and "reply:100:0" and "message:100" and "301" and body) equals "identity-conflict"):
        return 6
    set first to discord_outbox_claim(database and "reply:100:0" and "attempt-1")
    if not (archive_list_text(first and 0) equals "claimed") or else not (archive_list_text(discord_outbox_claim(database and "reply:100:0" and "attempt-2") and 0) equals "not-pending"):
        return 7
    set closed to sql_close(database)
    set database to discord_store_open(path and "900")
    if database equals 0 or else not (archive_list_text(discord_outbox_claim(database and "reply:100:0" and "after-crash") and 0) equals "not-pending"):
        return 8
    if not (discord_outbox_finish(database and "reply:100:0" and "wrong-attempt" and "sent" and "700" and "HTTP 200") equals "stale-attempt"):
        return 9
    if not (discord_outbox_finish(database and "reply:100:0" and "attempt-1" and "sent" and "700" and "HTTP 200") equals "recorded"):
        return 10
    if not (discord_reply_channel(database and "700" and "300") equals "300") or else string_length(discord_reply_channel(database and "700" and "301")) is not equal to 0:
        return 11
    if not (discord_outbox_enqueue(database and "reply:100:1" and "message:100" and "300" and body) equals "enqueued") or else not (archive_list_text(discord_outbox_claim(database and "reply:100:1" and "attempt-3") and 0) equals "claimed"):
        return 12
    if not (discord_outbox_finish(database and "reply:100:1" and "attempt-3" and "uncertain" and "" and "connection lost after request") equals "recorded") or else not (archive_list_text(discord_outbox_claim(database and "reply:100:1" and "attempt-4") and 0) equals "not-pending"):
        return 13
    set checked to history_collect_one(archive_prepare(database and "PRAGMA quick_check;"))
    if not (archive_list_text(checked and 1) equals "ok"):
        return 14
    set closed to sql_close(database)
    if discord_store_open(path and "901") is not equal to 0:
        return 15
    display "PASS: immutable inbox dedup/conflicts, idempotent outbox, committed claims, crash/reopen without resend, stale attempt refusal, exact-channel reply binding and uncertain delivery retention."
    return 0
