import "../../app/discord/access"

define read_fixture_add with snapshot as List and route as Str and bucket as Str and major as Str and body as Str returning Int:
    set response to ["observed",body,ep_sha256(body)]
    return append_list(snapshot and [route,bucket,major,"0",response])

define read_fixture with channel_body as Str and parent as Str returning List:
    set snapshot to create_list()
    set added to read_fixture_add(snapshot and "/channels/400" and "GET:channel" and "400" and channel_body)
    set added to read_fixture_add(snapshot and "/channels/500" and "GET:channel" and "500" and parent)
    set added to read_fixture_add(snapshot and "/guilds/200" and "GET:guild" and "200" and "{\"id\":\"200\",\"owner_id\":\"999\"}")
    set added to read_fixture_add(snapshot and "/guilds/200/roles" and "GET:roles" and "200" and "[{\"id\":\"200\",\"permissions\":\"66560\"}]")
    set added to read_fixture_add(snapshot and "/guilds/200/members/900" and "GET:member" and "200" and "{\"user\":{\"id\":\"900\"},\"roles\":[]}")
    set added to read_fixture_add(snapshot and "/guilds/200/members/300" and "GET:member" and "200" and "{\"user\":{\"id\":\"300\"},\"roles\":[],\"communication_disabled_until\":\"2099-01-01T00:00:00Z\"}")
    return snapshot

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0:
        return 2
    set room to "{\"id\":\"400\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[]}"
    set parent to "{\"id\":\"500\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[]}"
    set archived to "{\"id\":\"400\",\"guild_id\":\"200\",\"type\":11,\"parent_id\":\"500\",\"thread_metadata\":{\"archived\":true,\"locked\":true}}"
    set admins to ["300"]
    for each channel_body in [room,archived]:
        set snapshot to read_fixture(channel_body and parent)
        set result to discord_access_read_snapshot("" and "" and journal and "" and "900" and "200" and "400" and "300" and admins and snapshot)
        if not (archive_list_text(result and 0) equals "allowed"):
            display result
            return 3
        set sending to discord_access_check_snapshot("" and "" and journal and "" and "900" and "200" and "400" and "300" and admins and -1 and create_list() and snapshot)
        if archive_list_text(sending and 0) equals "allowed":
            return 4
    set denied to "{\"id\":\"400\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[{\"id\":\"300\",\"type\":1,\"allow\":\"0\",\"deny\":\"65536\"}]}"
    set result to discord_access_read_snapshot("" and "" and journal and "" and "900" and "200" and "400" and "300" and admins and read_fixture(denied and parent))
    if not (archive_list_text(result and 0) equals "history-permission-denied"):
        display result
        return 5
    display "PASS: read-only history access permits archived/locked threads and send-restricted members; send gates unchanged; requester history denial enforced."
    return sql_close(journal)
