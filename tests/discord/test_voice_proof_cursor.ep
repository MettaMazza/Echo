import "../../app/providers/archived_stream"
import "../../app/discord/voice_proof_cursor"

define main returning Int:
    set journal to sql_open(":memory:")
    if journal equals 0 or else sql_execute(journal and "CREATE TABLE discord_dispatch(session TEXT,sequence INTEGER,kind TEXT,digest TEXT,PRIMARY KEY(session,sequence)); INSERT INTO discord_dispatch VALUES('session',2,'MESSAGE_CREATE','fixture'),('session',3,'MESSAGE_CREATE','fixture'),('session',5,'MESSAGE_CREATE','fixture'),('other',4,'MESSAGE_CREATE','fixture');") is not equal to 0:
        return 1
    if discord_voice_proof_messages_only(journal and "session" and 1 and 3) is not equal to 1 or else discord_voice_proof_messages_only(journal and "session" and 3 and 3) is not equal to 1:
        return 2
    if discord_voice_proof_messages_only(journal and "session" and 1 and 5) is not equal to 0 or else discord_voice_proof_messages_only(journal and "other" and 1 and 3) is not equal to 0 or else discord_voice_proof_messages_only(journal and "session" and 3 and 1) is not equal to 0 or else discord_voice_proof_messages_only(journal and "" and 3 and 3) is not equal to 0:
        return 3
    set kinds to ["MESSAGE_UPDATE","MESSAGE_DELETE","MESSAGE_DELETE_BULK","GUILD_MEMBER_UPDATE","GUILD_ROLE_UPDATE","CHANNEL_UPDATE","THREAD_UPDATE","THREAD_MEMBER_UPDATE","VOICE_STATE_UPDATE","VOICE_SERVER_UPDATE","RESUMED","UNKNOWN_NEW_EVENT"]
    for each kind in kinds:
        set changed to sql_execute(journal and "DELETE FROM discord_dispatch WHERE session='session' AND sequence=4;")
        set name to ptr_to_str(kind)
        set keys to create_list()
        set added to append_list(keys and name)
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_dispatch VALUES('session',4,?1,'fixture');" and keys) and 101) is not equal to 0:
            return 4
        if discord_voice_proof_messages_only(journal and "session" and 1 and 5) is not equal to 0:
            display name
            return 5
    set closed to sql_close(journal)
    display "PASS: only contiguous same-session MESSAGE_CREATE receipts preserve voice proof; gaps, edits, authority/membership changes and unknown events invalidate."
    return 0
