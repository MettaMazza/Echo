import "../../app/discord/agent_bridge"
import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    if database equals 0 or else journal equals 0:
        return 2
    set admins to create_list()
    set admins to ["400"]
    set guilds to create_list()
    set guilds to ["200"]
    set body to "{\"id\":\"100\",\"channel_id\":\"300\",\"type\":0,\"author\":{\"id\":\"500\"},\"content\":\"Inspect configured guild onboarding\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:100")
    if string_contains(schemas and "discord_onboarding") is not equal to 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:500" and "discord-message:100" and "discord_onboarding" and "{\"guild\":\"200\",\"operation\":\"inspect\"}")
    if string_contains(outcome and "admin-required") equals 0:
        display outcome
        return 6
    set body to "{\"id\":\"101\",\"channel_id\":\"300\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"Inspect configured guild onboarding\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]}"
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:101")
    if string_contains(schemas and "discord_onboarding") is not equal to 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:400" and "discord-message:101" and "discord_onboarding" and "{\"guild\":\"200\",\"operation\":\"inspect\"}")
    if string_contains(outcome and "audience-restricted") equals 0:
        display outcome
        return 6
    set body to "{\"id\":\"102\",\"channel_id\":\"301\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"Inspect configured guild onboarding\"}"
    if not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:102" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:102")
    if string_contains(schemas and "discord_onboarding") equals 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:400" and "discord-message:102" and "discord_onboarding" and "{\"guild\":\"200\",\"operation\":\"inspect\"}")
    if string_contains(outcome and "discord-runtime-unavailable") equals 0:
        display outcome
        return 6
    if tool_policy_allows(database and "discord-message:102" and "jobs" and "discord_onboarding") is not equal to 1 or else tool_policy_allows(database and "discord-message:102" and "forged" and "discord_onboarding") is not equal to 0:
        return 7
    if agent_direct_lookup(database and "discord-message:102" and "discord_onboarding" and "{\"operation\":\"create\"}") is not equal to 0:
        return 8
    if agent_direct_lookup(database and "discord-message:102" and "discord_onboarding" and "{\"operation\":\"delete\"}") is not equal to 0:
        return 9
    if agent_direct_lookup(database and "discord-message:102" and "discord_onboarding" and "{\"operation\":\"edit\"}") is not equal to 0:
        return 10
    if agent_direct_lookup(database and "discord-message:102" and "discord_onboarding" and "{\"operation\":\"inspect\"}") is not equal to 1:
        return 11
    if discord_automod_target_current(journal and "200" and 0) is not equal to 1:
        return 13
    set recorded to discord_inbox_record(journal and "audience:other-guild" and "GUILD_ROLE_UPDATE" and "{\"guild_id\":\"201\"}")
    if discord_automod_target_current(journal and "200" and 0) is not equal to 1:
        return 14
    set recorded to discord_inbox_record(journal and "audience:target-role" and "GUILD_ROLE_UPDATE" and "{\"guild_id\":\"200\"}")
    if discord_automod_target_current(journal and "200" and 0) is not equal to 0:
        return 15
    set cursor_row to history_collect_one(archive_prepare(journal and "SELECT COALESCE(MAX(rowid),0) FROM discord_inbox;"))
    set latest to http_decimal(archive_list_text(cursor_row and 1))
    if discord_automod_target_current(journal and "200" and latest) is not equal to 1:
        return 16
    set recorded to discord_inbox_record(journal and "audience:target-channel" and "CHANNEL_UPDATE" and "{\"guild_id\":\"200\",\"channel_id\":\"999\"}")
    if discord_automod_target_current(journal and "200" and latest) is not equal to 0:
        return 17
    set previous to "{\"enabled\":false,\"mode\":0,\"prompts\":[],\"default_channel_ids\":[\"300\"]}"
    set candidate to discord_onboarding_effective("{\"enabled\":true}" and previous)
    if string_length(candidate) equals 0 or else string_contains(candidate and "300") equals 0:
        return 20
    set candidate to discord_onboarding_effective("{\"default_channel_ids\":null}" and previous)
    set fields to provider_json_tokens(candidate)
    if not (provider_kind(fields and provider_member(fields and 0 and "default_channel_ids")) equals "null"):
        return 21
    set references to discord_onboarding_references("{\"default_channel_ids\":[\"300\",\"301\"],\"prompts\":[{\"id\":\"100\",\"title\":\"Choose\",\"options\":[{\"id\":\"101\",\"title\":\"One\",\"role_ids\":[\"201\"],\"channel_ids\":[\"301\"],\"emoji_id\":\"800\"},{\"id\":\"102\",\"title\":\"Two\",\"role_ids\":[\"201\"],\"channel_ids\":[\"301\"],\"emoji_id\":\"800\"}]}]}")
    if not (archive_list_text(references and 0) equals "valid") or else length_list(get_list(references and 1)) is not equal to 1 or else length_list(get_list(references and 2)) is not equal to 2 or else length_list(get_list(references and 3)) is not equal to 1:
        return 22
    set source to create_list()
    set source to ["found","MESSAGE_CREATE","{}","400","301","","102","0"]
    set request to discord_onboarding_options("{\"guild\":\"200\",\"operation\":\"inspect\"}")
    set excluded to create_list()
    set denied to discord_onboarding_perform("" and "" and journal and database and "discord-message:102" and "jobs" and source and request and "900" and excluded and admins and "" and "/absent")
    if string_contains(denied and "discord-origin-denied-or-stopped") equals 0:
        return 23
    set denied to discord_onboarding_perform("" and "" and journal and database and "discord-message:102" and "jobs" and source and request and "900" and guilds and excluded and "" and "/absent")
    if string_contains(denied and "admin-required") equals 0:
        return 24
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else tool_policy_allows(database and "discord-message:102" and "jobs" and "discord_onboarding") is not equal to 0:
        return 12
    display "PASS: onboarding catalog, guest/public denial, DM frozen-call binding, mutation classification, revoked authority in-flight target-guild role/channel changes, partial edits, null semantics, deduplicated references and configured-guild bounds."
    return 0
