import "../../app/discord/voice_playback_confirmation"
import "../../app/discord/gateway_journal"
import "../../app/discord/voice_gateway_tick"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_schema(database) is not equal to 0 or else discord_voice_leave_schema(database) is not equal to 0 or else discord_voice_gateway_send_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set recorded to discord_gateway_dispatch(database and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set library to ep_dlopen(get_argument(2))
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and library)
    set added to append_list(socket and 1)
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set evidence to ep_sha256("access")
    set requested to discord_voice_intent_request(database and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claimed to discord_voice_intent_claim(database and "join" and "generation" and 1 and evidence)
    set claim to archive_list_text(claimed and 1)
    if not (discord_voice_gateway_send(database and socket and "join" and claim and "old" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "stale-voice-dispatch") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0:
        return 2
    if not (discord_voice_gateway_send(database and socket and "join" and claim and "generation" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "sent"):
        return 3
    set body to ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text")))
    if not (body equals discord_voice_gateway_state_body("100" and "200" and 1 and 1)):
        return 4
    if not (discord_voice_gateway_send(database and socket and "join" and claim and "generation" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "voice-dispatch-not-owned") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 5
    set setup to sql_execute(database and "CREATE TABLE discord_voice_connections(identity TEXT PRIMARY KEY,generation TEXT,state TEXT); INSERT INTO discord_voice_connections VALUES('join','generation','identified'); INSERT INTO discord_voice_playback_gates VALUES('join','generation','session',1,'fixture-proof','pending');")
    if setup is not equal to 0:
        return 20
    if not (discord_voice_playback_gate_send(database and socket and "join" and "old" and "/nonexistent/fixture-stop") equals "stale-voice-playback-gateway"):
        return 21
    set current to history_collect_one(archive_prepare(database and "SELECT i.state,p.state FROM discord_voice_intents i JOIN discord_voice_playback_gates p ON p.identity=i.identity WHERE i.identity='join';"))
    if not (archive_list_text(current and 1) equals "sent") or else not (archive_list_text(current and 2) equals "pending") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 22
    if not (discord_voice_playback_gate_send(database and socket and "join" and "generation" and "/nonexistent/fixture-stop") equals "sent"):
        return 23
    set body to ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text")))
    if not (body equals discord_voice_gateway_state_body("100" and "200" and 0 and 1)) or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 2:
        return 24
    if not (discord_voice_playback_gate_send(database and socket and "join" and "generation" and "/nonexistent/fixture-stop") equals "voice-playback-gate-already-attempted") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 2:
        return 25
    set credentials to create_list()
    set credentials to ["100","300","voice-session","",""]
    set connection to create_list()
    set added to append_list(connection and 0)
    set added to append_list(connection and credentials)
    set added to append_list(connection and "200")
    set added to append_list(connection and 0)
    set owner to create_list()
    set added to append_list(owner and connection)
    set added to append_list(owner and "join")
    set added to append_list(owner and "generation")
    set added to append_list(owner and "300")
    if discord_voice_playback_gate_confirmed(database and owner) is not equal to 0:
        return 30
    set base to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"voice-session\""
    set cases to create_list()
    set added to append_list(cases and "}")
    set added to append_list(cases and ",\"self_mute\":false,\"self_deaf\":true,\"mute\":false,\"suppress\":false}")
    set added to append_list(cases and ",\"self_mute\":true,\"self_deaf\":true,\"mute\":false,\"suppress\":false}")
    set added to append_list(cases and ",\"self_mute\":false,\"self_deaf\":false,\"mute\":false,\"suppress\":false}")
    set added to append_list(cases and ",\"self_mute\":false,\"self_deaf\":true,\"mute\":true,\"suppress\":false}")
    set added to append_list(cases and ",\"self_mute\":false,\"self_deaf\":true,\"mute\":false,\"suppress\":true}")
    set sequence to 2
    for each suffix in cases:
        set body to concat(base and ptr_to_str(suffix))
        set recorded to discord_gateway_dispatch_voice(database and "generation" and "session" and sequence and "VOICE_STATE_UPDATE" and ep_sha256(body) and "" and "" and body)
        set expected to -1
        if sequence equals 3:
            set expected to 1
        if discord_voice_playback_gate_confirmed(database and owner) is not equal to expected:
            return 31
        set sequence to sequence + 1
    display "PASS: no audio confirmation before own state; missing flags, remute, reception enabled, server mute and suppression revoke confirmation."
    return 0
