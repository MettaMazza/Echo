import "../../app/discord/gateway_journal"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_schema(database) is not equal to 0:
        return 2
    if not (discord_gateway_bind(database and "connection-a" and "session-a") equals "bound"):
        return 3
    set digest to ep_sha256("envelope-1")
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 1 and "MESSAGE_CREATE" and digest and "message:100" and "admitted") equals "recorded"):
        return 4
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "900")
    if not (discord_gateway_bind(database and "connection-b" and "session-a") equals "bound"):
        return 5
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 2 and "MESSAGE_CREATE" and digest and "" and "") equals "stale-connection"):
        return 6
    if not (discord_gateway_dispatch(database and "connection-b" and "session-a" and 1 and "MESSAGE_CREATE" and digest and "message:100" and "admitted") equals "already-recorded"):
        return 7
    if not (discord_gateway_dispatch(database and "connection-b" and "session-a" and 1 and "MESSAGE_CREATE" and ep_sha256("different") and "" and "") equals "sequence-conflict"):
        return 8
    if not (discord_gateway_dispatch(database and "connection-b" and "session-a" and 2 and "MESSAGE_CREATE" and digest and "message:100" and "conflict") equals "identity-conflict"):
        return 9
    set row to history_collect_one(archive_prepare(database and "SELECT sequence FROM discord_gateway WHERE singleton=1;"))
    if not (archive_list_text(row and 1) equals "1"):
        return 10
    if not (discord_gateway_dispatch(database and "connection-b" and "session-a" and 2 and "MESSAGE_CREATE" and digest and "" and "private ignored text") equals "unadmitted-payload"):
        return 11
    if not (discord_gateway_dispatch(database and "connection-b" and "session-a" and 2 and "MESSAGE_CREATE" and digest and "" and "") equals "recorded"):
        return 12
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox;"))
    if not (archive_list_text(row and 1) equals "1"):
        return 13
    if not (discord_gateway_dispatch(database and "connection-b" and "session-a" and 0 and "MESSAGE_CREATE" and digest and "" and "") equals "sequence-regressed"):
        return 14
    set closed to sql_close(database)
    display "PASS: atomic intake/sequence, reconnect fencing, resume dedup, conflict rollback, monotonic sequence and ignored-payload exclusion."
    return 0
