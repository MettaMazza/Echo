import "../../app/discord/manual_retry"
import "../../app/discord/command_registration"
import "../../app/discord/agent_bridge"
import "../../app/jobs/delegation_run"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public network retry fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set definition to discord_control_command_definition("retry")
    set registration to concat("{\"id\":\"701\",\"application_id\":\"900\",\"guild_id\":\"200\"," and substring(definition and 1 and string_length(definition) - 1))
    if discord_control_command_matches(registration and "retry") is not equal to 1 or else not (discord_command_observe(journal and registration and "900" and "200") equals "registered"):
        return 20
    set command_body to "{\"id\":\"702\",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"id\":\"701\",\"name\":\"retry\",\"type\":1,\"options\":[{\"name\":\"message\",\"type\":3,\"value\":\"100\"}]}}"
    set command to discord_command_resolve(journal and command_body and "900" and guilds and admins)
    if not (archive_list_text(command and 0) equals "command-bound-needs-live-access") or else not (archive_list_text(command and 5) equals "100"):
        return 21
    if web_worker_claim(database and "discord-message:100" and "retry-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved") or else not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "retry-worker" and 123 and "fixture") equals "recorded"):
        return 5
    if not (discord_manual_retry(journal and database and "message:create:100" and "401" and "300" and "200" and "wrong") equals "retry-source-denied") or else not (discord_manual_retry(journal and database and "message:create:100" and "400" and "301" and "200" and "wrong") equals "retry-source-denied"):
        return 6
    if not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "active") equals "run-not-retryable"):
        return 7
    if sql_execute(database and "UPDATE echo_web_workers SET status='provider-unavailable';") is not equal to 0:
        return 8
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to compaction_lock_acquire(database and "web-worker:discord-message:100" and library)
    if lock < 0 or else not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "locked") equals "retry-worker-active"):
        return 9
    set closed to net_close(lock)
    set result to discord_manual_retry_message(journal and database and "100" and "400" and "300" and "200" and "request-one")
    display result
    if not (result equals "retry-requested"):
        return 10
    if not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "request-one") equals "retry-requested"):
        return 11
    set row to history_collect_one(archive_prepare(journal and "SELECT state,worker FROM discord_background_runs;"))
    set claim to history_collect_one(archive_prepare(database and "SELECT status FROM echo_web_workers;"))
    if not (archive_list_text(row and 1) equals "reserved") or else string_length(archive_list_text(row and 2)) > 0 or else not (archive_list_text(claim and 1) equals "launch-failed"):
        return 12
    set events to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_background_events WHERE detail='request-one';"))
    set receipts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='discord_retry_requested';"))
    if not (archive_list_text(events and 1) equals "1") or else not (archive_list_text(receipts and 1) equals "1"):
        return 13
    # Simulate interruption after archive commit, before journal requeue.
    if sql_execute(journal and "UPDATE discord_background_runs SET state='recovery',worker='retry-worker';") is not equal to 0 or else not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "request-one") equals "retry-requested"):
        return 14
    if sql_execute(database and "UPDATE echo_web_workers SET worker='new-worker',status='running';") is not equal to 0 or else not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "request-one") equals "retry-already-requested"):
        return 15
    if not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "request-two") equals "run-not-retryable"):
        return 16
    if sql_execute(database and "UPDATE echo_web_workers SET status='provider-unavailable'; INSERT INTO echo_tool_calls(run,call_id,session,request_event,state) SELECT run,'unobserved',session,objective_event,'queued' FROM echo_runs;") is not equal to 0 or else not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "uncertain") equals "run-not-retryable"):
        return 17
    if sql_execute(database and "UPDATE echo_tool_calls SET state='observed';") is not equal to 0 or else sql_execute(journal and "INSERT INTO discord_cancel_sources VALUES('message:create:100','400','cancel-fixture',1);") is not equal to 0 or else not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "cancelled") equals "run-not-retryable"):
        return 18
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_manual_retry(journal and database and "message:create:100" and "400" and "300" and "200" and "request-one") equals "retry-already-requested"):
        return 19
    # Ordinary foreground requests need a new reservation on manual retry.
    if sql_execute(database and "UPDATE echo_runs SET state='cancelled';") is not equal to 0:
        return 22
    set source_two to string_replace(source and "\"id\":\"100\"" and "\"id\":\"101\"")
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and source_two) equals "recorded"):
        return 23
    set next_run to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(next_run and 0) equals "accepted") or else web_worker_claim(database and "discord-message:101" and "foreground-worker") is not equal to 0 or else sql_execute(database and "UPDATE echo_web_workers SET status='provider-unavailable' WHERE run='discord-message:101';") is not equal to 0:
        return 24
    if not (discord_manual_retry_message(journal and database and "101" and "400" and "300" and "200" and "foreground-request") equals "retry-reservation:conversation-busy"):
        return 27
    if not (discord_background_transition(journal and "discord-message:100" and "reserved" and "released" and "" and 0 and "Prior cancelled fixture reservation released") equals "recorded"):
        return 28
    set result to discord_manual_retry_message(journal and database and "101" and "400" and "300" and "200" and "foreground-request")
    display result
    if not (result equals "retry-requested"):
        return 25
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else not (discord_manual_retry_message(journal and database and "101" and "400" and "300" and "200" and "revoked") equals "retry-source-denied"):
        return 26
    if sql_execute(database and "UPDATE echo_devices SET revoked=0 WHERE device='discord:400'; UPDATE echo_runs SET state='completed' WHERE run='discord-message:101'; DELETE FROM echo_web_workers WHERE run='discord-message:101';") is not equal to 0 or else not (discord_manual_retry_message(journal and database and "101" and "400" and "300" and "200" and "completed-no-worker") equals "run-not-retryable"):
        return 29
    display "PASS: exact-run manual retry; owner/channel/lock/running/tool/cancel guards; idempotent receipt and interrupted journal recovery; old interaction cannot restart a newer worker."
    return 0
