import "../../app/discord/turn_guard"
import "select"

define source_match_worker with completed as Int returning Int:
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[]}"
    set edited to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Edited\",\"attachments\":[]}"
    set index to 0
    repeat while index < 10000:
        if discord_source_matches(original and original) is not equal to 1 or else discord_source_matches(original and edited) is not equal to 0:
            send 1 to completed
            return 1
        set index to index + 1
    send 0 to completed
    return 0

define main returning Int:
    set first to channel
    set second to channel
    spawn source_match_worker(first)
    spawn source_match_worker(second)
    set waits to create_list()
    set added to append_list(waits and first)
    set added to append_list(waits and second)
    set remaining to 2
    repeat while remaining > 0:
        set ready to select(waits and 20)
        if ready >= 0:
            set result to receive from get_list(waits and ready)
            if result is not equal to 0:
                return 1
            set remaining to remaining - 1
    display "PASS: concurrent source matching preserves equality and rejects edits across collection."
    return 0
