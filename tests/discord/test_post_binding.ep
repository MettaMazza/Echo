import "../../app/discord/agent_bridge"
import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set host to archive_open(get_argument(1))
    if host equals 0 or else web_run_schema(host) is not equal to 0:
        return 2
    if web_pairing_invite(host and "host") is not equal to 0 or else web_device_pair(host and "host" and "host" and "host" and "fixture-secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(host and "host" and "host-run" and "" and "inspect")
    if string_contains(session_tool_schemas_owned(host and "host-run") and "discord_post") is not equal to 0:
        return 4
    set denied to tool_fixture_call(host and "host" and "host-run" and "discord_post" and "{\"operation\":\"status\",\"post\":\"tool-post:fixture\"}")
    if string_contains(denied and "discord-runtime-unavailable") equals 0:
        display denied
        return 5
    set database to discord_agent_open(get_argument(2) and "900")
    if database equals 0:
        return 6
    set admins to create_list()
    set device to discord_agent_principal(database and "400" and admins)
    set submitted to web_submit_owned(database and device and "discord-shaped-local-run" and "" and "inspect")
    if string_contains(session_tool_schemas_owned(database and "discord-shaped-local-run") and "discord_post") equals 0:
        return 7
    set denied to tool_fixture_call(database and device and "discord-shaped-local-run" and "discord_post" and "{\"operation\":\"status\",\"post\":\"tool-post:fixture\"}")
    if string_contains(denied and "discord-runtime-unavailable") equals 0:
        display denied
        return 8
    if tool_policy_allows(database and "discord-shaped-local-run" and "forged-call" and "discord_post") is not equal to 0:
        return 9
    display "PASS: Discord-only catalog, real queued dispatch records refusal outside authenticated child runtime, forged call denied; no external action"
    return 0
