import "../../app/discord/hud_control"
import "../../app/jobs/delegation_schema"
import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","c"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set private to web_submit_owned(database and "a" and "private" and "" and "HOST_PRIVATE_HUD_CANARY")
    if not (group_create(database and "a" and "g" and "discord" and "100" and "200" and "g") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "discord" and "100" and "200" and 3) equals "created"):
        return 4
    if not (group_run_submit(database and "a" and "run" and "shared" and "discord" and "100" and "200" and "Shared HUD acceptance") equals "accepted"):
        return 5
    set request to "{\"run\":\"run\",\"section\":\"interaction\",\"after\":0}"
    for each device in ["a","b"]:
        set result to discord_hud_request(database and device and "100" and "200" and request)
        if string_contains(result and "run:user") equals 0 or else string_contains(result and "HOST_PRIVATE_HUD_CANARY") is not equal to 0:
            display result
            return 6
    if string_contains(discord_hud_request(database and "c" and "100" and "200" and request) and "not-authorized") equals 0 or else string_contains(discord_hud_request(database and "a" and "101" and "200" and request) and "not-authorized") equals 0 or else string_contains(discord_hud_request(database and "a" and "100" and "201" and request) and "not-authorized") equals 0:
        return 7
    if string_contains(discord_hud_request(database and "a" and "100" and "200" and "{\"run\":\"private\",\"section\":\"interaction\",\"after\":0}") and "not-authorized") equals 0:
        return 8
    for each section in ["context","work","schedules","incidents","community"]:
        set arguments to concat("{\"run\":\"run\",\"section\":" and concat(provider_quote(section) and ",\"after\":0}"))
        set result to discord_hud_request(database and "b" and "100" and "200" and arguments)
        set fields to provider_json_tokens(result)
        set data to provider_member(fields and 0 and "data")
        set status to provider_value(fields and provider_member(fields and data and "status"))
        if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "found") or else string_contains(result and "HOST_PRIVATE_HUD_CANARY") is not equal to 0:
            display result
            return 13
        if not (status equals "found" or else status equals "end" or else status equals "observed"):
            display result
            return 14
    for each section in ["machine","rights"]:
        set arguments to concat("{\"run\":\"run\",\"section\":" and concat(provider_quote(section) and ",\"after\":0}"))
        if string_contains(discord_hud_request(database and "b" and "100" and "200" and arguments) and "not-authorized") equals 0:
            return 9
    for each arguments in ["{}","{\"run\":\"run\",\"section\":\"unknown\",\"after\":0}","{\"run\":\"run\",\"section\":\"interaction\",\"after\":-1}","{\"run\":\"run\",\"section\":\"interaction\",\"after\":0,\"device\":\"a\"}"]:
        if string_contains(discord_hud_request(database and "a" and "100" and "200" and arguments) and "invalid-arguments") equals 0:
            return 10
    if not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded") or else string_contains(discord_hud_request(database and "b" and "100" and "200" and request) and "not-authorized") equals 0:
        return 11
    if web_device_revoke(database and "a") is not equal to 0 or else string_contains(discord_hud_request(database and "a" and "100" and "200" and request) and "not-authorized") equals 0:
        return 12
    display "PASS: Discord HUD owner/member reads, foreign/Host/channel isolation, privileged sections, strict arguments and current authority."
    return sql_close(database)
