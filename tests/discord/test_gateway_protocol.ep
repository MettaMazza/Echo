import "../../app/discord/gateway_protocol"

define main returning Int:
    set state to discord_frames_new()
    if not (archive_list_text(discord_frames_accept(state and ["chunk","{\"op\":","5","0","2"]) and 0) equals "pending"):
        return 1
    if not (archive_list_text(discord_frames_accept(state and ["control"]) and 0) equals "pending"):
        return 2
    if not (archive_list_text(discord_frames_accept(state and ["chunk","10","5","6","0"]) and 0) equals "pending"):
        return 3
    set message to discord_frames_accept(state and ["chunk","}","1","0","0"])
    if not (archive_list_text(message and 0) equals "message") or else not (archive_list_text(message and 1) equals "{\"op\":10}"):
        return 4
    if not (archive_list_text(discord_frames_accept(state and ["chunk","next","1","0","0"]) and 1) equals "next"):
        return 5
    set state to discord_frames_new()
    set first to discord_frames_accept(state and ["chunk","a","1","0","2"])
    if not (archive_list_text(discord_frames_accept(state and ["chunk","bc","1","2","0"]) and 0) equals "invalid-frame-continuity"):
        return 6
    if not (archive_list_text(discord_frames_accept(discord_frames_new() and ["chunk","binary","2","0","0"]) and 0) equals "invalid-frame"):
        return 7
    set heart to discord_heartbeat_new(1000 and 10000 and 250)
    if not (discord_heartbeat_action(heart and 10249) equals "wait") or else not (discord_heartbeat_action(heart and 10250) equals "send"):
        return 8
    set sent to discord_heartbeat_sent(heart and 10250 and 1)
    set requested to discord_heartbeat_sent(heart and 11000 and 0)
    if not (discord_heartbeat_action(heart and 11250) equals "reconnect-missing-ack"):
        return 9
    set acked to discord_heartbeat_ack(heart and 11100)
    if not (discord_heartbeat_action(heart and 11250) equals "send"):
        return 10
    for each code in [4004,4010,4011,4012,4013,4014]:
        if not (discord_gateway_close_action(code) equals "stop-configuration"):
            return 11
    for each code in [4007,4009,1000,1001]:
        if not (discord_gateway_close_action(code) equals "identify"):
            return 12
    if not (discord_gateway_close_action(1006) equals "resume"):
        return 13
    set state to discord_frames_new()
    if not (archive_list_text(discord_frames_accept(state and ["close-chunk","15","-1","1","0","1"]) and 0) equals "pending"):
        return 15
    if not (archive_list_text(discord_frames_accept(state and ["close-chunk","174","-1","1","1","0"]) and 1) equals "4014"):
        return 16
    for each url in ["https://gateway.discord.gg","wss://discord.gg.evil.example","wss://gateway.discord.gg@evil.example","wss://127.0.0.1","wss://gateway.discord.gg/other","wss://gateway.discord.gg?token=bad"]:
        if string_length(discord_gateway_endpoint(ptr_to_str(url))) is not equal to 0:
            return 14
    display "PASS: fragmented/chunked frames, interleaved controls, continuity errors, heartbeat deadlines/ACK, server-request deadline preservation and close/origin policy."
    return 0
