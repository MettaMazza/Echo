import "../../app/discord/post_options"

define main returning Int:
    set options to discord_post_options("{}")
    if archive_list_text(options and 0) equals "valid":
        return 1
    set options to discord_post_options("{\"operation\":\"reply\"}")
    if archive_list_text(options and 0) equals "valid":
        return 2
    set options to discord_post_options("{\"operation\":\"reply\",\"text\":\"x\",\"post\":\"p\"}")
    if archive_list_text(options and 0) equals "valid":
        return 3
    set options to discord_post_options("{\"operation\":\"delete\",\"post\":\"p\",\"text\":\"x\"}")
    if archive_list_text(options and 0) equals "valid":
        return 4
    set options to discord_post_options("{\"operation\":\"edit\",\"text\":\"x\"}")
    if archive_list_text(options and 0) equals "valid":
        return 5
    set options to discord_post_options("{\"operation\":\"reply\",\"text\":\"x\",\"channel\":\"500\"}")
    if archive_list_text(options and 0) equals "valid":
        return 6
    set options to discord_post_options("{\"operation\":\"reply\",\"text\":3}")
    if archive_list_text(options and 0) equals "valid":
        return 7
    set options to discord_post_options("{\"operation\":\"ban\",\"post\":\"p\"}")
    if archive_list_text(options and 0) equals "valid":
        return 8
    set text to ""
    set count to 0
    repeat while count < 1000:
        set text to concat(text and "🌿")
        set count to count + 1
    set arguments to concat("{\"operation\":\"reply\",\"text\":" and concat(provider_quote(text) and "}"))
    set valid to discord_post_options(arguments)
    if not (archive_list_text(valid and 0) equals "valid"):
        return 10
    set text to concat(text and "a")
    set arguments to concat("{\"operation\":\"reply\",\"text\":" and concat(provider_quote(text) and "}"))
    set invalid to discord_post_options(arguments)
    if archive_list_text(invalid and 0) equals "valid":
        return 11
    set body to discord_post_body("@everyone test" and "123")
    set tokens to provider_json_tokens(body)
    set mentions to provider_member(tokens and 0 and "allowed_mentions")
    if not (provider_value(tokens and provider_member(tokens and mentions and "replied_user")) equals "false") or else length_list(provider_items(tokens and provider_member(tokens and mentions and "parse"))) is not equal to 0:
        return 12
    set options to discord_post_options("{\"operation\":\"retry\",\"post\":\"tool-post:test\"}")
    if not (archive_list_text(options and 0) equals "valid"):
        return 13
    display "PASS: strict post operations, no destination/mention controls, correct UTF-16 post limit and reply payload"
    return 0
