import "../../app/discord/worker_store"
import "../../app/discord/job_dispatch"
import "../fixtures/delegation_fixture"

# Explicit test fixture using a retained, public labelled test message. It
# creates isolated archives and a synthetic delegated tool request, never a
# fabricated claim that a model issued that request. The actual --job process
# subsequently checks this source through Discord before model inference.
define main returning Int:
    if (get_argument_count() is not equal to 7 and get_argument_count() is not equal to 8) or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set raw to read_file(get_argument(3))
    if raw equals 0:
        return 2
    set body to ptr_to_str(raw)
    set tokens to provider_json_tokens(body)
    set message to provider_value(tokens and provider_member(tokens and 0 and "id"))
    if discord_snowflake(message) equals 0:
        return 3
    set inbox to concat("message:create:" and message)
    set run to concat("discord-message:" and message)
    set journal to discord_store_open(get_argument(1) and get_argument(4))
    set database to discord_agent_open(get_argument(2) and get_argument(4))
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else web_worker_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 4
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 5
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 0) equals "claimed"):
        return 6
    set guilds to string_split(get_argument(5) and ",")
    set admins to string_split(get_argument(6) and ",")
    set submitted to discord_agent_submit(journal and database and inbox and get_argument(4) and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 7
    set instruction to "This is a labelled isolated background-worker acceptance test. Reply exactly quartz-job-61. Do not use tools."
    if get_argument_count() equals 8:
        set supplied to read_file(get_argument(7))
        if supplied equals 0:
            return 10
        set instruction to concat("This is a labelled isolated background-worker acceptance test. " and ptr_to_str(supplied))
    set arguments to concat("{\"instruction\":" and concat(provider_quote(instruction) and "}"))
    if delegation_fixture_request(database and run and archive_list_text(submitted and 1) and "live-fixture" and arguments) is not equal to 0 or else not (delegation_materialize(database and run and "live-fixture") equals "materialized"):
        return 8
    set child to concat(run and ":delegate:live-fixture")
    if not (discord_job_origin(journal and database and child) equals inbox) or else web_worker_claim(database and child and "live-job-fixture-worker") is not equal to 0:
        return 9
    display child
    return 0
