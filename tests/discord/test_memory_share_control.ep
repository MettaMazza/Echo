import "../../app/discord/memory_share_control"
import "../../app/archive/snapshot"
import "../../app/discord/agent_bridge"
import "../../app/security/group_session_selection"

define share_control_arguments with database as Int and action as Str and source as Str and destination as Str and review as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_object('action',?1,'source',?2,'destination',?3,'review',?4);" and [action,source,destination,review]))
    return archive_list_text(row and 1)

define share_control_field with body as Str and key as Str returning Str:
    set tokens to provider_json_tokens(body)
    return provider_value(tokens and provider_member(tokens and 0 and key))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    set device to discord_agent_principal(database and "400" and create_list())
    set other to discord_agent_principal(database and "401" and create_list())
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "share-first" and "Café violet 🌿" and create_list())
    set source to archive_read_event(database and "share-first:user")
    if source equals 0:
        return 3
    set source_digest to archive_list_text(source and 6)
    set group_id to channel_silo_identity("discord" and "200" and "300" and principal_for_device(database and device))
    set next to group_session_restart(database and device and "share-next" and group_id and "discord" and "200" and "300" and 1)
    set destination to archive_list_text(next and 1)
    set query to share_control_arguments(database and "preview" and "share-first:user" and destination and "")
    set preview to discord_memory_share_request(database and device and "200" and "300" and query)
    if not (share_control_field(preview and "status") equals "review-required") or else string_contains(preview and "Café violet 🌿") equals 0 or else string_contains(preview and "destination_audience") equals 0:
        display preview
        return 4
    set review to share_control_field(preview and "review_digest")
    set wrong to share_control_arguments(database and "confirm" and "share-first:user" and destination and ep_sha256("wrong"))
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and wrong) and "status") equals "review-changed"):
        return 5
    set confirm to share_control_arguments(database and "confirm" and "share-first:user" and destination and review)
    set result to discord_memory_share_request(database and device and "200" and "300" and confirm)
    if not (share_control_field(result and "status") equals "recorded") or else not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and confirm) and "status") equals "already-recorded"):
        display result
        return 6
    set event to share_control_field(result and "event")
    set copy to archive_read_event(database and event)
    if not (archive_list_text(copy and 0) equals destination) or else string_contains(archive_list_text(copy and 3) and source_digest) equals 0 or else not (archive_list_text(archive_read_event(database and "share-first:user") and 6) equals source_digest):
        return 7
    for each namespace in [["200","301"],["201","300"]]:
        if not (share_control_field(discord_memory_share_request(database and device and archive_list_text(namespace and 0) and archive_list_text(namespace and 1) and query) and "status") equals "not-authorized"):
            return 8
    if not (share_control_field(discord_memory_share_request(database and other and "200" and "300" and confirm) and "status") equals "not-authorized"):
        return 9
    set private to web_submit_owned(database and device and "private-share" and "" and "Host private sentinel")
    set private_query to share_control_arguments(database and "preview" and "private-share:user" and destination and "")
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and private_query) and "status") equals "not-authorized"):
        return 10
    set private_target to share_control_arguments(database and "preview" and "share-first:user" and archive_list_text(private and 1) and "")
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and private_target) and "status") equals "not-authorized"):
        return 11
    set elsewhere to channel_silo_submit(database and device and "discord" and "200" and "301" and "cross-target" and "Destination fixture" and create_list())
    set cross_session to archive_list_text(elsewhere and 1)
    if not (discord_share_destination_room(database and device and "200" and cross_session) equals "301") or else string_length(discord_share_destination_room(database and other and "200" and cross_session)) is not equal to 0 or else string_length(discord_share_destination_room(database and device and "201" and cross_session)) is not equal to 0:
        return 18
    set cross_preview to discord_memory_share_request(database and device and "200" and "300" and share_control_arguments(database and "preview" and "share-first:user" and cross_session and ""))
    if not (share_control_field(cross_preview and "status") equals "review-required") or else string_contains(cross_preview and "\"destination_channel\":\"301\"") equals 0:
        display cross_preview
        return 19
    set cross_confirm to share_control_arguments(database and "confirm" and "share-first:user" and cross_session and share_control_field(cross_preview and "review_digest"))
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and cross_confirm) and "status") equals "recorded"):
        return 20
    # A digest reviewed for one destination cannot authorize another.
    set swapped to share_control_arguments(database and "confirm" and "share-first:user" and destination and share_control_field(cross_preview and "review_digest"))
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and swapped) and "status") equals "review-changed"):
        return 21
    if not (group_create(database and device and "shared" and "discord" and "200" and "300" and "fixture") equals "created") or else not (group_change(database and device and "invite" and "shared" and principal_for_device(database and other) and "invited" and 1) equals "recorded") or else not (group_change(database and other and "join" and "shared" and principal_for_device(database and other) and "joined" and 2) equals "recorded") or else not (group_session_create(database and device and "shared-session" and "shared" and "discord" and "200" and "300" and 3) equals "created"):
        return 12
    set shared_preview to discord_memory_share_request(database and device and "200" and "300" and share_control_arguments(database and "preview" and "share-first:user" and "shared-session" and ""))
    set shared_confirm to share_control_arguments(database and "confirm" and "share-first:user" and "shared-session" and share_control_field(shared_preview and "review_digest"))
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and shared_confirm) and "status") equals "recorded"):
        return 13
    if not (group_change(database and device and "remove" and "shared" and principal_for_device(database and other) and "removed" and 3) equals "recorded") or else not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and shared_confirm) and "status") equals "not-authorized"):
        return 14
    if not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and "{\"action\":\"preview\",\"device\":\"other\"}") and "status") equals "invalid-arguments"):
        return 15
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if archive_verify_all(database) is not equal to 0 or else archive_read_event(database and event) equals 0:
        return 16
    if not (principal_host_revocation(database and "revoke-share" and principal_for_device(database and device) and 1 and "fixture") equals "recorded") or else not (share_control_field(discord_memory_share_request(database and device and "200" and "300" and confirm) and "status") equals "not-authorized"):
        return 17
    display "PASS: exact reviewed Unicode copy, unchanged original, idempotent confirmation, permitted cross-channel destination, destination substitution denial, wrong review, foreign account/source-channel/guild/private denial, shared audience change, reopen integrity and revoked actor"
    return sql_close(database)
