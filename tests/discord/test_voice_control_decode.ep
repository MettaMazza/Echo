import "../../app/discord/voice_control_decode"

define main returning Int:
    set hello to discord_voice_control_decode("{\"op\":8,\"d\":{\"heartbeat_interval\":41250.25}}")
    if not (archive_list_text(hello and 0) equals "hello") or else get_list(get_list(hello and 3) and 0) is not equal to 41251:
        return 1
    set ready to discord_voice_control_decode("{\"op\":2,\"seq\":65535,\"d\":{\"ssrc\":4294967295,\"ip\":\"203.0.113.1\",\"port\":50000,\"modes\":[\"unknown\",\"aead_xchacha20_poly1305_rtpsize\"]}}")
    if not (archive_list_text(ready and 0) equals "ready") or else get_list(ready and 2) is not equal to 65535:
        return 2
    set numbers to ""
    set invalid_numbers to ""
    set index to 0
    repeat while index < 32:
        if index > 0:
            set numbers to concat(numbers and ",")
            set invalid_numbers to concat(invalid_numbers and ",")
        set numbers to concat(numbers and int_to_string(index * 8))
        if index equals 0:
            set invalid_numbers to "256"
        else:
            set invalid_numbers to concat(invalid_numbers and int_to_string(index * 8))
        set index to index + 1
    set prefix to "{\"op\":4,\"d\":{\"mode\":\"aead_xchacha20_poly1305_rtpsize\",\"dave_protocol_version\":1,\"secret_key\":["
    set description to discord_voice_control_decode(concat(prefix and concat(numbers and "]}}")))
    if not (archive_list_text(description and 0) equals "session-description"):
        return 3
    set key to get_list(get_list(description and 3) and 1)
    set index to 0
    repeat while index < 32:
        if peek_byte(get_list_data_ptr(key) and index) is not equal to index * 8:
            return 4
        set index to index + 1
    set invalid to create_list()
    set invalid to ["{\"op\":8,\"op\":8,\"d\":{\"heartbeat_interval\":5000}}","{\"op\":8,\"d\":{\"heartbeat_interval\":-1}}","{\"op\":22,\"d\":{\"transition_id\":65536}}","{\"op\":22,\"d\":{\"transition_id\":18446744073709551616}}","{\"op\":22,\"d\":{\"transition_id\":\"1\"}}","{\"op\":9,\"seq\":null,\"d\":{}}"]
    for each body in invalid:
        set result to discord_voice_control_decode(ptr_to_str(body))
        if not (archive_list_text(result and 0) equals "invalid-voice-control"):
            return 5
    set malformed_key to discord_voice_control_decode(concat(prefix and concat(numbers and ",256]}}")))
    if not (archive_list_text(malformed_key and 0) equals "invalid-voice-control"):
        return 6
    set wrong_byte to discord_voice_control_decode(concat(prefix and concat(invalid_numbers and "]}}")))
    if not (archive_list_text(wrong_byte and 0) equals "invalid-voice-control"):
        return 10
    set downgrade to discord_voice_control_decode("{\"op\":21,\"d\":{\"transition_id\":1,\"protocol_version\":0}}")
    if not (archive_list_text(downgrade and 0) equals "unsupported-dave-version"):
        return 7
    set transition to discord_voice_control_decode("{\"op\":21,\"seq\":0,\"d\":{\"transition_id\":512,\"protocol_version\":1}}")
    if not (archive_list_text(transition and 0) equals "prepare-transition") or else get_list(get_list(transition and 3) and 0) is not equal to 512:
        return 8
    set epoch to discord_voice_control_decode("{\"op\":24,\"d\":{\"epoch\":1,\"protocol_version\":1}}")
    if not (archive_list_text(epoch and 0) equals "prepare-epoch"):
        return 9
    display "PASS: voice control decoding validates HELLO, READY, binary session key and DAVE transition fields; ambiguous/overflow/malformed/downgrade input rejected."
    return 0
