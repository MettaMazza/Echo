import "../../app/archive/history"
import "fs"
import "os"

# Measure the actual durable append/readback/hash path, not SQLite alone.
# The same payload/count is used on both storage targets. No sync weakening.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set payload to "{\"request_event\":\"benchmark-request\",\"event_type\":\"message\",\"data\":\""
    set index to 0
    repeat while index < 10:
        set payload to concat(payload and "durable stream observation with reasoning and source provenance; ")
        set index to index + 1
    set payload to concat(payload and "\"}")
    set start to ep_time_now_ms()
    set index to 0
    repeat while index < 200:
        if archive_append(database and "benchmark" and concat("chunk:" and int_to_string(index)) and "provider_event" and payload and concat("unix-ms:" and int_to_string(ep_time_now_ms()))) is not equal to 0:
            return 3
        set index to index + 1
    set elapsed to ep_time_now_ms() - start
    if archive_verify(database and "benchmark") is not equal to 0:
        return 4
    display concat("{\"events\":200,\"elapsed_ms\":" and concat(int_to_string(elapsed) and ",\"verified\":true}"))
    return sql_close(database)
