import "../../app/discord/receipt_spool"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    set index to 0
    repeat while index < 300:
        set name to discord_receipt_name(library and root and ptr_to_str(ep_uuid_v4()))
        if string_length(name) equals 0:
            return 2
        set path to concat(name and ".json")
        set file to workspace_file_open(library and root and path and 1)
        if file < 0:
            return 3
        set closed to net_close(file)
        if workspace_file_open(library and root and path and 1) >= 0:
            return 4
        set file to workspace_file_open(library and root and path and 0)
        if file < 0:
            return 5
        set closed to net_close(file)
        set index to index + 1
    set closed to net_close(root)
    display "PASS: 300 sharded receipts remain readable and cannot be overwritten"
    return 0
