import "../../app/discord/background_supervisor"
import "../../app/discord/typing"
import "../../app/discord/background_settle"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background recovery fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 0) equals "claimed"):
        return 5
    set current to agent_run_read(database and "discord-message:100")
    set session to archive_list_text(current and 0)
    set request to "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"name\":\"discord_message_read\",\"arguments\":{\"operation\":\"search_local\",\"query\":\"needle\",\"limit\":2}}"
    if archive_append(database and session and "uncertain-request" and "tool_call" and request and "test") is not equal to 0 or else tool_ledger_queue(database and "discord-message:100" and "uncertain-call" and session and "uncertain-request") is not equal to 0 or else tool_ledger_claim(database and "discord-message:100" and "uncertain-call") is not equal to 0:
        return 6
    if sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='discord-message:100';") is not equal to 0 or else discord_typing_schema(journal) is not equal to 0:
        return 7
    display "Prepared native interrupted foreground read fixture; no network or inference."
    return 0
