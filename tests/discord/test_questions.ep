import "../../app/discord/question_store"
import "../../app/discord/question_controls"

define question_control_fixture with identity as Str and actor as Str and room as Str and message as Str and kind as Int returning Str:
    set body to concat("{\"type\":" and concat(int_to_string(kind) and ",\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":"))
    set body to concat(body and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"message\":{\"author\":{\"id\":\"900\"},\"id\":"))))
    set body to concat(body and concat(provider_quote(message) and "},\"data\":{\"component_type\":2,\"custom_id\":"))
    return concat(body and concat(provider_quote(identity) and "}}"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if database equals 0 or else journal equals 0 or else web_run_schema(database) is not equal to 0 or else web_cancel_schema(database) is not equal to 0:
        return 2
    if not (delegation_schema(database) equals "applied"):
        return 22
    set body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Ask me three questions\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set admitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and ["400"])
    if not (archive_list_text(admitted and 0) equals "accepted"):
        return 4
    set run to "discord-message:100"
    set questions to "{\"questions\":[{\"id\":\"topic\",\"title\":\"What topic?\",\"options\":[\"Art\",\"Science\",\"Music\"]},{\"id\":\"length\",\"title\":\"How long?\",\"options\":[\"Short\",\"Long\"]},{\"id\":\"notes\",\"title\":\"Anything else?\",\"options\":[]}]}"
    if sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='discord-message:100';") is not equal to 0 or else string_contains(questions_save(database and run and "ask" and questions) and "awaiting-user-input") equals 0:
        return 5
    set binding to discord_question_bind(journal and database and run)
    if string_length(binding) is not equal to 70 or else not (discord_question_bind(journal and database and run) equals binding):
        return 6
    set queued to discord_outbox_enqueue(journal and "question:100" and "message:create:100" and "300" and "{\"content\":\"Questions\"}")
    set other to discord_question_control_bind(journal and binding and "question:100" and "other" and 0 and -1)
    set choice_control to discord_question_control_bind(journal and binding and "question:100" and "choice" and 0 and 1)
    if string_length(other) is not equal to 71 or else not (discord_question_control_bind(journal and binding and "question:100" and "other" and 0 and -1) equals other):
        return 23
    set click to question_control_fixture(other and "500" and "300" and "700" and 3)
    if string_length(discord_question_other_modal(journal and click and "900")) > 0:
        return 24
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='question:100';") is not equal to 0:
        return 25
    set modal to discord_question_other_modal(journal and click and "900")
    if provider_json_tokens(modal) equals 0 or else string_contains(modal and "Your answer") equals 0 or else string_contains(modal and "Science"):
        return 26
    for each invalid in [question_control_fixture(other and "501" and "300" and "700" and 3),question_control_fixture(other and "500" and "301" and "700" and 3),question_control_fixture(other and "500" and "300" and "701" and 3),question_control_fixture(choice_control and "500" and "300" and "700" and 5)]:
        set denied to discord_question_control_resolve(journal and ptr_to_str(invalid) and "900")
        if archive_list_text(denied and 0) equals "found":
            return 27
    set submission to discord_question_control_resolve(journal and question_control_fixture(other and "500" and "300" and "700" and 5) and "900")
    if not (archive_list_text(submission and 0) equals "found") or else not (archive_list_text(submission and 2) equals binding):
        return 28
    if not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-answer-not-accepted"):
        return 7
    if not (discord_question_choose(journal and database and binding and "501" and "300" and "200" and "topic" and 0 and "") equals "question-binding-denied") or else not (discord_question_choose(journal and database and binding and "500" and "301" and "200" and "topic" and 0 and "") equals "question-binding-denied") or else not (discord_question_choose(journal and database and binding and "500" and "300" and "201" and "topic" and 0 and "") equals "question-binding-denied"):
        return 8
    if not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "topic" and 3 and "") equals "invalid-question-choice") or else not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "notes" and -1 and " ") equals "invalid-question-choice"):
        return 9
    if not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "topic" and 1 and "") equals "question-draft-saved") or else not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "length" and 0 and "") equals "question-draft-saved"):
        return 10
    if questions_pending(database and run) equals "null" or else not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-answer-not-accepted"):
        return 11
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_question_bind(journal and database and run) equals binding) or else not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "notes" and -1 and "Keep café examples") equals "question-draft-saved"):
        return 12
    if not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-answered") or else not (questions_pending(database and run) equals "null"):
        return 13
    if not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-no-longer-pending"):
        return 14
    set count to history_collect_one(checkpoint_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='user_input_answered' AND json_extract(payload,'$.run_id')=?1;" and [run]))
    if not (archive_list_text(count and 1) equals "1"):
        return 15
    set guidance to guidance_pending(database and run)
    if not (archive_list_text(guidance and 0) equals "found") or else string_contains(archive_list_text(guidance and 2) and "Science") equals 0 or else string_contains(archive_list_text(guidance and 2) and "café") equals 0:
        return 16
    if string_contains(questions_save(database and run and "second" and questions) and "awaiting-user-input") equals 0:
        return 17
    set second to discord_question_bind(journal and database and run)
    if second equals binding or else string_length(second) is not equal to 70:
        return 18
    if web_device_revoke(database and "discord:500") is not equal to 0:
        return 19
    if not (discord_question_choose(journal and database and second and "500" and "300" and "200" and "topic" and 0 and "") equals "question-authority-denied"):
        return 20
    if archive_verify(database and archive_list_text(agent_run_read(database and run) and 0)) is not equal to 0:
        return 21
    display "PASS: admitted Discord questions retain drafts across reopen, require explicit complete answers, deny foreign actors/channels/guilds and revoked authority, and append one scoped answer/guidance receipt."
    return 0
