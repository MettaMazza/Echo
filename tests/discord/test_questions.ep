import "../../app/discord/question_store"
import "../../app/discord/question_controls"
import "../../app/discord/interaction_recovery"
import "../../app/discord/question_action"
import "../../app/discord/question_pages"
import "../../app/discord/question_delivery"
import "../../app/discord/question_scheduler"
import "../../app/discord/question_view"
import "../../app/discord/worker_delivery"

define question_control_fixture with identity as Str and actor as Str and room as Str and message as Str and kind as Int returning Str:
    set body to concat("{\"type\":" and concat(int_to_string(kind) and ",\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":"))
    set body to concat(body and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"message\":{\"author\":{\"id\":\"900\"},\"id\":"))))
    set body to concat(body and concat(provider_quote(message) and "},\"data\":{\"component_type\":2,\"custom_id\":"))
    return concat(body and concat(provider_quote(identity) and "}}"))

define question_action_fixture with journal as Int and identity as Str and body as Str returning Int:
    set saved to discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body)
    return archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledged',0,'fixture');" and [identity]) and 101)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if database equals 0 or else journal equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if not (delegation_schema(database) equals "applied"):
        return 22
    set body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Ask me three questions\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set admitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and ["400"])
    if not (archive_list_text(admitted and 0) equals "accepted"):
        return 4
    set run to "discord-message:100"
    set questions to "{\"questions\":[{\"id\":\"topic\",\"title\":\"What topic?\",\"options\":[\"Art\",\"Science\",\"Music\"]},{\"id\":\"length\",\"title\":\"How long?\",\"options\":[\"Short\",\"Long\"]},{\"id\":\"notes\",\"title\":\"Anything else?\",\"options\":[]}]}"
    if sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='discord-message:100';") is not equal to 0 or else string_contains(questions_save(database and run and "ask" and questions) and "awaiting-user-input") equals 0:
        return 5
    set binding to discord_question_bind(journal and database and run)
    if string_length(binding) is not equal to 70 or else not (discord_question_bind(journal and database and run) equals binding):
        return 6
    set defaults to history_collect_one(checkpoint_prepare(journal and "SELECT count(*) FROM discord_question_drafts WHERE question=?1 AND choice=0 AND text='';" and [binding]))
    set unanswered to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind IN ('user_input_answered','guidance_received');"))
    if not (archive_list_text(defaults and 1) equals "2") or else not (archive_list_text(unanswered and 1) equals "0"):
        return 78
    if discord_question_scheduler_schema(journal) is not equal to 0 or else discord_question_discover(journal and database) is not equal to 0:
        return 64
    set discovered to history_collect_one(archive_prepare(journal and "SELECT count(*) FROM discord_question_schedule WHERE run='discord-message:100' AND active=1;"))
    if not (archive_list_text(discovered and 1) equals "1"):
        return 65
    set page_index to 0
    repeat while page_index < 4:
        if not (discord_question_page_prepare(journal and database and run) equals "question-page-prepared"):
            return 49
        set page_index to page_index + 1
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_question_page_prepare(journal and database and run) equals "question-pages-ready"):
        return 50
    set page_count to history_collect_one(archive_prepare(journal and "SELECT count(*),count(DISTINCT position) FROM discord_question_pages;"))
    if not (archive_list_text(page_count and 1) equals "4") or else not (archive_list_text(page_count and 2) equals "4"):
        return 51
    set controls_count to history_collect_one(archive_prepare(journal and "SELECT count(*) FROM discord_question_controls;"))
    if not (archive_list_text(controls_count and 1) equals "9"):
        return 52
    if discord_worker_schema(journal) is not equal to 0 or else discord_delivery_schema(journal) is not equal to 0:
        return 53
    if not (archive_list_text(discord_reply_due(journal and ep_time_now_ms()) and 0) equals "end"):
        return 54
    if not (discord_worker_deliver("" and "" and journal and "question-page:fixture" and "900" and ["400"] and "" and "") equals "separate-activity-worker"):
        return 55
    set first_page to discord_question_page_due(journal and ep_time_now_ms())
    if not (archive_list_text(first_page and 0) equals "found") or else not (archive_list_text(discord_question_page_context(journal and database and archive_list_text(first_page and 1)) and 0) equals "found"):
        return 56
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_outbox SET state='uncertain' WHERE identity=?1;" and [archive_list_text(first_page and 1)]) and 101) is not equal to 0:
        return 57
    if not (archive_list_text(discord_question_page_due(journal and ep_time_now_ms()) and 0) equals "end"):
        return 58
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_outbox SET state='sent',message='800' WHERE identity=?1;" and [archive_list_text(first_page and 1)]) and 101) is not equal to 0:
        return 59
    set submit_page to history_collect_one(archive_prepare(journal and "SELECT outbox FROM discord_question_pages WHERE position=3;"))
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_outbox SET state='sent',message='803' WHERE identity=?1;" and [archive_list_text(submit_page and 1)]) and 101) is not equal to 0:
        return 68
    set incomplete_view to discord_question_view(journal and database and archive_list_text(submit_page and 1))
    set disabled to history_collect_one(checkpoint_prepare(journal and "SELECT json_extract(?1,'$.components[0].components[0].disabled');" and [archive_list_text(incomplete_view and 1)]))
    if not (archive_list_text(incomplete_view and 0) equals "found") or else not (archive_list_text(disabled and 1) equals "1"):
        return 69
    if discord_question_sync_schema(journal) is not equal to 0:
        return 73
    set observed_view to history_collect_one(checkpoint_prepare(journal and "SELECT json_set(?1,'$.id','803','$.channel_id','300','$.author',json('{\"id\":\"900\"}'),'$.components[0].id',77,'$.components[0].components[0].id',78);" and [archive_list_text(incomplete_view and 1)]))
    if not (discord_question_view_observe(journal and archive_list_text(submit_page and 1) and "900" and archive_list_text(incomplete_view and 1) and archive_list_text(observed_view and 1)) equals "question-view-observed"):
        return 74
    for each mutation in ["$.id","$.channel_id","$.author.id","$.message_reference.message_id","$.components[0].components[0].custom_id","$.components[0].components[0].label"]:
        set invalid_view to history_collect_one(checkpoint_prepare(journal and "SELECT json_set(?1,?2,'wrong');" and [archive_list_text(observed_view and 1),ptr_to_str(mutation)]))
        if discord_question_view_matches(journal and archive_list_text(submit_page and 1) and "900" and archive_list_text(incomplete_view and 1) and archive_list_text(invalid_view and 1)) is not equal to 0:
            return 75
    set wrong_disabled to history_collect_one(checkpoint_prepare(journal and "SELECT json_set(?1,'$.components[0].components[0].disabled',json('false'));" and [archive_list_text(observed_view and 1)]))
    if discord_question_view_matches(journal and archive_list_text(submit_page and 1) and "900" and archive_list_text(incomplete_view and 1) and archive_list_text(wrong_disabled and 1)) is not equal to 0:
        return 76
    if not (discord_question_view_sync("" and "" and journal and database and archive_list_text(submit_page and 1) and "900" and [] and [] and "" and "") equals "question-view-settled"):
        return 77
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_question_view_observe(journal and archive_list_text(submit_page and 1) and "900" and archive_list_text(incomplete_view and 1) and archive_list_text(observed_view and 1)) equals "question-view-observed"):
        return 79
    set receipt_count to history_collect_one(archive_prepare(journal and "SELECT count(*) FROM discord_question_view_receipts;"))
    if not (archive_list_text(receipt_count and 1) equals "1"):
        return 80
    if sql_execute(journal and "DELETE FROM discord_question_view_receipts;") equals 0:
        return 81
    set second_page to discord_question_page_due(journal and ep_time_now_ms())
    if not (archive_list_text(second_page and 0) equals "found") or else archive_list_text(second_page and 1) equals archive_list_text(first_page and 1):
        return 60
    set queued to discord_outbox_enqueue(journal and "question:100" and "message:create:100" and "300" and "{\"content\":\"Questions\"}")
    set other to discord_question_control_bind(journal and binding and "question:100" and "other" and 0 and -1)
    set choice_control to discord_question_control_bind(journal and binding and "question:100" and "choice" and 0 and 1)
    if string_length(other) is not equal to 71 or else not (discord_question_control_bind(journal and binding and "question:100" and "other" and 0 and -1) equals other):
        return 23
    set click to question_control_fixture(other and "500" and "300" and "700" and 3)
    if string_length(discord_question_other_modal(journal and click and "900")) > 0:
        return 24
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='question:100';") is not equal to 0:
        return 25
    set modal to discord_question_other_modal(journal and click and "900")
    if provider_json_tokens(modal) equals 0 or else string_contains(modal and "Your answer") equals 0 or else string_contains(modal and "Science"):
        return 26
    for each invalid in [question_control_fixture(other and "501" and "300" and "700" and 3),question_control_fixture(other and "500" and "301" and "700" and 3),question_control_fixture(other and "500" and "300" and "701" and 3),question_control_fixture(choice_control and "500" and "300" and "700" and 5)]:
        set denied to discord_question_control_resolve(journal and ptr_to_str(invalid) and "900")
        if archive_list_text(denied and 0) equals "found":
            return 27
    set submission to discord_question_control_resolve(journal and question_control_fixture(other and "500" and "300" and "700" and 5) and "900")
    if not (archive_list_text(submission and 0) equals "found") or else not (archive_list_text(submission and 2) equals binding):
        return 28
    # Modal-open is terminal on confirmed ACK, and is never recovered as a
    # deferred original after interruption. No callback retry or network here.
    if discord_interaction_schema(journal) is not equal to 0:
        return 29
    for each identity in ["interaction:modal-confirmed","interaction:modal-unknown"]:
        set saved to discord_inbox_record(journal and ptr_to_str(identity) and "INTERACTION_CREATE" and click)
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledging',0,'');" and [ptr_to_str(identity)]) and 101) is not equal to 0:
            return 30
        if not (discord_interaction_callback_prepare(journal and ptr_to_str(identity) and click and modal) equals "modal"):
            return 31
        if not (discord_interaction_callback_prepare(journal and ptr_to_str(identity) and click and "{\"type\":5,\"data\":{\"flags\":64}}") equals "ack-callback-denied"):
            return 32
    if not (discord_interaction_ack_record(journal and "interaction:modal-confirmed" and 1) equals "completed") or else not (discord_interaction_ack_record(journal and "interaction:modal-confirmed" and 0) equals "stale-ack"):
        return 33
    # Simulate the actual ACK owner's startup conversion after a lost response.
    if sql_execute(journal and "UPDATE discord_interaction_jobs SET state='uncertain',detail='ack-owner-interrupted' WHERE state='acknowledging';") is not equal to 0:
        return 34
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_interaction_callback_kind(journal and "interaction:modal-unknown") equals "modal") or else not (discord_interaction_recover("" and "" and journal and "interaction:modal-unknown" and "900" and "") equals "ack-expired"):
        return 35
    set terminal to history_collect_one(archive_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity='interaction:modal-unknown';"))
    if not (archive_list_text(terminal and 1) equals "expired") or else not (archive_list_text(terminal and 2) equals "modal-open-unconfirmed-no-replay"):
        return 36
    set first_click to question_control_fixture(choice_control and "500" and "300" and "700" and 3)
    set music_control to discord_question_control_bind(journal and binding and "question:100" and "choice" and 0 and 2)
    set next_click to question_control_fixture(music_control and "500" and "300" and "700" and 3)
    if question_action_fixture(journal and "interaction:choice-delayed" and first_click) is not equal to 0:
        return 66
    if question_action_fixture(journal and "interaction:choice-first" and first_click) is not equal to 0 or else question_action_fixture(journal and "interaction:choice-next" and next_click) is not equal to 0:
        return 37
    if not (discord_question_action_apply(journal and database and "interaction:choice-first" and first_click and "900") equals "question-draft-saved") or else not (discord_question_action_apply(journal and database and "interaction:choice-next" and next_click and "900") equals "question-draft-saved"):
        return 38
    if not (discord_question_action_apply(journal and database and "interaction:choice-first" and first_click and "900") equals "question-draft-saved"):
        return 39
    if not (discord_question_action_apply(journal and database and "interaction:choice-delayed" and first_click and "900") equals "question-draft-superseded"):
        return 67
    set draft to history_collect_one(checkpoint_prepare(journal and "SELECT choice FROM discord_question_drafts WHERE question=?1 AND item='topic';" and [binding]))
    set selected_view to discord_question_view(journal and database and archive_list_text(first_page and 1))
    set selected to history_collect_one(checkpoint_prepare(journal and "SELECT json_extract(?1,'$.components[0].components[2].style'),json_extract(?1,'$.components[0].components[0].style');" and [archive_list_text(selected_view and 1)]))
    if not (archive_list_text(selected and 1) equals "3") or else not (archive_list_text(selected and 2) equals "2"):
        return 70
    if not (archive_list_text(draft and 1) equals "2"):
        return 40
    if not (discord_question_action_apply(journal and database and "interaction:choice-first" and next_click and "900") equals "question-control-denied"):
        return 41
    set notes_control to discord_question_control_bind(journal and binding and "question:100" and "other" and 0 and -1)
    set notes_body to string_replace(question_control_fixture(notes_control and "500" and "300" and "700" and 5) and "\"component_type\":2," and "\"components\":[{\"type\":18,\"component\":{\"type\":4,\"custom_id\":\"answer\",\"value\":\"Keep café examples\"}}],")
    if question_action_fixture(journal and "interaction:notes" and notes_body) is not equal to 0 or else not (discord_question_action_apply(journal and database and "interaction:notes" and notes_body and "900") equals "question-draft-saved"):
        return 42
    if not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-answer-not-accepted"):
        return 7
    if not (discord_question_choose(journal and database and binding and "501" and "300" and "200" and "topic" and 0 and "") equals "question-binding-denied") or else not (discord_question_choose(journal and database and binding and "500" and "301" and "200" and "topic" and 0 and "") equals "question-binding-denied") or else not (discord_question_choose(journal and database and binding and "500" and "300" and "201" and "topic" and 0 and "") equals "question-binding-denied"):
        return 8
    if not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "topic" and 3 and "") equals "invalid-question-choice") or else not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "notes" and -1 and " ") equals "invalid-question-choice"):
        return 9
    if not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "topic" and 1 and "") equals "question-draft-saved") or else not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "length" and 0 and "") equals "question-draft-saved"):
        return 10
    if questions_pending(database and run) equals "null" or else not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-answer-not-accepted"):
        return 11
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_question_bind(journal and database and run) equals binding) or else not (discord_question_choose(journal and database and binding and "500" and "300" and "200" and "notes" and -1 and "Keep café examples") equals "question-draft-saved"):
        return 12
    set complete_view to discord_question_view(journal and database and archive_list_text(submit_page and 1))
    set enabled to history_collect_one(checkpoint_prepare(journal and "SELECT json_extract(?1,'$.components[0].components[0].disabled');" and [archive_list_text(complete_view and 1)]))
    if not (archive_list_text(enabled and 1) equals "0"):
        return 71
    # A delayed observation of the older disabled view cannot confirm the new
    # enabled view. The stored applied hash still describes what was observed.
    if not (discord_question_view_observe(journal and archive_list_text(submit_page and 1) and "900" and archive_list_text(complete_view and 1) and archive_list_text(observed_view and 1)) equals "question-view-unconfirmed"):
        return 82
    set applied to history_collect_one(checkpoint_prepare(journal and "SELECT applied FROM discord_question_views WHERE outbox=?1;" and [archive_list_text(submit_page and 1)]))
    if not (archive_list_text(applied and 1) equals archive_list_text(incomplete_view and 2)):
        return 83
    set submit_control to discord_question_control_bind(journal and binding and "question:100" and "submit" and -1 and -1)
    set submit_body to question_control_fixture(submit_control and "500" and "300" and "700" and 3)
    if question_action_fixture(journal and "interaction:submit" and submit_body) is not equal to 0 or else question_action_fixture(journal and "interaction:submit-interrupted" and submit_body) is not equal to 0:
        return 43
    # Freeze a second submission before the archive commit, then recover it
    # after the first succeeds: models the cross-database interruption window.
    set snapshot to history_collect_one(checkpoint_prepare(journal and "SELECT json_group_array(json_object('id',item,'choice',choice,'text',text)) FROM (SELECT item,choice,text FROM discord_question_drafts WHERE question=?1 ORDER BY item);" and [binding]))
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_question_operations(identity,intake_sha256,answers) VALUES('interaction:submit-interrupted',?1,?2);" and [ep_sha256(submit_body),archive_list_text(snapshot and 1)]) and 101) is not equal to 0:
        return 44
    if not (discord_question_action_apply(journal and database and "interaction:submit" and submit_body and "900") equals "question-answered"):
        return 45
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_question_action_apply(journal and database and "interaction:submit-interrupted" and submit_body and "900") equals "question-answered") or else not (discord_question_action_apply(journal and database and "interaction:submit" and submit_body and "900") equals "question-answered"):
        return 46
    if not (discord_question_action_apply(journal and database and "interaction:submit" and submit_body and "900") equals "question-answered") or else not (questions_pending(database and run) equals "null"):
        return 13
    if not (discord_question_submit(journal and database and binding and "500" and "300" and "200") equals "question-no-longer-pending"):
        return 14
    if not (archive_list_text(discord_question_page_context(journal and database and archive_list_text(second_page and 1)) and 0) equals "question-no-longer-pending"):
        return 61
    # Empty transport parameters prove stale page withdrawal runs before network.
    if not (discord_question_page_deliver("" and "" and journal and database and archive_list_text(second_page and 1) and "900" and ["200"] and ["400"] and "" and "") equals "question-pages-withdrawn"):
        return 62
    set withdrawn to history_collect_one(archive_prepare(journal and "SELECT count(*) FROM discord_question_pages p JOIN discord_outbox o ON o.identity=p.outbox WHERE o.state='rejected';"))
    if not (archive_list_text(withdrawn and 1) equals "2"):
        return 63
    set closed_view to discord_question_view(journal and database and archive_list_text(first_page and 1))
    set closed_control to history_collect_one(checkpoint_prepare(journal and "SELECT json_extract(?1,'$.components[0].components[0].disabled');" and [archive_list_text(closed_view and 1)]))
    if not (archive_list_text(closed_control and 1) equals "1") or else string_contains(archive_list_text(closed_view and 1) and "Answers submitted.") equals 0 or else string_contains(archive_list_text(closed_view and 1) and "café"):
        return 72
    set count to history_collect_one(checkpoint_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='user_input_answered' AND json_extract(payload,'$.run_id')=?1;" and [run]))
    if not (archive_list_text(count and 1) equals "1"):
        return 15
    set guidance to guidance_pending(database and run)
    if not (archive_list_text(guidance and 0) equals "found") or else string_contains(archive_list_text(guidance and 2) and "Science") equals 0 or else string_contains(archive_list_text(guidance and 2) and "café") equals 0:
        return 16
    if string_contains(questions_save(database and run and "second" and questions) and "awaiting-user-input") equals 0:
        return 17
    set second to discord_question_bind(journal and database and run)
    if second equals binding or else string_length(second) is not equal to 70:
        return 18
    if sql_execute(database and "INSERT INTO echo_cancel_requests VALUES('discord-message:100','discord:500');") is not equal to 0:
        return 47
    if not (discord_question_choose(journal and database and second and "500" and "300" and "200" and "topic" and 0 and "") equals "question-no-longer-pending"):
        return 48
    set orphan_body to "{\"content\":\"Interrupted question page\"}"
    if not (discord_question_intent(journal and "question-page:orphan-fixture" and second and 0 and orphan_body) equals "question-intent-recorded") or else not (discord_outbox_enqueue(journal and "question-page:orphan-fixture" and "message:create:100" and "300" and orphan_body) equals "enqueued"):
        return 84
    if not (discord_question_intent(journal and "question-page:orphan-fixture" and second and 0 and "{}") equals "question-intent-conflict"):
        return 85
    set closed to sql_close(journal)
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    if not (discord_question_orphan_tick(journal and database) equals "question-orphan-withdrawn") or else not (discord_question_orphan_tick(journal and database) equals "question-orphans-idle"):
        return 86
    set orphan to history_collect_one(archive_prepare(journal and "SELECT o.state,(SELECT count(*) FROM discord_delivery_events e WHERE e.identity=o.identity) FROM discord_outbox o WHERE o.identity='question-page:orphan-fixture';"))
    if not (archive_list_text(orphan and 1) equals "rejected") or else not (archive_list_text(orphan and 2) equals "1"):
        return 87
    if web_device_revoke(database and "discord:500") is not equal to 0:
        return 19
    if not (discord_question_choose(journal and database and second and "500" and "300" and "200" and "topic" and 0 and "") equals "question-authority-denied"):
        return 20
    if archive_verify(database and archive_list_text(agent_run_read(database and run) and 0)) is not equal to 0:
        return 21
    display "PASS: admitted Discord questions retain drafts across reopen, require explicit complete answers, deny foreign actors/channels/guilds and revoked authority, and append one scoped answer/guidance receipt."
    return 0
