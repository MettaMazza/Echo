import "../../app/discord/command_response"

# Network-free negative tests must stop before opening a transport. Positive
# HTTP delivery remains a live acceptance requirement, not a fixture claim.
define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_interaction_schema(journal) is not equal to 0:
        return 2
    if not (discord_command_public_anchor("" and "" and journal and "interaction:701" and "900" and ["200"] and ["400"] and "" and get_argument(2)) equals "command-response-expired"):
        return 3
    set original to "{\"id\":\"701\",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\"}}"
    set saved to discord_inbox_record(journal and "interaction:701" and "INTERACTION_CREATE" and original)
    if discord_interaction_queue(journal and "interaction:701") is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES('interaction:701','synthetic_response_credential_1234','fixture',0,CAST(?1 AS INTEGER)+900000);" and [int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 4
    if not (discord_command_public_anchor("" and "" and journal and "interaction:701" and "900" and ["200"] and ["400"] and "" and get_argument(2)) equals "command-not-acknowledged"):
        return 5
    if sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledged';") is not equal to 0 or else not (discord_command_public_anchor("" and "" and journal and "interaction:701" and "900" and ["200"] and ["400"] and "" and get_argument(2)) equals "command-requires-public-ack"):
        return 6
    if sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledging';") is not equal to 0 or else not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else not (discord_interaction_visibility_prepare(journal and "interaction:701" and original) equals "public") or else sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledged';") is not equal to 0:
        return 7
    if not (discord_command_public_anchor("" and "" and journal and "interaction:701" and "900" and ["200"] and create_list() and "" and get_argument(2)) equals "admin-required"):
        return 8
    display "PASS: command original response fails before network on expired credential, unacknowledged source, legacy private callback and missing current admin; live positive pending"
    return 0
