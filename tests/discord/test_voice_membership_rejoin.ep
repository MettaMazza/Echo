import "../../app/discord/gateway_intake"
import "../../app/discord/voice_membership_reader"

define rejoin_event with database as Int and sequence as Int and kind as Str and data as Str returning Str:
    set body to concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":" and concat(provider_quote(kind) and concat(",\"d\":" and concat(data and "}"))))))
    return discord_gateway_intake(database and "generation" and "300" and ["100"] and [] and body)

define rejoin_read with database as Int and identity as Str returning List:
    return discord_voice_membership_read_intent(database and "generation" and "session" and 1 and "100" and "200" and "300" and identity)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_runtime_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set baseline to "{\"id\":\"100\",\"roles\":[],\"voice_states\":[{\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"old-bot\"},{\"user_id\":\"400\",\"channel_id\":\"200\",\"session_id\":\"guest-a\"}]}"
    set recorded to rejoin_event(database and 1 and "GUILD_CREATE" and baseline)
    set left to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":null,\"session_id\":\"old-bot\"}"
    set recorded to rejoin_event(database and 2 and "VOICE_STATE_UPDATE" and left)
    set guest to "{\"guild_id\":\"100\",\"user_id\":\"500\",\"channel_id\":\"200\",\"session_id\":\"guest-b\"}"
    set recorded to rejoin_event(database and 3 and "VOICE_STATE_UPDATE" and guest)
    set moved to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"201\",\"session_id\":\"other-room\"}"
    set recorded to rejoin_event(database and 4 and "VOICE_STATE_UPDATE" and moved)
    set evidence to ep_sha256("fixture-authority")
    set requested to discord_voice_intent_request(database and "new-join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claim to discord_voice_intent_claim(database and "new-join" and "generation" and 4 and evidence)
    if not (discord_voice_intent_written(database and "new-join" and archive_list_text(claim and 1) and 1) equals "sent"):
        return 2
    set joined to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"new-bot\"}"
    set recorded to rejoin_event(database and 5 and "VOICE_STATE_UPDATE" and joined)
    set legacy to discord_voice_membership_read(database and "generation" and "session" and 1 and "100" and "200" and "300")
    if not (archive_list_text(legacy and 0) equals "voice-membership-invalidated"):
        return 3
    set result to rejoin_read(database and "new-join")
    if not (archive_list_text(result and 0) equals "voice-membership-ready") or else length_list(discord_voice_membership_roster(get_list(result and 1) and 1)) is not equal to 3 or else get_list(result and 2) is not equal to 5:
        return 4
    set wrong to rejoin_read(database and "unknown-intent")
    if not (archive_list_text(wrong and 0) equals "stale-voice-membership-intent"):
        return 5
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "300")
    set result to rejoin_read(database and "new-join")
    if not (archive_list_text(result and 0) equals "voice-membership-ready"):
        return 6
    set recorded to rejoin_event(database and 6 and "VOICE_STATE_UPDATE" and left)
    set result to rejoin_read(database and "new-join")
    if not (archive_list_text(result and 0) equals "voice-membership-invalidated"):
        return 7
    # Even a rejoin using the same reported session cannot resurrect this owner.
    set recorded to rejoin_event(database and 7 and "VOICE_STATE_UPDATE" and joined)
    set result to rejoin_read(database and "new-join")
    if not (archive_list_text(result and 0) equals "voice-membership-invalidated"):
        return 8
    set cancelled to discord_voice_intent_cancel(database and "new-join")
    set leave_claim to discord_voice_leave_claim(database and "new-join" and "generation")
    set written to discord_voice_leave_written(database and "new-join" and archive_list_text(leave_claim and 1) and 1)
    set recorded to rejoin_event(database and 8 and "VOICE_STATE_UPDATE" and left)
    if not (discord_voice_leave_reconcile(database and "new-join" and "generation" and "300") equals "voice-left-confirmed"):
        return 9
    set guest_left to "{\"guild_id\":\"100\",\"user_id\":\"500\",\"channel_id\":null}"
    set recorded to rejoin_event(database and 9 and "VOICE_STATE_UPDATE" and guest_left)
    set requested to discord_voice_intent_request(database and "next-join" and "100" and "200" and "400" and "run" and "next-call" and evidence)
    set claim to discord_voice_intent_claim(database and "next-join" and "generation" and 9 and evidence)
    set written to discord_voice_intent_written(database and "next-join" and archive_list_text(claim and 1) and 1)
    set recorded to rejoin_event(database and 10 and "VOICE_STATE_UPDATE" and joined)
    set result to rejoin_read(database and "next-join")
    if not (archive_list_text(result and 0) equals "voice-membership-ready") or else length_list(discord_voice_membership_roster(get_list(result and 1) and 1)) is not equal to 2:
        return 10
    set wrong to rejoin_read(database and "new-join")
    if not (archive_list_text(wrong and 0) equals "stale-voice-membership-intent"):
        return 11
    set recorded to rejoin_event(database and 11 and "VOICE_STATE_UPDATE" and "{\"guild_id\":\"100\",\"user_id\":\"400\"}")
    set result to rejoin_read(database and "next-join")
    if not (archive_list_text(result and 0) equals "voice-membership-invalidated"):
        return 12
    set closed to sql_close(database)
    display "PASS: exact intent replays prior departures without erasing other members; restart and new joins recover, current departures/rejoins and malformed observations remain invalidating."
    return 0
