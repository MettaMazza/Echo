import "../../app/memory/context_snapshot"

define main returning Int:
    if get_argument_count() is not equal to 15 or else not (get_argument(13) equals "--turn"):
        return 1
    set database to archive_open(get_argument(4))
    set run to get_argument(14)
    if discord_memory_prepare(database and run) is not equal to 0:
        return 2
    set records to group_memory_records(database and run)
    if provider_json_tokens(records) equals 0:
        return 3
    set needle to ptr_to_str(get_env("ECHO_VERIFY_SOURCE_EVENT"))
    if string_contains(records and needle) equals 0:
        display "Source absent from automatic recall."
        return 4
    display "PASS: original consent is included in automatic prompt records under live Discord access checks, without a model retrieval call."
    display concat("Automatic context bytes: " and int_to_string(string_length(records)))
    return sql_close(database)
