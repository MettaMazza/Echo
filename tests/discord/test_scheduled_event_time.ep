import "../../app/discord/scheduled_event_time"

define main returning Int:
    if discord_event_timestamp("1970-01-01T00:00:00Z") is not equal to 0:
        return 1
    if discord_event_timestamp("2000-02-29T12:00:00Z") is not equal to 951825600000:
        return 2
    if discord_event_timestamp("2026-10-25T01:30:00+01:00") is not equal to 1792888200000:
        return 3
    if discord_event_timestamp("2026-10-25T01:30:00Z") - discord_event_timestamp("2026-10-25T01:30:00+01:00") is not equal to 3600000:
        return 4
    if discord_event_timestamp("2026-10-22T10:30:45.12-03:30") - discord_event_timestamp("2026-10-22T14:00:45Z") is not equal to 120:
        return 5
    if discord_event_timestamp("2026-10-22T14:00:45.123456789Z") - discord_event_timestamp("2026-10-22T14:00:45Z") is not equal to 123:
        return 6
    set invalid to ["2026-02-29T00:00:00Z","2100-02-29T00:00:00Z","2026-04-31T00:00:00Z","2026-13-01T00:00:00Z","2026-00-01T00:00:00Z","2026-01-00T00:00:00Z","2026-01-01T24:00:00Z","2026-01-01T00:60:00Z","2026-01-01T00:00:60Z","2026-01-01T00:00:00","2026-01-01T00:00:00-00:00","2026-01-01T00:00:00+24:00","2026-01-01T00:00:00+01:60","2026-01-01T00:00:00.Z","2026-01-01T00:00:00Zsuffix","2026-01-01T00:00:00.1234567890Z","2026-01-01 00:00:00Z","tomorrow","202x-01-01T00:00:00Z"]
    for each item in invalid:
        if discord_event_timestamp(ptr_to_str(item)) is not equal to -1:
            display ptr_to_str(item)
            return 7
    display "PASS: explicit timestamp zones, DST ambiguity separation, leap-year boundaries, fractions and invalid dates."
    return 0
