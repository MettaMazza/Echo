import "../../app/discord/voice_opus"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 90
    if discord_voice_opus_open("/usr/lib/libSystem.B.dylib") is not equal to 0:
        return 1
    set state to discord_voice_opus_open(get_argument(1))
    if state equals 0:
        return 2
    set pcm to research_native_words(480)
    if discord_voice_opus_encode(state and get_list_data_ptr(pcm) and 3839) is not equal to 0 or else discord_voice_opus_encode(state and get_list_data_ptr(pcm) and 3841) is not equal to 0:
        return 3
    set index to 0
    repeat while index < 5:
        set packet to discord_voice_opus_encode(state and get_list_data_ptr(pcm) and 3840)
        if packet equals 0:
            return 4
        set decoded to discord_voice_opus_decode(state and get_list(packet and 0) and get_list(packet and 1))
        if decoded equals 0 or else get_list(decoded and 1) is not equal to 3840:
            return 5
        set released to discord_voice_blob_release(decoded)
        set released to discord_voice_blob_release(packet)
        set index to index + 1
    if discord_voice_opus_decode(state and get_list_data_ptr(pcm) and 0) is not equal to 0 or else discord_voice_opus_decode(state and get_list_data_ptr(pcm) and 65508) is not equal to 0:
        return 6
    if discord_voice_opus_close(state) equals 0 or else discord_voice_opus_close(state) equals 0:
        return 7
    if discord_voice_opus_encode(state and get_list_data_ptr(pcm) and 3840) is not equal to 0:
        return 8
    display "PASS: native Opus codec lifecycle, five 20ms stereo frame roundtrips, exact PCM length boundaries, receive bounds and closed-handle rejection."
    return 0
