import "../../app/discord/message_actions"

define action_test_body with identity as Str and actor as Str and room as Str and message as Str returning Str:
    set body to concat("{\"type\":3,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and provider_quote(room))
    set body to concat(body and concat(",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"message\":{\"author\":{\"id\":\"900\"},\"id\":")))
    set body to concat(body and concat(provider_quote(message) and "},\"data\":{\"component_type\":2,\"custom_id\":"))
    return concat(body and concat(provider_quote(identity) and "}}"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set queued to discord_outbox_enqueue(journal and "reply:100" and "message:create:100" and "300" and "{\"content\":\"Hello\"}")
    set speak to discord_message_action_bind(journal and "reply:100" and "speak" and "final:100")
    if string_length(discord_message_action_bind(journal and "reply:100" and "trace" and "final:100")) is not equal to 0:
        return 20
    set trace to discord_message_action_identity("reply:100" and "trace")
    set legacy to archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_message_actions VALUES(?1,'reply:100','trace','final:100');" and [trace]) and 101)
    if string_length(speak) is not equal to 69 or else string_length(trace) is not equal to 69:
        return 2
    if not (discord_message_action_bind(journal and "reply:100" and "speak" and "final:100") equals speak) or else string_length(discord_message_action_bind(journal and "reply:100" and "speak" and "other-final")) is not equal to 0:
        return 3
    set admins to create_list()
    set body to action_test_body(speak and "500" and "300" and "700")
    set result to discord_message_action_resolve(journal and body and "900" and admins)
    if not (archive_list_text(result and 0) equals "action-binding-denied"):
        return 4
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='reply:100';") is not equal to 0:
        return 5
    set result to discord_message_action_resolve(journal and body and "900" and admins)
    if not (archive_list_text(result and 0) equals "bound-needs-live-access") or else not (archive_list_text(result and 2) equals "final:100"):
        return 6
    set result to discord_message_action_resolve(journal and action_test_body(speak and "501" and "300" and "700") and "900" and admins)
    if not (archive_list_text(result and 0) equals "action-binding-denied"):
        return 7
    set result to discord_message_action_resolve(journal and action_test_body(speak and "500" and "301" and "700") and "900" and admins)
    if not (archive_list_text(result and 0) equals "action-binding-denied"):
        return 8
    set result to discord_message_action_resolve(journal and action_test_body(speak and "500" and "300" and "701") and "900" and admins)
    if not (archive_list_text(result and 0) equals "action-binding-denied"):
        return 9
    set result to discord_message_action_resolve(journal and action_test_body(trace and "500" and "300" and "700") and "900" and admins)
    if not (archive_list_text(result and 0) equals "private-activity-retired"):
        return 10
    set added to append_list(admins and "500")
    set result to discord_message_action_resolve(journal and action_test_body(trace and "500" and "300" and "700") and "900" and admins)
    if not (archive_list_text(result and 0) equals "private-activity-retired"):
        return 11
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_message_action_bind(journal and "reply:100" and "speak" and "final:100") equals speak):
        return 12
    set result to discord_message_action_resolve(journal and body and "901" and admins)
    if not (archive_list_text(result and 0) equals "foreign-application"):
        return 13
    display "PASS: immutable reply/final action binding, confirmed-message requirement, actor/channel/message isolation, retired private trace denial and restart identity"
    return 0
