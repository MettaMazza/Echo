import "../../app/discord/gateway_intake"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 2
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"session-a\",\"resume_gateway_url\":\"wss://gateway.discord.gg\"}}"
    if not (discord_gateway_ready_record(database and "socket-a" and "900" and ready) equals "recorded"):
        return 3
    set kinds to ["GUILD_EMOJIS_UPDATE","GUILD_STICKERS_UPDATE"]
    set sequence to 2
    for each item in kinds:
        set body to concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":" and concat(provider_quote(ptr_to_str(item)) and ",\"d\":{\"guild_id\":\"200\",\"emojis\":[{\"name\":\"EXCLUDED_DETAIL\",\"user\":{\"id\":\"500\"}}],\"stickers\":[{\"description\":\"EXCLUDED_DETAIL\"}]}}"))))
        if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and [] and body) equals "recorded"):
            return 4
        if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and [] and body) equals "already-recorded"):
            return 5
        set sequence to sequence + 1
    set foreign to "{\"op\":0,\"s\":4,\"t\":\"GUILD_EMOJIS_UPDATE\",\"d\":{\"guild_id\":\"201\",\"emojis\":[{\"name\":\"EXCLUDED_DETAIL\"}]}}"
    if not (discord_gateway_intake(database and "socket-a" and "900" and ["200"] and [] and foreign) equals "recorded"):
        return 6
    set rows to history_collect_one(archive_prepare(database and "SELECT COUNT(*),SUM(CASE WHEN payload='{\"guild_id\":\"200\"}' THEN 1 ELSE 0 END),SUM(instr(payload,'EXCLUDED_DETAIL')) FROM discord_inbox WHERE identity LIKE 'expression-change:%';"))
    if not (archive_list_text(rows and 1) equals "2") or else not (archive_list_text(rows and 2) equals "2") or else not (archive_list_text(rows and 3) equals "0"):
        return 7
    if sql_execute(database and "UPDATE discord_gateway_intents SET mask=112129;") is not equal to 0 or else not (archive_list_text(discord_gateway_resume_read(database) and 0) equals "end"):
        return 8
    if sql_execute(database and "UPDATE discord_gateway_intents SET mask=112137;") is not equal to 0 or else not (archive_list_text(discord_gateway_resume_read(database) and 3) equals "4"):
        return 9
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "900")
    if not (archive_list_text(discord_gateway_resume_read(database) and 3) equals "4"):
        return 10
    set closed to sql_close(database)
    display "PASS: emoji/sticker collection markers retained once, foreign guild and detailed profiles excluded, old intent profile cannot resume, new cursor survives reopen."
    return 0
