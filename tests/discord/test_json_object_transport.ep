import "../../app/discord/onboarding_options"
import "../../app/discord/guild_settings_options"

define patch_transport_arguments with body as Str and encoded as Int and asset as Int returning Str:
    set output to "{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Transport qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\""
    if asset equals 1:
        set output to concat(output and ",\"assets\":")
    else:
        set output to concat(output and ",\"changes\":")
    if encoded equals 1:
        set output to concat(output and provider_quote(body))
    else:
        set output to concat(output and body)
    return concat(output and "}")

define main returning Int:
    set body to "{\"mode\":0,\"prompts\":[{\"id\":\"1\",\"title\":\"Choice\",\"options\":[{\"title\":\"One\",\"description\":\"Text\"}]}],\"enabled\":false}"
    set request to discord_onboarding_options(patch_transport_arguments(body and 0 and 0))
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 5) equals body):
        return 1
    set request to discord_onboarding_options(patch_transport_arguments(body and 1 and 0))
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 5) equals body):
        return 2
    set body to "{\"description\":\"Escaped \\\"quote\\\" and \\n newline\",\"name\":\"Fixture\"}"
    set request to discord_guild_settings_options(patch_transport_arguments(body and 0 and 0))
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 5) equals body):
        return 3
    set request to discord_guild_settings_options(patch_transport_arguments(body and 1 and 0))
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 5) equals body):
        return 4
    set request to discord_onboarding_options(patch_transport_arguments("{}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 5
    set request to discord_onboarding_options(patch_transport_arguments("[]" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 6
    set request to discord_onboarding_options(patch_transport_arguments("null" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 7
    set request to discord_onboarding_options(patch_transport_arguments("false" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 8
    set request to discord_onboarding_options(patch_transport_arguments("\"{}\"" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 9
    set request to discord_onboarding_options(patch_transport_arguments("{" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 10
    set request to discord_onboarding_options(patch_transport_arguments("{\"mode\":99}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 11
    set request to discord_onboarding_options(patch_transport_arguments("{\"unknown\":1}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 12
    set request to discord_onboarding_options(patch_transport_arguments("{\"enabled\":true,\"enabled\":false}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 13
    set request to discord_onboarding_options(patch_transport_arguments("{\"prompts\":[{\"id\":\"1\",\"title\":\"Missing options\"}]}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 14
    set request to discord_guild_settings_options(patch_transport_arguments("{}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 15
    set request to discord_guild_settings_options(patch_transport_arguments("[]" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 16
    set request to discord_guild_settings_options(patch_transport_arguments("null" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 17
    set request to discord_guild_settings_options(patch_transport_arguments("true" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 18
    set request to discord_guild_settings_options(patch_transport_arguments("\"{}\"" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 19
    set request to discord_guild_settings_options(patch_transport_arguments("{" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 20
    set request to discord_guild_settings_options(patch_transport_arguments("{\"owner_id\":\"400\"}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 21
    set request to discord_guild_settings_options(patch_transport_arguments("{\"verification_level\":9}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 22
    set request to discord_guild_settings_options(patch_transport_arguments("{\"description\":7}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 23
    set request to discord_guild_settings_options(patch_transport_arguments("{\"description\":\"a\",\"description\":\"b\"}" and 1 and 0))
    if archive_list_text(request and 0) equals "valid":
        return 24
    set body to "{\"icon\":\"fixture:file\",\"banner\":null}"
    set request to discord_guild_settings_options(patch_transport_arguments(body and 0 and 1))
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 6) equals body):
        return 25
    set request to discord_guild_settings_options(patch_transport_arguments(body and 1 and 1))
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 6) equals body):
        return 26
    set request to discord_guild_settings_options(patch_transport_arguments("[]" and 1 and 1))
    if archive_list_text(request and 0) equals "valid":
        return 27
    set request to discord_guild_settings_options(patch_transport_arguments("null" and 1 and 1))
    if archive_list_text(request and 0) equals "valid":
        return 28
    set request to discord_guild_settings_options(patch_transport_arguments("{\"icon\":7}" and 1 and 1))
    if archive_list_text(request and 0) equals "valid":
        return 29
    set request to discord_guild_settings_options(patch_transport_arguments("{\"owner_id\":\"400\"}" and 1 and 1))
    if archive_list_text(request and 0) equals "valid":
        return 30
    set request to discord_guild_settings_options(patch_transport_arguments("{\"icon\":\"one\",\"icon\":\"two\"}" and 1 and 1))
    if archive_list_text(request and 0) equals "valid":
        return 31
    display "PASS: 31 object/JSON-string transport cases preserve exact settings and asset payloads; malformed, scalar, duplicate, unknown, empty and out-of-bounds edits remain denied."
    return 0
