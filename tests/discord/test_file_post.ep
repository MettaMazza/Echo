import "../../app/discord/post_file"
import "../../app/discord/agent_bridge"
import "../../app/discord/post_options"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Fixture prompt\"}"
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source)
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 3
    set session to archive_list_text(submitted and 1)
    if web_attachment_register(database and "discord:400" and session and "fixture:file" and get_argument(3) and "binary-test.bin" and "application/octet-stream") is not equal to 0:
        return 4
    set file to discord_post_file_source(database and "discord-message:100" and "400" and "fixture:file")
    if not (archive_list_text(file and 0) equals "found") or else archive_list_text(discord_post_file_source(database and "discord-message:100" and "500" and "fixture:file") and 0) equals "found" or else archive_list_text(discord_post_file_source(database and "other-run" and "400" and "fixture:file") and 0) equals "found":
        return 5
    set other_source to string_replace(string_replace(source and "\"id\":\"100\"" and "\"id\":\"101\"") and "\"channel_id\":\"300\"" and "\"channel_id\":\"301\"")
    set recorded to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and other_source)
    set other to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(other and 0) equals "accepted") or else archive_list_text(discord_post_file_source(database and "discord-message:101" and "400" and "fixture:file") and 0) equals "found":
        return 16
    set body to "{\"attachments\":[{\"id\":0,\"filename\":\"binary-test.bin\"}],\"allowed_mentions\":{\"parse\":[]}}"
    if not (discord_outbox_enqueue(journal and "tool-post:file" and "message:create:100" and "300" and body) equals "enqueued") or else not (discord_post_bind(journal and "tool-post:file" and "400" and "300" and "discord-message:100") equals "bound"):
        return 6
    if not (discord_post_file_bind(journal and "tool-post:file" and "fixture:file" and file) equals "bound") or else discord_post_file_bind(journal and "tool-post:file" and "other-file" and file) equals "bound":
        return 7
    set prepared to discord_post_file_prepare(journal and database and "tool-post:file" and "discord-message:100" and "400" and 8)
    if not (archive_list_text(prepared and 0) equals "multipart-ready"):
        display archive_list_text(prepared and 0)
        return 8
    set pointer to get_list(prepared and 1) + get_list(prepared and 4)
    if peek_byte(pointer and 0) is not equal to 0 or else peek_byte(pointer and 1) is not equal to 255 or else peek_byte(pointer and 7) is not equal to 66 or else string_length(archive_list_text(prepared and 5)) is not equal to 64:
        return 9
    set released to discord_audio_multipart_release(prepared)
    set prepared to discord_post_file_prepare(journal and database and "tool-post:file" and "discord-message:100" and "400" and 7)
    if not (archive_list_text(prepared and 0) equals "attachment-too-large-or-empty"):
        return 10
    if discord_file_header_safe("bad\r\nHeader") is not equal to 0 or else discord_file_header_safe("bad\"name") is not equal to 0 or else not (discord_post_filename("../bad\"name.txt") equals ".._bad_name.txt"):
        return 11
    if archive_append(database and session and "excluded:fixture" and "attachment_visibility" and "{\"attachment\":\"fixture:file\",\"state\":\"excluded\"}" and "fixture") is not equal to 0:
        return 12
    if not (archive_list_text(discord_post_file_prepare(journal and database and "tool-post:file" and "discord-message:100" and "400" and 8) and 0) equals "attachment-selection-disabled"):
        return 13
    if sql_execute(journal and "UPDATE discord_tool_post_files SET attachment='different';") equals 0 or else sql_execute(journal and "DELETE FROM discord_tool_post_files;") equals 0:
        return 14
    if not (archive_list_text(discord_post_options("{\"operation\":\"reply\",\"attachment\":\"fixture:file\"}") and 0) equals "valid") or else archive_list_text(discord_post_options("{\"operation\":\"edit\",\"post\":\"p\",\"text\":\"x\",\"attachment\":\"a\"}") and 0) equals "valid":
        return 15
    if archive_append(database and session and "included:fixture" and "attachment_visibility" and "{\"attachment\":\"fixture:file\",\"state\":\"included\"}" and "fixture") is not equal to 0 or else write_file(get_argument(3) and "changed!") is not equal to 1:
        return 17
    if not (archive_list_text(discord_post_file_prepare(journal and database and "tool-post:file" and "discord-message:100" and "400" and 8) and 0) equals "audio-integrity-failed"):
        return 18
    display "PASS: exact current-conversation file, wrong actor/run denial, immutable source binding, binary multipart, size/header limits, excluded-source retry denial and attachment-only options"
    return 0
