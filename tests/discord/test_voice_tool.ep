import "../../app/discord/voice_tool"
import "../../app/discord/voice_dispatch"
import "../../app/discord/worker_store"
import "../../app/discord/gateway_journal"
import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 7 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else web_cancel_schema(database) is not equal to 0:
        return 6
    if not (delegation_schema(database) equals "applied"):
        return 26
    set admin_ids to ["500"]
    set admin_device to discord_agent_principal(database and "500" and admin_ids)
    set journal to discord_store_open(get_argument(2) and "900")
    set source_body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Join authorised voice\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source_body) equals "recorded"):
        return 12
    if discord_worker_schema(journal) is not equal to 0:
        return 21
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:100"):
        return 22
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and admin_ids)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 12
    set listener to local_socket_listen(0)
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"voice-call\",\"function\":{\"name\":\"discord_voice\",\"arguments\":\"{\\\"operation\\\":\\\"join\\\",\\\"channel\\\":\\\"600\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "discord-message:100" and "voice-request" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0 or else discord_voice_intent_schema(journal) is not equal to 0:
        return 16
    if discord_voice_launch_schema(journal) is not equal to 0:
        return 30
    set source to discord_run_source(journal and database and "discord-message:100")
    set options to discord_voice_options("{\"operation\":\"join\",\"channel\":\"600\"}")
    set fixture to ep_dlopen(get_argument(3))
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set denied to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and options and "900" and ["200"] and [] and get_argument(4) and "/absent-fixture-stop")
    if string_index_of(denied and "voice-admin-origin-denied") < 0 or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 0:
        return 31
    set unavailable to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    if string_index_of(unavailable and "voice-runtime-unavailable") < 0:
        display unavailable
        return 32
    set enabled to sql_execute(journal and "INSERT INTO discord_voice_runtime(singleton,enabled) VALUES(1,1);")
    set result to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    set fields to provider_json_tokens(result)
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "queued") or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 11:
        display result
        return 33
    set identity to provider_value(fields and provider_member(fields and 0 and "intent"))
    set duplicate to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    if string_index_of(duplicate and "existing:queued") < 0:
        return 34
    set count to history_collect_one(archive_prepare(journal and "SELECT count(*) FROM discord_voice_intents;"))
    if not (archive_list_text(count and 1) equals "1"):
        return 35
    set inspect_options to create_list()
    set inspect_options to ["valid","status",identity]
    set observed to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and inspect_options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    set observed_fields to provider_json_tokens(observed)
    if not (provider_value(observed_fields and provider_member(observed_fields and 0 and "status")) equals "queued"):
        return 39
    set foreign to discord_voice_intent_request(journal and "foreign-voice" and "201" and "601" and "500" and "discord-message:100" and "voice-call" and ep_sha256("fixture"))
    set foreign_options to create_list()
    set foreign_options to ["valid","status","foreign-voice"]
    set hidden to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and foreign_options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    if string_index_of(hidden and "voice-intent-unavailable") < 0:
        return 40
    set leave_options to create_list()
    set leave_options to ["valid","leave",identity]
    set left to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and leave_options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    set left_fields to provider_json_tokens(left)
    if not (provider_value(left_fields and provider_member(left_fields and 0 and "status")) equals "cancelled") or else not (provider_value(left_fields and provider_member(left_fields and 0 and "effects")) equals "queued join cancelled locally; no Gateway leave needed"):
        return 41
    set changed to discord_inbox_record(journal and "message:update:100:fixture" and "MESSAGE_UPDATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"content\":\"changed\"}")
    set edited to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:100" and "voice-call" and source and options and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    if string_index_of(edited and "voice-source-or-authority-changed") < 0:
        display edited
        return 36
    for each invalid in ["{}","{\"operation\":\"join\",\"channel\":600}","{\"operation\":\"join\",\"channel\":\"600\",\"token\":\"x\"}","{\"operation\":\"join\",\"operation\":\"leave\",\"channel\":\"600\"}","{\"operation\":\"play\",\"channel\":\"600\"}","{\"operation\":\"status\",\"intent\":\"x\",\"channel\":\"600\"}"]:
        if archive_list_text(discord_voice_options(ptr_to_str(invalid)) and 0) equals "valid":
            return 37
    if not (archive_list_text(discord_voice_options("{\"operation\":\"status\",\"intent\":\"x\"}") and 0) equals "valid") or else not (archive_list_text(discord_voice_options("{\"operation\":\"leave\",\"intent\":\"x\"}") and 0) equals "valid"):
        return 38
    display "PASS: voice tool rejects unsafe arguments and unauthorised/unconfigured joins, queues a source-bound intent once, reports status, hides other guilds, cancels queued leave and refuses edited source replay."
    return 0
