import "../../app/discord/voice_recording_delivery"
import "../../app/discord/voice_recording_terminal_worker"
import "../../app/discord/worker_store"
import "../../app/discord/gateway_journal"
import "../fixtures/tool_call_fixture"

define recording_authority_submit with journal as Int and database as Int and identity as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Authorised voice test\"}"))
    set inbox to concat("message:create:" and identity)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals inbox):
        return 2
    set submitted to discord_agent_submit(journal and database and inbox and "900" and ["200"] and ["500"])
    if not (archive_list_text(submitted and 0) equals "accepted"):
        display archive_list_text(submitted and 0)
        return 3
    return 0

define recording_authority_generate with database as Int and run as Str and request as Str and operation as Str returning Int:
    set listener to local_socket_listen(0)
    set arguments to concat("{\"operation\":" and concat(provider_quote(operation) and ",\"intent\":\"voice-intent\"}"))
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"voice-call\",\"function\":{\"name\":\"discord_voice\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and run and request and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    return generated + served

define recording_authority_check with journal as Int and database as Int and expected as Str returning Int:
    set result to discord_voice_recording_guard(journal and database and "recording" and "900" and ["200"] and ["500"] and "/absent-fixture-stop")
    if not (archive_list_text(result and 0) equals expected):
        display concat("Expected " and concat(expected and concat("; got " and archive_list_text(result and 0))))
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else web_cancel_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set admin to discord_agent_principal(database and "500" and ["500"])
    set journal to discord_store_open(get_argument(2) and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0 or else discord_voice_recording_schema(journal) is not equal to 0:
        return 3
    if recording_authority_submit(journal and database and "100") is not equal to 0 or else recording_authority_generate(database and "discord-message:100" and "join-request" and "join") is not equal to 0:
        return 4
    set requested to discord_voice_intent_request(journal and "voice-intent" and "200" and "600" and "500" and "discord-message:100" and "voice-call" and ep_sha256("fixture-access"))
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET state='sent' WHERE identity='voice-intent';")
    # Model the completed join before admitting the later recording request.
    set changed to sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='discord-message:100'; UPDATE echo_tool_calls SET state='observed' WHERE run='discord-message:100';")
    set changed to sql_execute(journal and "UPDATE discord_agent_jobs SET state='enqueued' WHERE inbox='message:create:100';")
    if recording_authority_submit(journal and database and "101") is not equal to 0 or else recording_authority_generate(database and "discord-message:101" and "record-request" and "record") is not equal to 0:
        return 5
    set request to history_collect_one(archive_prepare(database and "SELECT request_event FROM echo_tool_calls WHERE run='discord-message:101' AND call_id='voice-call';"))
    if not (discord_voice_recording_request(journal and "recording" and "voice-intent" and "500" and "300" and archive_list_text(request and 1)) equals "pending-notice"):
        return 6
    if recording_authority_check(journal and database and "recording-native-current") is not equal to 0:
        return 7
    if discord_gateway_schema(journal) is not equal to 0:
        return 30
    set bound to discord_gateway_bind(journal and "generation" and "session")
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    if discord_gateway_voice_schema(journal) is not equal to 0 or else discord_voice_recording_offer_schema(journal) is not equal to 0:
        return 40
    set baseline to "{\"id\":\"200\",\"voice_states\":[{\"user_id\":\"900\",\"channel_id\":\"600\",\"session_id\":\"bot-session\"},{\"user_id\":\"500\",\"channel_id\":\"600\",\"session_id\":\"human-session\"}]}"
    set recorded to discord_gateway_voice_record(journal and "session" and 1 and "GUILD_CREATE" and baseline)
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET generation='generation',gateway_session='session' WHERE identity='voice-intent';")
    set fixture to ep_dlopen(get_argument(3))
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set outcome to discord_voice_recording_deliver(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "recording" and "" and "900" and ["200"] and ["500"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "active"):
        return 41
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-idle"):
        return 42
    if get_argument(5) equals "interrupted":
        set stopped to discord_voice_recording_recover(journal and "voice-intent")
    else:
        set stopped to discord_voice_recording_stop(journal and "recording")
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["201"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-scope-denied") or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 0:
        display outcome
        return 43
    if get_argument(5) equals "missing":
        set failure_mode to 14
        repeat while failure_mode <= 15:
            set changed to sql_execute(journal and "UPDATE discord_voice_recording_terminal_delivery SET next_ms=0;")
            set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and failure_mode and str_to_ptr(get_argument(2)))
            set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
            set state to history_collect_one(archive_prepare(journal and "SELECT confirmed FROM discord_voice_recording_terminal_delivery;"))
            if not (outcome equals "http-404" or else outcome equals "http-403") or else not (archive_list_text(state and 1) equals "0"):
                display outcome
                return 51
            set failure_mode to failure_mode + 1
        set changed to sql_execute(journal and "UPDATE discord_voice_recording_terminal_delivery SET next_ms=0;")
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 13 and str_to_ptr(get_argument(2)))
        set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
        set state to history_collect_one(archive_prepare(journal and "SELECT confirmed,receipt FROM discord_voice_recording_terminal_delivery;"))
        if not (outcome equals "recording-terminal-missing") or else not (archive_list_text(state and 1) equals "1") or else string_length(archive_list_text(state and 2)) < 80 or else ep_dlcall0(ep_dlsym(fixture and "fixture_recording_patches")) is not equal to 0 or else ep_dlcall0(ep_dlsym(fixture and "fixture_recording_posts")) is not equal to 1:
            display outcome
            return 52
        set closed to sql_close(journal)
        set journal to discord_store_open(get_argument(2) and "900")
        set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
        set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
        if not (outcome equals "recording-terminal-idle") or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 0:
            return 53
        display "PASS: terminal cleanup persists an exact Unknown Message receipt, sends no edit or replacement post, and stays idle after reopening; missing-access 404 and 403 remain unconfirmed."
        return 0
    set changed to sql_execute(journal and "UPDATE discord_voice_recording_terminal_delivery SET next_ms=0;")
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 4 and str_to_ptr(get_argument(2)))
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-message-changed") or else ep_dlcall0(ep_dlsym(fixture and "fixture_recording_patches")) is not equal to 0:
        display outcome
        return 44
    set changed to sql_execute(journal and "UPDATE discord_voice_recording_terminal_delivery SET next_ms=0;")
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 11 and str_to_ptr(get_argument(2)))
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-unconfirmed") or else ep_dlcall0(ep_dlsym(fixture and "fixture_recording_patches")) is not equal to 1:
        display outcome
        return 45
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-idle") or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 0:
        return 46
    # Simulate the persisted retry deadline passing after a worker restart.
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(2) and "900")
    set changed to sql_execute(journal and "UPDATE discord_voice_recording_terminal_delivery SET next_ms=0;")
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-confirmed") or else ep_dlcall0(ep_dlsym(fixture and "fixture_recording_patches")) is not equal to 1 or else ep_dlcall0(ep_dlsym(fixture and "fixture_recording_posts")) is not equal to 1:
        display outcome
        return 47
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set outcome to discord_voice_recording_terminal_tick(get_argument(3) and "fixture-token-no-network-123456" and journal and "900" and ["200"] and get_argument(4) and "/absent-fixture-stop")
    if not (outcome equals "recording-terminal-idle") or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 0:
        return 48
    set config to create_list()
    set added to append_list(config and get_argument(3))
    set added to append_list(config and "fixture-token-no-network-123456")
    set added to append_list(config and get_argument(2))
    set added to append_list(config and "900")
    set guilds to ["200"]
    set added to append_list(config and guilds)
    set added to append_list(config and get_argument(4))
    set added to append_list(config and "/absent-fixture-stop")
    set stop to channel
    set completed to channel
    send 1 to stop
    spawn discord_voice_recording_terminal_worker(config and stop and completed)
    set waits to create_list()
    set added to append_list(waits and completed)
    if select(waits and 5000) < 0:
        return 49
    set status to receive from completed
    if status is not equal to 0:
        return 50
    display "PASS: terminal notice cleanup is scoped, preserves changed messages, persists retry deadlines, reconciles a lost PATCH response after restart without a second edit or post, then stays idle and joins its worker."
    return 0
