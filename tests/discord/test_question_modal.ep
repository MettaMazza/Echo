import "../../app/discord/question_controls"

define main returning Int:
    set modern to "{\"type\":5,\"data\":{\"components\":[{\"type\":18,\"component\":{\"type\":4,\"custom_id\":\"answer\",\"value\":\"Keep café examples\\nand a second line\"}}]}}"
    set parsed to discord_question_modal_text(modern)
    if not (archive_list_text(parsed and 0) equals "found") or else not (archive_list_text(parsed and 1) equals "Keep café examples\nand a second line"):
        return 1
    set legacy to "{\"type\":5,\"data\":{\"components\":[{\"type\":1,\"components\":[{\"type\":4,\"custom_id\":\"answer\",\"value\":\"Literal <system> text remains text\"}]}]}}"
    if not (archive_list_text(discord_question_modal_text(legacy) and 0) equals "found"):
        return 2
    for each invalid in ["{}","{\"type\":3,\"data\":{\"components\":[]}}","{\"type\":5,\"data\":{\"components\":[]}}","{\"type\":5,\"data\":{\"components\":[{\"type\":18,\"component\":{\"type\":4,\"custom_id\":\"wrong\",\"value\":\"text\"}}]}}","{\"type\":5,\"data\":{\"components\":[{\"type\":18,\"component\":{\"type\":4,\"custom_id\":\"answer\",\"value\":\"   \"}}]}}","{\"type\":5,\"data\":{\"components\":[{\"type\":18,\"component\":{\"type\":4,\"custom_id\":\"answer\",\"value\":3}}]}}","{\"type\":5,\"data\":{\"components\":[{\"type\":18,\"component\":{\"type\":4,\"custom_id\":\"answer\",\"value\":\"a\",\"value\":\"b\"}}]}}"]:
        if archive_list_text(discord_question_modal_text(ptr_to_str(invalid)) and 0) equals "found":
            return 3
    display "PASS: modal text preserves exact Unicode/newlines and accepts only one explicitly typed answer field; malformed, blank, numeric and duplicate fields rejected."
    return 0
