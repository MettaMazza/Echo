import "../../app/discord/typing"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_worker_schema(journal) is not equal to 0 or else discord_typing_schema(journal) is not equal to 0:
        return 2
    # Minimal run table isolates scheduling from model/network execution.
    if sql_execute(journal and "CREATE TABLE echo_runs(run TEXT PRIMARY KEY,session TEXT,objective_event TEXT,state TEXT,last_event TEXT); INSERT INTO echo_runs VALUES('discord-message:100','s','e','generating','e');") is not equal to 0:
        return 3
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"channel_id\":\"301\"}")
    set claimed to discord_worker_claim(journal)
    # Missing private output directory makes network impossible but records an attempt.
    set tick to discord_typing_tick("" and "" and journal and journal and "/nonexistent-echo-typing-test")
    set tick to discord_typing_tick("" and "" and journal and journal and "/nonexistent-echo-typing-test")
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_typing_events;"))
    if not (archive_list_text(count and 1) equals "1"):
        return 4
    set changed to sql_execute(journal and "UPDATE discord_typing_clock SET next_ms=0; UPDATE echo_runs SET state='tools';")
    set tick to discord_typing_tick("" and "" and journal and journal and "/nonexistent-echo-typing-test")
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_typing_events;"))
    if not (archive_list_text(count and 1) equals "2"):
        return 5
    set states to create_list()
    set added to append_list(states and "waiting")
    set added to append_list(states and "completed")
    set added to append_list(states and "cancelled")
    set added to append_list(states and "failed")
    for each state_ptr in states:
        set state to ptr_to_str(state_ptr)
        set values to create_list()
        set added to append_list(values and state)
        set changed to archive_finish(checkpoint_prepare(journal and "UPDATE echo_runs SET state=?;" and values) and 101)
        set changed to sql_execute(journal and "UPDATE discord_typing_clock SET next_ms=0;")
        set tick to discord_typing_tick("" and "" and journal and journal and "/nonexistent-echo-typing-test")
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_typing_events;"))
    if not (archive_list_text(count and 1) equals "2") or else discord_typing_active("ready") is not equal to 1:
        return 6
    set recorded to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and "{\"channel_id\":\"301\",\"author\":{\"id\":\"502\"}}")
    set changed to sql_execute(journal and "INSERT INTO discord_agent_jobs VALUES('message:create:101','claimed','fixture',9999999999999,0); INSERT INTO echo_runs VALUES('discord-message:101','s','e','generating','e'); UPDATE discord_typing_clock SET next_ms=0;")
    if not (discord_typing_due(journal and journal and ep_time_now_ms()) equals "301"):
        return 7
    display "PASS: native typing cadence, tool refresh, waiting/complete/cancel/failure suppression; no network"
    return 0
