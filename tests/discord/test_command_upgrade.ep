import "../../app/discord/command_upgrade"

define main returning Int:
    set body to "{\"id\":\"100\",\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"group\",\"type\":1,\"version\":\"101\"}"
    if discord_command_upgrade_scope(body and "900" and "200" and "group" and "100" and "101") is not equal to 1:
        return 1
    if discord_command_upgrade_scope(body and "901" and "200" and "group" and "100" and "101") is not equal to 0 or else discord_command_upgrade_scope(body and "900" and "201" and "group" and "100" and "101") is not equal to 0 or else discord_command_upgrade_scope(body and "900" and "200" and "new" and "100" and "101") is not equal to 0:
        return 2
    if discord_command_upgrade_scope(body and "900" and "200" and "group" and "102" and "101") is not equal to 0 or else discord_command_upgrade_scope(body and "900" and "200" and "group" and "100" and "102") is not equal to 0:
        return 3
    if discord_command_upgrade_scope(string_replace(body and "\"type\":1" and "\"type\":2") and "900" and "200" and "group" and "100" and "101") is not equal to 0 or else discord_command_upgrade_scope(string_replace(body and "\"id\":\"100\"" and "\"id\":\"100\",\"id\":\"100\"") and "900" and "200" and "group" and "100" and "101") is not equal to 0:
        return 4
    display "PASS: command upgrade requires exact application, guild, command, type and inspected version; duplicate fields denied."
    return 0
