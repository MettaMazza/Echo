import "../../app/discord/voice_socket"

define main returning Int:
    if not (discord_voice_endpoint("us-west123.discord.media:443") equals "wss://us-west123.discord.media/?v=8") or else not (discord_voice_endpoint("wss://voice.discord.gg") equals "wss://voice.discord.gg/?v=8"):
        return 1
    if not (discord_voice_endpoint("sweetwater-12345.discord.media:2048") equals "wss://sweetwater-12345.discord.media:2048/?v=8") or else not (discord_voice_endpoint("voice.discord.media:80") equals "wss://voice.discord.media:80/?v=8") or else not (discord_voice_endpoint("voice.discord.media:65535") equals "wss://voice.discord.media:65535/?v=8"):
        return 7
    set invalid to create_list()
    set invalid to ["", "localhost", "127.0.0.1", "discord.media", "evil.discord.media.attacker.test", "evil@voice.discord.media", "voice.discord.media/path", "voice.discord.media?token=x", "voice.discord.media#x", "voice.discord.media:0", "voice.discord.media:65536", "voice.discord.media:-1", "voice.discord.media:+443", "voice.discord.media:", "voice.discord.media:0443", "voice.discord.media:443/path", "voice.discord.media:443:443", "https://voice.discord.media", "ws://voice.discord.media", "-voice.discord.media", "voice-.discord.media", "voice..discord.media", ".voice.discord.media", "voice.discord.media."]
    for each endpoint in invalid:
        if string_length(discord_voice_endpoint(ptr_to_str(endpoint))) is not equal to 0:
            display ptr_to_str(endpoint)
            return 2
    set rejected to discord_voice_socket_open("/missing/library" and "attacker.invalid")
    if not (archive_list_text(rejected and 0) equals "invalid-voice-origin"):
        return 3
    set socket to create_list()
    set added to append_list(socket and "not-connected")
    if discord_voice_socket_send(socket and 1 and 1 and 1) is not equal to 0:
        return 4
    set row to discord_voice_socket_read(socket)
    if not (archive_list_text(row and 0) equals "not-connected"):
        return 5
    if not (discord_gateway_endpoint("wss://gateway.discord.gg") equals "wss://gateway.discord.gg/?v=10&encoding=json"):
        return 6
    display "PASS: voice v8 endpoint construction, explicit TLS Discord origin validation, valid TLS ports and malformed/credential/port/path rejection and disconnected I/O guards; Gateway v10 URL unchanged."
    return 0
