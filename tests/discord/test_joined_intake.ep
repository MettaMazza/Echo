import "../../app/discord/agent_output"

define joined_intake_body with message as Str and user as Str and text as Str returning Str:
    set output to concat("{\"id\":" and provider_quote(message))
    set output to concat(output and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":")
    set output to concat(output and provider_quote(user))
    set output to concat(output and "},\"mentions\":[{\"id\":\"900\"}],\"content\":")
    set output to concat(output and provider_quote(text))
    return concat(output and "}")

define joined_intake_submit with journal as Int and database as Int and message as Str and user as Str returning List:
    set body to joined_intake_body(message and user and concat("Public group fixture " and message))
    set identity to concat("message:create:" and message)
    if not (discord_inbox_record(journal and identity and "MESSAGE_CREATE" and body) equals "recorded"):
        return history_status("fixture-intake-failed")
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    return discord_agent_submit(journal and database and identity and "900" and guilds and admins)

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0:
        return 2
    set admins to create_list()
    set a to discord_agent_principal(database and "400" and admins)
    set b to discord_agent_principal(database and "500" and admins)
    set personal to joined_intake_submit(journal and database and "100" and "400")
    if not (archive_list_text(personal and 0) equals "accepted") or else agent_cancel_run(database and "discord-message:100") is not equal to 0:
        return 3
    set created to discord_joined_create(database and a and "200" and "300" and "joined-test")
    set group_id to archive_list_text(created and 1)
    if not (archive_list_text(created and 0) equals "created") or else not (discord_joined_change(database and a and "200" and "300" and "invite" and group_id and principal_for_device(database and b) and "invited" and 1) equals "recorded") or else not (discord_joined_change(database and b and "200" and "300" and "join" and group_id and principal_for_device(database and b) and "joined" and 2) equals "recorded"):
        return 4
    if not (discord_joined_select(database and a and "200" and "300" and "select-a" and group_id) equals "selected") or else not (discord_joined_select(database and b and "200" and "300" and "select-b" and group_id) equals "selected"):
        return 5
    set first to joined_intake_submit(journal and database and "101" and "400")
    if not (archive_list_text(first and 0) equals "accepted") or else archive_list_text(first and 1) equals archive_list_text(personal and 1):
        return 6
    # Synthetic final explicitly tests transport binding, not model quality.
    set session to archive_list_text(first and 1)
    set request to "{\"run_id\":\"discord-message:101\",\"parent_event\":\"discord-message:101:user\",\"fixture\":true}"
    if archive_append(database and session and "joined-request" and "model_request" and request and "fixture") is not equal to 0 or else agent_run_transition(database and "discord-message:101" and "ready" and "discord-message:101:user" and "generating" and "joined-request") is not equal to 0:
        return 15
    set response to "{\"run_id\":\"discord-message:101\",\"parent_event\":\"joined-request\",\"content\":\"Shared group reply.\",\"fixture\":true}"
    if archive_append(database and session and "joined-final" and "assistant_final" and response and "fixture") is not equal to 0 or else agent_run_transition(database and "discord-message:101" and "generating" and "joined-request" and "completed" and "joined-final") is not equal to 0:
        return 16
    set second to joined_intake_submit(journal and database and "102" and "500")
    if not (archive_list_text(second and 0) equals "accepted") or else not (archive_list_text(second and 1) equals archive_list_text(first and 1)) or else agent_cancel_run(database and "discord-message:102") is not equal to 0:
        return 7
    if group_session_allows(database and b and archive_list_text(personal and 1) and "discord" and "200" and "300" and 0) is not equal to 0:
        return 8
    if not (discord_joined_select(database and a and "200" and "300" and "back-personal" and "") equals "selected"):
        return 9
    set pinned to discord_joined_target(database and a and "200" and "300" and "discord-message:101")
    if not (archive_list_text(pinned and 1) equals group_id) or else not (archive_list_text(discord_joined_target(database and b and "200" and "300" and "discord-message:101") and 0) equals "run-audience-conflict"):
        return 10
    if not (discord_job_source(journal and database and "discord-message:101") equals "message:create:101") or else not (discord_agent_output(journal and database and "message:create:101") equals "enqueued"):
        return 17
    set output to history_collect_one(archive_prepare(journal and "SELECT channel,json_extract(body,'$.message_reference.message_id'),json_extract(body,'$.content') FROM discord_outbox WHERE identity='discord-message:101:final:0';"))
    if not (archive_list_text(output and 1) equals "300") or else not (archive_list_text(output and 2) equals "101") or else not (archive_list_text(output and 3) equals "Shared group reply."):
        return 18
    set absent to discord_joined_bound(database and a and "200" and "300" and "unadmitted-run")
    if not (archive_list_text(absent and 0) equals "end"):
        return 19
    set next to joined_intake_submit(journal and database and "103" and "400")
    if not (archive_list_text(next and 0) equals "accepted") or else not (archive_list_text(next and 1) equals archive_list_text(personal and 1)) or else agent_cancel_run(database and "discord-message:103") is not equal to 0:
        return 11
    if not (discord_joined_change(database and a and "200" and "300" and "remove" and group_id and principal_for_device(database and b) and "removed" and 3) equals "recorded"):
        return 12
    set refused to joined_intake_submit(journal and database and "104" and "500")
    if not (archive_list_text(refused and 0) equals "audience-not-authorized") or else agent_run_read(database and "discord-message:104") is not equal to 0:
        return 13
    if archive_verify(database and archive_list_text(first and 1)) is not equal to 0 or else archive_verify(database and archive_list_text(personal and 1)) is not equal to 0:
        return 14
    display "PASS: authenticated Discord messages use the selected shared group; personal history stays separate; old run remains pinned across selection; foreign replay and removed membership denied."
    return 0
