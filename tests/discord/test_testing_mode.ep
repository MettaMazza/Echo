import "../../app/discord/command_registration"

define testing_message with sequence as Int and identity as Str and actor as Str returning Str:
    return concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":\"MESSAGE_CREATE\",\"d\":{\"type\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"channel_id\":\"300\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}],\"content\":\"fixture\",\"author\":{\"id\":" and concat(provider_quote(actor) and "}}}"))))))

define testing_command with actor as Str returning Str:
    return concat("{\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"data\":{\"type\":1,\"id\":\"800\",\"name\":\"testing\",\"options\":[]}}"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_gateway_runtime_schema(journal) is not equal to 0 or else discord_command_schema(journal) is not equal to 0:
        return 2
    set admins to ["400"]
    set guilds to ["200"]
    if discord_testing_allows(journal and "500") is not equal to 1:
        return 3
    set registration to "{\"type\":1,\"id\":\"800\",\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"testing\"}"
    if not (discord_command_observe(journal and registration and "900" and "200") equals "registered") or else discord_control_command_matches(discord_control_command_definition("testing") and "testing") is not equal to 1:
        return 4
    set body to testing_command("400")
    if not (archive_list_text(discord_command_resolve(journal and body and "900" and guilds and admins) and 0) equals "command-bound-needs-live-access"):
        return 5
    if not (archive_list_text(discord_command_resolve(journal and testing_command("500") and "900" and guilds and admins) and 0) equals "admin-required"):
        return 6
    if not (discord_testing_toggle(journal and "interaction:1" and body and "400" and admins) equals "command-not-acknowledged"):
        return 7
    for each identity in ["interaction:1","interaction:2"]:
        set recorded to discord_inbox_record(journal and ptr_to_str(identity) and "INTERACTION_CREATE" and body)
        if discord_interaction_queue(journal and ptr_to_str(identity)) is not equal to 0:
            return 8
    if sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledged';") is not equal to 0:
        return 9
    if not (discord_testing_toggle(journal and "interaction:1" and body and "500" and admins) equals "admin-required") or else not (discord_testing_toggle(journal and "interaction:1" and body and "400" and admins) equals "testing-enabled"):
        return 10
    if discord_testing_allows(journal and "500") is not equal to 0 or else discord_testing_allows(journal and "400") is not equal to 1:
        return 11
    if not (discord_testing_toggle(journal and "interaction:1" and body and "400" and admins) equals "testing-enabled") or else discord_testing_allows(journal and "500") is not equal to 0:
        return 12
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"testing-session\",\"resume_gateway_url\":\"wss://gateway.discord.gg\"}}"
    if not (discord_gateway_ready_record(journal and "socket" and "900" and ready) equals "recorded"):
        return 13
    if not (discord_gateway_intake(journal and "socket" and "900" and guilds and admins and testing_message(2 and "100" and "500")) equals "recorded") or else not (discord_gateway_intake(journal and "socket" and "900" and guilds and admins and testing_message(3 and "101" and "400")) equals "recorded"):
        return 14
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_inbox WHERE identity='message:create:100';"))
    if not (archive_list_text(row and 1) equals "0"):
        return 15
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_inbox WHERE identity='message:create:101';"))
    if not (archive_list_text(row and 1) equals "1"):
        return 16
    set held to int_to_string(ep_time_now_ms())
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_testing_allows(journal and "500") is not equal to 0:
        return 17
    # Ensure distinct timestamps for the historical admission check.
    set pause to channel
    set waited to select([pause] and 10)
    if not (discord_testing_toggle(journal and "interaction:2" and body and "400" and admins) equals "testing-disabled") or else discord_testing_allows(journal and "500") is not equal to 1:
        return 18
    if discord_testing_received_allows(journal and "500" and held) is not equal to 0:
        return 19
    if not (discord_testing_toggle(journal and "interaction:1" and body and "400" and admins) equals "testing-disabled") or else discord_testing_allows(journal and "500") is not equal to 1:
        return 20
    if not (discord_gateway_intake(journal and "socket" and "900" and guilds and admins and testing_message(4 and "102" and "500")) equals "recorded"):
        return 21
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_inbox WHERE identity='message:create:102';"))
    if not (archive_list_text(row and 1) equals "1"):
        return 22
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM sqlite_master WHERE name='echo_events';"))
    if not (archive_list_text(row and 1) equals "0"):
        return 23
    display "PASS: admin-only registered toggle; acknowledgement and retry binding; persistence; guest text excluded; admin intake allowed; historical guest admission denied; normal intake restored; no model archive."
    return 0
