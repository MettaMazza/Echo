import "../../app/discord/worker_delivery"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_worker_schema(journal) is not equal to 0:
        return 2
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\"}") equals "recorded"):
        return 3
    if not (discord_outbox_enqueue(journal and "activity-page:old:0" and "message:create:100" and "100" and "{\"content\":\"Activity\"}") equals "enqueued"):
        return 4
    if not (discord_outbox_enqueue(journal and "reply:first" and "message:create:100" and "300" and "{\"content\":\"First reply\"}") equals "enqueued") or else not (discord_outbox_enqueue(journal and "reply:second" and "message:create:100" and "300" and "{\"content\":\"Second reply\"}") equals "enqueued"):
        return 5
    set due to discord_reply_due(journal and 1000)
    if not (archive_list_text(due and 1) equals "reply:first"):
        return 6
    if sql_execute(journal and "INSERT INTO discord_delivery_retry_clock VALUES('reply:first',2000);") is not equal to 0:
        return 7
    set due to discord_reply_due(journal and 1000)
    if not (archive_list_text(due and 1) equals "reply:second"):
        return 8
    set due to discord_reply_due(journal and 2000)
    if not (archive_list_text(due and 1) equals "reply:first"):
        return 9
    set admins to create_list()
    if not (discord_worker_deliver("" and "" and 0 and "activity-page:old:0" and "900" and admins and "" and "") equals "separate-activity-worker"):
        return 10
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity LIKE 'reply:%';") is not equal to 0:
        return 11
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set due to discord_reply_due(journal and 3000)
    if not (archive_list_text(due and 0) equals "end"):
        return 12
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_outbox WHERE identity='activity-page:old:0';"))
    if not (archive_list_text(row and 1) equals "pending"):
        return 13
    display "PASS: activity cannot occupy reply queue, reply retry clocks respected, namespace guard before DB/network, restart retains independent pending activity"
    return 0
