import "../../app/discord/gateway_journal"
import "../../app/discord/voice_intents"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_schema(database) is not equal to 0 or else discord_voice_intent_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set recorded to discord_gateway_dispatch(database and "generation" and "session" and 10 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set evidence to ep_sha256("fresh permission snapshots")
    if not (discord_voice_intent_request(database and "intent-a" and "100" and "200" and "400" and "run" and "call" and evidence) equals "queued"):
        return 2
    if not (discord_voice_intent_request(database and "intent-a" and "100" and "201" and "400" and "run" and "call" and evidence) equals "voice-intent-identity-conflict") or else not (discord_voice_intent_request(database and "intent-b" and "100" and "201" and "400" and "run" and "call-b" and evidence) equals "voice-guild-busy"):
        return 3
    set stale to discord_voice_intent_claim(database and "intent-a" and "generation" and 9 and evidence)
    if not (archive_list_text(stale and 0) equals "stale-voice-claim"):
        return 4
    set claimed to discord_voice_intent_claim(database and "intent-a" and "generation" and 10 and evidence)
    if not (archive_list_text(claimed and 0) equals "claimed"):
        return 5
    set claim to archive_list_text(claimed and 1)
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "300")
    set duplicate to discord_voice_intent_claim(database and "intent-a" and "generation" and 10 and evidence)
    if not (archive_list_text(duplicate and 0) equals "voice-intent-not-queued"):
        return 6
    if not (discord_voice_intent_written(database and "intent-a" and "wrong" and 1) equals "voice-write-result-not-applied") or else not (discord_voice_intent_written(database and "intent-a" and claim and 0) equals "uncertain"):
        return 7
    if not (discord_voice_intent_request(database and "intent-b" and "100" and "201" and "400" and "run" and "call-b" and evidence) equals "voice-guild-busy") or else not (discord_voice_intent_cancel(database and "intent-a") equals "leave-required"):
        return 8
    if not (discord_voice_intent_written(database and "intent-a" and claim and 1) equals "voice-write-result-not-applied"):
        return 9
    if not (discord_voice_intent_request(database and "intent-c" and "101" and "202" and "400" and "run" and "call-c" and evidence) equals "queued") or else not (discord_voice_intent_cancel(database and "intent-c") equals "cancelled"):
        return 10
    if not (discord_voice_intent_request(database and "intent-d" and "101" and "202" and "400" and "run" and "call-d" and evidence) equals "queued"):
        return 11
    set closed to sql_close(database)
    display "PASS: durable voice intent reserves each guild, fences claims by Gateway cursor, survives restart without resend and preserves uncertain/cancelled-write reconciliation."
    return 0
