import "test_audit_privacy"
import "test_audit_role_combinations"
import "test_audit_view"

define main returning Int:
    set result to audit_privacy_test()
    if result is not equal to 0:
        display concat("privacy failure: " and int_to_string(result))
        return 1
    set result to audit_view_test()
    if result is not equal to 0:
        display concat("view failure: " and int_to_string(result))
        return 2
    set result to audit_role_combinations_test()
    if result is not equal to 0:
        display concat("role-combination failure: " and int_to_string(result))
        return 3
    return 0
