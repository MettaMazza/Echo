import "../../app/discord/gateway_intake"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "300")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 2
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"300\"},\"session_id\":\"old-session\",\"resume_gateway_url\":\"wss://gateway.discord.gg\"}}"
    if not (discord_gateway_ready_record(database and "old-generation" and "300" and ready) equals "recorded"):
        return 3
    set evidence to ep_sha256("fixture-authority")
    set requested to discord_voice_intent_request(database and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set joined to discord_voice_intent_claim(database and "join" and "old-generation" and 1 and evidence)
    set cancelled to discord_voice_intent_cancel(database and "join")
    set leave_claim to discord_voice_leave_claim(database and "join" and "old-generation")
    if not (discord_voice_leave_written(database and "join" and archive_list_text(leave_claim and 1) and 1) equals "sent"):
        return 4
    set ready to string_replace(ready and "old-session" and "new-session")
    if not (discord_gateway_ready_record(database and "new-generation" and "300" and ready) equals "recorded"):
        return 5
    set present to "{\"op\":0,\"s\":2,\"t\":\"GUILD_CREATE\",\"d\":{\"id\":\"100\",\"voice_states\":[{\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"voice-session\"}],\"roles\":[]}}"
    if not (discord_gateway_intake(database and "new-generation" and "300" and ["100"] and [] and present) equals "recorded"):
        return 6
    if not (discord_voice_leave_reconcile(database and "join" and "new-generation" and "300") equals "await-voice-leave-confirmation"):
        return 7
    set absent to "{\"op\":0,\"s\":3,\"t\":\"GUILD_CREATE\",\"d\":{\"id\":\"100\",\"voice_states\":[],\"roles\":[]}}"
    if not (discord_gateway_intake(database and "new-generation" and "300" and ["100"] and [] and absent) equals "recorded"):
        return 8
    if not (discord_voice_leave_reconcile(database and "join" and "new-generation" and "300") equals "voice-left-confirmed"):
        return 9
    set row to history_collect_one(archive_prepare(database and "SELECT state FROM discord_voice_intents WHERE identity='join';"))
    if not (archive_list_text(row and 1) equals "closed"):
        return 10
    set closed to sql_close(database)
    display "PASS: fresh-session authenticated baseline retains reservation while bot is present and closes old sent leave only when bot is absent."
    return 0
