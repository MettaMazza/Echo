import "../../app/discord/activity_transport"

# Explicit live qualification: creates only the source-attached empty activity
# thread, never exports a conversation or model trace. Retained source is a
# labelled test message fetched from the authenticated Gateway journal.
define main returning Int:
    if get_argument_count() is not equal to 10:
        return 1
    set library to get_argument(1)
    set held_library to ep_dlopen(library)
    if held_library equals 0:
        return 2
    set secret to read_file(get_argument(2))
    set source_file to read_file(get_argument(4))
    if secret equals 0 or else source_file equals 0:
        return 3
    set token to string_trim(ptr_to_str(secret))
    set source to ptr_to_str(source_file)
    set journal to discord_store_open(get_argument(3) and get_argument(8))
    if journal equals 0:
        return 4
    set recorded to discord_inbox_record(journal and get_argument(9) and "MESSAGE_CREATE" and source)
    if not (recorded equals "recorded" or else recorded equals "already-recorded"):
        return 5
    set admins to string_split(get_argument(5) and ",")
    set result to discord_activity_ensure(library and token and journal and get_argument(9) and get_argument(8) and admins and get_argument(6) and get_argument(7))
    display result
    set closed to sql_close(journal)
    set closed to ep_dlclose(held_library)
    if not (result equals "ready"):
        return 6
    display "PASS: exact original-message activity thread confirmed; no trace content exported"
    return 0
