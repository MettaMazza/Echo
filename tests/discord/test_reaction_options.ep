import "../../app/discord/reaction_options"

define main returning Int:
    set options to discord_reaction_options("{\"operation\": \"add\", \"emoji\": \"❤️\"}")
    if not (archive_list_text(options and 0) equals "valid") or else not (archive_list_text(options and 3) equals "%E2%9D%A4%EF%B8%8F"):
        return 1
    if archive_list_text(discord_reaction_options("{}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_reaction_options("{\"operation\":\"add\"}") and 0) equals "valid":
        return 3
    if archive_list_text(discord_reaction_options("{\"operation\":\"discover\",\"emoji\":\"x\"}") and 0) equals "valid":
        return 4
    if archive_list_text(discord_reaction_options("{\"operation\":\"remove\",\"emoji\":\"\"}") and 0) equals "valid":
        return 5
    if archive_list_text(discord_reaction_options("{\"operation\":\"inspect\",\"channel\":\"999\"}") and 0) equals "valid":
        return 6
    if archive_list_text(discord_reaction_options("{\"operation\":\"add\",\"operation\":\"remove\",\"emoji\":\"x\"}") and 0) equals "valid":
        return 7
    if archive_list_text(discord_reaction_options("{\"operation\":\"add\",\"emoji\":5}") and 0) equals "valid":
        return 8
    if archive_list_text(discord_reaction_options("{\"operation\":\"add\",\"emoji\":\"a b\"}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_reaction_options("{\"operation\":\"ban\"}") and 0) equals "valid":
        return 10
    set encoded to discord_reaction_options("{\"operation\":\"add\",\"emoji\":\"x/../@everyone?\"}")
    if not (archive_list_text(encoded and 3) equals "x%2F..%2F%40everyone%3F"):
        return 12
    set body to "[{\"id\": \"100\", \"name\": \"open\", \"roles\": [], \"user\": {\"secret\": \"not-for-output\"}}, {\"id\": \"101\", \"name\": \"allowed\", \"roles\": [\"400\"]}, {\"id\": \"102\", \"name\": \"forbidden\", \"roles\": [\"500\"]}, {\"id\": \"103\", \"name\": \"unavailable\", \"roles\": [\"400\"], \"available\": false}]"
    set member to "{\"user\":{\"id\":\"900\"},\"roles\":[\"400\"]}"
    set catalog to discord_reaction_catalog(body and member and 0)
    if discord_reaction_catalog_has(catalog and "open:100") is not equal to 1 or else discord_reaction_catalog_has(catalog and "allowed:101") is not equal to 1 or else discord_reaction_catalog_has(catalog and "forbidden:102") is not equal to 0 or else discord_reaction_catalog_has(catalog and "unavailable:103") is not equal to 0 or else string_contains(catalog and "not-for-output") is not equal to 0:
        return 13
    if string_length(discord_reaction_catalog(body and "{}" and 0)) is not equal to 0:
        return 14
    set application_catalog to discord_reaction_catalog("{\"items\": [{\"id\": \"104\", \"name\": \"app\", \"animated\": true}]}" and "{}" and 1)
    if discord_reaction_catalog_has(application_catalog and "app:104") is not equal to 1:
        return 15
    if string_length(discord_reaction_catalog("[{\"id\":\"100\",\"name\":\"x\",\"roles\":[]},{\"id\":\"100\",\"name\":\"y\",\"roles\":[]}]" and member and 0)) is not equal to 0:
        return 16
    display "PASS: reaction arguments, encoded routes, role-limited catalogs, missing/duplicate fields and stripped account metadata"
    return 0
