import "../../app/discord/invite_tool"

define main returning Int:
    set cases to create_list()
    set added to append_list(cases and "{\"operation\":\"inspect\",\"code\":\"../users/@me\"}")
    set added to append_list(cases and "{\"operation\":\"inspect\",\"code\":\"a\",\"reason\":\"unused\"}")
    set added to append_list(cases and "{\"operation\":\"list\",\"code\":\"a\"}")
    set added to append_list(cases and "{\"operation\":\"delete\",\"code\":\"a\",\"reason\":\"fixture\"}")
    set added to append_list(cases and "{\"operation\":\"create\",\"reason\":\"fixture\",\"max_age\":604801}")
    set added to append_list(cases and "{\"operation\":\"create\",\"reason\":\"fixture\",\"max_uses\":101}")
    set added to append_list(cases and "{\"operation\":\"create\",\"reason\":\"fixture\",\"temporary\":\"true\"}")
    set added to append_list(cases and "{\"operation\":\"create\",\"reason\":\"fixture\",\"route\":\"/users/@me\"}")
    set added to append_list(cases and "{\"operation\":\"create\",\"reason\":\"fixture\",\"target_user_id\":\"123\"}")
    set added to append_list(cases and "{\"operation\":\"create\",\"reason\":\"fixture\",\"max_age\":-1}")
    for each item in cases:
        if archive_list_text(discord_invite_options(ptr_to_str(item)) and 0) equals "valid":
            return 1
    set options to discord_invite_options("{\"operation\":\"create\",\"reason\":\"fixture\"}")
    if not (archive_list_text(options and 0) equals "valid") or else not (archive_list_text(options and 5) equals "{\"unique\":true,\"max_age\":3600,\"max_uses\":1,\"temporary\":false}"):
        return 2
    set body to "{\"code\":\"Test_a-B\",\"guild\":{\"id\":\"100\",\"name\":\"excluded\"},\"channel\":{\"id\":\"200\"},\"inviter\":{\"id\":\"300\",\"email\":\"private-excluded\"},\"max_age\":60,\"max_uses\":1,\"uses\":0,\"temporary\":false}"
    set projected to discord_invite_single(body and "100" and "200" and "Test_a-B" and 1)
    if string_length(projected) equals 0 or else string_contains(projected and "excluded") equals 1:
        return 3
    if string_length(discord_invite_single(body and "101" and "200" and "Test_a-B" and 1)) > 0 or else string_length(discord_invite_single(body and "100" and "201" and "Test_a-B" and 1)) > 0 or else string_length(discord_invite_single(body and "100" and "200" and "Wrong" and 1)) > 0:
        return 4
    set items to concat("[" and concat(body and "]"))
    if string_length(discord_invite_list_view(items and "100" and "200")) equals 0:
        return 5
    set items to concat("[" and concat(body and concat("," and concat(body and "]"))))
    if string_length(discord_invite_list_view(items and "100" and "200")) > 0:
        return 6
    if string_length(discord_invite_single("{\"code\":\"Test_a-B\",\"channel\":{\"id\":\"200\"}}" and "100" and "200" and "Test_a-B" and 1)) > 0:
        return 7
    display "PASS: invite route confinement, defaults, bounded explicit expiry/use, unknown-field refusal, guild/channel binding and private metadata projection."
    return 0
