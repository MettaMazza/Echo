import "../../app/discord/gateway_connection"
import "string"

# Live qualification of the real heartbeat owner. The external harness
# requests stop only after observing multiple persisted server ACKs. Reusing
# the database in a second invocation exercises durable session resumption.
# No chat message is sent and no inference is invoked.
define main returning Int:
    if get_argument_count() is not equal to 7:
        return 1
    set secret to read_file(get_argument(2))
    if secret equals 0 or else file_exists(get_argument(4)):
        return 2
    set token to string_trim(ptr_to_str(secret))
    set database to discord_store_open(get_argument(3) and "1559932799559934065")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 3
    set previous to discord_gateway_resume_read(database)
    if get_argument(6) equals "resume":
        if not (archive_list_text(previous and 0) equals "found"):
            return 4
    else if archive_list_text(previous and 0) equals "found":
        return 5
    set result to discord_gateway_connection(get_argument(1) and token and database and "1559932799559934065" and ["1559928442403819711"] and ["1559898941171040291"] and get_argument(5) and "wss://gateway.discord.gg" and get_argument(4))
    if not (archive_list_text(result and 0) equals "stopped"):
        print archive_list_text(result and 1)
        return 6
    set health to history_collect_one(archive_prepare(database and "SELECT ack_count FROM discord_gateway_health WHERE singleton=1;"))
    if string_to_int(archive_list_text(health and 1)) < 2:
        return 7
    set current to discord_gateway_resume_read(database)
    if not (archive_list_text(current and 0) equals "found"):
        return 8
    if get_argument(6) equals "resume":
        if not (archive_list_text(previous and 1) equals archive_list_text(current and 1)):
            return 9
        set resumed to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_dispatch WHERE kind='RESUMED';"))
        if string_to_int(archive_list_text(resumed and 1)) < 1:
            return 10
    print "PASS: real Gateway owner, persisted session, multiple heartbeat ACKs and host stop"
    return 0
