import "../../app/discord/queue_offer"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_queue_offer_schema(journal) is not equal to 0:
        return 2
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set claimed to discord_worker_claim(journal)
    set recorded to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and "{\"id\":\"101\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"},\"content\":\"Follow up\"}")
    set offer to discord_queue_offer(journal and "message:create:101")
    if not (archive_list_text(offer and 0) equals "offered") or else not (archive_list_text(offer and 1) equals "message:create:100"):
        return 3
    if not (discord_queue_offer_reserve(journal and "message:create:101" and "501") equals "offer-binding-denied"):
        return 4
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set offer to discord_queue_offer(journal and "message:create:101")
    if not (archive_list_text(offer and 1) equals "message:create:100"):
        return 5
    set ended to discord_worker_finish(journal and "message:create:100" and "enqueued")
    if not (discord_queue_offer_reserve(journal and "message:create:101" and "500") equals "queue-or-target-unavailable"):
        return 6
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:101"):
        return 7
    set recorded to discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and "{\"id\":\"102\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set offer to discord_queue_offer(journal and "message:create:102")
    if not (archive_list_text(offer and 1) equals "message:create:101"):
        return 8
    if not (discord_queue_offer_reserve(journal and "message:create:102" and "500") equals "reserved"):
        return 9
    set recorded to discord_inbox_record(journal and "message:create:103" and "MESSAGE_CREATE" and "{\"id\":\"103\",\"channel_id\":\"301\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    if not (archive_list_text(discord_queue_offer(journal and "message:create:103") and 0) equals "no-unique-active-target"):
        return 10
    set recorded to discord_inbox_record(journal and "message:create:104" and "MESSAGE_CREATE" and "{\"id\":\"104\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"501\"}}")
    if not (archive_list_text(discord_queue_offer(journal and "message:create:104") and 0) equals "no-unique-active-target"):
        return 11
    # Replaying a stale offer never retargets it to the newer claimed turn.
    set offer to discord_queue_offer(journal and "message:create:101")
    if not (archive_list_text(offer and 1) equals "message:create:100"):
        return 12
    set recorded to discord_inbox_record(journal and "interaction:700" and "INTERACTION_CREATE" and "{\"id\":\"700\",\"channel_id\":\"302\",\"guild_id\":\"200\",\"member\":{\"user\":{\"id\":\"500\"}}}")
    if sql_execute(journal and "INSERT INTO discord_background_runs VALUES('fixture-command','interaction:700',1,'running','fixture',0,0);") is not equal to 0:
        return 13
    set recorded to discord_inbox_record(journal and "message:create:105" and "MESSAGE_CREATE" and "{\"id\":\"105\",\"channel_id\":\"302\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set offer to discord_queue_offer(journal and "message:create:105")
    if not (archive_list_text(offer and 1) equals "interaction:700") or else not (archive_list_text(offer and 2) equals "500"):
        return 14
    # Corrupt/overlapping activity cannot silently select one of two targets.
    set recorded to discord_inbox_record(journal and "message:create:106" and "MESSAGE_CREATE" and "{\"id\":\"106\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    if sql_execute(journal and "INSERT INTO discord_background_runs VALUES('fixture-overlap','message:create:100',1,'running','fixture',0,0);") is not equal to 0:
        return 15
    if not (archive_list_text(discord_queue_offer(journal and "message:create:106") and 0) equals "no-unique-active-target"):
        return 16
    display "PASS: queue offers persist exact targets across restart, deny foreign actors/channels, do not consume queue items, reject stale clicks instead of retargeting, bind command actors, and reject ambiguous targets."
    return 0
