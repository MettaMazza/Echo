import "../../app/discord/gateway_journal"
import "../../app/discord/voice_gateway_tick"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_schema(database) is not equal to 0 or else discord_voice_leave_schema(database) is not equal to 0 or else discord_voice_gateway_send_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "old" and "session")
    set recorded to discord_gateway_dispatch(database and "old" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set library to ep_dlopen(get_argument(2))
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and library)
    set added to append_list(socket and 1)
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set evidence to ep_sha256("access")
    set requested to discord_voice_intent_request(database and "unwritten" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claimed to discord_voice_intent_claim(database and "unwritten" and "old" and 1 and evidence)
    set cancelled to discord_voice_intent_cancel(database and "unwritten")
    set pending to discord_voice_leave_claim(database and "unwritten" and "old")
    set pending_claim to archive_list_text(pending and 1)
    set requested to discord_voice_intent_request(database and "attempted" and "101" and "201" and "400" and "run" and "call2" and evidence)
    set claimed to discord_voice_intent_claim(database and "attempted" and "old" and 1 and evidence)
    set cancelled to discord_voice_intent_cancel(database and "attempted")
    set pending to discord_voice_leave_claim(database and "attempted" and "old")
    set attempted_claim to archive_list_text(pending and 1)
    # Simulate a crash after the native write, before its outcome is durable.
    set injected to sql_execute(database and "CREATE TRIGGER fixture_leave_failure BEFORE UPDATE ON discord_voice_leave_attempts WHEN NEW.identity='attempted' AND NEW.state='sent' BEGIN SELECT RAISE(ABORT,'fixture outcome failure'); END;")
    if not (discord_voice_gateway_send(database and socket and "attempted" and attempted_claim and "old" and 1 and 0 and 1 and "/nonexistent/fixture-stop") equals "voice-dispatch-outcome-unrecorded") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 2
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "300")
    set removed to sql_execute(database and "DROP TRIGGER fixture_leave_failure;")
    set bound to discord_gateway_bind(database and "new" and "session")
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    if not (discord_voice_gateway_tick(database and socket and "old" and "/nonexistent/fixture-stop" and "300") equals "stale-voice-tick"):
        return 3
    if not (discord_voice_gateway_send(database and socket and "unwritten" and pending_claim and "old" and 1 and 0 and 1 and "/nonexistent/fixture-stop") equals "stale-voice-dispatch"):
        return 4
    if not (discord_voice_gateway_tick(database and socket and "new" and "/nonexistent/fixture-stop" and "300") equals "sent") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 5
    if not (ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text"))) equals discord_voice_gateway_state_body("100" and "" and 1 and 1)):
        return 6
    if not (discord_voice_gateway_tick(database and socket and "new" and "/nonexistent/fixture-stop" and "300") equals "voice-idle") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 7
    set state to history_collect_one(archive_prepare(database and "SELECT state,generation,gateway_session,after_sequence FROM discord_voice_leave_attempts WHERE identity='attempted';"))
    if not (archive_list_text(state and 1) equals "uncertain") or else not (archive_list_text(state and 2) equals "old") or else not (archive_list_text(state and 3) equals "session") or else not (archive_list_text(state and 4) equals "1"):
        return 8
    if not (discord_voice_leave_reconcile(database and "attempted" and "new" and "300") equals "await-voice-leave-confirmation"):
        return 9
    set payload to "{\"guild_id\":\"101\",\"user_id\":\"300\",\"channel_id\":null,\"session_id\":\"\"}"
    set recorded to discord_gateway_dispatch_voice(database and "new" and "session" and 2 and "VOICE_STATE_UPDATE" and ep_sha256(payload) and "" and "" and payload)
    if not (discord_voice_gateway_tick(database and socket and "new" and "/nonexistent/fixture-stop" and "300") equals "voice-left-confirmed"):
        return 10
    if ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1 or else not (discord_voice_intent_request(database and "next" and "101" and "202" and "400" and "run" and "call3" and evidence) equals "queued"):
        return 11
    # The remaining sent leave has no disconnect receipt. A new Identify
    # must wait for a current, valid snapshot that actually excludes the bot.
    set bound to discord_gateway_bind(database and "identified" and "new-session")
    if not (discord_voice_gateway_tick(database and socket and "identified" and "/nonexistent/fixture-stop" and "300") equals "voice-idle"):
        return 12
    set payload to "{\"id\":\"100\",\"voice_states\":[{\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"voice\"}]}"
    set recorded to discord_gateway_dispatch_voice(database and "identified" and "new-session" and 1 and "GUILD_CREATE" and ep_sha256(payload) and "" and "" and payload)
    if not (discord_voice_gateway_tick(database and socket and "identified" and "/nonexistent/fixture-stop" and "300") equals "voice-idle"):
        return 13
    set payload to "{\"id\":\"100\",\"voice_states\":[]}"
    set recorded to discord_gateway_dispatch_voice(database and "identified" and "new-session" and 2 and "GUILD_CREATE" and ep_sha256(payload) and "" and "" and payload)
    set invalidated to "{\"guild_id\":\"100\",\"invalid\":true}"
    set recorded to discord_gateway_dispatch_voice(database and "identified" and "new-session" and 3 and "GUILD_DELETE" and ep_sha256(invalidated) and "" and "" and invalidated)
    if not (discord_voice_gateway_tick(database and socket and "identified" and "/nonexistent/fixture-stop" and "300") equals "voice-idle"):
        return 14
    set recorded to discord_gateway_dispatch_voice(database and "identified" and "new-session" and 4 and "GUILD_CREATE" and ep_sha256(payload) and "" and "" and payload)
    if not (discord_voice_gateway_tick(database and socket and "identified" and "/nonexistent/fixture-stop" and "300") equals "voice-left-confirmed") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 15
    set receipt to history_collect_one(archive_prepare(database and "SELECT session,sequence,kind FROM discord_voice_leave_confirmations WHERE identity='unwritten';"))
    if not (archive_list_text(receipt and 1) equals "new-session") or else not (archive_list_text(receipt and 2) equals "4") or else not (archive_list_text(receipt and 3) equals "GUILD_CREATE"):
        return 16
    set closed to discord_socket_close(socket)
    set closed to sql_close(database)
    display "PASS: restart adopts only unmarked leave claims; stale owners cannot write; an attempted write with lost outcome remains uncertain and reconciles from a later trusted disconnect without replay."
    return 0
