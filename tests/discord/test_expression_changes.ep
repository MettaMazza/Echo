import "../../app/discord/expression_changes"

define main returning Int:
    if discord_expression_changes("{\"name\": \"fixture\", \"roles\": []}" and "emoji" and 1) is not equal to 1:
        return 1
    if discord_expression_changes("{\"roles\": null}" and "emoji" and 0) is not equal to 1:
        return 2
    if discord_expression_changes("{\"name\": \"fixture\", \"roles\": null}" and "emoji" and 1) is not equal to 0:
        return 3
    if discord_expression_changes("{\"roles\": [\"100\", \"100\"]}" and "emoji" and 0) is not equal to 0:
        return 4
    if discord_expression_changes("{\"roles\": [100]}" and "emoji" and 0) is not equal to 0:
        return 5
    if discord_expression_changes("{\"description\": \"wrong\"}" and "emoji" and 0) is not equal to 0:
        return 6
    if discord_expression_changes("{}" and "emoji" and 0) is not equal to 0:
        return 7
    if discord_expression_changes("{\"name\": \"Fixture\", \"description\": \"\", \"tags\": \"wave\"}" and "sticker" and 1) is not equal to 1:
        return 8
    if discord_expression_changes("{\"name\": \"Fixture\", \"description\": \"x\", \"tags\": \"wave\"}" and "sticker" and 1) is not equal to 0:
        return 9
    if discord_expression_changes("{\"name\": \"Fixture\", \"description\": null, \"tags\": \"wave\"}" and "sticker" and 1) is not equal to 0:
        return 10
    if discord_expression_changes("{\"description\": null}" and "sticker" and 0) is not equal to 1:
        return 11
    if discord_expression_changes("{\"description\": \"\"}" and "sticker" and 0) is not equal to 0:
        return 12
    if discord_expression_changes("{\"tags\": \"wave\"}" and "sticker" and 0) is not equal to 1:
        return 13
    if discord_expression_changes("{\"roles\": []}" and "sticker" and 0) is not equal to 0:
        return 14
    if discord_expression_changes("{\"name\": \"Fixture\", \"tags\": \"wave\"}" and "sticker" and 1) is not equal to 0:
        return 15
    if discord_expression_changes("{\"name\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}" and "sticker" and 0) is not equal to 0:
        return 16
    if discord_expression_changes("{\"roles\": [\"100\", \"200\"]}" and "emoji" and 0) is not equal to 1:
        return 17
    display "PASS: expression metadata, sticker create/edit null and empty distinctions, role arrays and unknown fields."
    return 0
