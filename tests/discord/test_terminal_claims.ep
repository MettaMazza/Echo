import "../../app/discord/terminal_claims"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to archive_open(concat(get_argument(1) and ".agent"))
    if discord_worker_schema(journal) is not equal to 0 or else agent_run_schema(database) is not equal to 0:
        return 2
    for each status in ["cancelled","failed","completed","generating","ready"]:
        set state to ptr_to_str(status)
        set inbox to concat("message:create:" and state)
        set run to concat("discord-message:" and state)
        set event to concat(run and ":user")
        set recorded to discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and "{}")
        if archive_append(database and state and event and "user" and "fixture" and "fixture") is not equal to 0 or else agent_run_create(database and run and state and event) is not equal to 0:
            return 3
        if archive_finish(checkpoint_prepare(database and "UPDATE echo_runs SET state=?2 WHERE run=?1;" and [run,state]) and 101) is not equal to 0:
            return 4
        if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_agent_jobs VALUES(?1,'claimed','fixture',0,0);" and [inbox]) and 101) is not equal to 0:
            return 5
    set recorded to discord_inbox_record(journal and "message:create:missing" and "MESSAGE_CREATE" and "{}")
    if sql_execute(journal and "INSERT INTO discord_agent_jobs VALUES('message:create:missing','claimed','fixture',0,0);") is not equal to 0:
        return 6
    if discord_terminal_claims_reconcile(journal and database) is not equal to 0 or else discord_terminal_claims_reconcile(journal and database) is not equal to 0:
        return 7
    set result to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_agent_jobs WHERE (inbox='message:create:cancelled' AND state='cancelled') OR (inbox='message:create:failed' AND state='failed') OR (inbox IN ('message:create:completed','message:create:generating','message:create:ready','message:create:missing') AND state='claimed');"))
    if not (archive_list_text(result and 1) equals "6"):
        return 8
    set receipts to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_agent_job_events;"))
    if not (archive_list_text(receipts and 1) equals "2"):
        return 9
    display "PASS: terminal cancellations/failures release claims once; completed, live and missing runs are not replayed or altered."
    return sql_close(journal) + sql_close(database)
