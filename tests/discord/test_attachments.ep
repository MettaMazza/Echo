import "../../app/discord/turn_guard"

define main returning Int:
    set before to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"\",\"attachments\":[{\"id\":\"700\",\"filename\":\"voice.wav\",\"size\":100,\"content_type\":\"audio/wav\",\"url\":\"https://cdn.discordapp.com/attachments/300/700/voice.wav?ex=old\"}]}"
    set after to string_replace(before and "ex=old" and "ex=new")
    if discord_source_matches(before and after) is not equal to 1:
        return 1
    for each changed in ["\"size\":101", "\"size\":-1"]:
        if discord_source_matches(before and string_replace(after and "\"size\":100" and ptr_to_str(changed))) is not equal to 0:
            return 2
    if discord_source_matches(before and string_replace(after and "voice.wav" and "other.wav")) is not equal to 0:
        return 3
    if not (archive_list_text(discord_attachment_url("https://cdn.discordapp.com/attachments/300/700/voice.wav?ex=new" and "300" and "700") and 0) equals "parsed"):
        return 4
    for each url in ["http://cdn.discordapp.com/attachments/300/700/voice.wav","https://evil.test/attachments/300/700/voice.wav","https://cdn.discordapp.com.evil.test/attachments/300/700/voice.wav","https://cdn.discordapp.com/attachments/301/700/voice.wav","https://cdn.discordapp.com/attachments/300/701/voice.wav","https://user:pass@cdn.discordapp.com/attachments/300/700/voice.wav","https://127.0.0.1/attachments/300/700/voice.wav"]:
        if archive_list_text(discord_attachment_url(ptr_to_str(url) and "300" and "700") and 0) equals "parsed":
            return 5
    display "PASS: renewed signed query allowed; changed attachment identity/name/size denied; CDN HTTPS origin and channel/file binding enforced."
    return 0
