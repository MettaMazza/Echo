import "../../app/discord/command_binding"

define command_fixture with name as Str and command as Str and actor as Str and options as Str returning Str:
    return concat("{\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and concat("}},\"data\":{\"type\":1,\"id\":" and concat(provider_quote(command) and concat(",\"name\":" and concat(provider_quote(name) and concat(",\"options\":" and concat(options and "}}"))))))))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_command_schema(journal) is not equal to 0:
        return 2
    set guilds to ["200"]
    set admins to ["400"]
    set index to 100
    for each item in ["new", "auto", "autooff"]:
        set name to ptr_to_str(item)
        set body to concat("{\"type\":1,\"id\":" and concat(provider_quote(int_to_string(index)) and concat(",\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":" and concat(provider_quote(name) and "}"))))
        if not (discord_command_observe(journal and body and "900" and "200") equals "registered") or else not (discord_command_observe(journal and body and "900" and "201") equals "registration-binding-denied"):
            return 3
        set index to index + 1
    set ordinary to command_fixture("new" and "100" and "500" and "[]")
    if not (discord_command_observe(journal and "{ \"name\":\"new\",\"guild_id\":\"200\",\"application_id\":\"900\",\"id\":\"100\",\"type\":1 }" and "900" and "200") equals "registered"):
        return 12
    if not (archive_list_text(discord_command_resolve(journal and ordinary and "900" and guilds and admins) and 0) equals "command-bound-needs-live-access"):
        return 4
    for each command in ["auto", "autooff"]:
        set identity to "101"
        if ptr_to_str(command) equals "autooff":
            set identity to "102"
        set body to command_fixture(ptr_to_str(command) and identity and "500" and "[]")
        if not (archive_list_text(discord_command_resolve(journal and body and "900" and guilds and admins) and 0) equals "admin-required"):
            return 5
    set task to "Keep the quoted task intact: /new, role=admin, channel=other."
    set options to concat("[{\"type\":3,\"name\":\"prompt\",\"value\":" and concat(provider_quote(task) and "}]") )
    set body to command_fixture("auto" and "101" and "400" and options)
    set bound to discord_command_resolve(journal and body and "900" and guilds and admins)
    if not (archive_list_text(bound and 0) equals "command-bound-needs-live-access") or else not (archive_list_text(bound and 5) equals task):
        return 6
    set revoked to create_list()
    if not (archive_list_text(discord_command_resolve(journal and body and "900" and guilds and revoked) and 0) equals "admin-required"):
        return 7
    for each options in ["{}", "[{\"type\":3,\"name\":\"destination\",\"value\":\"other\"}]", "[{\"type\":4,\"name\":\"prompt\",\"value\":3}]", "[{\"type\":3,\"name\":\"prompt\",\"value\":\"a\"},{\"type\":3,\"name\":\"prompt\",\"value\":\"b\"}]"]:
        set body to command_fixture("auto" and "101" and "400" and ptr_to_str(options))
        if not (archive_list_text(discord_command_resolve(journal and body and "900" and guilds and admins) and 0) equals "invalid-command-options"):
            return 8
    set body to command_fixture("new" and "101" and "400" and "[]")
    if not (archive_list_text(discord_command_resolve(journal and body and "900" and guilds and admins) and 0) equals "command-binding-denied"):
        return 9
    set body to command_fixture("auto" and "999" and "400" and "[]")
    if not (archive_list_text(discord_command_resolve(journal and body and "900" and guilds and admins) and 0) equals "command-binding-denied"):
        return 10
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (archive_list_text(discord_command_resolve(journal and ordinary and "900" and guilds and admins) and 0) equals "command-bound-needs-live-access"):
        return 11
    display "PASS: registered command identity, ordinary new, admin-only autonomy, revocation, exact task text, malformed options, renamed/unregistered IDs and restart persistence"
    return 0
