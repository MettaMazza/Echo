import "../../app/discord/text_chunk"

define main returning Int:
    if not (discord_text_chunk("First sentence. Second sentence! Third?" and 0 and 25) equals "First sentence."):
        return 1
    if not (discord_text_chunk("First? Second! Third sentence continues" and 0 and 20) equals "First? Second!"):
        return 2
    if not (discord_text_chunk("Words without punctuation continue here" and 0 and 18) equals "Words without "):
        return 3
    if not (discord_text_chunk("Value 3.14159 continues here" and 0 and 12) equals "Value "):
        return 4
    if not (discord_text_chunk("First sentence.\n2. Another sentence continues." and 0 and 22) equals "First sentence."):
        return 8
    set text to ""
    set index to 0
    repeat while index < 300:
        set text to concat(text and "A sentence with é and 🎧! Another question? ")
        set index to index + 1
    set offset to 0
    set rebuilt to ""
    repeat while offset < string_length(text):
        set part to discord_text_chunk(text and offset and 1800)
        if string_length(part) equals 0 or else string_length(part) > 1800 or else provider_valid_utf8(part) equals 0:
            return 5
        set rebuilt to concat(rebuilt and part)
        set offset to offset + string_length(part)
    if not (rebuilt equals text):
        return 6
    if string_length(discord_text_chunk("🎧🎧🎧" and 1 and 5)) > 0 or else not (discord_text_chunk("🎧🎧🎧" and 0 and 5) equals "🎧"):
        return 7
    display "PASS: sentence ends, whitespace fallback, decimal avoidance, Unicode-safe long token, lossless multi-page reconstruction."
    return 0
