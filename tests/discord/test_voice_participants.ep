import "../../app/discord/voice_participants"

define main returning Int:
    set state to discord_voice_participants_new("100" and "200" and "300" and 1)
    if discord_voice_participants_roster(state and 1) is not equal to 0:
        return 1
    set result to discord_voice_participants_update(state and 1 and "100" and "200" and "300" and "bot-session")
    set result to discord_voice_participants_update(state and 1 and "100" and "200" and "400" and "member-session")
    set roster to discord_voice_participants_roster(state and 1)
    if length_list(roster) is not equal to 2:
        return 2
    set result to discord_voice_participants_update(state and 1 and "100" and "bad-channel" and "400" and "member-session")
    if not (result equals "invalid-participant") or else length_list(discord_voice_participants_roster(state and 1)) is not equal to 2:
        return 12
    set revision to get_list(state and 6)
    set result to discord_voice_participants_update(state and 1 and "100" and "200" and "400" and "member-session")
    if get_list(state and 6) is not equal to revision or else not (result equals "membership-unchanged"):
        return 3
    if not (discord_voice_participants_ssrc(state and 1 and "400" and 12345) equals "audio-identity-mapped") or else not (discord_voice_participants_user(state and 1 and 12345) equals "400"):
        return 4
    set fresh to discord_voice_participants_new("100" and "200" and "300" and 1)
    set result to discord_voice_participants_update(fresh and 1 and "100" and "200" and "400" and "member-session")
    if discord_voice_participants_carry(state and fresh and 1) is not equal to 1 or else not (discord_voice_participants_user(fresh and 1 and 12345) equals "400"):
        return 13
    set result to discord_voice_participants_update(fresh and 1 and "100" and "200" and "400" and "changed-session")
    if discord_voice_participants_carry(state and fresh and 1) is not equal to 1 or else not (discord_voice_participants_user(fresh and 1 and 12345) equals "") or else not (discord_voice_participants_user(state and 1 and 12345) equals "400"):
        return 14
    set result to discord_voice_participants_update(state and 1 and "100" and "200" and "400" and "new-session")
    if not (discord_voice_participants_user(state and 1 and 12345) equals ""):
        return 5
    if not (discord_voice_participants_ssrc(state and 1 and "999" and 54321) equals "unknown-voice-participant") or else length_list(discord_voice_participants_roster(state and 1)) is not equal to 2:
        return 6
    set result to discord_voice_participants_update(state and 2 and "100" and "" and "400" and "")
    if not (result equals "stale-participant-event") or else length_list(discord_voice_participants_roster(state and 1)) is not equal to 2:
        return 7
    set result to discord_voice_participants_update(state and 1 and "999" and "" and "300" and "")
    if not (result equals "other-guild") or else discord_voice_participants_valid(state and 1) is not equal to 1:
        return 8
    set result to discord_voice_participants_update(state and 1 and "100" and "201" and "400" and "new-session")
    if length_list(discord_voice_participants_roster(state and 1)) is not equal to 1 or else length_list(roster) is not equal to 2:
        return 9
    set result to discord_voice_participants_update(state and 1 and "100" and "200" and "400" and "third-session")
    set result to discord_voice_participants_ssrc(state and 1 and "300" and 111)
    set result to discord_voice_participants_ssrc(state and 1 and "400" and 111)
    if not (result equals "ambiguous-audio-identity") or else discord_voice_participants_roster(state and 1) is not equal to 0 or else not (discord_voice_participants_user(state and 1 and 111) equals ""):
        return 10
    set state to discord_voice_participants_new("100" and "200" and "300" and 2)
    set result to discord_voice_participants_update(state and 2 and "100" and "200" and "300" and "bot-session")
    set result to discord_voice_participants_update(state and 2 and "100" and "201" and "300" and "bot-session")
    if not (result equals "bot-left-channel") or else discord_voice_participants_roster(state and 2) is not equal to 0:
        return 11
    display "PASS: channel-bound voice membership tracks join/leave/session changes, stable snapshots and SSRC identity; stale events, unknown users and collisions cannot authorize audio."
    return 0
