import "../../app/discord/agent_bridge"

# Read-only diagnosis against an archive snapshot. No mutation arguments accepted.
define main returning Int:
    if get_argument_count() is not equal to 15:
        return 1
    set database to discord_agent_open(get_argument(4) and get_argument(7))
    if database equals 0:
        return 2
    set run to get_argument(14)
    set pending to history_collect_one(checkpoint_prepare(database and "SELECT t.call_id,json_extract(e.payload,'$.arguments') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run=?1 AND t.state='running' AND json_extract(e.payload,'$.name')='discord_channels' AND json_extract(json_extract(e.payload,'$.arguments'),'$.operation')='inspect';" and [run]))
    if not (archive_list_text(pending and 0) equals "found"):
        return 3
    display discord_channels_execute(database and run and archive_list_text(pending and 1) and archive_list_text(pending and 2))
    return 0
