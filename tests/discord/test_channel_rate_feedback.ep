import "../../app/discord/channel_tool"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_delivery_schema(journal) is not equal to 0:
        return 2
    set now to ep_time_now_ms()
    if not (discord_rate_observe(journal and "fixture" and "200" and "429" and "" and "{\"retry_after\":60,\"global\":true}" and now) equals "recorded"):
        return 3
    set expected_deadline to discord_rate_deadline(journal and "GET:guild" and "200")
    if expected_deadline <= now:
        return 6
    set target to "{\"id\":\"300\",\"guild_id\":\"200\",\"permission_overwrites\":[]}"
    set result to discord_channels_permission("not-a-library" and "not-a-token" and journal and "not-an-output-directory" and "900" and "200" and "400" and target and 0)
    set fields to provider_json_tokens(result)
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "rate-limited") or else not (provider_value(fields and provider_member(fields and 0 and "retry_at_unix_ms")) equals int_to_string(expected_deadline)):
        display result
        return 4
    set options to create_list()
    set result to discord_overwrite_permission("not-a-library" and "not-a-token" and journal and "not-an-output-directory" and "900" and "200" and "400" and target and options)
    set fields to provider_json_tokens(result)
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "rate-limited") or else string_contains(result and "not an access revocation") equals 0:
        display result
        return 5
    set closed to sql_close(journal)
    display "PASS: channel and overwrite controllers preserve real rate-gate deadline without network access or false permission revocation."
    return 0
