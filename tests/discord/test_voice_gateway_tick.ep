import "../../app/discord/gateway_journal"
import "../../app/discord/voice_gateway_tick"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_schema(database) is not equal to 0 or else discord_voice_leave_schema(database) is not equal to 0 or else discord_voice_gateway_send_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set recorded to discord_gateway_dispatch(database and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set library to ep_dlopen(get_argument(2))
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and library)
    set added to append_list(socket and 1)
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set evidence to ep_sha256("access")
    set requested to discord_voice_intent_request(database and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claimed to discord_voice_intent_claim(database and "join" and "generation" and 1 and evidence)
    set claim to archive_list_text(claimed and 1)
    if not (discord_voice_gateway_tick(database and socket and "old" and "/nonexistent/fixture-stop" and "300") equals "stale-voice-tick"):
        return 12
    if not (discord_voice_gateway_send(database and socket and "join" and claim and "old" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "stale-voice-dispatch") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0:
        return 2
    if not (discord_voice_gateway_tick(database and socket and "generation" and "/nonexistent/fixture-stop" and "300") equals "sent"):
        return 3
    set body to ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text")))
    if not (body equals discord_voice_gateway_state_body("100" and "200" and 1 and 1)):
        return 4
    if not (discord_voice_gateway_send(database and socket and "join" and claim and "generation" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "voice-dispatch-not-owned") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 5
    set cancelled to discord_voice_intent_cancel(database and "join")

    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 1)
    if not (discord_voice_gateway_tick(database and socket and "generation" and "/nonexistent/fixture-stop" and "300") equals "uncertain"):
        return 6
    set body to ptr_to_str(ep_dlcall0(ep_dlsym(library and "fixture_text")))
    if not (body equals discord_voice_gateway_state_body("100" and "" and 1 and 1)):
        return 7
    if not (discord_voice_gateway_tick(database and socket and "generation" and "/nonexistent/fixture-stop" and "300") equals "voice-idle") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 8
    set requested to discord_voice_intent_request(database and "denied" and "101" and "201" and "400" and "run" and "call2" and evidence)
    set claimed to discord_voice_intent_claim(database and "denied" and "generation" and 1 and evidence)
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    if not (discord_voice_gateway_send(database and socket and "denied" and archive_list_text(claimed and 1) and "generation" and 0 and 0 and 0 and "/nonexistent/fixture-stop") equals "voice-dispatch-revoked") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0:
        return 9
    set requested to discord_voice_intent_request(database and "commit-fail" and "102" and "202" and "400" and "run" and "call3" and evidence)
    set claimed to discord_voice_intent_claim(database and "commit-fail" and "generation" and 1 and evidence)
    set claim to archive_list_text(claimed and 1)
    set injected to sql_execute(database and "CREATE TRIGGER fixture_outcome_failure BEFORE UPDATE ON discord_voice_intents WHEN NEW.identity='commit-fail' AND NEW.state='sent' BEGIN SELECT RAISE(ABORT,'fixture outcome failure'); END;")
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    if not (discord_voice_gateway_send(database and socket and "commit-fail" and claim and "generation" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "voice-dispatch-outcome-unrecorded"):
        return 10
    if not (discord_voice_gateway_send(database and socket and "commit-fail" and claim and "generation" and 0 and 1 and 0 and "/nonexistent/fixture-stop") equals "voice-dispatch-already-attempted") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 11
    set closed to discord_socket_close(socket)
    set closed to sql_close(database)
    display "PASS: Gateway polling dispatches authorized join claims and prioritized leave cleanup; uncertain writes stay non-replayable across subsequent polls."
    return 0
