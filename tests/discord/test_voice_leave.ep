import "../../app/discord/gateway_journal"
import "../../app/discord/voice_leave"

define fixture_voice_leave_event with database as Int and sequence as Int and user as Str returning Str:
    set payload to concat("{\"guild_id\":\"100\",\"user_id\":" and concat(provider_quote(user) and ",\"channel_id\":null,\"session_id\":\"\"}"))
    return discord_gateway_dispatch_voice(database and "generation" and "session" and sequence and "VOICE_STATE_UPDATE" and ep_sha256(payload) and "" and "" and payload)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_schema(database) is not equal to 0 or else discord_voice_leave_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set recorded to fixture_voice_leave_event(database and 1 and "300")
    set evidence to ep_sha256("permission evidence")
    set requested to discord_voice_intent_request(database and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set joined to discord_voice_intent_claim(database and "join" and "generation" and 1 and evidence)
    set cancelled to discord_voice_intent_cancel(database and "join")
    set leave_claim to discord_voice_leave_claim(database and "join" and "generation")
    if not (archive_list_text(leave_claim and 0) equals "leave-claimed"):
        return 2
    if not (discord_voice_leave_reconcile(database and "join" and "generation" and "300") equals "await-voice-leave-confirmation"):
        return 3
    set claim to archive_list_text(leave_claim and 1)
    if not (discord_voice_leave_written(database and "join" and claim and 0) equals "uncertain"):
        return 4
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "300")
    set duplicate to discord_voice_leave_claim(database and "join" and "generation")
    if not (archive_list_text(duplicate and 0) equals "voice-leave-already-attempted"):
        return 5
    set recorded to fixture_voice_leave_event(database and 2 and "999")
    if not (discord_voice_leave_reconcile(database and "join" and "generation" and "300") equals "await-voice-leave-confirmation") or else not (discord_voice_intent_request(database and "new" and "100" and "201" and "400" and "run" and "new-call" and evidence) equals "voice-guild-busy"):
        return 6
    set recorded to fixture_voice_leave_event(database and 3 and "300")
    set moved to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"201\",\"session_id\":\"new-bot-session\"}"
    set recorded to discord_gateway_dispatch_voice(database and "generation" and "session" and 4 and "VOICE_STATE_UPDATE" and ep_sha256(moved) and "" and "" and moved)
    if not (discord_voice_leave_reconcile(database and "join" and "generation" and "300") equals "await-voice-leave-confirmation"):
        return 9
    set recorded to fixture_voice_leave_event(database and 5 and "300")
    set invalidated to "{\"guild_id\":\"100\",\"invalid\":true}"
    set recorded to discord_gateway_dispatch_voice(database and "generation" and "session" and 6 and "GUILD_DELETE" and ep_sha256(invalidated) and "" and "" and invalidated)
    if not (discord_voice_leave_reconcile(database and "join" and "generation" and "300") equals "await-voice-leave-confirmation"):
        return 10
    set recorded to fixture_voice_leave_event(database and 7 and "300")
    if not (discord_voice_leave_reconcile(database and "join" and "stale-generation" and "300") equals "stale-voice-leave-reconcile") or else not (discord_voice_leave_reconcile(database and "join" and "generation" and "300") equals "voice-left-confirmed"):
        return 7
    if not (discord_voice_intent_request(database and "new" and "100" and "201" and "400" and "run" and "new-call" and evidence) equals "queued"):
        return 8
    set closed to sql_close(database)
    display "PASS: durable leave claim cannot replay after restart; guild remains reserved until a fresh journaled bot disconnect confirms leave."
    return 0
