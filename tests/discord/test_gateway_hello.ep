import "../../app/discord/socket"
import "../../app/discord/routing"

# Live unauthenticated protocol qualification: no bot token, IDENTIFY, messages,
# member data or server mutation. Exercises actual TLS and WebSocket framing.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set socket to discord_socket_open(get_argument(1))
    if not (archive_list_text(socket and 0) equals "connected"):
        display archive_list_text(socket and 0)
        display archive_list_text(socket and 1)
        return 2
    set started to ep_time_now_ms()
    set text to ""
    repeat while ep_time_now_ms() - started < 20000:
        set row to discord_socket_read(socket)
        if archive_list_text(row and 0) equals "again":
            set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
            set waited to ep_dlcall1(ep_dlsym(system and "usleep") and 50000)
            set closed to ep_dlclose(system)
        else if archive_list_text(row and 0) equals "chunk":
            if not (archive_list_text(row and 2) equals "1"):
                set closed to discord_socket_close(socket)
                return 3
            set text to concat(text and archive_list_text(row and 1))
            if archive_list_text(row and 4) equals "0":
                set tokens to provider_json_tokens(text)
                if tokens is not equal to 0 and provider_value(tokens and provider_member(tokens and 0 and "op")) equals "10":
                    set data to provider_member(tokens and 0 and "d")
                    set interval to provider_value(tokens and provider_member(tokens and data and "heartbeat_interval"))
                    set closed to discord_socket_close(socket)
                    if string_to_int(interval) > 0:
                        display "PASS: real Discord TLS/WebSocket HELLO and positive heartbeat interval; no token or identification sent."
                        return 0
                set closed to discord_socket_close(socket)
                return 4
        else:
            display archive_list_text(row and 0)
            set closed to discord_socket_close(socket)
            return 5
    set closed to discord_socket_close(socket)
    return 6
