import "../../app/discord/gateway_intake"

define revision_dispatch with sequence as Int and kind as Str and data as Str returning Str:
    return concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":" and concat(provider_quote(kind) and concat(",\"d\":" and concat(data and "}"))))))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 2
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"session-r\",\"resume_gateway_url\":\"wss://gateway.discord.gg\"}}"
    if not (discord_gateway_ready_record(database and "socket-r" and "900" and ready) equals "recorded"):
        return 3
    set created to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"original\"}"
    if not (discord_gateway_intake(database and "socket-r" and "900" and ["200"] and ["400"] and revision_dispatch(2 and "MESSAGE_CREATE" and created)) equals "recorded"):
        return 4
    set edited to "{\"id\":\"100\",\"channel_id\":\"300\",\"content\":\"edited\"}"
    if not (discord_gateway_intake(database and "socket-r" and "900" and ["200"] and ["400"] and revision_dispatch(3 and "MESSAGE_UPDATE" and edited)) equals "recorded"):
        return 5
    for each invalid in ["{\"id\":\"100\",\"channel_id\":\"301\",\"content\":\"FOREIGN_CHANNEL\"}","{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"201\",\"content\":\"FOREIGN_GUILD\"}","{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"501\"},\"content\":\"FORGED_AUTHOR\"}","{\"id\":\"101\",\"channel_id\":\"300\",\"content\":\"UNKNOWN_MESSAGE\"}"]:
        if string_length(discord_message_revision(database and "MESSAGE_UPDATE" and ptr_to_str(invalid) and ["200"] and ["400"])) > 0:
            return 6
    if string_length(discord_message_revision(database and "MESSAGE_UPDATE" and edited and ["201"] and ["400"])) > 0:
        return 7
    set deleted to "{\"id\":\"100\",\"channel_id\":\"300\",\"content\":\"DELETE_PAYLOAD_MUST_NOT_SURVIVE\"}"
    if not (discord_gateway_intake(database and "socket-r" and "900" and ["200"] and ["400"] and revision_dispatch(4 and "MESSAGE_DELETE" and deleted)) equals "recorded"):
        return 8
    if not (discord_gateway_intake(database and "socket-r" and "900" and ["200"] and ["400"] and revision_dispatch(5 and "CHANNEL_UPDATE" and "{\"id\":\"300\",\"guild_id\":\"200\",\"name\":\"UNTRUSTED_CHANNEL_NAME\"}")) equals "recorded"):
        return 9
    set patches to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE kind='MESSAGE_UPDATE';"))
    if not (archive_list_text(patches and 1) equals "1"):
        return 10
    set originals to history_collect_one(archive_prepare(database and "SELECT payload FROM discord_inbox WHERE identity='message:create:100';"))
    if not (archive_list_text(originals and 1) equals created):
        return 11
    set leaked to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE payload LIKE '%DELETE_PAYLOAD%' OR payload LIKE '%UNTRUSTED_CHANNEL_NAME%';"))
    if not (archive_list_text(leaked and 1) equals "0"):
        return 12
    set barriers to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE kind='CHANNEL_UPDATE' AND payload='{\"guild_id\":\"200\",\"channel_id\":\"300\"}';"))
    if not (archive_list_text(barriers and 1) equals "1"):
        return 13
    if not (discord_gateway_intake(database and "socket-r" and "900" and ["200"] and ["400"] and revision_dispatch(6 and "MESSAGE_DELETE_BULK" and "{\"channel_id\":\"300\",\"guild_id\":\"200\",\"ids\":[\"100\",\"999\"]}")) equals "recorded"):
        return 14
    set bulk to history_collect_one(archive_prepare(database and "SELECT payload FROM discord_inbox WHERE kind='MESSAGE_DELETE_BULK';"))
    if not (archive_list_text(bulk and 1) equals "{\"channel_id\":\"300\",\"ids\":[\"100\"]}"):
        return 15
    if not (discord_gateway_intake(database and "socket-r" and "900" and ["200"] and ["400"] and revision_dispatch(7 and "THREAD_UPDATE" and "{\"id\":\"700\",\"guild_id\":\"200\",\"name\":\"UNTRUSTED_THREAD_NAME\"}")) equals "recorded"):
        return 16
    set thread to history_collect_one(archive_prepare(database and "SELECT payload FROM discord_inbox WHERE kind='THREAD_UPDATE';"))
    if not (archive_list_text(thread and 1) equals "{\"guild_id\":\"200\",\"thread_id\":\"700\"}"):
        return 17
    print "PASS: admitted edit patches, immutable originals, scoped deletes and audience invalidation"
    return 0
