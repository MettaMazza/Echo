import "../../app/discord/interaction_recovery"
import "string"

# Explicit qualification against a private cloned journal with a labelled
# uncertain fixture. Only GET the token-bound original; never POST a callback.
# Arguments: curl library, credential file, cloned journal, interaction, bot,
# private HTTP evidence directory. No credentials are printed.
define main returning Int:
    if get_argument_count() is not equal to 7:
        return 1
    set secret to read_file(get_argument(2))
    if secret equals 0:
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 3
    set keys to [get_argument(4)]
    set fixture to history_collect_one(checkpoint_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity=?;" and keys))
    if not (archive_list_text(fixture and 1) equals "uncertain") or else not (archive_list_text(fixture and 2) equals "qualification-lost-ack-fixture"):
        return 4
    set result to discord_interaction_recover(get_argument(1) and string_trim(ptr_to_str(secret)) and journal and get_argument(4) and get_argument(5) and get_argument(6))
    if not (result equals "ack-recovered"):
        display result
        return 5
    set observed to history_collect_one(checkpoint_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity=?;" and keys))
    if not (archive_list_text(observed and 1) equals "acknowledged") or else not (archive_list_text(observed and 2) equals "ack-observed-original"):
        return 6
    display "PASS: existing private Discord response recovers uncertain fixture using GET only; no callback or speech replay"
    return 0
