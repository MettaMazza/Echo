import "../../app/discord/interaction_ack"

# Supply a disposable existing private directory. No network or credentials.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set refill to channel
    set receipts to channel
    set completed to channel
    spawn discord_ack_receipt_worker(get_argument(1) and refill and receipts and completed)
    send 1 to refill
    send 1 to refill
    set ready to create_list()
    set added to append_list(ready and receipts)
    if select(ready and 15000) < 0:
        return 2
    set first to receive from receipts
    if get_list(first and 0) < 0 or else get_list(first and 1) < 0:
        return 3
    if select(ready and 15000) < 0:
        return 4
    set second to receive from receipts
    if get_list(second and 0) < 0 or else get_list(second and 1) < 0:
        return 5
    if get_list(first and 0) equals get_list(second and 0) or else get_list(first and 1) equals get_list(second and 1):
        return 6
    if select(ready and 0) >= 0:
        return 7
    set closed to discord_ack_receipt_close(first)
    set closed to discord_ack_receipt_close(second)
    send 1 to refill
    send 0 to refill
    set finished to receive from completed
    if select(ready and 0) < 0:
        return 8
    set last to receive from receipts
    set closed to discord_ack_receipt_close(last)
    if select(ready and 0) >= 0:
        return 9
    set missing to discord_ack_receipt_pair(concat(get_argument(1) and "/missing-directory"))
    if get_list(missing and 0) is not equal to -1 or else get_list(missing and 1) is not equal to -1:
        return 10
    set retry_refill to channel
    set retry_receipts to channel
    set retry_completed to channel
    spawn discord_ack_receipt_worker(concat(get_argument(1) and "/recovering") and retry_refill and retry_receipts and retry_completed)
    send 1 to retry_refill
    set retry_ready to [retry_receipts]
    if select(retry_ready and 600) >= 0:
        return 11
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(system and get_argument(1))
    set restored to workspace_directory_open(system and root and "recovering" and 1)
    if restored < 0:
        return 12
    set closed to net_close(restored)
    set closed to net_close(root)
    set closed to ep_dlclose(system)
    if select(retry_ready and 15000) < 0:
        return 13
    set recovered to receive from retry_receipts
    if get_list(recovered and 0) < 0 or else get_list(recovered and 1) < 0:
        return 14
    set closed to discord_ack_receipt_close(recovered)
    send 0 to retry_refill
    set stopped to receive from retry_completed
    set stop_refill to channel
    set stop_receipts to channel
    set stop_completed to channel
    spawn discord_ack_receipt_worker(concat(get_argument(1) and "/never-available") and stop_refill and stop_receipts and stop_completed)
    send 1 to stop_refill
    set stop_ready to [stop_receipts]
    if select(stop_ready and 600) >= 0:
        return 15
    send 0 to stop_refill
    set stopped_ready to [stop_completed]
    if select(stopped_ready and 2000) < 0:
        return 16
    set stopped to receive from stop_completed
    display "PASS: valid exclusive receipts only; unavailable startup recovers without a new command; shutdown during outage completes"
    return 0
