import "../../app/discord/interaction_ack"

# Supply a disposable existing private directory. No network or credentials.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set refill to channel
    set receipts to channel
    set completed to channel
    spawn discord_ack_receipt_worker(get_argument(1) and refill and receipts and completed)
    send 1 to refill
    send 1 to refill
    set ready to create_list()
    set added to append_list(ready and receipts)
    if select(ready and 15000) < 0:
        return 2
    set first to receive from receipts
    if get_list(first and 0) < 0 or else get_list(first and 1) < 0:
        return 3
    if select(ready and 15000) < 0:
        return 4
    set second to receive from receipts
    if get_list(second and 0) < 0 or else get_list(second and 1) < 0:
        return 5
    if get_list(first and 0) equals get_list(second and 0) or else get_list(first and 1) equals get_list(second and 1):
        return 6
    if select(ready and 0) >= 0:
        return 7
    set closed to discord_ack_receipt_close(first)
    set closed to discord_ack_receipt_close(second)
    send 1 to refill
    send 0 to refill
    set finished to receive from completed
    if select(ready and 0) < 0:
        return 8
    set last to receive from receipts
    set closed to discord_ack_receipt_close(last)
    if select(ready and 0) >= 0:
        return 9
    set missing to discord_ack_receipt_pair(concat(get_argument(1) and "/missing-directory"))
    if get_list(missing and 0) is not equal to -1 or else get_list(missing and 1) is not equal to -1:
        return 10
    display "PASS: exclusive receipt pairs, bounded refill, drain after worker shutdown, unavailable directory"
    return 0
