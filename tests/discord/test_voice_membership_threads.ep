import "../../app/providers/archived_stream"
import "../../app/discord/voice_membership_reader"
import "select"

define membership_thread with completed as Int returning Int:
    set baseline to "{\"id\":\"100\",\"voice_states\":[{\"user_id\":\"400\",\"channel_id\":\"200\",\"session_id\":\"guest\"}]}"
    set joined to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"bot\"}"
    set departed to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":null}"
    set index to 0
    repeat while index < 10000:
        set membership to discord_voice_membership_new("100" and "200" and "300" and 1)
        set seeded to discord_voice_membership_snapshot(membership and 1 and 1 and baseline)
        if not (seeded equals "membership-seeded"):
            display seeded
            send 1 to completed
            return 1
        set result to discord_voice_membership_replay(membership and 1 and 2 and joined and 3)
        if not (result equals "membership-changed"):
            display result
            send 2 to completed
            return 2
        set result to discord_voice_membership_replay(membership and 1 and 3 and departed and 3)
        if not (result equals "membership-changed"):
            display result
            send 3 to completed
            return 3
        set result to discord_voice_membership_replay(membership and 1 and 4 and joined and 3)
        set roster to discord_voice_membership_roster(membership and 1)
        if not (result equals "membership-changed") or else length_list(roster) is not equal to 2:
            display result
            send 4 to completed
            return 4
        set result to discord_voice_membership_replay(membership and 1 and 5 and departed and 3)
        if not (result equals "bot-left-channel"):
            display result
            send 5 to completed
            return 5
        set index to index + 1
    send 0 to completed
    return 0

define main returning Int:
    set first to channel
    set second to channel
    spawn membership_thread(first)
    spawn membership_thread(second)
    set waits to create_list()
    set added to append_list(waits and first)
    set added to append_list(waits and second)
    set remaining to 2
    repeat while remaining > 0:
        set ready to select(waits and 20)
        if ready >= 0:
            set result to receive from get_list(waits and ready)
            if result is not equal to 0:
                return result
            set remaining to remaining - 1
    display "PASS: concurrent membership replay retains historical departures and rejects current bot departure."
    return 0
