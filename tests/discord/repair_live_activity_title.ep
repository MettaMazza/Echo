import "../../app/discord/activity_archive"

# Explicitly selected existing Echo-owned test thread. Archive/reopen/archive
# confirms the source binding and preserves all messages, then leaves it tidy.
define main returning Int:
    if get_argument_count() is not equal to 8:
        return 1
    set library to get_argument(1)
    set held to ep_dlopen(library)
    set secret to read_file(get_argument(2))
    if held equals 0 or else secret equals 0:
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(4))
    if journal equals 0:
        return 3
    set admins to string_split(get_argument(5) and ",")
    set outcome to discord_activity_thread_update(library and string_trim(ptr_to_str(secret)) and journal and get_argument(6) and -1 and "Echo · Activity history" and get_argument(4) and admins and get_argument(7) and "/tmp/echo-archive-test-stop")
    display outcome
    if not (outcome equals "archive-state-confirmed"):
        return 4
    display "PASS: source-bound history title confirmed with archived state restored."
    return 0
