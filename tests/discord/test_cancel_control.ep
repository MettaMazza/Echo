import "../../app/discord/cancel_control"
import "../../app/discord/command_registration"

define cancel_fixture with journal as Int and message as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(message) and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"},\"content\":\"Cancellation fixture\"}"))
    set source to concat("message:create:" and message)
    if not (discord_inbox_record(journal and source and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_command_schema(journal) is not equal to 0 or else discord_control_command_matches(discord_control_command_definition("cancel") and "cancel") is not equal to 1:
        return 20
    if not (discord_command_observe(journal and "{\"id\":\"801\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"cancel\"}" and "900" and "200") equals "registered"):
        return 21
    set command_body to "{\"id\":\"701\",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"500\"}},\"data\":{\"type\":1,\"id\":\"801\",\"name\":\"cancel\",\"options\":[{\"name\":\"message\",\"type\":3,\"value\":\"100\"}]}}"
    set bound to discord_command_resolve(journal and command_body and "900" and ["200"] and create_list())
    if not (archive_list_text(bound and 0) equals "command-bound-needs-live-access") or else not (archive_list_text(bound and 1) equals "cancel") or else not (archive_list_text(bound and 2) equals "500") or else not (archive_list_text(bound and 5) equals "100"):
        return 22
    if discord_worker_schema(journal) is not equal to 0 or else cancel_fixture(journal and "100") is not equal to 0 or else cancel_fixture(journal and "101") is not equal to 0:
        return 2
    for each actor in ["501","999"]:
        if not (discord_cancel_source(journal and "message:create:100" and ptr_to_str(actor) and "300" and "200" and "r1") equals "cancel-source-denied"):
            return 3
    if not (discord_cancel_source(journal and "message:create:100" and "500" and "301" and "200" and "r1") equals "cancel-source-denied") or else not (discord_cancel_source(journal and "message:create:100" and "500" and "300" and "201" and "r1") equals "cancel-source-denied"):
        return 3
    if not (discord_cancel_source(journal and "message:create:100" and "500" and "300" and "200" and "r1") equals "queue-cancelled"):
        return 4
    set claim to discord_worker_claim(journal)
    if not (archive_list_text(claim and 1) equals "message:create:101"):
        return 5
    if not (discord_cancel_source(journal and "message:create:101" and "500" and "300" and "200" and "r2") equals "cancel-requested"):
        return 6
    if discord_turn_barrier(journal and 99999 and "101" and "300" and "200") is not equal to 1 or else discord_turn_barrier(journal and 99999 and "102" and "300" and "200") is not equal to 0:
        return 7
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_cancel_source(journal and "message:create:101" and "500" and "300" and "200" and "r2") equals "already-cancel-requested") or else discord_turn_barrier(journal and 99999 and "101" and "300" and "200") is not equal to 1:
        return 8
    if cancel_fixture(journal and "102") is not equal to 0 or else sql_execute(journal and "INSERT INTO discord_agent_jobs VALUES('message:create:102','steered','fixture',0,0);") is not equal to 0:
        return 9
    if not (discord_cancel_source(journal and "message:create:102" and "500" and "300" and "200" and "r3") equals "cancel-target-is-steering"):
        return 10
    if cancel_fixture(journal and "103") is not equal to 0 or else sql_execute(journal and "INSERT INTO discord_agent_jobs VALUES('message:create:103','enqueued','fixture',0,0);") is not equal to 0:
        return 11
    if not (discord_cancel_source(journal and "message:create:103" and "500" and "300" and "200" and "r4") equals "cancel-target-terminal"):
        return 12
    display "PASS: queue cancellation, active barrier, scope denial, restart replay, steering and terminal rejection. Transport and actual socket interruption pending."
    return 0
