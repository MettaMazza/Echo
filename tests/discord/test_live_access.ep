import "../../app/discord/access"

# Read-only authenticated transport qualification; no conversation or send.
define main returning Int:
    if get_argument_count() is not equal to 9 or else file_exists(get_argument(3)):
        return 1
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 3
    if discord_member_timeout(journal and "{\"communication_disabled_until\":\"invalid\"}" and 1000) is not equal to -1 or else discord_member_timeout(journal and "{\"communication_disabled_until\":\"2026-10-20T11:00:00+00:00\"}" and 1000) is not equal to 1 or else discord_member_timeout(journal and "{\"communication_disabled_until\":null}" and 1000) is not equal to 0:
        return 4
    set admins to create_list()
    set added to append_list(admins and get_argument(8))
    set result to discord_access_check(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(7) and get_argument(8) and admins)
    display archive_list_text(result and 0)
    if not (archive_list_text(result and 0) equals "allowed") or else not (archive_list_text(result and 1) equals "public"):
        return 5
    display concat("Evidence digest: " and archive_list_text(result and 2))
    display "PASS: current authenticated bot and configured user guild/channel/role/member permissions; read-only API snapshots"
    return 0
