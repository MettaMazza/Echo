import "../../app/discord/turn_guard"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[]}"
    if discord_source_matches(original and original) is not equal to 1:
        return 2
    for each changed in ["{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"501\"},\"content\":\"Hello\"}","{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Edited\"}","{}"]:
        if discord_source_matches(original and ptr_to_str(changed)) is not equal to 0:
            return 3
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original)
    if discord_turn_barrier(journal and 1 and "100" and "300" and "200") is not equal to 0:
        return 4
    set recorded to discord_inbox_record(journal and "revision:other" and "MESSAGE_DELETE" and "{\"id\":\"101\",\"channel_id\":\"300\"}")
    if discord_turn_barrier(journal and 1 and "100" and "300" and "200") is not equal to 0:
        return 5
    set recorded to discord_inbox_record(journal and "revision:bulk" and "MESSAGE_DELETE_BULK" and "{\"ids\":[\"100\"],\"channel_id\":\"300\"}")
    if discord_turn_barrier(journal and 1 and "100" and "300" and "200") is not equal to 1 or else discord_turn_barrier(journal and 3 and "100" and "300" and "200") is not equal to 0:
        return 6
    set recorded to discord_inbox_record(journal and "audience:1" and "GUILD_ROLE_UPDATE" and "{\"guild_id\":\"200\"}")
    if discord_turn_barrier(journal and 3 and "100" and "300" and "200") is not equal to 1 or else discord_turn_barrier(journal and 3 and "100" and "300" and "201") is not equal to 0:
        return 7
    display "PASS: source identity/text freshness and rowid revision/audience barriers"
    return 0
