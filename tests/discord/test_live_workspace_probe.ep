import "../../app/workspace/sessions"

# Read-only diagnostic: never create a workspace or change its ownership.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    display concat("device-active=" and int_to_string(principal_device_active(database and get_argument(3))))
    display concat("history-allowed=" and int_to_string(group_history_allows(database and get_argument(2))))
    display concat("workspace-allowed=" and int_to_string(workspace_session_allowed(database and get_argument(3) and get_argument(2))))
    set root to workspace_root_open(library and get_argument(4))
    display concat("root-open=" and int_to_string(root >= 0))
    if root >= 0:
        set closed to net_close(root)
    display concat("anchor-present=" and int_to_string(string_length(archive_runtime_anchor(database and library)) > 0))
    set closed to ep_dlclose(library)
    set closed to sql_close(database)
    return 0
