import "../../app/discord/voice_wire"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 90
    set opus to ep_dlopen(get_argument(1))
    set sodium to ep_dlopen(get_argument(2))
    if opus equals 0 or else sodium equals 0:
        return 1
    set error to research_native_words(1)
    set encoder to ep_dlcall4(ep_dlsym(opus and "opus_encoder_create") and 48000 and 2 and 2049 and get_list_data_ptr(error))
    if encoder equals 0 or else get_list(error and 0) is not equal to 0:
        return 2
    set decoder to ep_dlcall3(ep_dlsym(opus and "opus_decoder_create") and 48000 and 2 and get_list_data_ptr(error))
    if decoder equals 0 or else get_list(error and 0) is not equal to 0:
        return 3
    set pcm to alloc_bytes(3840)
    set decoded to alloc_bytes(3840)
    set packet to alloc_bytes(1275)
    set index to 0
    repeat while index < 3840:
        set written to poke_byte(pcm and index and 0)
        set index to index + 1
    set bytes to ep_dlcall5(ep_dlsym(opus and "opus_encode") and encoder and pcm and 960 and packet and 1275)
    if bytes < 1 or else bytes > 1275:
        return 4
    set samples to ep_dlcall6(ep_dlsym(opus and "opus_decode") and decoder and packet and bytes and decoded and 960 and 0)
    if samples is not equal to 960:
        return 5
    set destroyed to ep_dlcall1(ep_dlsym(opus and "opus_encoder_destroy") and encoder)
    set destroyed to ep_dlcall1(ep_dlsym(opus and "opus_decoder_destroy") and decoder)
    free_bytes(pcm)
    free_bytes(decoded)
    free_bytes(packet)
    set initialized to ep_dlcall0(ep_dlsym(sodium and "sodium_init"))
    if initialized is not equal to 0 and also initialized is not equal to 1:
        return 6
    set key to alloc_bytes(32)
    set nonce to alloc_bytes(24)
    set plaintext to alloc_bytes(7)
    set cipher to alloc_bytes(23)
    set recovered to alloc_bytes(7)
    set index to 0
    repeat while index < 32:
        set written to poke_byte(key and index and index)
        if index < 24:
            set written to poke_byte(nonce and index and index + 32)
        set index to index + 1
    set index to 0
    repeat while index < 7:
        set written to poke_byte(plaintext and index and index * 42)
        set index to index + 1
    set header to discord_voice_rtp_header(1 and 960 and 16909060)
    set cipher_size to research_native_words(1)
    set output_size to research_native_words(1)
    set encrypted to ep_dlcall9(ep_dlsym(sodium and "crypto_aead_xchacha20poly1305_ietf_encrypt") and cipher and get_list_data_ptr(cipher_size) and plaintext and 7 and get_list(header and 0) and 12 and 0 and nonce and key)
    if encrypted is not equal to 0 or else get_list(cipher_size and 0) is not equal to 23:
        return 7
    set decrypted to ep_dlcall9(ep_dlsym(sodium and "crypto_aead_xchacha20poly1305_ietf_decrypt") and recovered and get_list_data_ptr(output_size) and 0 and cipher and 23 and get_list(header and 0) and 12 and nonce and key)
    if decrypted is not equal to 0 or else get_list(output_size and 0) is not equal to 7:
        return 8
    set index to 0
    repeat while index < 7:
        if peek_byte(recovered and index) is not equal to peek_byte(plaintext and index):
            return 9
        set index to index + 1
    set written to poke_byte(get_list(header and 0) and 2 and 1)
    set invalid to ep_dlcall9(ep_dlsym(sodium and "crypto_aead_xchacha20poly1305_ietf_decrypt") and recovered and get_list_data_ptr(output_size) and 0 and cipher and 23 and get_list(header and 0) and 12 and nonce and key)
    if invalid equals 0:
        return 10
    set written to poke_byte(get_list(header and 0) and 2 and 0)
    set written to poke_byte(cipher and 0 and (peek_byte(cipher and 0) + 1) % 256)
    set invalid to ep_dlcall9(ep_dlsym(sodium and "crypto_aead_xchacha20poly1305_ietf_decrypt") and recovered and get_list_data_ptr(output_size) and 0 and cipher and 23 and get_list(header and 0) and 12 and nonce and key)
    if invalid equals 0:
        return 11
    set wiped to ep_dlcall2(ep_dlsym(sodium and "sodium_memzero") and key and 32)
    free_bytes(key)
    free_bytes(nonce)
    free_bytes(plaintext)
    free_bytes(cipher)
    free_bytes(recovered)
    set released to discord_voice_blob_release(header)
    set closed to ep_dlclose(opus)
    set closed to ep_dlclose(sodium)
    display "PASS: native shared-library Opus 48kHz stereo 20ms encode/decode and XChaCha20-Poly1305 binary roundtrip; RTP header and ciphertext tampering fail authentication."
    return 0
