import "../../app/discord/agent_bridge"
import "../../app/discord/steering_media"
import "../../app/security/group_session_selection"

define media_retry_body with message as Str and file_id as Str and size as Str returning Str:
    return concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Listen to the fixture.\",\"attachments\":[{\"id\":" and concat(provider_quote(file_id) and concat(",\"filename\":\"clip.wav\",\"content_type\":\"audio/wav\",\"size\":" and concat(size and "}]}"))))))

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if web_attachment_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    set device to discord_agent_principal(database and "400" and create_list())
    if not (device equals "discord:400"):
        return 3
    set seed to channel_silo_submit(database and device and "discord" and "200" and "300" and "seed" and "Seed." and create_list())
    set first to archive_list_text(seed and 1)
    set revision to string_to_int(archive_list_text(seed and 2))
    if not (archive_list_text(seed and 0) equals "accepted") or else agent_cancel_run(database and "seed") is not equal to 0:
        return 4
    set group_id to channel_silo_identity("discord" and "200" and "300" and principal_for_device(database and device))
    set digest to file_digest(get_argument(3) and 65536)
    set size to int_to_string(get_list(digest and 2))
    set body to media_retry_body("101" and "501" and size)
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and body) equals "recorded") or else web_attachment_register(database and device and first and "discord-file:101:501" and get_argument(3) and "clip.wav" and "audio/wav") is not equal to 0:
        return 5
    set admitted to discord_agent_submit_media(journal and database and "message:create:101" and "900" and ["200"] and create_list() and "/private/tmp" and body)
    if not (archive_list_text(admitted and 0) equals "accepted") or else not (archive_list_text(admitted and 1) equals first):
        display archive_list_text(admitted and 0)
        return 6
    if agent_cancel_run(database and "discord-message:101") is not equal to 0:
        return 7
    set fresh to group_session_restart(database and device and "new-session-fixture" and group_id and "discord" and "200" and "300" and revision)
    set second to archive_list_text(fresh and 1)
    if not (archive_list_text(fresh and 0) equals "created") or else second equals first:
        return 8
    set replay to discord_agent_submit_media(journal and database and "message:create:101" and "900" and ["200"] and create_list() and "/private/tmp" and body)
    if not (archive_list_text(replay and 0) equals "already-accepted") or else not (archive_list_text(replay and 1) equals first):
        display archive_list_text(replay and 0)
        return 9
    # Staged, not yet admitted, media may be requeued into the new selection.
    # Separate immutable identities prevent adopting the old session's bytes.
    set old_path to concat(get_argument(3) and ".staged")
    set new_path to concat(get_argument(3) and ".reimported")
    if file_copy_verified(get_argument(3) and old_path and archive_list_text(digest and 1) and string_to_int(size) and 65536) is not equal to 0 or else file_copy_verified(get_argument(3) and new_path and archive_list_text(digest and 1) and string_to_int(size) and 65536) is not equal to 0:
        return 10
    if web_attachment_register(database and device and first and "discord-file:102:502" and old_path and "clip.wav" and "audio/wav") is not equal to 0:
        return 11
    set scoped to discord_attachment_identity(database and second and "102" and "502")
    if scoped equals "discord-file:102:502" or else not (scoped equals concat("discord-file:102:502:session:" and ep_sha256(second))):
        return 12
    set body2 to media_retry_body("102" and "502" and size)
    if not (archive_list_text(discord_steering_media_selection(database and second and body2) and 0) equals "steering-media-import-required"):
        return 13
    if web_attachment_register(database and device and second and scoped and new_path and "clip.wav" and "audio/wav") is not equal to 0 or else not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and body2) equals "recorded"):
        return 14
    set accepted to discord_agent_submit_media(journal and database and "message:create:102" and "900" and ["200"] and create_list() and "/private/tmp" and body2)
    if not (archive_list_text(accepted and 0) equals "accepted") or else not (archive_list_text(accepted and 1) equals second):
        display archive_list_text(accepted and 0)
        return 15
    if discord_steering_media_proof(database and second and "discord-message:102:user" and body2) is not equal to 1 or else discord_steering_media_proof(database and first and "discord-message:102:user" and body2) is not equal to 0:
        return 16
    set selected to discord_media_session(database and device and group_id and "200" and "300" and "discord-message:102")
    set third to group_session_restart(database and device and "another-new-fixture" and group_id and "discord" and "200" and "300" and revision)
    if not (archive_list_text(third and 0) equals "created") or else not (archive_list_text(selected and 1) equals second):
        return 17
    set again to discord_agent_submit_media(journal and database and "message:create:102" and "900" and ["200"] and create_list() and "/private/tmp" and body2)
    if not (archive_list_text(again and 0) equals "already-accepted") or else not (archive_list_text(again and 1) equals second):
        return 18
    if archive_verify(database and first) is not equal to 0 or else archive_verify(database and second) is not equal to 0:
        return 19
    display "PASS: accepted media retry remains in its original session across /new; interrupted staged imports receive a distinct session-bound identity; missing new import is denied; independent original receipts remain intact; repeated session changes do not redirect accepted runs. No live concurrency claim."
    return 0
