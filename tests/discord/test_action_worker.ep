import "../../app/discord/action_worker"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_action_worker_schema(journal) is not equal to 0:
        return 2
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set queued to discord_outbox_enqueue(journal and "reply:100" and "message:create:100" and "300" and "{\"content\":\"Fixture\"}")
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='reply:100';") is not equal to 0:
        return 3
    set identity to discord_message_action_bind(journal and "reply:100" and "trace" and "final:fixture")
    set body to concat("{\"id\":\"800\",\"type\":3,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"500\"}},\"message\":{\"id\":\"700\",\"author\":{\"id\":\"900\"}},\"data\":{\"component_type\":2,\"custom_id\":" and concat(provider_quote(identity) and "}}"))
    set recorded to discord_inbox_record(journal and "interaction:800" and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and "interaction:800") is not equal to 0:
        return 4
    set admins to create_list()
    if not (discord_action_worker_tick("" and "" and journal and 0 and "900" and admins and "" and "/nonexistent-echo-test-stop") equals "idle"):
        return 5
    if sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity='interaction:800';") is not equal to 0:
        return 6
    # No credential in this fixture: status response is expired. The original
    # non-admin denial must happen without opening a model archive or network.
    if not (discord_action_worker_tick("" and "" and journal and 0 and "900" and admins and "" and "/nonexistent-echo-test-stop") equals "denied"):
        return 7
    set row to history_collect_one(archive_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity='interaction:800';"))
    if not (archive_list_text(row and 1) equals "denied") or else not (archive_list_text(row and 2) equals "admin-required"):
        return 8
    if not (discord_action_worker_tick("" and "" and journal and 0 and "900" and admins and "" and "/nonexistent-echo-test-stop") equals "idle"):
        return 9
    set recorded to discord_inbox_record(journal and "interaction:801" and "INTERACTION_CREATE" and "{}")
    if discord_interaction_queue(journal and "interaction:801") is not equal to 0 or else sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity='interaction:801';") is not equal to 0:
        return 10
    if not (discord_action_worker_tick("" and "" and journal and 0 and "900" and admins and "" and "/nonexistent-echo-test-stop") equals "denied"):
        return 11
    set row to history_collect_one(archive_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity='interaction:801';"))
    if not (archive_list_text(row and 1) equals "denied") or else not (archive_list_text(row and 2) equals "invalid-component"):
        return 12
    display "PASS: malformed controls terminal, unacknowledged clicks cannot execute, non-admin trace denied before model/network, terminal denial not retried"
    return 0
