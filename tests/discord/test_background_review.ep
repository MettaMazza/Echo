import "../../app/discord/background_supervisor"
import "../../app/discord/typing"
import "../../app/discord/background_settle"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background recovery fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "original-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved") or else not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "original-worker" and 123 and "fixture") equals "recorded"):
        return 5
    set current to agent_run_read(database and "discord-message:100")
    set session to archive_list_text(current and 0)
    set request to "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"name\":\"fixture\",\"arguments\":{}}"
    if archive_append(database and session and "uncertain-request" and "tool_call" and request and "test") is not equal to 0 or else tool_ledger_queue(database and "discord-message:100" and "uncertain-call" and session and "uncertain-request") is not equal to 0 or else tool_ledger_claim(database and "discord-message:100" and "uncertain-call") is not equal to 0:
        return 6
    if sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='discord-message:100';") is not equal to 0 or else discord_typing_schema(journal) is not equal to 0:
        return 7
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to compaction_lock_acquire(database and "web-worker:discord-message:100" and library)
    if lock < 0 or else not (archive_list_text(discord_background_recover(journal and database and "discord-message:100") and 0) equals "worker-owned"):
        return 8
    if not (discord_typing_due(journal and database and ep_time_now_ms()) equals "300"):
        return 9
    if net_close(lock) is not equal to 0:
        return 10
    set recovered to discord_background_recover(journal and database and "discord-message:100")
    if not (archive_list_text(recovered and 0) equals "tool-outcome-needs-review"):
        display archive_list_text(recovered and 0)
        return 11
    set held to history_collect_one(archive_prepare(journal and "SELECT state,process,worker FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "recovery") or else not (archive_list_text(held and 2) equals "0") or else not (archive_list_text(held and 3) equals "original-worker") or else discord_background_active(journal and database) is not equal to 0 or else string_length(discord_typing_due(journal and database and ep_time_now_ms())) > 0:
        return 12
    set call to tool_ledger_read(database and "discord-message:100" and "uncertain-call")
    if not (archive_list_text(call and 1) equals "uncertain"):
        return 13
    set before to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_background_events;"))
    set arguments to create_list()
    set count to 0
    repeat while count < 12:
        set added to append_list(arguments and "fixture")
        set count to count + 1
    set count to 0
    repeat while count < 3:
        set count to count + 1
        if discord_background_orphans(journal and database and create_list()) is not equal to 0 or else not (archive_list_text(discord_background_resume_one(journal and database and arguments) and 0) equals "end"):
            return 14
    set after to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_background_events;"))
    if not (archive_list_text(before and 1) equals archive_list_text(after and 1)):
        return 15
    set closed to sql_close(database)
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if discord_worker_schema(journal) is not equal to 0 or else discord_background_orphans(journal and database and create_list()) is not equal to 0 or else string_length(discord_typing_due(journal and database and ep_time_now_ms())) > 0:
        return 16
    # A saved real result resolves the original call; it does not rerun it.
    if archive_append(database and session and "uncertain-request:result" and "tool_result" and "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"request_event\":\"uncertain-request\",\"result\":{\"status\":\"complete\"}}" and "test") is not equal to 0:
        return 17
    set recovered to discord_background_recover(journal and database and "discord-message:100")
    if not (archive_list_text(recovered and 0) equals "recovered") or else archive_list_text(recovered and 2) equals "original-worker":
        return 18
    set review to history_collect_one(archive_prepare(journal and "SELECT resolved FROM discord_background_reviews;"))
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='model_request';"))
    set call to tool_ledger_read(database and "discord-message:100" and "uncertain-call")
    if not (archive_list_text(review and 1) equals "1") or else not (archive_list_text(counts and 1) equals "0") or else not (archive_list_text(call and 1) equals "observed"):
        return 19
    display "PASS: native owner protected; orphan review durable across restart, no false typing/capacity/repeated recovery/replay; persisted result requires fresh worker token."
    set closed to ep_dlclose(library)
    return sql_close(database)
