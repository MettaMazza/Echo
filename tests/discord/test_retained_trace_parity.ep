import "../../app/discord/activity_pages"

# Read-only qualification against one explicitly selected archived run. No
# trace text is printed, sent to Discord or copied into public evidence.
define main returning Int:
    if get_argument_count() is not equal to 5 or else not file_exists(get_argument(1)) or else not file_exists(get_argument(2)):
        return 1
    set journal to sql_open(get_argument(1))
    set database to sql_open(get_argument(2))
    if journal equals 0 or else database equals 0 or else sql_execute(journal and "PRAGMA query_only=ON;") is not equal to 0 or else sql_execute(database and "PRAGMA query_only=ON;") is not equal to 0:
        return 2
    set cursor to 0
    set reasoning to 0
    set tools to 0
    repeat while 1 equals 1:
        set browser to web_run_trace(database and get_argument(4) and cursor and 32)
        set discord to discord_run_trace(journal and database and get_argument(3) and get_argument(4) and cursor and 32)
        if not (browser equals discord):
            return 3
        set tokens to provider_json_tokens(discord)
        if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found"):
            return 4
        set rendered to discord_activity_render(discord and 1)
        for each entry in provider_items(tokens and provider_member(tokens and 0 and "entries")):
            set text to provider_value(tokens and provider_member(tokens and entry and "text"))
            if string_length(text) > 0 and string_index_of(rendered and text) < 0:
                return 5
            set kind to provider_value(tokens and provider_member(tokens and entry and "kind"))
            if kind equals "model_reasoning":
                set reasoning to reasoning + 1
            if kind equals "tool_call" or else kind equals "tool_result":
                set tools to tools + 1
        set next to http_decimal(provider_value(tokens and provider_member(tokens and 0 and "after")))
        if next < cursor:
            return 6
        if next equals cursor:
            break
        set cursor to next
    if reasoning equals 0:
        return 7
    display concat("PASS: original browser/Discord trace pages identical; full rendering retains every entry; reasoning fragments=" and concat(int_to_string(reasoning) and concat(", tool entries=" and int_to_string(tools))))
    set closed to sql_close(journal)
    return sql_close(database)
