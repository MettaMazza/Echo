import "../../app/discord/command_execution"

define autooff_fixture with journal as Int and id as Str and actor as Str returning Str:
    set body to concat("{\"id\":" and concat(provider_quote(id) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"data\":{\"type\":1,\"id\":\"801\",\"name\":\"autooff\"}}"))))
    set identity to concat("interaction:" and id)
    set saved to discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and identity) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [identity]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_autooff_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [identity,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0:
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"801\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"autooff\"}" and "900" and "200") equals "registered"):
        return 3
    set admins to ["400","401"]
    set guilds to ["200"]
    set guest_device to discord_agent_principal(database and "402" and admins)
    set guest_start to channel_silo_submit(database and guest_device and "discord" and "200" and "300" and "guest-auto" and "/auto fixture" and create_list())
    if not (archive_list_text(guest_start and 0) equals "autonomy-admin-required") or else agent_run_read(database and "guest-auto") is not equal to 0:
        return 12
    set alice to discord_agent_principal(database and "400" and admins)
    set bob to discord_agent_principal(database and "401" and admins)
    set first to channel_silo_submit(database and alice and "discord" and "200" and "300" and "alice-auto" and "/auto fixture" and create_list())
    set second to channel_silo_submit(database and bob and "discord" and "200" and "300" and "bob-auto" and "/auto fixture" and create_list())
    if not (archive_list_text(first and 0) equals "accepted") or else not (archive_list_text(second and 0) equals "accepted") or else autonomy_enabled(database and "alice-auto") equals 0 or else autonomy_enabled(database and "bob-auto") equals 0:
        return 4
    set body to autooff_fixture(journal and "701" and "400")
    set guest to autooff_fixture(journal and "702" and "402")
    if not (discord_command_autooff_apply(journal and database and "interaction:702" and guest and "900" and guilds and admins) equals "admin-required"):
        return 5
    if not (discord_command_autooff_apply(journal and database and "interaction:701" and guest and "900" and guilds and admins) equals "command-not-acknowledged"):
        return 6
    if not (discord_command_autooff_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals "autonomy-stopped") or else autonomy_enabled(database and "alice-auto") is not equal to 0 or else autonomy_enabled(database and "bob-auto") is not equal to 1:
        return 7
    set cancellations to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_cancel_requests WHERE run='alice-auto';"))
    if not (archive_list_text(cancellations and 1) equals "1"):
        return 8
    set newer to channel_silo_submit(database and alice and "discord" and "200" and "301" and "alice-newer" and "/auto later" and create_list())
    if not (archive_list_text(newer and 0) equals "accepted") or else autonomy_enabled(database and "alice-newer") equals 0:
        return 9
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_command_autooff_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals "autonomy-stopped") or else autonomy_enabled(database and "alice-newer") equals 0:
        return 10
    if not (discord_command_autooff_apply(journal and database and "interaction:701" and body and "900" and guilds and create_list()) equals "admin-required"):
        return 11
    display "PASS: admin-only exact acknowledged stop, same-principal scope, cancellation requested, other admin unaffected, restart replay does not stop newer autonomy, current admin removal enforced"
    return 0
