import "../../app/discord/voice_connection_io"

define fixture_io with library as Int and path as Str returning List:
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and ep_dlopen(path))
    set added to append_list(socket and 1)
    set paths to create_list()
    set paths to ["unused","unused","unused"]
    return discord_voice_io_new(discord_voice_transport_new(socket and paths and 1234 and "5678" and 1) and 100)

define fixture_queue with library as Int and body as Str returning Int:
    return ep_dlcall3(ep_dlsym(library and "fixture_receive") and str_to_ptr(body) and string_length(body) and 1)

define refresh_fixture with library as Int and path as Str returning List:
    set state to fixture_io(library and path)
    set queued to fixture_queue(library and "{\"op\":8,\"d\":{\"heartbeat_interval\":5000}}")
    set hello to discord_voice_io_tick(state and 100 and 10000 and 1 and 1 and 0)
    set handshake to get_list(get_list(state and 0) and 0)
    # A completed handshake isolates refresh expiry from initial handshake expiry.
    set changed to set_list(handshake and 0 and 4)
    return state

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 90
    set library to ep_dlopen(get_argument(1))
    set state to refresh_fixture(library and get_argument(1))
    set binary to research_native_words(1)
    set written to poke_byte(get_list_data_ptr(binary) and 0 and 65)
    set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and get_list_data_ptr(binary) and 3 and 2)
    set result to discord_voice_io_refresh_tick(state and 101 and 10001 and 1)
    if not (archive_list_text(result and 0) equals "pending") or else length_list(get_list(state and 5)) is not equal to 1 or else get_list(state and 6) is not equal to 3 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 1
    set queued to fixture_queue(library and "{\"op\":6,\"seq\":99,\"d\":10001}")
    set result to discord_voice_io_refresh_tick(state and 200 and 10100 and 1)
    set heart to get_list(get_list(get_list(state and 0) and 0) and 1)
    if get_list(heart and 2) is not equal to -1 or else get_list(heart and 5) is not equal to -1:
        return 2
    set result to discord_voice_io_refresh_tick(state and 5101 and 15001 and 1)
    set queued to fixture_queue(library and "{\"op\":6,\"d\":15001}")
    set result to discord_voice_io_refresh_tick(state and 5200 and 15100 and 1)
    if get_list(state and 4) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 2:
        return 3
    set result to discord_voice_io_tick(state and 5201 and 15101 and 1 and 1 and 0)
    set blob to get_list(result and 1)
    if not (archive_list_text(result and 0) equals "binary-mls") or else peek_byte(get_list(blob and 0) and 0) is not equal to 65 or else get_list(state and 6) is not equal to 0 or else get_list(state and 7) is not equal to -1:
        return 4
    set released to discord_voice_blob_release(blob)
    set closed to discord_voice_io_close(state and "fixture-stop")
    # An explicit denial releases deferred data without another heartbeat.
    set state to refresh_fixture(library and get_argument(1))
    set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and get_list_data_ptr(binary) and 3 and 2)
    set result to discord_voice_io_refresh_tick(state and 101 and 10001 and 1)
    set retained to get_list(get_list(get_list(state and 5) and 0) and 1)
    set result to discord_voice_io_tick(state and 5101 and 15001 and 1 and 0 and 0)
    if not (archive_list_text(result and 0) equals "voice-authorization-revoked") or else get_list(retained and 0) is not equal to 0 or else length_list(get_list(state and 5)) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 5
    set closed to discord_voice_io_close(state and "repeat-close")
    # A continuously pending proof expires even when every heartbeat is ACKed.
    set state to refresh_fixture(library and get_argument(1))
    set now to 101
    repeat while now < 30101:
        set result to discord_voice_io_refresh_tick(state and now and now + 10000 and 1)
        set queued to fixture_queue(library and "{\"op\":6,\"d\":0}")
        set result to discord_voice_io_refresh_tick(state and now + 1 and now + 10001 and 1)
        if get_list(state and 4) is not equal to 0:
            return 6
        set now to now + 5000
    set result to discord_voice_io_refresh_tick(state and 30101 and 40101 and 1)
    if not (archive_list_text(result and 0) equals "voice-proof-refresh-deadline") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 6:
        return 7
    # Buffer count and bytes are independent limits; neither processes MLS.
    set state to refresh_fixture(library and get_argument(1))
    set index to 0
    repeat while index < 65:
        set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and get_list_data_ptr(binary) and 3 and 2)
        set result to discord_voice_io_refresh_tick(state and 101 + index and 10001 + index and 1)
        set index to index + 1
    if not (archive_list_text(result and 0) equals "voice-proof-buffer-limit") or else length_list(get_list(state and 5)) is not equal to 0 or else get_list(state and 6) is not equal to 0:
        return 8
    set state to refresh_fixture(library and get_argument(1))
    set large to alloc_bytes(65536)
    set index to 0
    repeat while index < 17:
        set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and large and 65536 and 2)
        set result to discord_voice_io_refresh_tick(state and 101 + index and 10001 + index and 1)
        set index to index + 1
    free_bytes(large)
    if not (archive_list_text(result and 0) equals "voice-proof-buffer-limit") or else get_list(state and 6) is not equal to 0:
        return 9
    set state to refresh_fixture(library and get_argument(1))
    set result to discord_voice_io_refresh_tick(state and 101 and 10001 and 1)
    set result to discord_voice_io_refresh_tick(state and 5101 and 15001 and 1)
    if not (archive_list_text(result and 0) equals "reconnect-missing-ack"):
        return 10
    set state to refresh_fixture(library and get_argument(1))
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 1)
    set result to discord_voice_io_refresh_tick(state and 101 and 10001 and 1)
    if not (archive_list_text(result and 0) equals "voice-heartbeat-write-failed"):
        return 11
    # HELLO can arrive during refresh; its sequence must not skip deferred data.
    set state to fixture_io(library and get_argument(1))
    set queued to fixture_queue(library and "{\"op\":8,\"seq\":9,\"d\":{\"heartbeat_interval\":5000}}")
    set result to discord_voice_io_refresh_tick(state and 100 and 10000 and 2)
    if not (archive_list_text(result and 0) equals "stale-or-closed-voice-socket") or else get_list(state and 7) is not equal to -1:
        return 12
    set result to discord_voice_io_refresh_tick(state and 100 and 10000 and 1)
    if not (archive_list_text(result and 0) equals "heartbeat-ready") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0:
        return 13
    set queued to fixture_queue(library and "{\"op\":6,\"d\":10001}")
    set result to discord_voice_io_refresh_tick(state and 101 and 10001 and 1)
    set queued to fixture_queue(library and "{\"op\":8,\"d\":{\"heartbeat_interval\":5000}}")
    set result to discord_voice_io_refresh_tick(state and 102 and 10002 and 1)
    if not (archive_list_text(result and 0) equals "invalid-voice-hello-order") or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 14
    # Deferred JSON and binary messages preserve wire order across authorization.
    set state to refresh_fixture(library and get_argument(1))
    set queued to fixture_queue(library and "{\"op\":13,\"d\":{\"user_id\":\"900\"}}")
    set result to discord_voice_io_refresh_tick(state and 101 and 10001 and 1)
    set queued to ep_dlcall3(ep_dlsym(library and "fixture_receive") and get_list_data_ptr(binary) and 3 and 2)
    set result to discord_voice_io_refresh_tick(state and 102 and 10002 and 1)
    if length_list(get_list(state and 5)) is not equal to 2:
        return 15
    set result to discord_voice_io_tick(state and 103 and 10003 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "client-disconnect") or else length_list(get_list(state and 5)) is not equal to 1:
        display archive_list_text(result and 0)
        return 16
    set result to discord_voice_io_tick(state and 104 and 10004 and 1 and 1 and 0)
    if not (archive_list_text(result and 0) equals "binary-mls") or else length_list(get_list(state and 5)) is not equal to 0:
        return 17
    set released to discord_voice_blob_release(get_list(result and 1))
    set result to discord_voice_io_refresh_tick(state and 103 and 10003 and 1)
    if not (archive_list_text(result and 0) equals "voice-clock-anomaly"):
        return 18
    set closed to ep_dlclose(library)
    display "PASS: pending proofs maintain heartbeats, defer MLS without sequence acknowledgement, resume owned bytes only after authorization, bound time/count/bytes, and close on denial, missing ACK or partial write."
    return 0
