import "../../app/discord/expression_view"

define main returning Int:
    set emoji to "{\"id\":\"300\",\"name\":\"fixture\",\"roles\":[],\"managed\":false,\"user\":{\"id\":\"900\",\"email\":\"private\"},\"unknown\":\"private\"}"
    set view to discord_expression_view(emoji and "emoji" and "100" and "300")
    if string_length(view) equals 0 or else string_contains(view and "private") > 0 or else string_contains(view and "user") > 0:
        return 1
    if string_length(discord_expression_view(emoji and "emoji" and "100" and "301")) > 0:
        return 2
    set sticker to "{\"id\":\"400\",\"guild_id\":\"100\",\"type\":2,\"name\":\"fixture\",\"description\":null,\"tags\":\"wave\",\"format_type\":1,\"user\":{\"id\":\"900\",\"email\":\"private\"}}"
    set view to discord_expression_view(sticker and "sticker" and "100" and "400")
    if string_length(view) equals 0 or else string_contains(view and "private") > 0:
        return 3
    if string_length(discord_expression_view(sticker and "sticker" and "101" and "400")) > 0:
        return 4
    if string_length(discord_expression_view(sticker and "application" and "100" and "400")) > 0:
        return 5
    display "PASS: expression resource binding and public projection without creator profiles."
    return 0
