import "../../app/discord/access"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set journal to discord_store_open(get_argument(2) and "900")
    set ready to discord_delivery_schema(journal)
    set response to discord_access_get(get_argument(1) and "fixture-token-not-a-real-credential" and journal and get_argument(3) and "/channels/300" and "GET:channel" and "300")
    if not (archive_list_text(response and 0) equals "observed"):
        display archive_list_text(response and 0)
        return 2
    set filename to archive_list_text(response and 3)
    if string_index_of(filename and "receipts/") is not equal to 0 or else not (ptr_to_str(read_file(concat(get_argument(3) and concat("/" and filename)))) equals archive_list_text(response and 1)):
        return 3
    set inserted to discord_inbox_record(journal and "source" and "MESSAGE_CREATE" and "{}")
    set queued to discord_outbox_enqueue(journal and "reply" and "source" and "300" and "{\"content\":\"fixture reply\"}")
    set sent to discord_delivery_send(get_argument(1) and "fixture-token-not-a-real-credential" and journal and "reply" and get_argument(3))
    if not (sent equals "recorded"):
        display sent
        return 4
    set row to history_collect_one(archive_prepare(journal and "SELECT state,message FROM discord_outbox WHERE identity='reply';"))
    if not (archive_list_text(row and 1) equals "sent" and archive_list_text(row and 2) equals "700"):
        return 5
    set merged to discord_delivery_quiet_body(journal and "{\"content\":\"keep me\",\"flags\":4,\"nonce\":\"123\",\"allowed_mentions\":{\"parse\":[]}}")
    set fields to provider_json_tokens(merged)
    if not (provider_value(fields and provider_member(fields and 0 and "flags")) equals "4100") or else not (provider_value(fields and provider_member(fields and 0 and "content")) equals "keep me") or else not (provider_value(fields and provider_member(fields and 0 and "nonce")) equals "123"):
        return 6
    if string_length(discord_delivery_quiet_body(journal and "{\"flags\":\"invalid\"}")) > 0:
        return 7
    set fixture to ep_dlopen(get_argument(1))
    if ep_dlcall0(ep_dlsym(fixture and "fixture_quiet_seen")) is not equal to 0:
        return 8
    set queued to discord_outbox_enqueue(journal and "quiet-reply" and "source" and "300" and "{\"content\":\"quiet backlog\",\"allowed_mentions\":{\"parse\":[]}}")
    set sent to discord_delivery_send_policy(get_argument(1) and "fixture-token-not-a-real-credential" and journal and "quiet-reply" and get_argument(3) and 0 and 0 and "" and "" and 1)
    if not (sent equals "recorded") or else ep_dlcall0(ep_dlsym(fixture and "fixture_quiet_seen")) is not equal to 1:
        return 9
    set receipt to history_collect_one(archive_prepare(journal and "SELECT count(*) FROM discord_delivery_events WHERE identity='quiet-reply' AND detail LIKE 'notification-policy:suppressed; request-sha256:%';"))
    if not (archive_list_text(receipt and 1) equals "1"):
        return 10
    set closed to ep_dlclose(fixture)
    set closed to sql_close(journal)
    display "PASS: GET, normal/quiet POST, preserved flags/content/nonce and durable quiet-policy receipt"
    return 0
