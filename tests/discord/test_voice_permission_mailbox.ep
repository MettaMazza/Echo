import "../../app/discord/voice_permission_mailbox"

define fixture_mailbox_reply with serial as Int returning List:
    set proof to create_list()
    set added to append_list(proof and "fixture-proof")
    set reply to create_list()
    set added to append_list(reply and serial)
    set added to append_list(reply and proof)
    return reply

define main returning Int:
    set requests to channel
    set replies to channel
    set completed to channel
    set state to discord_voice_permission_mailbox_new(requests and replies and completed)
    if not (discord_voice_permission_mailbox_poll(state) equals "pending") or else discord_voice_permission_mailbox_refresh(state) is not equal to 1 or else discord_voice_permission_mailbox_refresh(state) is not equal to 0:
        return 1
    set request to receive from requests
    if request is not equal to 1:
        return 2
    set reply to fixture_mailbox_reply(1)
    send reply to replies
    if not (discord_voice_permission_mailbox_poll(state) equals "permission-proof-ready") or else discord_voice_permission_mailbox_proof(state) equals 0:
        return 3
    if discord_voice_permission_mailbox_refresh(state) is not equal to 2:
        return 4
    set request to receive from requests
    set reply to fixture_mailbox_reply(1)
    send reply to replies
    if not (discord_voice_permission_mailbox_poll(state) equals "permission-observer-failed") or else discord_voice_permission_mailbox_proof(state) is not equal to 0:
        return 5
    set request to receive from requests
    if request is not equal to 0:
        return 6
    send 0 to completed
    if not (discord_voice_permission_mailbox_poll(state) equals "permission-observer-failed"):
        return 7
    set state to discord_voice_permission_mailbox_new(requests and replies and completed)
    set request to discord_voice_permission_mailbox_refresh(state)
    set request to receive from requests
    set stopped to discord_voice_permission_mailbox_stop(state)
    set request to receive from requests
    set reply to fixture_mailbox_reply(1)
    send reply to replies
    if not (discord_voice_permission_mailbox_poll(state) equals "permission-observer-stopping") or else discord_voice_permission_mailbox_proof(state) is not equal to 0 or else discord_voice_permission_mailbox_refresh(state) is not equal to 0:
        return 8
    send 0 to completed
    if not (discord_voice_permission_mailbox_poll(state) equals "permission-observer-stopped"):
        return 9
    set state to discord_voice_permission_mailbox_new(requests and replies and completed)
    set request to discord_voice_permission_mailbox_refresh(state)
    set request to receive from requests
    set reply to fixture_mailbox_reply(1)
    send reply to replies
    send 1 to completed
    if not (discord_voice_permission_mailbox_poll(state) equals "permission-observer-failed") or else discord_voice_permission_mailbox_proof(state) is not equal to 0:
        return 10
    display "PASS: one refresh in flight, nonblocking proof delivery, stale reply rejection, stop discards late proof and observer completion overrides cached replies."
    return 0
