import "../../app/discord/voice_permission_observer"
import "../../app/discord/voice_audio_proof"
import "../../app/discord/voice_audio_jobs"
import "../../app/discord/voice_authorized_worker"
import "../../app/discord/worker_store"
import "../../app/discord/gateway_journal"
import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else web_cancel_schema(database) is not equal to 0:
        return 6
    if not (delegation_schema(database) equals "applied"):
        return 26
    set admin_ids to ["500"]
    set admin_device to discord_agent_principal(database and "500" and admin_ids)
    set journal to discord_store_open(get_argument(2) and "900")
    set source_body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Join authorised voice\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source_body) equals "recorded"):
        return 12
    if discord_worker_schema(journal) is not equal to 0:
        return 21
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:100"):
        return 22
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and admin_ids)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 12
    set listener to local_socket_listen(0)
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"voice-call\",\"function\":{\"name\":\"discord_voice\",\"arguments\":\"{}\"}},{\"index\":1,\"id\":\"play-call\",\"function\":{\"name\":\"discord_voice\",\"arguments\":\"{\\\"operation\\\": \\\"play\\\", \\\"intent\\\": \\\"voice-intent\\\", \\\"attachment\\\": \\\"speech\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "discord-message:100" and "voice-request" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0 or else discord_voice_intent_schema(journal) is not equal to 0:
        return 16
    set requested to discord_voice_intent_request(journal and "voice-intent" and "200" and "600" and "500" and "discord-message:100" and "voice-call" and ep_sha256("fixture-access"))
    if not (requested equals "queued"):
        return 17
    set allowed to discord_voice_request_guard(journal and database and "voice-intent" and "900" and ["200"] and admin_ids and "/absent-fixture-stop")
    if not (archive_list_text(allowed and 0) equals "allowed"):
        display archive_list_text(allowed and 0)
        return 18
    if discord_gateway_schema(journal) is not equal to 0:
        return 27
    set bound to discord_gateway_bind(journal and "generation" and "session")
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    if discord_voice_audio_jobs_schema(journal) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 40
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET state='sent' WHERE identity='voice-intent';")
    set row to history_collect_one(archive_prepare(database and "SELECT session FROM echo_runs WHERE run='discord-message:100';"))
    set session to archive_list_text(row and 1)
    set digest to file_digest(get_argument(3) and 65536)
    set pcm_path to concat(get_argument(4) and "/pcm.wav")
    if file_copy_verified(get_argument(3) and pcm_path and archive_list_text(digest and 1) and get_list(digest and 2) and 65536) is not equal to 0:
        return 41
    if web_attachment_register(database and "discord:500" and session and "speech" and get_argument(3) and "speech.wav" and "audio/wav") is not equal to 0 or else web_attachment_register_decoded_import(database and "discord:500" and session and "speech:voice-pcm-wav" and pcm_path and "speech PCM.wav" and "speech") is not equal to 0:
        return 42
    set binding to discord_voice_audio_source_prepare(database and "discord-message:100" and "500" and "speech" and get_argument(4))
    if not (archive_list_text(binding and 0) equals "voice-audio-ready"):
        return 43
    set request to history_collect_one(archive_prepare(database and "SELECT request_event FROM echo_tool_calls WHERE run='discord-message:100' AND call_id='play-call';"))
    if not (discord_voice_audio_job_enqueue(journal and "audio" and "voice-intent" and "discord-message:100" and "play-call" and "500" and binding and archive_list_text(request and 1)) equals "queued"):
        return 44
    set claim to discord_voice_audio_job_claim(journal and "voice-intent")
    set guarded to discord_voice_audio_job_guard(journal and database and "voice-intent" and claim and "900" and ["200"] and admin_ids and "/absent-fixture-stop")
    if not (archive_list_text(guarded and 0) equals "voice-audio-native-current"):
        display archive_list_text(guarded and 0)
        return 45
    set fixture to ep_dlopen(get_argument(5))
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(2)))
    set proof to discord_voice_audio_proof(get_argument(5) and "fixture-token-no-network-123456" and journal and database and "voice-intent" and claim and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    if not (archive_list_text(proof and 0) equals "voice-audio-proof") or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 12:
        display archive_list_text(proof and 0)
        return 50
    set config to create_list()
    set added to append_list(config and get_argument(5))
    set added to append_list(config and "fixture-token-no-network-123456")
    set added to append_list(config and get_argument(2))
    set added to append_list(config and get_argument(1))
    set added to append_list(config and "voice-intent")
    set added to append_list(config and "900")
    set scope to create_list()
    set added to append_list(scope and "200")
    set added to append_list(config and scope)
    set added to append_list(config and admin_ids)
    set added to append_list(config and get_argument(4))
    set added to append_list(config and "/absent-fixture-stop")
    set added to append_list(config and 1)
    set added to append_list(config and claim)
    set requests to channel
    set replies to channel
    set finished to channel
    spawn discord_voice_permission_observer(config and requests and replies and finished)
    send 1 to requests
    set waits to create_list()
    set added to append_list(waits and replies)
    if select(waits and 5000) < 0:
        return 53
    set reply to receive from replies
    set observed_proof to get_list(reply and 1)
    if get_list(reply and 0) is not equal to 1 or else not (discord_voice_audio_proof_check(journal and database and "voice-intent" and claim and observed_proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop") equals "allowed"):
        return 54
    send 0 to requests
    set waits to create_list()
    set added to append_list(waits and finished)
    if select(waits and 5000) < 0:
        return 55
    set joined to receive from finished
    if joined is not equal to 0 or else ep_dlcall0(ep_dlsym(fixture and "fixture_calls")) is not equal to 24:
        return 56
    set changed to set_list(proof and 2 and "another-attempt")
    if not (discord_voice_audio_proof_check(journal and database and "voice-intent" and claim and proof and "900" and ["200"] and admin_ids and "/absent-fixture-stop") equals "voice-audio-proof-binding-denied"):
        return 51
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and 2 and str_to_ptr(get_argument(2)))
    set proof to discord_voice_audio_proof(get_argument(5) and "fixture-token-no-network-123456" and journal and database and "voice-intent" and claim and "900" and ["200"] and admin_ids and get_argument(4) and "/absent-fixture-stop")
    if not (archive_list_text(proof and 0) equals "voice-authorization-refresh-required"):
        return 52
    set changed to set_list(claim and 2 and "forged-attempt")
    if not (archive_list_text(discord_voice_audio_job_guard(journal and database and "voice-intent" and claim and "900" and ["200"] and admin_ids and "/absent-fixture-stop") and 0) equals "voice-audio-claim-denied"):
        return 46
    set row to history_collect_one(archive_prepare(journal and "SELECT attempt FROM discord_voice_audio_jobs WHERE identity='audio';"))
    set changed to set_list(claim and 2 and archive_list_text(row and 1))
    set changed to sql_execute(database and "UPDATE echo_tool_calls SET state='uncertain' WHERE call_id='play-call';")
    if not (archive_list_text(discord_voice_audio_job_guard(journal and database and "voice-intent" and claim and "900" and ["200"] and admin_ids and "/absent-fixture-stop") and 0) equals "voice-audio-call-denied"):
        return 47
    set changed to sql_execute(database and "UPDATE echo_tool_calls SET state='queued' WHERE call_id='play-call';")
    if archive_append(database and session and "exclude-audio" and "attachment_visibility" and "{\"attachment\":\"speech\",\"state\":\"excluded\"}" and "fixture") is not equal to 0:
        return 48
    if archive_list_text(discord_voice_audio_job_guard(journal and database and "voice-intent" and claim and "900" and ["200"] and admin_ids and "/absent-fixture-stop") and 0) equals "voice-audio-native-current":
        return 49
    display "PASS: separate SQLite observer returns exact job-bound playback proof and stops cleanly; playback requires its own admitted call, exact claimed artifact and current selection; forged attempts and uncertain playback calls are denied independently of join authority."
    return 0
