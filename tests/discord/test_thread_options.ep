import "../../app/discord/thread_options"
import "../../app/discord/thread_scope"

define main returning Int:
    set options to discord_thread_options("{\"operation\":\"create\",\"name\":\"fixture\",\"private\":true,\"invitable\":false,\"reason\":\"test\"}")
    if not (archive_list_text(options and 0) equals "valid") or else string_contains(archive_list_text(options and 5) and "\"type\":12") equals 0:
        return 1
    set options to discord_thread_options("{\"operation\":\"create\",\"name\":\"fixture\",\"private\":true,\"message\":\"100\",\"reason\":\"test\"}")
    if archive_list_text(options and 0) equals "valid":
        return 2
    set options to discord_thread_options("{\"operation\":\"create\",\"name\":\"fixture\",\"archived\":true,\"reason\":\"test\"}")
    if archive_list_text(options and 0) equals "valid":
        return 3
    set options to discord_thread_options("{\"operation\":\"edit\",\"thread\":\"100\",\"archived\":false,\"reason\":\"test\"}")
    if archive_list_text(options and 0) equals "valid":
        return 4
    set options to discord_thread_options("{\"operation\":\"members\",\"thread\":\"100\",\"limit\":1,\"after\":\"200\"}")
    if not (archive_list_text(options and 0) equals "valid") or else not (archive_list_text(options and 10) equals "1"):
        return 5
    set options to discord_thread_options("{\"operation\":\"members\",\"thread\":\"100\",\"limit\":101}")
    if archive_list_text(options and 0) equals "valid":
        return 6
    set options to discord_thread_options("{\"operation\":\"join\",\"thread\":\"100\",\"member\":\"200\",\"reason\":\"test\"}")
    if archive_list_text(options and 0) equals "valid":
        return 7
    set options to discord_thread_options("{\"operation\":\"create\",\"name\":\"fixture\",\"auto_archive_minutes\":7,\"reason\":\"test\"}")
    if archive_list_text(options and 0) equals "valid":
        return 8
    set origin to "{\"id\":\"100\",\"guild_id\":\"200\",\"type\":0}"
    set public_thread to "{\"id\":\"300\",\"guild_id\":\"200\",\"parent_id\":\"100\",\"type\":11,\"name\":\"public fixture\"}"
    set private_thread to "{\"id\":\"301\",\"guild_id\":\"200\",\"parent_id\":\"100\",\"type\":12,\"name\":\"private canary\"}"
    if not (discord_thread_scope(origin and public_thread and "200" and "100" and "300") equals "public-parent-audience"):
        return 9
    if not (discord_thread_scope(origin and private_thread and "200" and "100" and "301") equals "private-metadata-withheld"):
        return 10
    if not (discord_thread_scope(private_thread and private_thread and "200" and "301" and "301") equals "private-source"):
        return 11
    if discord_thread_scope(origin and public_thread and "201" and "100" and "300") equals "public-parent-audience":
        return 12
    set other to "{\"id\":\"300\",\"guild_id\":\"200\",\"parent_id\":\"101\",\"type\":11}"
    if not (discord_thread_scope(origin and other and "200" and "100" and "300") equals "thread-parent-outside-origin"):
        return 13
    set view to discord_thread_view(private_thread and "private-metadata-withheld")
    if string_contains(view and "private canary") is not equal to 0 or else string_contains(view and "observed_sha256") equals 0:
        return 14
    set page to discord_thread_member_page("[{\"id\":\"300\",\"user_id\":\"400\",\"member\":{\"private_canary\":\"hidden\"}}]" and "300")
    if not (page equals "[{\"user_id\":\"400\"}]"):
        return 15
    if string_length(discord_thread_member_page("[{\"id\":\"301\",\"user_id\":\"400\"}]" and "300")) > 0:
        return 16
    display "PASS: thread options, explicit lifecycle, parent/guild identity, private projection and minimal member pages"
    return 0
