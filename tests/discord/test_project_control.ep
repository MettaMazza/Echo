import "../../app/discord/project_control"
import "../../app/discord/agent_bridge"
import "../../app/security/group_session_selection"

define project_control_query with operation as Str and session as Str and identity as Str and project as Str and expected as Str and manifest as Str returning Str:
    set output to concat("{\"operation\":" and provider_quote(operation))
    set fields to [["session",session],["identity",identity],["project",project],["expected_revision",expected]]
    for each pair in fields:
        set name to provider_quote(archive_list_text(pair and 0))
        set value to provider_quote(archive_list_text(pair and 1))
        set output to concat(output and concat("," and concat(name and concat(":" and value))))
    return concat(output and concat(",\"manifest\":" and concat(manifest and "}")))

define project_control_status with result as Str returning Str:
    set tokens to provider_json_tokens(result)
    return provider_value(tokens and provider_member(tokens and 0 and "status"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    set admins to create_list()
    set device to discord_agent_principal(database and "400" and admins)
    set other_device to discord_agent_principal(database and "401" and admins)
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "first" and "Project fixture" and create_list())
    set foreign to channel_silo_submit(database and other_device and "discord" and "200" and "300" and "foreign" and "Other user" and create_list())
    set elsewhere to channel_silo_submit(database and device and "discord" and "200" and "301" and "elsewhere" and "Other channel" and create_list())
    if not (archive_list_text(first and 0) equals "accepted") or else not (archive_list_text(foreign and 0) equals "accepted") or else not (archive_list_text(elsewhere and 0) equals "accepted"):
        return 3
    set session to archive_list_text(first and 1)
    set manifest to "{\"name\":\"Café garden\",\"instructions\":\"Preserve the violet marker.\",\"tasks\":[{\"id\":\"one\",\"title\":\"Read original\",\"status\":\"todo\"}],\"files\":[]}"
    set query to project_control_query("create" and session and "create-1" and "" and "" and manifest)
    set result to discord_project_request(database and device and "200" and "300" and query)
    if not (project_control_status(result) equals "recorded"):
        display result
        return 4
    set fields to provider_json_tokens(result)
    set project to provider_value(fields and provider_member(fields and 0 and "project"))
    set revision to provider_value(fields and provider_member(fields and 0 and "revision"))
    if not (project_control_status(discord_project_request(database and device and "200" and "300" and query)) equals "already-recorded"):
        return 5
    for each altered in [string_replace(query and "\"operation\":\"create\"" and "\"operation\":\"create\",\"scope\":\"private:owner\""),string_replace(query and "\"operation\":\"create\"" and "\"operation\":\"create\",\"operation\":\"list\"")]:
        if not (project_control_status(discord_project_request(database and device and "200" and "300" and ptr_to_str(altered))) equals "invalid-arguments"):
            return 6
    if not (project_control_status(discord_project_request(database and other_device and "200" and "300" and query)) equals "not-authorized") or else not (project_control_status(discord_project_request(database and device and "200" and "301" and query)) equals "not-authorized") or else not (project_control_status(discord_project_request(database and device and "201" and "300" and query)) equals "not-authorized"):
        return 7
    set hidden to discord_project_request(database and other_device and "200" and "300" and project_control_query("read" and archive_list_text(foreign and 1) and "" and project and "" and "{}"))
    if not (project_control_status(hidden) equals "not-authorized"):
        return 8
    set hidden to discord_project_request(database and device and "200" and "301" and project_control_query("list" and archive_list_text(elsewhere and 1) and "" and "" and "" and "{}"))
    if not (project_control_status(hidden) equals "found") or else string_contains(hidden and project) is not equal to 0:
        return 9
    set group_id to channel_silo_identity("discord" and "200" and "300" and principal_for_device(database and device))
    set next to group_session_restart(database and device and "new-project-session" and group_id and "discord" and "200" and "300" and 1)
    if not (archive_list_text(next and 0) equals "created"):
        return 10
    set next_session to archive_list_text(next and 1)
    set selected to project_control_query("select" and next_session and "select-1" and project and "" and "{}")
    if not (project_control_status(discord_project_request(database and device and "200" and "300" and selected)) equals "recorded"):
        return 11
    set followup to channel_silo_submit(database and device and "discord" and "200" and "300" and "followup" and "Use selected project" and create_list())
    if not (archive_list_text(followup and 1) equals next_session) or else string_contains(project_context(database and "followup") and "violet marker") equals 0:
        return 12
    set changed to string_replace(manifest and "\"status\":\"todo\"" and "\"status\":\"done\"")
    set update to project_control_query("update" and next_session and "update-1" and project and revision and changed)
    if not (project_control_status(discord_project_request(database and device and "200" and "300" and update)) equals "recorded") or else not (project_control_status(discord_project_request(database and device and "200" and "300" and update)) equals "already-recorded"):
        return 13
    set stale to project_control_query("update" and next_session and "stale-1" and project and revision and manifest)
    if not (project_control_status(discord_project_request(database and device and "200" and "300" and stale)) equals "revision-conflict"):
        return 14
    set private_session to web_submit_owned(database and device and "private-run" and "" and "Private fixture")
    if not (archive_list_text(private_session and 0) equals "accepted") or else not (project_control_status(discord_project_request(database and device and "200" and "300" and project_control_query("list" and archive_list_text(private_session and 1) and "" and "" and "" and "{}"))) equals "not-authorized"):
        return 15
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if archive_verify(database and session) is not equal to 0 or else archive_verify(database and next_session) is not equal to 0:
        return 16
    set readback to discord_project_request(database and device and "200" and "300" and project_control_query("read" and next_session and "" and project and "" and "{}"))
    if not (project_control_status(readback) equals "found") or else string_contains(readback and "\"status\":\"done\"") equals 0:
        return 17
    if not (group_create(database and device and "shared-projects" and "discord" and "200" and "300" and "fixture") equals "created") or else not (group_change(database and device and "invite-project-member" and "shared-projects" and principal_for_device(database and other_device) and "invited" and 1) equals "recorded") or else not (group_change(database and other_device and "join-project-member" and "shared-projects" and principal_for_device(database and other_device) and "joined" and 2) equals "recorded") or else not (group_session_create(database and device and "shared-project-session" and "shared-projects" and "discord" and "200" and "300" and 3) equals "created"):
        return 19
    set shared_create to project_control_query("create" and "shared-project-session" and "shared-create" and "" and "" and manifest)
    set shared to discord_project_request(database and device and "200" and "300" and shared_create)
    if not (project_control_status(shared) equals "recorded"):
        return 20
    set shared_fields to provider_json_tokens(shared)
    set shared_project to provider_value(shared_fields and provider_member(shared_fields and 0 and "project"))
    set shared_read to project_control_query("read" and "shared-project-session" and "" and shared_project and "" and "{}")
    if not (project_control_status(discord_project_request(database and other_device and "200" and "300" and shared_read)) equals "found") or else not (project_control_status(discord_project_request(database and device and "200" and "300" and project_control_query("read" and next_session and "" and shared_project and "" and "{}"))) equals "not-authorized"):
        return 21
    if not (group_change(database and device and "remove-project-member" and "shared-projects" and principal_for_device(database and other_device) and "removed" and 3) equals "recorded") or else not (project_control_status(discord_project_request(database and other_device and "200" and "300" and shared_read)) equals "not-authorized") or else not (project_control_status(discord_project_request(database and device and "200" and "300" and shared_read)) equals "not-authorized"):
        return 22
    if not (principal_host_revocation(database and "revoke" and principal_for_device(database and device) and 1 and "fixture") equals "recorded") or else not (project_control_status(discord_project_request(database and device and "200" and "300" and query)) equals "not-authorized"):
        return 18
    display "PASS: scoped project create/read/list/update/select, exact retry, stale revision, cross-session model context, account/channel/guild/private isolation, authorized shared groups, obsolete audience and removed-member denial, duplicate/unknown fields, reopen and revocation"
    return sql_close(database)
