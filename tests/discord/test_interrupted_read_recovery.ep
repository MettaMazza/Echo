import "../../app/discord/background_supervisor"
import "../../app/discord/typing"
import "../../app/discord/background_settle"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background recovery fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "original-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved") or else not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "original-worker" and 123 and "fixture") equals "recorded"):
        return 5
    set current to agent_run_read(database and "discord-message:100")
    set session to archive_list_text(current and 0)
    set request to "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"name\":\"discord_message_read\",\"arguments\":{\"operation\":\"search_local\",\"query\":\"needle\",\"limit\":2}}"
    if get_argument(3) equals "mutation":
        set request to "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"name\":\"discord_post\",\"arguments\":{\"operation\":\"reply\",\"text\":\"hello\"}}"
    if get_argument(3) equals "channel":
        set request to "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"name\":\"discord_channels\",\"arguments\":{\"operation\":\"inspect\",\"channel\":\"300\"}}"
    else if get_argument(3) equals "channel-mutation":
        set request to "{\"run_id\":\"discord-message:100\",\"call_id\":\"uncertain-call\",\"name\":\"discord_channels\",\"arguments\":{\"operation\":\"create\",\"name\":\"fixture\",\"type\":0,\"reason\":\"test\"}}"
    if archive_append(database and session and "uncertain-request" and "tool_call" and request and "test") is not equal to 0 or else tool_ledger_queue(database and "discord-message:100" and "uncertain-call" and session and "uncertain-request") is not equal to 0 or else tool_ledger_claim(database and "discord-message:100" and "uncertain-call") is not equal to 0:
        return 6
    if sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='discord-message:100';") is not equal to 0 or else discord_typing_schema(journal) is not equal to 0:
        return 7
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to compaction_lock_acquire(database and "web-worker:discord-message:100" and library)
    if lock < 0 or else not (archive_list_text(discord_background_recover(journal and database and "discord-message:100") and 0) equals "worker-owned"):
        return 8
    if net_close(lock) is not equal to 0:
        return 9
    if get_argument(3) equals "revoked":
        if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0:
            return 10
    else if get_argument(3) equals "cancelled":
        if agent_cancel_run(database and "discord-message:100") is not equal to 0:
            return 10
    set recovered to discord_background_recover(journal and database and "discord-message:100")
    set receipt to history_collect_one(archive_prepare(database and "SELECT payload FROM echo_events WHERE event='uncertain-request:result';"))
    if get_argument(3) equals "revoked" or else get_argument(3) equals "cancelled" or else get_argument(3) equals "mutation" or else get_argument(3) equals "channel-mutation":
        if archive_list_text(receipt and 0) equals "found":
            return 11
        display "PASS: revoked/cancelled/mutating work is not reconciled as an interrupted read."
        return 0
    if not (archive_list_text(recovered and 0) equals "recovered") or else not (archive_list_text(receipt and 0) equals "found"):
        display archive_list_text(recovered and 0)
        return 12
    set tokens to provider_json_tokens(archive_list_text(receipt and 1))
    set result to provider_member(tokens and 0 and "result")
    if not (provider_value(tokens and provider_member(tokens and result and "status")) equals "interrupted-read"):
        return 13
    if not (provider_value(tokens and provider_member(tokens and result and "original_outcome")) equals "unavailable") or else not (provider_value(tokens and provider_member(tokens and result and "replayed")) equals "false"):
        return 14
    if agent_recovered_read_phase(database and "discord-message:100") is not equal to 1:
        return 17
    set before to archive_list_text(receipt and 1)
    if agent_recover_tools_owned(database and "discord-message:100") is not equal to 0:
        return 15
    set after to history_collect_one(archive_prepare(database and "SELECT payload FROM echo_events WHERE event='uncertain-request:result';"))
    set call to tool_ledger_read(database and "discord-message:100" and "uncertain-call")
    if not (archive_list_text(after and 1) equals before) or else not (archive_list_text(call and 1) equals "observed"):
        return 16
    display "PASS: abandoned Discord read records interruption without network or replay, original identity preserved, repeat recovery reuses receipt."
    return 0
