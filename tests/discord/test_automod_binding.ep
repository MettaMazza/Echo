import "../../app/discord/agent_bridge"
import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    if database equals 0 or else journal equals 0:
        return 2
    set admins to create_list()
    set admins to ["400"]
    set guilds to create_list()
    set guilds to ["200"]
    set body to "{\"id\":\"100\",\"channel_id\":\"300\",\"type\":0,\"author\":{\"id\":\"500\"},\"content\":\"Inspect configured guild automod\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:100")
    if string_contains(schemas and "discord_automod") is not equal to 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:500" and "discord-message:100" and "discord_automod" and "{\"guild\":\"200\",\"operation\":\"list\"}")
    if string_contains(outcome and "admin-required") equals 0:
        display outcome
        return 6
    set body to "{\"id\":\"101\",\"channel_id\":\"300\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"Inspect configured guild automod\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]}"
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:101")
    if string_contains(schemas and "discord_automod") is not equal to 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:400" and "discord-message:101" and "discord_automod" and "{\"guild\":\"200\",\"operation\":\"list\"}")
    if string_contains(outcome and "audience-restricted") equals 0:
        display outcome
        return 6
    set body to "{\"id\":\"102\",\"channel_id\":\"301\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"Inspect configured guild automod\"}"
    if not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:102" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:102")
    if string_contains(schemas and "discord_automod") equals 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:400" and "discord-message:102" and "discord_automod" and "{\"guild\":\"200\",\"operation\":\"list\"}")
    if string_contains(outcome and "discord-runtime-unavailable") equals 0:
        display outcome
        return 6
    if tool_policy_allows(database and "discord-message:102" and "jobs" and "discord_automod") is not equal to 1 or else tool_policy_allows(database and "discord-message:102" and "forged" and "discord_automod") is not equal to 0:
        return 7
    if agent_direct_lookup(database and "discord-message:102" and "discord_automod" and "{\"operation\":\"create\"}") is not equal to 0:
        return 8
    if agent_direct_lookup(database and "discord-message:102" and "discord_automod" and "{\"operation\":\"delete\"}") is not equal to 0:
        return 9
    if agent_direct_lookup(database and "discord-message:102" and "discord_automod" and "{\"operation\":\"edit\"}") is not equal to 0:
        return 10
    if agent_direct_lookup(database and "discord-message:102" and "discord_automod" and "{\"operation\":\"list\"}") is not equal to 1:
        return 11
    if discord_automod_target_current(journal and "200" and 0) is not equal to 1:
        return 13
    set recorded to discord_inbox_record(journal and "audience:other-guild" and "GUILD_ROLE_UPDATE" and "{\"guild_id\":\"201\"}")
    if discord_automod_target_current(journal and "200" and 0) is not equal to 1:
        return 14
    set recorded to discord_inbox_record(journal and "audience:target-role" and "GUILD_ROLE_UPDATE" and "{\"guild_id\":\"200\"}")
    if discord_automod_target_current(journal and "200" and 0) is not equal to 0:
        return 15
    set cursor_row to history_collect_one(archive_prepare(journal and "SELECT COALESCE(MAX(rowid),0) FROM discord_inbox;"))
    set latest to http_decimal(archive_list_text(cursor_row and 1))
    if discord_automod_target_current(journal and "200" and latest) is not equal to 1:
        return 16
    set recorded to discord_inbox_record(journal and "audience:target-channel" and "CHANNEL_UPDATE" and "{\"guild_id\":\"200\",\"channel_id\":\"999\"}")
    if discord_automod_target_current(journal and "200" and latest) is not equal to 0:
        return 17
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else tool_policy_allows(database and "discord-message:102" and "jobs" and "discord_automod") is not equal to 0:
        return 12
    display "PASS: automod catalog, guest/public denial, DM frozen-call binding, mutation classification, revoked authority and in-flight target-guild role/channel changes."
    return 0
