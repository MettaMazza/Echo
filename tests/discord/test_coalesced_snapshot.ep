import "../../app/archive/coalesced_snapshot"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    if get_argument(3) equals "space-probe":
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        display int_to_string(archive_snapshot_free_bytes(library and get_argument(2)))
        set closed to ep_dlclose(library)
        return 0
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    if get_argument(3) equals "prune":
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set result to archive_snapshot_retention(database and get_argument(2) and library)
        set closed to ep_dlclose(library)
        set closed to sql_close(database)
        return result
    if get_argument(3) equals "low-capacity":
        if sql_execute(database and "UPDATE echo_snapshot_requests SET generation=generation+1 WHERE singleton=1;") is not equal to 0:
            return 4
        set ticket to history_collect_one(archive_prepare(database and "SELECT CAST(generation AS TEXT) FROM echo_snapshot_requests WHERE singleton=1;"))
        set library to ep_dlopen(concat(get_argument(2) and "/disk-full.dylib"))
        if library equals 0:
            return 5
        set deferred to archive_snapshot_coalesced_locked(database and get_argument(2) and archive_list_text(ticket and 1) and library)
        set closed to ep_dlclose(library)
        set closed to sql_close(database)
        return deferred
    if not (get_argument(3) equals "snapshot"):
        if archive_append(database and "fixture" and get_argument(3) and "test" and "{}" and "fixture") is not equal to 0:
            return 3
    if get_argument(3) equals "seed":
        return sql_close(database)
    set result to archive_snapshot_coalesced(database and get_argument(2))
    set closed to sql_close(database)
    return result
