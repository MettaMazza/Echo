import "../../app/discord/delivery"

# Explicitly authorised setup message in Echo's Garden/general. This checks
# delivery only, never claims a working conversational connector.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(3)):
        return 1
    set secret to read_file(get_argument(2))
    if secret equals 0:
        return 2
    set database to discord_store_open(get_argument(3) and "1559932799559934065")
    if database equals 0 or else discord_delivery_schema(database) is not equal to 0:
        return 3
    if not (discord_inbox_record(database and "setup" and "HOST_QUALIFICATION" and "{\"purpose\":\"authorised Discord delivery test\"}") equals "recorded"):
        return 4
    set identity to concat("qualification:" and ptr_to_str(ep_uuid_v4()))
    set body to "{\"content\":\"Echo setup check: testing reliable message delivery and recovery. Conversations are not enabled yet; no reply is needed.\",\"allowed_mentions\":{\"parse\":[],\"replied_user\":false}}"
    if not (discord_outbox_enqueue(database and identity and "setup" and "1559928443817431095" and body) equals "enqueued"):
        return 5
    set result to discord_delivery_send(get_argument(1) and string_trim(ptr_to_str(secret)) and database and identity and get_argument(4))
    set row to history_collect_one(checkpoint_prepare(database and "SELECT state,message FROM discord_outbox WHERE identity=?;" and [identity]))
    if not (result equals "recorded") or else not (archive_list_text(row and 1) equals "sent"):
        print result
        print archive_list_text(row and 1)
        return 6
    # Repeating the controller call must not send another request.
    set again to discord_delivery_send(get_argument(1) and string_trim(ptr_to_str(secret)) and database and identity and get_argument(4))
    if not (again equals "not-pending" or else again equals "rate-limited"):
        return 7
    print "PASS: authenticated live message sent, nonce/channel/author matched; repeated call did not resend"
    print archive_list_text(row and 2)
    return 0
