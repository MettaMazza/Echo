import "../../app/discord/turn_guard"
import "../../app/discord/command_binding"

define test_input with identity as Str and actor as Str returning Str:
    return concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(actor) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"fixture\"}"))))

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_gateway_runtime_schema(journal) is not equal to 0 or else discord_command_schema(journal) is not equal to 0:
        return 2
    set admins to ["400"]
    set guilds to ["200"]
    set saved to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and test_input("100" and "500"))
    set admitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(admitted and 0) equals "accepted"):
        return 3
    set baseline to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events;"))
    set saved to discord_inbox_record(journal and "interaction:800" and "INTERACTION_CREATE" and "{}")
    if discord_interaction_queue(journal and "interaction:800") is not equal to 0 or else sql_execute(journal and "UPDATE discord_interaction_jobs SET state='acknowledged';") is not equal to 0:
        return 4
    if not (discord_testing_toggle(journal and "interaction:800" and "{}" and "400" and admins) equals "testing-enabled"):
        return 5
    set after to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events;"))
    if not (archive_list_text(baseline and 1) equals archive_list_text(after and 1)):
        return 6
    if discord_turn_barrier(journal and 0 and "100" and "300" and "200") is not equal to 1:
        return 7
    set saved to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and test_input("101" and "500"))
    set denied to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(denied and 0) equals "intake-no-longer-authorized"):
        return 8
    set saved to discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and test_input("102" and "400"))
    set accepted to discord_agent_submit(journal and database and "message:create:102" and "900" and guilds and admins)
    if not (archive_list_text(accepted and 0) equals "accepted"):
        return 9
    if discord_turn_barrier(journal and 0 and "102" and "300" and "200") is not equal to 0:
        return 10
    set owner to agent_run_read(database and "discord-message:102")
    if archive_append(database and archive_list_text(owner and 0) and "final-102" and "assistant_final" and "{\"run_id\":\"discord-message:102\",\"content\":\"reply\"}" and "fixture") is not equal to 0:
        return 11
    set queued to discord_outbox_enqueue(journal and "reply-102" and "message:create:102" and "300" and "{\"content\":\"reply\"}")
    if not (discord_final_bind(journal and "reply-102" and "discord-message:102" and "final-102") equals "bound") or else sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='reply-102';") is not equal to 0:
        return 12
    set reaction to "{\"channel_id\":\"300\",\"guild_id\":\"200\",\"message_id\":\"700\",\"user_id\":\"500\",\"emoji\":{\"id\":null,\"name\":\"heart\"}}"
    if string_length(discord_passive_reaction(journal and "900" and reaction and guilds and admins)) equals 0:
        return 13
    if not (discord_gateway_bind(journal and "socket" and "session") equals "bound"):
        return 14
    set envelope to concat("{\"op\":0,\"s\":1,\"t\":\"MESSAGE_REACTION_ADD\",\"d\":" and concat(reaction and "}"))
    if not (discord_gateway_intake(journal and "socket" and "900" and guilds and admins and envelope) equals "recorded"):
        return 15
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_inbox WHERE kind='ECHO_MESSAGE_REACTION_ADD';"))
    if not (archive_list_text(row and 1) equals "0"):
        return 16
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE instr(payload,'testing')>0;"))
    if not (archive_list_text(row and 1) equals "0"):
        return 17
    display "PASS: no model event for toggle; active guest barrier stops; queued guest input blocked; admin turn allowed; guest reaction excluded; no mode text in agent archive."
    return 0
