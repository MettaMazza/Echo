import "../../app/discord/command_execution"
import "../../app/discord/command_registration"
import "../../app/discord/agent_output"
import "../../app/discord/revision_target"
import "../../app/discord/run_source"
import "../../app/discord/queue_control_store"

define branch_fixture with journal as Int and id as Str and state as Str and name as Str and options as Str and actor as Str and room as Str returning Str:
    set data to concat("{\"type\":1,\"id\":\"801\",\"name\":" and provider_quote(name))
    set data to concat(data and concat(",\"options\":" and concat(options and "}")))
    if name equals "history":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"802\"")
    if name equals "search":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"803\"")
    if name equals "export":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"804\"")
    if name equals "edit":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"811\"")
    if name equals "regenerate":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"812\"")
    set body to concat("{\"id\":" and provider_quote(id))
    set body to concat(body and ",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":")
    set body to concat(body and concat(data and "}"))

    set body to string_replace(body and "\"id\":\"400\"" and concat("\"id\":" and provider_quote(actor)))
    set body to string_replace(body and "\"channel_id\":\"300\"" and concat("\"channel_id\":" and provider_quote(room)))
    set identity to concat("interaction:" and id)
    if not (discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    set values to create_list()
    set added to append_list(values and identity)
    set added to append_list(values and state)
    set added to append_list(values and int_to_string(ep_time_now_ms()))
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,?2,CAST(?3 AS INTEGER),'fixture');" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_command_credential_1234','fixture',CAST(?3 AS INTEGER),CAST(?3 AS INTEGER)+900000);" and values) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    set registration to "{\"id\":\"801\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"branch\"}"
    if not (discord_command_observe(journal and registration and "900" and "200") equals "registered") or else discord_control_command_matches(discord_control_command_definition("branch") and "branch") is not equal to 1:
        return 3
    set guilds to ["200"]
    set admins to create_list()
    set intake to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Original question\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and intake) equals "recorded"):
        return 4
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 5
    set source to archive_list_text(submitted and 1)
    set request to "{\"run_id\":\"discord-message:100\",\"parent_event\":\"discord-message:100:user\",\"fixture\":true}"
    set final to "{\"run_id\":\"discord-message:100\",\"parent_event\":\"fixture-request\",\"content\":\"Original answer\",\"fixture\":true}"
    if archive_append(database and source and "fixture-request" and "model_request" and request and "fixture") is not equal to 0 or else agent_run_transition(database and "discord-message:100" and "ready" and "discord-message:100:user" and "generating" and "fixture-request") is not equal to 0 or else archive_append(database and source and "fixture-final" and "assistant_final" and final and "fixture") is not equal to 0 or else agent_run_transition(database and "discord-message:100" and "generating" and "fixture-request" and "completed" and "fixture-final") is not equal to 0:
        return 6
    if not (discord_agent_output(journal and database and "message:create:100") equals "enqueued"):
        return 7
    set claimed to discord_outbox_claim(journal and "discord-message:100:final:0" and "fixture")
    if not (archive_list_text(claimed and 0) equals "claimed") or else not (discord_outbox_finish(journal and "discord-message:100:final:0" and "fixture" and "sent" and "800" and "synthetic delivery") equals "recorded"):
        return 8
    set device to "discord:400"
    set direct to discord_revision_target(journal and database and device and "100" and "200" and "300")
    set reply to discord_revision_target(journal and database and device and "800" and "200" and "300")
    if not (archive_list_text(direct and 0) equals "found") or else not (archive_list_text(reply and 0) equals "found") or else not (archive_list_text(direct and 1) equals source) or else not (archive_list_text(direct and 2) equals "discord-message:100:user") or else not (archive_list_text(reply and 2) equals archive_list_text(direct and 2)):
        return 9
    set other_device to discord_agent_principal(database and "500" and admins)
    set other to discord_revision_target(journal and database and other_device and "800" and "200" and "300")
    set wrong_room to discord_revision_target(journal and database and device and "800" and "200" and "301")
    set unknown to discord_revision_target(journal and database and device and "999" and "200" and "300")
    if archive_list_text(other and 0) equals "found" or else archive_list_text(wrong_room and 0) equals "found" or else archive_list_text(unknown and 0) equals "found":
        return 10
    set edit_registration to "{\"id\":\"811\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"edit\"}"
    set regenerate_registration to string_replace(edit_registration and "edit" and "regenerate")
    set regenerate_registration to string_replace(regenerate_registration and "811" and "812")
    if not (discord_command_observe(journal and edit_registration and "900" and "200") equals "registered") or else not (discord_command_observe(journal and regenerate_registration and "900" and "200") equals "registered"):
        return 11
    set template to "{\"id\":\"720\",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"id\":\"811\",\"type\":1,\"name\":\"edit\",\"options\":[{\"name\":\"text\",\"type\":3,\"value\":\"Revised question with punctuation?\"},{\"name\":\"message\",\"type\":3,\"value\":\"100\"}]}}"
    set parsed to discord_command_resolve(journal and template and "900" and guilds and admins)
    if not (archive_list_text(parsed and 0) equals "command-bound-needs-live-access"):
        return 12
    set options to provider_json_tokens(archive_list_text(parsed and 5))
    if not (provider_value(options and provider_member(options and 0 and "text")) equals "Revised question with punctuation?") or else not (provider_value(options and provider_member(options and 0 and "message")) equals "100"):
        return 13
    set malformed to [string_replace(template and "\"text\"" and "\"message\""),string_replace(template and "\"text\"" and "\"actor\""),string_replace(template and "Revised question with punctuation?" and ""),string_replace(template and "\"type\":3" and "\"type\":4"),string_replace(template and "\"value\":\"100\"" and "\"value\":100")]
    for each bad in malformed:
        set rejected to discord_command_resolve(journal and ptr_to_str(bad) and "900" and guilds and admins)
        if not (archive_list_text(rejected and 0) equals "invalid-command-options"):
            return 14
    set regen to "{\"data\":{\"options\":[{\"name\":\"message\",\"type\":3,\"value\":\"800\"}]}}"
    if string_length(discord_revision_command_options(regen and "regenerate")) equals 0 or else string_length(discord_revision_command_options(template and "regenerate")) > 0:
        return 15
    set names to ["edit","regenerate"]
    for each name_value in names:
        set name to ptr_to_str(name_value)
        set definition to discord_control_command_definition(name)
        if discord_control_command_matches(definition and name) is not equal to 1 or else discord_control_command_matches(string_replace(definition and "\"required\":true" and "\"required\":false") and name) is not equal to 0:
            return 16
    set revised to group_revision_submit(database and device and "revision-target-fixture" and archive_list_text(direct and 1) and archive_list_text(direct and 2) and "discord" and "200" and "300" and "edit" and "Revised question" and "")
    if not (archive_list_text(revised and 0) equals "accepted"):
        display archive_list_text(revised and 0)
        return 17
    set selected to archive_list_text(revised and 1)
    set closed to sql_close(journal)
    set closed to sql_close(database)
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    set reply to discord_revision_target(journal and database and device and "800" and "200" and "300")
    set replay to group_revision_submit(database and device and "revision-target-fixture" and archive_list_text(reply and 1) and archive_list_text(reply and 2) and "discord" and "200" and "300" and "edit" and "Revised question" and "")
    if not (archive_list_text(replay and 0) equals "already-accepted") or else not (archive_list_text(replay and 1) equals selected) or else archive_verify(database and source) is not equal to 0 or else archive_verify(database and selected) is not equal to 0:
        return 18
    if discord_worker_schema(journal) is not equal to 0:
        return 19
    set revise_options to "[{\"name\":\"message\",\"type\":3,\"value\":\"800\"}]"
    set body to branch_fixture(journal and "730" and "acknowledged" and "regenerate" and revise_options and "400" and "300")
    set anchor_response to "{\"id\":\"1730\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Regeneration requested for message 800.\",\"interaction_metadata\":{\"id\":\"730\",\"type\":2,\"user\":{\"id\":\"400\"}}}"
    if string_length(body) equals 0 or else not (discord_command_anchor_observe(journal and "interaction:730" and anchor_response and "900" and guilds and admins) equals "anchored"):
        return 20
    set held to discord_worker_claim(journal)
    if not (archive_list_text(held and 1) equals "message:create:100") or else not (discord_command_start_apply(journal and database and "interaction:730" and body and "900" and guilds and admins) equals "command-reservation:conversation-busy"):
        return 21
    set run to "discord-command:interaction:730"
    set keys to [run]
    set absent to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_runs WHERE run=?1;" and keys))
    if not (archive_list_text(absent and 1) equals "0") or else not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "recorded"):
        return 22
    set admitted to discord_command_start_apply(journal and database and "interaction:730" and body and "900" and guilds and admins)
    if not (admitted equals "revision-admitted"):
        display admitted
        return 23
    if not (discord_job_origin(journal and database and run) equals "interaction:730") or else autonomy_enabled(database and run) is not equal to 0:
        return 24
    set typed to discord_run_source(journal and database and run)
    if not (archive_list_text(typed and 0) equals "found") or else not (archive_list_text(typed and 1) equals "INTERACTION_CREATE") or else not (archive_list_text(typed and 3) equals "400") or else not (archive_list_text(typed and 6) equals "1730"):
        return 25
    set original to archive_read_event(database and concat(run and ":user"))
    if not (archive_list_text(original and 3) equals "Original question") or else not (discord_command_start_apply(journal and database and "interaction:730" and body and "900" and guilds and admins) equals "revision-admitted"):
        return 26
    if discord_queue_control_schema(journal) is not equal to 0 or else not (archive_list_text(discord_queue_command_next(journal) and 1) equals "interaction:730") or else not (discord_queue_cancel_plan(journal and database and "interaction:730" and "900" and guilds and admins) equals "tracked"):
        return 60
    set cancel_output to "queue-status:interaction:730"
    set cancel_claim to discord_outbox_claim(journal and cancel_output and "cancel-fixture")
    if not (archive_list_text(cancel_claim and 0) equals "claimed") or else not (discord_outbox_finish(journal and cancel_output and "cancel-fixture" and "sent" and "2730" and "fixture") equals "recorded"):
        return 61
    set cancel_body to concat("{\"id\":\"9730\",\"application_id\":\"900\",\"type\":3,\"channel_id\":\"300\",\"guild_id\":\"200\",\"member\":{\"user\":{\"id\":\"400\"}},\"message\":{\"id\":\"2730\",\"author\":{\"id\":\"900\"}},\"data\":{\"component_type\":2,\"custom_id\":" and concat(provider_quote(discord_cancel_button_identity(cancel_output)) and "}}"))
    set cancel_bound to discord_cancel_button_resolve(journal and cancel_body and "900")
    if not (archive_list_text(cancel_bound and 0) equals "cancel-bound") or else not (archive_list_text(cancel_bound and 1) equals "interaction:730"):
        return 62
    if not (archive_list_text(discord_cancel_button_resolve(journal and string_replace(cancel_body and "400" and "500") and "900") and 0) equals "cancel-source-denied") or else not (archive_list_text(discord_cancel_button_resolve(journal and string_replace(cancel_body and "300" and "301") and "900") and 0) equals "cancel-source-denied"):
        return 63
    if discord_queue_control_position(journal and database and "interaction:730") is not equal to -2 or else discord_run_barrier(journal and "interaction:730" and string_to_int(archive_list_text(typed and 7)) and "1730" and "300" and "200") is not equal to 0:
        return 64
    if not (discord_cancel_source(journal and "interaction:730" and "400" and "300" and "200" and "interaction:9730") equals "cancel-requested") or else discord_run_barrier(journal and "interaction:730" and string_to_int(archive_list_text(typed and 7)) and "1730" and "300" and "200") is not equal to 1:
        return 65
    if not (discord_cancel_source(journal and "interaction:730" and "400" and "300" and "200" and "interaction:9730") equals "already-cancel-requested"):
        return 66
    if agent_cancel_run(database and run) is not equal to 0 or else not (discord_background_transition(journal and run and "reserved" and "released" and "" and 0 and "fixture cancellation") equals "recorded"):
        return 27
    if discord_queue_control_position(journal and database and "interaction:730") is not equal to 0:
        return 67
    set status_body to concat("{\"id\":\"2730\",\"author\":{\"id\":\"900\"},\"message_reference\":{\"message_id\":\"1730\"},\"content\":\"This message has left the queue.\",\"components\":" and concat(discord_cancel_button_components(cancel_output and 0) and "}"))
    if not (discord_queue_status_observe(journal and "interaction:730" and "900" and 0 and status_body) equals "observed") or else not (discord_queue_status_observe(journal and "interaction:730" and "900" and 0 and string_replace(status_body and "1730" and "730")) equals "queue-status-unconfirmed"):
        return 68
    if not (archive_list_text(discord_queue_command_next(journal) and 0) equals "end"):
        return 69
    set closed to sql_close(database)
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_command_start_apply(journal and database and "interaction:730" and body and "900" and guilds and admins) equals "revision-admitted"):
        return 28
    set released to history_collect_one(checkpoint_prepare(journal and "SELECT state FROM discord_background_runs WHERE run=?1;" and keys))
    if not (archive_list_text(released and 1) equals "released"):
        return 29
    set long_text to ""
    repeat while string_length(long_text) < 4200:
        set long_text to concat(long_text and "A complete replacement sentence with punctuation. ")
    set edit_options to concat("[{\"name\":\"message\",\"type\":3,\"value\":\"100\"},{\"name\":\"text\",\"type\":3,\"value\":" and concat(provider_quote(long_text) and "}]"))
    set edit_body to branch_fixture(journal and "731" and "acknowledged" and "edit" and edit_options and "400" and "300")
    set edit_response to string_replace(anchor_response and "730" and "731")
    if not (discord_command_anchor_observe(journal and "interaction:731" and edit_response and "900" and guilds and admins) equals "anchored"):
        return 32
    set edit_command to discord_command_resolve(journal and edit_body and "900" and guilds and admins)
    set edit_source to discord_intake_source(journal and "interaction:731")
    if discord_command_source_allows(journal and edit_source and "900" and admins) is not equal to 1 or else not (discord_revision_prompt_publish(journal and "interaction:731" and edit_command) equals "revision-prompt-pending"):
        return 33
    set joined to ""
    set count to 0
    repeat while count < 3:
        set output to concat("revision-prompt:interaction:731:" and int_to_string(count))
        set taken to discord_outbox_claim(journal and output and "prompt-fixture")
        if not (archive_list_text(taken and 0) equals "claimed"):
            return 34
        set rows to [output]
        set payload to history_collect_one(checkpoint_prepare(journal and "SELECT json_extract(body,'$.content'),json_extract(body,'$.message_reference.message_id') FROM discord_outbox WHERE identity=?1;" and rows))
        if not (archive_list_text(payload and 2) equals "1731"):
            return 35
        set joined to concat(joined and archive_list_text(payload and 1))
        if not (discord_outbox_finish(journal and output and "prompt-fixture" and "sent" and int_to_string(9000 + count) and "synthetic prompt delivery") equals "recorded"):
            return 36
        set count to count + 1
    if not (joined equals long_text) or else not (discord_revision_prompt_publish(journal and "interaction:731" and edit_command) equals "revision-prompt-ready"):
        return 37
    if not (discord_command_start_apply(journal and database and "interaction:731" and edit_body and "900" and guilds and admins) equals "revision-admitted"):
        return 38
    set edited to archive_read_event(database and "discord-command:interaction:731:user")
    if not (archive_list_text(edited and 3) equals long_text) or else not (discord_job_origin(journal and database and "discord-command:interaction:731") equals "interaction:731"):
        return 39
    if sql_execute(journal and "UPDATE discord_interaction_credentials SET expires_ms=0;") is not equal to 0 or else not (discord_job_origin(journal and database and run) equals "interaction:730"):
        return 30
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else string_length(discord_job_origin(journal and database and run)) > 0:
        return 31
    display "PASS: ordinary-user revision reservation, admitted typed command provenance, original prompt, replay/cancel/reopen, token expiry and authority revocation"
    return 0
