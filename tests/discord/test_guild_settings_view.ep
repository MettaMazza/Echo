import "../../app/discord/guild_settings_view"
import "../../app/discord/access"

define main returning Int:
    set body to "{\"id\":\"400\",\"name\":\"Test guild\",\"description\":null,\"region\":\"eu-west\",\"verification_level\":0,\"default_message_notifications\":0,\"explicit_content_filter\":0,\"preferred_locale\":\"en-GB\",\"afk_timeout\":300,\"afk_channel_id\":null,\"system_channel_id\":null,\"system_channel_flags\":0,\"features\":[],\"rules_channel_id\":null,\"safety_alerts_channel_id\":null,\"public_updates_channel_id\":null,\"premium_progress_bar_enabled\":false,\"icon\":\"imagehash\",\"splash\":null,\"discovery_splash\":null,\"banner\":null,\"home_header\":null,\"owner_profile\":\"EXCLUDED_PRIVATE\",\"roles\":[{\"private\":\"EXCLUDED_PRIVATE\"}]}"
    set view to discord_guild_settings_view(body and "400")
    if string_length(view) equals 0 or else string_contains(view and "EXCLUDED_PRIVATE") equals 1:
        return 1
    if string_length(discord_guild_settings_view(body and "401")) is not equal to 0:
        return 2
    set fields to provider_json_tokens(view)
    set settings to provider_member(fields and 0 and "settings")
    if discord_guild_settings_changes(agent_json_source(view and fields and settings)) is not equal to 1:
        return 3
    if provider_member(fields and settings and "icon") >= 0 or else provider_member(fields and 0 and "asset_hashes") < 0:
        return 4
    if string_length(discord_guild_settings_view("{\"id\":\"400\",\"name\":\"Incomplete\"}" and "400")) is not equal to 0:
        return 5
    display "PASS: guild settings projection binds guild, excludes profiles and roles, retains nullable settings, and separates image hashes from writable settings."
    if get_argument_count() equals 1:
        return 0
    if get_argument_count() is not equal to 7 or else discord_snowflake(get_argument(6)) equals 0:
        return 20
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 21
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 22
    set route to concat("/guilds/" and get_argument(6))
    set response to discord_access_get(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and route and "GET:guild-settings-independent-read" and get_argument(6))
    if not (archive_list_text(response and 0) equals "observed"):
        display archive_list_text(response and 0)
        return 23
    set projected to discord_guild_settings_view(archive_list_text(response and 1) and get_argument(6))
    if string_length(projected) equals 0:
        return 24
    set target to concat(get_argument(4) and "/guild-settings-projection.json")
    if file_exists(target) or else write_file(target and projected) is not equal to 1:
        return 25
    display "Verified guild-bound server settings; projected settings and image hashes retained privately."
    return sql_close(journal)
