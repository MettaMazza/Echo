import "../../app/discord/group_options"

define main returning Int:
    set definition to discord_group_command_definition()
    if discord_group_command_matches(definition) is not equal to 1 or else discord_group_command_matches(string_replace(definition and "\"type\":6" and "\"type\":3")) is not equal to 0:
        return 1
    set creation_body to "{\"data\":{\"options\":[{\"name\":\"action\",\"type\":3,\"value\":\"create\"}]}}"
    if string_length(discord_group_command_options(creation_body)) equals 0:
        return 2
    set invite to "{\"data\":{\"options\":[{\"name\":\"action\",\"type\":3,\"value\":\"invite\"},{\"name\":\"group\",\"type\":3,\"value\":\"joined-test\"},{\"name\":\"member\",\"type\":6,\"value\":\"500\"},{\"name\":\"revision\",\"type\":3,\"value\":\"2\"}]}}"
    if string_length(discord_group_command_options(invite)) equals 0 or else string_length(discord_group_command_options(string_replace(invite and "\"type\":6" and "\"type\":3"))) > 0:
        return 3
    if string_length(discord_group_command_options(string_replace(invite and "\"2\"" and "\"-1\""))) > 0 or else string_length(discord_group_command_options(string_replace(invite and "\"500\"" and "\"fake-user\""))) > 0:
        return 4
    if string_length(discord_group_command_options(string_replace(invite and "\"invite\"" and "\"join\""))) > 0 or else string_length(discord_group_command_options(string_replace(creation_body and "\"create\"" and "\"invite\""))) > 0:
        return 5
    set duplicate to "{\"data\":{\"options\":[{\"name\":\"action\",\"type\":3,\"value\":\"create\"},{\"name\":\"action\",\"type\":3,\"value\":\"personal\"}]}}"
    if string_length(discord_group_command_options(duplicate)) > 0:
        return 6
    set archive_body to "{\"data\":{\"options\":[{\"name\":\"action\",\"type\":3,\"value\":\"archive\"},{\"name\":\"group\",\"type\":3,\"value\":\"joined-test\"},{\"name\":\"revision\",\"type\":3,\"value\":\"2\"}]}}"
    if string_length(discord_group_command_options(archive_body)) equals 0 or else string_length(discord_group_command_options(string_replace(archive_body and "\"archive\"" and "\"reopen\""))) equals 0:
        return 7
    if string_length(discord_group_command_options(string_replace(archive_body and "\"archive\"" and "\"expire\""))) > 0:
        return 8
    set expiry_body to string_replace(archive_body and "\"archive\"" and "\"expire\"")
    set expiry_body to string_replace(expiry_body and "}]}}" and "},{\"name\":\"expires\",\"type\":3,\"value\":\"2000000000\"}]}}")
    if string_length(discord_group_command_options(expiry_body)) equals 0 or else string_length(discord_group_command_options(string_replace(expiry_body and "2000000000" and "9223372036854776"))) > 0 or else string_length(discord_group_command_options(string_replace(expiry_body and "\"expire\"" and "\"archive\""))) > 0:
        return 9
    display "PASS: group options enforce native user type, required action fields, positive revision, valid user identifier and duplicate rejection."
    return 0
