import "../../app/discord/expression_upload"
import "../../app/discord/agent_bridge"
import "../../app/discord/post_options"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Fixture prompt\"}"
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source)
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 3
    set session to archive_list_text(submitted and 1)
    if web_attachment_register(database and "discord:400" and session and "fixture:file" and get_argument(3) and "binary-test.bin" and "image/png") is not equal to 0:
        return 4
    set file to discord_post_file_source(database and "discord-message:100" and "400" and "fixture:file")
    if not (archive_list_text(file and 0) equals "found") or else archive_list_text(discord_post_file_source(database and "discord-message:100" and "500" and "fixture:file") and 0) equals "found" or else archive_list_text(discord_post_file_source(database and "other-run" and "400" and "fixture:file") and 0) equals "found":
        return 5
    set other_source to string_replace(string_replace(source and "\"id\":\"100\"" and "\"id\":\"101\"") and "\"channel_id\":\"300\"" and "\"channel_id\":\"301\"")
    set recorded to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and other_source)
    set other to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(other and 0) equals "accepted") or else archive_list_text(discord_post_file_source(database and "discord-message:101" and "400" and "fixture:file") and 0) equals "found":
        return 16
    set metadata to "{\"name\":\"Fixture\",\"description\":\"\",\"tags\":\"wave\"}"
    set prepared to discord_expression_upload(database and "discord-message:100" and "400" and "sticker" and "fixture:file" and metadata and "{}")
    if not (archive_list_text(prepared and 0) equals "multipart-ready"):
        display archive_list_text(prepared and 0)
        return 20
    set released to discord_audio_multipart_release(prepared)
    set prepared to discord_expression_upload(database and "discord-message:100" and "400" and "emoji" and "fixture:file" and "{\"name\":\"fixture\"}" and "{}")
    if not (archive_list_text(prepared and 0) equals "json-ready") or else string_contains(archive_list_text(prepared and 1) and "data:image/png;base64,AP9BCoANAEI=") equals 0:
        return 21
    if archive_list_text(discord_expression_upload(database and "discord-message:101" and "400" and "emoji" and "fixture:file" and "{\"name\":\"fixture\"}" and "{}") and 0) equals "json-ready":
        return 22
    if archive_append(database and session and "excluded:fixture" and "attachment_visibility" and "{\"attachment\":\"fixture:file\",\"state\":\"excluded\"}" and "fixture") is not equal to 0:
        return 23
    if not (archive_list_text(discord_expression_upload(database and "discord-message:100" and "400" and "sticker" and "fixture:file" and metadata and "{}") and 0) equals "attachment-selection-disabled"):
        return 24
    if archive_append(database and session and "included:fixture" and "attachment_visibility" and "{\"attachment\":\"fixture:file\",\"state\":\"included\"}" and "fixture") is not equal to 0 or else write_file(get_argument(3) and "changed!") is not equal to 1:
        return 25
    if not (archive_list_text(discord_expression_upload(database and "discord-message:100" and "400" and "emoji" and "fixture:file" and "{\"name\":\"fixture\"}" and "{}") and 0) equals "integrity-failed"):
        return 26
    display "PASS: scoped expression upload preparation, encoded emoji data, frozen sticker bytes, cross-conversation/excluded-source and changed-byte denial."
    return 0
