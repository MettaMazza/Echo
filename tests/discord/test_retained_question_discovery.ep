import "../../app/tools/tool_discovery"


define question_discovery_allocations with completed as Int returning Int:
    set index to 0
    repeat while index < 20000:
        set tokens to provider_json_tokens("{\"items\":[{\"text\":\"concurrent allocation café\"}],\"state\":\"running\"}")
        if tokens equals 0:
            send 1 to completed
            return 1
        set index to index + 1
    send 0 to completed
    return 0

# Diagnostic on an explicitly supplied private snapshot, never the live archive.
# No inference, tool dispatch, network request or tool-ledger retry is performed.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0:
        return 2
    set completed to channel
    spawn question_discovery_allocations(completed)
    set result to tool_discovery_execute(database and get_argument(2) and "{\"query\":\"request_user_input\",\"after\":0,\"catalog_digest\":\"\"}")
    set tokens to provider_json_tokens(result)
    if tokens equals 0:
        return 3
    set status to provider_value(tokens and provider_member(tokens and 0 and "status"))
    display status
    if not (status equals "end"):
        return 4
    display "PASS: retained child catalog excludes direct user forms without executing the pending tool."
    set allocation_status to receive from completed
    if allocation_status is not equal to 0:
        return 5
    return sql_close(database)
