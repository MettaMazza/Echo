import "../../app/discord/snapshot"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\"}") equals "recorded") or else not (discord_outbox_enqueue(journal and "reply" and "message:create:100" and "300" and "{\"content\":\"Fixture\"}") equals "enqueued"):
        return 2
    if discord_journal_snapshot(journal and get_argument(2)) is not equal to 0 or else discord_journal_snapshot(journal and get_argument(2)) equals 0:
        return 3
    set snapshot to sql_open(get_argument(2))
    if discord_snapshot_verify(snapshot) is not equal to 0:
        return 4
    set row to history_collect_one(archive_prepare(snapshot and "SELECT inbox_count,outbox_count FROM discord_snapshot_receipt;"))
    if not (archive_list_text(row and 1) equals "1") or else not (archive_list_text(row and 2) equals "1"):
        return 5
    # Corrupt only the disposable native fixture to verify retained-byte audit.
    if sql_execute(snapshot and "DROP TRIGGER discord_inbox_no_update; UPDATE discord_inbox SET payload='tampered';") is not equal to 0 or else discord_snapshot_verify(snapshot) equals 0:
        return 6
    display "PASS: Discord journal snapshot without conversation schema, receipt coverage, overwrite refusal, original-byte corruption detection"
    return 0
