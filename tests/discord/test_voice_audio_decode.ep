import "../../app/discord/agent_bridge"

# Actual pinned ffmpeg conversion in the same sandbox used by intake. Inputs
# must be a synthetic OGG fixture and an existing private temporary directory.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Decoder test" and "test-only-secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "owner" and "seed" and "" and "Decoder test")
    set session to archive_list_text(first and 1)
    if agent_cancel_run(database and "seed") is not equal to 0:
        return 4
    if web_attachment_register(database and "owner" and session and "clip" and get_argument(2) and "clip.wav" and "audio/wav") is not equal to 0:
        return 5
    set decoded to discord_voice_audio_decode(database and "owner" and session and "clip" and get_argument(3))
    display archive_list_text(decoded and 0)
    if not (archive_list_text(decoded and 0) equals "decoded") or else not (archive_list_text(decoded and 1) equals "clip:voice-pcm-wav"):
        return 6
    set replay to discord_voice_audio_decode(database and "owner" and session and "clip" and get_argument(3))
    if not (archive_list_text(replay and 0) equals "decoded"):
        return 7
    set lineage to history_collect_one(archive_prepare(database and "SELECT parent FROM echo_attachment_derivations WHERE attachment='clip:voice-pcm-wav';"))
    if not (archive_list_text(lineage and 1) equals "clip"):
        return 8
    set part to attachment_audio_original_part(database and session and "clip:voice-pcm-wav")
    if not (archive_list_text(part and 0) equals "ready"):
        return 9
    if not (archive_list_text(discord_voice_audio_decode(database and "stranger" and session and "clip" and get_argument(3)) and 0) equals "audio-source-unavailable"):
        return 10
    if archive_verify(database and session) is not equal to 0:
        return 11
    set second to web_submit_owned(database and "owner" and "other-seed" and "" and "Separate decoder conversation")
    set other_session to archive_list_text(second and 1)
    if other_session equals "" or else other_session equals session or else agent_cancel_run(database and "other-seed") is not equal to 0:
        return 12
    set cross_session to discord_voice_audio_decode(database and "owner" and other_session and "clip" and get_argument(3))
    if not (archive_list_text(cross_session and 0) equals "audio-source-unavailable"):
        return 13
    set owned to web_attachment_owned(database and "owner" and "clip:voice-pcm-wav")
    display archive_list_text(owned and 1)
    display "PASS: sandboxed voice PCM conversion, separate derivative identity, parent provenance, cache reuse and audience denial."
    return 0
