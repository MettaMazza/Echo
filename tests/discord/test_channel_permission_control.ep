import "../../app/discord/channel_options"
import "../../app/discord/channel_permission_guard"
external define ep_gc_get_minor_count returning Int

# Fixed synthetic snapshots, no Discord credentials or external side effects.
define main returning Int:
    set digest to "1111111111111111111111111111111111111111111111111111111111111111"
    set prefix to concat("{\"channel\":\"300\",\"subject\":\"200\",\"subject_type\":0,\"reason\":\"fixture\",\"observed_sha256\":" and concat(provider_quote(digest) and ","))
    set set_args to concat(prefix and "\"operation\":\"permissions_set\",\"allow\":\"0\",\"deny\":\"2048\"}")
    set remove_args to concat(prefix and "\"operation\":\"permissions_delete\"}")
    set options to discord_channel_options(set_args)
    set remove_options to discord_channel_options(remove_args)
    if not (archive_list_text(options and 0) equals "valid") or else not (archive_list_text(remove_options and 0) equals "valid"):
        return 1
    if discord_overwrite_mask("0") is not equal to 1 or else discord_overwrite_mask("4503599627370496") is not equal to 1 or else discord_overwrite_mask("9007199254740992") is not equal to 0 or else discord_overwrite_mask("01") is not equal to 0 or else discord_overwrite_mask("1e3") is not equal to 0:
        return 2
    if archive_list_text(discord_channel_options(concat(prefix and "\"operation\":\"permissions_set\",\"allow\":\"2048\",\"deny\":\"2048\"}")) and 0) equals "valid" or else archive_list_text(discord_channel_options(concat(prefix and "\"operation\":\"permissions_set\",\"allow\":0,\"deny\":\"2048\"}")) and 0) equals "valid" or else archive_list_text(discord_channel_options(concat(prefix and "\"operation\":\"permissions_delete\",\"deny\":\"0\"}")) and 0) equals "valid":
        return 3
    set origin to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[]}"
    set changed to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"2048\"}]}"
    set hidden to "{\"id\":\"301\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"}]}"
    if discord_channel_same_audience(origin and changed and "200") is not equal to 1 or else discord_channel_same_audience(origin and hidden and "200") is not equal to 0:
        return 4
    if not (discord_overwrite_matches(changed and options) equals "verified-match") or else not (discord_overwrite_matches(origin and remove_options) equals "verified-absent") or else discord_overwrite_matches(changed and remove_options) equals "verified-absent":
        return 5
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"200\",\"permissions\":\"268436480\"}]"
    set member to "{\"user\":{\"id\":\"500\"},\"roles\":[]}"
    if discord_overwrite_assignment(server and roles and member and origin and "{}" and "200" and "500" and "300" and "2048" and "0") is not equal to 0:
        return 6
    set parent to "{\"id\":\"400\",\"guild_id\":\"200\",\"type\":4,\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"2048\",\"deny\":\"0\"}]}"
    if discord_overwrite_assignment(server and roles and member and origin and parent and "200" and "500" and "300" and "2048" and "0") is not equal to 1:
        return 7
    set exception to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[{\"id\":\"500\",\"type\":1,\"allow\":\"268435456\",\"deny\":\"0\"}]}"
    if discord_overwrite_assignment(server and roles and member and exception and "{}" and "200" and "500" and "300" and "2048" and "0") is not equal to 1:
        return 8
    if discord_overwrite_assignment(server and roles and member and origin and "{}" and "200" and "501" and "300" and "0" and "0") is not equal to 0:
        return 9
    set member_grant to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[{\"id\":\"500\",\"type\":1,\"allow\":\"2048\",\"deny\":\"0\"}]}"
    if discord_overwrite_assignment(server and roles and member and member_grant and "{}" and "200" and "500" and "300" and "2048" and "0") is not equal to 0:
        return 10
    set denied to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[{\"id\":\"500\",\"type\":1,\"allow\":\"0\",\"deny\":\"268435456\"}]}"
    if discord_overwrite_assignment(server and roles and member and denied and "{}" and "200" and "500" and "300" and "0" and "0") is not equal to 0:
        return 11
    set before to ep_gc_get_minor_count()
    set iteration to 0
    repeat while iteration < 500:
        if discord_channel_same_audience(origin and changed and "200") is not equal to 1 or else discord_channel_same_audience(origin and hidden and "200") is not equal to 0 or else not (discord_overwrite_matches(changed and options) equals "verified-match"):
            return 12
        set iteration to iteration + 1
    if ep_gc_get_minor_count() equals before:
        return 13
    display "PASS: strict overwrite inputs, nonoverlapping decimal masks, visibility separation, independent result verification and actor guild/parent/overwrite permissions."
    return 0
