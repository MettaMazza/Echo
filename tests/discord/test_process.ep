import "../../app/discord/process"
import "select"

define main returning Int:
    if get_argument_count() equals 2:
        if get_argument(1) equals "--child-no-workspace":
            if string_length(ptr_to_str(get_env("ECHO_WORKSPACE_ROOT"))) > 0:
                return 11
            return 0
        if get_argument(1) equals "--child-ok":
            if not (ptr_to_str(get_env("ECHO_SYSTEM_PROFILE")) equals "discord-architecture-fixture") or else not (ptr_to_str(get_env("ECHO_IDENTITY_FILE")) equals "discord-identity-fixture") or else not (ptr_to_str(get_env("ECHO_RUNTIME_BUILD_SHA256")) equals "discord-build-fixture"):
                return 8
            if string_length(ptr_to_str(get_env("ECHO_PRIVATE_ENV_CANARY"))) > 0:
                return 9
            if not (ptr_to_str(get_env("ECHO_WORKSPACE_ROOT")) equals "discord-workspace-fixture") or else not (ptr_to_str(get_env("ECHO_DISCORD_WORKSPACE_ROOT")) equals "discord-workspace-fixture"):
                return 10
            return 0
        return 7
    set configured to set_env("ECHO_WORKSPACE_ROOT" and "private-host-workspace-canary")
    set configured to set_env("ECHO_DISCORD_WORKSPACE_ROOT" and "discord-workspace-fixture")
    set arguments to create_list()
    set added to append_list(arguments and "--child-ok")
    set process to discord_process_start(arguments and -1)
    if process <= 0:
        return 1
    set result to test_discord_wait(process)
    if result is not equal to 1:
        return 2
    set configured to set_env("ECHO_DISCORD_WORKSPACE_ROOT" and "")
    set absent to discord_process_start(["--child-no-workspace"] and -1)
    if absent <= 0 or else test_discord_wait(absent) is not equal to 1:
        return 12
    set failed_arguments to create_list()
    set added to append_list(failed_arguments and "--child-fail")
    set failed to discord_process_start(failed_arguments and -1)
    if failed <= 0 or else test_discord_wait(failed) is not equal to 2:
        return 3
    display "PASS: isolated current-executable child launch, explicit Discord workspace mapping instead of host root, private env exclusion and normal/abnormal exits"
    return 0

define test_discord_wait with process as Int returning Int:
    set idle to channel
    set waits to create_list()
    set added to append_list(waits and idle)
    repeat while 1 equals 1:
        set result to discord_process_poll(process)
        if result is not equal to 0:
            return result
        set waited to select(waits and 25)
    return -1
