import "../../app/discord/process"
import "select"

define main returning Int:
    if get_argument_count() equals 2:
        if get_argument(1) equals "--child-ok":
            return 0
        return 7
    set arguments to create_list()
    set added to append_list(arguments and "--child-ok")
    set process to discord_process_start(arguments and -1)
    if process <= 0:
        return 1
    set result to test_discord_wait(process)
    if result is not equal to 1:
        return 2
    set failed_arguments to create_list()
    set added to append_list(failed_arguments and "--child-fail")
    set failed to discord_process_start(failed_arguments and -1)
    if failed <= 0 or else test_discord_wait(failed) is not equal to 2:
        return 3
    display "PASS: isolated current-executable child launch and observed normal/abnormal exits"
    return 0

define test_discord_wait with process as Int returning Int:
    set idle to channel
    set waits to create_list()
    set added to append_list(waits and idle)
    repeat while 1 equals 1:
        set result to discord_process_poll(process)
        if result is not equal to 0:
            return result
        set waited to select(waits and 25)
    return -1
