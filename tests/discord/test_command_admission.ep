import "../../app/discord/command_admission"
import "../../app/discord/job_origin"

define auto_admit_fixture with journal as Int and identity as Str and room as Str and prompt as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":" and concat(provider_quote(prompt) and "}]}}"))))))
    set inbox to concat("interaction:" and identity)
    set saved to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and inbox) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [inbox]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_admission_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 1
    set response to concat("{\"id\":" and concat(provider_quote(concat("1" and identity)) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy request received.\",\"interaction_metadata\":{\"id\":" and concat(provider_quote(identity) and ",\"type\":2,\"user\":{\"id\":\"400\"}}}"))))))
    if not (discord_command_anchor_observe(journal and inbox and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else auto_admit_fixture(journal and "701" and "300" and "Keep the exact task, including its punctuation.") is not equal to 0:
        return 3
    set first to discord_command_auto_admit(journal and database and "interaction:701" and "900" and ["200"] and ["400"])
    if not (archive_list_text(first and 0) equals "accepted") or else not (archive_list_text(first and 3) equals "discord-command:interaction:701") or else autonomy_enabled(database and archive_list_text(first and 3)) equals 0:
        return 4
    if not (discord_job_origin(journal and database and "discord-command:interaction:701") equals "interaction:701"):
        return 12
    set foreign to discord_agent_open(concat(get_argument(2) and ".foreign") and "901")
    if not (archive_list_text(discord_command_auto_admit(journal and foreign and "interaction:701" and "900" and ["200"] and ["400"]) and 0) equals "archive-binding-denied") or else string_length(discord_job_origin(journal and foreign and "discord-command:interaction:701")) > 0:
        return 13
    set closed to sql_close(foreign)
    set event to archive_read_event(database and "discord-command:interaction:701:user")
    if event equals 0 or else string_index_of(archive_list_text(event and 3) and "Keep the exact task, including its punctuation.") < 0:
        return 5
    if not (archive_list_text(discord_command_auto_admit(journal and database and "interaction:701" and "900" and ["200"] and create_list()) and 0) equals "admin-required"):
        return 6
    if auto_admit_fixture(journal and "702" and "301" and "") is not equal to 0:
        return 7
    set second to discord_command_auto_admit(journal and database and "interaction:702" and "900" and ["200"] and ["400"])
    if not (archive_list_text(second and 0) equals "accepted") or else autonomy_enabled(database and "discord-command:interaction:701") is not equal to 0 or else autonomy_enabled(database and "discord-command:interaction:702") equals 0:
        return 8
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    set replay to discord_command_auto_admit(journal and database and "interaction:701" and "900" and ["200"] and ["400"])
    if not (archive_list_text(replay and 0) equals "already-accepted") or else autonomy_enabled(database and "discord-command:interaction:701") is not equal to 0 or else autonomy_enabled(database and "discord-command:interaction:702") equals 0:
        return 9
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='discord_command_origin';"))
    if not (archive_list_text(count and 1) equals "2"):
        return 10
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else string_length(discord_job_origin(journal and database and "discord-command:interaction:702")) > 0:
        return 14
    display "PASS: exact slash task admission, empty free-autonomy task, current admin gate, interaction provenance, cross-channel transfer and restart-safe replay without re-enabling old work"
    return 0
