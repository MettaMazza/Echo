import "../../app/discord/message_moderation_options"

external define ep_gc_get_minor_count returning Int

define main returning Int:
    for each body in ["{\"operation\":\"inspect\",\"message\":\"123\"}","{\"operation\":\"delete\",\"message\":\"123\",\"reason\":\"fixture\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"}","{\"operation\":\"clear_reactions\",\"message\":\"123\",\"reason\":\"fixture\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"}","{\"operation\":\"clear_emoji\",\"message\":\"123\",\"reason\":\"fixture\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"emoji\":\"\\ud83c\\udf3f\"}","{\"operation\":\"remove_user_reaction\",\"message\":\"123\",\"reason\":\"fixture\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"emoji\":\"fern:456\",\"user\":\"789\"}"]:
        if not (archive_list_text(discord_message_moderation_options(ptr_to_str(body)) and 0) equals "valid"):
            display ptr_to_str(body)
            return 1
    for each body in ["{}","{\"operation\":\"inspect\",\"message\":\"123\",\"channel\":\"999\"}","{\"operation\":\"inspect\",\"message\":\"123\",\"reason\":\"bad\"}","{\"operation\":\"delete\",\"message\":\"123\",\"reason\":\"x\"}","{\"operation\":\"delete\",\"message\":\"123\",\"reason\":\"x\",\"observed_sha256\":\"GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG\"}","{\"operation\":\"delete\",\"message\":\"123\",\"reason\":\" \",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"}","{\"operation\":\"clear_emoji\",\"message\":\"123\",\"reason\":\"x\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"}","{\"operation\":\"remove_user_reaction\",\"message\":\"123\",\"reason\":\"x\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"emoji\":\"\\ud83c\\udf3f\",\"user\":\"../5\"}","{\"operation\":\"clear_reactions\",\"message\":\"123\",\"reason\":\"x\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"user\":\"5\"}"]:
        if archive_list_text(discord_message_moderation_options(ptr_to_str(body)) and 0) equals "valid":
            display ptr_to_str(body)
            return 2
    set header to discord_audit_reason("Reason: café\r\nX-Forged: injected")
    if string_contains(header and "\r") is not equal to 0 or else string_contains(header and "\n") is not equal to 0 or else string_contains(header and "%0D%0A") equals 0 or else string_contains(header and "%C3%A9") equals 0:
        return 3
    set long_reason to ""
    set reason_index to 0
    repeat while reason_index < 513:
        set long_reason to concat(long_reason and "x")
        set reason_index to reason_index + 1
    if string_length(discord_audit_reason("")) is not equal to 0 or else string_length(discord_audit_reason(long_reason)) is not equal to 0:
        return 4
    set body to "{\"id\":\"123\",\"channel_id\":\"300\",\"author\":{\"id\":\"400\",\"username\":\"fixture\",\"email\":\"private-sentinel\"},\"content\":\"test\",\"timestamp\":\"now\",\"reactions\":[{\"count\":1,\"me\":false,\"emoji\":{\"id\":null,\"name\":\"\\ud83c\\udf3f\"}}],\"referenced_message\":{\"content\":\"excluded-sentinel\"}}"
    set view to discord_message_moderation_view(body and "300" and "123")
    if string_length(view) equals 0 or else string_contains(view and ep_sha256(body)) equals 0 or else string_contains(view and "private-sentinel") is not equal to 0 or else string_contains(view and "excluded-sentinel") is not equal to 0:
        return 5
    if string_length(discord_message_moderation_view(body and "999" and "123")) is not equal to 0 or else string_length(discord_message_moderation_view(body and "300" and "456")) is not equal to 0:
        return 6
    set before to ep_gc_get_minor_count()
    set iterations to 0
    repeat while ep_gc_get_minor_count() equals before and iterations < 2000:
        set view to discord_message_moderation_view(body and "300" and "123")
        if string_length(view) equals 0 or else string_contains(view and ep_sha256(body)) equals 0:
            return 7
        set iterations to iterations + 1
    if ep_gc_get_minor_count() equals before:
        return 8
    display "PASS: strict moderation scope/options, expected revision, URI-safe audit reason, private-field projection and collection stability."
    return 0
