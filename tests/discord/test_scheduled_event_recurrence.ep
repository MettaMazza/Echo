import "../../app/discord/scheduled_event_recurrence"

define main returning Int:
    set valid to create_list()
    set added to append_list(valid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_weekday\": [2]}")
    set added to append_list(valid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 2, \"by_weekday\": [6]}")
    set added to append_list(valid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 3, \"interval\": 1, \"by_weekday\": [0, 1, 2, 3, 4]}")
    set added to append_list(valid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 1, \"interval\": 1, \"by_n_weekday\": [{\"n\": 4, \"day\": 2}]}")
    set added to append_list(valid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 0, \"interval\": 1, \"by_month\": [2], \"by_month_day\": [29]}")
    set added to append_list(valid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_weekday\": null}")
    for each item in valid:
        set fields to provider_json_tokens(ptr_to_str(item))
        if discord_event_recurrence(fields and 0) is not equal to 1:
            display ptr_to_str(item)
            return 1
    set invalid to create_list()
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 4, \"interval\": 1}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 0}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 3, \"interval\": 2}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_weekday\": [2, 2]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_weekday\": [1, 2]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 3, \"interval\": 1, \"by_weekday\": [1, 3]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 3, \"interval\": 1, \"by_weekday\": [0, 1, 2, 3, 4, 5, 6]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 1, \"interval\": 1, \"by_n_weekday\": [{\"n\": 0, \"day\": 2}]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 1, \"interval\": 1, \"by_n_weekday\": [{\"n\": 1, \"day\": 7}]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_n_weekday\": [{\"n\": 1, \"day\": 2}]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 0, \"interval\": 1, \"by_month\": [4], \"by_month_day\": [31]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 0, \"interval\": 1, \"by_month\": [4]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_month\": [4], \"by_month_day\": [1]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 0, \"interval\": 1, \"by_month\": [4, 5], \"by_month_day\": [1]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"count\": 2}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"end\": null}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_year_day\": [1]}")
    set added to append_list(invalid and "{\"start\": \"tomorrow\", \"frequency\": 2, \"interval\": 1}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 2, \"interval\": 1, \"by_weekday\": [\"2\"]}")
    set added to append_list(invalid and "{\"start\": \"2026-11-01T09:00:00Z\", \"frequency\": 1, \"interval\": 1, \"by_n_weekday\": [{\"n\": 1, \"day\": 2, \"extra\": true}]}")
    for each item in invalid:
        set fields to provider_json_tokens(ptr_to_str(item))
        if discord_event_recurrence(fields and 0) is not equal to 0:
            display ptr_to_str(item)
            return 2
    display "PASS: recurrence enums, valid daily/weekly/monthly/yearly patterns, interval and mutually exclusive field rules, null fields and malformed values."
    return 0
