import "../../app/discord/worker_delivery"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_worker_schema(journal) is not equal to 0:
        return 2
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{}")
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 0) equals "claimed") or else not (archive_list_text(claimed and 1) equals "message:create:100"):
        return 3
    set second to discord_worker_claim(journal)
    if not (archive_list_text(second and 0) equals "end"):
        return 4
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set second to discord_worker_claim(journal)
    if not (archive_list_text(second and 0) equals "end"):
        return 5
    if not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "recorded") or else not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "not-claimed"):
        return 6
    set recorded to discord_inbox_record(journal and "message:redirect:101" and "MESSAGE_CREATE" and "{\"admission\":\"redirect-dm\",\"id\":\"101\",\"channel_id\":\"301\",\"author_id\":\"501\"}")
    set redirect to discord_worker_claim(journal)
    if not (archive_list_text(redirect and 1) equals "message:redirect:101") or else not (discord_redirect_enqueue(journal and "message:redirect:101") equals "enqueued") or else not (discord_redirect_enqueue(journal and "message:redirect:101") equals "redirect-suppressed"):
        return 7
    set queued to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox WHERE channel='301' AND json_array_length(body,'$.allowed_mentions.parse')=0;"))
    if not (archive_list_text(queued and 1) equals "1"):
        return 8
    set recorded to discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and "{\"id\":\"102\",\"channel_id\":\"302\",\"author\":{\"id\":\"502\"}}")
    set recorded to discord_inbox_record(journal and "message:create:103" and "MESSAGE_CREATE" and "{\"id\":\"103\",\"channel_id\":\"302\",\"author\":{\"id\":\"502\"}}")
    set recorded to discord_inbox_record(journal and "message:create:104" and "MESSAGE_CREATE" and "{\"id\":\"104\",\"channel_id\":\"303\",\"author\":{\"id\":\"502\"}}")
    set first to discord_worker_claim(journal)
    set independent to discord_worker_claim(journal)
    set blocked to discord_worker_claim(journal)
    if not (archive_list_text(first and 1) equals "message:create:102") or else not (archive_list_text(independent and 1) equals "message:create:104") or else not (archive_list_text(blocked and 0) equals "end"):
        return 9
    if not (discord_worker_finish(journal and "message:create:102" and "enqueued") equals "recorded"):
        return 10
    set resumed to discord_worker_claim(journal)
    if not (archive_list_text(resumed and 1) equals "message:create:103"):
        return 11
    display "PASS: durable nonduplicate claims, per-conversation order, independent-conversation progress and terminal receipts"
    return 0
