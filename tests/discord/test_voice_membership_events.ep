import "../../app/discord/voice_membership_events"

define main returning Int:
    set state to discord_voice_membership_new("100" and "200" and "300" and 1)
    set joined to "{\"guild_id\":\"100\",\"user_id\":\"400\",\"channel_id\":\"200\",\"session_id\":\"member\"}"
    if not (discord_voice_membership_event(state and 1 and 11 and joined) equals "await-membership-snapshot"):
        return 1
    set duplicate to "{\"id\":\"100\",\"voice_states\":[{\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"bot\"},{\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"other\"}]}"
    if not (discord_voice_membership_snapshot(state and 1 and 10 and duplicate) equals "duplicate-membership-user") or else get_list(state and 2) is not equal to 0:
        return 2
    set snapshot to "{\"id\":\"100\",\"voice_states\":[{\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"bot\"},{\"user_id\":\"500\",\"channel_id\":\"201\",\"session_id\":\"other-channel\"}]}"
    if not (discord_voice_membership_snapshot(state and 1 and 10 and snapshot) equals "membership-seeded") or else length_list(discord_voice_membership_roster(state and 1)) is not equal to 1:
        return 3
    if not (discord_voice_membership_event(state and 2 and 11 and joined) equals "stale-membership-generation") or else not (discord_voice_membership_event(state and 1 and 11 and joined) equals "membership-changed"):
        return 4
    if length_list(discord_voice_membership_roster(state and 1)) is not equal to 2 or else not (discord_voice_membership_snapshot(state and 1 and 10 and snapshot) equals "membership-already-seeded"):
        return 5
    set missing to "{\"guild_id\":\"100\",\"user_id\":\"400\"}"
    if not (discord_voice_membership_event(state and 1 and 12 and missing) equals "invalid-membership-event") or else get_list(state and 1) is not equal to 11:
        return 6
    set empty_channel to "{\"guild_id\":\"100\",\"user_id\":\"400\",\"channel_id\":\"\"}"
    if not (discord_voice_membership_event(state and 1 and 12 and empty_channel) equals "invalid-membership-event"):
        return 11
    set leave to "{\"guild_id\":\"100\",\"user_id\":\"400\",\"channel_id\":null}"
    if not (discord_voice_membership_event(state and 1 and 10 and leave) equals "duplicate-or-stale-membership-event") or else length_list(discord_voice_membership_roster(state and 1)) is not equal to 2:
        return 7
    if not (discord_voice_membership_event(state and 1 and 12 and leave) equals "membership-changed") or else length_list(discord_voice_membership_roster(state and 1)) is not equal to 1:
        return 8
    if not (discord_voice_membership_event(state and 1 and 11 and joined) equals "duplicate-or-stale-membership-event"):
        return 9
    set bot_leave to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":null}"
    if not (discord_voice_membership_event(state and 1 and 13 and bot_leave) equals "bot-left-channel") or else discord_voice_membership_roster(state and 1) is not equal to 0:
        return 10
    display "PASS: atomic Gateway voice snapshot and ordered voice-state events populate scoped roster; duplicates, missing fields, stale generations and bot departure handled."
    return 0
