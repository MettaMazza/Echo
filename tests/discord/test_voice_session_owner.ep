import "../../app/discord/gateway_intake"
import "../../app/discord/voice_session_owner"

define fixture_session_prepare with journal as Int and identity as Str and guild as Str and path as Str returning List:
    set row to history_collect_one(archive_prepare(journal and "SELECT sequence FROM discord_gateway WHERE singleton=1;"))
    set sequence to string_to_int(archive_list_text(row and 1))
    set evidence to ep_sha256("access")
    set requested to discord_voice_intent_request(journal and identity and guild and "200" and "400" and "run" and identity and evidence)
    set claimed to discord_voice_intent_claim(journal and identity and "generation" and sequence and evidence)
    set written to discord_voice_intent_written(journal and identity and archive_list_text(claimed and 1) and 1)
    set own to concat("{\"guild_id\":" and concat(provider_quote(guild) and ",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"fixture-session\"}"))
    set recorded to discord_gateway_dispatch_voice(journal and "generation" and "session" and sequence + 1 and "VOICE_STATE_UPDATE" and ep_sha256(own) and "" and "" and own)
    set server to concat("{\"guild_id\":" and concat(provider_quote(guild) and ",\"token\":\"fixture-token\",\"endpoint\":\"fixture.discord.media:443\"}"))
    set recorded to discord_gateway_dispatch_private_voice(journal and "generation" and "session" and sequence + 2 and "VOICE_SERVER_UPDATE" and ep_sha256(server) and "" and "" and "" and server and "300")
    set handoff to discord_voice_handoff_claim(journal and identity and "generation" and "300" and ep_time_now_ms() and 1 and 0)
    if handoff equals 0:
        return 0
    set credentials to discord_voice_handoff_take(handoff)
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and ep_dlopen(path))
    set added to append_list(socket and 1)
    set prepared to create_list()
    set added to append_list(prepared and socket)
    set added to append_list(prepared and credentials)
    set added to append_list(prepared and "200")
    set added to append_list(prepared and 0)
    set binding to create_list()
    set added to append_list(binding and prepared)
    set added to append_list(binding and identity)
    set added to append_list(binding and "generation")
    set added to append_list(binding and "300")
    return binding

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 90
    set journal to discord_store_open(get_argument(1) and "300")
    if discord_gateway_runtime_schema(journal) is not equal to 0 or else discord_voice_session_schema(journal) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(journal and "generation" and "session")
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set library to ep_dlopen(get_argument(2))
    set paths to create_list()
    set paths to ["unused","unused","unused"]
    set binding to fixture_session_prepare(journal and "success" and "100" and get_argument(2))
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set owner to discord_voice_session_activate(journal and binding and paths and 1 and 100 and 3 and 1 and 0)
    if owner equals 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 2
    if discord_voice_session_activate(journal and binding and paths and 1 and 100 and 3 and 1 and 0) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1:
        return 3
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_connections WHERE identity='success';"))
    if not (archive_list_text(row and 1) equals "identified"):
        return 4
    set ticked to discord_voice_session_tick(journal and owner and 1 and 101 and 10001 and 3 and 1 and 0)
    if get_list(get_list(owner and 0) and 3) is not equal to 0:
        return 10
    set ticked to discord_voice_session_tick(journal and owner and 1 and 102 and 10002 and 3 and 1 and 1)
    if not (archive_list_text(ticked and 0) equals "voice-session-revoked") or else ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 5
    set binding to fixture_session_prepare(journal and "stale" and "101" and get_argument(2))
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 6 and "IGNORED" and ep_sha256("changed") and "" and "")
    if discord_voice_session_activate(journal and binding and paths and 2 and 200 and 5 and 1 and 0) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 6
    set binding to fixture_session_prepare(journal and "moved" and "102" and get_argument(2))
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    set moved to "{\"guild_id\":\"102\",\"user_id\":\"300\",\"channel_id\":\"999\",\"session_id\":\"fixture-session\"}"
    set recorded to discord_gateway_dispatch_voice(journal and "generation" and "session" and 9 and "VOICE_STATE_UPDATE" and ep_sha256(moved) and "" and "" and moved)
    if discord_voice_session_activate(journal and binding and paths and 3 and 300 and 9 and 1 and 0) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 0:
        return 7
    set binding to fixture_session_prepare(journal and "lost-outcome" and "103" and get_argument(2))
    set injected to sql_execute(journal and "CREATE TRIGGER fixture_activation_failure BEFORE UPDATE ON discord_voice_connections WHEN NEW.state='identified' BEGIN SELECT RAISE(ABORT,'fixture outcome failure'); END;")
    set reset to ep_dlcall1(ep_dlsym(library and "fixture_reset") and 0)
    if discord_voice_session_activate(journal and binding and paths and 4 and 400 and 11 and 1 and 0) is not equal to 0 or else ep_dlcall0(ep_dlsym(library and "fixture_calls")) is not equal to 1 or else ep_dlcall0(ep_dlsym(library and "fixture_cleanups")) is not equal to 1:
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT i.state,c.state FROM discord_voice_intents i JOIN discord_voice_connections c ON c.identity=i.identity WHERE i.identity='lost-outcome';"))
    if not (archive_list_text(row and 1) equals "leave-required") or else not (archive_list_text(row and 2) equals "closed"):
        return 9
    set closed to sql_close(journal)
    set closed to ep_dlclose(library)
    display "PASS: durable voice activation is single-use; fresh cursor and own-state checks precede Identify; stale preparation and lost outcomes close transport and request leave."
    return 0
