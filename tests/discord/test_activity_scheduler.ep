import "../../app/discord/activity_scheduler"

define activity_scheduler_fixture with journal as Int and message as Str returning Int:
    set source to concat("{\"id\":" and concat(provider_quote(message) and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"400\"}}"))
    if not (discord_inbox_record(journal and concat("message:create:" and message) and "MESSAGE_CREATE" and source) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_worker_schema(journal) is not equal to 0 or else activity_scheduler_fixture(journal and "100") is not equal to 0 or else activity_scheduler_fixture(journal and "101") is not equal to 0:
        return 2
    if sql_execute(journal and "INSERT INTO discord_agent_jobs VALUES('message:create:100','completed','fixture',10,0),('message:create:101','claimed','fixture',20,0);") is not equal to 0 or else discord_activity_scheduler_schema(journal) is not equal to 0:
        return 3
    if activity_scheduler_fixture(journal and "102") is not equal to 0 or else sql_execute(journal and "INSERT INTO discord_agent_jobs VALUES('message:create:102','completed','fixture',30,0);") is not equal to 0 or else discord_activity_discover(journal) is not equal to 0:
        return 4
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*),SUM(run='discord-message:100') FROM discord_activity_targets;"))
    if not (archive_list_text(row and 1) equals "2") or else not (archive_list_text(row and 2) equals "0"):
        return 5
    set due to discord_activity_due(journal and 1000)
    if not (archive_list_text(due and 1) equals "discord-message:101"):
        return 6
    if discord_activity_settle(journal and "discord-message:101" and "20" and "awaiting-admission" and 0 and 1000) is not equal to 0:
        return 17
    set admission to history_collect_one(archive_prepare(journal and "SELECT next_ms FROM discord_activity_targets WHERE run='discord-message:101';"))
    if not (archive_list_text(admission and 1) equals "1500"):
        return 18
    if discord_activity_settle(journal and "discord-message:101" and "20" and "delivery:rate-limited" and 0 and 1000) is not equal to 0:
        return 7
    set cooldown to history_collect_one(archive_prepare(journal and "SELECT next_ms FROM discord_activity_targets WHERE run='discord-message:101';"))
    if not (archive_list_text(cooldown and 1) equals "2000"):
        return 19
    set due to discord_activity_due(journal and 1000)
    if not (archive_list_text(due and 1) equals "discord-message:102"):
        return 8
    if discord_activity_settle(journal and "discord-message:102" and "30" and "caught-up" and 1 and 1000) is not equal to 0 or else discord_activity_discover(journal) is not equal to 0:
        return 9
    set due to discord_activity_due(journal and 1000)
    if not (archive_list_text(due and 0) equals "end"):
        return 10
    # A new parent continuation reactivates the same source/stream. A stale
    # finishing tick must not overwrite that new revision's active state.
    if sql_execute(journal and "UPDATE discord_agent_jobs SET state='claimed',updated_ms=40 WHERE inbox='message:create:102';") is not equal to 0 or else discord_activity_discover(journal) is not equal to 0 or else discord_activity_settle(journal and "discord-message:102" and "30" and "caught-up" and 1 and 1000) is not equal to 0:
        return 11
    set due to discord_activity_due(journal and 1000)
    if not (archive_list_text(due and 1) equals "discord-message:102") or else not (archive_list_text(due and 3) equals "40"):
        return 12
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_activity_scheduler_schema(journal) is not equal to 0 or else discord_activity_discover(journal) is not equal to 0:
        return 13
    set row to history_collect_one(archive_prepare(journal and "SELECT inbox_floor FROM discord_activity_activation;"))
    if not (archive_list_text(row and 1) equals "2"):
        return 14
    if sql_execute(journal and "INSERT INTO discord_background_runs VALUES('child-fixture','message:create:100',0,'running','fixture',42,50);") is not equal to 0 or else discord_activity_discover(journal) is not equal to 0:
        return 15
    set row to history_collect_one(archive_prepare(journal and "SELECT inbox FROM discord_activity_targets WHERE run='child-fixture';"))
    if not (archive_list_text(row and 1) equals "message:create:100"):
        return 16
    if not (discord_rate_observe(journal and "GET:member" and "200" and "200" and "x-ratelimit-bucket: members\nx-ratelimit-remaining: 0\nx-ratelimit-reset-after: 4\n" and "{}" and 1000) equals "recorded"):
        return 20
    if discord_activity_settle(journal and "discord-message:101" and "20" and "delivery:source-access:rate-limited" and 0 and 1000) is not equal to 0:
        return 21
    set cooldown to history_collect_one(archive_prepare(journal and "SELECT next_ms FROM discord_activity_targets WHERE run='discord-message:101';"))
    if not (archive_list_text(cooldown and 1) equals "6000"):
        return 22
    if discord_activity_settle(journal and "discord-message:101" and "20" and "delivery:source-access:forbidden" and 0 and 1000) is not equal to 0:
        return 23
    set cooldown to history_collect_one(archive_prepare(journal and "SELECT next_ms FROM discord_activity_targets WHERE run='discord-message:101';"))
    if not (archive_list_text(cooldown and 1) equals "31000"):
        return 24
    display "PASS: no completed-history backfill, active-at-start and new-turn discovery, fair cooldown, terminal sleep, resumed-parent revision protection, persisted watermark and child source"
    return 0
