import "../../app/discord/guild_settings_tool"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"600\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\",\"managed\":false},{\"id\":\"201\",\"position\":10,\"permissions\":\"32\",\"managed\":false}]"
    set requester to "{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]}"
    set bot_member to "{\"user\":{\"id\":\"900\"},\"roles\":[\"201\"]}"
    set requester_limited to "{\"user\":{\"id\":\"400\"},\"roles\":[]}"
    set bot_limited to "{\"user\":{\"id\":\"900\"},\"roles\":[]}"
    set bundle to create_list()
    set bundle to ["observed",server,roles,requester,bot_member,requester,"null"]
    if discord_guild_settings_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 1:
        return 1
    if discord_guild_settings_bundle_allowed(bundle and "201" and "400" and "900") is not equal to 0 or else discord_guild_settings_bundle_allowed(bundle and "200" and "401" and "900") is not equal to 0:
        return 2
    set bundle to ["observed",server,roles,requester_limited,bot_member,requester_limited,"null"]
    if discord_guild_settings_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 0:
        return 3
    set bundle to ["observed",server,roles,requester,bot_limited,requester,"null"]
    if discord_guild_settings_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 0:
        return 4
    set server to "{\"id\":\"200\",\"owner_id\":\"400\"}"
    set bundle to ["observed",server,roles,requester_limited,bot_member,requester_limited,"null"]
    if discord_guild_settings_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 1:
        return 5
    set bundle to ["observed",server,roles,requester_limited,bot_limited,requester_limited,"null"]
    if discord_guild_settings_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 0:
        return 6
    set previous to "{\"name\":\"Test guild\",\"description\":\"Original\",\"region\":\"eu-west\",\"verification_level\":0,\"default_message_notifications\":0,\"explicit_content_filter\":0,\"preferred_locale\":\"en-GB\",\"afk_timeout\":300,\"afk_channel_id\":null,\"system_channel_id\":null,\"system_channel_flags\":0,\"features\":[],\"rules_channel_id\":null,\"safety_alerts_channel_id\":null,\"public_updates_channel_id\":null,\"premium_progress_bar_enabled\":false}"
    set candidate to discord_guild_settings_effective("{\"description\":null}" and previous)
    if string_length(candidate) equals 0:
        return 7
    set fields to provider_json_tokens(candidate)
    if not (provider_kind(fields and provider_member(fields and 0 and "description")) equals "null") or else not (provider_value(fields and provider_member(fields and 0 and "name")) equals "Test guild"):
        return 8
    if string_length(discord_guild_settings_effective("{\"owner_id\":\"400\"}" and previous)) is not equal to 0:
        return 9
    if not (discord_guild_settings_effective("{}" and previous) equals previous):
        return 10
    display "PASS: guild settings permissions bind both identities and guild; owner authority does not bypass bot checks; partial changes preserve omitted settings and explicit null."
    return 0
