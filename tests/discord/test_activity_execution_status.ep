import "../../app/discord/activity_scheduler"

define main returning Int:
    set journal to sql_open(":memory:")
    set database to sql_open(":memory:")
    set made to sql_execute(journal and "CREATE TABLE discord_activity_targets(run TEXT,inbox TEXT,active INTEGER); INSERT INTO discord_activity_targets VALUES('one','source',1);")
    set made to sql_execute(database and "CREATE TABLE echo_runs(run TEXT,session TEXT,objective_event TEXT,state TEXT,last_event TEXT); INSERT INTO echo_runs VALUES('one','session','event','completed','last');")
    if not (discord_activity_execution_title(journal and database and "source") equals "Echo · Idle · delivering activity logs"):
        return 1
    set made to sql_execute(journal and "INSERT INTO discord_activity_targets VALUES('two','source',1);")
    set made to sql_execute(database and "INSERT INTO echo_runs VALUES('two','session','event','generating','last');")
    if not (discord_activity_execution_title(journal and database and "source") equals "Echo · Working · activity log"):
        return 2
    set made to sql_execute(database and "UPDATE echo_runs SET state='waiting' WHERE run='two';")
    if not (discord_activity_execution_title(journal and database and "source") equals "Echo · Idle · delivering activity logs"):
        return 3
    set made to sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='one';")
    if not (discord_activity_execution_title(journal and database and "source") equals "Echo · Working · activity log"):
        return 4
    set closed to sql_close(database)
    set closed to sql_close(journal)
    display "PASS: delivery backlog is idle; running siblings and resumed tools remain working"
    return 0
