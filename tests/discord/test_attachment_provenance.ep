import "../../app/discord/steering_media"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Inspect the retained image.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    set source to "{\"id\":\"100\",\"attachments\":[{\"id\":\"700\",\"filename\":\"fixture.png\",\"size\":1164,\"content_type\":\"image/webp\",\"original_content_type\":\"image/png\"}]}"
    set tokens to provider_json_tokens(source)
    set items to provider_items(tokens and provider_member(tokens and 0 and "attachments"))
    set item to get_list(items and 0)
    set declaration to discord_attachment_declaration(tokens and item)
    set verified to file_digest(get_argument(2) and 65536)
    if not (archive_list_text(verified and 0) equals "verified") or else get_list(verified and 2) is not equal to 1080 or else not (discord_attachment_file_magic(get_argument(2)) equals "image/png"):
        return 5
    set receipt to concat("{\"declaration\":" and provider_quote(declaration))
    set receipt to concat(receipt and concat(",\"received_sha256\":" and provider_quote(archive_list_text(verified and 1))))
    set receipt to concat(receipt and ",\"received_bytes\":\"1080\",\"received_media\":\"image/png\",\"representation\":\"declared-image-rendition\"}")
    if web_attachment_publish_source(database and "foreign" and session and "discord-file:100:700" and get_argument(2) and "fixture.png" and "image/png" and "" and "" and "" and 0 and receipt) equals 0:
        return 6
    set invalid to string_replace(receipt and "\"1080\"" and "\"1079\"")
    if web_attachment_publish_source(database and "owner" and session and "discord-file:100:700" and get_argument(2) and "fixture.png" and "image/png" and "" and "" and "" and 0 and invalid) equals 0:
        return 7
    if web_attachment_publish_source(database and "owner" and session and "discord-file:100:700" and get_argument(2) and "fixture.png" and "image/png" and "" and "" and "" and 0 and receipt) is not equal to 0:
        return 8
    set imported to discord_attachment_import(database and "owner" and session and "300" and "100" and tokens and item and "/private/tmp")
    if not (archive_list_text(imported and 0) equals "imported"):
        display archive_list_text(imported and 0)
        return 9
    if not (archive_list_text(discord_steering_media_selection(database and session and source) and 0) equals "selected"):
        return 10
    set changed to string_replace(source and "original_content_type\":\"image/png" and "original_content_type\":\"image/jpeg")
    if discord_attachment_manifest(source) equals discord_attachment_manifest(changed) or else archive_list_text(discord_steering_media_selection(database and session and changed) and 0) equals "selected":
        return 11
    if discord_attachment_stored_matches(database and "other-session" and "discord-file:100:700" and declaration and "fixture.png" and "image/webp" and "1164") is not equal to 0:
        return 12
    if web_attachment_publish_source(database and "owner" and session and "duplicate" and get_argument(2) and "fixture.png" and "image/png" and "" and "" and "" and 0 and receipt) equals 0:
        return 13
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind IN ('attachment','attachment_source');"))
    if not (archive_list_text(counts and 1) equals "2") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 14
    set database to archive_open(get_argument(1))
    if discord_attachment_stored_matches(database and session and "discord-file:100:700" and declaration and "fixture.png" and "image/webp" and "1164") is not equal to 1:
        return 15
    if web_device_revoke(database and "owner") is not equal to 0 or else archive_list_text(web_attachment_owned(database and "owner" and "discord-file:100:700") and 0) equals "found":
        return 16
    display "PASS: rendition provenance and actual bytes publish atomically, replay and steering retain declared metadata, changed sources/foreign sessions/revoked owners denied, duplicate rollback and reopen preserved."
    return sql_close(database)
