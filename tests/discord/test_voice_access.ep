import "../../app/discord/voice_access"

define main returning Int:
    set database to sql_open(":memory:")
    set guild to "{\"id\":\"100\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"100\",\"permissions\":\"3146752\"}]"
    set actor to "{\"user\":{\"id\":\"300\"},\"roles\":[],\"communication_disabled_until\":null}"
    set bot to "{\"user\":{\"id\":\"400\"},\"roles\":[],\"communication_disabled_until\":null}"
    set room to "{\"id\":\"200\",\"guild_id\":\"100\",\"type\":2,\"permission_overwrites\":[]}"
    set guilds to create_list()
    set guilds to ["100"]
    set admins to create_list()
    set admins to ["300"]
    set allowed to discord_voice_access_snapshots(database and guild and roles and actor and bot and room and "100" and "200" and "300" and "400" and guilds and admins and 1 and 1000)
    if not (allowed equals "allowed"):
        display allowed
        return 1
    set no_speak to "[{\"id\":\"100\",\"permissions\":\"1049600\"}]"
    if not (discord_voice_access_snapshots(database and guild and no_speak and actor and bot and room and "100" and "200" and "300" and "400" and guilds and admins and 0 and 1000) equals "allowed") or else not (discord_voice_access_snapshots(database and guild and no_speak and actor and bot and room and "100" and "200" and "300" and "400" and guilds and admins and 1 and 1000) equals "voice-speak-denied"):
        return 2
    set denied to "{\"id\":\"200\",\"guild_id\":\"100\",\"type\":2,\"permission_overwrites\":[{\"id\":\"400\",\"type\":1,\"allow\":\"0\",\"deny\":\"1048576\"}]}"
    if not (discord_voice_access_snapshots(database and guild and roles and actor and bot and denied and "100" and "200" and "300" and "400" and guilds and admins and 0 and 1000) equals "voice-connect-denied"):
        return 3
    set actor_denied to "{\"id\":\"200\",\"guild_id\":\"100\",\"type\":2,\"permission_overwrites\":[{\"id\":\"300\",\"type\":1,\"allow\":\"0\",\"deny\":\"1048576\"}]}"
    if not (discord_voice_access_snapshots(database and guild and roles and actor and bot and actor_denied and "100" and "200" and "300" and "400" and guilds and admins and 0 and 1000) equals "voice-connect-denied"):
        return 7
    set text_room to "{\"id\":\"200\",\"guild_id\":\"100\",\"type\":0,\"permission_overwrites\":[]}"
    if not (discord_voice_access_snapshots(database and guild and roles and actor and bot and text_room and "100" and "200" and "300" and "400" and guilds and admins and 0 and 1000) equals "unsupported-voice-channel-type"):
        return 8
    set guests to create_list()
    if not (discord_voice_access_snapshots(database and guild and roles and actor and bot and room and "100" and "200" and "300" and "400" and guilds and guests and 1 and 1000) equals "voice-admin-origin-denied"):
        return 4
    set timed_out to "{\"user\":{\"id\":\"400\"},\"roles\":[],\"communication_disabled_until\":\"2099-01-01T00:00:00Z\"}"
    if not (discord_voice_access_snapshots(database and guild and roles and actor and timed_out and room and "100" and "200" and "300" and "400" and guilds and admins and 1 and 1000) equals "voice-member-timeout-or-invalid"):
        return 5
    if not (discord_voice_gateway_state_body("100" and "200" and 1 and 1) equals "{\"op\":4,\"d\":{\"guild_id\":\"100\",\"channel_id\":\"200\",\"self_mute\":true,\"self_deaf\":true}}") or else not (discord_voice_gateway_state_body("100" and "" and 1 and 1) equals "{\"op\":4,\"d\":{\"guild_id\":\"100\",\"channel_id\":null,\"self_mute\":true,\"self_deaf\":true}}"):
        return 6
    set closed to sql_close(database)
    display "PASS: voice access uses view/connect for both identities and bot speak for playback; admin/overwrite/timeout gates and Gateway join/leave bodies verified."
    return 0
