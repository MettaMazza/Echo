import "../../app/discord/gateway_intake"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_gateway_runtime_schema(journal) is not equal to 0:
        return 2
    set ready to "{\"op\":0,\"s\":1,\"t\":\"READY\",\"d\":{\"user\":{\"id\":\"900\"},\"session_id\":\"session-a\",\"resume_gateway_url\":\"wss://gateway-us-east1-b.discord.gg\"}}"
    if not (discord_gateway_ready_record(journal and "socket-a" and "900" and ready) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set original to "{\"type\":3,\"application_id\":\"900\",\"id\":\"700\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"member\":{\"user\":{\"id\":\"500\"}},\"token\":\"synthetic_credential_fixture_1234\",\"data\":{\"component_type\":2,\"custom_id\":\"echo:fixture\"}}"
    set dispatch to concat("{\"op\":0,\"s\":2,\"t\":\"INTERACTION_CREATE\",\"d\":" and concat(original and "}"))
    if not (discord_gateway_intake(journal and "socket-a" and "900" and guilds and admins and dispatch) equals "recorded"):
        return 4
    set row to history_collect_one(archive_prepare(journal and "SELECT json_type(payload,'$.token'),instr(payload,'synthetic_credential'),kind FROM discord_inbox WHERE identity='interaction:700';"))
    if not (archive_list_text(row and 2) equals "0") or else not (archive_list_text(row and 3) equals "INTERACTION_CREATE"):
        return 5
    set row to history_collect_one(archive_prepare(journal and "SELECT j.state,c.expires_ms-c.received_ms,g.sequence FROM discord_interaction_jobs j JOIN discord_interaction_credentials c ON c.identity=j.identity CROSS JOIN discord_gateway g WHERE j.identity='interaction:700';"))
    if not (archive_list_text(row and 1) equals "pending") or else not (archive_list_text(row and 2) equals "900000") or else not (archive_list_text(row and 3) equals "2"):
        return 6
    if not (discord_gateway_intake(journal and "socket-a" and "900" and guilds and admins and dispatch) equals "already-recorded"):
        return 7
    set none to create_list()
    if string_length(discord_interaction_admit(original and "901" and guilds and admins)) > 0 or else string_length(discord_interaction_admit(original and "900" and none and admins)) > 0:
        return 8
    if discord_interaction_credential_valid("synthetic/bad/credential1234") is not equal to 0:
        return 9
    set dm to "{\"type\":3,\"application_id\":\"900\",\"id\":\"701\",\"channel_id\":\"301\",\"user\":{\"id\":\"500\"},\"token\":\"synthetic_credential_fixture_1234\"}"
    if string_length(discord_interaction_admit(dm and "900" and guilds and admins)) > 0:
        return 10
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_gateway_intake(journal and "stale-socket" and "900" and guilds and admins and dispatch) equals "stale-connection"):
        return 11
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_interaction_jobs;"))
    if not (archive_list_text(row and 1) equals "1"):
        return 12
    # Slash dispatch shares credential isolation, atomic intake and ACK queue.
    # Admission alone does not authorize or execute any command.
    set slash to "{\"type\":2,\"application_id\":\"900\",\"id\":\"702\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"member\":{\"user\":{\"id\":\"500\"}},\"token\":\"synthetic_slash_credential_1234\",\"data\":{\"type\":1,\"id\":\"800\",\"name\":\"new\"}}"
    set dispatch to concat("{\"op\":0,\"s\":3,\"t\":\"INTERACTION_CREATE\",\"d\":" and concat(slash and "}"))
    if not (discord_gateway_intake(journal and "socket-a" and "900" and guilds and admins and dispatch) equals "recorded") or else not (discord_gateway_intake(journal and "socket-a" and "900" and guilds and admins and dispatch) equals "already-recorded"):
        return 13
    set row to history_collect_one(archive_prepare(journal and "SELECT j.state,instr(i.payload,'synthetic_slash'),json_extract(i.payload,'$.type'),g.sequence FROM discord_interaction_jobs j JOIN discord_inbox i ON i.identity=j.identity CROSS JOIN discord_gateway g WHERE j.identity='interaction:702';"))
    if not (archive_list_text(row and 1) equals "pending") or else not (archive_list_text(row and 2) equals "0") or else not (archive_list_text(row and 3) equals "2") or else not (archive_list_text(row and 4) equals "3"):
        return 14
    if string_length(discord_interaction_admit(slash and "901" and guilds and admins)) > 0 or else string_length(discord_interaction_admit(slash and "900" and none and admins)) > 0:
        return 15
    set modal to "{\"type\":5,\"application_id\":\"900\",\"id\":\"703\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"member\":{\"user\":{\"id\":\"500\"}},\"token\":\"synthetic_modal_credential_1234\",\"data\":{\"custom_id\":\"echoqc:fixture\",\"components\":[]}}"
    set dispatch to concat("{\"op\":0,\"s\":4,\"t\":\"INTERACTION_CREATE\",\"d\":" and concat(modal and "}"))
    if not (discord_gateway_intake(journal and "socket-a" and "900" and guilds and admins and dispatch) equals "recorded") or else not (discord_gateway_intake(journal and "socket-a" and "900" and guilds and admins and dispatch) equals "already-recorded"):
        return 16
    set row to history_collect_one(archive_prepare(journal and "SELECT j.state,instr(i.payload,'synthetic_modal'),json_extract(i.payload,'$.type'),g.sequence FROM discord_interaction_jobs j JOIN discord_inbox i ON i.identity=j.identity CROSS JOIN discord_gateway g WHERE j.identity='interaction:703';"))
    if not (archive_list_text(row and 1) equals "pending") or else not (archive_list_text(row and 2) equals "0") or else not (archive_list_text(row and 3) equals "5") or else not (archive_list_text(row and 4) equals "4"):
        return 17
    if string_length(discord_interaction_admit(modal and "901" and guilds and admins)) > 0 or else string_length(discord_interaction_admit(modal and "900" and none and admins)) > 0:
        return 18
    set dm_modal to "{\"type\":5,\"application_id\":\"900\",\"id\":\"704\",\"channel_id\":\"301\",\"user\":{\"id\":\"500\"},\"token\":\"synthetic_modal_credential_1234\"}"
    if string_length(discord_interaction_admit(dm_modal and "900" and guilds and admins)) > 0:
        return 19
    display "PASS: component, slash and modal scoped admission, credential-free immutable payload, atomic ACK queue/cursor, replay/reopen identity, stale socket and foreign scope denial"
    return 0
