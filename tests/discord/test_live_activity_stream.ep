import "../../app/discord/activity_worker"

# Explicit host qualification of one already admitted source/run. Never
# discovers historical conversations or posts the prompt into its thread.
# Arguments: curl, token file, journal, agent DB, private HTTP spool, stop,
# bot, admins CSV, original inbox, original run.
define main returning Int:
    if get_argument_count() is not equal to 11:
        return 1
    set library to ep_dlopen(get_argument(1))
    if library equals 0:
        return 2
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 3
    set token to string_trim(ptr_to_str(credential))
    set journal to discord_store_open(get_argument(3) and get_argument(7))
    set database to discord_agent_open(get_argument(4) and get_argument(7))
    if journal equals 0 or else database equals 0 or else discord_delivery_schema(journal) is not equal to 0:
        return 4
    set admins to string_split(get_argument(8) and ",")
    set count to 0
    set result to ""
    repeat while count < 256:
        set count to count + 1
        set result to discord_activity_worker_tick(get_argument(1) and token and journal and database and get_argument(9) and get_argument(10) and get_argument(7) and admins and get_argument(5) and get_argument(6))
        display result
        if result equals "caught-up":
            set closed to sql_close(database)
            set closed to sql_close(journal)
            set closed to ep_dlclose(library)
            return 0
        if not (result equals "advanced" or else result equals "part-sent"):
            return 5
    return 6
