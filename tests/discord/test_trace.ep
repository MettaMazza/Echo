import "../../app/discord/trace"
import "../../app/discord/agent_bridge"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else not (delegation_schema(database) equals "applied"):
        return 12
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Trace fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 2
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 3
    set session to archive_list_text(submitted and 1)
    if archive_append(database and session and "trace-request" and "model_request" and "{\"run_id\":\"discord-message:100\"}" and "fixture") is not equal to 0:
        return 4
    set delta to "{\"request_event\":\"trace-request\",\"data\":\"{\\\"choices\\\":[{\\\"index\\\":0,\\\"delta\\\":{\\\"reasoning_content\\\":\\\"Recorded reasoning fixture.\\\"}}]}\"}"
    if archive_append(database and session and "trace-delta" and "provider_event" and delta and "fixture") is not equal to 0:
        return 5
    if archive_append(database and session and "trace-tool" and "tool_result" and "{\"run_id\":\"discord-message:100\",\"result\":\"Actual fixture receipt.\"}" and "fixture") is not equal to 0:
        return 6
    # Same session alone does not authorize another run's trace.
    if archive_append(database and session and "other-request" and "model_request" and "{\"run_id\":\"other-run\"}" and "fixture") is not equal to 0 or else archive_append(database and session and "other-tool" and "tool_result" and "{\"run_id\":\"other-run\",\"result\":\"FOREIGN_TRACE_CANARY\"}" and "fixture") is not equal to 0:
        return 7
    set trace to discord_run_trace(journal and database and "message:create:100" and "discord-message:100" and 0 and 100)
    if string_index_of(trace and "Recorded reasoning fixture.") < 0 or else string_index_of(trace and "Actual fixture receipt.") < 0 or else string_index_of(trace and "FOREIGN_TRACE_CANARY") >= 0:
        display trace
        return 8
    if not (discord_run_trace(journal and database and "message:create:999" and "discord-message:100" and 0 and 100) equals "{\"status\":\"scope-denied\"}"):
        return 9
    set text to ""
    set count to 0
    repeat while count < 1000:
        set text to concat(text and "🎧")
        set count to count + 1
    set first to discord_trace_chunk(text and 0)
    set second to discord_trace_chunk(text and string_length(first))
    set third to discord_trace_chunk(text and string_length(first) + string_length(second))
    if not (concat(first and concat(second and third)) equals text) or else string_length(first) > 1800 or else string_length(discord_trace_chunk(text and 1)) > 0:
        return 10
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else not (discord_run_trace(journal and database and "message:create:100" and "discord-message:100" and 0 and 100) equals "{\"status\":\"scope-denied\"}"):
        return 11
    display "PASS: original reasoning/tool projection, wrong-source and same-session isolation, revocation, lossless UTF-8 chunks"
    return 0
