import "../../app/discord/agent_turn"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set cancellation to socket_cancellation_create(library)
    set stop to socket_cancellation_create(library)
    if journal equals 0 or else library equals 0 or else cancellation equals 0 or else stop equals 0:
        return 2
    set completed to channel
    spawn discord_turn_monitor(get_argument(1) and "900" and 0 and "100" and "300" and "200" and concat(get_argument(1) and ".stop") and get_list(stop and 0) and get_list(cancellation and 1) and completed)
    set recorded to discord_inbox_record(journal and "revision:1" and "MESSAGE_DELETE" and "{\"id\":\"100\",\"channel_id\":\"300\"}")
    if not (recorded equals "recorded"):
        return 3
    set result to receive from completed
    if result is not equal to 0 or else agent_cancellation_pending(library and get_list(cancellation and 0)) equals 0:
        return 4
    set closed to net_close(get_list(stop and 1))
    set closed to net_close(get_list(cancellation and 0))
    set closed to ep_dlclose(library)
    set closed to sql_close(journal)
    display "PASS: retained source deletion wakes the native inference cancellation pipe"
    return 0
