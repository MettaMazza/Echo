define recording_authority_submit with journal as Int and database as Int and identity as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Authorised voice test\"}"))
    set inbox to concat("message:create:" and identity)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals inbox):
        return 2
    set submitted to discord_agent_submit(journal and database and inbox and "900" and ["200"] and ["500"])
    if not (archive_list_text(submitted and 0) equals "accepted"):
        display archive_list_text(submitted and 0)
        return 3
    return 0

define recording_authority_generate with database as Int and run as Str and request as Str and operation as Str returning Int:
    set listener to local_socket_listen(0)
    set arguments to concat("{\"operation\":" and concat(provider_quote(operation) and ",\"intent\":\"voice-intent\"}"))
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"voice-call\",\"function\":{\"name\":\"discord_voice\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and run and request and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    return generated + served

define recording_authority_check with journal as Int and database as Int and expected as Str returning Int:
    set result to discord_voice_recording_guard(journal and database and "recording" and "900" and ["200"] and ["500"] and "/absent-fixture-stop")
    if not (archive_list_text(result and 0) equals expected):
        display concat("Expected " and concat(expected and concat("; got " and archive_list_text(result and 0))))
        return 1
    return 0

define capture_consent with journal as Int and offer as Str and interaction as Str and decision as Str and participants as List returning Str:
    set custom to concat("echo:record:" and concat(offer and concat(":" and decision)))
    set body to concat("{\"id\":" and concat(provider_quote(interaction) and ",\"type\":3,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"message\":{\"id\":\"710\",\"author\":{\"id\":\"900\"}},\"member\":{\"user\":{\"id\":\"500\"}},\"data\":{\"custom_id\":"))
    set body to concat(body and concat(provider_quote(custom) and "}}"))
    set inbox to concat("interaction:" and interaction)
    set recorded to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    set cursor to history_collect_one(archive_prepare(journal and "SELECT sequence FROM discord_gateway WHERE singleton=1;"))
    return discord_voice_recording_consent_at(journal and offer and inbox and participants and 1 and "generation" and "session" and string_to_int(archive_list_text(cursor and 1)))

define main returning Int:
    if (get_argument_count() is not equal to 12 and also get_argument_count() is not equal to 13) or else file_exists(get_argument(8)) or else file_exists(get_argument(9)):
        return 90
    set database to discord_agent_open(get_argument(8) and "900")
    if database equals 0 or else web_cancel_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set admin to discord_agent_principal(database and "500" and ["500"])
    set journal to discord_store_open(get_argument(9) and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0 or else discord_voice_recording_schema(journal) is not equal to 0:
        return 3
    if recording_authority_submit(journal and database and "100") is not equal to 0 or else recording_authority_generate(database and "discord-message:100" and "join-request" and "join") is not equal to 0:
        return 4
    set requested to discord_voice_intent_request(journal and "voice-intent" and "200" and "600" and "500" and "discord-message:100" and "voice-call" and ep_sha256("fixture-access"))
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET state='sent' WHERE identity='voice-intent';")
    # Model the completed join before admitting the later recording request.
    set changed to sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='discord-message:100'; UPDATE echo_tool_calls SET state='observed' WHERE run='discord-message:100';")
    set changed to sql_execute(journal and "UPDATE discord_agent_jobs SET state='enqueued' WHERE inbox='message:create:100';")
    if recording_authority_submit(journal and database and "101") is not equal to 0 or else recording_authority_generate(database and "discord-message:101" and "record-request" and "record") is not equal to 0:
        return 5
    set request to history_collect_one(archive_prepare(database and "SELECT request_event FROM echo_tool_calls WHERE run='discord-message:101' AND call_id='voice-call';"))
    if not (discord_voice_recording_request(journal and "recording" and "voice-intent" and "500" and "300" and archive_list_text(request and 1)) equals "pending-notice"):
        return 6
    if recording_authority_check(journal and database and "recording-native-current") is not equal to 0:
        return 7
    if discord_gateway_schema(journal) is not equal to 0:
        return 30
    set bound to discord_gateway_bind(journal and "generation" and "session")
    set recorded to discord_gateway_dispatch(journal and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    if discord_gateway_voice_schema(journal) is not equal to 0 or else discord_voice_recording_offer_schema(journal) is not equal to 0:
        return 40
    set baseline to "{\"id\":\"200\",\"voice_states\":[{\"user_id\":\"900\",\"channel_id\":\"600\",\"session_id\":\"bot-session\"},{\"user_id\":\"500\",\"channel_id\":\"600\",\"session_id\":\"human-session\"}]}"
    set recorded to discord_gateway_voice_record(journal and "session" and 1 and "GUILD_CREATE" and baseline)
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET generation='generation',gateway_session='session' WHERE identity='voice-intent';")
    set recorded to discord_gateway_voice_record(journal and "session" and 2 and "VOICE_STATE_UPDATE" and "{\"guild_id\":\"200\",\"user_id\":\"900\",\"channel_id\":\"600\",\"session_id\":\"bot-session\"}")
    set changed to sql_execute(journal and "UPDATE discord_gateway SET sequence=2 WHERE singleton=1; UPDATE discord_voice_intents SET after_sequence=0 WHERE identity='voice-intent';")
    if discord_voice_handoff_schema(journal) is not equal to 0 or else discord_voice_session_schema(journal) is not equal to 0:
        return 100
    # Fixture durable owner matches the native peer connection assembled below.
    set changed to sql_execute(journal and "INSERT INTO discord_voice_handoffs VALUES('voice-intent','900','','',2,9999999999999,1); INSERT INTO discord_voice_connections VALUES('voice-intent','generation','identified');")
    set rest_fixture to ep_dlopen(get_argument(10))
    set configured to ep_dlcall2(ep_dlsym(rest_fixture and "fixture_configure") and 0 and str_to_ptr(get_argument(9)))
    set delivered to discord_voice_recording_deliver(get_argument(10) and "fixture-token-no-network-123456" and journal and database and "recording" and "" and "900" and ["200"] and ["500"] and get_argument(11) and "/absent-fixture-stop")
    if not (delivered equals "active"):
        display delivered
        return 101
    set offer to ep_sha256("capture-consent-offer")
    set offered to discord_voice_recording_offer(journal and offer and "recording" and "500" and "human-session")
    set delivered to discord_voice_recording_deliver(get_argument(10) and "fixture-token-no-network-123456" and journal and database and "recording" and offer and "900" and ["200"] and ["500"] and get_argument(11) and "/absent-fixture-stop")
    if not (delivered equals "recording-offer-bound"):
        display delivered
        return 102
    set fixture to ep_dlopen(get_argument(3))
    if fixture equals 0:
        return 1
    set round to 0
    repeat while round < 1:
        set left to discord_dave_open(get_argument(1) and get_argument(2) and 1 and 600 and "500")
        set right to discord_dave_open(get_argument(1) and get_argument(2) and 1 and 600 and "900")
        if left equals 0 or else right equals 0:
            return 2
        set library to get_list(left and 0)
        set sender to ep_dlcall1(ep_dlsym(fixture and "daveExternalSenderCreate") and 600)
        if sender equals 0:
            return 3
        set raw to research_native_words(1)
        set size to research_native_words(1)
        set fetched to ep_dlcall3(ep_dlsym(fixture and "daveExternalSenderGetMarshalledExternalSender") and sender and get_list_data_ptr(raw) and get_list_data_ptr(size))
        set sender_bytes to discord_dave_owned_copy(library and get_list(raw and 0) and get_list(size and 0))
        set users to create_list()
        set users to ["500","900"]
        set external_a to fixture_receive(left and 65535 and 25 and -1 and sender_bytes and users)
        set external_b to fixture_receive(right and 65535 and 25 and -1 and sender_bytes and users)
        if not (archive_list_text(external_a and 0) equals "external-sender") or else not (archive_list_text(external_b and 0) equals "external-sender") or else get_list(external_a and 1) is not equal to 65535:
            return 4
        set released to discord_voice_blob_release(sender_bytes)
        set package to discord_dave_key_package(right)
        if package equals 0:
            return 5
        set raw to research_native_words(1)
        set size to research_native_words(1)
        set key_wire to discord_voice_mls_outbound(26 and get_list(package and 0) and get_list(package and 1))
        if key_wire equals 0 or else get_list(key_wire and 1) is not equal to get_list(package and 1) + 1 or else peek_byte(get_list(key_wire and 0) and 0) is not equal to 26:
            return 25
        set byte_index to 0
        repeat while byte_index < get_list(package and 1):
            if peek_byte(get_list(key_wire and 0) and byte_index + 1) is not equal to peek_byte(get_list(package and 0) and byte_index):
                return 26
            set byte_index to byte_index + 1
        set released to discord_voice_blob_release(key_wire)
        set proposed to ep_dlcall6(ep_dlsym(fixture and "daveExternalSenderProposeAdd") and sender and 0 and get_list(package and 0) and get_list(package and 1) and get_list_data_ptr(raw) and get_list_data_ptr(size))
        set proposal to discord_dave_owned_copy(library and get_list(raw and 0) and get_list(size and 0))
        set released to discord_voice_blob_release(package)
        if proposal equals 0:
            return 6
        set users to create_list()
        set users to ["500","900"]
        set processed to fixture_receive(left and 0 and 27 and -1 and proposal and users)
        set released to discord_voice_blob_release(proposal)
        if not (archive_list_text(processed and 0) equals "send-commit-welcome"):
            display archive_list_text(processed and 0)
            return 7
        set combined to get_list(processed and 3)
        if get_list(processed and 1) is not equal to 0 or else get_list(processed and 2) is not equal to -1 or else peek_byte(get_list(combined and 0) and 0) is not equal to 28:
            return 20
        set commit_pointer to research_native_words(1)
        set commit_size to research_native_words(1)
        set welcome_pointer to research_native_words(1)
        set welcome_size to research_native_words(1)
        set split to ep_dlcall7(ep_dlsym(fixture and "daveExternalSenderSplitCommitWelcome") and sender and get_list(combined and 0) + 1 and get_list(combined and 1) - 1 and get_list_data_ptr(commit_pointer) and get_list_data_ptr(commit_size) and get_list_data_ptr(welcome_pointer) and get_list_data_ptr(welcome_size))
        set commit to discord_dave_owned_copy(library and get_list(commit_pointer and 0) and get_list(commit_size and 0))
        set welcome to discord_dave_owned_copy(library and get_list(welcome_pointer and 0) and get_list(welcome_size and 0))
        set released to discord_voice_blob_release(combined)
        if commit equals 0 or else welcome equals 0:
            return 8
        set current_users to create_list()
        set current_users to users
        if round equals 1:
            set current_users to ["500"]
        set commit_wire to fixture_receive(left and 1 and 29 and 512 and commit and current_users)
        set committed to get_list(commit_wire and 3)
        set welcome_wire to fixture_receive(right and 1 and 30 and 512 and welcome and current_users)
        set joined to get_list(welcome_wire and 3)
        if get_list(commit_wire and 2) is not equal to 512 or else get_list(welcome_wire and 2) is not equal to 512:
            return 21
        set released to discord_voice_blob_release(commit)
        set released to discord_voice_blob_release(welcome)
        if round equals 0:
            if not (archive_list_text(committed and 0) equals "committed") or else not (archive_list_text(joined and 0) equals "joined"):
                return 9
            set roster to get_list(committed and 1)
            set other_roster to get_list(joined and 1)
            if length_list(roster) is not equal to 2 or else length_list(other_roster) is not equal to 2 or else not (archive_list_text(roster and 0) equals archive_list_text(other_roster and 0)) or else not (archive_list_text(roster and 1) equals archive_list_text(other_roster and 1)):
                return 10
            set auth_a to research_native_words(1)
            set auth_b to research_native_words(1)
            set size_a to research_native_words(1)
            set size_b to research_native_words(1)
            set fetched to ep_dlcall3(ep_dlsym(library and "daveSessionGetLastEpochAuthenticator") and get_list(left and 1) and get_list_data_ptr(auth_a) and get_list_data_ptr(size_a))
            set fetched to ep_dlcall3(ep_dlsym(library and "daveSessionGetLastEpochAuthenticator") and get_list(right and 1) and get_list_data_ptr(auth_b) and get_list_data_ptr(size_b))
            if get_list(size_a and 0) < 1 or else get_list(size_a and 0) is not equal to get_list(size_b and 0):
                return 11
            set index to 0
            repeat while index < get_list(size_a and 0):
                if peek_byte(get_list(auth_a and 0) and index) is not equal to peek_byte(get_list(auth_b and 0) and index):
                    return 12
                set index to index + 1
            set released to ep_dlcall1(ep_dlsym(library and "daveFree") and get_list(auth_a and 0))
            set released to ep_dlcall1(ep_dlsym(library and "daveFree") and get_list(auth_b and 0))
            set socket_library to ep_dlopen(get_argument(4))
            set socket to create_list()
            set added to append_list(socket and "connected")
            set added to append_list(socket and socket_library)
            set added to append_list(socket and 1)
            set handshake to discord_voice_handshake_new(1)
            set changed to set_list(handshake and 0 and 4)
            set changed to set_list(handshake and 2 and 12345)
            set transport to create_list()
            set added to append_list(transport and handshake)
            set added to append_list(transport and socket)
            set added to append_list(transport and 0)
            set added to append_list(transport and 0)
            set added to append_list(transport and left)
            set added to append_list(transport and create_list())
            set added to append_list(transport and 600)
            set added to append_list(transport and "500")
            set io_state to discord_voice_io_new(transport and 100)
            set controller to discord_voice_media_controller_new(io_state and get_argument(1) and 1)
            if controller equals 0 or else discord_voice_media_controller_media(controller and "500" and 1 and 1) is not equal to 0:
                return 30
            set reset to ep_dlcall1(ep_dlsym(socket_library and "fixture_reset") and 0)
            if not (discord_voice_media_controller_dispatch(controller and commit_wire and roster) equals "media-transition-prepared") or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 1:
                return 31
            if discord_voice_media_controller_media(controller and "500" and 1 and 1) is not equal to 0:
                return 32
            set execute_action to discord_voice_handshake_receive(handshake and "{\"op\":22,\"seq\":2,\"d\":{\"transition_id\":512}}" and 101 and 1)
            if not (discord_voice_media_controller_dispatch(controller and execute_action and roster) equals "media-transition-executed"):
                return 33
            set media to discord_voice_media_controller_media(controller and "500" and 1 and 1)
            if media equals 0 or else get_list(media and 3) is not equal to 1 or else discord_voice_media_controller_media(controller and "500" and 1 and 0) is not equal to 0 or else discord_voice_media_controller_media(controller and "500" and 0 and 1) is not equal to 0:
                return 34
            set remote_media to discord_voice_media_controller_media(controller and "900" and 1 and 1)
            if remote_media equals 0 or else get_list(remote_media and 3) is not equal to 0:
                return 35
            set udp_sender to fixture_udp()
            set udp_receiver to fixture_udp()
            if fixture_udp_connect(udp_sender and udp_receiver) equals 0 or else fixture_udp_connect(udp_receiver and udp_sender) equals 0:
                return 39
            set changed to set_list(transport and 2 and get_list(udp_sender and 0))
            set key to research_native_words(4)
            set cipher to discord_voice_crypto_open(get_argument(6) and get_list_data_ptr(key) and 32)
            set changed to set_list(transport and 3 and cipher)
            set codec to discord_voice_opus_open(get_argument(5))
            set playback to discord_voice_playback_new(controller and codec and 65535 and 4294967000 and 100)
            set digest to file_digest(get_argument(7) and 65536)
            set reader to discord_voice_pcm_open(get_argument(7) and archive_list_text(digest and 1) and get_list(digest and 2))
            set file_playback to discord_voice_file_playback_new(reader and playback)
            if file_playback equals 0:
                return 52
            set peer_handshake to discord_voice_handshake_new(1)
            set changed to set_list(peer_handshake and 0 and 4)
            set changed to set_list(peer_handshake and 2 and 54321)
            set peer_transport to create_list()
            set added to append_list(peer_transport and peer_handshake)
            set peer_socket to history_status("connected")
            set added to append_list(peer_socket and ep_dlopen(get_argument(4)))
            set added to append_list(peer_socket and 2)
            set added to append_list(peer_transport and peer_socket)
            set added to append_list(peer_transport and get_list(udp_receiver and 0))
            set added to append_list(peer_transport and cipher)
            set added to append_list(peer_transport and right)
            set added to append_list(peer_transport and create_list())
            set added to append_list(peer_transport and 600)
            set added to append_list(peer_transport and "900")
            set peer_io to discord_voice_io_new(peer_transport and 100)
            set peer_controller to discord_voice_media_controller_new(peer_io and get_argument(1) and 1)
            if not (discord_voice_media_controller_dispatch(peer_controller and welcome_wire and roster) equals "media-transition-prepared"):
                return 60
            set execute_peer to discord_voice_handshake_receive(peer_handshake and "{\"op\":22,\"seq\":2,\"d\":{\"transition_id\":512}}" and 101 and 1)
            if not (discord_voice_media_controller_dispatch(peer_controller and execute_peer and roster) equals "media-transition-executed"):
                return 61
            set participants to discord_voice_participants_new("200" and "600" and "900" and 1)
            set updated to discord_voice_participants_update(participants and 1 and "200" and "600" and "900" and "bot-session")
            set updated to discord_voice_participants_update(participants and 1 and "200" and "600" and "500" and "human-session")
            set mapped to discord_voice_participants_ssrc(participants and 1 and "500" and 12345)
            set receiver to discord_voice_receiver_new(peer_controller and get_argument(5))
            if receiver equals 0:
                return 62
            set reset to ep_dlcall1(ep_dlsym(socket_library and "fixture_reset") and 0)
            if not (discord_voice_file_playback_tick(file_playback and 100 and 1 and 1 and 0) equals "source-frame-sent"):
                return 40
            set received to fixture_udp_wait(get_list(udp_receiver and 0))
            if not (archive_list_text(received and 0) equals "packet"):
                return 41
            set packet to get_list(received and 1)
            if discord_voice_u16(get_list(packet and 0) and 2) is not equal to 65535 or else discord_voice_u32(get_list(packet and 0) and 4) is not equal to 4294967000 or else discord_voice_u32(get_list(packet and 0) and get_list(packet and 1) - 4) is not equal to 0:
                return 42
            set credentials to ["200","900","bot-session",""]
            set connection to create_list()
            set added to append_list(connection and peer_io)
            set added to append_list(connection and credentials)
            set added to append_list(connection and "600")
            set added to append_list(connection and 0)
            set owner to [connection,"voice-intent","generation","900"]
            set engine to [owner,get_argument(1),1,peer_controller,0,participants,2]
            set stream to discord_voice_recording_capture_stream(engine and receiver)
            if discord_voice_recording_frames_schema(journal) is not equal to 0:
                return 132
