import "../../app/discord/expression_tool"
import "../../app/discord/agent_bridge"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set body to "[{\"id\":\"300\",\"name\":\"fixture\",\"managed\":false,\"user\":{\"email\":\"private\"}}]"
    set projected to discord_expression_collection(body and "emoji" and "200")
    if string_length(projected) equals 0 or else string_contains(projected and "private") > 0:
        return 2
    if string_length(discord_expression_collection("[{\"id\":\"400\",\"guild_id\":\"201\",\"type\":2}]" and "sticker" and "200")) > 0:
        return 3
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0:
        return 4
    set options to discord_expression_options("{\"kind\":\"emoji\",\"operation\":\"list\"}")
    set source to ["found","MESSAGE_CREATE","{}","400","300","200","100","0"]
    set guilds to ["200"]
    set admins to []
    set result to discord_expressions_perform("" and "" and 0 and database and "forged-run" and "forged-call" and source and options and "900" and guilds and admins and "" and "/absent")
    set feedback to provider_json_tokens(result)
    if string_contains(result and "admin-required") equals 0 or else string_contains(result and "requester-role-required") equals 0 or else not (provider_kind(feedback and provider_member(feedback and 0 and "system_failure")) equals "false"):
        return 5
    if string_contains(discord_expressions_execute(database and "forged-run" and "forged-call" and "{}") and "invalid-expression-kind") equals 0:
        return 6
    display "PASS: expression collection binding, creator privacy and pre-network forged-request refusal. Integration with registered real calls remains separate."
    return 0
