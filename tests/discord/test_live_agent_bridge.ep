import "../../app/discord/agent_output"
import "../../app/agent/runner"

# Real primary-model/runner qualification with synthetic transport envelopes.
# This is not a real Discord mention/reply acceptance test.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0:
        return 2
    set profile to provider_llama_profile(get_argument(4) and http_decimal(get_argument(3)))
    set messages to ["My test marker is amber-otter-427. Remember it for this conversation. Acknowledge briefly.", "What marker did I give you? Use history_read to check the original message event discord-message:100:user, then answer briefly.", "This is a separate user's conversation. What test marker have I given you in this conversation? If none, say so; do not invent one."]
    set index to 0
    for each text in messages:
        set message to int_to_string(100 + index)
        set sender to "500"
        if index equals 2:
            set sender to "501"
        set body to concat("{\"id\":" and provider_quote(message))
        set body to concat(body and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":")
        set body to concat(body and concat(provider_quote(sender) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":"))
        set body to concat(body and concat(provider_quote(ptr_to_str(text)) and "}"))
        set inbox to concat("message:create:" and message)
        if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
            return 3
        set submitted to discord_agent_submit(journal and database and inbox and "900" and ["200"] and ["400"])
        if not (archive_list_text(submitted and 0) equals "accepted"):
            display archive_list_text(submitted and 0)
            return 4
        set run to concat("discord-message:" and message)
        set outcome to agent_loop_provider(database and run and profile and 8192 and -1 and 65536)
        display concat(run and concat(": " and outcome))
        if not (outcome equals "completed"):
            return 5
        if not (discord_agent_output(journal and database and inbox) equals "enqueued") or else not (discord_agent_output(journal and database and inbox) equals "enqueued"):
            return 6
        set final to archive_read_event(database and archive_list_text(agent_run_read(database and run) and 3))
        display archive_list_text(final and 3)
        set index to index + 1
    set calls to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run='discord-message:101' AND t.state='observed' AND json_extract(e.payload,'$.name')='history_read';"))
    if http_decimal(archive_list_text(calls and 1)) < 1:
        return 7
    set deliveries to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox WHERE channel='300' AND state='pending' AND json_extract(body,'$.allowed_mentions.replied_user')=0 AND json_array_length(body,'$.allowed_mentions.parse')=0;"))
    if not (archive_list_text(deliveries and 1) equals "3"):
        return 8
    display "PASS: three real primary-model turns through isolated Discord archive and existing runner, observed history tool, idempotent reply intents. Inspect retained requests for cross-user marker exclusion. No live Discord conversations or delivery performed."
    return 0
