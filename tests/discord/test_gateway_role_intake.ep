import "../../app/discord/gateway_intake"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 2
    if not (discord_gateway_bind(database and "socket-a" and "session-a") equals "bound"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "100")
    set admins to create_list()
    set created to "{\"op\":0,\"s\":1,\"t\":\"GUILD_ROLE_CREATE\",\"d\":{\"guild_id\":\"100\",\"role\":{\"id\":\"200\",\"name\":\"Untrusted name\",\"permissions\":\"0\"}}}"
    if not (discord_gateway_intake(database and "socket-a" and "900" and guilds and admins and created) equals "recorded"):
        return 4
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE kind='GUILD_ROLE_CREATE' AND identity LIKE 'role-metadata:%' AND json_extract(payload,'$.role_id')='200' AND json_extract(payload,'$.permissions')='0' AND instr(payload,'Untrusted name')=0;"))
    if not (archive_list_text(row and 1) equals "1"):
        return 5
    set changed to "{\"op\":0,\"s\":2,\"t\":\"GUILD_ROLE_UPDATE\",\"d\":{\"guild_id\":\"100\",\"role\":{\"id\":\"200\",\"permissions\":\"1024\"}}}"
    if not (discord_gateway_intake(database and "socket-a" and "900" and guilds and admins and changed) equals "recorded"):
        return 6
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE kind='GUILD_ROLE_UPDATE' AND identity LIKE 'audience:%';"))
    if not (archive_list_text(row and 1) equals "1"):
        return 7
    set envelope_3 to "{\"op\":0,\"s\":3,\"t\":\"GUILD_CREATE\",\"d\":{\"id\":\"100\",\"roles\":[{\"id\":\"200\",\"permissions\":\"1024\",\"name\":\"Discard name\"},{\"id\":\"300\",\"permissions\":\"0\"}],\"members\":[{\"private\":\"MUST_NOT_RETAIN\"}]}}"
    if not (discord_gateway_intake(database and "socket-a" and "900" and guilds and admins and envelope_3) equals "recorded"):
        return 13
    set row_3 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity LIKE 'audience:%:3' AND instr(payload,'MUST_NOT_RETAIN')=0 AND instr(payload,'Discard name')=0;"))
    if not (archive_list_text(row_3 and 1) equals "1"):
        return 23
    set envelope_4 to "{\"op\":0,\"s\":4,\"t\":\"GUILD_ROLE_UPDATE\",\"d\":{\"guild_id\":\"100\",\"role\":{\"id\":\"300\",\"permissions\":\"0\",\"position\":5}}}"
    if not (discord_gateway_intake(database and "socket-a" and "900" and guilds and admins and envelope_4) equals "recorded"):
        return 14
    set row_4 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity LIKE 'role-metadata:audience:%:4' AND instr(payload,'MUST_NOT_RETAIN')=0 AND instr(payload,'Discard name')=0;"))
    if not (archive_list_text(row_4 and 1) equals "1"):
        return 24
    set envelope_5 to "{\"op\":0,\"s\":5,\"t\":\"GUILD_ROLE_UPDATE\",\"d\":{\"guild_id\":\"100\",\"role\":{\"id\":\"300\",\"permissions\":\"8\"}}}"
    if not (discord_gateway_intake(database and "socket-a" and "900" and guilds and admins and envelope_5) equals "recorded"):
        return 15
    set row_5 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity LIKE 'audience:%:5' AND instr(payload,'MUST_NOT_RETAIN')=0 AND instr(payload,'Discard name')=0;"))
    if not (archive_list_text(row_5 and 1) equals "1"):
        return 25
    set closed to sql_close(database)
    display "PASS: actual Gateway envelope projects role permission evidence; zero create does not cancel; permission update retains audience barrier; role names excluded."
    return 0
