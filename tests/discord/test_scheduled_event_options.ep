import "../../app/discord/scheduled_event_options"

define main returning Int:
    set valid to create_list()
    # The live recurring-cover fixture must pass argument validation intact.
    set added to append_list(valid and "{\"operation\":\"create\",\"reason\":\"Synthetic recurring cover\",\"changes\":{\"name\":\"Synthetic fixture\",\"entity_type\":3,\"scheduled_start_time\":\"2026-10-23T20:00:00Z\",\"scheduled_end_time\":\"2026-10-23T20:15:00Z\",\"entity_metadata\":{\"location\":\"Test only\"},\"recurrence_rule\":{\"start\":\"2026-10-23T20:00:00Z\",\"frequency\":2,\"interval\":1,\"by_weekday\":[4]},\"image\":\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAAAkCAIAAAC2bqvFAAAAU0lEQVR4nO3PwQkAIBDAsNvF6Xy7PziEjyAUOkA66+yvGy5oQAsa0IIGtKABLWhACxrQgga0oAEtaEALGtCCBrSgAS1oQAsa0IIGtKABLWhACx67pDj3eRV1SBIAAAAASUVORK5CYII=\"}}")
    set added to append_list(valid and "{\"operation\": \"list\"}")
    set added to append_list(valid and "{\"operation\": \"inspect\", \"event\": \"300\"}")
    set added to append_list(valid and "{\"operation\": \"users\", \"event\": \"300\", \"limit\": 3, \"after\": \"200\"}")
    set added to append_list(valid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null}}")
    set added to append_list(valid and "{\"operation\": \"edit\", \"event\": \"300\", \"reason\": \"Fixture edit\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"changes\": {\"description\": null, \"image\": null, \"recurrence_rule\": null}}")
    set added to append_list(valid and "{\"operation\": \"start\", \"event\": \"300\", \"reason\": \"Fixture transition\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    set added to append_list(valid and "{\"operation\": \"end\", \"event\": \"300\", \"reason\": \"Fixture transition\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    set added to append_list(valid and "{\"operation\": \"cancel\", \"event\": \"300\", \"reason\": \"Fixture transition\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    set added to append_list(valid and "{\"operation\": \"delete\", \"event\": \"300\", \"reason\": \"Fixture transition\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    for each item in valid:
        set result to discord_event_options(ptr_to_str(item))
        if not (archive_list_text(result and 0) equals "valid"):
            display ptr_to_str(item)
            display archive_list_text(result and 0)
            return 1
    set invalid to create_list()
    set added to append_list(invalid and "{\"operation\": \"list\", \"event\": \"300\"}")
    set added to append_list(invalid and "{\"operation\": \"list\", \"limit\": 2}")
    set added to append_list(invalid and "{\"operation\": \"inspect\", \"event\": \"../users/@me\"}")
    set added to append_list(invalid and "{\"operation\": \"users\", \"event\": \"300\", \"before\": \"200\", \"after\": \"400\"}")
    set added to append_list(invalid and "{\"operation\": \"users\", \"event\": \"300\", \"limit\": 101}")
    set added to append_list(invalid and "{\"operation\": \"delete\", \"event\": \"300\", \"reason\": \"Fixture\"}")
    set added to append_list(invalid and "{\"operation\": \"delete\", \"event\": \"300\", \"reason\": \"Fixture\", \"observed_sha256\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null}, \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null, \"status\": 2}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null, \"privacy_level\": 1}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"next week\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"test\", \"extra\": \"injected\"}, \"channel_id\": null}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null, \"image\": \"https://example.com/image.png\"}}")
    set added to append_list(invalid and "{\"operation\": \"create\", \"reason\": \"Labelled fixture\", \"changes\": {\"name\": \"Disposable event\", \"entity_type\": 3, \"scheduled_start_time\": \"2026-11-01T12:00:00Z\", \"scheduled_end_time\": \"2026-11-01T13:00:00Z\", \"entity_metadata\": {\"location\": \"Test room\"}, \"channel_id\": null, \"image\": \"data:image/png;base64,AAAA=AAA\"}}")
    set added to append_list(invalid and "{\"operation\": \"edit\", \"event\": \"300\", \"reason\": \"Fixture\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"changes\": {}}")
    set added to append_list(invalid and "{\"operation\": \"end\", \"event\": \"300\", \"reason\": \"Fixture\", \"observed_sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"changes\": {\"name\": \"Ignored\"}}")
    set added to append_list(invalid and "{\"operation\":\"list\",\"operation\":\"delete\"}")
    for each item in invalid:
        if archive_list_text(discord_event_options(ptr_to_str(item)) and 0) equals "valid":
            display ptr_to_str(item)
            return 2
    display "PASS: scheduled-event operation arguments, mutation hashes/reasons, pagination exclusivity, nullable edits, image syntax and duplicate/unused-field refusal."
    return 0
