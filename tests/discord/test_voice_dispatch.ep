import "../../app/discord/voice_dispatch"
import "select"

# The real service executable and an admitted fixture database are supplied by
# the native integration driver. No production token or network is involved.
define main returning Int:
    if get_argument_count() is not equal to 11:
        return 1
    set journal to sql_open(get_argument(1))
    if journal equals 0 or else discord_voice_launch_schema(journal) is not equal to 0:
        return 2
    set config to discord_voice_launch_config()
    if config equals 0:
        return 3
    set arguments to create_list()
    set index to 2
    repeat while index <= 10:
        set added to append_list(arguments and get_argument(index))
        set index to index + 1
    set launched to discord_voice_launch_next(journal and arguments and config)
    if not (archive_list_text(launched and 0) equals "voice-worker-started") or else get_list(launched and 3) is not equal to 0:
        display archive_list_text(launched and 0)
        return 4
    if not (archive_list_text(discord_voice_launch_next(journal and arguments and config) and 0) equals "end"):
        return 5
    set idle to channel
    set waits to create_list()
    set added to append_list(waits and idle)
    set attempts to 0
    set claimed to 0
    repeat while attempts < 100 and also claimed equals 0:
        set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_voice_intents WHERE identity='voice-intent';"))
        if archive_list_text(row and 1) equals "claimed":
            set claimed to 1
        else:
            set ready to select(waits and 20)
        set attempts to attempts + 1
    if claimed equals 0:
        return 6
    if discord_voice_launch_recover(journal) is not equal to 0:
        return 7
    set result to 0
    set attempts to 0
    repeat while result equals 0 and also attempts < 250:
        set result to discord_process_poll(get_list(launched and 1))
        if result equals 0:
            set ready to select(waits and 20)
        set attempts to attempts + 1
    if result is not equal to 2:
        return 8
    if discord_voice_launch_settle(journal and archive_list_text(launched and 2) and result) is not equal to 0:
        return 9
    set row to history_collect_one(archive_prepare(journal and "SELECT i.state,p.state FROM discord_voice_intents i JOIN discord_voice_processes p ON p.identity=i.identity WHERE i.identity='voice-intent';"))
    if not (archive_list_text(row and 1) equals "leave-required") or else not (archive_list_text(row and 2) equals "failed") or else not (archive_list_text(discord_voice_launch_next(journal and arguments and config) and 0) equals "end"):
        return 10
    display "PASS: pinned service launches once, duplicate poll cannot replay, controller recovery revokes live child and reaps it with durable leave."
    return 0
