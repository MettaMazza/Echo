import "../../app/discord/group_control"
import "../../app/discord/agent_bridge"

define group_control_field with body as Str and key as Str returning Str:
    set fields to provider_json_tokens(body)
    return provider_value(fields and provider_member(fields and 0 and key))

define group_control_args with action as Str and group_id as Str and revision as Int returning Str:
    return concat("{\"action\":" and concat(provider_quote(action) and concat(",\"group\":" and concat(provider_quote(group_id) and concat(",\"revision\":" and concat(provider_quote(int_to_string(revision)) and "}"))))))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0:
        return 2
    set admins to create_list()
    set a to discord_agent_principal(database and "400" and admins)
    set b to discord_agent_principal(database and "500" and admins)
    set made to discord_group_request(database and a and "200" and "300" and "create-one" and "{\"action\":\"create\"}" and "")
    if not (group_control_field(made and "status") equals "created"):
        return 3
    set group_id to group_control_field(made and "group")
    set invited to discord_group_request(database and a and "200" and "300" and "invite-b" and group_control_args("invite" and group_id and 1) and principal_for_device(database and b))
    if not (group_control_field(invited and "status") equals "recorded"):
        return 4
    set listed to discord_group_request(database and b and "200" and "300" and "list-b" and "{\"action\":\"list\"}" and "")
    if string_contains(listed and group_id) equals 0 or else string_contains(listed and "invited") equals 0:
        return 5
    set denied to discord_group_request(database and b and "200" and "301" and "wrong-room" and group_control_args("inspect" and group_id and 2) and "")
    if not (group_control_field(denied and "status") equals "group-not-authorized"):
        return 6
    set joined to discord_group_request(database and b and "200" and "300" and "join-b" and group_control_args("join" and group_id and 2) and "")
    if not (group_control_field(joined and "status") equals "recorded") or else not (archive_list_text(discord_joined_selected(database and b and "200" and "300") and 1) equals group_id):
        return 7
    set replay to discord_group_request(database and b and "200" and "300" and "join-b" and group_control_args("join" and group_id and 2) and "")
    if not (group_control_field(replay and "status") equals "already-recorded"):
        return 8
    set inspected to discord_group_request(database and b and "200" and "300" and "inspect-b" and group_control_args("inspect" and group_id and 3) and "")
    if not (group_control_field(inspected and "revision") equals "3"):
        return 9
    set left to discord_group_request(database and b and "200" and "300" and "leave-b" and group_control_args("leave" and group_id and 3) and "")
    if not (group_control_field(left and "status") equals "recorded") or else not (archive_list_text(discord_joined_selected(database and b and "200" and "300") and 0) equals "personal"):
        return 10
    set listed to discord_group_request(database and b and "200" and "300" and "list-left" and "{\"action\":\"list\"}" and "")
    if string_contains(listed and group_id) is not equal to 0:
        return 11
    display "PASS: group controls create/select, invite without joining, list invitations, deny foreign channel, self-join/replay, inspect revision, leave and return to personal routing."
    return sql_close(database)
