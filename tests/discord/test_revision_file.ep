import "../../app/discord/revision_file"
import "../../app/jobs/delegation_schema"

define attachment_control_arguments with action as Str and source as Str and identity as Str and previous as Str returning Str:
    set output to "{"
    for each pair in [["action",action],["attachment",source],["identity",identity],["previous",previous]]:
        if string_length(output) > 1:
            set output to concat(output and ",")
        set output to concat(output and concat(provider_quote(archive_list_text(pair and 0)) and concat(":" and provider_quote(archive_list_text(pair and 1)))))
    return concat(output and "}")

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)) or else file_exists(concat(get_argument(2) and ".shared")):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","c"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set private to web_submit_owned(database and "a" and "private" and "" and "Private attachment fixture")
    if agent_cancel_run(database and "private") is not equal to 0 or else write_file(get_argument(2) and "Retained original copper fern") is not equal to 1 or else web_attachment_register(database and "a" and archive_list_text(private and 1) and "host-file" and get_argument(2) and "host.txt" and "text/plain") is not equal to 0:
        return 4
    if not (group_create(database and "a" and "g" and "discord" and "100" and "200" and "g") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "discord" and "100" and "200" and 3) equals "created"):
        return 5
    set replacement to "Start of complete replacement.\n"
    set line to 0
    repeat while line < 1500:
        set line to line + 1
        set replacement to concat(replacement and "🙂é Sentence preserved.\n")
    set replacement to concat(replacement and "Exact final sentence.\n")
    if write_file(concat(get_argument(2) and ".shared") and replacement) is not equal to 1 or else web_attachment_register(database and "a" and "shared" and "source" and concat(get_argument(2) and ".shared") and "shared.txt" and "text/plain") is not equal to 0:
        return 6
    set journal to sql_open(concat(get_argument(1) and ".journal"))
    if journal equals 0:
        return 30
    set prepared to discord_revision_file_prepare(journal and database and "interaction-one" and "a" and "100" and "200" and "source")
    set repeated to discord_revision_file_prepare(journal and database and "interaction-one" and "a" and "100" and "200" and "source")
    if not (archive_list_text(prepared and 0) equals "prepared") or else not (archive_list_text(repeated and 1) equals replacement):
        return 31
    if not (archive_list_text(discord_revision_file_prepare(journal and database and "interaction-one" and "b" and "100" and "200" and "source") and 0) equals "replacement-request-conflict"):
        return 32
    set closed to sql_close(journal)
    set journal to sql_open(concat(get_argument(1) and ".journal"))
    if not (archive_list_text(discord_revision_file_prepare(journal and database and "interaction-one" and "a" and "100" and "200" and "source") and 0) equals "prepared"):
        return 33
    set full to discord_revision_file_text(database and "a" and "100" and "200" and "source")
    if not (archive_list_text(full and 0) equals "prepared") or else not (archive_list_text(full and 1) equals replacement) or else not (archive_list_text(full and 2) equals "source") or else not (archive_list_text(full and 3) equals "source:attachment"):
        return 20
    for each denied in [["a","100","200","host-file"],["c","100","200","source"],["a","101","200","source"],["a","100","201","source"]]:
        set read to discord_revision_file_text(database and archive_list_text(denied and 0) and archive_list_text(denied and 1) and archive_list_text(denied and 2) and archive_list_text(denied and 3))
        if not (archive_list_text(read and 0) equals "attachment-not-authorized"):
            return 21
    set listing to discord_attachment_list(database and "b" and "100" and "200" and "shared")
    if string_contains(listing and "shared.txt") equals 0 or else string_contains(listing and "host.txt") is not equal to 0 or else string_contains(discord_attachment_list(database and "a" and "100" and "200" and archive_list_text(private and 1)) and "not-authorized") equals 0:
        return 16
    set query to attachment_control_arguments("trash" and "source" and "trash" and "")
    if not (discord_attachment_request(database and "c" and "100" and "200" and "lifecycle" and query) equals "not-authorized") or else not (discord_attachment_request(database and "a" and "101" and "200" and "lifecycle" and query) equals "not-authorized") or else not (discord_attachment_request(database and "a" and "100" and "201" and "lifecycle" and query) equals "not-authorized"):
        return 7
    if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and attachment_control_arguments("trash" and "host-file" and "host" and "")) equals "not-authorized"):
        return 8
    if not (discord_attachment_request(database and "b" and "100" and "200" and "lifecycle" and query) equals "recorded") or else not (discord_attachment_request(database and "b" and "100" and "200" and "lifecycle" and query) equals "already-recorded") or else attachment_selectable(database and "source") is not equal to 0 or else attachment_context_included(database and "source") is not equal to 1:
        return 9
    if not (archive_list_text(discord_revision_file_text(database and "a" and "100" and "200" and "source") and 0) equals "attachment-not-selected"):
        return 22
    if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and attachment_control_arguments("restore" and "source" and "stale" and "")) equals "revision-conflict"):
        return 10
    set query to attachment_control_arguments("exclude" and "source" and "exclude" and "")
    if not (discord_attachment_request(database and "a" and "100" and "200" and "visibility" and query) equals "recorded") or else attachment_context_included(database and "source") is not equal to 0:
        return 11
    for each arguments in ["{}","{\"action\":\"trash\",\"attachment\":\"source\",\"identity\":\"x\",\"previous\":\"\",\"device\":\"a\"}"]:
        if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and arguments) equals "invalid-arguments"):
            return 12
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (discord_attachment_request(database and "a" and "100" and "200" and "lifecycle" and attachment_control_arguments("restore" and "source" and "restore" and "attachment-lifecycle:b:trash")) equals "recorded") or else not (discord_attachment_request(database and "a" and "100" and "200" and "visibility" and attachment_control_arguments("restore" and "source" and "include" and "attachment-visibility:a:exclude")) equals "recorded"):
        return 13
    if attachment_selectable(database and "source") is not equal to 1 or else attachment_context_included(database and "source") is not equal to 1 or else not (ptr_to_str(read_file(concat(get_argument(2) and ".shared"))) equals replacement) or else archive_verify(database and "shared") is not equal to 0:
        return 14
    set restored to discord_revision_file_text(database and "b" and "100" and "200" and "source")
    if not (archive_list_text(restored and 0) equals "prepared") or else not (archive_list_text(restored and 1) equals replacement):
        return 23
    if not (discord_attachment_request(database and "a" and "100" and "200" and "visibility" and attachment_control_arguments("exclude" and "source" and "exclude-again" and "attachment-visibility:a:include")) equals "recorded") or else not (archive_list_text(discord_revision_file_text(database and "a" and "100" and "200" and "source") and 0) equals "attachment-not-selected"):
        return 27
    if not (discord_attachment_request(database and "a" and "100" and "200" and "visibility" and attachment_control_arguments("restore" and "source" and "include-again" and "attachment-visibility:a:exclude-again")) equals "recorded"):
        return 28
    if write_file(concat(get_argument(2) and ".binary") and "Not a text media type") is not equal to 1 or else web_attachment_register(database and "a" and "shared" and "binary" and concat(get_argument(2) and ".binary") and "data.pdf" and "application/pdf") is not equal to 0 or else not (archive_list_text(discord_revision_file_text(database and "a" and "100" and "200" and "binary") and 0) equals "replacement-text-file-required"):
        return 29
    if write_file(concat(get_argument(2) and ".shared") and "Changed original") is not equal to 1 or else not (archive_list_text(discord_revision_file_text(database and "a" and "100" and "200" and "source") and 0) equals "replacement-file:integrity-failed"):
        return 24
    if write_file(concat(get_argument(2) and ".shared") and replacement) is not equal to 1:
        return 25
    if not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded") or else not (discord_attachment_request(database and "b" and "100" and "200" and "visibility" and query) equals "not-authorized"):
        return 15
    if not (archive_list_text(discord_revision_file_text(database and "b" and "100" and "200" and "source") and 0) equals "attachment-not-authorized"):
        return 26
    display "PASS: full long Unicode replacement text, provenance and digest checks; Discord attachment namespace isolation, owner/member changes, immutable retry, stale revision, distinct trash/context policy, retained bytes, restart restore and removed-member denial."
    return sql_close(database)
