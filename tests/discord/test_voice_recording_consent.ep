import "../../app/providers/json_string"
import "../../app/discord/voice_recording_consent"

define recording_fixture_interaction with journal as Int and identity as Str and actor as Str and offer as Str and decision as Str returning Str:
    set custom to concat("echo:record:" and concat(offer and concat(":" and decision)))
    set body to concat("{\"id\":" and provider_quote(identity))
    set bound to history_collect_one(checkpoint_prepare(journal and "SELECT message FROM discord_voice_recording_offer_messages WHERE offer=?1;" and [offer]))
    set message to archive_list_text(bound and 1)
    if identity equals "149":
        set message to "710"
    set body to concat(body and concat(",\"message\":{\"id\":" and concat(provider_quote(message) and ",\"author\":{\"id\":\"900\"}},\"type\":3,")))
    set body to concat(body and "\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":")
    set body to concat(body and concat(provider_quote(actor) and "}},\"data\":{\"custom_id\":"))
    set body to concat(body and concat(provider_quote(custom) and "}}"))
    if identity equals "131":
        set marked to history_collect_one(checkpoint_prepare(journal and "SELECT json_set(?1,'$.member.user.bot',json('true'));" and [body]))
        set body to archive_list_text(marked and 1)
    set inbox to concat("interaction:" and identity)
    set recorded to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    return inbox

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_voice_recording_offer_schema(journal) is not equal to 0:
        return 2
    set requested to discord_voice_intent_request(journal and "voice" and "200" and "600" and "500" and "join-run" and "join-call" and ep_sha256("access"))
    set sent to sql_execute(journal and "UPDATE discord_voice_intents SET state='sent' WHERE identity='voice';")
    set participants to discord_voice_participants_new("200" and "600" and "900" and 1)
    set updated to discord_voice_participants_update(participants and 1 and "200" and "600" and "900" and "bot-session")
    set updated to discord_voice_participants_update(participants and 1 and "200" and "600" and "501" and "member-session")
    set requested to discord_voice_recording_request(journal and "recording" and "voice" and "500" and "300" and "admitted-request")
    if not (requested equals "pending-notice") or else not (discord_voice_recording_request(journal and "recording" and "voice" and "500" and "300" and "admitted-request") equals "existing:pending-notice"):
        return 3
    if not (archive_list_text(discord_voice_recording_snapshot(journal and "recording" and participants and 1) and 0) equals "recording-not-active"):
        return 4
    if not (discord_voice_recording_notice(journal and "recording" and "700" and "observed-notice") equals "active"):
        return 5
    set offer to ep_sha256("member-session-offer")
    if not (discord_voice_recording_offer(journal and offer and "recording" and "501" and "member-session") equals "offered"):
        return 6
    set notice to discord_voice_recording_offer_body(journal and offer)
    set observed to concat("{\"id\":\"710\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"}," and substring(notice and 1 and string_length(notice) - 1))
    if not (discord_voice_recording_offer_observed(journal and offer and observed and "observed-offer") equals "recording-offer-bound"):
        return 21
    set other_message to concat("{\"id\":\"712\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"}," and substring(notice and 1 and string_length(notice) - 1))
    if not (discord_voice_recording_offer_observed(journal and offer and other_message and "duplicate-offer") equals "recording-offer-binding-conflict"):
        return 24
    set wrong_author to concat("{\"id\":\"713\",\"channel_id\":\"300\",\"author\":{\"id\":\"501\"}," and substring(notice and 1 and string_length(notice) - 1))
    if not (discord_voice_recording_offer_observed(journal and offer and wrong_author and "wrong-author") equals "recording-offer-observation-invalid"):
        return 25
    set disabled to history_collect_one(checkpoint_prepare(journal and "SELECT json_set(?1,'$.components[0].components[1].disabled',json('true'));" and [observed]))
    if not (discord_voice_recording_offer_observed(journal and offer and archive_list_text(disabled and 1) and "disabled-revoke") equals "recording-offer-controls-invalid"):
        return 26
    set original to recording_fixture_interaction(journal and "100" and "502" and offer and "grant")
    if not (discord_voice_recording_consent(journal and offer and original and participants and 1) equals "recording-interaction-binding-denied"):
        return 7
    set original to recording_fixture_interaction(journal and "120" and "501" and offer and "revoke")
    if not (discord_voice_recording_consent(journal and offer and original and participants and 1) equals "consent-recorded"):
        return 8
    set original to recording_fixture_interaction(journal and "110" and "501" and offer and "grant")
    if not (discord_voice_recording_consent(journal and offer and original and participants and 1) equals "consent-recorded") or else not (discord_voice_recording_consent(journal and offer and original and participants and 1) equals "existing-consent-receipt"):
        return 9
    set snapshot to discord_voice_recording_snapshot(journal and "recording" and participants and 1)
    if length_list(get_list(snapshot and 7)) is not equal to 0:
        return 10
    set original to recording_fixture_interaction(journal and "130" and "501" and offer and "grant")
    set created to sql_execute(journal and "CREATE TABLE discord_gateway(singleton INTEGER PRIMARY KEY,generation TEXT,session TEXT,sequence INTEGER); INSERT INTO discord_gateway VALUES(1,'gateway-generation','gateway-session',10);")
    if not (discord_voice_recording_consent_at(journal and offer and original and participants and 1 and "gateway-generation" and "gateway-session" and 9) equals "recording-membership-refresh-required"):
        return 27
    if not (discord_voice_recording_consent_at(journal and offer and original and participants and 1 and "old-generation" and "gateway-session" and 10) equals "recording-membership-refresh-required"):
        return 28
    set recorded to discord_voice_recording_consent_at(journal and offer and original and participants and 1 and "gateway-generation" and "gateway-session" and 10)
    if not (recorded equals "consent-recorded"):
        return 29
    set snapshot to discord_voice_recording_snapshot(journal and "recording" and participants and 1)
    if length_list(get_list(snapshot and 7)) is not equal to 1 or else not (archive_list_text(get_list(get_list(snapshot and 7) and 0) and 2) equals original):
        return 11
    set original to recording_fixture_interaction(journal and "131" and "501" and offer and "grant")
    if not (discord_voice_recording_consent(journal and offer and original and participants and 1) equals "recording-human-consent-required"):
        return 30
    set updated to discord_voice_participants_update(participants and 1 and "200" and "600" and "501" and "new-session")
    set original to recording_fixture_interaction(journal and "140" and "501" and offer and "grant")
    if not (discord_voice_recording_consent(journal and offer and original and participants and 1) equals "recording-consent-session-changed"):
        return 12
    set snapshot to discord_voice_recording_snapshot(journal and "recording" and participants and 1)
    if length_list(get_list(snapshot and 7)) is not equal to 0:
        return 13
    set offer2 to ep_sha256("new-session-offer")
    set offered to discord_voice_recording_offer(journal and offer2 and "recording" and "501" and "new-session")
    set notice2 to discord_voice_recording_offer_body(journal and offer2)
    set observed2 to concat("{\"id\":\"711\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"}," and substring(notice2 and 1 and string_length(notice2) - 1))
    if not (discord_voice_recording_offer_observed(journal and offer2 and observed2 and "observed-offer2") equals "recording-offer-bound"):
        return 22
    set original to recording_fixture_interaction(journal and "149" and "501" and offer2 and "grant")
    if not (discord_voice_recording_consent(journal and offer2 and original and participants and 1) equals "recording-interaction-message-denied"):
        return 23
    set original to recording_fixture_interaction(journal and "150" and "501" and offer2 and "grant")
    if not (discord_voice_recording_consent(journal and offer2 and original and participants and 1) equals "consent-recorded"):
        return 14
    if discord_voice_recording_stop(journal and "recording") is not equal to 0 or else not (discord_voice_recording_notice(journal and "recording" and "701" and "late-notice") equals "recording-notice-not-applied"):
        return 15
    set original to recording_fixture_interaction(journal and "160" and "501" and offer2 and "grant")
    if not (discord_voice_recording_consent(journal and offer2 and original and participants and 1) equals "recording-not-active"):
        return 16
    if not (discord_voice_recording_request(journal and "recording2" and "voice" and "500" and "300" and "new-request") equals "pending-notice") or else not (discord_voice_recording_notice(journal and "recording2" and "702" and "new-notice") equals "active"):
        return 17
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_voice_recording_recover(journal and "voice") is not equal to 0:
        return 18
    if not (archive_list_text(discord_voice_recording_snapshot(journal and "recording2" and participants and 1) and 0) equals "recording-not-active") or else not (discord_voice_recording_request(journal and "recording2" and "voice" and "500" and "300" and "new-request") equals "existing:interrupted"):
        return 19
    set states to history_collect_one(archive_prepare(journal and "SELECT (SELECT state FROM discord_voice_recordings WHERE identity='recording'),(SELECT state FROM discord_voice_recordings WHERE identity='recording2'),(SELECT count(*) FROM discord_voice_recording_consents);"))
    if not (archive_list_text(states and 1) equals "stopped") or else not (archive_list_text(states and 2) equals "interrupted") or else not (archive_list_text(states and 3) equals "4"):
        return 20
    display "PASS: recording requires a notice and exact observed bot challenge with usable revoke control; member-bound human consent resists spoofing, duplicates, delayed grants and session changes; stop and restart remain non-recording with durable receipts."
    return 0
