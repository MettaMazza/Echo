import "../../app/discord/joined_groups"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else discord_joined_schema(database) is not equal to 0:
        return 2
    set devices to create_list()
    set added to append_list(devices and "a")
    set added to append_list(devices and "b")
    set added to append_list(devices and "c")
    for each device in devices:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set created to discord_joined_create(database and "a" and "100" and "200" and "create")
    if not (archive_list_text(created and 0) equals "created"):
        display created
        return 4
    set group_id to archive_list_text(created and 1)
    if not (archive_list_text(discord_joined_create(database and "a" and "100" and "200" and "create") and 0) equals "already-created") or else not (archive_list_text(discord_joined_create(database and "b" and "100" and "200" and "create") and 0) equals "group-identity-conflict"):
        return 5
    if not (discord_joined_select(database and "a" and "100" and "200" and "a-select" and group_id) equals "selected") or else not (discord_joined_select(database and "b" and "100" and "200" and "b-select" and group_id) equals "audience-not-authorized"):
        return 6
    if not (discord_joined_change(database and "a" and "100" and "200" and "invite" and group_id and "device:b" and "invited" and 1) equals "recorded") or else not (discord_joined_select(database and "b" and "100" and "200" and "b-select" and group_id) equals "audience-not-authorized"):
        return 7
    if not (discord_joined_change(database and "a" and "100" and "200" and "forced-join" and group_id and "device:b" and "joined" and 2) equals "membership-not-authorized"):
        return 8
    if not (discord_joined_change(database and "b" and "100" and "200" and "join" and group_id and "device:b" and "joined" and 2) equals "recorded") or else not (discord_joined_select(database and "b" and "100" and "200" and "b-select" and group_id) equals "selected"):
        return 9
    set first to group_route(database and "a" and group_id and "discord" and "100" and "200")
    set second to group_route(database and "b" and group_id and "discord" and "100" and "200")
    if not (archive_list_text(first and 0) equals "routed") or else not (archive_list_text(first and 1) equals archive_list_text(second and 1)):
        return 10
    if not (discord_joined_select(database and "a" and "101" and "200" and "foreign-server" and group_id) equals "audience-not-authorized") or else not (discord_joined_select(database and "a" and "100" and "201" and "foreign-room" and group_id) equals "audience-not-authorized"):
        return 11
    if not (archive_list_text(discord_joined_selected(database and "c" and "100" and "200") and 0) equals "personal"):
        return 12
    if not (discord_joined_select(database and "a" and "100" and "200" and "a-select" and group_id) equals "already-selected") or else not (discord_joined_select(database and "a" and "100" and "200" and "a-select" and "") equals "selection-identity-conflict"):
        return 13
    if not (discord_joined_change(database and "a" and "100" and "200" and "remove" and group_id and "device:b" and "removed" and 3) equals "recorded") or else not (archive_list_text(discord_joined_selected(database and "b" and "100" and "200") and 0) equals "audience-not-authorized"):
        return 14
    if group_session_allows(database and "b" and archive_list_text(first and 1) and "discord" and "100" and "200" and 0) is not equal to 0:
        return 15
    if not (discord_joined_select(database and "b" and "100" and "200" and "personal" and "") equals "selected"):
        return 16
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (archive_list_text(discord_joined_selected(database and "a" and "100" and "200") and 1) equals group_id) or else not (archive_list_text(discord_joined_selected(database and "b" and "100" and "200") and 0) equals "personal"):
        return 17
    if not (group_create(database and "a" and "host" and "browser" and "local" and "host" and "host") equals "created") or else not (discord_joined_select(database and "a" and "100" and "200" and "host-import" and "host") equals "audience-not-authorized"):
        return 18
    display "PASS: explicit invitations and self-join, same group routing, current membership removal, personal reset, immutable selection replay and platform/channel/account isolation."
    return sql_close(database)
