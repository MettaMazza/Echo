import "../../app/discord/member_guard"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"1024\",\"managed\":false},{\"id\":\"201\",\"position\":5,\"permissions\":\"1099511627782\",\"managed\":true},{\"id\":\"202\",\"position\":5,\"permissions\":\"0\",\"managed\":false},{\"id\":\"203\",\"position\":7,\"permissions\":\"0\",\"managed\":false}]"
    set actor to "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\"]}"
    set target to "{\"user\":{\"id\":\"600\"},\"roles\":[\"202\"]}"
    if discord_member_below(server and roles and actor and target and "200" and "500" and "600" and 0) is not equal to 1:
        return 1
    if discord_member_below(server and roles and target and actor and "200" and "600" and "500" and 0) is not equal to 0:
        return 2
    set owner to "{\"user\":{\"id\":\"999\"},\"roles\":[]}"
    if discord_member_below(server and roles and actor and owner and "200" and "500" and "999" and 0) is not equal to 0:
        return 3
    if discord_member_below(server and roles and owner and actor and "200" and "999" and "500" and 1) is not equal to 1:
        return 4
    set ordinary to "{\"user\":{\"id\":\"700\"},\"roles\":[]}"
    if discord_member_below(server and roles and actor and ordinary and "200" and "500" and "700" and 0) is not equal to 1:
        return 5
    if discord_member_below(server and roles and actor and actor and "200" and "500" and "500" and 0) is not equal to 0:
        return 6
    set missing to "{\"user\":{\"id\":\"600\"},\"roles\":[\"404\"]}"
    if discord_member_below(server and roles and actor and missing and "200" and "500" and "600" and 0) is not equal to 0:
        return 7
    if discord_member_guild_permission(server and roles and actor and "200" and "500" and 40) is not equal to 1 or else discord_member_guild_permission(server and roles and actor and "200" and "500" and 27) is not equal to 0:
        return 8
    set repeated to 0
    repeat while repeated < 500:
        if discord_member_below(server and roles and actor and target and "200" and "500" and "600" and 0) is not equal to 1:
            return 9
        set repeated to repeated + 1
    display "PASS: member hierarchy, equal-position ordering, owner/self protection, managed-role hierarchy, absent-role denial, guild permissions and repeated allocations."
    return 0
