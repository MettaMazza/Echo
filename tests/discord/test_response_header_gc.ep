import "../../app/discord/delivery"
external define ep_gc_get_minor_count returning Int

define main returning Int:
    set headers to "HTTP/1.1 200 Connection established\r\nX-RateLimit-Bucket: obsolete\r\n\r\nHTTP/2 200\r\n"
    set index to 0
    repeat while index < 160:
        set headers to concat(headers and concat("X-Extra-" and concat(int_to_string(index) and ": retained-header-value\r\n")))
        set index to index + 1
    set headers to concat(headers and "X-RateLimit-Bucket: current\r\nX-RateLimit-Remaining: 4\r\n\r\n")
    set before to ep_gc_get_minor_count()
    set index to 0
    repeat while index < 120:
        if not (discord_response_header(headers and "x-ratelimit-bucket") equals "current") or else not (discord_response_header(headers and "x-ratelimit-remaining") equals "4"):
            return 1
        set index to index + 1
    if ep_gc_get_minor_count() equals before:
        return 2
    if not (discord_response_header("HTTP/2 200\nX-Test: a\nX-Test: b\n" and "x-test") equals "!conflicting-header"):
        return 3
    display "PASS: final HTTP block, long header iteration through actual minor collection, exact values and conflicting-header refusal."
    return 0
