import "../../app/discord/question_render"

define main returning Int:
    set long_title to ""
    set repeat_count to 0
    repeat while repeat_count < 250:
        set long_title to concat(long_title and "Café 🌿 — a complete question, ")
        set repeat_count to repeat_count + 1
    set option to concat("A long option: " and long_title)
    set source to concat("{\"questions\":[{\"id\":\"first\",\"title\":" and concat(provider_quote(long_title) and concat(",\"options\":[" and concat(provider_quote(option) and ",\"Two\",\"Three\"]},{\"id\":\"second\",\"title\":\"Second question\",\"options\":[\"Yes\",\"No\"]},{\"id\":\"third\",\"title\":\"Free text\",\"options\":[]}]}"))))
    set rows to discord_question_render("echoq:fixture" and source)
    if length_list(rows) < 10:
        return 1
    set whole to ""
    set action_rows to 0
    set first_pages to 0
    set first_text to ""
    for each row in rows:
        set tokens to provider_json_tokens(ptr_to_str(row))
        if tokens equals 0:
            return 2
        set body to provider_member(tokens and 0 and "body")
        set content to provider_value(tokens and provider_member(tokens and body and "content"))
        if string_length(content) > 1800 or else provider_valid_utf8(content) equals 0:
            return 3
        set whole to concat(whole and content)
        if provider_value(tokens and provider_member(tokens and 0 and "item")) equals "0":
            set first_text to concat(first_text and content)
            set first_pages to first_pages + 1
        set components to provider_items(tokens and provider_member(tokens and body and "components"))
        if length_list(components) > 0:
            set action_rows to action_rows + 1
            if length_list(components) is not equal to 1:
                return 4
            set buttons to provider_items(tokens and provider_member(tokens and get_list(components and 0) and "components"))
            if length_list(buttons) > 4:
                return 5
            for each button in buttons:
                set custom to provider_value(tokens and provider_member(tokens and button and "custom_id"))
                if string_length(custom) is not equal to 71:
                    return 6
        set mentions to provider_items(tokens and provider_member(tokens and provider_member(tokens and body and "allowed_mentions") and "parse"))
        if length_list(mentions) is not equal to 0:
            return 7
    set expected to concat("Question 1 of 3\n" and concat(long_title and concat("\n\n1. " and concat(option and "\n\n2. Two\n\n3. Three\n\nChoose a numbered answer or Other. Choices are saved as drafts until you submit the batch."))))
    if not (first_text equals expected) or else first_pages < 2 or else action_rows is not equal to 4:
        return 8
    if string_contains(whole and "Second question") equals 0 or else string_contains(whole and "Free text") equals 0:
        return 9
    set repeated to discord_question_render("echoq:fixture" and source)
    if length_list(repeated) is not equal to length_list(rows):
        return 10
    set i to 0
    repeat while i < length_list(rows):
        if not (ptr_to_str(get_list(rows and i)) equals ptr_to_str(get_list(repeated and i))):
            return 11
        set i to i + 1
    if length_list(discord_question_render("echoq:fixture" and "{}")) is not equal to 0:
        return 12
    display "PASS: long Unicode question and options reconstructed exactly; bounded valid UTF-8 pages, stable IDs, numbered controls, Other/free text, explicit submit and mentions disabled."
    return 0
