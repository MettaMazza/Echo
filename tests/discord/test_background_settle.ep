import "../../app/discord/background_settle"
import "../../app/web/worker"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background receipt fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "receipt-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved"):
        return 5
    if not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "receipt-worker" and 123 and "fixture") equals "recorded") or else agent_cancel_run(database and "discord-message:100") is not equal to 0:
        return 6
    if discord_background_settle(journal and database) is not equal to 0:
        return 7
    set held to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "running"):
        return 8
    # A receipt belonging to another worker cannot release this reservation.
    if sql_execute(database and "UPDATE echo_web_workers SET worker='other-worker',status='cancelled';") is not equal to 0 or else discord_background_settle(journal and database) is not equal to 0:
        return 9
    set held to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "running"):
        return 10
    if sql_execute(database and "UPDATE echo_web_workers SET worker='receipt-worker';") is not equal to 0 or else discord_background_settle(journal and database) is not equal to 0:
        return 11
    set released to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(released and 1) equals "released"):
        return 12
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_background_settle(journal and database) is not equal to 0:
        return 13
    set counts to history_collect_one(archive_prepare(journal and "SELECT (SELECT COUNT(*) FROM discord_background_events WHERE state='released'),(SELECT COUNT(*) FROM discord_outbox);"))
    if not (archive_list_text(counts and 1) equals "1") or else not (archive_list_text(counts and 2) equals "0"):
        return 14
    display "PASS: cancellation needs matching finished-worker receipt, releases once across reopen, and produces no fabricated reply."
    return sql_close(database)
