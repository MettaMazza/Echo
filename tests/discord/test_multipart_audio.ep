import "../../app/discord/multipart_audio"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set digest to file_digest(get_argument(1) and 65536)
    if not (archive_list_text(digest and 0) equals "verified") or else get_list(digest and 2) is not equal to 8:
        return 2
    set payload to "{\"attachments\":[{\"id\":0,\"filename\":\"Echo-reply.wav\"}],\"allowed_mentions\":{\"parse\":[]}}"
    set result to discord_audio_multipart(get_argument(1) and archive_list_text(digest and 1) and 8 and 8 and payload)
    if not (archive_list_text(result and 0) equals "multipart-ready"):
        display archive_list_text(result and 0)
        return 3
    set pointer to get_list(result and 1) + get_list(result and 4)
    if peek_byte(pointer and 0) is not equal to 0 or else peek_byte(pointer and 1) is not equal to 255 or else peek_byte(pointer and 4) is not equal to 128 or else peek_byte(pointer and 6) is not equal to 0 or else peek_byte(pointer and 7) is not equal to 66:
        return 4
    set released to discord_audio_multipart_release(result)
    set result to discord_audio_multipart(get_argument(1) and "wrong-digest" and 8 and 8 and payload)
    if not (archive_list_text(result and 0) equals "audio-integrity-failed"):
        return 5
    set result to discord_audio_multipart(get_argument(1) and archive_list_text(digest and 1) and 7 and 8 and payload)
    if not (archive_list_text(result and 0) equals "audio-integrity-failed"):
        return 6
    set result to discord_audio_multipart(get_argument(1) and archive_list_text(digest and 1) and 9 and 8 and payload)
    if not (archive_list_text(result and 0) equals "attachment-too-large-or-empty"):
        return 7
    display "PASS: exact binary multipart including NUL/high bytes, digest mismatch and changed length denied, upload limit enforced"
    return 0
