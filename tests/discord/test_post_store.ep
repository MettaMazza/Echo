import "../../app/discord/post_store"
import "../../app/discord/worker_delivery"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0:
        return 2
    set saved to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"400\"}}")
    set body to "{\"content\":\"disposable test\"}"
    if not (discord_outbox_enqueue(journal and "tool-post:one" and "message:create:100" and "300" and body) equals "enqueued") or else not (discord_post_bind(journal and "tool-post:one" and "400" and "300" and "run:one") equals "bound"):
        return 3
    if not (discord_post_bind(journal and "tool-post:one" and "400" and "300" and "run:one") equals "bound") or else discord_post_bind(journal and "tool-post:one" and "500" and "300" and "run:one") equals "bound":
        return 4
    if archive_list_text(discord_post_lookup(journal and "tool-post:one" and "500" and "300") and 0) equals "found" or else archive_list_text(discord_post_lookup(journal and "tool-post:one" and "400" and "301") and 0) equals "found":
        return 5
    set row to discord_post_lookup(journal and "tool-post:one" and "400" and "300")
    if not (archive_list_text(row and 1) equals "pending") or else not (archive_list_text(row and 5) equals body):
        return 6
    # Generic delivery cannot race the model tool's authorization controller.
    if not (discord_worker_deliver("" and "" and journal and "tool-post:one" and "900" and create_list() and "" and "") equals "separate-tool-controller"):
        return 7
    set claimed to discord_outbox_claim(journal and "tool-post:one" and "first")
    if not (archive_list_text(claimed and 0) equals "claimed"):
        return 8
    set finished to discord_outbox_finish(journal and "tool-post:one" and "first" and "uncertain" and "" and "simulated lost response")
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else archive_list_text(discord_outbox_claim(journal and "tool-post:one" and "blind-retry") and 0) equals "claimed":
        return 9
    if not (archive_list_text(discord_post_lookup(journal and "tool-post:one" and "400" and "300") and 1) equals "uncertain"):
        return 10
    if sql_execute(journal and "UPDATE discord_tool_posts SET actor='500';") equals 0 or else sql_execute(journal and "DELETE FROM discord_tool_posts;") equals 0:
        return 11
    if not (discord_post_bind(journal and "final:one" and "400" and "300" and "run:one") equals "not-a-tool-post"):
        return 12
    display "PASS: post provenance, wrong actor/channel denial, immutable binding, controller-only dispatch and crash/uncertain no resend"
    return 0
