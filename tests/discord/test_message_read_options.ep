import "../../app/discord/message_read_options"

define main returning Int:
    set options to discord_message_read_options("{}")
    if archive_list_text(options and 0) equals "valid":
        return 1
    set options to discord_message_read_options("{\"operation\":\"delete\"}")
    if archive_list_text(options and 0) equals "valid":
        return 2
    set options to discord_message_read_options("{\"operation\":\"read\",\"message\":\"1/../2\"}")
    if archive_list_text(options and 0) equals "valid":
        return 3
    set options to discord_message_read_options("{\"operation\":\"history\",\"channel\":\"999\"}")
    if archive_list_text(options and 0) equals "valid":
        return 4
    set options to discord_message_read_options("{\"operation\":\"history\",\"limit\":0}")
    if archive_list_text(options and 0) equals "valid":
        return 5
    set options to discord_message_read_options("{\"operation\":\"history\",\"limit\":101}")
    if archive_list_text(options and 0) equals "valid":
        return 6
    set options to discord_message_read_options("{\"operation\":\"history\",\"limit\":1.5}")
    if archive_list_text(options and 0) equals "valid":
        return 7
    set options to discord_message_read_options("{\"operation\":\"history\",\"before\":\"123\",\"after\":\"124\"}")
    if archive_list_text(options and 0) equals "valid":
        return 8
    set options to discord_message_read_options("{\"operation\":\"read\",\"message\":\"123\",\"limit\":2}")
    if archive_list_text(options and 0) equals "valid":
        return 9
    set options to discord_message_read_options("{\"operation\":\"history\",\"message\":\"123\"}")
    if archive_list_text(options and 0) equals "valid":
        return 10
    set options to discord_message_read_options("{\"operation\":\"history\",\"before\":\"\"}")
    if archive_list_text(options and 0) equals "valid":
        return 11
    set options to discord_message_read_options("{\"operation\":\"read\",\"message\":123}")
    if archive_list_text(options and 0) equals "valid":
        return 12
    set options to discord_message_read_options("{\"operation\":\"history\",\"operation\":\"read\"}")
    if archive_list_text(options and 0) equals "valid":
        return 20
    set options to discord_message_read_options("{\"operation\":\"history\",\"before\":\"123\",\"limit\":100}")
    if not (archive_list_text(options and 2) equals "/messages?limit=100&before=123"):
        return 21
    set options to discord_message_read_options("{\"operation\":\"read\",\"message\":\"123\"}")
    if not (archive_list_text(options and 2) equals "/messages/123"):
        return 22
    set body to "{\"id\":\"123\",\"channel_id\":\"456\",\"author\":{\"id\":\"789\",\"username\":\"screen\",\"global_name\":\"Screen Name\",\"email\":\"private-email\"},\"content\":\"Retained words.\",\"timestamp\":\"2026-10-21T22:00:00Z\",\"referenced_message\":{\"content\":\"foreign-private-content\"},\"message_snapshots\":[{\"message\":{\"content\":\"foreign-forwarded-content\"}}]}"
    set page to discord_message_read_page(body and "456" and "read" and "123")
    if string_length(page) equals 0 or else string_contains(page and "Retained words.") equals 0 or else string_contains(page and "Screen Name") equals 0 or else string_contains(page and "private-email") is not equal to 0 or else string_contains(page and "foreign-") is not equal to 0:
        return 23
    if string_length(discord_message_read_page(body and "999" and "read" and "123")) > 0 or else string_length(discord_message_read_page(body and "456" and "read" and "124")) > 0:
        return 24
    set page to discord_message_read_page("[{\"id\":\"123\",\"channel_id\":\"456\",\"author\":{\"id\":\"789\",\"username\":\"screen\",\"global_name\":\"Screen Name\",\"email\":\"private-email\"},\"content\":\"Retained words.\",\"timestamp\":\"2026-10-21T22:00:00Z\",\"referenced_message\":{\"content\":\"foreign-private-content\"},\"message_snapshots\":[{\"message\":{\"content\":\"foreign-forwarded-content\"}}]},{\"id\":\"123\",\"channel_id\":\"456\",\"author\":{\"id\":\"789\",\"username\":\"screen\",\"global_name\":\"Screen Name\",\"email\":\"private-email\"},\"content\":\"Retained words.\",\"timestamp\":\"2026-10-21T22:00:00Z\",\"referenced_message\":{\"content\":\"foreign-private-content\"},\"message_snapshots\":[{\"message\":{\"content\":\"foreign-forwarded-content\"}}]}]" and "456" and "history" and "")
    if string_length(page) > 0:
        return 25
    set page to discord_message_read_page("[{\"id\":\"123\",\"channel_id\":\"456\",\"author\":{\"id\":\"789\",\"username\":\"screen\",\"global_name\":\"Screen Name\",\"email\":\"private-email\"},\"content\":\"Retained words.\",\"timestamp\":\"2026-10-21T22:00:00Z\",\"referenced_message\":{\"content\":\"foreign-private-content\"},\"message_snapshots\":[{\"message\":{\"content\":\"foreign-forwarded-content\"}}]},{\"id\":\"123\",\"channel_id\":\"999\",\"author\":{\"id\":\"789\",\"username\":\"screen\",\"global_name\":\"Screen Name\",\"email\":\"private-email\"},\"content\":\"Retained words.\",\"timestamp\":\"2026-10-21T22:00:00Z\",\"referenced_message\":{\"content\":\"foreign-private-content\"},\"message_snapshots\":[{\"message\":{\"content\":\"foreign-forwarded-content\"}}]}]" and "456" and "history" and "")
    if string_length(page) > 0:
        return 26
    if not (discord_message_read_page("[]" and "456" and "history" and "") equals "[]"):
        return 27
    display "PASS: strict read/history arguments, bounded API pages, complete channel/ID validation, duplicate rejection and nested audience exclusion"
    return 0
