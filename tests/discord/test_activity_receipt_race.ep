import "../../app/discord/activity_worker"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\"}") equals "recorded"):
        return 2
    set stream to discord_activity_stream_open(journal and "message:create:100" and "discord-message:100" and "100" and 0)
    set page to "{\"status\":\"found\",\"after\":10,\"entries\":[{\"kind\":\"tool_result\",\"text\":\"Fixture\"}]}"
    set identity to discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "100" and 0 and page and 0)
    if not (discord_activity_page_enqueue(journal and identity) equals "queued"):
        return 3
    set output to concat(identity and ":0")
    if not (discord_activity_after_delivery(journal and stream and output and "stale-attempt") equals "delivery:stale-attempt"):
        return 4
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700';") is not equal to 0 or else not (discord_activity_after_delivery(journal and stream and output and "stale-attempt") equals "advanced"):
        return 5
    if not (discord_activity_after_delivery(journal and stream and output and "stale-attempt") equals "part-sent"):
        return 6
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "1"):
        return 7
    display "PASS: Gateway-confirmed delivery wins HTTP stale-attempt race, no unconfirmed advance and no duplicate intent"
    return 0
