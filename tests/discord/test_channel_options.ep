import "../../app/discord/channel_options"
import "../../app/discord/community_intent"
external define ep_gc_get_minor_count returning Int

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    for each raw in ["{\"operation\":\"list\",\"limit\":2,\"offset\":0}","{\"operation\":\"inspect\",\"channel\":\"300\"}","{\"operation\":\"create\",\"type\":0,\"name\":\"fixture\",\"reason\":\"test\"}","{\"operation\":\"edit\",\"channel\":\"300\",\"topic\":\"next\",\"slowmode\":7,\"position\":3,\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"reason\":\"test\"}","{\"operation\":\"delete\",\"channel\":\"300\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"reason\":\"test\"}"]:
        if not (archive_list_text(discord_channel_options(ptr_to_str(raw)) and 0) equals "valid"):
            display ptr_to_str(raw)
            return 2
    for each raw in ["{}","{\"operation\":\"list\",\"token\":\"secret\"}","{\"operation\":\"inspect\",\"channel\":\"../3\"}","{\"operation\":\"create\",\"type\":12,\"name\":\"private\",\"reason\":\"test\"}","{\"operation\":\"create\",\"type\":0,\"name\":\"missingreason\"}","{\"operation\":\"edit\",\"channel\":\"300\",\"topic\":\"x\",\"reason\":\"test\"}","{\"operation\":\"list\",\"limit\":101}","{\"operation\":\"list\",\"offset\":-1}","{\"operation\":\"edit\",\"channel\":\"300\",\"slowmode\":21601,\"reason\":\"test\",\"observed_sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"}","{\"operation\":\"create\",\"type\":2,\"name\":\"x\",\"reason\":\"test\",\"permission_overwrites\":[]}","{\"operation\":\"create\",\"type\":2,\"name\":\"x\",\"reason\":\"test\",\"bitrate\":1}"]:
        if archive_list_text(discord_channel_options(ptr_to_str(raw)) and 0) equals "valid":
            display ptr_to_str(raw)
            return 3
    set origin to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"name\":\"source\",\"permission_overwrites\":[]}"
    set target to "{\"id\":\"301\",\"guild_id\":\"200\",\"type\":2,\"name\":\"fixture\",\"permission_overwrites\":[],\"recipients\":[{\"secret\":\"private-sentinel\"}]}"
    set private_target to "{\"id\":\"302\",\"guild_id\":\"200\",\"type\":2,\"name\":\"hidden-channel-sentinel\",\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"}],\"recipients\":[{\"secret\":\"private-sentinel\"}]}"
    if discord_channel_same_audience(origin and target and "200") is not equal to 1 or else discord_channel_same_audience(origin and private_target and "200") is not equal to 0 or else discord_channel_same_audience(origin and target and "999") is not equal to 0:
        return 4
    set page_body to concat("[" and concat(private_target and concat("," and concat(target and "]"))))
    set page_options to discord_channel_options("{\"operation\":\"list\",\"limit\":1}")
    set page to discord_channels_page(page_body and origin and "200" and page_options)
    if string_contains(page and "hidden-channel-sentinel") is not equal to 0 or else string_contains(page and "private-sentinel") is not equal to 0 or else string_contains(page and "301") equals 0:
        return 5
    if discord_channel_fields_match("{\"bitrate\":64000}" and "0") is not equal to 0 or else discord_channel_fields_match("{\"topic\":\"text\"}" and "2") is not equal to 0 or else discord_channel_fields_match("{\"name\":\"category\",\"position\":2}" and "4") is not equal to 1:
        return 12
    if not (archive_list_text(discord_channel_options("{\"operation\":\"create\",\"name\":\"child\",\"type\":0,\"parent\":\"400\",\"reason\":\"fixture\"}") and 0) equals "valid") or else archive_list_text(discord_channel_options("{\"operation\":\"create\",\"name\":\"child\",\"type\":0,\"parent\":\"../400\",\"reason\":\"fixture\"}") and 0) equals "valid":
        return 13
    set before to ep_gc_get_minor_count()
    set index to 0
    repeat while ep_gc_get_minor_count() equals before and index < 3000:
        set view to discord_channel_view(target)
        if string_contains(view and "fixture") equals 0 or else string_contains(view and "private-sentinel") is not equal to 0 or else string_contains(view and ep_sha256(target)) equals 0:
            return 6
        set index to index + 1
    if ep_gc_get_minor_count() equals before:
        return 7
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_community_claim(journal and "run" and "call" and "POST/body") equals "claimed"):
        return 8
    if discord_community_claim(journal and "run" and "call" and "POST/body") equals "claimed" or else discord_community_claim(journal and "run" and "call" and "different") equals "claimed":
        return 9
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_community_claim(journal and "run" and "call" and "POST/body") equals "claimed":
        return 10
    if sql_execute(journal and "DELETE FROM discord_community_intents;") equals 0 or else sql_execute(journal and "UPDATE discord_community_intents SET body='changed';") equals 0:
        return 11
    display "PASS: strict channel fields, audience/identity exclusion, private-field projection through actual GC, durable no-replay intent and immutable restart history."
    return 0

