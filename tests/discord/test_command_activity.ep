import "../../app/discord/activity_delivery"

define auto_admit_fixture with journal as Int and identity as Str and room as Str and prompt as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":" and concat(provider_quote(prompt) and "}]}}"))))))
    set inbox to concat("interaction:" and identity)
    set saved to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and inbox) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [inbox]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_admission_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 1
    set response to concat("{\"id\":" and concat(provider_quote(concat("1" and identity)) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy request received.\",\"interaction_metadata\":{\"id\":" and concat(provider_quote(identity) and ",\"type\":2,\"user\":{\"id\":\"400\"}}}"))))))
    if not (discord_command_anchor_observe(journal and inbox and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_interaction_schema(journal) is not equal to 0 or else not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered"):
        return 2
    if auto_admit_fixture(journal and "701" and "300" and "Report progress.") is not equal to 0 or else not (discord_activity_plan(journal and "interaction:701") equals "planned"):
        return 3
    set wrong to "{\"id\":\"701\",\"parent_id\":\"300\",\"guild_id\":\"200\",\"owner_id\":\"900\",\"type\":11}"
    if not (discord_activity_observe(journal and "interaction:701" and wrong) equals "thread-binding-mismatch"):
        return 4
    set correct to "{\"id\":\"1701\",\"parent_id\":\"300\",\"guild_id\":\"200\",\"owner_id\":\"900\",\"type\":11}"
    if not (discord_activity_observe(journal and "interaction:701" and correct) equals "ready") or else not (discord_activity_observe(journal and "interaction:701" and correct) equals "ready"):
        return 5
    if not (discord_activity_recipient(journal and "interaction:701" and ["400"]) equals "400") or else not (discord_activity_recipient(journal and "interaction:701" and ["900"]) equals ""):
        return 6
    if not (discord_activity_ensure("" and "" and journal and "interaction:701" and "900" and create_list() and "" and concat(get_argument(1) and ".absent")) equals "admin-required"):
        return 7
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_activity_plan(journal and "interaction:701") equals "ready"):
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT source,thread,COUNT(*) FROM discord_activity_threads;"))
    if not (archive_list_text(row and 1) equals "1701") or else not (archive_list_text(row and 2) equals "1701") or else not (archive_list_text(row and 3) equals "1"):
        return 9
    display "PASS: command thread uses public anchor, not interaction ID; original human recipient, current admin denial before HTTP, replay and reopen preserve one binding"
    return 0
