import "../../app/discord/guild_settings_options"

define main returning Int:
    if not (archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"inspect\"}") and 0) equals "valid"):
        return 1
    if not (archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"changes\":{\"description\":\"Fixture\"}}") and 0) equals "valid"):
        return 2
    if not (archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"assets\":{\"icon\":null}}") and 0) equals "valid"):
        return 3
    if not (archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"assets\":{\"banner\":\"included-attachment\"}}") and 0) equals "valid"):
        return 4
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}") and 0) equals "valid":
        return 5
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"changes\":{},\"assets\":{}}") and 0) equals "valid":
        return 6
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"assets\":null}") and 0) equals "valid":
        return 7
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"changes\":{\"owner_id\":\"900\"}}") and 0) equals "valid":
        return 8
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"edit\",\"reason\":\"Native settings qualification\",\"observed_sha256\":\"gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg\",\"changes\":{\"description\":\"Fixture\"}}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"inspect\",\"assets\":{}}") and 0) equals "valid":
        return 10
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200/roles\",\"operation\":\"inspect\"}") and 0) equals "valid":
        return 11
    if archive_list_text(discord_guild_settings_options("{\"guild\":\"200\",\"operation\":\"delete\"}") and 0) equals "valid":
        return 12
    display "PASS: guild settings inspect/edit binding, audit reason and snapshot requirements, assets-only changes, empty/unknown/foreign-route rejection."
    return 0
