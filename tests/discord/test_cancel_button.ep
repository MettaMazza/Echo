import "../../app/discord/queue_status"

define cancel_button_body with output as Str and actor as Str and room as Str and message as Str returning Str:
    set body to concat("{\"id\":\"701\",\"application_id\":\"900\",\"type\":3,\"channel_id\":" and provider_quote(room))
    set body to concat(body and concat(",\"guild_id\":\"200\",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"message\":{\"id\":")))
    set body to concat(body and concat(provider_quote(message) and ",\"author\":{\"id\":\"900\"}},\"data\":{\"component_type\":2,\"custom_id\":"))
    return concat(body and concat(provider_quote(discord_cancel_button_identity(output)) and "}}"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_worker_schema(journal) is not equal to 0 or else discord_queue_status_schema(journal) is not equal to 0:
        return 2
    set source to "message:create:100"
    set payload to "{\"id\":\"100\",\"type\":0,\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Echo test\"}"
    if not (discord_inbox_record(journal and source and "MESSAGE_CREATE" and payload) equals "recorded"):
        return 3
    if not (discord_queue_cancel_plan(journal and 0 and source and "900" and ["200"] and []) equals "tracked"):
        return 4
    set output to concat("queue-status:" and source)
    set claim to discord_outbox_claim(journal and output and "attempt")
    if not (archive_list_text(claim and 0) equals "claimed"):
        display archive_list_text(claim and 0)
        return 5
    set finished to discord_outbox_finish(journal and output and "attempt" and "sent" and "600" and "fixture")
    set body to cancel_button_body(output and "500" and "300" and "600")
    set bound to discord_cancel_button_resolve(journal and body and "900")
    if not (archive_list_text(bound and 0) equals "cancel-bound") or else not (archive_list_text(bound and 1) equals source):
        return 6
    for each actor in ["501", "900"]:
        if not (archive_list_text(discord_cancel_button_resolve(journal and cancel_button_body(output and ptr_to_str(actor) and "300" and "600") and "900") and 0) equals "cancel-source-denied"):
            return 7
    if not (archive_list_text(discord_cancel_button_resolve(journal and cancel_button_body(output and "500" and "301" and "600") and "900") and 0) equals "cancel-source-denied") or else not (archive_list_text(discord_cancel_button_resolve(journal and cancel_button_body(output and "500" and "300" and "601") and "900") and 0) equals "cancel-source-denied"):
        return 8
    if not (discord_cancel_source(journal and source and "500" and "300" and "200" and "interaction:701") equals "queue-cancelled"):
        return 9
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set bound to discord_cancel_button_resolve(journal and body and "900")
    if not (archive_list_text(bound and 1) equals source) or else not (discord_cancel_source(journal and source and "500" and "300" and "200" and "interaction:701") equals "already-cancel-requested"):
        return 10
    set enabled to provider_json_tokens(concat("{\"components\":" and concat(discord_cancel_button_components(output and 1) and "}")))
    set disabled to provider_json_tokens(concat("{\"components\":" and concat(discord_cancel_button_components(output and 0) and "}")))
    if discord_cancel_status_matches(journal and source and enabled and -2) is not equal to 1 or else discord_cancel_status_matches(journal and source and enabled and 0) is not equal to 0 or else discord_cancel_status_matches(journal and source and disabled and 0) is not equal to 1:
        return 11
    display "PASS: Cancel button offered at queue position one, immutable source binding, foreign actor/channel/message denied, cancellation/reopen/replay and terminal disabling."
    return sql_close(journal)
