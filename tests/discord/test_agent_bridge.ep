import "../../app/discord/agent_bridge"
import "../../app/security/host_scope"
import "../../app/security/group_speakers"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0:
        return 2
    if discord_agent_open(get_argument(1) and "900") is not equal to 0 or else discord_agent_open(get_argument(2) and "901") is not equal to 0:
        return 3
    set public to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\",\"username\":\"test_account\",\"global_name\":\"Global Name\"},\"member\":{\"nick\":\"Screen Name\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"hello\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and public) equals "recorded"):
        return 4
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and ["400"])
    if not (archive_list_text(submitted and 0) equals "accepted") or else run_authority_allows(database and "discord-message:100" and "admin") is not equal to 0:
        return 5
    set owner to agent_run_read(database and "discord-message:100")
    set speaker to group_event_speaker(database and archive_list_text(owner and 0) and archive_list_text(owner and 1))
    if not string_contains(speaker and "Screen Name") or else not string_contains(speaker and "test_account"):
        return 16
    if run_authority_allows(database and "discord-message:100" and "admin") is not equal to 0:
        return 17
    if discord_agent_sender_record(database and "discord-message:100" and "{}") is not equal to 0:
        return 18
    if not (group_event_speaker(database and archive_list_text(owner and 0) and archive_list_text(owner and 1)) equals speaker):
        return 19
    set private to "{\"id\":\"101\",\"channel_id\":\"301\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"private Discord DM\"}"
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and private) equals "recorded"):
        return 6
    set dm to discord_agent_submit(journal and database and "message:create:101" and "900" and ["200"] and ["400"])
    if not (archive_list_text(dm and 0) equals "accepted") or else run_authority_allows(database and "discord-message:101" and "admin") is not equal to 1:
        return 7
    set scope to host_resource_scope(database and "discord-message:101")
    if not (archive_list_text(scope and 1) equals "discord"):
        return 8
    set owned to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_session_owners;"))
    if not (archive_list_text(owned and 1) equals "0") or else archive_list_text(submitted and 1) equals archive_list_text(dm and 1):
        return 9
    if not (archive_list_text(discord_agent_submit(journal and database and "message:create:101" and "900" and ["200"] and ["401"]) and 0) equals "intake-no-longer-authorized"):
        return 10
    if not (archive_list_text(discord_agent_submit(journal and database and "delivery:observed:700" and "900" and ["200"] and ["400"]) and 0) equals "not-user-intake"):
        return 11
    set admin_public to "{\"id\":\"102\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"public admin request\"}"
    if not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and admin_public) equals "recorded"):
        return 12
    set admin_turn to discord_agent_submit(journal and database and "message:create:102" and "900" and ["200"] and ["400"])
    if not (archive_list_text(admin_turn and 0) equals "accepted") or else run_authority_allows(database and "discord-message:102" and "admin") is not equal to 1:
        return 13
    if group_privileged_audience_allows(database and "discord-message:102") is not equal to 0 or else host_resource_scope(database and "discord-message:102") is not equal to 0:
        return 14
    if group_privileged_audience_allows(database and "discord-message:101") is not equal to 1:
        return 15
    print "PASS: independent Discord archive, authenticated principals, public/admin-DM silos; public admin authority cannot release privileged host results"
    return 0
