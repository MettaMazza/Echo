import "../../app/discord/access"
import "../../app/discord/reaction_options"

# Host acceptance fixture only. Requires the exact labelled disposable message
# and its known test author. Adds only the authenticated bot's three reactions.
define main returning Int:
    if get_argument_count() is not equal to 9 or else file_exists(get_argument(3)):
        return 1
    set secret to read_file(get_argument(2))
    if secret equals 0:
        return 2
    set token to string_trim(ptr_to_str(secret))
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 3
    set observed to discord_access_get(get_argument(1) and token and journal and get_argument(4) and "/users/@me" and "GET:fixture-self" and get_argument(5))
    if not (archive_list_text(observed and 0) equals "observed"):
        return 4
    set tokens to provider_json_tokens(archive_list_text(observed and 1))
    if not (provider_value(tokens and provider_member(tokens and 0 and "id")) equals get_argument(5)):
        return 5
    set route to concat("/channels/" and concat(get_argument(6) and concat("/messages/" and get_argument(7))))
    set observed to discord_access_get(get_argument(1) and token and journal and get_argument(4) and route and "GET:fixture-message" and get_argument(6))
    if not (archive_list_text(observed and 0) equals "observed"):
        return 6
    set tokens to provider_json_tokens(archive_list_text(observed and 1))
    if not (provider_value(tokens and provider_member(tokens and 0 and "id")) equals get_argument(7)) or else not (provider_value(tokens and provider_member(tokens and 0 and "channel_id")) equals get_argument(6)) or else not (provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "author") and "id")) equals get_argument(8)) or else not (provider_value(tokens and provider_member(tokens and 0 and "content")) equals "Disposable moderation acceptance fixture: violet-fern-729. This test-only message may be deleted after its three seeded reactions are tested."):
        return 7
    for each emoji in ["🌿","🌱","🌸"]:
        set encoded to network_query_encode(ptr_to_str(emoji))
        set target to concat(route and concat("/reactions/" and concat(encoded and "/@me")))
        set deadline to discord_rate_deadline(journal and "PUT:fixture-own-reaction" and get_argument(6))
        if deadline > ep_time_now_ms():
            set waited to sleep_ms(deadline - ep_time_now_ms() + 1)
        set result to discord_access_request(get_argument(1) and token and journal and get_argument(4) and "PUT" and target and "PUT:fixture-own-reaction" and get_argument(6))
        if not (archive_list_text(result and 0) equals "observed"):
            display archive_list_text(result and 0)
            return 8
        display archive_list_text(result and 3)
    display "Seeded three bot-owned fixture reactions; no message deleted."
    return 0
