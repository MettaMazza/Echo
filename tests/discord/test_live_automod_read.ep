import "../../app/discord/access"
import "../../app/discord/automod_view"

# Independent read-only acceptance helper. The output remains in the private
# evidence directory; this helper does not grant model tool authority.
define main returning Int:
    if get_argument_count() is not equal to 7 or else discord_snowflake(get_argument(6)) equals 0:
        return 1
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 3
    set route to discord_automod_route(get_argument(6) and "")
    set response to discord_access_get(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and route and "GET:automod-independent-readback" and get_argument(6))
    if not (archive_list_text(response and 0) equals "observed"):
        display archive_list_text(response and 0)
        return 4
    set projected to discord_automod_collection(archive_list_text(response and 1) and get_argument(6))
    if string_length(projected) equals 0:
        return 5
    set target to concat(get_argument(4) and "/automod-projection.json")
    if file_exists(target) or else write_file(target and projected) is not equal to 1:
        return 6
    display "Verified guild-bound automod collection; projection retained privately."
    return sql_close(journal)
