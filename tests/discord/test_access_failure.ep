import "../../app/discord/access_failure"

define main returning Int:
    set observed to create_list()
    set added to append_list(observed and "rate-limited")
    set added to append_list(observed and "1792636116212")
    set result to discord_access_failure_result(observed and "member permission snapshot")
    set fields to provider_json_tokens(result)
    if not (provider_value(fields and provider_member(fields and 0 and "status")) equals "rate-limited") or else not (provider_value(fields and provider_member(fields and 0 and "retry_at_unix_ms")) equals "1792636116212") or else string_contains(result and "not an access revocation") equals 0:
        return 1
    set failed to create_list()
    set added to append_list(failed and "http-403")
    set added to append_list(failed and "ecb1ef7a-0c09-4f20-96a6-4079c1390b14.json")
    set result to discord_access_failure_result(failed and "member permission snapshot")
    if string_contains(result and "http-403") equals 0 or else string_contains(result and "ecb1ef7a-0c09-4f20-96a6-4079c1390b14.json") equals 0 or else string_contains(result and "retry_at_unix_ms") is not equal to 0:
        return 2
    set denied to create_list()
    set added to append_list(denied and "permission-denied")
    set added to append_list(denied and "sensitive-snapshot-sentinel")
    set result to discord_access_failure_result(denied and "source permission check")
    if string_contains(result and "permission-denied") equals 0 or else string_contains(result and "sensitive-snapshot-sentinel") is not equal to 0:
        return 3
    display "PASS: preserve rate deadline, permission/transport status and receipt without snapshot disclosure or false revocation."
    return 0
