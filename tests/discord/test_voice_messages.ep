import "../../app/discord/voice_messages"

define main returning Int:
    set session to "session\"with\\escapes"
    set token to "fixture\nsecret\tvalue"
    set identify to discord_voice_identify_body("123" and "456" and session and token and 1)
    set tokens to provider_json_tokens(identify)
    set data to provider_member(tokens and 0 and "d")
    if not (provider_value(tokens and provider_member(tokens and 0 and "op")) equals "0") or else not (provider_value(tokens and provider_member(tokens and data and "session_id")) equals session) or else not (provider_value(tokens and provider_member(tokens and data and "token")) equals token):
        return 1
    set resume_body to discord_voice_resume_body("123" and "456" and session and token and 65535)
    set tokens to provider_json_tokens(resume_body)
    set data to provider_member(tokens and 0 and "d")
    if not (provider_value(tokens and provider_member(tokens and 0 and "op")) equals "7") or else not (provider_value(tokens and provider_member(tokens and data and "seq_ack")) equals "65535") or else not (provider_value(tokens and provider_member(tokens and data and "token")) equals token):
        return 2
    if not (discord_voice_identify_body("12x" and "456" and session and token and 1) equals "") or else not (discord_voice_resume_body("123" and "456" and "" and token and 1) equals ""):
        return 3
    if not (discord_voice_identify_body("123" and "456" and session and token and 0) equals "") or else not (discord_voice_resume_body("123" and "456" and session and token and 65536) equals ""):
        return 4
    set selected to discord_voice_select_body("192.168.1.2" and 5555)
    set tokens to provider_json_tokens(selected)
    set data to provider_member(tokens and 0 and "d")
    set network to provider_member(tokens and data and "data")
    if not (provider_value(tokens and provider_member(tokens and network and "address")) equals "192.168.1.2") or else not (provider_value(tokens and provider_member(tokens and network and "mode")) equals "aead_xchacha20_poly1305_rtpsize"):
        return 5
    if discord_voice_select_body("2001:db8::1" and 65535) equals "" or else not (discord_voice_select_body("host.example" and 5555) equals "") or else not (discord_voice_select_body("999.1.1.1" and 5555) equals "") or else not (discord_voice_select_body("192.168.1.2" and 0) equals ""):
        return 6
    if not (discord_voice_speaking_body(4294967295 and 1) equals "{\"op\":5,\"d\":{\"speaking\":1,\"delay\":0,\"ssrc\":4294967295}}") or else not (discord_voice_speaking_body(1 and 2) equals ""):
        return 7
    if not (discord_voice_transition_body(23 and 512) equals "{\"op\":23,\"d\":{\"transition_id\":512}}") or else not (discord_voice_transition_body(31 and 0) equals "{\"op\":31,\"d\":{\"transition_id\":0}}") or else not (discord_voice_transition_body(22 and 1) equals ""):
        return 8
    display "PASS: voice Identify/Resume preserve escaped credentials; UDP selection validates numeric addresses; speaking and DAVE responses enforce wire bounds."
    return 0
