import "../../app/discord/interaction_recovery"

define visibility_fixture with journal as Int and id as Str and name as Str returning Str:
    set body to concat("{\"id\":" and concat(provider_quote(id) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":" and concat(provider_quote(name) and "}}"))))
    set identity to concat("interaction:" and id)
    set saved to discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and identity) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledging' WHERE identity=?1;" and [identity]) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_interaction_schema(journal) is not equal to 0:
        return 2
    set before_registration to visibility_fixture(journal and "703" and "auto")
    if not (discord_interaction_visibility_prepare(journal and "interaction:703" and before_registration) equals "private") or else not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else not (discord_interaction_visibility_prepare(journal and "interaction:703" and before_registration) equals "private"):
        return 8
    set body to visibility_fixture(journal and "701" and "auto")
    set other to visibility_fixture(journal and "702" and "new")
    if not (discord_interaction_visibility_prepare(journal and "interaction:701" and body) equals "public") or else not (discord_interaction_visibility_prepare(journal and "interaction:702" and other) equals "private"):
        return 3
    if not (discord_interaction_visibility_prepare(journal and "interaction:701" and other) equals "ack-source-denied") or else not (discord_interaction_visibility_read(journal and "interaction:701" and other) equals "ack-source-denied"):
        return 4
    set response to "{\"id\":\"1001\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"},\"flags\":128,\"interaction_metadata\":{\"id\":\"701\",\"type\":2,\"user\":{\"id\":\"400\"}}}"
    if discord_interaction_public_original_matches(response and body and "900") is not equal to 1:
        return 5
    for each changed in [string_replace(response and "\"flags\":128" and "\"flags\":192"),string_replace(response and "\"id\":\"701\"" and "\"id\":\"703\""),string_replace(response and "\"id\":\"400\"" and "\"id\":\"401\""),string_replace(response and "\"channel_id\":\"300\"" and "\"channel_id\":\"301\""),string_replace(response and "\"type\":2" and "\"original_response_message_id\":\"999\",\"type\":2")]:
        if discord_interaction_public_original_matches(ptr_to_str(changed) and body and "900") is not equal to 0:
            return 6
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_interaction_visibility_read(journal and "interaction:701" and body) equals "public") or else not (discord_interaction_visibility_read(journal and "interaction:702" and other) equals "private") or else not (discord_interaction_visibility_read(journal and "legacy-private" and "{}") equals "private"):
        return 7
    display "PASS: registered auto public ACK, other controls private, exact intake digest, public recovery actor/interaction/channel/privacy/follow-up checks and restart/legacy compatibility"
    return 0
