import "../../app/discord/expression_guard"

define expression_fixture_roles with permissions as Str returning Str:
    return concat("[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\",\"managed\":false},{\"id\":\"201\",\"position\":1,\"permissions\":" and concat(provider_quote(permissions) and ",\"managed\":false}]"))

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set member to "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\"]}"
    set create_roles to expression_fixture_roles("8796093022208")
    set manage_roles to expression_fixture_roles("1073741824")
    set no_roles to expression_fixture_roles("0")
    if discord_expression_permission(server and create_roles and member and "200" and "500" and "" and 0 and "create") is not equal to 1:
        return 1
    if discord_expression_permission(server and manage_roles and member and "200" and "500" and "" and 0 and "create") is not equal to 0:
        return 2
    if discord_expression_permission(server and create_roles and member and "200" and "500" and "500" and 0 and "modify") is not equal to 1:
        return 3
    if discord_expression_permission(server and create_roles and member and "200" and "500" and "501" and 0 and "modify") is not equal to 0:
        return 4
    if discord_expression_permission(server and create_roles and member and "200" and "500" and "" and 0 and "delete") is not equal to 0:
        return 5
    if discord_expression_permission(server and manage_roles and member and "200" and "500" and "501" and 0 and "delete") is not equal to 1:
        return 6
    if discord_expression_permission(server and manage_roles and member and "200" and "500" and "501" and 1 and "delete") is not equal to 0:
        return 7
    if discord_expression_permission(server and no_roles and member and "200" and "500" and "" and 1 and "read") is not equal to 1:
        return 8
    if discord_expression_permission(server and no_roles and member and "200" and "500" and "500" and 0 and "delete") is not equal to 0:
        return 9
    if discord_expression_permission(server and manage_roles and member and "201" and "500" and "500" and 0 and "delete") is not equal to 0:
        return 10
    if discord_expression_permission(server and manage_roles and member and "200" and "501" and "500" and 0 and "delete") is not equal to 0:
        return 11
    if discord_expression_permission(server and manage_roles and member and "200" and "500" and "500" and 0 and "unknown") is not equal to 0:
        return 12
    if discord_expression_permission(server and manage_roles and member and "200" and "500" and "500" and 2 and "read") is not equal to 0:
        return 13
    set admin_roles to expression_fixture_roles("8")
    if discord_expression_permission(server and admin_roles and member and "200" and "500" and "501" and 0 and "modify") is not equal to 1:
        return 14
    if discord_expression_permission(server and admin_roles and member and "200" and "500" and "501" and 1 and "modify") is not equal to 0:
        return 15
    display "PASS: guild expression create/manage/ownership separation, managed-resource refusal, current guild/member binding and unknown-operation denial."
    return 0
