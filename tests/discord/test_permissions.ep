import "../../app/discord/permissions"

define main returning Int:
    if discord_permission_bit("276488" and 3) is not equal to 1 or else discord_permission_bit("0" and 10) is not equal to 0 or else discord_permission_bit("1e6" and 10) is not equal to -1:
        return 1
    # Greater than uint64; low bits remain exact, without float conversion.
    if discord_permission_bit("18446744073709552640" and 10) is not equal to 1 or else discord_permission_bit("18446744073709551616" and 10) is not equal to 0:
        return 2
    set guild to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set member to "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\",\"202\"]}"
    set roles to "[{\"id\":\"200\",\"permissions\":\"3072\"},{\"id\":\"201\",\"permissions\":\"0\"},{\"id\":\"202\",\"permissions\":\"0\"}]"
    set prefix to "{\"id\":\"300\",\"guild_id\":\"200\",\"permission_overwrites\":"
    set mixed to concat(prefix and "[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"},{\"id\":\"201\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"},{\"id\":\"202\",\"type\":0,\"allow\":\"1024\",\"deny\":\"0\"}]}")
    if discord_channel_permission(guild and roles and member and mixed and "200" and "500" and "300" and 10) is not equal to 1:
        return 3
    set denied to concat(prefix and "[{\"id\":\"202\",\"type\":0,\"allow\":\"1024\",\"deny\":\"0\"},{\"id\":\"500\",\"type\":1,\"allow\":\"0\",\"deny\":\"1024\"}]}")
    if discord_channel_permission(guild and roles and member and denied and "200" and "500" and "300" and 10) is not equal to 0:
        return 4
    set allowed to concat(prefix and "[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"},{\"id\":\"500\",\"type\":1,\"allow\":\"1024\",\"deny\":\"0\"}]}")
    if discord_channel_permission(guild and roles and member and allowed and "200" and "500" and "300" and 10) is not equal to 1:
        return 5
    if discord_channel_permission(guild and roles and member and allowed and "200" and "501" and "300" and 10) is not equal to -1 or else discord_channel_permission(guild and roles and member and allowed and "200" and "500" and "301" and 10) is not equal to -1:
        return 6
    if discord_channel_permission(guild and "[{\"id\":\"200\",\"permissions\":\"8\"}]" and member and allowed and "200" and "500" and "300" and 10) is not equal to -1:
        return 7
    set admin_roles to "[{\"id\":\"200\",\"permissions\":\"3072\"},{\"id\":\"201\",\"permissions\":\"8\"},{\"id\":\"202\",\"permissions\":\"0\"}]"
    if discord_channel_permission(guild and admin_roles and member and denied and "200" and "500" and "300" and 10) is not equal to 1:
        return 8
    display "PASS: exact large permission integers, overwrite precedence, identity/role completeness and Discord Administrator bypass"
    return 0
