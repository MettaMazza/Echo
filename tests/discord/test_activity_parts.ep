import "../../app/discord/activity_stream"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\"}") equals "recorded"):
        return 2
    set stream to discord_activity_stream_open(journal and "message:create:100" and "discord-message:100" and "800" and 1)
    set text to ""
    set count to 0
    repeat while count < 1100:
        set text to concat(text and "🎧")
        set count to count + 1
    set page to concat("{\"status\":\"found\",\"after\":10,\"entries\":[{\"kind\":\"model_reasoning\",\"text\":" and concat(provider_quote(text) and "}]}"))
    set identity to discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "800" and 0 and page and 1)
    if not (discord_activity_page_enqueue(journal and identity) equals "queued"):
        return 3
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "3"):
        return 4
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE rowid=(SELECT MIN(rowid) FROM discord_outbox);") is not equal to 0 or else not (discord_activity_stream_commit(journal and stream) equals "waiting"):
        return 5
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_activity_page_enqueue(journal and identity) equals "queued") or else not (discord_activity_stream_commit(journal and stream) equals "waiting"):
        return 6
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='701';") is not equal to 0 or else not (discord_activity_stream_commit(journal and stream) equals "advanced") or else not (discord_activity_stream_commit(journal and stream) equals "waiting"):
        return 7
    set zero to "{\"status\":\"found\",\"after\":11,\"entries\":[]}"
    set blank to discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "800" and 10 and zero and 1)
    if not (discord_activity_page_enqueue(journal and blank) equals "queued") or else not (discord_activity_stream_commit(journal and stream) equals "advanced"):
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "3"):
        return 9
    display "PASS: multi-part partial-delivery hold across restart, all-parts commit exactly once, empty filtered page advances without an empty message"
    return 0
