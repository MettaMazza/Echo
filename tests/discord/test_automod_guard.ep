import "../../app/discord/automod_guard"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"600\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\"},{\"id\":\"201\",\"position\":1,\"permissions\":\"32\"},{\"id\":\"202\",\"position\":2,\"permissions\":\"1099511627808\"}]"
    set requester to "{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]}"
    set moderator to "{\"user\":{\"id\":\"400\"},\"roles\":[\"202\"]}"
    set bot_member to "{\"user\":{\"id\":\"900\"},\"roles\":[\"201\"]}"
    set bot_moderator to "{\"user\":{\"id\":\"900\"},\"roles\":[\"202\"]}"
    set no_manage to "{\"user\":{\"id\":\"400\"},\"roles\":[]}"
    set bot_no_manage to "{\"user\":{\"id\":\"900\"},\"roles\":[]}"
    set candidate to "{\"actions\":[{\"type\":3,\"metadata\":{\"duration_seconds\":60}}]}"
    set bundle to create_list()
    set bundle to ["observed",server,roles,requester,bot_member,requester,"null"]
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and candidate and 0) is not equal to 1:
        return 1
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and candidate and 1) is not equal to 0:
        return 2
    if discord_automod_bundle_allowed(bundle and "201" and "400" and "900" and "{}" and 0) is not equal to 0:
        return 3
    if discord_automod_bundle_allowed(bundle and "200" and "401" and "900" and "{}" and 0) is not equal to 0:
        return 4
    set bundle to ["observed",server,roles,moderator,bot_member,moderator,"null"]
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and candidate and 1) is not equal to 0:
        return 5
    set bundle to ["observed",server,roles,requester,bot_moderator,requester,"null"]
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and candidate and 1) is not equal to 0:
        return 6
    set bundle to ["observed",server,roles,moderator,bot_moderator,moderator,"null"]
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and candidate and 1) is not equal to 1:
        return 7
    set bundle to ["observed",server,roles,no_manage,bot_moderator,no_manage,"null"]
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and "{}" and 0) is not equal to 0:
        return 8
    set bundle to ["observed",server,roles,moderator,bot_no_manage,moderator,"null"]
    if discord_automod_bundle_allowed(bundle and "200" and "400" and "900" and "{}" and 0) is not equal to 0:
        return 9
    set rule to "{\"id\":\"700\",\"guild_id\":\"200\",\"name\":\"fixture\",\"private_unrequested\":\"excluded\"}"
    set view to discord_automod_view(rule and "200" and "700")
    if string_length(view) equals 0 or else string_contains(view and "private_unrequested") is not equal to 0:
        return 10
    if string_length(discord_automod_view(rule and "201" and "700")) is not equal to 0 or else string_length(discord_automod_view(rule and "200" and "701")) is not equal to 0:
        return 11
    if string_length(discord_automod_collection(concat("[" and concat(rule and concat("," and concat(rule and "]")))) and "200")) is not equal to 0:
        return 12
    if not (discord_automod_collection("[]" and "200") equals "[]"):
        return 13
    if not (discord_automod_route("200" and "700") equals "/guilds/200/auto-moderation/rules/700") or else string_length(discord_automod_route("200/roles" and "")) is not equal to 0:
        return 14
    display "PASS: independent manage-guild and timeout permissions, guild/member binding, private-field projection, duplicate rule rejection and derived routes."
    return 0
