import "../../app/discord/background_settle"
import "../../app/web/worker"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background receipt fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "receipt-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved"):
        return 5
    if not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "receipt-worker" and 123 and "fixture") equals "recorded"):
        return 6
    if sql_execute(database and "UPDATE echo_web_workers SET status='token-count-failed';") is not equal to 0 or else discord_background_settle(journal and database) is not equal to 0:
        return 7
    set row to agent_run_read(database and "discord-message:100")
    set session to archive_list_text(row and 0)
    if archive_append(database and session and "stop:summary" and "autonomy_summary_requested" and "{\"run_id\":\"discord-message:100\"}" and "now") is not equal to 0 or else discord_background_settle(journal and database) is not equal to 0:
        return 8
    set held to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "recovery"):
        return 9
    if archive_append(database and session and "stop:summary:done" and "autonomy_summary_outcome" and "{\"run_id\":\"discord-message:100\",\"status\":\"enqueued\"}" and "now") is not equal to 0 or else discord_background_settle(journal and database) is not equal to 0 or else discord_background_settle(journal and database) is not equal to 0:
        return 10
    set counts to history_collect_one(archive_prepare(journal and "SELECT state,(SELECT COUNT(*) FROM discord_background_events WHERE state='released') FROM discord_background_runs;"))
    set row to agent_run_read(database and "discord-message:100")
    if not (archive_list_text(counts and 1) equals "released") or else not (archive_list_text(counts and 2) equals "1") or else not (archive_list_text(row and 2) equals "ready"):
        return 11
    display "PASS: dead autonomous worker remains held until its closing report is enqueued, releases once, and retains the ready recovery boundary."
    return 0
