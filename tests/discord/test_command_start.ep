import "../../app/discord/command_start"

define auto_admit_fixture with journal as Int and identity as Str and room as Str and prompt as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":\"400\",\"username\":\"fixture_user\",\"global_name\":\"Fixture Global\"},\"nick\":\"Fixture Nick\"},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":" and concat(provider_quote(prompt) and "}]}}"))))))
    set inbox to concat("interaction:" and identity)
    set saved to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and inbox) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [inbox]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_admission_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 1
    set response to concat("{\"id\":" and concat(provider_quote(concat("1" and identity)) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy request received.\",\"interaction_metadata\":{\"id\":" and concat(provider_quote(identity) and ",\"type\":2,\"user\":{\"id\":\"400\"}}}"))))))
    if not (discord_command_anchor_observe(journal and inbox and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 1
    return 0

define background_fixture_message with journal as Int and message as Str and user as Str and room as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(user) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public scheduler fixture.\"}"))))))
    set inbox to concat("message:create:" and message)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if discord_worker_schema(journal) is not equal to 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else auto_admit_fixture(journal and "701" and "300" and "Exact command task.") is not equal to 0:
        return 3
    set source to discord_command_anchor_read(journal and "interaction:701")
    set body to archive_list_text(source and 6)
    set run to "discord-command:interaction:701"
    if background_fixture_message(journal and "100" and "400" and "300") is not equal to 0 or else not (archive_list_text(discord_worker_claim(journal) and 1) equals "message:create:100") or else not (discord_command_start_apply(journal and database and "interaction:701" and body and "900" and ["200"] and ["400"]) equals "command-reservation:conversation-busy"):
        return 4
    set absent to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_runs WHERE run=?1;" and [run]))
    if not (archive_list_text(absent and 1) equals "0") or else not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "recorded"):
        return 5
    if not (discord_command_start_apply(journal and database and "interaction:701" and body and "900" and ["200"] and ["400"]) equals "autonomy-admitted"):
        return 6
    set sender to archive_read_event(database and concat(run and ":discord-sender"))
    set names to provider_json_tokens(archive_list_text(sender and 3))
    if not (provider_value(names and provider_member(names and 0 and "user_id")) equals "400") or else not (provider_value(names and provider_member(names and 0 and "username")) equals "fixture_user") or else not (provider_value(names and provider_member(names and 0 and "display_name")) equals "Fixture Nick"):
        return 7
    if not (discord_command_start_apply(journal and database and "interaction:701" and body and "900" and ["200"] and ["400"]) equals "autonomy-already-admitted"):
        return 8
    if agent_cancel_run(database and run) is not equal to 0 or else not (discord_background_transition(journal and run and "reserved" and "released" and "" and 0 and "fixture cancellation") equals "recorded"):
        return 9
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_command_start_apply(journal and database and "interaction:701" and body and "900" and ["200"] and ["400"]) equals "autonomy-already-admitted"):
        return 10
    set state to history_collect_one(checkpoint_prepare(journal and "SELECT state FROM discord_background_runs WHERE run=?1;" and [run]))
    if not (archive_list_text(state and 1) equals "released") or else not (discord_command_start_apply(journal and database and "interaction:701" and body and "900" and ["200"] and create_list()) equals "admin-required"):
        return 11
    set foreign to discord_agent_open(concat(get_argument(2) and ".foreign") and "901")
    if not (discord_command_start_apply(journal and foreign and "interaction:701" and body and "900" and ["200"] and ["400"]) equals "archive-binding-denied"):
        return 12
    set released to history_collect_one(checkpoint_prepare(journal and "SELECT state FROM discord_background_runs WHERE run=?1;" and [run]))
    if not (archive_list_text(released and 1) equals "released") or else discord_command_sender_record(database and run and string_replace(body and "\"id\":\"400\"" and "\"id\":\"401\"")) is not equal to 1:
        return 13
    display "PASS: reserve before admission, busy creates no run, original member account labels, active replay, cancelled replay after reopen does not reacquire, current admin gate, rejected foreign archive releases reservation and sender identity cannot be replaced"
    return 0
