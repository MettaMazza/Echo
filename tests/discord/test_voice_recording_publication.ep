import "../../app/discord/voice_recording_publication"
import "../../app/discord/agent_bridge"

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    set fixture to ep_dlopen(get_argument(3))
    if database equals 0 or else journal equals 0 or else fixture equals 0:
        return 2
    set mode to get_argument(5)
    set fixture_mode to 0
    if mode equals "source-changed":
        set fixture_mode to 6
    else if mode equals "view-permission-denied":
        set fixture_mode to 16
    else if mode equals "recording-publication-refresh-required":
        set fixture_mode to 17
    else if mode equals "recording-publication-authority-denied":
        set fixture_mode to 18
    else if mode equals "closed-voice":
        set fixture_mode to 12
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and fixture_mode and str_to_ptr(get_argument(2)))
    set configured_archive to ep_dlcall1(ep_dlsym(fixture and "fixture_recording_archive") and str_to_ptr(get_argument(1)))
    set row to history_collect_one(archive_prepare(journal and "SELECT identity FROM discord_voice_recording_artifacts ORDER BY after_nonce LIMIT 1;"))
    if not (archive_list_text(row and 0) equals "found"):
        return 3
    set identity to archive_list_text(row and 1)
    set admins to ["500"]
    if mode equals "recording-publication-scope-denied":
        set admins to ["501"]
    set result to discord_voice_recording_publish(get_argument(3) and "fixture-token-no-network-123456" and journal and database and identity and "900" and ["200"] and admins and get_argument(4) and "/absent-fixture-stop")
    if not (mode equals "normal" or else mode equals "closed-voice"):
        if not (archive_list_text(result and 0) equals mode):
            display archive_list_text(result and 0)
            return 4
        set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_voice_recording_publications;"))
        if not (archive_list_text(count and 1) equals "0"):
            return 5
        display concat("PASS: " and mode)
        return 0
    if not (archive_list_text(result and 0) equals "recording-published"):
        display archive_list_text(result and 0)
        return 6
    set repeated to discord_voice_recording_publish(get_argument(3) and "fixture-token-no-network-123456" and journal and database and identity and "900" and ["200"] and admins and get_argument(4) and "/absent-fixture-stop")
    if not (archive_list_text(repeated and 0) equals "recording-published") or else not (archive_list_text(result and 1) equals archive_list_text(repeated and 1)):
        display archive_list_text(repeated and 0)
        return 7
    set owner to discord_agent_principal(database and "500" and ["500"])
    set guest to discord_agent_principal(database and "501" and ["500"])
    set owned to web_attachment_owned(database and owner and archive_list_text(result and 1))
    set denied to web_attachment_owned(database and guest and archive_list_text(result and 1))
    if not (archive_list_text(owned and 0) equals "found") or else not (archive_list_text(denied and 0) equals "end"):
        return 8
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_voice_recording_publications;"))
    if not (archive_list_text(count and 1) equals "1"):
        return 9
    display "PASS: completed recording publishes exact audio and provenance to the admitted session, repeated publication is idempotent, and another active user cannot read its attachments."
    return 0
