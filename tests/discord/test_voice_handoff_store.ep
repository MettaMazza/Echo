import "../../app/discord/gateway_intake"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_runtime_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set recorded to discord_gateway_dispatch(database and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set guilds to create_list()
    set guilds to ["100","101"]
    set admins to create_list()
    set admins to ["400"]
    set evidence to ep_sha256("access")
    set requested to discord_voice_intent_request(database and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claimed to discord_voice_intent_claim(database and "join" and "generation" and 1 and evidence)
    set written to discord_voice_intent_written(database and "join" and archive_list_text(claimed and 1) and 1)
    set server to "{\"op\":0,\"s\":2,\"t\":\"VOICE_SERVER_UPDATE\",\"d\":{\"guild_id\":\"100\",\"token\":\"fixture-private-token\",\"endpoint\":\"fixture.discord.media:2048\"}}"
    # A dispatch rollback must also roll back private credentials and cursor.
    set injected to sql_execute(database and "CREATE TRIGGER fixture_receipt_failure BEFORE INSERT ON discord_dispatch WHEN NEW.kind='VOICE_SERVER_UPDATE' BEGIN SELECT RAISE(ABORT,'fixture receipt failure'); END;")
    if not (discord_gateway_intake(database and "generation" and "300" and guilds and admins and server) equals "receipt-failed"):
        return 2
    set count to history_collect_one(archive_prepare(database and "SELECT count(*) FROM discord_voice_handoffs;"))
    if not (archive_list_text(count and 1) equals "0"):
        return 3
    set removed to sql_execute(database and "DROP TRIGGER fixture_receipt_failure;")
    if not (discord_gateway_intake(database and "generation" and "300" and guilds and admins and server) equals "recorded"):
        return 4
    set now to ep_time_now_ms()
    if discord_voice_handoff_claim(database and "join" and "generation" and "300" and now and 1 and 0) is not equal to 0:
        return 5
    set own to "{\"op\":0,\"s\":3,\"t\":\"VOICE_STATE_UPDATE\",\"d\":{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"voice-session\"}}"
    if not (discord_gateway_intake(database and "generation" and "300" and guilds and admins and own) equals "recorded"):
        return 6
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "300")
    if discord_voice_handoff_claim(database and "join" and "generation" and "300" and now and 0 and 0) is not equal to 0 or else discord_voice_handoff_claim(database and "join" and "old" and "300" and now and 1 and 0) is not equal to 0:
        return 7
    set handoff to discord_voice_handoff_claim(database and "join" and "generation" and "300" and now and 1 and 0)
    if discord_voice_handoff_ready(handoff) is not equal to 1:
        return 8
    set credentials to discord_voice_handoff_take(handoff)
    if not (archive_list_text(credentials and 2) equals "voice-session") or else not (archive_list_text(credentials and 3) equals "fixture-private-token"):
        return 9
    if discord_voice_handoff_claim(database and "join" and "generation" and "300" and now and 1 and 0) is not equal to 0:
        return 10
    set count to history_collect_one(archive_prepare(database and "SELECT count(*) FROM discord_inbox;"))
    set cleared to history_collect_one(archive_prepare(database and "SELECT length(token),length(endpoint),consumed FROM discord_voice_handoffs WHERE identity='join';"))
    if not (archive_list_text(count and 1) equals "0") or else not (archive_list_text(cleared and 1) equals "0") or else not (archive_list_text(cleared and 2) equals "0") or else not (archive_list_text(cleared and 3) equals "1"):
        return 11
    set server to "{\"op\":0,\"s\":4,\"t\":\"VOICE_SERVER_UPDATE\",\"d\":{\"guild_id\":\"100\",\"token\":\"fixture-late-token\",\"endpoint\":\"fixture.discord.media:2048\"}}"
    set recorded to discord_gateway_intake(database and "generation" and "300" and guilds and admins and server)
    if discord_voice_handoff_claim(database and "join" and "generation" and "300" and now and 1 and 0) is not equal to 0:
        return 12
    set requested to discord_voice_intent_request(database and "expiry" and "101" and "201" and "400" and "run" and "call2" and evidence)
    set claimed to discord_voice_intent_claim(database and "expiry" and "generation" and 4 and evidence)
    set written to discord_voice_intent_written(database and "expiry" and archive_list_text(claimed and 1) and 1)
    set own to "{\"op\":0,\"s\":5,\"t\":\"VOICE_STATE_UPDATE\",\"d\":{\"guild_id\":\"101\",\"user_id\":\"300\",\"channel_id\":\"201\",\"session_id\":\"other-voice\"}}"
    set recorded to discord_gateway_intake(database and "generation" and "300" and guilds and admins and own)
    set server to "{\"op\":0,\"s\":6,\"t\":\"VOICE_SERVER_UPDATE\",\"d\":{\"guild_id\":\"101\",\"token\":\"fixture-expiry-token\",\"endpoint\":\"fixture.discord.media:2048\"}}"
    set recorded to discord_gateway_intake(database and "generation" and "300" and guilds and admins and server)
    if discord_voice_handoff_claim(database and "expiry" and "generation" and "300" and ep_time_now_ms() + 30001 and 1 and 0) is not equal to 0:
        return 13
    set cleared to history_collect_one(archive_prepare(database and "SELECT length(token),consumed FROM discord_voice_handoffs WHERE identity='expiry';"))
    if not (archive_list_text(cleared and 1) equals "0") or else not (archive_list_text(cleared and 2) equals "1"):
        return 14
    set expired_intent to history_collect_one(archive_prepare(database and "SELECT state FROM discord_voice_intents WHERE identity='expiry';"))
    if not (archive_list_text(expired_intent and 1) equals "leave-required"):
        return 15
    set closed to sql_close(database)
    display "PASS: authenticated Gateway handoff is atomic, private, restart-safe, single-use, generation-bound and expiring; no voice credential reaches the inbox."
    return 0
