import "../../app/discord/cancel_control"
import "../../app/discord/agent_bridge"
import "../fixtures/tool_call_fixture"

define event_wait_cancel_later with path as Str and completed as Int returning Int:
    set waited to sleep_ms(150)
    set journal to discord_store_open(path and "900")
    set result to discord_cancel_source(journal and "message:create:100" and "500" and "300" and "200" and "event-wait-test")
    set closed to sql_close(journal)
    send result to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set host to archive_open(get_argument(1))
    if host equals 0 or else web_run_schema(host) is not equal to 0:
        return 2
    if web_pairing_invite(host and "host") is not equal to 0 or else web_device_pair(host and "host" and "host" and "host" and "fixture-secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(host and "host" and "host-run" and "" and "list")
    if string_contains(session_tool_schemas_owned(host and "host-run") and "discord_events") is not equal to 0:
        return 4
    set denied to tool_fixture_call(host and "host" and "host-run" and "discord_events" and "{\"operation\":\"list\"}")
    if string_contains(denied and "discord-runtime-unavailable") equals 0:
        display denied
        return 5
    set database to discord_agent_open(get_argument(2) and "900")
    if database equals 0 or else not (delegation_schema(database) equals "applied") or else web_cancel_schema(database) is not equal to 0:
        return 6
    set admins to create_list()
    set device to discord_agent_principal(database and "400" and admins)
    set submitted to web_submit_owned(database and device and "discord-shaped-local-run" and "" and "list")
    if string_contains(session_tool_schemas_owned(database and "discord-shaped-local-run") and "discord_events") equals 0:
        return 7
    set denied to tool_fixture_call(database and device and "discord-shaped-local-run" and "discord_events" and "{\"operation\":\"list\"}")
    if string_contains(denied and "discord-runtime-unavailable") equals 0:
        display denied
        return 8
    if tool_policy_allows(database and "discord-shaped-local-run" and "forged-call" and "discord_events") is not equal to 0:
        return 9
    if discord_pin_admin(database and "discord-shaped-local-run" and "jobs") is not equal to 0:
        return 10
    set options to discord_event_options("{\"operation\":\"list\"}")
    set source to ["found","MESSAGE_CREATE","{}","400","300","200","100","0"]
    set result to discord_events_perform("" and "" and 0 and database and "discord-shaped-local-run" and "jobs" and source and options and "900" and ["200"] and [] and "" and "/absent")
    if string_contains(result and "admin-required") equals 0 or else string_contains(result and "requester-role-required") equals 0:
        return 11
    set admin_ids to ["500"]
    set admin_device to discord_agent_principal(database and "500" and admin_ids)
    set journal to discord_store_open(get_argument(3) and "900")
    set source_body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Inspect events\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source_body) equals "recorded"):
        return 12
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and admin_ids)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 12
    set original_receipt to archive_read_event(database and "discord-message:100:user:received")
    if original_receipt equals 0 or else not (archive_list_text(original_receipt and 2) equals "input_received"):
        return 16
    set receipt_fields to provider_json_tokens(archive_list_text(original_receipt and 3))
    set receipt_row to history_collect_one(archive_prepare(journal and "SELECT CAST(received_ms AS TEXT) FROM discord_inbox WHERE identity='message:create:100';"))
    if not (provider_value(receipt_fields and provider_member(receipt_fields and 0 and "received_unix_ms")) equals archive_list_text(receipt_row and 1)):
        return 17
    if discord_input_receipt_record(journal and database and "message:create:100" and "discord-message:100") is not equal to 0:
        return 18
    set denied to tool_fixture_call(database and admin_device and "discord-message:100" and "discord_events" and "{\"operation\":\"list\"}")
    if discord_pin_admin(database and "discord-message:100" and "jobs") is not equal to 1 or else tool_policy_allows(database and "discord-message:100" and "jobs" and "discord_events") is not equal to 1:
        return 12
    if group_privileged_audience_allows(database and "discord-message:100") is not equal to 0:
        return 13
    if discord_pin_admin(database and "discord-message:100" and "forged") is not equal to 0:
        return 14
    if discord_worker_schema(journal) is not equal to 0:
        return 25
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:100"):
        return 26
    set source to discord_run_source(journal and database and "discord-message:100")
    if not (archive_list_text(source and 0) equals "found") or else discord_delivery_schema(journal) is not equal to 0:
        return 20
    set started to ep_time_now_ms()
    set observed to discord_rate_observe(journal and "GET:scheduled-event" and "200" and "429" and "HTTP/2 429\r\n\r\n" and "{\"retry_after\":0.2,\"global\":false}" and started)
    set deadline to discord_rate_deadline(journal and "GET:scheduled-event" and "200")
    if not (observed equals "recorded") or else deadline <= started:
        return 21
    set ready to discord_event_read_wait(journal and database and "discord-message:100" and "jobs" and source and admin_ids and "/absent" and "GET:scheduled-event" and "200")
    if not (ready equals "ready") or else ep_time_now_ms() < deadline:
        display ready
        return 22
    set observed to discord_rate_observe(journal and "GET:scheduled-event" and "200" and "429" and "HTTP/2 429\r\n\r\n" and "{\"retry_after\":30,\"global\":false}" and ep_time_now_ms())
    set completed to channel
    set journal_path to concat(get_argument(3) and "")
    spawn event_wait_cancel_later(journal_path and completed)
    set stopped to discord_event_read_wait(journal and database and "discord-message:100" and "jobs" and source and admin_ids and "/absent" and "GET:scheduled-event" and "200")
    set result to receive from completed
    if not (stopped equals "event-source-or-permission-changed") or else not (ptr_to_str(result) equals "cancel-requested") or else ep_time_now_ms() >= discord_rate_deadline(journal and "GET:scheduled-event" and "200"):
        display stopped
        return 23
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:500';") is not equal to 0 or else discord_pin_admin(database and "discord-message:100" and "jobs") is not equal to 0:
        return 15
    set revoked to discord_event_read_wait(journal and database and "discord-message:100" and "jobs" and source and admin_ids and "/absent" and "GET:scheduled-event" and "200")
    if not (revoked equals "event-authority-revoked-or-stopped"):
        return 24
    display "PASS: recorded read deadline honored; concurrent cancellation interrupts wait before deadline; revoked authority denied; Discord-only catalog/runtime binding; ordinary-user event denial names requester; frozen admin call allows scoped checks but not private host audience; forged and revoked calls denied."
    return 0
