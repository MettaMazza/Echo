import "../../app/discord/audit_view"

define audit_view_test returning Int:
    set options to discord_audit_options("{\"limit\":1,\"before\":\"600\",\"user_id\":\"400\",\"action_type\":31}")
    set body to "{\"audit_log_entries\":[{\"id\":\"500\",\"target_id\":\"300\",\"user_id\":\"400\",\"action_type\":31,\"reason\":\"Approved role permissions\",\"changes\":[{\"key\":\"permissions\",\"old_value\":\"0\",\"new_value\":\"128\"}],\"options\":{\"count\":\"1\"}}],\"users\":[{\"id\":\"400\",\"email\":\"private-profile\"}],\"webhooks\":[{\"token\":\"private-webhook\"}]}"
    set page to discord_audit_page(body and options)
    if string_length(page) equals 0 or else string_contains(page and "private-profile") > 0 or else string_contains(page and "private-webhook") > 0 or else string_contains(page and "Approved role permissions") equals 0 or else string_contains(page and "permissions") equals 0:
        return 1
    set tokens to provider_json_tokens(page)
    if not (provider_value(tokens and provider_member(tokens and 0 and "oldest_id")) equals "500") or else not (provider_value(tokens and provider_member(tokens and 0 and "newest_id")) equals "500") or else not (provider_kind(tokens and provider_member(tokens and 0 and "more_may_exist")) equals "true"):
        return 2
    if string_length(discord_audit_page(body and discord_audit_options("{\"before\":\"500\"}"))) > 0:
        return 3
    if string_length(discord_audit_page(body and discord_audit_options("{\"after\":\"500\"}"))) > 0:
        return 3
    if string_length(discord_audit_page(body and discord_audit_options("{\"user_id\":\"401\"}"))) > 0:
        return 3
    if string_length(discord_audit_page(body and discord_audit_options("{\"action_type\":32}"))) > 0:
        return 3
    if string_length(discord_audit_page("{}" and discord_audit_options("{}"))) > 0:
        return 4
    if string_length(discord_audit_page("{\"audit_log_entries\":{}}" and discord_audit_options("{}"))) > 0:
        return 4
    if string_length(discord_audit_page("{\"audit_log_entries\":[{\"id\":\"500\",\"target_id\":\"300\",\"user_id\":\"400\",\"action_type\":31,\"reason\":\"Approved role permissions\",\"changes\":[{\"key\":\"permissions\",\"old_value\":\"0\",\"new_value\":\"128\"}],\"options\":{\"count\":\"1\"}},{\"id\":\"500\",\"target_id\":\"300\",\"user_id\":\"400\",\"action_type\":31,\"reason\":\"Approved role permissions\",\"changes\":[{\"key\":\"permissions\",\"old_value\":\"0\",\"new_value\":\"128\"}],\"options\":{\"count\":\"1\"}}]}" and discord_audit_options("{}"))) > 0:
        return 4
    if string_length(discord_audit_page("{\"audit_log_entries\":[{\"id\":\"bad\",\"action_type\":31}]}" and discord_audit_options("{}"))) > 0:
        return 4
    if string_length(discord_audit_page("{\"audit_log_entries\":[{\"id\":\"500\",\"action_type\":\"31\"}]}" and discord_audit_options("{}"))) > 0:
        return 4
    set empty to discord_audit_page("{\"audit_log_entries\":[]}" and discord_audit_options("{}"))
    if string_length(empty) equals 0:
        return 5
    set tokens to provider_json_tokens(empty)
    if not (provider_value(tokens and provider_member(tokens and 0 and "count")) equals "0") or else not (provider_kind(tokens and provider_member(tokens and 0 and "more_may_exist")) equals "false"):
        return 6
    display "PASS: audit pages preserve reasons and permission changes, exclude auxiliary profiles/webhook secrets, bind filters/cursors, reject malformed/duplicate entries and represent empty pages."
    return 0
