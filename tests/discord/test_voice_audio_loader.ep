import "select"
import "../../app/discord/voice_audio_loader"
import "../../app/discord/agent_bridge"

# Uses a synthetic valid 48 kHz stereo PCM fixture. Cache reuse is intentional;
# actual sandboxed conversion has separate native decoder qualification.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "discord:500" and "Voice fixture" and "fixture-secret") is not equal to 0:
        return 3
    set first to web_submit_owned(database and "discord:500" and "audio-run" and "" and "Voice fixture")
    set session to archive_list_text(first and 1)
    set cancelled to agent_cancel_run(database and "audio-run")
    set digest to file_digest(get_argument(2) and 65536)
    set derivative_path to concat(get_argument(3) and "/derivative.wav")
    if file_copy_verified(get_argument(2) and derivative_path and archive_list_text(digest and 1) and get_list(digest and 2) and 65536) is not equal to 0:
        return 14
    if web_attachment_register(database and "discord:500" and session and "speech" and get_argument(2) and "speech.wav" and "audio/wav") is not equal to 0 or else web_attachment_register_decoded_import(database and "discord:500" and session and "speech:voice-pcm-wav" and derivative_path and "speech PCM.wav" and "speech") is not equal to 0:
        return 4
    set binding to discord_voice_audio_source_prepare(database and "audio-run" and "500" and "speech" and get_argument(3))
    if not (archive_list_text(binding and 0) equals "voice-audio-ready"):
        display archive_list_text(binding and 0)
        return 5
    set config to create_list()
    set config to [get_argument(1),"audio-run","500",binding,get_argument(4)]
    set completed to channel
    spawn discord_voice_audio_load(config and completed)
    set waits to create_list()
    set added to append_list(waits and completed)
    if select(waits and 5000) < 0:
        return 15
    set loaded to receive from completed
    if not (archive_list_text(loaded and 0) equals "voice-audio-loaded") or else get_list(get_list(loaded and 1) and 4) is not equal to 0:
        display archive_list_text(loaded and 0)
        return 16
    set prepared_reader to get_list(loaded and 1)
    set prepared_codec to get_list(loaded and 2)
    if discord_voice_audio_loaded_close(loaded) is not equal to 1 or else get_list(prepared_reader and 5) is not equal to 1 or else get_list(prepared_codec and 0) is not equal to 0:
        return 17
    set reader to discord_voice_audio_source_open(database and "audio-run" and "500" and binding)
    if reader equals 0:
        return 6
    set frame to discord_voice_pcm_next(reader)
    if not (archive_list_text(frame and 0) equals "frame") or else get_list(get_list(frame and 1) and 1) is not equal to 3840:
        return 7
    set released to discord_voice_blob_release(get_list(frame and 1))
    set closed to discord_voice_pcm_close(reader)
    if discord_voice_audio_source_open(database and "audio-run" and "999" and binding) is not equal to 0:
        return 8
    set second to web_submit_owned(database and "discord:500" and "other-run" and "" and "Other conversation")
    set cancelled to agent_cancel_run(database and "other-run")
    if discord_voice_audio_source_open(database and "other-run" and "500" and binding) is not equal to 0:
        return 9
    set digest to archive_list_text(binding and 3)
    set changed to set_list(binding and 3 and ep_sha256("wrong"))
    if discord_voice_audio_source_open(database and "audio-run" and "500" and binding) is not equal to 0:
        return 10
    set changed to set_list(binding and 3 and digest)
    set original to archive_list_text(binding and 1)
    set changed to set_list(binding and 1 and "other-source")
    if discord_voice_audio_source_open(database and "audio-run" and "500" and binding) is not equal to 0:
        return 11
    set changed to set_list(binding and 1 and original)
    if archive_append(database and session and "exclude-audio" and "attachment_visibility" and "{\"attachment\":\"speech\",\"state\":\"excluded\"}" and "fixture") is not equal to 0:
        return 12
    if discord_voice_audio_source_open(database and "audio-run" and "500" and binding) is not equal to 0 or else archive_list_text(discord_voice_audio_source_current(database and "audio-run" and "500" and binding) and 0) equals "found":
        return 13
    display "PASS: asynchronous loader transfers unconsumed reader/codec and discards them cleanly; selected same-conversation audio resolves through exact PCM ancestry and verified inode; wrong actor/session/digest/parent and excluded original are denied."
    return 0
