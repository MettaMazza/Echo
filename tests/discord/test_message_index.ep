import "../../app/discord/message_index"
import "../../app/discord/message_read_options"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(journal and "create-a" and "MESSAGE_CREATE" and "{\"id\": \"100\", \"channel_id\": \"300\", \"content\": \"orchid original\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "create-b" and "MESSAGE_CREATE" and "{\"id\": \"101\", \"channel_id\": \"300\", \"content\": \"orchid next\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "foreign" and "MESSAGE_CREATE" and "{\"id\": \"102\", \"channel_id\": \"301\", \"content\": \"orchid private\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "edit-a" and "MESSAGE_UPDATE" and "{\"id\": \"100\", \"channel_id\": \"300\", \"content\": \"changed words\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "partial-b" and "MESSAGE_UPDATE" and "{\"id\": \"101\", \"channel_id\": \"300\", \"embeds\": []}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "deleted" and "MESSAGE_CREATE" and "{\"id\": \"103\", \"channel_id\": \"300\", \"content\": \"orchid deleted\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "delete" and "MESSAGE_DELETE" and "{\"id\": \"103\", \"channel_id\": \"300\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "bulk-create" and "MESSAGE_CREATE" and "{\"id\": \"104\", \"channel_id\": \"300\", \"content\": \"orchid bulk\"}") equals "recorded"):
        return 2
    if not (discord_inbox_record(journal and "bulk" and "MESSAGE_DELETE_BULK" and "{\"channel_id\": \"300\", \"ids\": [\"104\"]}") equals "recorded"):
        return 2
    if discord_message_index_refresh(journal) is not equal to 0 or else discord_message_index_refresh(journal) is not equal to 0:
        return 3
    set statement to discord_message_index_candidates(journal and "300" and "orchid" and "" and "2")
    set row to discord_message_index_row(statement)
    if not (archive_list_text(row and 1) equals "101"):
        return 4
    set row to discord_message_index_row(statement)
    if not (archive_list_text(row and 0) equals "end"):
        return 5
    set finalized to ep_sqlite3_finalize(statement)
    set statement to discord_message_index_candidates(journal and "300" and "changed" and "" and "1")
    set row to discord_message_index_row(statement)
    if not (archive_list_text(row and 1) equals "100"):
        return 6
    set cursor to archive_list_text(row and 2)
    set finalized to ep_sqlite3_finalize(statement)
    set statement to discord_message_index_candidates(journal and "300" and "changed" and cursor and "1")
    set row to discord_message_index_row(statement)
    if not (archive_list_text(row and 0) equals "end"):
        return 7
    set finalized to ep_sqlite3_finalize(statement)
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_message_index_refresh(journal) is not equal to 0:
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT count(*),sum(deleted) FROM discord_message_index;"))
    if not (archive_list_text(row and 1) equals "5") or else not (archive_list_text(row and 2) equals "2"):
        return 9
    if not (archive_list_text(discord_message_read_options("{\"operation\": \"search_local\", \"query\": \"orchid\", \"limit\": 2}") and 0) equals "valid"):
        return 10
    if not (archive_list_text(discord_message_read_options("{\"operation\": \"search_local\", \"query\": \"% _ SQL literal\", \"before\": \"4\"}") and 0) equals "valid"):
        return 10
    if archive_list_text(discord_message_read_options("{\"operation\": \"search_local\", \"query\": \"\"}") and 0) equals "valid":
        return 11
    if archive_list_text(discord_message_read_options("{\"operation\": \"search_local\", \"query\": \"x\", \"after\": \"1\"}") and 0) equals "valid":
        return 11
    if archive_list_text(discord_message_read_options("{\"operation\": \"search_local\", \"query\": \"x\", \"channel\": \"301\"}") and 0) equals "valid":
        return 11
    if archive_list_text(discord_message_read_options("{\"operation\": \"read\", \"message\": \"100\", \"query\": \"x\"}") and 0) equals "valid":
        return 11
    if discord_message_index_observe(journal and "[{\"id\":\"105\",\"channel_id\":\"300\",\"content\":\"REST orchid\"}]" and "synthetic-retained-receipt") is not equal to 0 or else discord_message_index_refresh(journal) is not equal to 0:
        return 12
    set statement to discord_message_index_candidates(journal and "300" and "REST orchid" and "" and "1")
    set row to discord_message_index_row(statement)
    if not (archive_list_text(row and 1) equals "105"):
        return 13
    set finalized to ep_sqlite3_finalize(statement)
    if not (discord_inbox_record(journal and "stale-replay" and "REST_MESSAGE_OBSERVATION" and "{\"id\":\"103\",\"channel_id\":\"300\",\"content\":\"orchid stale\"}") equals "recorded") or else discord_message_index_refresh(journal) is not equal to 0:
        return 14
    set row to history_collect_one(archive_prepare(journal and "SELECT deleted,content FROM discord_message_index WHERE message='103';"))
    if not (archive_list_text(row and 1) equals "1") or else string_length(archive_list_text(row and 2)) is not equal to 0:
        return 15
    set statement to discord_message_index_candidates(journal and "300" and "' OR 1=1 --" and "" and "100")
    set row to discord_message_index_row(statement)
    if not (archive_list_text(row and 0) equals "end"):
        return 16
    set finalized to ep_sqlite3_finalize(statement)
    set candidates to discord_message_index_snapshot(journal and "300" and "orchid" and "" and "100")
    if candidates equals 0:
        return 17
    set writer to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(writer and "concurrent" and "MESSAGE_UPDATE" and "{\"id\":\"105\",\"channel_id\":\"300\",\"content\":\"newer\"}") equals "recorded"):
        return 18
    set closed to sql_close(writer)
    if sql_execute(journal and "BEGIN IMMEDIATE; CREATE TABLE search_receipt_test(value TEXT); INSERT INTO search_receipt_test VALUES('recorded after concurrent writer'); COMMIT;") is not equal to 0:
        return 19
    display "PASS: scoped incremental index, edited and partial content, single/bulk tombstones, cursor pagination, replay and reopen; strict search options"
    return 0
