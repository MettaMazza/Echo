import "../../app/discord/member_tool"

define main returning Int:
    set bundle to create_list()
    set added to append_list(bundle and "observed")
    set added to append_list(bundle and "{\"id\":\"200\",\"owner_id\":\"999\"}")
    set added to append_list(bundle and "[{\"id\":\"200\",\"position\":0,\"permissions\":\"1024\",\"managed\":false},{\"id\":\"201\",\"position\":5,\"permissions\":\"1099712955398\",\"managed\":true},{\"id\":\"202\",\"position\":1,\"permissions\":\"0\",\"managed\":false}]")
    set added to append_list(bundle and "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\"]}")
    set added to append_list(bundle and "{\"user\":{\"id\":\"900\"},\"roles\":[\"201\"]}")
    set member to "{\"user\":{\"id\":\"600\",\"username\":\"fixture\",\"email\":\"never-project\"},\"roles\":[\"202\"],\"nick\":\"Café\",\"joined_at\":\"2026-01-01T00:00:00Z\",\"communication_disabled_until\":null,\"private_marker\":\"never-project\"}"
    set added to append_list(bundle and member)
    set added to append_list(bundle and "null")
    if discord_member_bundle_valid(bundle and "200" and "500" and "900" and "600" and 0) is not equal to 1:
        return 1
    set operations to create_list()
    set added to append_list(operations and "inspect")
    set added to append_list(operations and "inspect_ban")
    set added to append_list(operations and "kick")
    set added to append_list(operations and "ban")
    set added to append_list(operations and "unban")
    set added to append_list(operations and "timeout")
    set added to append_list(operations and "remove_timeout")
    set added to append_list(operations and "nickname")
    for each operation in operations:
        if discord_member_operation_allowed(bundle and "200" and "500" and "900" and "600" and ptr_to_str(operation)) is not equal to 1:
            display ptr_to_str(operation)
            return 2
    if discord_member_bundle_valid(bundle and "201" and "500" and "900" and "600" and 0) is not equal to 0 or else discord_member_bundle_valid(bundle and "200" and "500" and "900" and "601" and 0) is not equal to 0:
        return 3
    set view to discord_member_projection(member)
    if string_contains(view and "never-project") is not equal to 0 or else string_contains(view and "Café") equals 0:
        return 4
    set snapshot to discord_member_snapshot("200" and "600" and archive_list_text(bundle and 2) and member and "null" and 0)
    set other to discord_member_snapshot("201" and "600" and archive_list_text(bundle and 2) and member and "null" and 0)
    set ban_snapshot to discord_member_snapshot("200" and "600" and archive_list_text(bundle and 2) and member and "null" and 1)
    if ep_sha256(snapshot) equals ep_sha256(ban_snapshot):
        return 12
    if ep_sha256(snapshot) equals ep_sha256(other):
        return 5
    set admin_roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"1024\",\"managed\":false},{\"id\":\"201\",\"position\":5,\"permissions\":\"1099712955398\",\"managed\":true},{\"id\":\"202\",\"position\":1,\"permissions\":\"8\",\"managed\":false}]"
    set protected to member_test_replace(bundle and 2 and admin_roles)
    if discord_member_operation_allowed(protected and "200" and "500" and "900" and "600" and "timeout") is not equal to 0:
        return 6
    set missing to member_test_replace(bundle and 5 and "null")
    if discord_member_bundle_valid(missing and "200" and "500" and "900" and "600" and 0) is not equal to 0 or else discord_member_bundle_valid(missing and "200" and "500" and "900" and "600" and 1) is not equal to 1:
        return 7
    if discord_member_operation_allowed(missing and "200" and "500" and "900" and "600" and "ban") is not equal to 1 or else discord_member_operation_allowed(missing and "200" and "500" and "900" and "600" and "kick") is not equal to 0:
        return 8
    set wrong_ban to member_test_replace(bundle and 6 and "{\"user\":{\"id\":\"601\"}}")
    if discord_member_bundle_valid(wrong_ban and "200" and "500" and "900" and "600" and 1) is not equal to 0:
        return 9
    set equal_member to member_test_replace(bundle and 5 and "{\"user\":{\"id\":\"600\"},\"roles\":[\"201\"]}")
    if discord_member_operation_allowed(equal_member and "200" and "500" and "900" and "600" and "kick") is not equal to 0:
        return 10
    set revoked to member_test_replace(bundle and 3 and "{\"user\":{\"id\":\"500\"},\"roles\":[]}")
    if discord_member_operation_allowed(revoked and "200" and "500" and "900" and "600" and "ban") is not equal to 0:
        return 11
    set audit_roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\",\"managed\":false},{\"id\":\"201\",\"position\":5,\"permissions\":\"128\",\"managed\":true},{\"id\":\"202\",\"position\":1,\"permissions\":\"0\",\"managed\":false}]"
    set audit_only to member_test_replace(bundle and 2 and audit_roles)
    if discord_member_operation_allowed(audit_only and "200" and "500" and "900" and "600" and "inspect") is not equal to 1 or else discord_member_operation_allowed(audit_only and "200" and "500" and "900" and "600" and "inspect_ban") is not equal to 1:
        return 13
    if discord_member_operation_allowed(audit_only and "200" and "500" and "900" and "600" and "ban") is not equal to 0:
        return 14
    set no_owner to member_test_replace(bundle and 1 and "{\"id\":\"200\"}")
    if discord_member_bundle_valid(no_owner and "200" and "500" and "900" and "600" and 1) is not equal to 0:
        return 15
    if get_argument_count() is not equal to 2 or else member_test_absence(get_argument(1)) is not equal to 0:
        return 16
    display "PASS: actual member operation permissions, exact snapshot identity, guild-bound hashes and minimal public projection."
    return 0

# Fresh typed list, retaining all entries during allocations.
define member_test_replace with original as List and position as Int and value as Str returning List:
    set result to create_list()
    set index to 0
    repeat while index < length_list(original):
        set text to archive_list_text(original and index)
        if index equals position:
            set text to value
        set added to append_list(result and text)
        set index to index + 1
    return result

define member_test_absence with directory_path as Str returning Int:
    set filename to concat(directory_path and "/absence.json")
    if file_exists(filename) or else write_file(filename and "{\"code\":10026,\"message\":\"Unknown Ban\"}") is not equal to 1:
        return 1
    set observation to create_list()
    set added to append_list(observation and "http-404")
    set added to append_list(observation and "absence.json")
    set absence to discord_member_optional_observation(observation and directory_path and "10026")
    if not (archive_list_text(absence and 0) equals "observed") or else not (archive_list_text(absence and 1) equals "null"):
        return 2
    set wrong_code to discord_member_optional_observation(observation and directory_path and "10007")
    if not (archive_list_text(wrong_code and 0) equals "http-404"):
        return 3
    if write_file(filename and "{\"code\":10026,\"code\":10007}") is not equal to 1:
        return 4
    set duplicate to discord_member_optional_observation(observation and directory_path and "10026")
    if not (archive_list_text(duplicate and 0) equals "http-404"):
        return 5
    set denied to member_test_replace(observation and 0 and "http-403")
    if not (archive_list_text(discord_member_optional_observation(denied and directory_path and "10026") and 0) equals "http-403"):
        return 6
    return 0
