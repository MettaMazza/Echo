import "../../app/discord/queue_control_store"

# Fresh journals exercise ordering and recovery without network or inference.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_queue_control_schema(journal) is not equal to 0:
        return 2
    for each message in ["100","101","102"]:
        set actor to "500"
        if ptr_to_str(message) equals "102":
            set actor to "501"
        set body to concat("{\"id\":" and concat(provider_quote(ptr_to_str(message)) and concat(",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":" and concat(provider_quote(actor) and "}}"))))
        if not (discord_inbox_record(journal and concat("message:create:" and ptr_to_str(message)) and "MESSAGE_CREATE" and body) equals "recorded"):
            return 3
    set first to discord_worker_claim(journal)
    if not (archive_list_text(first and 1) equals "message:create:100") or else not (discord_worker_finish(journal and "message:create:100" and "access:rate-limited") equals "recorded"):
        return 4
    set now to ep_time_now_ms()
    if discord_queue_position(journal and "message:create:100") is not equal to 1 or else discord_queue_position(journal and "message:create:101") is not equal to 2:
        return 5
    set other to discord_worker_claim_at(journal and now)
    if not (archive_list_text(other and 1) equals "message:create:102") or else not (discord_worker_finish(journal and "message:create:102" and "enqueued") equals "recorded"):
        return 6
    if not (archive_list_text(discord_worker_claim_at(journal and now + 900) and 0) equals "end"):
        return 7
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set retried to discord_worker_claim_at(journal and now + 1001)
    if not (archive_list_text(retried and 1) equals "message:create:100"):
        return 8
    set receipts to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_agent_job_events WHERE inbox='message:create:100';"))
    if not (archive_list_text(receipts and 1) equals "3"):
        return 9
    if not (discord_worker_finish(journal and "message:create:100" and "access:view-permission-denied") equals "recorded"):
        return 10
    set next to discord_worker_claim_at(journal and now + 60000)
    if not (archive_list_text(next and 1) equals "message:create:101") or else not (discord_worker_finish(journal and "message:create:101" and "access:http-429") equals "recorded"):
        return 11
    set next to discord_worker_claim_at(journal and ep_time_now_ms() + 1001)
    if not (archive_list_text(next and 1) equals "message:create:101") or else not (discord_worker_finish(journal and "message:create:101" and "model-failed") equals "recorded"):
        return 12
    if not (archive_list_text(discord_worker_claim_at(journal and now + 90000) and 0) equals "end"):
        return 13
    display "PASS: throttle restart, queue order, retained receipts, backoff and independent users; no retry for permission denial or model failure."
    set closed to sql_close(journal)
    return 0
