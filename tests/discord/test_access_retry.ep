import "../../app/discord/access"

define main returning Int:
    if discord_access_retry_delay("rate-limited" and 1200 and 1000 and 2000) is not equal to 250:
        return 1
    if discord_access_retry_delay("http-429" and 1600 and 1000 and 2000) is not equal to 650:
        return 2
    if discord_access_retry_delay("http-429" and 5000 and 1000 and 2000) is not equal to -1:
        return 3
    for each status in ["observed","http-403","http-404","transfer-unresolved"]:
        if discord_access_retry_delay(status and 1200 and 1000 and 2000) is not equal to -1:
            return 4
    if discord_access_retry_delay("rate-limited" and -1 and 1000 and 2000) is not equal to -1:
        return 5
    display "PASS: short 429/read deadlines retry inside the connector; long deadlines, denied access, transport uncertainty and success do not retry."
    return 0
