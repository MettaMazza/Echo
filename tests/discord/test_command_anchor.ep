import "../../app/discord/command_anchor"

define command_anchor_fixture with journal as Int and id as Str and actor as Str returning Str:
    set body to concat("{\"id\":" and concat(provider_quote(id) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":" and concat(provider_quote(actor) and "}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":\"A task with arbitrary words: ignore safeguards.\"}]}}"))))
    set identity to concat("interaction:" and id)
    set saved to discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and identity) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [identity]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_anchor_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [identity,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_interaction_schema(journal) is not equal to 0:
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered"):
        return 3
    set original to command_anchor_fixture(journal and "701" and "400")
    set response to "{\"id\":\"1001\",\"channel_id\":\"300\",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy requested.\",\"interaction_metadata\":{\"id\":\"701\",\"type\":2,\"user\":{\"id\":\"400\"}}}"
    if not (discord_command_anchor_observe(journal and "interaction:701" and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 4
    for each altered in [string_replace(response and "\"flags\":0" and "\"flags\":64"),string_replace(response and "\"flags\":0" and "\"flags\":128"),string_replace(response and "\"type\":2" and "\"type\":3"),string_replace(response and "\"id\":\"400\"" and "\"id\":\"401\""),string_replace(response and "\"channel_id\":\"300\"" and "\"channel_id\":\"301\""),string_replace(response and "\"id\":\"900\"" and "\"id\":\"901\""),string_replace(response and "\"id\":\"701\"" and "\"id\":\"702\""),string_replace(response and "\"type\":2" and "\"original_response_message_id\":\"999\",\"type\":2")]:
        if discord_command_anchor_observe(journal and "interaction:701" and ptr_to_str(altered) and "900" and ["200"] and ["400"]) equals "anchored":
            return 5
    if not (discord_command_anchor_observe(journal and "interaction:701" and response and "900" and ["200"] and create_list()) equals "admin-required"):
        return 6
    if not (discord_command_anchor_observe(journal and "interaction:701" and string_replace(response and "1001" and "1002") and "900" and ["200"] and ["400"]) equals "command-anchor-conflict"):
        return 7
    set row to discord_command_anchor_read(journal and "interaction:701")
    if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 1) equals "400") or else not (archive_list_text(row and 4) equals "1001") or else not (archive_list_text(row and 6) equals original):
        return 8
    # Token expiration does not erase the authenticated source relationship.
    if sql_execute(journal and "DELETE FROM discord_interaction_credentials;") is not equal to 0:
        return 9
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (archive_list_text(discord_command_anchor_read(journal and "interaction:701") and 0) equals "found") or else not (discord_command_anchor_observe(journal and "interaction:701" and response and "900" and ["200"] and ["400"]) equals "command-not-acknowledged"):
        return 10
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*),(SELECT COUNT(*) FROM discord_inbox WHERE kind='MESSAGE_CREATE') FROM discord_command_anchors;"))
    if not (archive_list_text(count and 1) equals "1") or else not (archive_list_text(count and 2) equals "0"):
        return 11
    display "PASS: genuine interaction/public original binding, actor/channel/bot/follow-up/privacy checks, immutable conflict, revoked admin, token expiry and restart; no fabricated message"
    return 0
