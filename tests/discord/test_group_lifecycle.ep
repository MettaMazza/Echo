import "../../app/discord/joined_groups"
import "../../app/security/group_gate"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else discord_joined_schema(database) is not equal to 0:
        return 2
    set devices to create_list()
    set added to append_list(devices and "a")
    set added to append_list(devices and "b")
    for each device in devices:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set made to discord_joined_create(database and "a" and "100" and "200" and "create")
    set group_id to archive_list_text(made and 1)
    if not (archive_list_text(made and 0) equals "created"):
        return 4
    set first to group_route_submit(database and "a" and group_id and "discord" and "100" and "200" and "one" and "PRESERVE_THIS_HISTORY")
    set old_session to archive_list_text(first and 1)
    if not (archive_list_text(first and 0) equals "accepted") or else group_run_session_allows(database and "one" and old_session) equals 0:
        return 5
    if not (discord_group_lifecycle_change(database and "b" and group_id and "foreign-close" and "archived" and 0 and 1) equals "lifecycle-not-authorized"):
        return 6
    if not (discord_group_lifecycle_change(database and "a" and group_id and "close" and "archived" and 0 and 1) equals "recorded"):
        return 7
    if group_active(database and group_id) is not equal to 0 or else group_run_session_allows(database and "one" and old_session) is not equal to 0 or else group_session_allows(database and "a" and old_session and "discord" and "100" and "200" and 0) equals 0:
        return 8
    if not (archive_list_text(group_route(database and "a" and group_id and "discord" and "100" and "200") and 0) equals "audience-not-authorized") or else not (discord_joined_select(database and "a" and "100" and "200" and "select-closed" and group_id) equals "group-inactive"):
        return 9
    if not (discord_joined_change(database and "a" and "100" and "200" and "invite-closed" and group_id and "device:b" and "invited" and 2) equals "group-inactive"):
        return 10
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if group_active(database and group_id) is not equal to 0 or else not (discord_group_lifecycle_change(database and "a" and group_id and "close" and "archived" and 0 and 1) equals "already-recorded"):
        return 11
    if not (discord_group_lifecycle_change(database and "a" and group_id and "bad-reopen" and "active" and 0 and 1) equals "membership-revision-conflict") or else not (discord_group_lifecycle_change(database and "a" and group_id and "reopen" and "active" and 0 and 2) equals "recorded"):
        return 12
    if group_active(database and group_id) equals 0 or else group_run_session_allows(database and "one" and old_session) is not equal to 0:
        return 13
    if not (discord_group_lifecycle_change(database and "a" and group_id and "close" and "archived" and 0 and 1) equals "already-recorded") or else group_active(database and group_id) equals 0:
        return 14
    set next to group_route_submit(database and "a" and group_id and "discord" and "100" and "200" and "two" and "NEW_SEGMENT")
    if not (archive_list_text(next and 0) equals "accepted") or else archive_list_text(next and 1) equals old_session:
        return 15
    set deadline to ep_time_now_ms() + 1200
    if not (discord_group_lifecycle_change(database and "a" and group_id and "expiry" and "active" and deadline and 3) equals "recorded"):
        return 16
    set last to group_route_submit(database and "a" and group_id and "discord" and "100" and "200" and "three" and "DEADLINE_TEST")
    set last_session to archive_list_text(last and 1)
    if not (archive_list_text(last and 0) equals "accepted") or else group_run_session_allows(database and "three" and last_session) equals 0:
        return 17
    set slept to sleep_ms(2300)
    if group_active(database and group_id) is not equal to 0 or else group_run_session_allows(database and "three" and last_session) is not equal to 0:
        return 18
    if group_session_allows(database and "a" and last_session and "discord" and "100" and "200" and 0) equals 0 or else not (discord_group_lifecycle_change(database and "a" and group_id and "expiry" and "active" and deadline and 3) equals "already-recorded"):
        return 19
    set history to history_next(database and old_session and 0 and 9223372036854775807 and "PRESERVE_THIS_HISTORY")
    if not (archive_list_text(history and 0) equals "found"):
        display history
        return 20
    if not (discord_group_lifecycle_change(database and "a" and group_id and "past" and "active" and 1 and 4) equals "expiry-must-be-future"):
        return 21
    display "PASS: creator authorization, archive and deadline dispatch barriers, historical retention, stale revision rejection, restart/exact replay and no resurrection of pre-close runs after reopening."
    return sql_close(database)
