import "../../app/discord/group_command"
import "../../app/discord/command_registration"

define group_command_fixture with journal as Int and identity as Str and arguments as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT json_group_array(json_object('type',3,'name',key,'value',value)) FROM json_each(?1);" and [arguments]))
    set options to archive_list_text(row and 1)
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT json_object('id',?1,'type',2,'application_id','900','guild_id','200','channel_id','300','member',json('{\"user\":{\"id\":\"400\"}}'),'data',json_object('type',1,'id','805','name','group','options',json(?2)));" and [identity,options]))
    set body to archive_list_text(source and 1)
    set inbox to concat("interaction:" and identity)
    if not (discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledged',CAST(?2 AS INTEGER),'fixture');" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_attachment_credential_1234','fixture',CAST(?2 AS INTEGER),CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0:
        return 2
    set definition to discord_control_command_definition("group")
    if discord_control_command_matches(definition and "group") is not equal to 1:
        return 3
    if not (discord_command_observe(journal and "{\"id\":\"805\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"group\"}" and "900" and "200") equals "registered"):
        return 4
    set body to group_command_fixture(journal and "701" and "{\"action\":\"create\"}")
    set guilds to ["200"]
    set admins to create_list()
    set result to discord_group_command_apply(journal and database and "interaction:701" and body and "900" and guilds and admins)
    if string_index_of(result and "group-control:Shared conversation created and selected:") is not equal to 0:
        display result
        return 5
    set replay to discord_group_command_apply(journal and database and "interaction:701" and body and "900" and guilds and admins)
    if not (replay equals result):
        return 6
    set spoof to string_replace(body and "400" and "401")
    if not (discord_group_command_apply(journal and database and "interaction:701" and spoof and "900" and guilds and admins) equals "command-not-acknowledged"):
        return 7
    set listing to group_command_fixture(journal and "702" and "{\"action\":\"list\"}")
    set result to discord_group_command_apply(journal and database and "interaction:702" and listing and "900" and guilds and admins)
    if string_contains(result and "discord-joined:") equals 0 or else string_contains(result and "revision 1") equals 0:
        return 8
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_group_command_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals replay):
        return 9
    display "PASS: group registration and authenticated create/list controls; exact replay, forged-body rejection and restart persistence."
    return 0
