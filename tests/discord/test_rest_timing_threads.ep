import "../../app/discord/rest"
import "select"

define timing_fixture_worker with library as Int and completed as Int returning Int:
    set index to 0
    repeat while index < 1000:
        set timing to discord_rest_timing(library and 1 and 17)
        if not (timing equals "{\"setup_ms\":17,\"total_us\":0,\"dns_us\":0,\"connect_us\":0,\"first_byte_us\":0,\"tls_us\":0}"):
            send 1 to completed
            return 1
        set parsed to provider_json_tokens(timing)
        if parsed equals 0:
            send 2 to completed
            return 2
        set index to index + 1
    send 0 to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen(get_argument(1))
    if library equals 0:
        return 2
    set first to channel
    set second to channel
    spawn timing_fixture_worker(library and first)
    spawn timing_fixture_worker(library and second)
    set waits to create_list()
    set added to append_list(waits and first)
    set added to append_list(waits and second)
    set remaining to 2
    repeat while remaining > 0:
        set ready to select(waits and 20)
        if ready >= 0:
            set result to receive from get_list(waits and ready)
            if result is not equal to 0:
                return 3
            set remaining to remaining - 1
    display "PASS: concurrent REST timing generation retains exact valid metadata across collection safepoints."
    return 0
