import "../../app/discord/role_tool"

define main returning Int:
    set options to discord_role_options("{\"operation\":\"create\",\"name\":\"fixture\",\"reason\":\"test\"}")
    if not (archive_list_text(options and 0) equals "valid"):
        return 1
    set options to discord_role_options("{\"operation\":\"create\",\"name\":\"fixture\",\"permissions\":\"8\",\"reason\":\"test\"}")
    if not (archive_list_text(options and 0) equals "valid"):
        return 2
    set options to discord_role_options("{\"operation\":\"edit\",\"role\":\"201\",\"name\":\"changed\",\"reason\":\"test\"}")
    if not (archive_list_text(options and 0) equals "observed-sha256-required"):
        return 3
    set options to discord_role_options("{\"operation\":\"reorder\",\"role\":\"201\",\"position\":0,\"reason\":\"test\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    if not (archive_list_text(options and 0) equals "invalid-position"):
        return 4
    set options to discord_role_options("{\"operation\":\"assign\",\"role\":\"201\",\"member\":\"500\",\"reason\":\"test\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    if not (archive_list_text(options and 0) equals "valid"):
        return 5
    set options to discord_role_options("{\"operation\":\"assign\",\"role\":\"201\",\"member\":\"500\",\"permissions\":\"8\",\"reason\":\"test\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    if not (archive_list_text(options and 0) equals "unused-role-change"):
        return 6
    set options to discord_role_options("{\"operation\":\"list\",\"member\":\"500\"}")
    if not (archive_list_text(options and 0) equals "unused-member"):
        return 7
    set options to discord_role_options("{\"operation\":\"create\",\"name\":\"fixture\",\"permissions\":\"9007199254740992\",\"reason\":\"test\"}")
    if not (archive_list_text(options and 0) equals "invalid-permissions"):
        return 8
    set options to discord_role_options("{\"operation\":\"create\",\"name\":\"fixture\",\"color\":16777216,\"reason\":\"test\"}")
    if not (archive_list_text(options and 0) equals "invalid-color"):
        return 9
    set options to discord_role_options("{\"operation\":\"edit\",\"role\":\"201\",\"reason\":\"test\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}")
    if not (archive_list_text(options and 0) equals "change-required"):
        return 10
    set options to discord_role_options("{\"operation\":\"create\",\"name\":\"fixture\",\"color\":255,\"reason\":\"test\"}")
    if string_contains(archive_list_text(options and 6) and "\"permissions\":\"0\"") equals 0 or else string_contains(archive_list_text(options and 6) and "\"colors\":{\"primary_color\":255}") equals 0:
        return 11
    display "PASS: role operation options, exact masks, hash requirement, bounds and zero-permission create default"
    return 0
