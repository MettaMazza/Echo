import "../../app/discord/turn_guard"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0:
        return 2
    set recorded to discord_inbox_record(journal and "audience:unrelated" and "CHANNEL_UPDATE" and "{\"guild_id\":\"200\",\"channel_id\":\"999\"}")
    if discord_turn_barrier(journal and 0 and "100" and "300" and "200") is not equal to 1:
        return 3
    if discord_channel_scope_record(journal and "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"parent_id\":\"400\"}") is not equal to 0:
        return 4
    if discord_turn_barrier(journal and 0 and "100" and "300" and "200") is not equal to 0:
        return 5
    set recorded to discord_inbox_record(journal and "audience:parent" and "CHANNEL_UPDATE" and "{\"guild_id\":\"200\",\"channel_id\":\"400\"}")
    if discord_turn_barrier(journal and 0 and "100" and "300" and "200") is not equal to 1:
        return 6
    if discord_channel_scope_record(journal and "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":11,\"parent_id\":\"500\"}") is not equal to 0:
        return 7
    set recorded to discord_inbox_record(journal and "audience:threadparent" and "CHANNEL_DELETE" and "{\"guild_id\":\"200\",\"channel_id\":\"500\"}")
    if discord_turn_barrier(journal and 2 and "100" and "300" and "200") is not equal to 1:
        return 8
    set recorded to discord_inbox_record(journal and "audience:own" and "CHANNEL_UPDATE" and "{\"guild_id\":\"200\",\"channel_id\":\"300\"}")
    if discord_turn_barrier(journal and 3 and "100" and "300" and "200") is not equal to 1:
        return 9
    set recorded to discord_inbox_record(journal and "audience:legacy" and "CHANNEL_UPDATE" and "{\"guild_id\":\"200\"}")
    if discord_turn_barrier(journal and 4 and "100" and "300" and "200") is not equal to 1:
        return 10
    set recorded to discord_inbox_record(journal and "audience:roles" and "GUILD_ROLE_UPDATE" and "{\"guild_id\":\"200\"}")
    if discord_turn_barrier(journal and 5 and "100" and "300" and "200") is not equal to 1 or else discord_turn_barrier(journal and 5 and "100" and "300" and "201") is not equal to 0:
        return 11
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_turn_barrier(journal and 2 and "100" and "300" and "200") is not equal to 1:
        return 12
    if discord_channel_scope_record(journal and "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":11}") equals 0:
        return 13
    if sql_execute(journal and "DELETE FROM discord_channel_scopes;") equals 0:
        return 14
    display "PASS: unknown/legacy scope fail closed; unrelated channel excluded; own channel/parent/thread parent and guild roles still cancel; scope history survives restart and cannot be erased."
    return 0
