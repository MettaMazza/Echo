import "../../app/discord/post_options"
import "../../app/tools/discord_post_schema"

define rich_case with arguments as Str and expected as Int returning Int:
    set result to discord_post_options(arguments)
    set valid to 0
    if archive_list_text(result and 0) equals "valid":
        set valid to 1
    return valid equals expected

define main returning Int:
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"Field report\",\"description\":\"One two\",\"fields\":[{\"name\":\"A\",\"value\":\"B\",\"inline\":true}],\"footer\":{\"text\":\"Source\"},\"color\":16777215}]}" and 1) equals 0:
        return 1
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"Choose\",\"answers\":[\"Oak\",\"Ash\"],\"duration_hours\":1,\"multiselect\":true}}" and 1) equals 0:
        return 2
    if rich_case("{\"operation\":\"reply\",\"embeds\":[]}" and 0) equals 0:
        return 3
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{}]}" and 0) equals 0:
        return 4
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"color\":1}]}" and 0) equals 0:
        return 5
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"url\":\"https://example.com\"}]}" and 0) equals 0:
        return 6
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"fields\":[{\"name\":\"a\",\"value\":\"b\",\"inline\":\"true\"}]}]}" and 0) equals 0:
        return 7
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"color\":-1}]}" and 0) equals 0:
        return 8
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"color\":16777216}]}" and 0) equals 0:
        return 9
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"color\":1.5}]}" and 0) equals 0:
        return 10
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"footer\":{\"text\":\"ok\",\"icon_url\":\"secret\"}}]}" and 0) equals 0:
        return 11
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"},{\"title\":\"x\"}]}" and 0) equals 0:
        return 12
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"description\":\"\"},{\"description\":\"\"}]}" and 0) equals 0:
        return 13
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\\ud83c\\udf3f\"}]}" and 0) equals 0:
        return 14
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"one\"]}}" and 0) equals 0:
        return 15
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"one\",\"one\",\"one\",\"one\",\"one\",\"one\",\"one\",\"one\",\"one\",\"one\",\"one\"]}}" and 0) equals 0:
        return 16
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"b\"]}}" and 0) equals 0:
        return 17
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"a\",\"b\"],\"duration_hours\":769}}" and 0) equals 0:
        return 18
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"a\",\"b\"],\"duration_hours\":0}}" and 0) equals 0:
        return 19
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"a\",\"b\"],\"multiselect\":\"false\"}}" and 0) equals 0:
        return 20
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"x\",\"answers\":[\"a\",\"b\"],\"results\":{}}}" and 0) equals 0:
        return 21
    if rich_case("{\"operation\":\"reply\",\"poll\":{\"question\":\"\",\"answers\":[\"a\",\"b\"]}}" and 0) equals 0:
        return 22
    if rich_case("{\"operation\":\"edit\",\"post\":\"x\",\"text\":\"x\",\"embeds\":[{\"title\":\"x\"}]}" and 0) equals 0:
        return 23
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"description\":\"\"},{\"description\":\"\"}]}" and 1) equals 0:
        return 24
    if rich_case("{\"operation\":\"reply\",\"embeds\":[{\"title\":\"x\",\"title|description\":\"unknown\"}]}" and 0) equals 0:
        return 29
    set count to 0
    repeat while count < 500:
        set options to discord_post_options("{\"operation\":\"reply\",\"poll\":{\"question\":\"Trees?\",\"answers\":[\"Oak\",\"Ash\"]}}")
        set body to discord_rich_post_body("@everyone" and "123" and "" and archive_list_text(options and 5))
        set parsed to provider_json_tokens(body)
        set poll to provider_member(parsed and 0 and "poll")
        if not (provider_value(parsed and provider_member(parsed and poll and "duration")) equals "24") or else not (provider_value(parsed and provider_member(parsed and poll and "allow_multiselect")) equals "false"):
            return 30
        set mentions to provider_member(parsed and 0 and "allowed_mentions")
        if length_list(provider_items(parsed and provider_member(parsed and mentions and "parse"))) is not equal to 0 or else not (provider_value(parsed and provider_member(parsed and mentions and "replied_user")) equals "false"):
            return 31
        set count to count + 1
    set schema to provider_json_tokens(discord_post_schema_text())
    if schema equals 0 or else provider_unique_objects(schema) equals 0:
        return 32
    display "PASS: rich payload limits, strict keys/types, UTF-16 boundaries, native poll shape, mentions disabled and 500 retained allocations."
    return 0
