import "../../app/memory/scoped_archive_recall"

define main returning Int:
    if get_argument_count() is not equal to 15 or else not (get_argument(13) equals "--turn"):
        return 1
    set database to archive_open(get_argument(4))
    set run to get_argument(14)
    set event to ptr_to_str(get_env("ECHO_VERIFY_SOURCE_EVENT"))
    set result to memory_scoped_read(database and run and event and 0 and 8000)
    display archive_list_text(result and 0)
    if not (archive_list_text(result and 0) equals "found"):
        return 2
    display archive_list_text(result and 1)
    display archive_list_text(result and 5)
    if string_contains(archive_list_text(result and 7) and "consent") equals 0:
        return 3
    display "PASS: original consent retrieved across live Discord channels under source and destination access checks."
    return sql_close(database)
