import "../../app/discord/group_command"
import "../../app/discord/command_registration"
import "../../app/context/public_group_seed"

define group_command_fixture with journal as Int and identity as Str and arguments as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT json_group_array(json_object('type',3,'name',key,'value',value)) FROM json_each(?1);" and [arguments]))
    set options to archive_list_text(row and 1)
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT json_object('id',?1,'type',2,'application_id','900','guild_id','200','channel_id','300','member',json('{\"user\":{\"id\":\"400\"}}'),'data',json_object('type',1,'id','805','name','group','options',json(?2)));" and [identity,options]))
    set body to archive_list_text(source and 1)
    set inbox to concat("interaction:" and identity)
    if not (discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledged',CAST(?2 AS INTEGER),'fixture');" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_attachment_credential_1234','fixture',CAST(?2 AS INTEGER),CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0:
        return 2
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"},{\"id\":\"500\"},{\"id\":\"500\"},{\"id\":\"600\",\"bot\":true}],\"content\":\"Public seed amber-lantern; not private history.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set admitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(admitted and 0) equals "accepted"):
        display archive_list_text(admitted and 0)
        return 4
    if agent_cancel_run(database and "discord-message:100") is not equal to 0:
        return 5
    set offered to discord_group_offer_read(journal and "100" and "400" and "200" and "300")
    if not (archive_list_text(offered and 0) equals "found") or else not (archive_list_text(offered and 2) equals "[\"500\"]"):
        return 6
    if not (discord_group_offer_record(journal and database and "message:create:100" and "900") equals "already-enqueued"):
        return 7
    set denied to discord_group_offer_read(journal and "100" and "500" and "200" and "300")
    if not (archive_list_text(denied and 0) equals "offer-source-denied"):
        return 8
    set device to concat("discord:" and "400")
    set before to discord_joined_selected(database and device and "200" and "300")
    if archive_list_text(before and 0) equals "selected" and string_length(archive_list_text(before and 1)) > 0:
        return 9
    if not (discord_command_observe(journal and "{\"id\":\"805\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"group\"}" and "900" and "200") equals "registered"):
        return 10
    set body to group_command_fixture(journal and "701" and "{\"action\":\"create\",\"source\":\"100\"}")
    set result to discord_group_command_apply(journal and database and "interaction:701" and body and "900" and guilds and admins)
    if string_index_of(result and "group-control:Shared conversation:") is not equal to 0:
        display result
        return 11
    set chosen to discord_joined_selected(database and device and "200" and "300")
    set group_id to archive_list_text(chosen and 1)
    set invitee to principal_for_device(database and "discord:500")
    if not (group_member_state(database and group_id and invitee) equals "invited"):
        return 12
    set changed to discord_joined_change(database and "discord:500" and "200" and "300" and "decline-offer" and group_id and invitee and "left" and 2)
    if not (changed equals "recorded"):
        display changed
        return 13
    if not (discord_group_command_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals result) or else not (group_member_state(database and group_id and invitee) equals "left"):
        return 14
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_group_command_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals result) or else not (group_member_state(database and group_id and invitee) equals "left"):
        return 15
    set another to group_command_fixture(journal and "702" and "{\"action\":\"create\",\"source\":\"100\"}")
    if not (discord_group_command_apply(journal and database and "interaction:702" and another and "900" and guilds and admins) equals result) or else not (group_member_state(database and group_id and invitee) equals "left"):
        return 16
    if not (discord_joined_change(database and device and "200" and "300" and "explicit-new-invite" and group_id and invitee and "invited" and 3) equals "recorded"):
        return 17
    if not (discord_joined_change(database and "discord:500" and "200" and "300" and "explicit-self-join" and group_id and invitee and "joined" and 4) equals "recorded"):
        return 18
    if not (discord_joined_select(database and "discord:500" and "200" and "300" and "choose-group" and group_id) equals "selected"):
        return 19
    set next_body to "{\"id\":\"101\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"What public exchange started this conversation?\"}"
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and next_body) equals "recorded"):
        return 20
    set admitted to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(admitted and 0) equals "accepted"):
        display archive_list_text(admitted and 0)
        return 21
    set run to agent_run_read(database and "discord-message:101")
    set session to archive_list_text(run and 0)
    set seed to public_group_seed_context(database and "discord-message:101" and session)
    if string_contains(seed and "amber-lantern") equals 0 or else string_contains(seed and "source_boundary") equals 0 or else string_contains(seed and "attribution") equals 0:
        display seed
        return 22
    if string_length(public_group_seed_context(database and "discord-message:100" and session)) > 0:
        return 23
    if not (discord_group_seed_import(database and "discord-message:101") equals "already-recorded"):
        return 24
    set messages to session_messages_checkpoint(database and session and "discord-message:101" and 0)
    if string_contains(messages and "amber-lantern") equals 0 or else string_contains(messages and "What public exchange started this conversation?") equals 0:
        return 25
    display "PASS: public offer deduplication; no automatic join/selection; creator-bound acceptance; declined invitation remains declined across retry/reopen."
    return 0
