import "../../app/discord/steering_recovery"
import "../../app/discord/background_store"

define auto_admit_fixture with journal as Int and identity as Str and room as Str and prompt as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":" and concat(provider_quote(prompt) and "}]}}"))))))
    set inbox to concat("interaction:" and identity)
    set saved to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and inbox) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [inbox]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_admission_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 1
    set response to concat("{\"id\":" and concat(provider_quote(concat("1" and identity)) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy request received.\",\"interaction_metadata\":{\"id\":" and concat(provider_quote(identity) and ",\"type\":2,\"user\":{\"id\":\"400\"}}}"))))))
    if not (discord_command_anchor_observe(journal and inbox and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 1
    return 0

define background_fixture_message with journal as Int and message as Str and user as Str and room as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(user) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public scheduler fixture.\"}"))))))
    set inbox to concat("message:create:" and message)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if discord_steering_schema(journal) is not equal to 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else auto_admit_fixture(journal and "701" and "300" and "Work on a task.") is not equal to 0:
        return 3
    set run to "discord-command:interaction:701"
    set admitted to discord_command_auto_admit(journal and database and "interaction:701" and "900" and ["200"] and ["400"])
    if not (archive_list_text(admitted and 0) equals "accepted") or else not (discord_background_reserve(journal and run and "interaction:701" and 1) equals "reserved") or else background_fixture_message(journal and "101" and "400" and "300") is not equal to 0:
        return 4
    if not (discord_steering_reserve(journal and "message:create:101" and "interaction:701" and "900") equals "queue-or-target-unavailable") or else not (discord_steering_reserve(journal and "message:create:101" and "interaction:701" and "400") equals "reserved"):
        return 5
    set identity to concat("discord-steering:" and ep_sha256("message:create:101"))
    # Simulate archive commit followed by process interruption before journal confirmation.
    if web_guidance_request(database and "discord:400" and run and identity and "Public scheduler fixture.") is not equal to 0:
        return 6
    if not (discord_steering_release_terminal(journal and database and "message:create:101" and run) equals "guidance-reconciliation-required"):
        return 11
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_steering_apply(journal and database and "message:create:101" and run and "400") equals "steered") or else not (discord_steering_apply(journal and database and "message:create:101" and run and "400") equals "already-steered"):
        return 7
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='guidance_received';"))
    if not (archive_list_text(count and 1) equals "1") or else not (archive_list_text(discord_worker_claim(journal) and 0) equals "end"):
        return 8
    if not (discord_steering_apply(journal and database and "message:create:101" and run and "401") equals "steering-binding-denied"):
        return 9
    if background_fixture_message(journal and "102" and "400" and "300") is not equal to 0 or else not (discord_steering_reserve(journal and "message:create:102" and "interaction:701" and "400") equals "reserved"):
        return 12
    if not (discord_steering_release_terminal(journal and database and "message:create:102" and run) equals "target-not-terminal") or else agent_cancel_run(database and run) is not equal to 0:
        return 13
    if not (discord_steering_release_terminal(journal and database and "message:create:102" and run) equals "returned-to-queue") or else not (discord_steering_release_terminal(journal and database and "message:create:102" and run) equals "no-reservation"):
        return 14
    if not (discord_steering_apply(journal and database and "message:create:102" and run and "400") equals "steering-binding-denied") or else not (discord_background_transition(journal and run and "reserved" and "released" and "" and 0 and "cancelled fixture") equals "recorded"):
        return 15
    if not (archive_list_text(discord_worker_claim(journal) and 1) equals "message:create:102"):
        return 16
    if not (discord_steering_apply(journal and database and "message:create:102" and run and "400") equals "steering-binding-denied"):
        return 17
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else not (discord_steering_apply(journal and database and "message:create:101" and run and "400") equals "steering-binding-denied"):
        return 10
    display "PASS: command-target steering preserves original human, archive-before-journal crash recovery, exact one guidance, no ordinary dequeue, replay, terminal requeue without late guidance, and revoked authority rejection; live transport remains pending"
    return 0
