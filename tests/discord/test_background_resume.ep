import "../../app/discord/background_supervisor"
import "../../app/agent/control"

# The child deliberately does no inference or Discord I/O. This fixture
# qualifies executable role dispatch, sanitized environment, exact claim
# identity and durable settlement independently from live-model acceptance.
define main returning Int:
    if get_argument_count() equals 16:
        if not (get_argument(13) equals "--job") or else string_length(ptr_to_str(get_env("ECHO_TEST_PRIVATE_SENTINEL"))) > 0 or else not (ptr_to_str(get_env("ECHO_EMBEDDING_PROFILE")) equals get_argument(3)):
            return 20
        set database to discord_agent_open(get_argument(2) and "900")
        set values to create_list()
        set added to append_list(values and get_argument(14))
        set added to append_list(values and get_argument(15))
        if database equals 0 or else agent_cancel_run(database and get_argument(14)) is not equal to 0 or else tool_ledger_change(database and "UPDATE echo_web_workers SET status='cancelled' WHERE run=?1 AND worker=?2 AND status='running' RETURNING run;" and values) is not equal to 0:
            return 21
        return sql_close(database)
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background process fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "original-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved") or else not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "original-worker" and 123 and "fixture") equals "recorded"):
        return 5
    set tracked to create_list()
    set tracked_child to history_status("worker-started")
    set added to append_list(tracked_child and 123)
    set added to append_list(tracked_child and "discord-message:100")
    set added to append_list(tracked_child and "original-worker")
    set added to append_list(tracked and tracked_child)
    if discord_background_capacity(journal and database and tracked) is not equal to 1:
        return 10
    set unrecorded_child to history_status("worker-started")
    set added to append_list(unrecorded_child and 124)
    set added to append_list(unrecorded_child and "pending-journal-fixture")
    set added to append_list(unrecorded_child and "pending-worker")
    set added to append_list(tracked and unrecorded_child)
    if discord_background_capacity(journal and database and tracked) is not equal to 2:
        return 11
    set recovered to discord_background_recover(journal and database and "discord-message:100")
    if not (archive_list_text(recovered and 0) equals "recovered") or else discord_background_active(journal and database) is not equal to 0:
        return 6
    set arguments to create_list()
    set added to append_list(arguments and get_argument(1))
    set added to append_list(arguments and get_argument(2))
    set added to append_list(arguments and ptr_to_str(get_env("ECHO_EMBEDDING_PROFILE")))
    set index to 3
    repeat while index < 12:
        set added to append_list(arguments and "fixture")
        set index to index + 1
    set launched to discord_background_resume_one(journal and database and arguments)
    if not (archive_list_text(launched and 0) equals "worker-started") or else not (archive_list_text(launched and 3) equals archive_list_text(recovered and 2)):
        return 7
    set waiting to channel
    set waits to create_list()
    set added to append_list(waits and waiting)
    set outcome to 0
    repeat while outcome equals 0:
        set outcome to discord_process_poll(get_list(launched and 1))
        if outcome equals 0:
            set waited to select(waits and 10)
    if outcome is not equal to 1 or else discord_background_settle(journal and database) is not equal to 0:
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(row and 1) equals "released") or else not (archive_list_text(discord_background_resume_one(journal and database and arguments) and 0) equals "end"):
        return 9
    display "PASS: recovered job dispatched to same executable with isolated environment, exact claim token, terminal receipt and no duplicate launch."
    return sql_close(database)
