import "../../app/discord/rest"
import "fs"
import "string"

# Read-only live REST qualification. Use a fresh private directory. Never print
# the credential or response body; record only identity equality and HTTP facts.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and get_argument(4))
    set output to workspace_file_open(system and directory and "identity.json" and 1)
    set headers to workspace_file_open(system and directory and "identity.headers" and 1)
    if output < 0 or else headers < 0:
        return 3
    set result to discord_rest_transfer(get_argument(1) and string_trim(ptr_to_str(credential)) and "GET" and "/users/@me" and "" and output and headers)
    if not (archive_list_text(result and 0) equals "complete") or else not (archive_list_text(result and 1) equals "200"):
        display archive_list_text(result and 0)
        display archive_list_text(result and 1)
        return 4
    set response to read_file(concat(get_argument(4) and "/identity.json"))
    if response equals 0:
        return 5
    set tokens to provider_json_tokens(ptr_to_str(response))
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "id")) equals get_argument(3)):
        return 6
    set output to workspace_file_open(system and directory and "rejected.json" and 1)
    set headers to workspace_file_open(system and directory and "rejected.headers" and 1)
    set rejected to discord_rest_transfer(get_argument(1) and string_trim(ptr_to_str(credential)) and "GET" and "//example.com/steal" and "" and output and headers)
    if not (archive_list_text(rejected and 0) equals "setup-failed-route") or else not (archive_list_text(rejected and 1) equals "0"):
        return 7
    set output to workspace_file_open(system and directory and "header-rejected.json" and 1)
    set headers to workspace_file_open(system and directory and "header-rejected.headers" and 1)
    set rejected to discord_rest_transfer_bytes(get_argument(1) and string_trim(ptr_to_str(credential)) and "POST" and "/channels/0/messages" and 0 and 0 and "audio/wav\r\nInjected: value" and output and headers and 20000 and 60000)
    if not (archive_list_text(rejected and 0) equals "setup-failed-content-type") or else not (archive_list_text(rejected and 1) equals "0"):
        return 8
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    display "PASS: native TLS REST authenticated bot identity; cross-origin route and multipart header injection rejected before network. No server mutation."
    return 0
