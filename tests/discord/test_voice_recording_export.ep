import "../../app/discord/voice_recording_export"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set journal to sql_open(get_argument(1))
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and get_argument(2))
    if journal equals 0 or else system equals 0 or else directory < 0:
        return 2
    if discord_voice_recording_export_schema(journal) is not equal to 0 or else sql_execute(journal and "PRAGMA query_only=ON;") is not equal to 0:
        return 3
    if not (get_argument(3) equals "no-transaction"):
        if sql_execute(journal and "BEGIN;") is not equal to 0:
            return 4
    set cursor to -1
    set count to 0
    repeat while count < 100:
        set name to concat("chunk-" and concat(int_to_string(count) and ".wav"))
        set descriptor to workspace_file_open(system and directory and name and 1)
        if descriptor < 0:
            return 5
        set result to discord_voice_recording_export(journal and system and descriptor and "recording" and "500" and "human-session" and 12345 and cursor)
        if file_stage_finish(system and descriptor) is not equal to 0:
            return 6
        set status to archive_list_text(result and 0)
        if not (get_argument(3) equals "normal"):
            set expected to get_argument(3)
            if expected equals "no-transaction":
                set expected to "recording-export-invalid"
            if not (status equals expected):
                display status
                return 7
            display concat("PASS: " and status)
            return 0
        if status equals "recording-export-end":
            break
        if not (status equals "recording-audio-staged"):
            display status
            return 8
        set manifest to archive_list_text(result and 1)
        set fields to provider_json_tokens(manifest)
        set next_cursor to string_to_int(provider_value(fields and provider_member(fields and 0 and "last_nonce")))
        if next_cursor <= cursor:
            return 9
        set path to concat(get_argument(2) and concat("/chunk-" and concat(int_to_string(count) and ".json")))
        if write_file(path and manifest) is not equal to 1:
            return 10
        set cursor to next_cursor
        set count to count + 1
    if count >= 100 or else sql_execute(journal and "COMMIT;") is not equal to 0:
        return 11
    set closed to net_close(directory)
    set closed to sql_close(journal)
    set closed to ep_dlclose(system)
    display concat("PASS: exported segments " and int_to_string(count))
    return 0
