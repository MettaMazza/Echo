import "../../app/discord/action_worker"
import "../../app/discord/command_registration"
import "../../app/web/worker"

define hud_command_fixture with journal as Int and identity as Str and arguments as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT json_group_array(json_object('type',3,'name',key,'value',value)) FROM json_each(?1);" and [arguments]))
    set options to archive_list_text(row and 1)
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT json_object('id',?1,'type',2,'application_id','900','guild_id','200','channel_id','300','member',json('{\"user\":{\"id\":\"400\"}}'),'data',json_object('type',1,'id','806','name','hud','options',json(?2)));" and [identity,options]))
    set body to archive_list_text(source and 1)
    set inbox to concat("interaction:" and identity)
    if not (discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledged',CAST(?2 AS INTEGER),'fixture');" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_hud_credential_1234','fixture',CAST(?2 AS INTEGER),CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else web_worker_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if discord_control_command_matches(discord_control_command_definition("hud") and "hud") is not equal to 1 or else discord_control_command_matches(string_replace(discord_control_command_definition("hud") and "\"type\":3" and "\"type\":4") and "hud") is not equal to 0:
        return 3
    if not (discord_command_observe(journal and "{\"id\":\"806\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"hud\"}" and "900" and "200") equals "registered"):
        return 4
    set device to discord_agent_principal(database and "400" and create_list())
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "hud-run" and "HUD test" and create_list())
    if not (archive_list_text(first and 0) equals "accepted"):
        display archive_list_text(first and 0)
        return 5
    set session to archive_list_text(first and 1)
    set body to hud_command_fixture(journal and "701" and "{\"run\":\"hud-run\",\"section\":\"interaction\"}")
    set resolved to discord_command_resolve(journal and body and "900" and ["200"] and create_list())
    if not (archive_list_text(resolved and 0) equals "command-bound-needs-live-access") or else string_contains(archive_list_text(resolved and 5) and "\"after\":0") equals 0:
        return 6
    set prepared to discord_hud_prepare(journal and database and "interaction:701" and body and "900" and ["200"] and create_list())
    if not (archive_list_text(prepared and 0) equals "found") or else string_contains(archive_list_text(prepared and 1) and "hud-run:user") equals 0:
        display archive_list_text(prepared and 0)
        return 7
    set payload to archive_list_text(prepared and 1)
    set digest to archive_list_text(prepared and 2)
    if not (ep_sha256(payload) equals digest):
        return 8
    if archive_append(database and session and "hud-change" and "autonomy_disabled" and "{\"run_id\":\"hud-run\",\"reason\":\"Changed after the snapshot\"}" and "test") is not equal to 0:
        return 9
    set retry to discord_hud_prepare(journal and database and "interaction:701" and body and "900" and ["200"] and create_list())
    if not (archive_list_text(retry and 1) equals payload) or else not (archive_list_text(retry and 2) equals digest):
        return 10
    set next_body to hud_command_fixture(journal and "702" and "{\"run\":\"hud-run\",\"section\":\"interaction\",\"after\":\"0\"}")
    set next_snapshot to discord_hud_prepare(journal and database and "interaction:702" and next_body and "900" and ["200"] and create_list())
    if not (archive_list_text(next_snapshot and 0) equals "found") or else string_contains(archive_list_text(next_snapshot and 1) and "Changed after the snapshot") equals 0:
        return 11
    if not (archive_list_text(discord_hud_prepare(journal and database and "interaction:701" and string_replace(body and "300" and "301") and "900" and ["200"] and create_list()) and 0) equals "hud-not-authorized"):
        return 12
    set denied_body to hud_command_fixture(journal and "703" and "{\"run\":\"hud-run\",\"section\":\"machine\"}")
    if not (archive_list_text(discord_hud_prepare(journal and database and "interaction:703" and denied_body and "900" and ["200"] and create_list()) and 0) equals "hud-not-authorized"):
        return 13
    for each invalid in ["-1","1.5","01","9223372036854775808",""]:
        set bad to concat("{\"data\":{\"options\":[{\"type\":3,\"name\":\"run\",\"value\":\"hud-run\"},{\"type\":3,\"name\":\"section\",\"value\":\"interaction\"},{\"type\":3,\"name\":\"after\",\"value\":" and concat(provider_quote(invalid) and "}]}}"))
        if string_length(discord_hud_command_options(bad)) > 0:
            return 14
    for each bad in ["{\"data\":{\"options\":[{\"type\":3,\"name\":\"run\",\"value\":\"hud-run\"},{\"type\":3,\"name\":\"run\",\"value\":\"other\"},{\"type\":3,\"name\":\"section\",\"value\":\"interaction\"}]}}","{\"data\":{\"options\":[{\"type\":3,\"name\":\"run\",\"value\":\"hud-run\"},{\"type\":3,\"name\":\"section\",\"value\":\"unknown\"}]}}","{\"data\":{\"options\":[{\"type\":3,\"name\":\"device\",\"value\":\"admin\"}]}}"]:
        if string_length(discord_hud_command_options(bad)) > 0:
            return 15
    if web_device_revoke(database and device) is not equal to 0:
        return 16
    if not (archive_list_text(discord_hud_prepare(journal and database and "interaction:701" and body and "900" and ["200"] and create_list()) and 0) equals "hud-not-authorized"):
        return 17
    display "PASS: HUD command registration/options, authenticated binding, private frozen retry, fresh snapshot, forged body, privileged denial and revocation."
    set closed to sql_close(journal)
    return sql_close(database) + closed
