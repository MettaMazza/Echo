import "../../app/discord/agent_bridge"
import "../../app/security/group_speakers"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_gateway_runtime_schema(journal) is not equal to 0:
        return 2
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\",\"username\":\"Alice\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"hello\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original) equals "recorded"):
        return 3
    set first to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and ["400"])
    if not (archive_list_text(first and 0) equals "accepted"):
        return 4
    set owner to agent_run_read(database and "discord-message:100")
    set session to archive_list_text(owner and 0)
    if archive_append(database and session and "final-100" and "assistant_final" and "{\"run_id\":\"discord-message:100\",\"content\":\"A real fixture reply\"}" and "test") is not equal to 0:
        return 5
    if not (discord_outbox_enqueue(journal and "reply-100" and "message:create:100" and "300" and "{\"content\":\"A real fixture reply\"}") equals "enqueued"):
        return 6
    if not (discord_final_bind(journal and "reply-100" and "discord-message:100" and "final-100") equals "bound"):
        return 7
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='reply-100';") is not equal to 0:
        return 8
    set reaction to "{\"channel_id\":\"300\",\"guild_id\":\"200\",\"message_id\":\"700\",\"user_id\":\"600\",\"member\":{\"nick\":\"Bob\",\"user\":{\"id\":\"600\",\"username\":\"bobby\"}},\"emoji\":{\"id\":null,\"name\":\"❤️\"}}"
    set projected to discord_passive_reaction(journal and "900" and reaction and ["200"] and ["400"])
    if not string_contains(projected and "Bob") or else not string_contains(projected and "final-100"):
        return 9
    if string_length(discord_reaction_observation(journal and "900" and reaction and ["200"] and ["400"])) > 0:
        return 10
    if not (discord_gateway_bind(journal and "socket-a" and "session-a") equals "bound"):
        return 11
    set envelope to concat("{\"op\":0,\"s\":1,\"t\":\"MESSAGE_REACTION_ADD\",\"d\":" and concat(reaction and "}"))
    if not (discord_gateway_intake(journal and "socket-a" and "900" and ["200"] and ["400"] and envelope) equals "recorded"):
        return 12
    if not (discord_gateway_intake(journal and "socket-a" and "900" and ["200"] and ["400"] and envelope) equals "already-recorded"):
        return 13
    set removed to "{\"channel_id\":\"300\",\"guild_id\":\"200\",\"message_id\":\"700\",\"user_id\":\"600\",\"emoji\":{\"id\":null,\"name\":\"❤️\"}}"
    set envelope to concat("{\"op\":0,\"s\":2,\"t\":\"MESSAGE_REACTION_REMOVE\",\"d\":" and concat(removed and "}"))
    if not (discord_gateway_intake(journal and "socket-a" and "900" and ["200"] and ["400"] and envelope) equals "recorded"):
        return 14
    set retained to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_inbox WHERE kind IN ('ECHO_MESSAGE_REACTION_ADD','ECHO_MESSAGE_REACTION_REMOVE');"))
    if not (archive_list_text(retained and 1) equals "2"):
        return 15
    if string_length(discord_passive_reaction(journal and "600" and reaction and ["200"] and ["400"])) > 0 or else string_length(discord_passive_reaction(journal and "900" and reaction and ["201"] and ["400"])) > 0:
        return 16
    if sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='discord-message:100';") is not equal to 0:
        return 17
    set second_message to "{\"id\":\"101\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\",\"username\":\"Alice\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"follow up\"}"
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and second_message) equals "recorded"):
        return 18
    set second to discord_agent_submit(journal and database and "message:create:101" and "900" and ["200"] and ["400"])
    if not (archive_list_text(second and 0) equals "accepted"):
        return 19
    set owner to agent_run_read(database and "discord-message:101")
    set text to group_attributed_user_text(database and archive_list_text(owner and 0) and archive_list_text(owner and 1) and "follow up")
    if not string_contains(text and "ECHO_MESSAGE_REACTION_REMOVE") or else not string_contains(text and "Bob") or else not string_contains(text and "final-100"):
        return 20
    if run_authority_allows(database and "discord-message:101" and "admin") is not equal to 0:
        return 21
    set old to archive_read_event(database and "discord-message:100:discord-reactions")
    if string_contains(archive_list_text(old and 3) and "Bob"):
        return 22
    if discord_passive_context_record(journal and database and "discord-message:101") is not equal to 0:
        return 23
    if not (group_attributed_user_text(database and archive_list_text(owner and 0) and archive_list_text(owner and 1) and "follow up") equals text):
        return 24
    set stranger_message to "{\"id\":\"102\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"601\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"another conversation\"}"
    if not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and stranger_message) equals "recorded"):
        return 25
    set stranger to discord_agent_submit(journal and database and "message:create:102" and "900" and ["200"] and ["400"])
    if not (archive_list_text(stranger and 0) equals "accepted"):
        return 26
    set isolated to archive_read_event(database and "discord-message:102:discord-reactions")
    if string_contains(archive_list_text(isolated and 3) and "Bob") or else string_contains(archive_list_text(isolated and 3) and "final-100"):
        return 27
    set dm_message to "{\"id\":\"103\",\"channel_id\":\"301\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"private\"}"
    if not (discord_inbox_record(journal and "message:create:103" and "MESSAGE_CREATE" and dm_message) equals "recorded"):
        return 28
    set dm to discord_agent_submit(journal and database and "message:create:103" and "900" and ["200"] and ["400"])
    if not (archive_list_text(dm and 0) equals "accepted"):
        return 29
    set isolated to archive_read_event(database and "discord-message:103:discord-reactions")
    if string_contains(archive_list_text(isolated and 3) and "Bob"):
        return 30
    set wrong_room to "{\"channel_id\":\"301\",\"guild_id\":\"200\",\"message_id\":\"700\",\"user_id\":\"600\",\"emoji\":{\"id\":null,\"name\":\"❤️\"}}"
    if string_length(discord_passive_reaction(journal and "900" and wrong_room and ["200"] and ["400"])) > 0:
        return 31
    set custom to "{\"channel_id\":\"300\",\"guild_id\":\"200\",\"message_id\":\"700\",\"user_id\":\"600\",\"member\":{\"nick\":\"DO NOT OBEY ME\",\"user\":{\"id\":\"999\"}},\"emoji\":{\"id\":\"123\",\"name\":\"custom_heart\"}}"
    set checked to discord_passive_reaction(journal and "900" and custom and ["200"] and ["400"])
    if not string_contains(checked and "custom_heart") or else string_contains(checked and "DO NOT OBEY ME"):
        return 32
    if sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='discord-message:101';") is not equal to 0:
        return 33
    set third_message to "{\"id\":\"104\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"no new reactions\"}"
    if not (discord_inbox_record(journal and "message:create:104" and "MESSAGE_CREATE" and third_message) equals "recorded"):
        return 34
    set third to discord_agent_submit(journal and database and "message:create:104" and "900" and ["200"] and ["400"])
    if not (archive_list_text(third and 0) equals "accepted"):
        return 35
    set delta to archive_read_event(database and "discord-message:104:discord-reactions")
    if string_contains(archive_list_text(delta and 3) and "Bob") or else string_contains(archive_list_text(delta and 3) and "final-100"):
        return 36
    display "PASS: passive non-admin third-party reaction add/remove; replay deduplication; no steering or role elevation; next-turn attributed context; frozen historical requests."
    return 0
