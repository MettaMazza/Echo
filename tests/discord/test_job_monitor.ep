import "../../app/discord/job_worker"

define check_job_monitor with journal as Int and database as Int and journal_path as Str and database_path as Str and mode as Int returning Int:
    set message to int_to_string(100 + mode)
    set room to int_to_string(300 + mode)
    set inbox to concat("message:create:" and message)
    set run to concat("discord-message:" and message)
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and ",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Monitor regression.\"}"))))
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and inbox and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set stop to socket_cancellation_create(system)
    set cancellation to socket_cancellation_create(system)
    if system equals 0 or else stop equals 0 or else cancellation equals 0:
        return 3
    set completed to channel
    set stop_file to concat(database_path and ".stop")
    set monitor_run to concat(run and "")
    set monitor_message to concat(message and "")
    set monitor_room to concat(room and "")
    spawn discord_job_monitor(journal_path and database_path and monitor_run and inbox and 0 and monitor_message and monitor_room and "200" and stop_file and get_list(stop and 0) and get_list(cancellation and 1) and completed)
    if mode equals 0:
        set deletion to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and "}"))))
        if not (discord_inbox_record(journal and "job-delete" and "MESSAGE_DELETE" and deletion) equals "recorded"):
            return 4
    else if mode equals 1:
        if web_cancel_request(database and "discord:400" and run) is not equal to 0:
            return 5
    else if mode equals 2:
        set closed to net_close(get_list(stop and 1))
    else:
        if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0:
            return 6
    set result to receive from completed
    if result is not equal to 0 or else agent_cancellation_pending(system and get_list(cancellation and 0)) equals 0:
        return 7
    if mode is not equal to 2:
        set closed to net_close(get_list(stop and 1))
    set closed to net_close(get_list(cancellation and 0))
    set closed to ep_dlclose(system)
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set mode to 0
    repeat while mode < 4:
        set result to check_job_monitor(journal and database and get_argument(1) and get_argument(2) and mode)
        if result is not equal to 0:
            display mode
            display result
            return 3
        set mode to mode + 1
    display "PASS: Discord background cancellation pipe wakes on source deletion, explicit cancel, worker completion and authority revocation."
    return 0
