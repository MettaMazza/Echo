import "../../app/discord/access"
import "../../app/discord/expression_view"

# Independent readback using the native authenticated REST transport. Only the
# exact requested resource name or ID is projected; no creator profile is shown.
define main returning Int:
    if get_argument_count() is not equal to 9 or else discord_snowflake(get_argument(6)) equals 0:
        return 1
    set kind to get_argument(7)
    set suffix to "/emojis"
    if kind equals "sticker":
        set suffix to "/stickers"
    else if not (kind equals "emoji"):
        return 2
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 3
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 4
    set route to concat("/guilds/" and concat(get_argument(6) and suffix))
    set response to discord_access_get(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and route and "GET:expression-readback" and get_argument(6))
    if not (archive_list_text(response and 0) equals "observed"):
        display archive_list_text(response and 0)
        return 5
    set body to archive_list_text(response and 1)
    set fields to provider_json_tokens(body)
    if fields equals 0 or else not (provider_kind(fields and 0) equals "["):
        return 6
    set items to create_list()
    set items to provider_items(fields and 0)
    set matches to "["
    set count to 0
    for each item in items:
        set identity to provider_value(fields and provider_member(fields and item and "id"))
        set name to provider_value(fields and provider_member(fields and item and "name"))
        if identity equals get_argument(8) or else name equals get_argument(8):
            set raw to agent_json_source(body and fields and item)
            set projected to discord_expression_view(raw and kind and get_argument(6) and identity)
            if string_length(projected) equals 0:
                return 7
            if count > 0:
                set matches to concat(matches and ",")
            set matches to concat(matches and projected)
            set count to count + 1
    set matches to concat(matches and "]")
    set result to concat("{\"kind\":" and provider_quote(kind))
    set result to concat(result and concat(",\"count\":" and int_to_string(count)))
    set result to concat(result and concat(",\"response_sha256\":" and provider_quote(ep_sha256(body))))
    set result to concat(result and concat(",\"matches\":" and concat(matches and "}")))
    display result
    return sql_close(journal)
