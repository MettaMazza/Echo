import "../../app/discord/speech_toggle"

define toggle_test_click with journal as Int and identity as Str and now as Int returning Int:
    set saved to discord_inbox_record(journal and identity and "INTERACTION_CREATE" and "{}")
    if discord_interaction_queue(journal and identity) is not equal to 0:
        return 1
    return archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged',received_ms=CAST(?2 AS INTEGER) WHERE identity=?1;" and [identity,int_to_string(now)]) and 101)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_interaction_schema(journal) is not equal to 0:
        return 2
    set made to toggle_test_click(journal and "click:1" and 100)
    set made to toggle_test_click(journal and "click:2" and 101)
    if not (discord_speech_toggle_claim(journal and "click:1" and "reply:A") equals "1"):
        return 3
    if not (discord_speech_toggle_claim(journal and "click:2" and "reply:A") equals "speech-coalesced"):
        return 4
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_speech_toggle_claim(journal and "click:1" and "reply:A") equals "1"):
        return 5
    if not (discord_speech_toggle_finish(journal and "click:1" and 200) equals "speech-toggle-complete"):
        return 6
    if not (discord_speech_toggle_claim(journal and "click:1" and "reply:A") equals "speech-toggle-complete") or else not (discord_speech_toggle_claim(journal and "click:2" and "reply:A") equals "speech-coalesced"):
        return 7
    set made to toggle_test_click(journal and "click:3" and 300)
    if not (discord_speech_toggle_claim(journal and "click:3" and "reply:A") equals "0"):
        return 8
    if not (discord_speech_toggle_finish(journal and "click:3" and 400) equals "speech-toggle-complete"):
        return 9
    set made to toggle_test_click(journal and "click:4" and 500)
    if not (discord_speech_toggle_claim(journal and "click:4" and "reply:A") equals "1"):
        return 10
    set made to toggle_test_click(journal and "click:5" and 501)
    if not (discord_speech_toggle_claim(journal and "click:5" and "reply:B") equals "1"):
        return 11
    display "PASS: shared show/hide/restore, rapid-click coalescing, independent messages, durable pending operation and completed replay after reopen"
    return 0
