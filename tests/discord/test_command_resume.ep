import "../../app/discord/command_execution"

define session_command_fixture with journal as Int and id as Str and state as Str and name as Str and options as Str returning Str:
    set data to concat("{\"type\":1,\"id\":\"801\",\"name\":" and provider_quote(name))
    set data to concat(data and concat(",\"options\":" and concat(options and "}")))
    if name equals "history":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"802\"")
    if name equals "search":
        set data to string_replace(data and "\"id\":\"801\"" and "\"id\":\"803\"")
    set body to concat("{\"id\":" and provider_quote(id))
    set body to concat(body and ",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":")
    set body to concat(body and concat(data and "}"))

    set identity to concat("interaction:" and id)
    if not (discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    set values to create_list()
    set added to append_list(values and identity)
    set added to append_list(values and state)
    set added to append_list(values and int_to_string(ep_time_now_ms()))
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,?2,CAST(?3 AS INTEGER),'fixture');" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_command_credential_1234','fixture',CAST(?3 AS INTEGER),CAST(?3 AS INTEGER)+900000);" and values) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"801\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"resume\"}" and "900" and "200") equals "registered"):
        return 3
    set guilds to ["200"]
    set admins to create_list()
    set device to discord_agent_principal(database and "400" and admins)
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "before" and "BEFORE_NEW_MARKER" and create_list())
    if not (archive_list_text(first and 0) equals "accepted"):
        return 4
    set options to concat("[{\"type\":3,\"name\":\"session\",\"value\":" and concat(provider_quote(archive_list_text(first and 1)) and "}]"))
    set body to session_command_fixture(journal and "702" and "acknowledged" and "resume" and options)
    if not (discord_command_new_apply(journal and database and "interaction:702" and body and "900" and guilds and admins) equals "session-selected"):
        return 5
    set bad to session_command_fixture(journal and "703" and "acknowledged" and "resume" and "[]")
    if not (discord_command_new_apply(journal and database and "interaction:703" and bad and "900" and guilds and admins) equals "invalid-command-options"):
        return 6
    set denied to session_command_fixture(journal and "704" and "acknowledged" and "resume" and "[{\"type\":3,\"name\":\"session\",\"value\":\"host-private-session\"}]")
    if not (discord_command_new_apply(journal and database and "interaction:704" and denied and "900" and guilds and admins) equals "session-not-authorized"):
        return 7
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"history\"}" and "900" and "200") equals "registered"):
        return 8
    set listing to session_command_fixture(journal and "705" and "acknowledged" and "history" and "[]")
    set result to discord_command_new_apply(journal and database and "interaction:705" and listing and "900" and guilds and admins)
    if string_index_of(result and "session-history:") is not equal to 0 or else string_index_of(result and archive_list_text(first and 1)) < 0:
        return 9
    if not (discord_command_observe(journal and "{\"id\":\"803\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"search\"}" and "900" and "200") equals "registered"):
        return 10
    set query to session_command_fixture(journal and "706" and "acknowledged" and "search" and "[{\"type\":3,\"name\":\"query\",\"value\":\"before_new\"}]")
    set found to discord_command_new_apply(journal and database and "interaction:706" and query and "900" and guilds and admins)
    if string_index_of(found and archive_list_text(first and 1)) < 0:
        return 11
    set missing to session_command_fixture(journal and "707" and "acknowledged" and "search" and "[]")
    if not (discord_command_new_apply(journal and database and "interaction:707" and missing and "900" and guilds and admins) equals "invalid-command-options"):
        return 12
    display "PASS: authenticated resume dispatch, required argument validation, private/foreign session denial"
    return 0
