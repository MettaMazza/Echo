import "../../app/discord/voice_wire"

define main returning Int:
    set ssrc to 16909060
    set request to discord_voice_discovery_request(ssrc)
    if request equals 0 or else get_list(request and 1) is not equal to 74:
        return 1
    set pointer to get_list(request and 0)
    if discord_voice_u16(pointer and 0) is not equal to 1 or else discord_voice_u16(pointer and 2) is not equal to 70 or else peek_byte(pointer and 4) is not equal to 1 or else peek_byte(pointer and 7) is not equal to 4:
        return 2
    set index to 8
    repeat while index < 74:
        if peek_byte(pointer and index) is not equal to 0:
            return 3
        set index to index + 1
    if discord_voice_discovery_response(pointer and 74 and ssrc) is not equal to 0:
        return 4
    set written to discord_voice_put_u16(pointer and 0 and 2)
    set address to "203.0.113.7"
    set index to 0
    repeat while index < string_length(address):
        set written to poke_byte(pointer and index + 8 and peek_byte(str_to_ptr(address) and index))
        set index to index + 1
    set written to discord_voice_put_u16(pointer and 72 and 50000)
    set response to discord_voice_discovery_response(pointer and 74 and ssrc)
    if response equals 0 or else not (ptr_to_str(get_list(response and 0)) equals address) or else get_list(response and 1) is not equal to 50000:
        return 5
    if discord_voice_discovery_response(pointer and 73 and ssrc) is not equal to 0 or else discord_voice_discovery_response(pointer and 75 and ssrc) is not equal to 0 or else discord_voice_discovery_response(pointer and 74 and ssrc + 1) is not equal to 0:
        return 6
    set written to poke_byte(pointer and 8 and 47)
    if discord_voice_discovery_response(pointer and 74 and ssrc) is not equal to 0:
        return 7
    set index to 8
    repeat while index < 72:
        set written to poke_byte(pointer and index and 49)
        set index to index + 1
    if discord_voice_discovery_response(pointer and 74 and ssrc) is not equal to 0:
        return 8
    set released to discord_voice_blob_release(request)
    set header to discord_voice_rtp_header(65535 and 4294967295 and ssrc)
    if header equals 0 or else get_list(header and 1) is not equal to 12:
        return 9
    set pointer to get_list(header and 0)
    if peek_byte(pointer and 0) is not equal to 128 or else peek_byte(pointer and 1) is not equal to 120 or else discord_voice_u16(pointer and 2) is not equal to 65535 or else discord_voice_u32(pointer and 4) is not equal to 4294967295 or else discord_voice_u32(pointer and 8) is not equal to ssrc:
        return 10
    set released to discord_voice_blob_release(header)
    if discord_voice_rtp_header(65536 and 1 and ssrc) is not equal to 0 or else discord_voice_rtp_header(0 and 4294967296 and ssrc) is not equal to 0 or else discord_voice_discovery_request(-1) is not equal to 0:
        return 11
    display "PASS: binary voice discovery framing, bound SSRC and address/port extraction, malformed/truncated packets and Opus RTP network-byte-order boundaries."
    return 0
