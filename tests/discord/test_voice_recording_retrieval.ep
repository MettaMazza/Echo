import "../../app/discord/voice_tool"
import "../../app/discord/agent_bridge"
import "../../app/discord/post_file"
import "../../app/tools/attachment_text"
import "../../app/tools/attachment_image"

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    set fixture to ep_dlopen(get_argument(3))
    if database equals 0 or else journal equals 0 or else fixture equals 0:
        return 2
    set mode to get_argument(5)
    set fixture_mode to 12
    if mode equals "denied":
        set fixture_mode to 16
    else if mode equals "source":
        set fixture_mode to 6
    else if mode equals "epoch":
        set fixture_mode to 17
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and fixture_mode and str_to_ptr(get_argument(2)))
    set owner to history_collect_one(archive_prepare(journal and "SELECT identity,intent FROM discord_voice_recordings LIMIT 1;"))
    set source to discord_run_source(journal and database and "discord-message:101")
    set arguments to concat("{\"operation\":\"status\",\"intent\":" and concat(provider_quote(archive_list_text(owner and 2)) and concat(",\"recording\":" and concat(provider_quote(archive_list_text(owner and 1)) and "}"))))
    set options to discord_voice_options(arguments)
    set result to discord_voice_perform(get_argument(3) and "fixture-token-no-network-123456" and journal and database and "discord-message:101" and "voice-call" and source and options and "900" and ["200"] and ["500"] and get_argument(4) and "/absent-fixture-stop")
    display result
    if not (mode equals "normal"):
        return 0
    set assets to history_collect_one(archive_prepare(database and "SELECT audio,provenance,transcript,segments,p.session FROM echo_voice_recording_publications p JOIN echo_voice_recording_transcripts t ON t.artifact=p.identity ORDER BY p.identity LIMIT 1;"))
    if not (archive_list_text(assets and 0) equals "found"):
        return 3
    set session to archive_list_text(assets and 5)
    set guest to discord_agent_principal(database and "501" and ["500"])
    set index to 1
    repeat while index <= 4:
        set identity to archive_list_text(assets and index)
        if not (archive_list_text(web_attachment_owned(database and "discord:500" and identity) and 0) equals "found") or else archive_list_text(web_attachment_owned(database and guest and identity) and 0) equals "found":
            return 4
        if not (archive_list_text(discord_post_file_source(database and "discord-message:101" and "500" and identity) and 0) equals "found") or else archive_list_text(discord_post_file_source(database and "unrelated-run" and "500" and identity) and 0) equals "found":
            return 5
        if index equals 1:
            set read to attachment_audio_execute(database and session and concat("{\"attachment\":" and concat(provider_quote(identity) and "}")))
        else:
            set read to attachment_text_execute(database and session and concat("{\"attachment\":" and concat(provider_quote(identity) and ",\"offset\":0,\"characters\":4096}")))
        display read
        set tokens to provider_json_tokens(read)
        set status to provider_value(tokens and provider_member(tokens and 0 and "status"))
        if not (status equals "found" or else status equals "ready"):
            return 6
        set index to index + 1
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:500';") is not equal to 0:
        return 7
    set index to 1
    repeat while index <= 4:
        set identity to archive_list_text(assets and index)
        if archive_list_text(web_attachment_owned(database and "discord:500" and identity) and 0) equals "found" or else archive_list_text(discord_post_file_source(database and "discord-message:101" and "500" and identity) and 0) equals "found":
            return 8
        set index to index + 1
    if run_authority_allows(database and "discord-message:101" and "user") is not equal to 0:
        return 9
    display "PASS: audio, transcript, timings and provenance readable; guest/unbound delivery denied; revoked device loses all four exports and run authority."
    return 0
