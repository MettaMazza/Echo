import "../../app/discord/scheduled_event_access"

define main returning Int:
    set body to "{\"id\":\"700\",\"guild_id\":\"200\",\"channel_id\":null,\"name\":\"Fixture\",\"entity_type\":3,\"status\":1,\"creator_id\":\"900\",\"scheduled_start_time\":\"2026-12-01T18:00:00Z\",\"scheduled_end_time\":\"2026-12-01T19:00:00Z\",\"entity_metadata\":{\"location\":\"Garden\"}}"
    set digest to ep_sha256(body)
    set now to discord_event_timestamp("2026-11-01T00:00:00Z")
    set options to ["valid","start","700","fixture",digest,"{}","100","",""]
    set plan to discord_event_mutation_plan(body and options and now)
    if not (archive_list_text(plan and 0) equals "valid") or else not (archive_list_text(plan and 1) equals "{\"status\":2}"):
        return 1
    set options to ["valid","end","700","fixture",digest,"{}","100","",""]
    if not (archive_list_text(discord_event_mutation_plan(body and options and now) and 0) equals "invalid-event-transition"):
        return 2
    set options to ["valid","delete","700","fixture","wrong","{}","100","",""]
    if not (archive_list_text(discord_event_mutation_plan(body and options and now) and 0) equals "event-state-changed"):
        return 3
    set options to ["valid","delete","700","fixture",digest,"{}","100","",""]
    set plan to discord_event_mutation_plan(body and options and now)
    if not (archive_list_text(plan and 0) equals "valid") or else string_length(archive_list_text(plan and 1)) > 0:
        return 4
    set options to ["valid","edit","700","fixture",digest,"{\"name\":\"Revised\"}","100","",""]
    set plan to discord_event_mutation_plan(body and options and now)
    if not (archive_list_text(plan and 0) equals "valid") or else not (archive_list_text(plan and 1) equals "{\"name\":\"Revised\"}"):
        return 5
    set invalid_create to ["valid","create","","fixture","","{\"name\":\"bad\",\"entity_type\":3,\"scheduled_start_time\":\"2020-01-01T00:00:00Z\"}","100","",""]
    if archive_list_text(discord_event_mutation_plan("{}" and invalid_create and now) and 0) equals "valid":
        return 6
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"1024\",\"managed\":false},{\"id\":\"201\",\"position\":1,\"permissions\":\"17592186044416\",\"managed\":false}]"
    set actor to "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\"]}"
    set bot to "{\"user\":{\"id\":\"900\"},\"roles\":[\"201\"]}"
    set bundle to ["observed",server,roles,actor,bot,actor,"null"]
    set origin to "{\"id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"permission_overwrites\":[]}"
    if discord_event_permissions(bundle and origin and "{}" and "200" and "500" and "900" and "900" and 3 and "modify") is not equal to 0:
        return 7
    if discord_event_permissions(bundle and origin and "{}" and "200" and "500" and "900" and "" and 3 and "create") is not equal to 1:
        return 8
    set hidden to "{\"id\":\"301\",\"guild_id\":\"200\",\"type\":2,\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"}]}"
    if discord_event_permissions(bundle and origin and hidden and "200" and "500" and "900" and "" and 2 and "read") is not equal to 0:
        return 9
    set stage to "{\"id\":\"302\",\"guild_id\":\"200\",\"type\":13,\"permission_overwrites\":[]}"
    if discord_channel_same_audience(origin and stage and "200") is not equal to 1:
        return 10
    display "PASS: fresh-state mutation hashes, exact patches, invalid transitions, future time, independent creator permissions, source audience and stage visibility."
    return 0
