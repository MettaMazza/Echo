import "../../app/discord/steering_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_steering_schema(journal) is not equal to 0:
        return 2
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set active to discord_worker_claim(journal)
    if not (archive_list_text(active and 1) equals "message:create:100"):
        return 3
    set recorded to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and "{\"id\":\"101\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"},\"content\":\"steer\"}")
    if not (discord_steering_reserve(journal and "message:create:101" and "message:create:100" and "501") equals "queue-or-target-unavailable"):
        return 4
    if not (discord_steering_reserve(journal and "message:create:101" and "message:create:100" and "500") equals "reserved"):
        return 5
    if not (discord_steering_reserve(journal and "message:create:101" and "message:create:100" and "500") equals "already-reserved"):
        return 6
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_steering_reserve(journal and "message:create:101" and "message:create:100" and "500") equals "already-reserved"):
        return 7
    if not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "recorded"):
        return 8
    set next to discord_worker_claim(journal)
    if not (archive_list_text(next and 0) equals "end"):
        return 9
    set recorded to discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and "{\"id\":\"102\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    if not (discord_steering_reserve(journal and "message:create:102" and "message:create:100" and "500") equals "queue-or-target-unavailable"):
        return 10
    set next to discord_worker_claim(journal)
    if not (archive_list_text(next and 1) equals "message:create:102"):
        return 11
    set recorded to discord_inbox_record(journal and "message:create:103" and "MESSAGE_CREATE" and "{\"id\":\"103\",\"channel_id\":\"301\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    if not (discord_steering_reserve(journal and "message:create:103" and "message:create:102" and "500") equals "queue-or-target-unavailable"):
        return 12
    set next to discord_worker_claim(journal)
    if not (archive_list_text(next and 1) equals "message:create:103"):
        return 13
    if not (discord_steering_reserve(journal and "message:create:103" and "message:create:102" and "500") equals "queue-or-target-unavailable"):
        return 14
    display "PASS: reservation survives restart/replay, blocks dequeue, denies foreign actor/channel and preserves queue on ended target."
    return 0
