import "../../app/discord/queue_control_worker"
import "../../app/discord/background_store"
import "../../app/discord/steering_reconcile"

define auto_admit_fixture with journal as Int and identity as Str and room as Str and prompt as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":" and concat(provider_quote(prompt) and "}]}}"))))))
    set inbox to concat("interaction:" and identity)
    set saved to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and inbox) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [inbox]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_admission_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 1
    set response to concat("{\"id\":" and concat(provider_quote(concat("1" and identity)) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy request received.\",\"interaction_metadata\":{\"id\":" and concat(provider_quote(identity) and ",\"type\":2,\"user\":{\"id\":\"400\"}}}"))))))
    if not (discord_command_anchor_observe(journal and inbox and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 1
    return 0

define background_fixture_message with journal as Int and message as Str and user as Str and room as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(user) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public scheduler fixture.\"}"))))))
    set inbox to concat("message:create:" and message)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if discord_queue_control_schema(journal) is not equal to 0 or else discord_interaction_schema(journal) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else auto_admit_fixture(journal and "701" and "300" and "Keep the original task and accept a sound.") is not equal to 0:
        return 3
    set run to "discord-command:interaction:701"
    set admitted to discord_command_auto_admit(journal and database and "interaction:701" and "900" and ["200"] and ["400"])
    if not (archive_list_text(admitted and 0) equals "accepted") or else not (discord_background_reserve(journal and run and "interaction:701" and 1) equals "reserved"):
        return 4
    set state to agent_run_read(database and run)
    set session to archive_list_text(state and 0)
    set digest to file_digest(get_argument(3) and 65536)
    set size to int_to_string(get_list(digest and 2))
    set body to concat("{\"id\":\"101\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Listen to this update.\",\"attachments\":[{\"id\":\"501\",\"filename\":\"clip.wav\",\"content_type\":\"audio/wav\",\"size\":" and concat(size and "}]}"))
    set source to "message:create:101"
    if not (discord_inbox_record(journal and source and "MESSAGE_CREATE" and body) equals "recorded") or else not (discord_steering_reserve(journal and source and "interaction:701" and "400") equals "reserved"):
        return 5
    if not (discord_steering_apply(journal and database and source and run and "400") equals "steering-media-import-required"):
        return 6
    if web_attachment_register(database and "discord:400" and session and "discord-file:101:501" and get_argument(3) and "clip.wav" and "audio/wav") is not equal to 0:
        return 7
    # A receipt containing only text must not acknowledge media steering.
    set identity to concat("discord-steering:" and ep_sha256(source))
    set event to concat(run and concat(":guidance:" and identity))
    if web_guidance_request(database and "discord:400" and run and identity and "Listen to this update.") is not equal to 0:
        return 8
    if not (discord_steering_reconcile_accepted(journal and database and source and run) equals "guidance-media-proof-unavailable") or else not (discord_steering_apply(journal and database and source and run and "400") equals "guidance-not-accepted"):
        return 9
    # A different immutable source can succeed; the mismatched old event stays
    # intact for diagnosis, never silently upgraded or dispatched ordinarily.
    set body2 to concat("{\"id\":\"102\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"\",\"attachments\":[{\"id\":\"502\",\"filename\":\"second.wav\",\"content_type\":\"audio/wav\",\"size\":" and concat(size and "}]}"))
    set source2 to "message:create:102"
    set copy_path to concat(get_argument(3) and ".copy")
    if file_copy_verified(get_argument(3) and copy_path and archive_list_text(digest and 1) and string_to_int(size) and 65536) is not equal to 0:
        return 10
    if not (discord_inbox_record(journal and source2 and "MESSAGE_CREATE" and body2) equals "recorded") or else not (archive_list_text(discord_queue_offer(journal and source2) and 0) equals "offered") or else discord_queue_marker_eligible(journal and database and source2 and "steer" and "↪️") is not equal to 1 or else not (discord_queue_offer_reserve(journal and source2 and "400") equals "reserved") or else web_attachment_register(database and "discord:400" and session and "discord-file:102:502" and copy_path and "second.wav" and "audio/wav") is not equal to 0:
        return 11
    set selection to discord_steering_media_selection(database and session and body2)
    if not (archive_list_text(selection and 0) equals "selected") or else not (archive_list_text(discord_steering_media_selection(database and "wrong-session" and body2) and 0) equals "steering-media-import-required"):
        return 12
    set identity2 to concat("discord-steering:" and ep_sha256(source2))
    set event2 to concat(run and concat(":guidance:" and identity2))
    # Simulate the exact media archive commit followed by a process crash.
    if web_guidance_files_environment(database and "discord:400" and run and identity2 and "" and get_list(selection and 1) and "") is not equal to 0:
        return 13
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_steering_apply(journal and database and source2 and run and "400") equals "steered") or else not (discord_steering_apply(journal and database and source2 and run and "400") equals "already-steered"):
        return 14
    set content to agent_source_content(database and session and event2 and "Native media update")
    if string_index_of(content and "input_audio") < 0:
        return 15
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else not (discord_steering_reconcile_accepted(journal and database and source2 and run) equals "already-steered"):
        return 16
    if not (discord_steering_apply(journal and database and source2 and run and "400") equals "steering-binding-denied"):
        return 17
    set proof to turn_attachment_read(database and session and event2)
    if not (archive_list_text(proof and 0) equals "found") or else archive_verify(database and session) is not equal to 0:
        return 18
    display "PASS: exact Discord media imports, missing import denial, text-only receipt rejection, audio-only guidance, same-session binding, native audio reconstruction, archive-before-journal recovery, retry and revoked historical acknowledgement without new authority. No live transport claimed."
    return 0
