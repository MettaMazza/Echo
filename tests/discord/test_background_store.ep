import "../../app/discord/background_store"

define background_fixture_message with journal as Int and message as Str and user as Str and room as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(user) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public scheduler fixture.\"}"))))))
    set inbox to concat("message:create:" and message)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0 or else background_fixture_message(journal and "100" and "400" and "300") is not equal to 0:
        return 2
    set first to discord_worker_claim(journal)
    if not (archive_list_text(first and 0) equals "claimed") or else not (discord_background_reserve(journal and "parent" and "message:create:100" and 1) equals "conversation-busy"):
        return 3
    # Independent children may work while the parent conversation is active.
    if not (discord_background_reserve(journal and "child" and "message:create:100" and 0) equals "reserved") or else not (discord_worker_finish(journal and "message:create:100" and "enqueued") equals "recorded"):
        return 4
    if not (discord_background_reserve(journal and "parent" and "message:create:100" and 1) equals "reserved") or else not (discord_background_reserve(journal and "parent" and "message:create:100" and 1) equals "already-reserved"):
        return 5
    if background_fixture_message(journal and "101" and "400" and "300") is not equal to 0 or else background_fixture_message(journal and "102" and "401" and "300") is not equal to 0:
        return 6
    set second to discord_worker_claim(journal)
    if not (archive_list_text(second and 1) equals "message:create:102"):
        return 7
    if not (discord_worker_finish(journal and "message:create:102" and "enqueued") equals "recorded") or else not (archive_list_text(discord_worker_claim(journal) and 0) equals "end"):
        return 8
    if not (discord_background_transition(journal and "parent" and "reserved" and "running" and "worker-a" and 123 and "fixture launch") equals "recorded"):
        return 9
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (archive_list_text(discord_worker_claim(journal) and 0) equals "end"):
        return 10
    if not (discord_background_transition(journal and "parent" and "running" and "released" and "wrong-worker" and 0 and "stale completion") equals "worker-changed"):
        return 11
    if not (discord_background_transition(journal and "parent" and "running" and "recovery" and "worker-a" and 123 and "uncertain process") equals "recorded") or else not (archive_list_text(discord_worker_claim(journal) and 0) equals "end"):
        return 12
    if not (discord_background_transition(journal and "parent" and "recovery" and "released" and "worker-a" and 0 and "reconciled fixture") equals "recorded"):
        return 13
    set third to discord_worker_claim(journal)
    if not (archive_list_text(third and 1) equals "message:create:101"):
        return 14
    # A live foreground claim wins against a later canonical reservation.
    if not (discord_background_reserve(journal and "parent" and "message:create:100" and 1) equals "conversation-busy"):
        return 15
    display "PASS: atomic foreground/background ordering, independent child progress, other-user progress, durable recovery hold and stale-worker rejection."
    return 0
