import "../../app/discord/queue_marker_transport"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_queue_marker_schema(journal) is not equal to 0:
        return 2
    set index to 1
    repeat while index <= 12:
        set message to int_to_string(100 + index)
        set body to concat("{\"id\":" and concat(provider_quote(message) and ",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}"))
        set saved to discord_inbox_record(journal and concat("message:create:" and message) and "MESSAGE_CREATE" and body)
        set index to index + 1
    if discord_queue_position(journal and "message:create:112") is not equal to 12 or else not (discord_queue_position_glyph(12) equals "🔢"):
        return 3
    set claimed to discord_worker_claim(journal)
    if discord_queue_position(journal and "message:create:101") is not equal to 0 or else discord_queue_position(journal and "message:create:112") is not equal to 11:
        return 4
    if not (discord_queue_marker_desire(journal and "message:create:102" and "queue" and "1️⃣") equals "desired"):
        return 5
    set next to discord_queue_marker_next(journal and "message:create:102" and "queue")
    if not (archive_list_text(next and 0) equals "PUT") or else not (archive_list_text(next and 2) equals "1"):
        return 6
    set desired to discord_queue_marker_desire(journal and "message:create:102" and "queue" and "2️⃣")
    if not (discord_queue_marker_observed(journal and "message:create:102" and "queue" and "PUT" and "1️⃣" and "1") equals "observed"):
        return 7
    set next to discord_queue_marker_next(journal and "message:create:102" and "queue")
    if not (archive_list_text(next and 0) equals "DELETE") or else not (archive_list_text(next and 1) equals "1️⃣"):
        return 8
    if not (discord_queue_marker_observed(journal and "message:create:102" and "queue" and "DELETE" and "1️⃣" and "2") equals "observed"):
        return 9
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set next to discord_queue_marker_next(journal and "message:create:102" and "queue")
    if not (archive_list_text(next and 0) equals "PUT") or else not (archive_list_text(next and 1) equals "2️⃣"):
        return 10
    if not (discord_queue_marker_observed(journal and "message:create:102" and "queue" and "PUT" and "2️⃣" and "2") equals "observed"):
        return 11
    if not (discord_queue_marker_observed(journal and "message:create:102" and "queue" and "PUT" and "1️⃣" and "1") equals "marker-state-conflict"):
        return 12
    if not (archive_list_text(discord_queue_marker_next(journal and "message:create:102" and "queue") and 0) equals "settled"):
        return 13
    if not (discord_queue_marker_desire(journal and "message:create:102" and "queue" and "✅") equals "invalid-marker") or else not (discord_queue_marker_desire(journal and "message:create:102" and "confirm" and "1️⃣") equals "invalid-marker") or else not (discord_queue_marker_encoded("arbitrary:999") equals ""):
        return 14
    set desired to discord_queue_marker_desire(journal and "message:create:102" and "queue" and "")
    if not (archive_list_text(discord_queue_marker_next(journal and "message:create:102" and "queue") and 0) equals "DELETE"):
        return 15
    if discord_queue_marker_eligible(journal and 0 and "message:create:112" and "queue" and "🔢") is not equal to 1 or else discord_queue_marker_eligible(journal and 0 and "message:create:112" and "queue" and "1️⃣") is not equal to 0:
        return 16
    set desired to discord_queue_marker_desire(journal and "message:create:102" and "confirm" and "✅")
    if discord_queue_marker_eligible(journal and 0 and "message:create:102" and "confirm" and "✅") is not equal to 0:
        return 17
    display "PASS: uncapped queue rank, claim removal, marker slot allowlist, stale HTTP completion reconciliation, remove-before-replace and restart durability. HTTP and visible UI remain pending."
    return 0
