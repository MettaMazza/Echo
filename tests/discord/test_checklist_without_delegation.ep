import "../../app/discord/agent_bridge"
import "../../app/context/session_messages"
import "../../app/tools/scratchpad"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0:
        return 2
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Save a scoped note.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and ["400"])
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set absent to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM sqlite_master WHERE name='echo_delegations';"))
    if not (archive_list_text(absent and 1) equals "0"):
        return 5
    set schemas to session_tool_schemas_owned(database and "discord-message:100")
    if not string_contains(schemas and "\"name\":\"task_checklist\"") or else string_contains(schemas and "\"name\":\"delegate_task\""):
        return 6
    set checklist to "{\"items\":[{\"id\":\"note\",\"requirement\":\"Save the scoped note\",\"status\":\"pending\",\"evidence\":\"\"}]}"
    if not string_contains(task_checklist_save(database and "discord-message:100" and "plan" and checklist) and "\"status\":\"saved\""):
        return 7
    set written to scratchpad_execute(database and "discord-message:100" and "{\"operation\":\"write\",\"name\":\"public-fixture\",\"text\":\"A public continuity observation.\",\"previous_revision\":\"\"}")
    if not string_contains(written and "\"status\":\"saved\""):
        return 8
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    set read to scratchpad_execute(database and "discord-message:100" and "{\"operation\":\"read\",\"name\":\"public-fixture\"}")
    if not string_contains(read and "A public continuity observation.") or else not (task_checklist_state(database and "discord-message:100") equals "pending"):
        return 9
    if archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0:
        return 10
    display "PASS: Discord admin checklist advertised without delegation, scoped note saved and recovered after reopen."
    return 0
