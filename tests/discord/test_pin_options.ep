import "../../app/discord/pin_options"

external define ep_gc_get_minor_count returning Int

define main returning Int:
    for each body in ["{\"operation\":\"list\"}","{\"operation\":\"list\",\"limit\":50,\"before\":\"2026-10-22T00:00:00.000+00:00\"}","{\"operation\":\"status\",\"message\":\"123\"}","{\"operation\":\"pin\",\"message\":\"123\",\"reason\":\"Requested test\"}","{\"operation\":\"unpin\",\"message\":\"123\",\"reason\":\"Restore prior state\"}"]:
        if not (archive_list_text(discord_pin_options(ptr_to_str(body)) and 0) equals "valid"):
            return 1
    for each body in ["{}","{\"operation\":\"list\",\"channel\":\"123\"}","{\"operation\":\"list\",\"limit\":51}","{\"operation\":\"list\",\"limit\":0}","{\"operation\":\"list\",\"limit\":1.5}","{\"operation\":\"pin\",\"message\":\"123\"}","{\"operation\":\"pin\",\"message\":\"../123\",\"reason\":\"x\"}","{\"operation\":\"status\",\"message\":\"123\",\"reason\":\"x\"}","{\"operation\":\"list\",\"message\":\"123\"}","{\"operation\":\"pin\",\"message\":\"123\",\"reason\":\" \"}"]:
        if archive_list_text(discord_pin_options(ptr_to_str(body)) and 0) equals "valid":
            display ptr_to_str(body)
            return 2
    set encoded to discord_pin_options("{\"operation\":\"list\",\"before\":\"a&channel=9\"}")
    if string_contains(archive_list_text(encoded and 2) and "a%26channel%3D9") equals 0:
        return 3
    set page to "{\"items\":[{\"pinned_at\":\"2026-10-22T00:00:00Z\",\"message\":{\"id\":\"123\",\"channel_id\":\"300\",\"author\":{\"id\":\"400\",\"username\":\"person\",\"email\":\"private\"},\"content\":\"untrusted pin\",\"timestamp\":\"time\",\"referenced_message\":{\"content\":\"exclude\"}}}],\"has_more\":true}"
    set projected to discord_pin_page(page and "300")
    if string_length(projected) equals 0 or else string_contains(projected and "private") is not equal to 0 or else string_contains(projected and "exclude") is not equal to 0 or else string_contains(projected and "next_before") equals 0:
        return 4
    if string_length(discord_pin_page(page and "999")) is not equal to 0 or else string_length(discord_pin_page("{\"items\":[],\"has_more\":true}" and "300")) is not equal to 0:
        return 5
    if not (discord_pin_page("{\"items\":[],\"has_more\":false}" and "300") equals "{\"items\":[],\"has_more\":false,\"next_before\":\"\"}"):
        return 6
    set before to ep_gc_get_minor_count()
    set iterations to 0
    repeat while ep_gc_get_minor_count() equals before and iterations < 2000:
        set projected to discord_pin_page(page and "300")
        if string_length(projected) equals 0 or else string_contains(projected and "untrusted pin") equals 0:
            return 7
        set iterations to iterations + 1
    if ep_gc_get_minor_count() equals before:
        return 8
    display "PASS: strict pin options, URI-safe timestamp cursor, current-channel projection and exhausted-page semantics."
    return 0
