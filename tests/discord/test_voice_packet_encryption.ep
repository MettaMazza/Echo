import "../../app/discord/voice_packet_encryption"

define fixture_voice_decrypt with library as Int and packet as List and expected_nonce as Int and key as Int and original as Int returning Int:
    if packet equals 0 or else get_list(packet and 1) is not equal to 39:
        return 0
    set pointer to get_list(packet and 0)
    if discord_voice_u32(pointer and 35) is not equal to expected_nonce or else peek_byte(pointer and 0) is not equal to 128 or else peek_byte(pointer and 1) is not equal to 120:
        return 0
    set nonce to research_native_words(3)
    set written to discord_voice_put_u32(get_list_data_ptr(nonce) and 0 and expected_nonce)
    set size to research_native_words(1)
    set output to alloc_bytes(7)
    set status to ep_dlcall9(ep_dlsym(library and "crypto_aead_xchacha20poly1305_ietf_decrypt") and output and get_list_data_ptr(size) and 0 and pointer + 12 and 23 and pointer and 12 and get_list_data_ptr(nonce) and key)
    set valid to status equals 0 and also get_list(size and 0) equals 7
    set index to 0
    repeat while index < 7:
        if peek_byte(output and index) is not equal to peek_byte(original and index):
            set valid to 0
        set index to index + 1
    free_bytes(output)
    return valid

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 90
    set key to research_native_words(4)
    set expected_key to research_native_words(4)
    set frame to research_native_words(1)
    set written to poke_byte(get_list_data_ptr(frame) and 1 and 255)
    set state to discord_voice_crypto_open(get_argument(1) and get_list_data_ptr(key) and 32)
    if state equals 0:
        return 1
    set written to poke_byte(get_list_data_ptr(key) and 0 and 1)
    set header to discord_voice_rtp_header(5 and 960 and 16909060)
    set first to discord_voice_crypto_packet(state and header and get_list_data_ptr(frame) and 7)
    set second to discord_voice_crypto_packet(state and header and get_list_data_ptr(frame) and 7)
    if fixture_voice_decrypt(get_list(state and 0) and first and 0 and get_list_data_ptr(expected_key) and get_list_data_ptr(frame)) equals 0 or else fixture_voice_decrypt(get_list(state and 0) and second and 1 and get_list_data_ptr(expected_key) and get_list_data_ptr(frame)) equals 0:
        return 2
    set clear to discord_voice_crypto_unwrap(state and get_list(first and 0) and get_list(first and 1) and 12)
    if clear equals 0 or else get_list(clear and 1) is not equal to 7 or else get_list(state and 2) is not equal to 2:
        return 8
    set index to 0
    repeat while index < 7:
        if peek_byte(get_list(clear and 0) and index) is not equal to peek_byte(get_list_data_ptr(frame) and index):
            return 9
        set index to index + 1
    set released to discord_voice_blob_release(clear)
    set offsets to create_list()
    set offsets to [0,12,34,38]
    for each offset in offsets:
        set original to peek_byte(get_list(first and 0) and offset)
        set changed to poke_byte(get_list(first and 0) and offset and (original + 1) % 256)
        if discord_voice_crypto_unwrap(state and get_list(first and 0) and 39 and 12) is not equal to 0:
            return 10
        set changed to poke_byte(get_list(first and 0) and offset and original)
    if discord_voice_crypto_unwrap(state and get_list(first and 0) and 38 and 12) is not equal to 0 or else discord_voice_crypto_unwrap(state and get_list(first and 0) and 39 and 13) is not equal to 0 or else discord_voice_crypto_unwrap(state and get_list(first and 0) and 32 and 12) is not equal to 0:
        return 11
    # Extended clear header, encrypted extension data retained for RTP parser.
    set extended to alloc_bytes(43)
    set index to 0
    repeat while index < 16:
        set changed to poke_byte(extended and index and index)
        set index to index + 1
    set nonce to research_native_words(3)
    set written_size to research_native_words(1)
    set encrypted to ep_dlcall9(ep_dlsym(get_list(state and 0) and "crypto_aead_xchacha20poly1305_ietf_encrypt") and extended + 16 and get_list_data_ptr(written_size) and get_list_data_ptr(frame) and 7 and extended and 16 and 0 and get_list_data_ptr(nonce) and get_list(state and 1))
    set changed to discord_voice_put_u32(extended and 39 and 0)
    if encrypted is not equal to 0:
        return 12
    set clear to discord_voice_crypto_unwrap(state and extended and 43 and 16)
    if clear equals 0 or else get_list(clear and 1) is not equal to 7 or else peek_byte(get_list(clear and 0) and 1) is not equal to 255:
        return 13
    set released to discord_voice_blob_release(clear)
    set wrong_state to discord_voice_crypto_open(get_argument(1) and get_list_data_ptr(key) and 32)
    if discord_voice_crypto_unwrap(wrong_state and extended and 43 and 16) is not equal to 0:
        return 14
    set closed to discord_voice_crypto_close(wrong_state)
    if discord_voice_crypto_unwrap(wrong_state and extended and 43 and 16) is not equal to 0:
        return 15
    free_bytes(extended)
    set released to discord_voice_blob_release(first)
    set released to discord_voice_blob_release(second)
    set changed to set_list(state and 2 and 4294967295)
    set final to discord_voice_crypto_packet(state and header and get_list_data_ptr(frame) and 7)
    if fixture_voice_decrypt(get_list(state and 0) and final and 4294967295 and get_list_data_ptr(expected_key) and get_list_data_ptr(frame)) equals 0:
        return 3
    if get_list(state and 2) is not equal to 4294967296 or else discord_voice_crypto_packet(state and header and get_list_data_ptr(frame) and 7) is not equal to 0:
        return 4
    set released to discord_voice_blob_release(final)
    if discord_voice_crypto_packet(state and header and get_list_data_ptr(frame) and 65476) is not equal to 0:
        return 5
    if discord_voice_crypto_close(state) equals 0 or else discord_voice_crypto_close(state) equals 0:
        return 6
    if discord_voice_crypto_packet(state and header and get_list_data_ptr(frame) and 7) is not equal to 0:
        return 7
    set released to discord_voice_blob_release(header)
    display "PASS: native rtpsize encrypt/decrypt, extended clear headers, binary payload/key copy, tamper/wrong-key/truncation rejection, independent outbound nonce exhaustion and repeat-safe key cleanup."
    return 0
