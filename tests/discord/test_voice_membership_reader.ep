import "../../app/discord/gateway_intake"
import "../../app/discord/voice_membership_reader"

define fixture_dispatch with database as Int and sequence as Int and kind as Str and data as Str returning Str:
    set body to concat("{\"op\":0,\"s\":" and concat(int_to_string(sequence) and concat(",\"t\":" and concat(provider_quote(kind) and concat(",\"d\":" and concat(data and "}"))))))
    set guilds to create_list()
    set guilds to ["100"]
    set admins to create_list()
    return discord_gateway_intake(database and "connection-a" and "300" and guilds and admins and body)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 90
    set database to discord_store_open(get_argument(1) and "300")
    if database equals 0 or else discord_gateway_runtime_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "connection-a" and "gateway-session")
    set result to discord_voice_membership_read(database and "connection-a" and "gateway-session" and 1 and "100" and "200" and "300")
    if not (archive_list_text(result and 0) equals "await-voice-membership-baseline"):
        return 2
    set snapshot to "{\"id\":\"100\",\"roles\":[],\"voice_states\":[{\"user_id\":\"400\",\"channel_id\":\"200\",\"session_id\":\"guest\"}]}"
    if not (fixture_dispatch(database and 1 and "GUILD_CREATE" and snapshot) equals "recorded"):
        return 3
    set result to discord_voice_membership_read(database and "connection-a" and "gateway-session" and 1 and "100" and "200" and "300")
    if not (archive_list_text(result and 0) equals "await-bot-voice-state"):
        return 4
    set joined to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"bot\"}"
    if not (fixture_dispatch(database and 2 and "VOICE_STATE_UPDATE" and joined) equals "recorded"):
        return 5
    set result to discord_voice_membership_read(database and "connection-a" and "gateway-session" and 1 and "100" and "200" and "300")
    if not (archive_list_text(result and 0) equals "voice-membership-ready") or else get_list(result and 2) is not equal to 2:
        return 6
    set membership to get_list(result and 1)
    if length_list(discord_voice_membership_roster(membership and 1)) is not equal to 2:
        return 7
    set result to discord_voice_membership_read(database and "old-connection" and "gateway-session" and 1 and "100" and "200" and "300")
    if not (archive_list_text(result and 0) equals "stale-voice-membership-binding"):
        return 8
    set leave to "{\"guild_id\":\"100\",\"user_id\":\"400\",\"channel_id\":null}"
    set recorded to fixture_dispatch(database and 3 and "VOICE_STATE_UPDATE" and leave)
    set result to discord_voice_membership_read(database and "connection-a" and "gateway-session" and 2 and "100" and "200" and "300")
    if not (archive_list_text(result and 0) equals "voice-membership-ready") or else length_list(discord_voice_membership_roster(get_list(result and 1) and 2)) is not equal to 1 or else length_list(discord_voice_membership_roster(membership and 1)) is not equal to 2:
        return 9
    set closed to sql_close(database)
    set database to discord_store_open(get_argument(1) and "300")
    set restarted to discord_voice_membership_read(database and "connection-a" and "gateway-session" and 3 and "100" and "200" and "300")
    if not (archive_list_text(restarted and 0) equals "voice-membership-ready") or else length_list(discord_voice_membership_roster(get_list(restarted and 1) and 3)) is not equal to 1:
        return 11
    set recorded to fixture_dispatch(database and 4 and "VOICE_STATE_UPDATE" and "{\"guild_id\":\"100\",\"user_id\":\"400\"}")
    set result to discord_voice_membership_read(database and "connection-a" and "gateway-session" and 2 and "100" and "200" and "300")
    if not (archive_list_text(result and 0) equals "voice-membership-invalidated"):
        return 10
    set closed to sql_close(database)
    display "PASS: voice worker rebuilds membership through atomic private journal snapshot/replay; absent bot, stale binding and invalidation block usable roster."
    return 0
