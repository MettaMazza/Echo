import "../../app/discord/gateway_journal"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_gateway_schema(database) is not equal to 0:
        return 2
    if not (discord_gateway_bind(database and "connection-a" and "session-a") equals "bound"):
        return 3
    set payload_1 to "{\"guild_id\":\"100\",\"role_id\":\"200\",\"permissions\":\"0\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 1 and "GUILD_ROLE_CREATE" and ep_sha256(payload_1) and "audience:1" and payload_1) equals "recorded"):
        return 11
    set row_1 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='role-metadata:audience:1';"))
    if not (archive_list_text(row_1 and 1) equals "1"):
        return 31
    set payload_2 to "{\"guild_id\":\"100\",\"role_id\":\"200\",\"permissions\":\"0\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 2 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_2) and "audience:2" and payload_2) equals "recorded"):
        return 12
    set row_2 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='role-metadata:audience:2';"))
    if not (archive_list_text(row_2 and 1) equals "1"):
        return 32
    set payload_3 to "{\"guild_id\":\"100\",\"role_id\":\"200\",\"permissions\":\"1024\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 3 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_3) and "audience:3" and payload_3) equals "recorded"):
        return 13
    set row_3 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='audience:3';"))
    if not (archive_list_text(row_3 and 1) equals "1"):
        return 33
    set payload_4 to "{\"guild_id\":\"100\",\"role_id\":\"200\",\"permissions\":\"1024\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 4 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_4) and "audience:4" and payload_4) equals "recorded"):
        return 14
    set row_4 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='role-metadata:audience:4';"))
    if not (archive_list_text(row_4 and 1) equals "1"):
        return 34
    set payload_5 to "{\"guild_id\":\"100\",\"role_id\":\"200\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 5 and "GUILD_ROLE_DELETE" and ep_sha256(payload_5) and "audience:5" and payload_5) equals "recorded"):
        return 15
    set row_5 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='audience:5';"))
    if not (archive_list_text(row_5 and 1) equals "1"):
        return 35
    set payload_6 to "{\"guild_id\":\"100\",\"role_id\":\"200\",\"permissions\":\"1024\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 6 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_6) and "audience:6" and payload_6) equals "recorded"):
        return 16
    set row_6 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='audience:6';"))
    if not (archive_list_text(row_6 and 1) equals "1"):
        return 36
    set payload_7 to "{\"guild_id\":\"100\",\"role_id\":\"200\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 7 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_7) and "audience:7" and payload_7) equals "recorded"):
        return 17
    set row_7 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='audience:7';"))
    if not (archive_list_text(row_7 and 1) equals "1"):
        return 37
    set payload_8 to "{\"guild_id\":\"100\",\"role_id\":\"200\",\"permissions\":\"1024\"}"
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 8 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_8) and "audience:8" and payload_8) equals "recorded"):
        return 18
    set row_8 to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='audience:8';"))
    if not (archive_list_text(row_8 and 1) equals "1"):
        return 38
    # Exact replay must leave both the original barrier and observation intact.
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 3 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_3) and "audience:3" and payload_3) equals "already-recorded"):
        return 50
    # An identity collision rolls back the tentative permission observation.
    if not (discord_gateway_dispatch(database and "connection-a" and "session-a" and 9 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_1) and "audience:3" and payload_1) equals "identity-conflict"):
        return 51
    set rollback to history_collect_one(archive_prepare(database and "SELECT permissions FROM discord_gateway_role_permissions WHERE session='session-a' AND guild='100' AND role='200';"))
    if not (archive_list_text(rollback and 1) equals "1024"):
        return 52
    if not (discord_gateway_bind(database and "connection-b" and "session-b") equals "bound"):
        return 53
    if not (discord_gateway_dispatch(database and "connection-b" and "session-b" and 1 and "GUILD_ROLE_UPDATE" and ep_sha256(payload_3) and "audience:new-session" and payload_3) equals "recorded"):
        return 54
    set fresh to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM discord_inbox WHERE identity='audience:new-session';"))
    if not (archive_list_text(fresh and 1) equals "1"):
        return 55
    set closed to sql_close(database)
    display "PASS: zero-role create and unchanged mask metadata; permission changes, deletion, unknown and malformed updates retain barriers; replay, rollback and new-session isolation."
    return 0
