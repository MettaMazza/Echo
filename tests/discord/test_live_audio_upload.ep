import "../../app/discord/rest"
import "../../app/discord/multipart_audio"
import "string"
import "fs"

# Explicit live transport qualification in the authorised test channel only.
# No model invocation, personal recording or audition reference. The supplied
# file must be the generated test reply and match its recorded digest/length.
define main returning Int:
    if get_argument_count() is not equal to 9:
        return 1
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and get_argument(7))
    if directory < 0:
        return 3
    set output to workspace_file_open(system and directory and "bot.json" and 1)
    set headers to workspace_file_open(system and directory and "bot.headers" and 1)
    set token to string_trim(ptr_to_str(credential))
    set result to discord_rest_transfer(get_argument(1) and token and "GET" and "/users/@me" and "" and output and headers)
    if not (archive_list_text(result and 0) equals "complete") or else not (archive_list_text(result and 1) equals "200"):
        return 4
    set bot to provider_json_tokens(ptr_to_str(read_file(concat(get_argument(7) and "/bot.json"))))
    if not (provider_value(bot and provider_member(bot and 0 and "id")) equals get_argument(8)):
        return 5
    if discord_snowflake(get_argument(6)) equals 0:
        return 6
    set payload to "{\"content\":\"Echo Speak transport qualification — generated Warm test reply.\",\"attachments\":[{\"id\":0,\"filename\":\"Echo-reply.wav\"}],\"allowed_mentions\":{\"parse\":[]}}"
    set multipart to discord_audio_multipart(get_argument(3) and get_argument(4) and string_to_int(get_argument(5)) and 10485760 and payload)
    if not (archive_list_text(multipart and 0) equals "multipart-ready"):
        display archive_list_text(multipart and 0)
        return 7
    # Exclusive output creation prevents accidentally replaying this test in
    # the same evidence directory after an uncertain upload.
    set output to workspace_file_open(system and directory and "upload.json" and 1)
    set headers to workspace_file_open(system and directory and "upload.headers" and 1)
    if output < 0 or else headers < 0:
        set released to discord_audio_multipart_release(multipart)
        return 8
    set result to discord_rest_transfer_bytes(get_argument(1) and token and "POST" and concat("/channels/" and concat(get_argument(6) and "/messages")) and get_list(multipart and 1) and get_list(multipart and 2) and archive_list_text(multipart and 3) and output and headers and 20000 and 60000)
    set released to discord_audio_multipart_release(multipart)
    if not (archive_list_text(result and 0) equals "complete") or else not (archive_list_text(result and 1) equals "200"):
        display archive_list_text(result and 0)
        display archive_list_text(result and 1)
        return 9
    set saved to provider_json_tokens(ptr_to_str(read_file(concat(get_argument(7) and "/upload.json"))))
    if not (provider_value(saved and provider_member(saved and 0 and "channel_id")) equals get_argument(6)):
        return 10
    set files to provider_items(saved and provider_member(saved and 0 and "attachments"))
    if length_list(files) is not equal to 1:
        return 11
    set item to get_list(files and 0)
    if not (provider_value(saved and provider_member(saved and item and "size")) equals get_argument(5)) or else not (provider_value(saved and provider_member(saved and item and "filename")) equals "Echo-reply.wav"):
        return 12
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    display "PASS: native binary Warm test audio uploaded to authorised channel; response attachment filename and byte count match"
    return 0
