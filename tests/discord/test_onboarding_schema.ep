import "../../app/tools/discord_onboarding_schema"
import "../../app/providers/json_access"

# Regression: a required title omitted from a closed properties object makes
# every prompt impossible to submit, despite the native validator accepting it.
define main returning Int:
    set schema to discord_onboarding_schema()
    set fields to provider_json_tokens(schema)
    set function to provider_member(fields and 0 and "function")
    set parameters to provider_member(fields and function and "parameters")
    set properties to provider_member(fields and parameters and "properties")
    set changes to provider_member(fields and properties and "changes")
    if not (provider_value(fields and provider_member(fields and changes and "type")) equals "string"):
        return 4
    set shape to provider_member(fields and changes and "contentSchema")
    set properties to provider_member(fields and shape and "properties")
    set prompts to provider_member(fields and properties and "prompts")
    set prompt to provider_member(fields and prompts and "items")
    set properties to provider_member(fields and prompt and "properties")
    set title to provider_member(fields and properties and "title")
    if not (provider_value(fields and provider_member(fields and title and "type")) equals "string") or else not (provider_value(fields and provider_member(fields and title and "maxLength")) equals "100"):
        return 1
    set options to provider_member(fields and properties and "options")
    set option to provider_member(fields and options and "items")
    set properties to provider_member(fields and option and "properties")
    set title to provider_member(fields and properties and "title")
    if not (provider_value(fields and provider_member(fields and title and "type")) equals "string") or else not (provider_value(fields and provider_member(fields and title and "maxLength")) equals "50"):
        return 2
    set description to provider_member(fields and properties and "description")
    if not (provider_value(fields and provider_member(fields and description and "maxLength")) equals "100"):
        return 3
    display schema
    return 0
