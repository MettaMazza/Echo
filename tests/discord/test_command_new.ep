import "../../app/discord/command_execution"
import "../../app/context/session_messages"

define new_command_fixture with journal as Int and id as Str and state as Str returning Str:
    set body to concat("{\"id\":" and concat(provider_quote(id) and ",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"800\",\"name\":\"new\"}}"))
    set identity to concat("interaction:" and id)
    if not (discord_inbox_record(journal and identity and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    set values to create_list()
    set added to append_list(values and identity)
    set added to append_list(values and state)
    set added to append_list(values and int_to_string(ep_time_now_ms()))
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,?2,CAST(?3 AS INTEGER),'fixture');" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_command_credential_1234','fixture',CAST(?3 AS INTEGER),CAST(?3 AS INTEGER)+900000);" and values) and 101) is not equal to 0:
        return ""
    return body

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"800\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"new\"}" and "900" and "200") equals "registered"):
        return 3
    set guilds to ["200"]
    set admins to create_list()
    set device to discord_agent_principal(database and "400" and admins)
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "before" and "BEFORE_NEW_MARKER" and create_list())
    if not (archive_list_text(first and 0) equals "accepted"):
        return 4
    set pending to new_command_fixture(journal and "700" and "pending")
    if not (discord_command_new_apply(journal and database and "interaction:700" and pending and "900" and guilds and admins) equals "command-not-acknowledged"):
        return 5
    set body to new_command_fixture(journal and "701" and "acknowledged")
    if not (discord_command_new_apply(journal and database and "interaction:701" and pending and "900" and guilds and admins) equals "command-not-acknowledged"):
        return 6
    if not (discord_command_new_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals "new-session-created"):
        return 7
    set after to channel_silo_submit(database and device and "discord" and "200" and "300" and "after" and "AFTER_NEW_MARKER" and create_list())
    if not (archive_list_text(after and 0) equals "accepted") or else archive_list_text(after and 1) equals archive_list_text(first and 1):
        return 8
    set context to session_messages(database and archive_list_text(after and 1) and "after")
    if string_index_of(context and "BEFORE_NEW_MARKER") >= 0 or else string_index_of(context and "AFTER_NEW_MARKER") < 0:
        return 9
    # Finish the fixture turn through the real state machine before submitting
    # a follow-up. These archived events are explicitly synthetic, not inference.
    set session to archive_list_text(after and 1)
    if archive_append(database and session and "after:fixture-request" and "model_request" and "{\"run_id\":\"after\",\"parent_event\":\"after:user\",\"fixture\":true}" and "fixture") is not equal to 0 or else agent_run_transition(database and "after" and "ready" and "after:user" and "generating" and "after:fixture-request") is not equal to 0:
        return 15
    if archive_append(database and session and "after:fixture-final" and "assistant_final" and "{\"run_id\":\"after\",\"parent_event\":\"after:fixture-request\",\"fixture\":true,\"content\":\"Fixture completion.\"}" and "fixture") is not equal to 0 or else agent_run_transition(database and "after" and "generating" and "after:fixture-request" and "completed" and "after:fixture-final") is not equal to 0:
        return 16
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    if not (discord_command_new_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals "new-session-created"):
        return 10
    set again to channel_silo_submit(database and device and "discord" and "200" and "300" and "again" and "FOLLOW_UP_MARKER" and create_list())
    if not (archive_list_text(again and 0) equals "accepted") or else not (archive_list_text(again and 1) equals archive_list_text(after and 1)):
        return 11
    set empty to create_list()
    if not (discord_command_new_apply(journal and database and "interaction:701" and body and "900" and empty and admins) equals "command-scope-denied"):
        return 12
    if sql_execute(journal and "UPDATE discord_interaction_credentials SET expires_ms=0 WHERE identity='interaction:701';") is not equal to 0 or else not (discord_command_new_apply(journal and database and "interaction:701" and body and "900" and guilds and admins) equals "command-not-acknowledged"):
        return 13
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_group_session_choices;"))
    if not (archive_list_text(count and 1) equals "1"):
        return 14
    display "PASS: acknowledged exact intake only, ordinary-user new, next-turn fresh context, restart/replay without duplicate switch, current guild restriction and expired response denial"
    return 0
