import "../../app/discord/post_crosspost"
import "../../app/discord/post_options"

define main returning Int:
    set room_snapshot to "{\"id\":\"500\",\"guild_id\":\"600\",\"type\":5}"
    set body to "{\"id\":\"700\",\"channel_id\":\"500\",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"fixture\"}"
    set digest to ep_sha256(body)
    if not (discord_crosspost_guard(room_snapshot and body and "600" and "500" and "700" and "900" and digest) equals "ready"):
        return 1
    if not (discord_crosspost_guard("{\"id\":\"500\",\"guild_id\":\"600\",\"type\":0}" and body and "600" and "500" and "700" and "900" and digest) equals "announcement-channel-required"):
        return 2
    if discord_crosspost_guard(room_snapshot and body and "601" and "500" and "700" and "900" and digest) equals "ready":
        return 3
    if discord_crosspost_guard(room_snapshot and body and "600" and "500" and "700" and "901" and digest) equals "ready":
        return 4
    if discord_crosspost_guard(room_snapshot and body and "600" and "500" and "701" and "900" and digest) equals "ready":
        return 5
    if discord_crosspost_guard(room_snapshot and body and "600" and "500" and "700" and "900" and ep_sha256("changed")) equals "ready":
        return 6
    set published to "{\"id\":\"700\",\"channel_id\":\"500\",\"author\":{\"id\":\"900\"},\"flags\":1,\"content\":\"fixture\"}"
    if not (discord_crosspost_guard(room_snapshot and published and "600" and "500" and "700" and "900" and digest) equals "already-published"):
        return 7
    set options to discord_post_options("{\"operation\":\"crosspost\",\"post\":\"tool-post:fixture\"}")
    if archive_list_text(options and 0) equals "valid":
        return 8
    set arguments to concat("{\"operation\":\"crosspost\",\"post\":\"tool-post:fixture\",\"expected_sha256\":" and concat(provider_quote(digest) and "}"))
    set options to discord_post_options(arguments)
    if not (archive_list_text(options and 0) equals "valid") or else not (archive_list_text(options and 7) equals digest):
        return 9
    set options to discord_post_options(concat("{\"operation\":\"status\",\"post\":\"p\",\"expected_sha256\":" and concat(provider_quote(digest) and "}")))
    if archive_list_text(options and 0) equals "valid":
        return 10
    display "PASS: explicit publication options; announcement-only identity, unchanged message and already-published guards"
    return 0
