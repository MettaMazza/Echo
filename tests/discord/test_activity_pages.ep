import "../../app/discord/activity_delivery"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set recap_page to "{\"status\":\"found\",\"entries\":[{\"kind\":\"compaction\",\"text\":\"Original messages remain saved.\"}]}"
    if not (discord_activity_render(recap_page and 1) equals "**Conversation recap**\nOriginal messages remain saved."):
        return 14
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\"}") equals "recorded"):
        return 2
    set page to "{\"status\":\"found\",\"after\":8,\"more\":false,\"entries\":[{\"kind\":\"model_reasoning\",\"text\":\"PRIVATE_REASONING_CANARY\"},{\"kind\":\"tool_result\",\"text\":\"PRIVATE_TOOL_CANARY\"},{\"kind\":\"assistant_final\",\"text\":\"Reply completed and archived.\"}]}"
    set public_text to discord_activity_render(page and 0)
    set private_text to discord_activity_render(page and 1)
    if string_index_of(public_text and "PRIVATE_") >= 0 or else string_index_of(private_text and "PRIVATE_REASONING_CANARY") < 0 or else string_index_of(private_text and "PRIVATE_TOOL_CANARY") < 0:
        return 3
    set spaced to "{\"status\":\"found\",\"entries\":[{\"kind\":\"model_reasoning\",\"text\":\" lead \"},{\"kind\":\"model_reasoning\",\"text\":\"tail \"}]}"
    if not (discord_activity_render(spaced and 1) equals "**Thinking**\n lead tail ") or else string_length(discord_activity_render(spaced and 0)) is not equal to 0:
        return 13
    set identity to discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "100" and 0 and page and 0)
    if string_index_of(identity and "activity-page:") is not equal to 0 or else not (discord_activity_page_enqueue(journal and identity) equals "queued"):
        return 4
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "100" and 0 and page and 0) equals identity) or else not (discord_activity_page_enqueue(journal and identity) equals "queued"):
        return 5
    set changed to "{\"status\":\"found\",\"after\":9,\"entries\":[{\"kind\":\"tool_result\",\"text\":\"changed\"}]}"
    if not (discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "100" and 0 and changed and 0) equals "page-conflict"):
        return 6
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*),MIN(channel),MIN(json_array_length(body,'$.allowed_mentions.parse')) FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "1") or else not (archive_list_text(row and 2) equals "100") or else not (archive_list_text(row and 3) equals "0"):
        return 7
    set second to discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "100" and 8 and changed and 0)
    if second equals identity or else not (discord_activity_page_enqueue(journal and second) equals "queued"):
        return 8
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "2"):
        return 9
    if not (discord_activity_plan(journal and "message:create:100") equals "planned") or else not (discord_activity_observe(journal and "message:create:100" and "{\"id\":\"100\",\"parent_id\":\"300\",\"guild_id\":\"200\",\"owner_id\":\"900\",\"type\":11}") equals "ready"):
        return 10
    set restricted to discord_activity_page_plan(journal and "message:create:100" and "discord-message:100" and "999" and 0 and page and 1)
    if not (discord_activity_page_enqueue(journal and restricted) equals "queued"):
        return 11
    set admins to create_list()
    # Detail level never authorizes an unrelated destination. Reject before
    # reaching network or archive access, even with a real source thread.
    if not (discord_activity_deliver("" and "" and journal and 0 and concat(restricted and ":0") and "900" and admins and "/nonexistent" and "/nonexistent") equals "activity-requires-attached-thread"):
        return 12
    display "PASS: immutable persistent activity pages, replay idempotence, distinct later updates, privileged content withheld from public status, mentions disabled"
    return 0
