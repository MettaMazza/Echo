import "../../app/discord/turn_guard"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[],\"flags\":0,\"nonce\":\"123\"}"
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original)
    set update to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:thread" and "MESSAGE_UPDATE" and update)
    if discord_turn_barrier(journal and 1 and "100" and "300" and "200") is not equal to 0:
        return 2
    set changed to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Edited\",\"attachments\":[],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:edit" and "MESSAGE_UPDATE" and changed)
    if discord_turn_barrier(journal and 2 and "100" and "300" and "200") is not equal to 1:
        return 3
    set recorded to discord_inbox_record(journal and "revision:partial" and "MESSAGE_UPDATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"flags\":32}")
    if discord_turn_barrier(journal and 3 and "100" and "300" and "200") is not equal to 1:
        return 4
    set changed to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[{\"id\":\"700\"}],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:attachment" and "MESSAGE_UPDATE" and changed)
    if discord_turn_barrier(journal and 4 and "100" and "300" and "200") is not equal to 1:
        return 5
    set recorded to discord_inbox_record(journal and "revision:delete" and "MESSAGE_DELETE" and "{\"id\":\"100\",\"channel_id\":\"300\"}")
    if discord_turn_barrier(journal and 5 and "100" and "300" and "200") is not equal to 1:
        return 6
    display "PASS: thread metadata alone preserves inference; edits, partial updates, attachment changes and deletion cancel"
    return 0
