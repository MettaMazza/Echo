import "../../app/discord/turn_guard"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set original to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[],\"flags\":0,\"nonce\":\"123\"}"
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and original)
    set update to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:thread" and "MESSAGE_UPDATE" and update)
    if discord_turn_barrier(journal and 1 and "100" and "300" and "200") is not equal to 0:
        return 2
    set changed to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Edited\",\"attachments\":[],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:edit" and "MESSAGE_UPDATE" and changed)
    if discord_turn_barrier(journal and 2 and "100" and "300" and "200") is not equal to 1:
        return 3
    set recorded to discord_inbox_record(journal and "revision:partial" and "MESSAGE_UPDATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"flags\":32}")
    if discord_turn_barrier(journal and 3 and "100" and "300" and "200") is not equal to 1:
        return 4
    set changed to "{\"id\":\"100\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Hello\",\"attachments\":[{\"id\":\"700\"}],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:attachment" and "MESSAGE_UPDATE" and changed)
    if discord_turn_barrier(journal and 4 and "100" and "300" and "200") is not equal to 1:
        return 5
    set recorded to discord_inbox_record(journal and "revision:delete" and "MESSAGE_DELETE" and "{\"id\":\"100\",\"channel_id\":\"300\"}")
    if discord_turn_barrier(journal and 5 and "100" and "300" and "200") is not equal to 1:
        return 6
    set original_reply to "{\"id\":\"101\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Reply\",\"attachments\":[],\"flags\":0,\"message_reference\":{\"message_id\":\"99\"},\"referenced_message\":{\"id\":\"99\",\"content\":\"Quoted\"}}"
    set recorded to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and original_reply)
    set update_reply to "{\"id\":\"101\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"content\":\"Reply\",\"attachments\":[],\"flags\":32,\"message_reference\":{\"message_id\":\"99\"}}"
    set recorded to discord_inbox_record(journal and "revision:reply-thread" and "MESSAGE_UPDATE" and update_reply)
    if discord_turn_barrier(journal and 7 and "101" and "300" and "200") is not equal to 0:
        return 7
    set changed to string_replace(update_reply and "\"99\"" and "\"98\"")
    set recorded to discord_inbox_record(journal and "revision:reply-target" and "MESSAGE_UPDATE" and changed)
    if discord_turn_barrier(journal and 8 and "101" and "300" and "200") is not equal to 1:
        return 8
    set original_profile to "{\"id\":\"102\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Reply\",\"attachments\":[],\"flags\":0}"
    set recorded to discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and original_profile)
    set profile_update to "{\"id\":\"102\",\"channel_id\":\"300\",\"author\":{\"id\":\"500\",\"vad_colors\":null},\"mentions\":[{\"id\":\"900\",\"vad_colors\":null}],\"content\":\"Reply\",\"attachments\":[],\"flags\":32}"
    set recorded to discord_inbox_record(journal and "revision:profile-thread" and "MESSAGE_UPDATE" and profile_update)
    if discord_turn_barrier(journal and 10 and "102" and "300" and "200") is not equal to 0:
        return 9
    set changed to string_replace(profile_update and "\"500\"" and "\"501\"")
    set recorded to discord_inbox_record(journal and "revision:profile-author" and "MESSAGE_UPDATE" and changed)
    if discord_turn_barrier(journal and 11 and "102" and "300" and "200") is not equal to 1:
        return 10
    display "PASS: thread metadata alone preserves inference; edits, partial updates, attachment changes and deletion cancel"
    return 0
