import "../../app/discord/sticker_multipart"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set path to get_argument(1)
    set digest to file_digest(path and 65536)
    if not (archive_list_text(digest and 0) equals "verified") or else get_list(digest and 2) is not equal to 8:
        return 2
    set metadata to "{\"name\":\"Fixture\",\"description\":\"\",\"tags\":\"wave\"}"
    set result to discord_sticker_multipart(path and archive_list_text(digest and 1) and 8 and metadata and "fixture.png" and "image/png")
    if not (archive_list_text(result and 0) equals "multipart-ready"):
        return 3
    # This fixture begins with NUL, so its preceding form headers form a string.
    set prefix to ptr_to_str(get_list(result and 1))
    if string_contains(prefix and "name=\"name\"") equals 0 or else string_contains(prefix and "name=\"description\"") equals 0 or else string_contains(prefix and "name=\"tags\"") equals 0 or else string_contains(prefix and "name=\"file\"") equals 0 or else string_contains(prefix and "payload_json") > 0 or else string_contains(prefix and "files[0]") > 0:
        return 7
    set pointer to get_list(result and 1) + get_list(result and 4)
    if peek_byte(pointer and 0) is not equal to 0 or else peek_byte(pointer and 1) is not equal to 255 or else peek_byte(pointer and 7) is not equal to 66:
        return 4
    set released to discord_audio_multipart_release(result)
    set result to discord_sticker_multipart(path and "wrong" and 8 and metadata and "fixture.png" and "image/png")
    if not (archive_list_text(result and 0) equals "audio-integrity-failed"):
        return 5
    set result to discord_sticker_multipart(path and archive_list_text(digest and 1) and 8 and metadata and "bad\r\nname.png" and "image/png")
    if not (archive_list_text(result and 0) equals "invalid-file-metadata"):
        return 6
    display "PASS: sticker multipart preserves verified binary bytes and rejects changed content and injected headers."
    return 0
