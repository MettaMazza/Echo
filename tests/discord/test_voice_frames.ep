import "../../app/discord/voice_frames"

define fixture_voice_chunk with values as List and flags as Int and offset as Int and remaining as Int returning List:
    set pointer to alloc_bytes(length_list(values) + 1)
    set index to 0
    repeat while index < length_list(values):
        set copied to poke_byte(pointer and index and get_list(values and index))
        set index to index + 1
    set blob to create_list()
    set added to append_list(blob and pointer)
    set added to append_list(blob and length_list(values))
    set row to history_status("chunk")
    set added to append_list(row and blob)
    set added to append_list(row and flags)
    set added to append_list(row and offset)
    set added to append_list(row and remaining)
    return row

define main returning Int:
    set state to discord_voice_frames_new()
    set values to create_list()
    set values to [0,255]
    set row to fixture_voice_chunk(values and 6 and 0 and 2)
    set owned to get_list(row and 1)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "pending") or else get_list(owned and 0) is not equal to 0:
        return 1
    set result to discord_voice_frames_accept(state and history_status("control"))
    if not (archive_list_text(result and 0) equals "pending"):
        return 2
    set values to [10,0]
    set row to fixture_voice_chunk(values and 6 and 2 and 0)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "pending"):
        return 3
    set values to [99]
    set row to fixture_voice_chunk(values and 2 and 0 and 0)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "message") or else get_list(result and 2) is not equal to 2:
        return 4
    set message to get_list(result and 1)
    if get_list(message and 1) is not equal to 5:
        return 5
    set values to [0,255,10,0,99]
    set index to 0
    repeat while index < 5:
        if peek_byte(get_list(message and 0) and index) is not equal to get_list(values and index):
            return 6
        set index to index + 1
    set released to discord_voice_blob_release(message)
    set values to [123,125]
    set row to fixture_voice_chunk(values and 1 and 0 and 0)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "message") or else get_list(result and 2) is not equal to 1:
        return 7
    set message to get_list(result and 1)
    if not (ptr_to_str(get_list(message and 0)) equals "{}"):
        return 8
    set released to discord_voice_blob_release(message)
    set values to [15]
    set row to fixture_voice_chunk(values and 8 and 0 and 1)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "pending"):
        return 9
    set values to [166]
    set row to fixture_voice_chunk(values and 8 and 1 and 0)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "closed") or else not (archive_list_text(result and 1) equals "4006"):
        return 10
    set row to fixture_voice_chunk(values and 2 and 0 and 0)
    set owned to get_list(row and 1)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "frames-closed") or else get_list(owned and 0) is not equal to 0:
        return 11
    set released to discord_voice_frames_close(state)
    set released to discord_voice_frames_close(state)
    set state to discord_voice_frames_new()
    set row to fixture_voice_chunk(values and 2 and 1 and 0)
    set owned to get_list(row and 1)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "invalid-frame-offset") or else get_list(owned and 0) is not equal to 0:
        return 12
    set released to discord_voice_frames_close(state)
    set state to discord_voice_frames_new()
    set row to fixture_voice_chunk(values and 6 and 0 and 0)
    set result to discord_voice_frames_accept(state and row)
    set row to fixture_voice_chunk(values and 1 and 0 and 0)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "frame-type-changed"):
        return 13
    set released to discord_voice_frames_close(state)
    set state to discord_voice_frames_new()
    set row to fixture_voice_chunk(values and 2 and 0 and 16777216)
    set result to discord_voice_frames_accept(state and row)
    if not (archive_list_text(result and 0) equals "voice-message-too-large"):
        return 14
    set released to discord_voice_frames_close(state)
    display "PASS: binary NUL/255 across I/O chunks and WebSocket fragments, interleaved controls, text/binary separation, chunked close code, error ownership, offset/type/size rejection and repeat-safe teardown."
    return 0
