import "../../app/discord/role_guard"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"200\",\"permissions\":\"1024\",\"position\":0,\"managed\":false},{\"id\":\"201\",\"permissions\":\"268435456\",\"position\":5,\"managed\":false},{\"id\":\"202\",\"permissions\":\"0\",\"position\":2,\"managed\":false},{\"id\":\"203\",\"permissions\":\"8\",\"position\":8,\"managed\":true}]"
    set member to "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\"]}"
    set target to discord_role_snapshot(roles and "202")
    if discord_member_highest_position(roles and member and "200" and "500") is not equal to 5:
        return 1
    if discord_role_below_member(server and roles and member and "200" and "500" and target and 0) is not equal to 1:
        return 2
    set own_role to discord_role_snapshot(roles and "201")
    if discord_role_below_member(server and roles and member and "200" and "500" and own_role and 0) is not equal to 0:
        return 3
    set managed to discord_role_snapshot(roles and "203")
    if discord_role_below_member(server and roles and member and "200" and "500" and managed and 0) is not equal to 0:
        return 4
    if discord_role_permissions_held(server and roles and member and "200" and "500" and "1024") is not equal to 1:
        return 5
    if discord_role_permissions_held(server and roles and member and "200" and "500" and "8") is not equal to 0:
        return 6
    if discord_member_highest_position(roles and member and "200" and "501") is not equal to -1:
        return 7
    set equal_lower to "{\"id\":\"202\",\"position\":5,\"managed\":false}"
    if discord_role_below_member(server and roles and member and "200" and "500" and equal_lower and 0) is not equal to 1:
        return 9
    set equal_higher to "{\"id\":\"199\",\"position\":5,\"managed\":false}"
    if discord_role_below_member(server and roles and member and "200" and "500" and equal_higher and 0) is not equal to 0:
        return 10
    if discord_role_id_older("9999999999999999999" and "10000000000000000000") is not equal to 1 or else discord_role_id_older("18446744073709551614" and "18446744073709551615") is not equal to 1 or else discord_role_id_older("201" and "201") is not equal to 0:
        return 11
    set repeat_index to 0
    repeat while repeat_index < 500:
        if discord_role_below_member(server and roles and member and "200" and "500" and target and 0) is not equal to 1 or else discord_role_permissions_held(server and roles and member and "200" and "500" and "8") is not equal to 0:
            return 8
        set repeat_index to repeat_index + 1
    display "PASS: role hierarchy, managed/equal-role refusal, exact permission subset and identity across repeated allocations"
    return 0
