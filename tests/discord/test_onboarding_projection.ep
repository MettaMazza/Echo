import "../../app/discord/onboarding_view"
import "../../app/discord/access"

define main returning Int:
    set body to "{\"guild_id\":\"400\",\"enabled\":false,\"mode\":0,\"default_channel_ids\":[\"300\"],\"prompts\":[{\"id\":\"100\",\"title\":\"Interests\",\"options\":[{\"id\":\"101\",\"title\":\"Plants\",\"description\":\"Choose plants\",\"emoji\":{\"id\":null,\"name\":\"🌿\",\"animated\":false,\"creator_profile\":\"EXCLUDED_PRIVATE\"},\"role_ids\":[\"200\"],\"channel_ids\":[\"300\"],\"unexpected\":\"EXCLUDED_PRIVATE\"}],\"single_select\":false,\"required\":false,\"in_onboarding\":true,\"type\":0,\"unexpected\":\"EXCLUDED_PRIVATE\"}],\"unexpected\":\"EXCLUDED_PRIVATE\"}"
    set view to discord_onboarding_view(body and "400")
    if string_length(view) equals 0 or else string_contains(view and "EXCLUDED_PRIVATE") is not equal to 0 or else discord_onboarding_changes(view) is not equal to 1:
        return 1
    if string_length(discord_onboarding_view(body and "401")) is not equal to 0:
        return 2
    set fields to provider_json_tokens(view)
    if not (provider_kind(fields and provider_member(fields and 0 and "enabled")) equals "false"):
        return 3
    if string_contains(view and "emoji_name") is not equal to 1 or else string_contains(view and "emoji_animated") is not equal to 1:
        return 4
    if not (archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"inspect\"}") and 0) equals "valid"):
        return 10
    if not (archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"edit\",\"reason\":\"Qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"changes\":{\"enabled\":false}}") and 0) equals "valid"):
        return 11
    if archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"edit\",\"reason\":\"Qualification\",\"observed_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"changes\":{}}") and 0) equals "valid":
        return 12
    if archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"edit\",\"changes\":{\"enabled\":false}}") and 0) equals "valid":
        return 13
    if archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"inspect\",\"changes\":{\"enabled\":false}}") and 0) equals "valid":
        return 14
    if archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"delete\"}") and 0) equals "valid":
        return 15
    if archive_list_text(discord_onboarding_options("{\"guild\":\"400/roles\",\"operation\":\"inspect\"}") and 0) equals "valid":
        return 16
    if archive_list_text(discord_onboarding_options("{\"guild\":\"400\",\"operation\":\"edit\",\"reason\":\"Qualification\",\"observed_sha256\":\"zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\",\"changes\":{\"enabled\":false}}") and 0) equals "valid":
        return 17
    display "PASS: onboarding projection excludes unknown private fields; guild binding, restorable emoji/settings shape and strict inspection/edit requests verified."
    if get_argument_count() equals 1:
        return 0
    if get_argument_count() is not equal to 7 or else discord_snowflake(get_argument(6)) equals 0:
        return 20
    set credential to read_file(get_argument(2))
    if credential equals 0:
        return 21
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 22
    set route to concat("/guilds/" and concat(get_argument(6) and "/onboarding"))
    set response to discord_access_get(get_argument(1) and string_trim(ptr_to_str(credential)) and journal and get_argument(4) and route and "GET:onboarding-independent-read" and get_argument(6))
    if not (archive_list_text(response and 0) equals "observed"):
        display archive_list_text(response and 0)
        return 23
    set projected to discord_onboarding_view(archive_list_text(response and 1) and get_argument(6))
    if string_length(projected) equals 0:
        return 24
    set target to concat(get_argument(4) and "/onboarding-projection.json")
    if file_exists(target) or else write_file(target and projected) is not equal to 1:
        return 25
    display "Verified guild-bound onboarding settings; projected restoration fields retained privately."
    return sql_close(journal)
