import "../../app/discord/store"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0:
        return 2
    set closed to sql_close(database)
    if closed is not equal to 0:
        return 3
    display "PASS: concurrent transport journal open"
    return 0
