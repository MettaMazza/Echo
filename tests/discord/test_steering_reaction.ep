import "../../app/discord/steering_reaction"

define reaction_fixture with journal as Int and identity as Str and kind as Str and actor as Str and room as Str and guild as Str and emoji as Str and custom as Str returning Int:
    set body to concat("{\"message_id\":\"101\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":" and concat(provider_quote(guild) and concat(",\"user_id\":" and concat(provider_quote(actor) and concat(",\"emoji_name\":" and concat(provider_quote(emoji) and concat(",\"emoji_id\":" and concat(provider_quote(custom) and "}"))))))))))
    if not (discord_inbox_record(journal and identity and kind and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_queue_offer_schema(journal) is not equal to 0:
        return 2
    set saved to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set claimed to discord_worker_claim(journal)
    set saved to discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and "{\"id\":\"101\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set offer to discord_queue_offer(journal and "message:create:101")
    if reaction_fixture(journal and "reaction:1" and "MESSAGE_REACTION_ADD" and "500" and "300" and "200" and "↪️" and "") is not equal to 0:
        return 3
    set result to discord_steering_reaction(journal and "reaction:1")
    if not (archive_list_text(result and 0) equals "steering-intent") or else not (archive_list_text(result and 1) equals "message:create:101") or else not (archive_list_text(result and 2) equals "message:create:100") or else not (archive_list_text(result and 3) equals "500"):
        return 4
    set saved to reaction_fixture(journal and "reaction:2" and "MESSAGE_REACTION_ADD" and "501" and "300" and "200" and "↪️" and "")
    set saved to reaction_fixture(journal and "reaction:3" and "MESSAGE_REACTION_ADD" and "500" and "301" and "200" and "↪️" and "")
    set saved to reaction_fixture(journal and "reaction:4" and "MESSAGE_REACTION_ADD" and "500" and "300" and "201" and "↪️" and "")
    for each identity in ["reaction:2","reaction:3","reaction:4"]:
        if not (archive_list_text(discord_steering_reaction(journal and ptr_to_str(identity)) and 0) equals "reaction-binding-denied"):
            return 5
    set saved to reaction_fixture(journal and "reaction:5" and "MESSAGE_REACTION_REMOVE" and "500" and "300" and "200" and "↪️" and "")
    set saved to reaction_fixture(journal and "reaction:6" and "MESSAGE_REACTION_ADD" and "500" and "300" and "200" and "↪️" and "999")
    set saved to reaction_fixture(journal and "reaction:7" and "MESSAGE_REACTION_ADD" and "500" and "300" and "200" and "✅" and "")
    for each identity in ["reaction:5","reaction:6","reaction:7"]:
        if not (archive_list_text(discord_steering_reaction(journal and ptr_to_str(identity)) and 0) equals "not-steering-add"):
            return 6
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (archive_list_text(discord_steering_reaction(journal and "reaction:1") and 2) equals "message:create:100"):
        return 7
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_steering_intents;"))
    if not (archive_list_text(count and 1) equals "0"):
        return 8
    display "PASS: retained steering reaction binds exact author/source/target; foreign scopes, custom emoji spoof, remove and confirmation emoji rejected; restart replay has no execution side effect."
    return 0
