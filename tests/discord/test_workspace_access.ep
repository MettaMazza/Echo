import "../../app/discord/agent_bridge"
import "../../app/tools/workspace_tools"
import "../../app/tools/tool_discovery"

define workspace_discord_fixture with journal as Int and database as Int and message as Str and actor as Str returning Str:
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(actor) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Workspace isolation fixture\"}"))))
    set inbox to concat("message:create:" and message)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return ""
    set admitted to discord_agent_submit(journal and database and inbox and "900" and ["200"] and ["400"])
    if not (archive_list_text(admitted and 0) equals "accepted"):
        return ""
    set state to agent_run_read(database and concat("discord-message:" and message))
    return archive_list_text(state and 0)

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set configured to set_env("ECHO_WORKSPACE_ROOT" and get_argument(3))
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    set first to workspace_discord_fixture(journal and database and "100" and "500")
    set second to workspace_discord_fixture(journal and database and "101" and "501")
    if string_length(first) equals 0 or else string_length(second) equals 0 or else first equals second:
        return 2
    set catalog to tool_discovery_execute(database and "discord-message:100" and "{\"query\":\"workspace_list\",\"after\":0,\"catalog_digest\":\"\"}")
    if not string_contains(catalog and "\"status\":\"found\""):
        display catalog
        return 3
    set created to workspace_tool_execute_device(database and "discord:500" and first and "{\"path\":\"fixture.txt\",\"text\":\"scope-canary-17\"}" and "create")
    if not string_contains(created and "\"status\":\"created\""):
        display created
        return 4
    set listed to workspace_tool_execute_device(database and "discord:500" and first and "{\"path\":\".\",\"offset\":0,\"entries\":10}" and "list")
    if not string_contains(listed and "fixture.txt"):
        return 5
    set arguments to "{\"path\":\"fixture.txt\",\"offset\":0,\"characters\":100}"
    set read to workspace_tool_execute_device(database and "discord:500" and first and arguments and "read")
    if not string_contains(read and "scope-canary-17"):
        return 6
    for each target in [first,second]:
        set denied to workspace_tool_execute_device(database and "discord:501" and ptr_to_str(target) and arguments and "read")
        if string_contains(denied and "scope-canary-17"):
            return 7
    for each path in ["../fixture.txt","/etc/passwd"]:
        set denied to workspace_tool_execute_device(database and "discord:500" and first and concat("{\"path\":" and concat(provider_quote(ptr_to_str(path)) and ",\"offset\":0,\"characters\":100}")) and "read")
        if not string_contains(denied and "invalid-arguments"):
            return 8
    set closed to sql_close(database)
    set database to discord_agent_open(get_argument(2) and "900")
    set read to workspace_tool_execute_device(database and "discord:500" and first and arguments and "read")
    if not string_contains(read and "scope-canary-17"):
        return 9
    if not (principal_host_revocation(database and "revoke-workspace" and "device:discord:500" and 1 and "fixture") equals "recorded"):
        return 10
    set denied to workspace_tool_execute_device(database and "discord:500" and first and arguments and "read")
    if string_contains(denied and "scope-canary-17"):
        return 11
    display "PASS: actual Discord admission exposes scoped workspace catalogue; create/list/read, separate user silos, absolute/traversal denial, restart retention and revocation"
    return 0
