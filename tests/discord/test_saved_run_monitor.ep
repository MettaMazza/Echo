import "../../app/discord/cancel_control"
import "../../app/agent/runner"
import "../../app/agent/generation_recovery"

# Diagnostic on an explicitly copied archive only. No Discord delivery worker
# or scheduler runs here. Original evidence is never used as the destination.
define main returning Int:
    if get_argument_count() is not equal to 5 or else string_contains(get_argument(1) and ".diagnostic.sqlite") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set run to get_argument(2)
    set journal_path to concat(get_argument(1) and ".journal")
    if database equals 0 or else file_exists(journal_path):
        return 2
    set journal to discord_store_open(journal_path and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0:
        return 3
    set closed to sql_close(journal)
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to archive_runtime_lock(database and system)
    if lock < 0:
        return 4
    set recovery to concat("diagnostic-recovery:" and ptr_to_str(ep_uuid_v4()))
    set recovered to agent_recover_generation_owned(database and run and recovery and "0")
    if not (recovered equals "ready"):
        display recovered
        return 5
    set profile to provider_llama_profile(get_argument(3) and http_decimal(get_argument(4)))
    set cancellation to socket_cancellation_create(system)
    set stop to socket_cancellation_create(system)
    set completed to channel
    set monitor_path to concat(journal_path and "")
    set stop_path to concat(journal_path and ".stop")
    spawn discord_turn_monitor(monitor_path and "900" and 0 and "100" and "300" and "200" and stop_path and get_list(stop and 0) and get_list(cancellation and 1) and completed)
    set started to ep_time_now_ms()
    set outcome to agent_loop_provider(database and run and profile and 8192 and get_list(cancellation and 0) and 65536)
    set closed to net_close(get_list(stop and 1))
    set monitor_result to receive from completed
    set closed to net_close(get_list(cancellation and 0))
    display concat("Outcome: " and outcome)
    display concat("Milliseconds: " and int_to_string(ep_time_now_ms() - started))
    if monitor_result is not equal to 0 or else not (outcome equals "completed"):
        return 6
    return sql_close(database)
