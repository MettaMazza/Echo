import "../../app/discord/attachments"

# Read-only CDN acceptance. The caller supplies a retained authenticated intake
# snapshot and a fresh private database/staging directory. No bot token or
# Discord resource mutation is involved. Never use a production database here.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Read the retained authenticated attachment fixture.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    set source to ptr_to_str(read_file(get_argument(2)))
    set tokens to provider_json_tokens(source)
    set items to provider_items(tokens and provider_member(tokens and 0 and "attachments"))
    if length_list(items) is not equal to 1:
        return 5
    set item to get_list(items and 0)
    set room to provider_value(tokens and provider_member(tokens and 0 and "channel_id"))
    set message to provider_value(tokens and provider_member(tokens and 0 and "id"))
    set imported to discord_attachment_import(database and "owner" and session and room and message and tokens and item and get_argument(3))
    if not (archive_list_text(imported and 0) equals "imported"):
        display archive_list_text(imported and 0)
        return 6
    set attachment to archive_list_text(imported and 1)
    set owned to web_attachment_owned(database and "owner" and attachment)
    if not (archive_list_text(owned and 0) equals "found") or else not (archive_list_text(owned and 3) equals "image/png"):
        return 7
    set proof to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(payload,'$.representation') FROM echo_events WHERE event=?1 AND session=?2 AND kind='attachment_source';" and [concat(attachment and ":attachment:source"),session]))
    if not (archive_list_text(proof and 1) equals "declared-image-rendition"):
        return 8
    set repeated to discord_attachment_import(database and "owner" and session and room and message and tokens and item and get_argument(3))
    if not (archive_list_text(repeated and 0) equals "imported") or else not (archive_list_text(repeated and 1) equals attachment) or else archive_verify(database and session) is not equal to 0:
        return 9
    display "PASS: real authenticated-intake CDN download imported with received PNG metadata, atomic declared-rendition provenance, same-identity replay and verified archive; isolated database only."
    return sql_close(database)
