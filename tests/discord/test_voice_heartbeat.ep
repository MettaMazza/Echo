import "../../app/discord/voice_heartbeat"
import "os"

define main returning Int:
    set state to discord_voice_heartbeat_new(1)
    if not (discord_voice_heartbeat_action(state and 100) equals "await-hello") or else discord_voice_heartbeat_hello(state and 45000 and 100) is not equal to 1:
        return 1
    if not (discord_voice_heartbeat_action(state and 100) equals "send"):
        return 2
    set timestamp to discord_voice_heartbeat_timestamp(state and 1700000000000)
    if not (discord_voice_heartbeat_body(state and timestamp) equals "{\"op\":3,\"d\":{\"t\":1700000000000,\"seq_ack\":-1}}"):
        return 16
    if discord_voice_heartbeat_sent(state and 100 and timestamp) is not equal to 1:
        return 3
    if discord_voice_heartbeat_hello(state and 45000 and 200) is not equal to 0 or else discord_voice_heartbeat_ack(state and 200 and 2) is not equal to 0:
        return 4
    if not (discord_voice_heartbeat_action(state and 5099) equals "wait") or else not (discord_voice_heartbeat_action(state and 5100) equals "reconnect-missing-ack"):
        return 5
    if discord_voice_heartbeat_ack(state and 5100 and 1) is not equal to 0:
        return 6
    set accepted to discord_voice_heartbeat_sequence(state and 65535 and 1)
    set resumed to discord_voice_heartbeat_resume(state and 2)
    if resumed equals 0 or else get_list(resumed and 5) is not equal to 65535 or else not (discord_voice_heartbeat_action(resumed and 6000) equals "await-hello"):
        return 7
    if discord_voice_heartbeat_hello(resumed and 1000 and 6000) is not equal to 1:
        return 8
    set later to discord_voice_heartbeat_timestamp(resumed and 1)
    if not (discord_voice_heartbeat_body(resumed and later) equals "{\"op\":3,\"d\":{\"t\":1700000000001,\"seq_ack\":65535}}"):
        return 17
    if later is not equal to timestamp + 1 or else discord_voice_heartbeat_sent(resumed and 6000 and later) is not equal to 1:
        return 9
    if discord_voice_heartbeat_ack(resumed and 6100 and 1) is not equal to 0 or else discord_voice_heartbeat_ack(resumed and 6100 and 2) is not equal to 1:
        return 10
    if discord_voice_heartbeat_sequence(resumed and 0 and 2) is not equal to 1 or else get_list(resumed and 5) is not equal to 0:
        return 11
    if not (discord_voice_heartbeat_action(resumed and 6999) equals "wait") or else not (discord_voice_heartbeat_action(resumed and 7000) equals "send"):
        return 12
    # No successful write has occurred: a poll cannot create an ACK timeout.
    if not (discord_voice_heartbeat_action(resumed and 9000) equals "send"):
        return 13
    if not (discord_voice_heartbeat_action(resumed and 8999) equals "reconnect-clock-anomaly"):
        return 14
    if discord_voice_heartbeat_resume(resumed and 2) is not equal to 0 or else discord_voice_heartbeat_sequence(resumed and 65536 and 2) is not equal to 0:
        return 15
    display "PASS: voice heartbeat deadlines use monotonic time; missing/late ACK, old socket generation, duplicate HELLO, sequence wrap, resume and wall-clock rollback handled."
    return 0
