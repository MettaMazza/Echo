import "../../app/discord/interaction_ack"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_interaction_schema(journal) is not equal to 0 or else discord_ack_timing_schema(journal) is not equal to 0:
        return 2
    set recorded to discord_inbox_record(journal and "interaction:700" and "INTERACTION_CREATE" and "{\"id\":\"700\"}")
    set recorded to discord_inbox_record(journal and "interaction:701" and "INTERACTION_CREATE" and "{\"id\":\"701\"}")
    if sql_execute(journal and "INSERT INTO discord_interaction_credentials VALUES('interaction:700','synthetic_credential_fixture_1234','fixture',1000,901000),('interaction:701','synthetic_credential_fixture_1234','fixture',0,900000); INSERT INTO discord_interaction_jobs VALUES('interaction:700','pending',1000,''),('interaction:701','pending',0,'');") is not equal to 0:
        return 3
    set claim to discord_interaction_claim(journal and 2600)
    if not (archive_list_text(claim and 0) equals "found") or else not (archive_list_text(claim and 1) equals "interaction:700"):
        return 4
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_interaction_jobs WHERE identity='interaction:701';"))
    if not (archive_list_text(row and 1) equals "expired"):
        return 5
    set claim to discord_interaction_claim(journal and 2601)
    if not (archive_list_text(claim and 0) equals "idle"):
        return 6
    if not (discord_interaction_ack_record(journal and "interaction:700" and 0) equals "uncertain"):
        return 7
    if not (discord_interaction_ack_record(journal and "interaction:700" and 1) equals "stale-ack"):
        return 8
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set claim to discord_interaction_claim(journal and 2700)
    if not (archive_list_text(claim and 0) equals "idle"):
        return 9
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_interaction_jobs WHERE identity='interaction:700';"))
    if not (archive_list_text(row and 1) equals "uncertain"):
        return 10
    # A failure before any network attempt is terminal, not uncertain. The
    # distinction survives reopen and cannot overwrite a genuine uncertainty.
    set recorded to discord_inbox_record(journal and "interaction:702" and "INTERACTION_CREATE" and "{\"id\":\"702\"}")
    if sql_execute(journal and "INSERT INTO discord_interaction_jobs VALUES('interaction:702','acknowledging',2700,'');") is not equal to 0:
        return 12
    if not (discord_interaction_ack_unsent(journal and "interaction:702" and "deadline-after-preparation") equals "expired"):
        return 13
    if not (discord_interaction_ack_unsent(journal and "interaction:700" and "fixture") equals "stale-ack"):
        return 14
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set row to history_collect_one(archive_prepare(journal and "SELECT state,detail FROM discord_interaction_jobs WHERE identity='interaction:702';"))
    if not (archive_list_text(row and 1) equals "expired") or else not (archive_list_text(row and 2) equals "ack-not-sent:deadline-after-preparation"):
        return 15
    set claim to discord_interaction_claim(journal and 901001)
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_interaction_credentials;"))
    if not (archive_list_text(row and 1) equals "0"):
        return 11
    if sql_execute(journal and "INSERT INTO discord_ack_timings VALUES('interaction:700',1000,1010,1100,2790,'transfer-failed','0','28','{}');") is not equal to 0:
        return 16
    if sql_execute(journal and "UPDATE discord_ack_timings SET curl_code='0' WHERE identity='interaction:700';") equals 0 or else sql_execute(journal and "DELETE FROM discord_ack_timings WHERE identity='interaction:700';") equals 0:
        return 17
    set row to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_interaction_jobs WHERE identity='interaction:700';"))
    if not (archive_list_text(row and 1) equals "uncertain"):
        return 18
    display "PASS: deadline expiry, exclusive durable claim, uncertain callback not retried after reopen, stale acknowledgement cannot overwrite outcome"
    return 0
