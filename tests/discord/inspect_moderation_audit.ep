import "../../app/discord/access"

# Read-only native acceptance inspection. No audit payload is printed; retained
# originals remain in the private evidence directory supplied by the host.
define main returning Int:
    if get_argument_count() is not equal to 10 or else file_exists(get_argument(3)):
        return 1
    set secret to read_file(get_argument(2))
    if secret equals 0:
        return 2
    set journal to discord_store_open(get_argument(3) and get_argument(5))
    if journal equals 0:
        return 3
    set route to concat("/guilds/" and concat(get_argument(6) and "/audit-logs?limit=100"))
    set observed to discord_access_get(get_argument(1) and string_trim(ptr_to_str(secret)) and journal and get_argument(4) and route and "GET:moderation-audit" and get_argument(6))
    if not (archive_list_text(observed and 0) equals "observed"):
        display archive_list_text(observed and 0)
        return 4
    set tokens to provider_json_tokens(archive_list_text(observed and 1))
    for each item in provider_items(tokens and provider_member(tokens and 0 and "audit_log_entries")):
        set details to provider_member(tokens and item and "options")
        if provider_value(tokens and provider_member(tokens and item and "action_type")) equals "72" and provider_value(tokens and provider_member(tokens and item and "user_id")) equals get_argument(5) and provider_value(tokens and provider_member(tokens and item and "target_id")) equals get_argument(8) and provider_value(tokens and provider_member(tokens and details and "channel_id")) equals get_argument(7) and provider_value(tokens and provider_member(tokens and item and "reason")) equals get_argument(9):
            display provider_value(tokens and provider_member(tokens and item and "id"))
            display archive_list_text(observed and 3)
            display "Matched actual Discord deletion audit entry, bot, target author, channel and exact reason."
            return 0
    display "No matching audit entry observed; not proof of delivery failure."
    return 5
