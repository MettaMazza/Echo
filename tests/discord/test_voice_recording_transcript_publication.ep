import "../../app/discord/voice_recording_transcript_publication"
import "../../app/discord/agent_bridge"

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    set fixture to ep_dlopen(get_argument(3))
    if database equals 0 or else journal equals 0 or else fixture equals 0:
        return 2
    if discord_recording_transcript_publication_schema(database) is not equal to 0:
        return 3
    set mode to get_argument(5)
    set fixture_mode to 13
    if mode equals "view-permission-denied":
        set fixture_mode to 16
    else if mode equals "source-changed":
        set fixture_mode to 6
    else if mode equals "recording-publication-refresh-required":
        set fixture_mode to 17
    else if mode equals "recording-publication-authority-denied":
        set fixture_mode to 18
    set configured to ep_dlcall2(ep_dlsym(fixture and "fixture_configure") and fixture_mode and str_to_ptr(get_argument(2)))
    set configured to ep_dlcall1(ep_dlsym(fixture and "fixture_recording_archive") and str_to_ptr(get_argument(1)))
    set config to create_list()
    set added to append_list(config and get_argument(3))
    set added to append_list(config and "fixture-token-no-network-123456")
    set added to append_list(config and get_argument(2))
    set added to append_list(config and get_argument(1))
    set added to append_list(config and "/unused-native-root")
    set added to append_list(config and "900")
    set guilds to ["200"]
    set admins to ["500"]
    set added to append_list(config and guilds)
    set added to append_list(config and admins)
    set added to append_list(config and get_argument(4))
    set added to append_list(config and "/absent-fixture-stop")
    set row to history_collect_one(archive_prepare(journal and "SELECT artifact FROM discord_voice_recording_transcripts LIMIT 1;"))
    if not (archive_list_text(row and 0) equals "found"):
        return 4
    set artifact to archive_list_text(row and 1)
    set result to discord_recording_transcript_publish(journal and database and config and artifact)
    display result
    if not (result equals mode):
        return 5
    if result equals "recording-transcript-published":
        if not (discord_recording_transcript_publish(journal and database and config and artifact) equals result):
            return 6
        set owner to discord_agent_principal(database and "500" and ["500"])
        set guest to discord_agent_principal(database and "501" and ["500"])
        set owned to web_attachment_owned(database and owner and concat(artifact and ":transcript"))
        set denied to web_attachment_owned(database and guest and concat(artifact and ":transcript"))
        if not (archive_list_text(owned and 0) equals "found") or else not (archive_list_text(denied and 0) equals "end"):
            return 7
        set payload to concat("{\"attachment\":" and concat(provider_quote(concat(artifact and ":audio")) and ",\"state\":\"excluded\"}"))
        if archive_append(database and archive_list_text(owned and 6) and concat("fixture-exclusion:" and ptr_to_str(ep_uuid_v4())) and "attachment_visibility" and payload and "fixture-time") is not equal to 0:
            return 8
        if attachment_context_included(database and concat(artifact and ":transcript")) is not equal to 0 or else attachment_context_included(database and concat(artifact and ":segments")) is not equal to 0:
            return 9
    set closed to sql_close(database)
    set closed to sql_close(journal)
    return 0
