import "../../app/discord/background_retry"
import "../../app/discord/agent_bridge"
import "../../app/jobs/delegation_run"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public network retry fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "retry-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved") or else not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "retry-worker" and 123 and "fixture") equals "recorded"):
        return 5
    set now to ep_time_now_ms()
    if sql_execute(database and "UPDATE echo_web_workers SET status='access:transfer-unresolved:fixture';") is not equal to 0 or else discord_background_retry(journal and database and now) is not equal to 0:
        return 6
    set held to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "running"):
        return 7
    if sql_execute(database and "UPDATE echo_web_workers SET status='access:view-permission-denied';") is not equal to 0 or else discord_background_retry(journal and database and now + 60000) is not equal to 0:
        return 8
    set held to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "running"):
        return 9
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to compaction_lock_acquire(database and "web-worker:discord-message:100" and library)
    if lock < 0 or else sql_execute(database and "UPDATE echo_web_workers SET status='access:http-503';") is not equal to 0 or else discord_background_retry(journal and database and now + 60000) is not equal to 0:
        return 10
    set held to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    if not (archive_list_text(held and 1) equals "running") or else net_close(lock) is not equal to 0 or else discord_background_retry(journal and database and now + 60000) is not equal to 0:
        return 11
    set released to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    set claim to history_collect_one(archive_prepare(database and "SELECT status FROM echo_web_workers;"))
    if not (archive_list_text(released and 1) equals "reserved") or else not (archive_list_text(claim and 1) equals "launch-failed"):
        return 12
    if discord_background_retry(journal and database and now + 120000) is not equal to 0:
        return 13
    set events to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_background_events WHERE detail='preflight retry retains conversation ownership';"))
    if not (archive_list_text(events and 1) equals "1"):
        return 14
    if not (archive_list_text(discord_worker_claim(journal) and 0) equals "end"):
        return 15
    display "PASS: read-only failure retry respects backoff and live ownership; permission denial is not retried; requeue retains conversation ownership exactly once."
    set closed to ep_dlclose(library)
    return sql_close(database)
