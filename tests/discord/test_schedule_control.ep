import "../../app/discord/schedule_control"
import "../fixtures/schedule_fixture"
import "../../app/jobs/delegation_schema"

define discord_schedule_fixture with database as Int and device as Str and run as Str and session as Str and instruction as Str returning Int:
    if not (group_run_submit(database and device and run and session and "discord" and "100" and "200" and "Schedule fixture") equals "accepted"):
        return 1
    set event to concat(run and ":call")
    set payload to concat("{\"run_id\":" and concat(provider_quote(run) and ",\"call_id\":\"schedule\",\"name\":\"schedule_fixture\",\"arguments\":\"{}\"}"))
    if archive_append(database and session and event and "tool_call" and payload and "fixture") is not equal to 0 or else tool_ledger_queue(database and run and "schedule" and session and event) is not equal to 0:
        return 2
    if not (schedule_create(database and run and "schedule" and instruction and 1000 and 1000 and "coalesce") equals "created"):
        return 3
    # Storage fixture: release the simulated origin before admitting the next.
    set values to [run]
    if archive_finish(checkpoint_prepare(database and "UPDATE echo_tool_calls SET state='observed' WHERE run=?1;" and values) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(database and "UPDATE echo_runs SET state='completed' WHERE run=?1;" and values) and 101) is not equal to 0:
        return 4
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    set devices to ["a","b","c"]
    for each device in devices:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "100" and "200" and "g") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "discord" and "100" and "200" and 3) equals "created"):
        return 4
    if discord_schedule_fixture(database and "a" and "first" and "shared" and "First visible instruction") is not equal to 0 or else discord_schedule_fixture(database and "a" and "second" and "shared" and "Second visible instruction") is not equal to 0 or else discord_schedule_fixture(database and "b" and "other" and "shared" and "Another account instruction") is not equal to 0:
        return 5
    if schedule_fixture_origin(database and "a" and "host") is not equal to 0 or else not (schedule_create(database and "host" and "schedule" and "Private Host instruction" and 1000 and 0 and "catch-up") equals "created"):
        return 6
    set list_args to "{\"action\":\"list\",\"session\":\"shared\",\"after\":0}"
    set first to discord_schedule_request(database and "a" and "100" and "200" and "list-one" and list_args)
    if string_contains(first and "First visible instruction") equals 0 or else string_contains(first and "Private Host") > 0 or else string_contains(first and "Another account") > 0:
        display first
        return 7
    set parsed to provider_json_tokens(first)
    set next to provider_value(parsed and provider_member(parsed and 0 and "next_after"))
    set next_args to concat("{\"action\":\"list\",\"session\":\"shared\",\"after\":" and concat(next and "}"))
    set second to discord_schedule_request(database and "a" and "100" and "200" and "list-two" and next_args)
    if string_contains(second and "Second visible instruction") equals 0:
        return 8
    set parsed to provider_json_tokens(second)
    set next to provider_value(parsed and provider_member(parsed and 0 and "next_after"))
    set next_args to concat("{\"action\":\"list\",\"session\":\"shared\",\"after\":" and concat(next and "}"))
    if not (discord_schedule_request(database and "a" and "100" and "200" and "list-end" and next_args) equals "{\"status\":\"end\"}"):
        return 9
    set denied to [["c","100","200"],["a","101","200"],["a","100","201"]]
    for each entry in denied:
        if not (discord_schedule_request(database and archive_list_text(entry and 0) and archive_list_text(entry and 1) and archive_list_text(entry and 2) and "denied" and list_args) equals "{\"status\":\"not-authorized\"}"):
            return 10
    set host_row to agent_run_read(database and "host")
    set host_args to concat("{\"action\":\"list\",\"session\":" and concat(provider_quote(archive_list_text(host_row and 0)) and "}"))
    if not (discord_schedule_request(database and "a" and "100" and "200" and "host-denied" and host_args) equals "{\"status\":\"not-authorized\"}"):
        return 11
    if not (schedule_take_due(database and "first:schedule:schedule" and 1000) equals "first:schedule:schedule:due:1000"):
        return 12
    set occurrences to discord_schedule_request(database and "a" and "100" and "200" and "occurrences" and "{\"action\":\"occurrences\",\"session\":\"shared\",\"schedule\":\"first:schedule:schedule\",\"after\":0}")
    if string_contains(occurrences and "first:schedule:schedule:due:1000") equals 0 or else string_contains(occurrences and "reserved") equals 0:
        return 13
    if not (discord_schedule_cancel(database and "b" and "100" and "200" and "shared" and "first:schedule:schedule" and "foreign") equals "not-authorized"):
        return 14
    if not (discord_schedule_cancel(database and "a" and "100" and "200" and "shared" and "first:schedule:schedule" and "cancel-one") equals "cancelled") or else not (discord_schedule_cancel(database and "a" and "100" and "200" and "shared" and "first:schedule:schedule" and "cancel-one") equals "already-cancelled"):
        return 15
    if not (discord_schedule_cancel(database and "a" and "100" and "200" and "shared" and "second:schedule:schedule" and "cancel-one") equals "request-conflict") or else not (schedule_take_due(database and "first:schedule:schedule" and 2000) equals "cancelled"):
        return 16
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set inspect to discord_schedule_request(database and "a" and "100" and "200" and "inspect" and "{\"action\":\"inspect\",\"session\":\"shared\",\"schedule\":\"first:schedule:schedule\"}")
    if string_contains(inspect and "cancelled") equals 0 or else not (discord_schedule_cancel(database and "a" and "100" and "200" and "shared" and "first:schedule:schedule" and "cancel-one") equals "already-cancelled"):
        return 17
    set prior to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_schedule_occurrences WHERE schedule='first:schedule:schedule';"))
    if not (archive_list_text(prior and 1) equals "1") or else archive_verify(database and "shared") is not equal to 0:
        return 18
    if not (group_change(database and "a" and "leave" and "g" and "device:a" and "left" and 3) equals "recorded") or else not (discord_schedule_request(database and "a" and "100" and "200" and "revoked" and list_args) equals "{\"status\":\"not-authorized\"}"):
        return 19
    display "PASS: schedule pagination, inspection and retained occurrences; owner-only cancellation, immutable replay/conflict, restart, Host/channel/account separation and membership revocation."
    return sql_close(database)
