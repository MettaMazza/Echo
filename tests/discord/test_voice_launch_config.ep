import "../../app/discord/voice_dispatch"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set expected to string_to_int(get_argument(1))
    set config to discord_voice_launch_config()
    if expected equals 0:
        if config is not equal to 0:
            return 2
    else:
        if config equals 0 or else length_list(config) is not equal to expected:
            return 3
        if expected equals 6 and also not (archive_list_text(config and 5) equals get_argument(2)):
            return 4
    display "PASS: optional playback codec requires its exact operator-configured digest; join-only configuration remains valid."
    return 0
