import "../../app/discord/agent_bridge"
import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to discord_agent_open(get_argument(1) and "900")
    set journal to discord_store_open(get_argument(2) and "900")
    if database equals 0 or else journal equals 0:
        return 2
    set admins to create_list()
    set admins to ["400"]
    set guilds to create_list()
    set guilds to ["200"]
    set body to "{\"id\":\"100\",\"channel_id\":\"300\",\"type\":0,\"author\":{\"id\":\"500\"},\"content\":\"Inspect configured guild audit\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:100")
    if string_contains(schemas and "discord_audit_log") is not equal to 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:500" and "discord-message:100" and "discord_audit_log" and "{\"guild\":\"200\"}")
    if string_contains(outcome and "admin-required") equals 0:
        display outcome
        return 6
    set body to "{\"id\":\"101\",\"channel_id\":\"300\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"Inspect configured guild audit\",\"guild_id\":\"200\",\"mentions\":[{\"id\":\"900\"}]}"
    if not (discord_inbox_record(journal and "message:create:101" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:101" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:101")
    if string_contains(schemas and "discord_audit_log") is not equal to 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:400" and "discord-message:101" and "discord_audit_log" and "{\"guild\":\"200\"}")
    if string_contains(outcome and "audience-restricted") equals 0:
        display outcome
        return 6
    set body to "{\"id\":\"102\",\"channel_id\":\"301\",\"type\":0,\"author\":{\"id\":\"400\"},\"content\":\"Inspect configured guild audit\"}"
    if not (discord_inbox_record(journal and "message:create:102" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 3
    set submitted to discord_agent_submit(journal and database and "message:create:102" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set schemas to session_tool_schemas_owned(database and "discord-message:102")
    if string_contains(schemas and "discord_audit_log") equals 0:
        return 5
    set outcome to tool_fixture_call(database and "discord:400" and "discord-message:102" and "discord_audit_log" and "{\"guild\":\"200\"}")
    if string_contains(outcome and "discord-runtime-unavailable") equals 0:
        display outcome
        return 6
    if tool_policy_allows(database and "discord-message:102" and "jobs" and "discord_audit_log") is not equal to 1 or else tool_policy_allows(database and "discord-message:102" and "forged" and "discord_audit_log") is not equal to 0:
        return 7
    set request to discord_audit_request("{\"guild\":\"200\",\"limit\":2}")
    if not (archive_list_text(request and 0) equals "valid") or else not (archive_list_text(request and 1) equals "200"):
        return 8
    if archive_list_text(discord_audit_request("{}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_audit_request("{\"guild\":\"200/roles\"}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_audit_request("{\"guild\":200}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_audit_request("{\"guild\":\"200\",\"guild\":\"201\"}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_audit_request("{\"guild\":\"200\",\"limit\":101}") and 0) equals "valid":
        return 9
    if archive_list_text(discord_audit_request("{\"guild\":\"200\",\"token\":\"not-accepted\"}") and 0) equals "valid":
        return 9
    set server to "{\"id\":\"200\",\"owner_id\":\"600\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\"},{\"id\":\"201\",\"position\":1,\"permissions\":\"128\"}]"
    set requester to "{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]}"
    set bot_member to "{\"user\":{\"id\":\"900\"},\"roles\":[\"201\"]}"
    set no_audit to "{\"user\":{\"id\":\"400\"},\"roles\":[]}"
    set bot_no_audit to "{\"user\":{\"id\":\"900\"},\"roles\":[]}"
    set bundle to create_list()
    set bundle to ["observed",server,roles,requester,bot_member,requester,"null"]
    if discord_audit_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 1 or else discord_audit_bundle_allowed(bundle and "201" and "400" and "900") is not equal to 0:
        return 10
    set bundle to ["observed",server,roles,no_audit,bot_member,no_audit,"null"]
    if discord_audit_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 0:
        return 11
    set bundle to ["observed",server,roles,requester,bot_no_audit,requester,"null"]
    if discord_audit_bundle_allowed(bundle and "200" and "400" and "900") is not equal to 0:
        return 12
    set source to create_list()
    set source to ["found","MESSAGE_CREATE","{}","400","301","","102","0"]
    set excluded to create_list()
    set stopped to discord_audit_perform("" and "" and journal and database and "discord-message:102" and "jobs" and source and request and "900" and excluded and admins and "" and "/absent")
    if string_contains(stopped and "discord-origin-denied-or-stopped") equals 0:
        return 13
    set removed to discord_audit_perform("" and "" and journal and database and "discord-message:102" and "jobs" and source and request and "900" and guilds and excluded and "" and "/absent")
    if string_contains(removed and "admin-required") equals 0:
        return 14
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='discord:400';") is not equal to 0 or else tool_policy_allows(database and "discord-message:102" and "jobs" and "discord_audit_log") is not equal to 0:
        return 15
    display "PASS: audit tool advertised only in eligible admin context; guest and public-channel calls denied; DM frozen call binding, revoked authority, configured-guild boundary, strict request parsing and independent requester/bot audit permissions verified."
    return 0
