import "../../app/discord/share_delivery"
import "../../app/discord/command_registration"
import "../../app/security/group_session_selection"
import "../../app/archive/snapshot"

# Native authenticated intake fixture; no network or live account is involved.
define share_command_fixture with journal as Int and identity as Str and arguments as Str returning Str:
    set row to history_collect_one(checkpoint_prepare(journal and "SELECT json_group_array(json_object('type',3,'name',key,'value',value)) FROM json_each(?1);" and [arguments]))
    set options to archive_list_text(row and 1)
    set source to history_collect_one(checkpoint_prepare(journal and "SELECT json_object('id',?1,'type',2,'application_id','900','guild_id','200','channel_id','300','member',json('{\"user\":{\"id\":\"400\"}}'),'data',json_object('type',1,'id','805','name','share','options',json(?2)));" and [identity,options]))
    set body to archive_list_text(source and 1)
    set inbox to concat("interaction:" and identity)
    if not (discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body) equals "recorded"):
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_jobs VALUES(?1,'acknowledged',CAST(?2 AS INTEGER),'fixture');" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    if archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_project_credential_1234','fixture',CAST(?2 AS INTEGER),CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return ""
    return body

define share_command_run with journal as Int and database as Int and identity as Str and arguments as Str returning Str:
    set body to share_command_fixture(journal and identity and arguments)
    set result to discord_share_prepare(journal and database and concat("interaction:" and identity) and body and "900" and ["200"] and create_list())
    if archive_list_text(result and 0) equals "found":
        return archive_list_text(result and 1)
    return concat("{\"status\":" and concat(provider_quote(archive_list_text(result and 0)) and "}"))

define share_command_field with result as Str and name as Str returning Str:
    set tokens to provider_json_tokens(result)
    return provider_value(tokens and provider_member(tokens and 0 and name))

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    if discord_control_command_matches(discord_control_command_definition("share") and "share") is not equal to 1:
        return 3
    if not (discord_command_observe(journal and "{\"id\":\"805\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"share\"}" and "900" and "200") equals "registered"):
        return 4
    set device to discord_agent_principal(database and "400" and create_list())
    set first to channel_silo_submit(database and device and "discord" and "200" and "300" and "source" and "Only this café sentence." and create_list())
    set group_id to channel_silo_identity("discord" and "200" and "300" and principal_for_device(database and device))
    set next to group_session_restart(database and device and "share-next" and group_id and "discord" and "200" and "300" and 1)
    set destination to archive_list_text(next and 1)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_object('action','preview','source','source:user','destination',?1);" and [destination]))
    set preview to share_command_run(journal and database and "701" and archive_list_text(row and 1))
    if not (share_command_field(preview and "status") equals "review-required") or else string_contains(preview and "Only this café sentence.") equals 0:
        display preview
        return 5
    set review to share_command_field(preview and "review_digest")
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_object('action','confirm','source','source:user','destination',?1,'review',?2);" and [destination,review]))
    set arguments to archive_list_text(row and 1)
    set confirmed to share_command_run(journal and database and "702" and arguments)
    if not (share_command_field(confirmed and "status") equals "recorded"):
        display confirmed
        return 6
    set repeated to share_command_run(journal and database and "703" and arguments)
    if not (share_command_field(repeated and "status") equals "already-recorded") or else not (share_command_field(confirmed and "event") equals share_command_field(repeated and "event")):
        return 7
    set prior to history_collect_one(checkpoint_prepare(journal and "SELECT payload FROM discord_inbox WHERE identity='interaction:702';" and create_list()))
    set retry to discord_share_prepare(journal and database and "interaction:702" and archive_list_text(prior and 1) and "900" and ["200"] and create_list())
    if not (archive_list_text(retry and 1) equals confirmed):
        return 8
    set substituted to string_replace(archive_list_text(prior and 1) and "\"id\":\"400\"" and "\"id\":\"401\"")
    if not (archive_list_text(discord_share_prepare(journal and database and "interaction:702" and substituted and "900" and ["200"] and create_list()) and 0) equals "share-not-authorized"):
        return 9
    set wrong to string_replace(arguments and review and ep_sha256("wrong review"))
    if not (share_command_field(share_command_run(journal and database and "704" and wrong) and "status") equals "share-rejected:review-changed"):
        return 10
    if archive_verify_all(database) is not equal to 0:
        return 11
    display "PASS: registered private share preview, exact Unicode content, explicit confirmation, idempotent second interaction, frozen retry, actor substitution, wrong review and provenance verification"
    return 0

