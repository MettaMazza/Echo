import "../../app/discord/audit_options"
import "../../app/discord/audit_audience"

define audit_privacy_test returning Int:
    set parsed to discord_audit_options("{}")
    if not (archive_list_text(parsed and 0) equals "valid") or else not (archive_list_text(parsed and 1) equals "?limit=50"):
        return 1
    set parsed to discord_audit_options("{\"limit\":100,\"before\":\"123\",\"user_id\":\"456\",\"action_type\":60}")
    if not (archive_list_text(parsed and 0) equals "valid") or else not (archive_list_text(parsed and 1) equals "?limit=100&before=123&user_id=456&action_type=60"):
        return 1
    set parsed to discord_audit_options("{\"after\":\"123\"}")
    if not (archive_list_text(parsed and 0) equals "valid") or else not (archive_list_text(parsed and 1) equals "?limit=50&after=123"):
        return 1
    if archive_list_text(discord_audit_options("[]") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"limit\":0}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"limit\":101}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"limit\":1.0}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"limit\":\"1\"}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"before\":\"12/roles\"}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"before\":\"123\",\"after\":\"456\"}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"action_type\":-1}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"action_type\":1e2}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"user_id\":123}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"limit\":2,\"limit\":3}") and 0) equals "valid":
        return 2
    if archive_list_text(discord_audit_options("{\"guild\":\"123\"}") and 0) equals "valid":
        return 2
    set server to "{\"id\":\"200\",\"owner_id\":\"900\"}"
    set roles to "[{\"id\":\"200\",\"permissions\":\"0\",\"position\":0},{\"id\":\"201\",\"permissions\":\"128\",\"position\":1},{\"id\":\"202\",\"permissions\":\"0\",\"position\":2}]"
    set room_body to "{\"id\":\"300\",\"guild_id\":\"200\",\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"},{\"id\":\"201\",\"type\":0,\"allow\":\"1024\",\"deny\":\"0\"}]}"
    if discord_audit_role_audience(server and roles and room_body and "200" and "300") is not equal to 1:
        return 3
    set unsafe to "{\"id\":\"300\",\"guild_id\":\"200\",\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"},{\"id\":\"201\",\"type\":0,\"allow\":\"1024\",\"deny\":\"0\"},{\"id\":\"202\",\"type\":0,\"allow\":\"1024\",\"deny\":\"0\"}]}"
    if discord_audit_role_audience(server and roles and unsafe and "200" and "300") is not equal to 0:
        return 4
    set room_body to "{\"id\":\"300\",\"guild_id\":\"200\",\"permission_overwrites\":[{\"id\":\"200\",\"type\":0,\"allow\":\"0\",\"deny\":\"1024\"},{\"id\":\"201\",\"type\":0,\"allow\":\"1024\",\"deny\":\"0\"},{\"id\":\"400\",\"type\":1,\"allow\":\"1024\",\"deny\":\"0\"}]}"
    if discord_audit_member_audience(server and roles and room_body and "[]" and "200") is not equal to 0:
        return 5
    if discord_audit_member_audience(server and roles and room_body and "[{\"user\":{\"id\":\"400\"},\"roles\":[\"202\"]}]" and "200") is not equal to 0:
        return 5
    if discord_audit_member_audience(server and roles and room_body and "[{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]}]" and "200") is not equal to 1:
        return 5
    if discord_audit_member_audience(server and roles and room_body and "[{\"user\":{\"id\":\"401\"},\"roles\":[\"201\"]}]" and "200") is not equal to 0:
        return 5
    if discord_audit_member_audience(server and roles and room_body and "[{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]},{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]}]" and "200") is not equal to 0:
        return 5
    if discord_audit_role_audience(server and roles and room_body and "201" and "300") is not equal to 0:
        return 6
    display "PASS: audit pagination rejects route injection and ambiguous filters; audit audience excludes non-auditors, validates explicit member grants, rejects missing and duplicate member snapshots."
    return 0
