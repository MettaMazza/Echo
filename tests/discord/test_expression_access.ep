import "../../app/discord/expression_access"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"999\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\"},{\"id\":\"201\",\"position\":1,\"permissions\":\"8796093022208\"},{\"id\":\"202\",\"position\":2,\"permissions\":\"8\"}]"
    set requester to "{\"user\":{\"id\":\"500\"},\"roles\":[\"201\"]}"
    set bot_member to "{\"user\":{\"id\":\"600\"},\"roles\":[\"202\"]}"
    set body to "{\"id\":\"300\",\"name\":\"fixture\",\"managed\":false,\"user\":{\"id\":\"600\"}}"
    if discord_expression_authority(server and roles and requester and bot_member and "emoji" and "{}" and "200" and "500" and "600" and "" and "create") is not equal to 1:
        return 1
    if discord_expression_authority(server and roles and requester and bot_member and "emoji" and body and "200" and "500" and "600" and "300" and "edit") is not equal to 0:
        return 2
    set owner to "{\"user\":{\"id\":\"999\"},\"roles\":[]}"
    if discord_expression_authority(server and roles and owner and bot_member and "emoji" and body and "200" and "999" and "600" and "300" and "edit") is not equal to 1:
        return 3
    if discord_expression_authority(server and roles and owner and bot_member and "emoji" and body and "200" and "999" and "600" and "301" and "delete") is not equal to 0:
        return 4
    if string_length(discord_expression_route("emoji" and "200/other" and "300")) > 0:
        return 5
    if discord_expression_roles_current("{\"roles\":[\"202\"]}" and roles) is not equal to 1:
        return 6
    if discord_expression_roles_current("{\"roles\":[\"203\"]}" and roles) is not equal to 0:
        return 7
    display "PASS: independent expression authority, bot ownership separation, resource binding, scoped routes and role existence."
    return 0
