import "../../app/discord/voice_recording_artifact"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set journal to sql_open(get_argument(1))
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if journal equals 0 or else system equals 0 or else sql_execute(journal and "PRAGMA busy_timeout=5000; PRAGMA journal_mode=WAL;") is not equal to 0 or else discord_voice_recording_artifact_schema(journal) is not equal to 0:
        return 2
    set anchor to archive_runtime_anchor(journal and system)
    set count to 0
    repeat while count < 100:
        set result to discord_voice_recording_artifact_step(journal and system and anchor and get_argument(2))
        set status to archive_list_text(result and 0)
        if status equals "recording-artifact-discovered":
            set count to count + 1
        else if status equals "recording-artifact-staged":
            display archive_list_text(result and 1)
            if get_argument(3) equals "once":
                break
            set count to count + 1
        else if status equals "recording-artifact-idle":
            break
        else:
            if status equals get_argument(3):
                display concat("PASS: " and status)
                return 0
            display status
            return 3
    if count >= 100:
        return 4
    set closed to sql_close(journal)
    set closed to ep_dlclose(system)
    display "PASS: native artifact staging settled"
    return 0
