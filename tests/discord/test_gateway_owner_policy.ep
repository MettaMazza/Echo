import "../../app/discord/gateway_owner"

define main returning Int:
    # Fractional cooldowns must round up; malformed or enormous values must
    # never become an immediate retry through integer truncation or overflow.
    if discord_retry_seconds("0.001") < 1 or else discord_retry_seconds("61.25") < 62:
        return 1
    for each value in ["","-1","1e4","1..2",".5","1.","99999999999999999999","NaN"]:
        if discord_retry_seconds(ptr_to_str(value)) is not equal to -1:
            return 2
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 3
    set database to discord_store_open(get_argument(1) and "900")
    if database equals 0 or else discord_owner_schema(database) is not equal to 0:
        return 4
    if discord_owner_retry(database and 123456789 and "server-rate-limit") is not equal to 0:
        return 5
    set closed to sql_close(database)
    set reopened to discord_store_open(get_argument(1) and "900")
    set row to history_collect_one(archive_prepare(reopened and "SELECT retry_at,cause FROM discord_gateway_owner;"))
    if not (archive_list_text(row and 1) equals "123456789") or else not (archive_list_text(row and 2) equals "server-rate-limit"):
        return 6
    print "PASS: fractional retry-after, invalid cooldown rejection and durable retry deadline"
    return 0
