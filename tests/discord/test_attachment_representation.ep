import "../../app/discord/attachment_representation"

define representation_magic_fixture with prefix as List and expected as Str returning Int:
    set bytes to [0,0]
    set index to 0
    for each value in prefix:
        set written to poke_byte(get_list_data_ptr(bytes) and index and value)
        set index to index + 1
    return discord_attachment_magic(get_list_data_ptr(bytes) and index) equals expected

define main returning Int:
    if not (discord_attachment_representation("image/webp" and "image/png" and "1164" and "image/png" and "image/png" and 1080) equals "declared-image-rendition"):
        return 1
    if not (discord_attachment_representation("image/webp" and "image/png" and "1164" and "image/png; charset=binary" and "image/png" and 1164) equals "declared-image-rendition"):
        return 2
    if not (discord_attachment_representation("audio/wav" and "null" and "100" and "audio/wav" and "" and 100) equals "exact"):
        return 3
    if not (discord_attachment_representation("application/octet-stream" and "null" and "100" and "application/octet-stream" and "" and 100) equals "exact"):
        return 4
    for each original in ["null", "", "image/webp", "text/html", "image/svg+xml"]:
        if discord_attachment_representation("image/webp" and ptr_to_str(original) and "1164" and "image/png" and "image/png" and 1080) equals "declared-image-rendition":
            return 5
    for each received in ["text/html", "application/octet-stream", "image/jpeg", "image/svg+xml"]:
        if discord_attachment_representation("image/webp" and "image/png" and "1164" and ptr_to_str(received) and "image/png" and 1080) equals "declared-image-rendition":
            return 6
    for each signature in ["", "image/jpeg", "image/webp"]:
        if discord_attachment_representation("image/webp" and "image/png" and "1164" and "image/png" and ptr_to_str(signature) and 1080) equals "declared-image-rendition":
            return 7
    if not (discord_attachment_representation("audio/wav" and "audio/flac" and "100" and "audio/flac" and "" and 99) equals "attachment-size-mismatch"):
        return 8
    if not (discord_attachment_representation("image/png" and "image/png" and "100" and "image/png" and "image/png" and 99) equals "attachment-size-mismatch"):
        return 9
    if not (discord_attachment_representation("image/png" and "null" and "100" and "text/html" and "" and 100) equals "attachment-media-mismatch"):
        return 10
    for each size in ["", "-1", "10x"]:
        if not (discord_attachment_representation("image/webp" and "image/png" and ptr_to_str(size) and "image/png" and "image/png" and 1080) equals "invalid-size"):
            return 11
    if discord_attachment_representation("image/webp" and "image/png" and "100" and "image/png" and "image/png" and 0) equals "declared-image-rendition":
        return 12
    set bytes to [0,0]
    set prefix to [137,80,78,71,13,10,26,10]
    set index to 0
    for each value in prefix:
        set written to poke_byte(get_list_data_ptr(bytes) and index and value)
        set index to index + 1
    if not (discord_attachment_magic(get_list_data_ptr(bytes) and 8) equals "image/png") or else not (discord_attachment_magic(get_list_data_ptr(bytes) and 7) equals ""):
        return 13
    set written to poke_byte(get_list_data_ptr(bytes) and 0 and 0)
    if not (discord_attachment_magic(get_list_data_ptr(bytes) and 8) equals ""):
        return 14
    if representation_magic_fixture([255,216,255] and "image/jpeg") is not equal to 1 or else representation_magic_fixture([255,216] and "") is not equal to 1:
        return 15
    if representation_magic_fixture([71,73,70,56,55,97] and "image/gif") is not equal to 1 or else representation_magic_fixture([71,73,70,56,57,97] and "image/gif") is not equal to 1 or else representation_magic_fixture([71,73,70,56,56,97] and "") is not equal to 1:
        return 16
    if representation_magic_fixture([82,73,70,70,0,0,0,0,87,69,66,80] and "image/webp") is not equal to 1 or else representation_magic_fixture([82,73,70,70,0,0,0,0,87,65,86,69] and "") is not equal to 1:
        return 17
    display "PASS: explicit image rendition metadata, HTTP type and binary signature agree; undeclared/non-image transformations, corrupt signatures, empty bodies and malformed sizes denied."
    return 0
