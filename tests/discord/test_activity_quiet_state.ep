import "../../app/discord/activity_delivery"

define main returning Int:
    if discord_activity_quiet_state("completed") is not equal to 1 or else discord_activity_quiet_state("failed") is not equal to 1 or else discord_activity_quiet_state("cancelled") is not equal to 1 or else discord_activity_quiet_state("waiting") is not equal to 1:
        return 1
    if discord_activity_quiet_state("ready") is not equal to 0 or else discord_activity_quiet_state("generating") is not equal to 0 or else discord_activity_quiet_state("tools") is not equal to 0:
        return 2
    display "PASS: inactive-run backlog is silent; active execution remains unchanged"
    return 0
