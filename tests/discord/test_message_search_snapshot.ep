import "../../app/discord/message_index"

# Run with the production ECHO_ARCHIVE_JOURNAL=WAL setting. Reproduce the
# original read-snapshot upgrade failure, then prove the detached page fixes it.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if sql_execute(journal and "PRAGMA journal_mode=WAL;") is not equal to 0:
        return 2
    set mode to history_collect_one(archive_prepare(journal and "PRAGMA journal_mode;"))
    if not (archive_list_text(mode and 1) equals "wal"):
        return 2
    if not (discord_inbox_record(journal and "first" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"content\":\"needle\"}") equals "recorded") or else discord_message_index_refresh(journal) is not equal to 0:
        return 3
    set iterator to discord_message_index_candidates(journal and "300" and "needle" and "" and "10")
    set row to discord_message_index_row(iterator)
    if not (archive_list_text(row and 0) equals "found"):
        return 4
    set writer to discord_store_open(get_argument(1) and "900")
    if not (discord_inbox_record(writer and "second" and "MESSAGE_UPDATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"content\":\"needle edited\"}") equals "recorded"):
        return 5
    # The old pattern cannot upgrade after another writer committed.
    if sql_execute(journal and "BEGIN IMMEDIATE;") equals 0:
        set rolled to sql_execute(journal and "ROLLBACK;")
        return 6
    set finalized to ep_sqlite3_finalize(iterator)
    set page to discord_message_index_snapshot(journal and "300" and "needle" and "" and "10")
    if page equals 0:
        return 7
    if not (discord_inbox_record(writer and "third" and "MESSAGE_UPDATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"content\":\"needle latest\"}") equals "recorded"):
        return 8
    if sql_execute(journal and "BEGIN IMMEDIATE; CREATE TABLE receipt_probe(value TEXT); INSERT INTO receipt_probe VALUES('verified'); COMMIT;") is not equal to 0:
        return 9
    display "PASS: production WAL reproduces open-cursor upgrade failure; detached candidates permit concurrent-writer then receipt commit"
    return 0
