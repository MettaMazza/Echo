import "../../app/discord/onboarding_guard"

define main returning Int:
    set server to "{\"id\":\"200\",\"owner_id\":\"600\"}"
    set roles to "[{\"id\":\"200\",\"position\":0,\"permissions\":\"0\",\"managed\":false},{\"id\":\"201\",\"position\":10,\"permissions\":\"32\",\"managed\":false},{\"id\":\"202\",\"position\":10,\"permissions\":\"268435488\",\"managed\":false},{\"id\":\"203\",\"position\":1,\"permissions\":\"0\",\"managed\":false},{\"id\":\"204\",\"position\":20,\"permissions\":\"0\",\"managed\":false},{\"id\":\"205\",\"position\":1,\"permissions\":\"0\",\"managed\":true},{\"id\":\"206\",\"position\":1,\"permissions\":\"8\",\"managed\":false}]"
    set requester to "{\"user\":{\"id\":\"400\"},\"roles\":[\"202\"]}"
    set bot_member to "{\"user\":{\"id\":\"900\"},\"roles\":[\"202\"]}"
    set requester_limited to "{\"user\":{\"id\":\"400\"},\"roles\":[\"201\"]}"
    set bot_limited to "{\"user\":{\"id\":\"900\"},\"roles\":[\"201\"]}"
    set bundle to create_list()
    set bundle to ["observed",server,roles,requester,bot_member,requester,"null"]
    if discord_onboarding_bundle_allowed(bundle and "200" and "400" and "900" and 1) is not equal to 1:
        return 1
    if discord_onboarding_bundle_allowed(bundle and "201" and "400" and "900" and 1) is not equal to 0 or else discord_onboarding_bundle_allowed(bundle and "200" and "401" and "900" and 1) is not equal to 0:
        return 2
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "203") is not equal to 1:
        return 3
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "200") is not equal to 0:
        return 4
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "204") is not equal to 0:
        return 5
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "205") is not equal to 0:
        return 6
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "206") is not equal to 0:
        return 7
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "999") is not equal to 0:
        return 8
    set bundle to ["observed",server,roles,requester_limited,bot_member,requester_limited,"null"]
    if discord_onboarding_bundle_allowed(bundle and "200" and "400" and "900" and 0) is not equal to 1 or else discord_onboarding_bundle_allowed(bundle and "200" and "400" and "900" and 1) is not equal to 0:
        return 9
    set bundle to ["observed",server,roles,requester,bot_limited,requester,"null"]
    if discord_onboarding_bundle_allowed(bundle and "200" and "400" and "900" and 0) is not equal to 1 or else discord_onboarding_bundle_allowed(bundle and "200" and "400" and "900" and 1) is not equal to 0:
        return 10
    set server to "{\"id\":\"200\",\"owner_id\":\"400\"}"
    set bundle to ["observed",server,roles,requester,bot_member,requester,"null"]
    if discord_onboarding_role_allowed(bundle and "200" and "400" and "900" and "204") is not equal to 0:
        return 11
    display "PASS: onboarding requester/bot permissions, guild/member bindings, manageable role hierarchy and non-escalating self-selection verified."
    return 0
