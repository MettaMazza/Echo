import "../../app/discord/action_speech"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if not (delegation_schema(database) equals "applied"):
        return 2
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Fixture prompt\"}"
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source)
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 3
    set session to archive_list_text(submitted and 1)
    if archive_append(database and session and "final:fixture" and "assistant_final" and "{\"run_id\":\"discord-message:100\",\"content\":\"Fixture reply\"}" and "fixture") is not equal to 0:
        return 4
    set queued to discord_outbox_enqueue(journal and "reply:fixture" and "message:create:100" and "300" and "{\"content\":\"Fixture reply\"}")
    if sql_execute(journal and "UPDATE discord_outbox SET state='sent',message='700' WHERE identity='reply:fixture';") is not equal to 0:
        return 5
    set identity to discord_message_action_bind(journal and "reply:fixture" and "speak" and "final:fixture")
    set body to concat("{\"type\":3,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":\"300\",\"member\":{\"user\":{\"id\":\"400\"}},\"message\":{\"id\":\"700\",\"author\":{\"id\":\"900\"}},\"data\":{\"component_type\":2,\"custom_id\":" and concat(provider_quote(identity) and "}}"))
    set result to discord_speech_action_context(journal and database and body and "900" and admins)
    if not (archive_list_text(result and 0) equals "bound-needs-live-access") or else not (archive_list_text(result and 5) equals "discord-message:100"):
        return 6
    set wrong to discord_speech_action_prepare("" and "" and journal and database and "{}" and "900" and admins and "" and "/nonexistent-echo-test-stop")
    if not (archive_list_text(wrong and 0) equals "invalid-component"):
        return 7
    if sql_execute(database and "UPDATE echo_principals SET revoked=1;") is not equal to 0:
        return 8
    set result to discord_speech_action_context(journal and database and body and "900" and admins)
    if archive_list_text(result and 0) equals "bound-needs-live-access":
        return 9
    display "PASS: Speak resolves actual final/run, malformed click denied before speech/network, revoked principal cannot synthesize"
    return 0
