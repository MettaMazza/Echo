import "../../app/discord/action_output"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set recorded to discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"500\"}}")
    set body to "{\"content\":\"Actual reply\",\"allowed_mentions\":{\"parse\":[]}}"
    if not (discord_action_output(journal and "reply:100" and "message:create:100" and "300" and body and "final:100" and 1) equals "enqueued"):
        return 2
    if not (discord_action_output(journal and "reply:100" and "message:create:100" and "300" and body and "final:100" and 1) equals "enqueued"):
        return 3
    if not (discord_action_output(journal and "reply:100" and "message:create:100" and "300" and body and "other-final" and 1) equals "action-binding-conflict"):
        return 4
    if not (discord_action_output(journal and "reply:wrong" and "message:create:100" and "100" and body and "final:100" and 1) equals "action-binding-conflict"):
        return 5
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*),channel,json_extract(body,'$.content'),json_array_length(body,'$.components[0].components') FROM discord_outbox;"))
    if not (archive_list_text(row and 1) equals "1") or else not (archive_list_text(row and 2) equals "300") or else not (archive_list_text(row and 3) equals "Actual reply") or else not (archive_list_text(row and 4) equals "1"):
        return 6
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*),COUNT(DISTINCT final_event) FROM discord_message_actions WHERE final_event='final:100';"))
    if not (archive_list_text(row and 1) equals "1") or else not (archive_list_text(row and 2) equals "1"):
        return 7
    if not (discord_action_output(journal and "reply:inject" and "message:create:100" and "300" and "{\"content\":\"No\",\"components\":[]}" and "final:100" and 1) equals "caller-controls-denied"):
        return 8
    display "PASS: reply and controls committed together, exact channel retained, conflicting final and thread destination rolled back, restart and replay stable, caller components denied"
    return 0
