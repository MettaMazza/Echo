import "../../app/discord/queue_control_worker"
import "../../app/discord/background_store"

define auto_admit_fixture with journal as Int and identity as Str and room as Str and prompt as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(identity) and concat(",\"type\":2,\"application_id\":\"900\",\"guild_id\":\"200\",\"channel_id\":" and concat(provider_quote(room) and concat(",\"member\":{\"user\":{\"id\":\"400\"}},\"data\":{\"type\":1,\"id\":\"802\",\"name\":\"auto\",\"options\":[{\"name\":\"prompt\",\"type\":3,\"value\":" and concat(provider_quote(prompt) and "}]}}"))))))
    set inbox to concat("interaction:" and identity)
    set saved to discord_inbox_record(journal and inbox and "INTERACTION_CREATE" and body)
    if discord_interaction_queue(journal and inbox) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "UPDATE discord_interaction_jobs SET state='acknowledged' WHERE identity=?1;" and [inbox]) and 101) is not equal to 0 or else archive_finish(checkpoint_prepare(journal and "INSERT INTO discord_interaction_credentials VALUES(?1,'synthetic_admission_credential_1234','fixture',0,CAST(?2 AS INTEGER)+900000);" and [inbox,int_to_string(ep_time_now_ms())]) and 101) is not equal to 0:
        return 1
    set response to concat("{\"id\":" and concat(provider_quote(concat("1" and identity)) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"author\":{\"id\":\"900\"},\"flags\":0,\"content\":\"Autonomy request received.\",\"interaction_metadata\":{\"id\":" and concat(provider_quote(identity) and ",\"type\":2,\"user\":{\"id\":\"400\"}}}"))))))
    if not (discord_command_anchor_observe(journal and inbox and response and "900" and ["200"] and ["400"]) equals "anchored"):
        return 1
    return 0

define background_fixture_message with journal as Int and message as Str and user as Str and room as Str returning Int:
    set body to concat("{\"id\":" and concat(provider_quote(message) and concat(",\"channel_id\":" and concat(provider_quote(room) and concat(",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":" and concat(provider_quote(user) and "},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public scheduler fixture.\"}"))))))
    set inbox to concat("message:create:" and message)
    if not (discord_inbox_record(journal and inbox and "MESSAGE_CREATE" and body) equals "recorded"):
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if discord_queue_control_schema(journal) is not equal to 0 or else discord_interaction_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if not (discord_command_observe(journal and "{\"id\":\"802\",\"type\":1,\"application_id\":\"900\",\"guild_id\":\"200\",\"name\":\"auto\"}" and "900" and "200") equals "registered") or else auto_admit_fixture(journal and "701" and "300" and "Work on a task.") is not equal to 0:
        return 3
    set delivery to discord_inbox_record(journal and "delivery:observed:999" and "MESSAGE_CREATE" and "{\"id\":\"999\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"author\":{\"id\":\"900\"}}")
    if not (archive_list_text(discord_queue_refresh_next(journal) and 0) equals "end"):
        return 16
    set run to "discord-command:interaction:701"
    set admitted to discord_command_auto_admit(journal and database and "interaction:701" and "900" and ["200"] and ["400"])
    if not (archive_list_text(admitted and 0) equals "accepted") or else not (discord_background_reserve(journal and run and "interaction:701" and 1) equals "reserved"):
        return 4
    set saved to background_fixture_message(journal and "101" and "400" and "300")
    set saved to background_fixture_message(journal and "102" and "400" and "300")
    if not (discord_queue_refresh_source(journal and database and "message:create:101") equals "refreshed") or else not (discord_queue_refresh_source(journal and database and "message:create:102") equals "refreshed"):
        return 5
    set first to discord_queue_marker_next(journal and "message:create:101" and "queue")
    set second to discord_queue_marker_next(journal and "message:create:102" and "queue")
    if not (archive_list_text(first and 1) equals "1️⃣") or else not (archive_list_text(second and 1) equals "2️⃣") or else not (archive_list_text(discord_queue_marker_next(journal and "message:create:101" and "steer") and 1) equals "↪️"):
        return 6
    set observed to discord_queue_marker_observed(journal and "message:create:102" and "queue" and "PUT" and "2️⃣" and archive_list_text(second and 2))
    if not (discord_queue_offer_reserve(journal and "message:create:101" and "400") equals "reserved") or else not (discord_steering_apply(journal and database and "message:create:101" and run and "400") equals "steered"):
        return 7
    set refreshed to discord_queue_refresh_source(journal and database and "message:create:101")
    set tick to discord_queue_marker_next(journal and "message:create:101" and "confirm")
    if not (archive_list_text(tick and 1) equals "✅") or else not (archive_list_text(discord_queue_marker_next(journal and "message:create:101" and "queue") and 0) equals "settled") or else not (archive_list_text(discord_queue_marker_next(journal and "message:create:101" and "steer") and 0) equals "settled"):
        return 8
    set observed to discord_queue_marker_observed(journal and "message:create:101" and "confirm" and "PUT" and "✅" and archive_list_text(tick and 2))
    set refreshed to discord_queue_refresh_source(journal and database and "message:create:102")
    set next to discord_queue_marker_next(journal and "message:create:102" and "queue")
    if not (archive_list_text(next and 0) equals "DELETE") or else not (archive_list_text(next and 1) equals "2️⃣") or else discord_queue_position(journal and "message:create:102") is not equal to 1:
        return 9
    set reset to sql_execute(journal and "UPDATE discord_queue_refresh SET next_ms=0;")
    set next to discord_queue_refresh_next(journal)
    if not (archive_list_text(next and 1) equals "message:create:102"):
        return 10
    set saved to discord_inbox_record(journal and "reaction:fixture" and "MESSAGE_REACTION_REMOVE" and "{}")
    set job to discord_reaction_job_next(journal)
    if not (archive_list_text(job and 1) equals "reaction:fixture") or else not (discord_reaction_job_record(journal and "reaction:fixture" and "not-steering-add") equals "denied") or else not (discord_reaction_job_record(journal and "reaction:fixture" and "not-steering-add") equals "denied"):
        return 11
    set count to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_reaction_job_events;"))
    if not (archive_list_text(count and 1) equals "1"):
        return 12
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if not (archive_list_text(discord_reaction_job_next(journal) and 0) equals "end"):
        return 13
    set cancelled to agent_cancel_run(database and run)
    set released to discord_background_transition(journal and run and "reserved" and "released" and "" and 0 and "fixture")
    set claimed to discord_worker_claim(journal)
    if not (archive_list_text(claimed and 1) equals "message:create:102"):
        return 14
    set refreshed to discord_queue_refresh_source(journal and database and "message:create:102")
    set row to history_collect_one(archive_prepare(journal and "SELECT COUNT(*) FROM discord_queue_markers WHERE source='message:create:102' AND desired<>'';"))
    if not (archive_list_text(row and 1) equals "0"):
        return 15
    display "PASS: queue planning, offered steering, receipt-gated tick, position advancement, settled history exclusion, reaction replay/restart, and dequeue cleanup. Live transport remains pending."
    return 0
