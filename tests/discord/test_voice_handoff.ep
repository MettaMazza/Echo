import "../../app/discord/voice_handoff"

define main returning Int:
    set own to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"200\",\"session_id\":\"session-one\"}"
    set server to "{\"guild_id\":\"100\",\"endpoint\":\"voice.example.discord.media:443\",\"token\":\"fixture-token\"}"
    set round to 0
    repeat while round < 2:
        set state to discord_voice_handoff_new("100" and "200" and "300" and "generation" and 10)
        if not (discord_voice_handoff_event(state and "old" and 11 and "VOICE_SERVER_UPDATE" and server) equals "stale-voice-handoff-event") or else discord_voice_handoff_take(state) is not equal to 0:
            return 1
        if round equals 0:
            set result to discord_voice_handoff_event(state and "generation" and 11 and "VOICE_STATE_UPDATE" and own)
            set result to discord_voice_handoff_event(state and "generation" and 12 and "VOICE_SERVER_UPDATE" and server)
        else:
            set result to discord_voice_handoff_event(state and "generation" and 11 and "VOICE_SERVER_UPDATE" and server)
            set result to discord_voice_handoff_event(state and "generation" and 12 and "VOICE_STATE_UPDATE" and own)
        if not (result equals "voice-handoff-ready"):
            return 2
        set credentials to discord_voice_handoff_take(state)
        if credentials equals 0 or else not (archive_list_text(credentials and 2) equals "session-one") or else not (archive_list_text(credentials and 3) equals "fixture-token") or else discord_voice_handoff_take(state) is not equal to 0 or else not (archive_list_text(state and 6) equals ""):
            return 3
        set round to round + 1
    set state to discord_voice_handoff_new("100" and "200" and "300" and "generation" and 10)
    set result to discord_voice_handoff_event(state and "generation" and 11 and "VOICE_SERVER_UPDATE" and server)
    set unavailable to "{\"guild_id\":\"100\",\"endpoint\":null,\"token\":\"ignored-fixture\"}"
    if not (discord_voice_handoff_event(state and "generation" and 12 and "VOICE_SERVER_UPDATE" and unavailable) equals "await-voice-endpoint") or else not (archive_list_text(state and 6) equals ""):
        return 4
    set result to discord_voice_handoff_event(state and "generation" and 13 and "VOICE_STATE_UPDATE" and own)
    if discord_voice_handoff_ready(state) is not equal to 0:
        return 5
    set result to discord_voice_handoff_event(state and "generation" and 11 and "VOICE_SERVER_UPDATE" and server)
    if not (result equals "stale-voice-handoff-event") or else discord_voice_handoff_ready(state) is not equal to 0:
        return 6
    set invalid_server to "{\"guild_id\":\"100\",\"endpoint\":\"localhost\",\"token\":\"fixture-token\"}"
    if not (discord_voice_handoff_event(state and "generation" and 14 and "VOICE_SERVER_UPDATE" and invalid_server) equals "invalid-voice-server") or else discord_voice_handoff_ready(state) is not equal to 0:
        return 7
    set state to discord_voice_handoff_new("100" and "200" and "300" and "generation" and 10)
    set other to "{\"guild_id\":\"100\",\"user_id\":\"400\",\"channel_id\":\"200\",\"session_id\":\"guest\"}"
    if not (discord_voice_handoff_event(state and "generation" and 11 and "VOICE_STATE_UPDATE" and other) equals "other-voice-user"):
        return 8
    set moved to "{\"guild_id\":\"100\",\"user_id\":\"300\",\"channel_id\":\"201\",\"session_id\":\"session-one\"}"
    if not (discord_voice_handoff_event(state and "generation" and 12 and "VOICE_STATE_UPDATE" and moved) equals "voice-join-target-changed") or else not (discord_voice_handoff_event(state and "generation" and 13 and "VOICE_SERVER_UPDATE" and server) equals "voice-handoff-closed"):
        return 9
    display "PASS: private voice handoff pairs either event order, enforces target and generation, clears unavailable endpoints and transfers credentials once."
    return 0
