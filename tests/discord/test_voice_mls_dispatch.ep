import "../../app/discord/voice_connection_io"

define fixture_mls_result with transport as List and generation as Int returning List:
    set bytes to alloc_bytes(3)
    set written to poke_byte(bytes and 0 and 28)
    set written to poke_byte(bytes and 1 and 0)
    set written to poke_byte(bytes and 2 and 255)
    set blob to create_list()
    set blob to [bytes,3]
    set result to create_list()
    set added to append_list(result and "send-commit-welcome")
    set added to append_list(result and 0)
    set added to append_list(result and -1)
    set added to append_list(result and blob)
    return discord_voice_mls_finish(transport and result and generation)

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 90
    set session to discord_dave_open(get_argument(1) and get_argument(2) and 1 and 1234567890 and "1234123412341234")
    set fixture to ep_dlopen(get_argument(3))
    set socket_library to ep_dlopen(get_argument(4))
    set socket to create_list()
    set added to append_list(socket and "connected")
    set added to append_list(socket and socket_library)
    set added to append_list(socket and 1)
    set handshake to discord_voice_handshake_new(1)
    set changed to set_list(handshake and 0 and 4)
    set paths to create_list()
    set transport to create_list()
    set added to append_list(transport and handshake)
    set added to append_list(transport and socket)
    set added to append_list(transport and 0)
    set added to append_list(transport and 0)
    set added to append_list(transport and session)
    set added to append_list(transport and paths)
    set added to append_list(transport and 1234567890)
    set added to append_list(transport and "1234123412341234")
    set sender to ep_dlcall1(ep_dlsym(fixture and "daveExternalSenderCreate") and 1234567890)
    set raw to research_native_words(1)
    set size to research_native_words(1)
    set fetched to ep_dlcall3(ep_dlsym(fixture and "daveExternalSenderGetMarshalledExternalSender") and sender and get_list_data_ptr(raw) and get_list_data_ptr(size))
    set payload to discord_dave_owned_copy(get_list(session and 0) and get_list(raw and 0) and get_list(size and 0))
    set count to get_list(payload and 1) + 3
    set bytes to alloc_bytes(count)
    set written to discord_voice_put_u16(bytes and 0 and 65535)
    set written to poke_byte(bytes and 2 and 25)
    set index to 0
    repeat while index < get_list(payload and 1):
        set written to poke_byte(bytes and index + 3 and peek_byte(get_list(payload and 0) and index))
        set index to index + 1
    set users to create_list()
    set users to ["1234123412341234"]
    set stale to discord_voice_mls_dispatch(transport and bytes and count and users and 2)
    if not (archive_list_text(stale and 0) equals "stale-mls-owner") or else get_list(get_list(handshake and 1) and 5) is not equal to -1:
        return 1
    set io_state to discord_voice_io_new(transport and 100)
    set incoming to create_list()
    set incoming to [bytes,count]
    set accepted to discord_voice_io_apply_mls(io_state and incoming and users and 1)
    if not (archive_list_text(accepted and 0) equals "external-sender") or else get_list(get_list(handshake and 1) and 5) is not equal to 65535:
        return 2
    set released to discord_voice_blob_release(payload)
    set reset to ep_dlcall1(ep_dlsym(socket_library and "fixture_reset") and 1)
    set failed to fixture_mls_result(transport and 1)
    if not (archive_list_text(failed and 0) equals "mls-response-write-uncertain") or else get_list(get_list(handshake and 1) and 5) is not equal to 65535:
        return 3
    set reset to ep_dlcall1(ep_dlsym(socket_library and "fixture_reset") and 0)
    set accepted to fixture_mls_result(transport and 1)
    if not (archive_list_text(accepted and 0) equals "send-commit-welcome") or else get_list(get_list(handshake and 1) and 5) is not equal to 0 or else ep_dlcall0(ep_dlsym(socket_library and "fixture_calls")) is not equal to 1:
        return 4
    set roster to create_list()
    set result to create_list()
    set added to append_list(result and "committed")
    set added to append_list(result and 1)
    set added to append_list(result and 7)
    set added to append_list(result and roster)
    set deferred to discord_voice_mls_finish(transport and result and 1)
    if not (archive_list_text(deferred and 0) equals "committed") or else get_list(get_list(handshake and 1) and 5) is not equal to 0:
        return 5
    set destroyed to ep_dlcall1(ep_dlsym(fixture and "daveExternalSenderDestroy") and sender)
    set closed to ep_dlclose(fixture)
    set closed to discord_voice_io_close(io_state and "fixture-complete")
    display "PASS: stale sockets cannot enter MLS; accepted external sender advances sequence; partial outbound binary write does not ack; full write wraps ack; commit waits for transition preparation."
    return 0
