import "../../app/discord/command_registration"

define main returning Int:
    if discord_new_command_matches(discord_new_command_definition()) is not equal to 1:
        return 1
    for each body in ["{}", "{\"name\":\"new\",\"type\":1,\"description\":\"Something else\"}", "{\"name\":\"new\",\"name\":\"new\",\"type\":1,\"description\":\"Start a new Echo conversation here, preserving previous history.\"}", "{\"name\":\"new\",\"type\":1,\"description\":\"Start a new Echo conversation here, preserving previous history.\",\"options\":{}}", "{\"name\":\"new\",\"type\":1,\"description\":\"Start a new Echo conversation here, preserving previous history.\",\"options\":[{\"name\":\"other\"}]}"]:
        if discord_new_command_matches(ptr_to_str(body)) is not equal to 0:
            return 2
    if not (discord_new_command_register("" and "" and 0 and "invalid" and "200" and "") equals "invalid-registration-scope"):
        return 3
    if discord_control_command_matches(discord_control_command_definition("autooff") and "autooff") is not equal to 1 or else discord_control_command_matches(discord_new_command_definition() and "autooff") is not equal to 0 or else string_length(discord_control_command_definition("auto")) is not equal to 0:
        return 20
    display "PASS: fixed new-command definition, conflicting/ambiguous/options denial and scope rejection before transport; live registration remains separate"
    return 0
