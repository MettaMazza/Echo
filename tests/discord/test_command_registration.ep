import "../../app/discord/command_registration"

define main returning Int:
    if discord_new_command_matches(discord_new_command_definition()) is not equal to 1:
        return 1
    for each body in ["{}", "{\"name\":\"new\",\"type\":1,\"description\":\"Something else\"}", "{\"name\":\"new\",\"name\":\"new\",\"type\":1,\"description\":\"Start a new Echo conversation here, preserving previous history.\"}", "{\"name\":\"new\",\"type\":1,\"description\":\"Start a new Echo conversation here, preserving previous history.\",\"options\":{}}", "{\"name\":\"new\",\"type\":1,\"description\":\"Start a new Echo conversation here, preserving previous history.\",\"options\":[{\"name\":\"other\"}]}"]:
        if discord_new_command_matches(ptr_to_str(body)) is not equal to 0:
            return 2
    if not (discord_new_command_register("" and "" and 0 and "invalid" and "200" and "") equals "invalid-registration-scope"):
        return 3
    if discord_control_command_matches(discord_control_command_definition("autooff") and "autooff") is not equal to 1 or else discord_control_command_matches(discord_new_command_definition() and "autooff") is not equal to 0 or else discord_control_command_matches(discord_control_command_definition("auto") and "auto") is not equal to 1:
        return 20
    set definition_text to discord_control_command_definition("auto")
    for each body in [string_replace(definition_text and "\"required\":false" and "\"required\":true"),string_replace(definition_text and "\"type\":3" and "\"type\":4"),string_replace(definition_text and "\"name\":\"prompt\"" and "\"name\":\"actor\""),string_replace(definition_text and "\"required\":false" and "\"required\":false,\"max_length\":10"),string_replace(definition_text and "\"required\":false" and "\"required\":false,\"autocomplete\":true")]:
        if discord_control_command_matches(ptr_to_str(body) and "auto") is not equal to 0:
            return 21
    if discord_control_command_matches(string_replace(definition_text and ",\"required\":false" and "") and "auto") is not equal to 1:
        return 22
    for each name_value in ["history","resume","search","export"]:
        set name to ptr_to_str(name_value)
        set definition to discord_control_command_definition(name)
        if discord_control_command_matches(definition and name) is not equal to 1:
            return 23
        set bad to string_replace(definition and "\"type\":3" and "\"type\":4")
        if discord_control_command_matches(bad and name) is not equal to 0:
            return 24
    display "PASS: fixed new-command definition, conflicting/ambiguous/options denial and scope rejection before transport; live registration remains separate"
    return 0
