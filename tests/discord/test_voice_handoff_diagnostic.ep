import "../../app/discord/gateway_intake"
define main returning Int:
    set database to discord_store_open(get_argument(1) and "300")
    if discord_gateway_runtime_schema(database) is not equal to 0:
        return 1
    set bound to discord_gateway_bind(database and "generation" and "session")
    set recorded to discord_gateway_dispatch(database and "generation" and "session" and 1 and "IGNORED" and ep_sha256("fixture") and "" and "")
    set evidence to ep_sha256("fixture-authority")
    set requested to discord_voice_intent_request(database and "join" and "100" and "200" and "400" and "run" and "call" and evidence)
    set claimed to discord_voice_intent_claim(database and "join" and "generation" and 1 and evidence)
    set written to discord_voice_intent_written(database and "join" and archive_list_text(claimed and 1) and 1)
    set body to "{\"guild_id\":\"100\",\"endpoint\":\"attacker.invalid\",\"token\":\"fixture-secret-never-log\"}"
    set saved to discord_gateway_dispatch_private_voice(database and "generation" and "session" and 2 and "VOICE_SERVER_UPDATE" and ep_sha256(body) and "" and "" and "" and body and "300")
    if not (saved equals "recorded"):
        return 2
    set row to history_collect_one(archive_prepare(database and "SELECT state FROM discord_voice_intents WHERE identity='join';"))
    if not (archive_list_text(row and 1) equals "leave-required"):
        return 3
    set closed to sql_close(database)
    return 0
