import "../../app/discord/voice_dispatch"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    if journal equals 0 or else discord_voice_audio_jobs_schema(journal) is not equal to 0:
        return 2
    set requested to discord_voice_intent_request(journal and "voice" and "200" and "600" and "500" and "join-run" and "join-call" and ep_sha256("access"))
    set binding to create_list()
    set binding to ["voice-audio-ready","speech","speech:voice-pcm-wav",ep_sha256("pcm"),"4044","session",ep_sha256("source")]
    if not (discord_voice_audio_job_enqueue(journal and "job" and "voice" and "play-run" and "play-call" and "500" and binding and "consent-event") equals "queued"):
        return 3
    if not (discord_voice_audio_job_enqueue(journal and "job" and "voice" and "play-run" and "play-call" and "500" and binding and "consent-event") equals "existing:queued"):
        return 4
    if not (discord_voice_audio_job_enqueue(journal and "other-id" and "voice" and "play-run" and "play-call" and "500" and binding and "consent-event") equals "voice-audio-identity-conflict"):
        return 5
    set changed to set_list(binding and 3 and ep_sha256("changed"))
    if not (discord_voice_audio_job_enqueue(journal and "job" and "voice" and "play-run" and "play-call" and "500" and binding and "consent-event") equals "voice-audio-identity-conflict"):
        return 6
    set changed to set_list(binding and 3 and ep_sha256("pcm"))
    if not (archive_list_text(discord_voice_audio_job_claim(journal and "voice") and 0) equals "voice-audio-not-ready"):
        return 7
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET state='sent' WHERE identity='voice';")
    set claimed to discord_voice_audio_job_claim(journal and "voice")
    if not (archive_list_text(claimed and 0) equals "attempted") or else not (archive_list_text(claimed and 3) equals "play-run") or else not (archive_list_text(claimed and 6) equals "consent-event"):
        return 8
    set recovered to get_list(claimed and 7)
    set index to 0
    repeat while index < 7:
        if not (archive_list_text(recovered and index) equals archive_list_text(binding and index)):
            return 9
        set index to index + 1
    set second to discord_store_open(get_argument(1) and "900")
    if not (discord_voice_audio_job_enqueue(second and "job2" and "voice" and "play-run" and "play-call2" and "500" and binding and "consent-event2") equals "queued") or else not (archive_list_text(discord_voice_audio_job_claim(second and "voice") and 0) equals "voice-audio-not-ready"):
        return 10
    if not (discord_voice_audio_job_settle(second and "job" and "wrong-attempt" and "completed") equals "voice-audio-result-not-applied"):
        return 11
    set attempt to archive_list_text(claimed and 2)
    if not (discord_voice_audio_job_settle(journal and "job" and attempt and "completed") equals "completed"):
        return 12
    if not (discord_voice_audio_job_enqueue(journal and "job" and "voice" and "play-run" and "play-call" and "500" and binding and "consent-event") equals "existing:completed"):
        return 13
    set claimed2 to discord_voice_audio_job_claim(second and "voice")
    if not (archive_list_text(claimed2 and 1) equals "job2"):
        return 14
    if not (discord_voice_audio_job_enqueue(journal and "job3" and "voice" and "play-run" and "play-call3" and "500" and binding and "consent-event3") equals "queued"):
        return 15
    set closed to sql_close(second)
    set closed to sql_close(journal)
    set journal to discord_store_open(get_argument(1) and "900")
    if discord_voice_audio_jobs_recover(journal and "voice") is not equal to 0:
        return 16
    if not (discord_voice_audio_job_settle(journal and "job2" and archive_list_text(claimed2 and 2) and "completed") equals "voice-audio-result-not-applied"):
        return 17
    if not (archive_list_text(discord_voice_audio_job_claim(journal and "voice") and 0) equals "voice-audio-not-ready"):
        return 18
    set state to history_collect_one(archive_prepare(journal and "SELECT (SELECT state FROM discord_voice_audio_jobs WHERE identity='job'),(SELECT state FROM discord_voice_audio_jobs WHERE identity='job2'),(SELECT state FROM discord_voice_audio_jobs WHERE identity='job3');"))
    if not (archive_list_text(state and 1) equals "completed") or else not (archive_list_text(state and 2) equals "uncertain") or else not (archive_list_text(state and 3) equals "cancelled"):
        return 19
    if not (discord_voice_audio_job_enqueue(journal and "job2" and "voice" and "play-run" and "play-call2" and "500" and binding and "consent-event2") equals "existing:uncertain"):
        return 20
    set cancelled to discord_voice_intent_cancel(journal and "voice")
    if not (discord_voice_audio_job_enqueue(journal and "job4" and "voice" and "play-run" and "play-call4" and "500" and binding and "consent-event4") equals "voice-intent-unavailable"):
        return 21
    if discord_voice_launch_schema(journal) is not equal to 0:
        return 22
    set requested to discord_voice_intent_request(journal and "orphan" and "201" and "601" and "500" and "join2" and "call2" and ep_sha256("access"))
    set changed to sql_execute(journal and "UPDATE discord_voice_intents SET state='sent' WHERE identity='orphan'; INSERT INTO discord_voice_processes(identity,state,process) VALUES('orphan','running',123);")
    if not (discord_voice_audio_job_enqueue(journal and "orphan-audio" and "orphan" and "play2" and "call2" and "500" and binding and "consent2") equals "queued"):
        return 23
    set orphan_claim to discord_voice_audio_job_claim(journal and "orphan")
    if not (archive_list_text(orphan_claim and 0) equals "attempted") or else discord_voice_launch_recover(journal) is not equal to 0:
        return 24
    set state to history_collect_one(archive_prepare(journal and "SELECT j.state,i.state,p.state FROM discord_voice_audio_jobs j JOIN discord_voice_intents i ON i.identity=j.intent JOIN discord_voice_processes p ON p.identity=i.identity WHERE j.identity='orphan-audio';"))
    if not (archive_list_text(state and 1) equals "uncertain") or else not (archive_list_text(state and 2) equals "leave-required") or else not (archive_list_text(state and 3) equals "orphaned"):
        return 25
    if not (discord_voice_audio_job_settle(journal and "orphan-audio" and archive_list_text(orphan_claim and 2) and "completed") equals "voice-audio-result-not-applied"):
        return 26
    display "PASS: immutable audio jobs, exact bindings, duplicate-call conflicts, one sender across connections, attempt ownership and restart tombstones prevent replay."
    return 0
