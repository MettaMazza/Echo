import "../../app/discord/agent_bridge"
import "../../app/agent/run_messages"
import "../fixtures/generation_fixture"

define discord_execution_fixture_call with call_id as Str and name as Str and arguments as Str returning Str:
    return concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(call_id) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set configured to set_env("ECHO_WORKSPACE_ROOT" and get_argument(2))
    set configured to set_env("ECHO_EXECUTION_RUNTIME" and get_argument(3))
    set database to discord_agent_open(get_argument(1) and "900")
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    set journal to discord_store_open(concat(get_argument(1) and ".journal") and "900")
    set body to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"500\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Execute echo in my isolated workspace\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and body) equals "recorded"):
        return 2
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and ["200"] and ["400"])
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 3
    set run to "discord-message:100"
    set session to archive_list_text(agent_run_read(database and run) and 0)
    set checklist to task_checklist_save(database and run and "fixture-plan" and "{\"items\":[{\"id\":\"execute\",\"requirement\":\"Execute echo and verify output\",\"status\":\"pending\",\"evidence\":\"\"}]}")
    if not string_contains(checklist and "saved"):
        display checklist
        return 4
    if provider_json_tokens(session_tool_schemas()) equals 0 or else string_contains(session_tool_schemas() and "workspace_execute") equals 0:
        return 1
    set replies to create_list()
    set source to "define main returning Int:\n    display \"Built inside Discord\"\n    return 0\n"
    set create_arguments to concat("{\"path\":\"hello.ep\",\"text\":" and concat(provider_quote(source) and "}"))
    set created to workspace_tool_execute_device(database and "discord:500" and session and create_arguments and "create")
    if not string_contains(created and "created"):
        display created
        return 5
    set arguments to "{\"program\":\"/bin/echo\",\"arguments\":[\"Hello Echo\"]}"
    set added to append_list(replies and concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"execute\",\"function\":{\"name\":\"workspace_execute\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}")))
    set added to append_list(replies and discord_execution_fixture_call("build" and "workspace_build" and "{\"path\":\"hello.ep\",\"mode\":\"compile\"}"))
    set added to append_list(replies and discord_execution_fixture_call("built-program" and "workspace_execute" and "{\"program\":\"hello\",\"arguments\":[]}"))
    set added to append_list(replies and discord_execution_fixture_call("database" and "workspace_database" and "{\"path\":\"fixture.db\",\"sql\":\"CREATE TABLE sample(value TEXT); INSERT INTO sample VALUES ('scoped-database-21'); SELECT value FROM sample;\"}"))
    set added to append_list(replies and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Execution receipt received.\"},\"finish_reason\":\"stop\"}]}")
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set index to 0
    repeat while index is less than length_list(replies):
        set completed to channel
        spawn generation_fixture(listener and ptr_to_str(get_list(replies and index)) and completed)
        set messages to agent_run_messages(database and run)
        set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and concat(",\"tools\":" and concat(session_tool_schemas() and "}"))))
        set generated to agent_generate_local(database and run and concat("generation:" and int_to_string(index)) and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
        set served to receive from completed
        if generated is not equal to 0 or else served is not equal to 0:
            return 1
        repeat while 1 equals 1:
            set row to agent_run_read(database and run)
            if row equals 0:
                return 1
            if not (ptr_to_str(get_list(row and 2)) equals "tools"):
                break
            if agent_tool_step(database and run) is not equal to 0:
                display "FAIL: execution dispatch"
                return 1
        if sql_close(database) is not equal to 0:
            return 1
        set database to archive_open(get_argument(1))
        set index to index + 1
    set output to history_collect_one(archive_prepare(database and "SELECT group_concat(data,'') FROM (SELECT json_extract(payload,'$.data') AS data FROM echo_events WHERE kind='process_output' AND json_extract(payload,'$.stream')='stdout' AND json_extract(payload,'$.call_id')='execute' ORDER BY sequence);"))
    if not (ptr_to_str(get_list(output and 0)) equals "found") or else not (ptr_to_str(get_list(output and 1)) equals "48656c6c6f204563686f0a"):
        display "FAIL: archived execution bytes"
        return 1
    set observed to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='tool_result' AND json_extract(payload,'$.result.status')='complete' AND json_extract(payload,'$.result.wait_status')='0';"))
    if not (ptr_to_str(get_list(observed and 0)) equals "found") or else not (ptr_to_str(get_list(observed and 1)) equals "4"):
        display "FAIL: build, generated program or database command failed"
        return 1
    set source to history_collect_one(archive_prepare(database and "SELECT json_extract(payload,'$.result.stdout_event') FROM echo_events WHERE kind='tool_result' AND json_extract(payload,'$.call_id')='execute';"))
    if not (ptr_to_str(get_list(source and 0)) equals "found"):
        return 1
    set read_arguments to concat("{\"event\":" and concat(provider_quote(ptr_to_str(get_list(source and 1))) and ",\"offset\":0,\"characters\":2000}"))
    set reread to history_tool_execute(database and session and "history_read" and read_arguments)
    if string_contains(reread and "48656c6c6f204563686f0a") equals 0:
        return 1
    set cursor to 0
    set eof_seen to 0
    repeat while 1 equals 1:
        set lookup to concat("{\"run_id\":" and concat(provider_quote(run) and concat(",\"call_id\":\"execute\",\"stream\":\"stdout\",\"after\":" and concat(int_to_string(cursor) and "}"))))
        set next to session_tool_execute(database and session and "workspace_output_next" and lookup)
        set tokens to provider_json_tokens(next)
        set next_status to provider_value(tokens and provider_member(tokens and 0 and "status"))
        if next_status equals "end":
            break
        if not (next_status equals "found"):
            return 1
        set cursor to string_to_int(provider_value(tokens and provider_member(tokens and 0 and "sequence")))
        if provider_value(tokens and provider_member(tokens and 0 and "eof")) equals "1":
            set eof_seen to eof_seen + 1
        set forbidden to session_tool_execute(database and "other-session" and "workspace_output_next" and lookup)
        if not (forbidden equals "{\"status\":\"not-authorized\"}"):
            return 1
    if eof_seen is not equal to 1:
        return 1
    set row to agent_run_read(database and run)
    if not (ptr_to_str(get_list(row and 2)) equals "completed") or else archive_verify(database and session) is not equal to 0:
        return 1
    set closed to local_socket_close(listener)
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: ordinary Discord admission dispatched real scoped guardian execution, exact stdout/exit, reopen, final continuation and cross-session output denial."
    return 0
