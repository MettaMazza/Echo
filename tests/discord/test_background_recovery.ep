import "../../app/discord/background_recovery"
import "../../app/discord/background_settle"
import "../../app/agent/control"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set journal to discord_store_open(get_argument(1) and "900")
    set database to discord_agent_open(get_argument(2) and "900")
    if journal equals 0 or else database equals 0 or else discord_worker_schema(journal) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    set source to "{\"id\":\"100\",\"channel_id\":\"300\",\"guild_id\":\"200\",\"type\":0,\"author\":{\"id\":\"400\"},\"mentions\":[{\"id\":\"900\"}],\"content\":\"Public background recovery fixture.\"}"
    if not (discord_inbox_record(journal and "message:create:100" and "MESSAGE_CREATE" and source) equals "recorded"):
        return 3
    set guilds to create_list()
    set added to append_list(guilds and "200")
    set admins to create_list()
    set added to append_list(admins and "400")
    set submitted to discord_agent_submit(journal and database and "message:create:100" and "900" and guilds and admins)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    if web_worker_claim(database and "discord-message:100" and "original-worker") is not equal to 0 or else not (discord_background_reserve(journal and "discord-message:100" and "message:create:100" and 1) equals "reserved") or else not (discord_background_transition(journal and "discord-message:100" and "reserved" and "running" and "original-worker" and 123 and "fixture") equals "recorded"):
        return 5
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set lock to compaction_lock_acquire(database and "web-worker:discord-message:100" and library)
    if lock < 0 or else not (archive_list_text(discord_background_recover(journal and database and "discord-message:100") and 0) equals "worker-owned"):
        return 6
    if net_close(lock) is not equal to 0:
        return 7
    set recovered to discord_background_recover(journal and database and "discord-message:100")
    if not (archive_list_text(recovered and 0) equals "recovered") or else not (archive_list_text(recovered and 3) equals "ready") or else archive_list_text(recovered and 2) equals "original-worker":
        return 8
    if not (discord_background_rebind(journal and "discord-message:100" and "original-worker" and "stale-replacement") equals "owner-changed"):
        return 9
    # Simulate the precise cross-archive crash window: the durable execution
    # claim was replaced but its journal still names the prior worker.
    if sql_execute(journal and "UPDATE discord_background_runs SET worker='original-worker';") is not equal to 0:
        return 10
    set closed to sql_close(database)
    set closed to sql_close(journal)
    set database to discord_agent_open(get_argument(2) and "900")
    set journal to discord_store_open(get_argument(1) and "900")
    if agent_cancel_run(database and "discord-message:100") is not equal to 0:
        return 11
    set recovered to discord_background_recover(journal and database and "discord-message:100")
    if not (archive_list_text(recovered and 0) equals "recovered") or else not (archive_list_text(recovered and 3) equals "cancelled") or else discord_background_settle(journal and database) is not equal to 0:
        return 12
    set final to history_collect_one(archive_prepare(journal and "SELECT state FROM discord_background_runs;"))
    set requests to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='model_request';"))
    if not (archive_list_text(final and 1) equals "released") or else not (archive_list_text(requests and 1) equals "0"):
        return 13
    if not (archive_list_text(discord_background_recover(journal and database and "discord-message:100") and 0) equals "reservation-unavailable"):
        return 14
    display "PASS: live owner protected, abandoned claim replaced, stale journal owner rejected, cross-archive recovery reconciled without inference or replay."
    set closed to ep_dlclose(library)
    return sql_close(database)
