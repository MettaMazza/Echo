import "../../app/archive/pdf_text"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set original to file_digest(get_argument(1) and 65536)
    if not (ptr_to_str(get_list(original and 0)) equals "verified"):
        return 1
    set extracted to pdf_text_verified(get_argument(1) and ptr_to_str(get_list(original and 1)) and get_list(original and 2))
    display ptr_to_str(get_list(extracted and 0))
    display ptr_to_str(get_list(extracted and 1))
    if not (ptr_to_str(get_list(extracted and 0)) equals "extracted") or else string_contains(ptr_to_str(get_list(extracted and 1)) and "Echo PDF fixture") equals 0 or else get_list(extracted and 2) is not equal to 2:
        return 1
    set rejected to pdf_text_verified(get_argument(1) and "wrong-digest" and get_list(original and 2))
    if ptr_to_str(get_list(rejected and 0)) equals "extracted" or else string_length(ptr_to_str(get_list(rejected and 1))) is not equal to 0:
        return 1
    set expected to create_list()
    set added to append_list(expected and "invalid-pdf")
    set added to append_list(expected and "locked-pdf")
    set added to append_list(expected and "no-extractable-text")
    set index to 2
    repeat while index is less than 5:
        set original to file_digest(get_argument(index) and 65536)
        set extracted to pdf_text_verified(get_argument(index) and ptr_to_str(get_list(original and 1)) and get_list(original and 2))
        if not (ptr_to_str(get_list(extracted and 0)) equals ptr_to_str(get_list(expected and index - 2))) or else string_length(ptr_to_str(get_list(extracted and 1))) is not equal to 0:
            display concat("FAIL: unexpected PDF status " and ptr_to_str(get_list(extracted and 0)))
            return 1
        set index to index + 1
    display "PASS: verified two-page text, hash mismatch withholding, invalid/locked PDF and no-text distinction."
    return 0
