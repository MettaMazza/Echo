import "../../app/archive/snapshot"

define main returning Int:
    if get_argument_count() is not equal to 4:
        display "Supply fresh active, backup and restored database paths."
        return 1
    set active_path to get_argument(1)
    set backup_path to get_argument(2)
    set restored_path to get_argument(3)
    if file_exists(active_path) or else file_exists(backup_path) or else file_exists(restored_path):
        return 1
    set database to archive_open(active_path)
    if database equals 0:
        return 1
    set original to "Echo lives locally. Maria's original words survive → exactly."
    if archive_append(database and "home" and "first" and "user" and original and "2026-10-14") is not equal to 0:
        return 1
    if archive_restore(active_path and restored_path) equals 0:
        display "FAIL: an unsealed active database was accepted as a backup."
        return 1
    if file_exists(restored_path):
        display "FAIL: rejected recovery created a destination."
        return 1
    if archive_snapshot(database and backup_path) is not equal to 0:
        return 1
    if archive_snapshot(database and backup_path) equals 0:
        display "FAIL: existing backup was overwritten."
        return 1
    if archive_append(database and "home" and "later" and "user" and "Committed after the snapshot." and "2026-10-15") is not equal to 0:
        return 1
    if archive_restore(backup_path and restored_path) is not equal to 0:
        return 1
    set restored to archive_open(restored_path)
    if restored equals 0:
        return 1
    set row to archive_read_event(restored and "first")
    if row equals 0:
        return 1
    if not (ptr_to_str(get_list(row and 3)) equals original):
        return 1
    if archive_read_event(restored and "later") is not equal to 0:
        display "FAIL: snapshot boundary changed."
        return 1
    if archive_verify_all(restored) is not equal to 0:
        return 1
    if sql_close(restored) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    # Deliberately damage only the disposable test snapshot.
    set damaged to sql_open(backup_path)
    if damaged equals 0:
        return 1
    if sql_execute(damaged and "DROP TRIGGER echo_events_no_update; UPDATE echo_events SET payload='damaged' WHERE event='first';") is not equal to 0:
        return 1
    if sql_close(damaged) is not equal to 0:
        return 1
    set rejected_path to concat(restored_path and ".must-not-exist")
    if archive_restore(backup_path and rejected_path) equals 0 or else file_exists(rejected_path):
        display "FAIL: a damaged backup was restored."
        return 1
    display "PASS: internal active storage, external snapshot, exact internal restoration, immutable backup destination, snapshot boundary, unsealed recovery rejection and corruption rejection."
    return 0
