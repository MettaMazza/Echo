import "../../app/archive/history"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set path to get_argument(1)
    if file_exists(path):
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    set original to "café → home; 100%_literal; '; DROP TABLE echo_events; --"
    if archive_append(database and "home" and "first" and "user" and original and "2026-10-14") is not equal to 0:
        return 1
    if archive_append(database and "other" and "secret" and "user" and original and "2026-10-14") is not equal to 0:
        return 1
    if archive_append(database and "home" and "correction" and "user" and "Correction remains separate." and "2026-10-15") is not equal to 0:
        return 1
    set boundary to history_boundary(database and "home")
    if not (ptr_to_str(get_list(boundary and 0)) equals "found"):
        return 1
    set endpoint to string_to_int(ptr_to_str(get_list(boundary and 1)))
    if archive_append(database and "home" and "later" and "assistant" and "New work." and "2026-10-16") is not equal to 0:
        return 1
    set found to history_next(database and "home" and 0 and endpoint and "100%_literal")
    if not (ptr_to_str(get_list(found and 0)) equals "found") or else not (ptr_to_str(get_list(found and 1)) equals "first"):
        return 1
    set found to history_next(database and "home" and 0 and endpoint and "'; DROP TABLE echo_events; --")
    if not (ptr_to_str(get_list(found and 0)) equals "found"):
        return 1
    set cursor to 0
    set count to 0
    repeat while cursor is less than endpoint:
        set found to history_next(database and "home" and cursor and endpoint and "")
        if not (ptr_to_str(get_list(found and 0)) equals "found"):
            return 1
        set cursor to string_to_int(ptr_to_str(get_list(found and 2)))
        set count to count + 1
    if count is not equal to 2:
        display "FAIL: scan crossed its boundary or session."
        return 1
    set found to history_next(database and "home" and cursor and endpoint and "")
    if not (ptr_to_str(get_list(found and 0)) equals "end"):
        return 1
    set piece to history_read_piece(database and "home" and "first" and 3 and 3)
    if not (ptr_to_str(get_list(piece and 7)) equals "é →"):
        display "FAIL: Unicode characters were split."
        return 1
    set total to string_to_int(ptr_to_str(get_list(piece and 4)))
    set rebuilt to ""
    set offset to 0
    repeat while offset is less than total:
        # Three characters is an adversarial test fixture, never a runtime cap.
        set piece to history_read_piece(database and "home" and "first" and offset and 3)
        if not (ptr_to_str(get_list(piece and 0)) equals "found"):
            return 1
        set rebuilt to concat(rebuilt and ptr_to_str(get_list(piece and 7)))
        set offset to offset + 3
    if not (rebuilt equals original):
        return 1
    set piece to history_read_piece(database and "home" and "secret" and 0 and 3)
    if not (ptr_to_str(get_list(piece and 0)) equals "end"):
        return 1
    set piece to history_read_piece(database and "home" and "first" and -1 and 3)
    if not (ptr_to_str(get_list(piece and 0)) equals "error"):
        return 1
    if archive_verify(database and "home") is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: literal search, chronological traversal, stable boundary, session isolation, Unicode-safe pieces, exact full reconstruction and distinct error/exhaustion."
    return 0
