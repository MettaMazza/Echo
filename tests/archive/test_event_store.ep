import "../../app/archive/event_store"

# Each invocation receives a disposable database path. Reopen verifies persistence.
define main returning Int:
    if get_argument_count() is less than 2:
        display "Supply a fresh disposable database path."
        return 1
    set path to get_argument(1)
    set database to archive_open(path)
    if database equals 0:
        return 1
    set unusual to "Maria's words: '; DROP TABLE echo_events; --\nA correction survives.\nUnicode: café, Echo → home."
    if archive_append(database and "session-a" and "event-a" and "user" and unusual and "2026-10-14T00:00:00Z") is not equal to 0:
        return 1
    if archive_append(database and "session-a" and "event-b" and "correction" and "The current value is two, superseding one." and "2026-10-14T00:00:01Z") is not equal to 0:
        return 1
    if archive_append(database and "session-b" and "event-c" and "assistant" and "A separate history." and "2026-10-14T00:00:02Z") is not equal to 0:
        return 1
    if archive_append(database and "session-a" and "event-b" and "user" and "Duplicate must fail" and "2026-10-14T00:00:03Z") equals 0:
        display "FAIL: duplicate event identity was accepted."
        return 1
    if archive_append(database and "" and "event-d" and "user" and "Invalid session" and "now") equals 0:
        display "FAIL: empty session identity was accepted."
        return 1
    if archive_verify(database and "session-a") is not equal to 0:
        return 1
    if archive_verify(database and "session-b") is not equal to 0:
        return 1
    if sql_execute(database and "UPDATE echo_events SET payload='changed' WHERE event='event-a';") equals 0:
        display "FAIL: original event was mutable."
        return 1
    if sql_execute(database and "DELETE FROM echo_events WHERE event='event-b';") equals 0:
        display "FAIL: original event was deletable."
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    set row to archive_read_event(database and "event-a")
    if row equals 0:
        return 1
    set restored to ptr_to_str(get_list(row and 3))
    if not (restored equals unusual):
        display "FAIL: original bytes changed after reopening."
        return 1
    if archive_verify(database and "session-a") is not equal to 0:
        return 1
    # Corrupt only this disposable database to exercise the independent verifier.
    if sql_execute(database and "DROP TRIGGER echo_events_no_update; UPDATE echo_events SET payload='corrupted' WHERE event='event-a';") is not equal to 0:
        return 1
    if archive_verify(database and "session-a") equals 0:
        display "FAIL: corruption was not detected."
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: exact persistence, separate chains, duplicate rejection, invalid identity rejection, immutable originals and corruption detection."
    return 0
