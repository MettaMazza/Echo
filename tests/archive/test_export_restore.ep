import "../../app/archive/export_restore"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    set text to ptr_to_str(read_file(get_argument(2)))
    if database equals 0:
        return 1
    set damaged to ptr_to_str(string_replace(text and "Exact café" and "Changed café"))
    if archive_export_restore(database and damaged and "") equals 0:
        return 1
    if sql_execute(database and "CREATE TRIGGER reject_restore BEFORE INSERT ON echo_events BEGIN SELECT RAISE(ABORT,'fixture write failure'); END;") is not equal to 0 or else archive_export_restore(database and text and "") equals 0:
        return 1
    if sql_execute(database and "DROP TRIGGER reject_restore;") is not equal to 0 or else archive_export_restore(database and text and "") is not equal to 0:
        return 1
    if archive_export_restore(database and text and "") equals 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set tokens to provider_json_tokens(text)
    set events to provider_items(tokens and provider_member(tokens and 0 and "events"))
    set index to 0
    repeat while index is less than length_list(events):
        set item to get_list(events and index)
        set original to archive_read_event(database and provider_value(tokens and provider_member(tokens and item and "event")))
        if original equals 0 or else not (ptr_to_str(get_list(original and 3)) equals provider_value(tokens and provider_member(tokens and item and "payload"))) or else not (ptr_to_str(get_list(original and 6)) equals provider_value(tokens and provider_member(tokens and item and "digest"))):
            return 1
        set index to index + 1
    if sql_close(database) is not equal to 0:
        return 1
    display "PASS: damaged input and write failure rejected, clean restore preserved original payloads and hashes after reopen, populated archive protected."
    return 0
