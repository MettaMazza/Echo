import "../../app/retained_text"
import "string"
external define ep_gc_get_minor_count returning Int

define split_case with value as Str and delimiter as Str and expected as List returning Int:
    set output to create_list()
    set count to retained_text_split(output and value and delimiter)
    if count is not equal to length_list(expected):
        return 1
    set index to 0
    repeat while index < count:
        if not (archive_list_text(output and index) equals archive_list_text(expected and index)):
            return 2
        set index to index + 1
    return 0

define main returning Int:
    if split_case("" and "," and [""]) is not equal to 0 or else split_case("abc" and "" and ["abc"]) is not equal to 0:
        return 1
    if split_case("aa::bb::::" and "::" and ["aa","bb","",""]) is not equal to 0 or else split_case("aaaaa" and "aa" and ["","","a"]) is not equal to 0:
        return 2
    if split_case("é🌿β🌿" and "🌿" and ["é","β",""]) is not equal to 0 or else split_case("a" and "longer" and ["a"]) is not equal to 0:
        return 3
    set absent to create_list()
    if retained_text_split(absent and 0 and ",") is not equal to 0 or else length_list(absent) is not equal to 0:
        return 9
    set used to create_list()
    set added to append_list(used and "keep")
    if retained_text_split(used and "a,b" and ",") is not equal to -1 or else length_list(used) is not equal to 1 or else not (archive_list_text(used and 0) equals "keep"):
        return 4
    set value to ""
    set index to 0
    repeat while index < 128:
        set value to concat(value and concat(int_to_string(index) and "::"))
        set index to index + 1
    set before to ep_gc_get_minor_count()
    set trial to 0
    repeat while trial < 256:
        set output to create_list()
        if retained_text_split(output and value and "::") is not equal to 129:
            return 5
        set index to 0
        repeat while index < 128:
            set expected to int_to_string(index)
            if not (archive_list_text(output and index) equals expected):
                return 6
            set index to index + 1
        if not (archive_list_text(output and 128) equals ""):
            return 7
        set trial to trial + 1
    if ep_gc_get_minor_count() equals before:
        return 8
    display "PASS: exact split semantics, UTF-8 and multi-byte delimiters, retained output through actual collection, nonempty destination unchanged."
    return 0
