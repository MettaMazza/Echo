import "../../app/archive/file_base64"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set inputs to create_list()
    set outputs to create_list()
    set added to append_list(inputs and "")
    set added to append_list(outputs and "")
    set added to append_list(inputs and "f")
    set added to append_list(outputs and "Zg==")
    set added to append_list(inputs and "fo")
    set added to append_list(outputs and "Zm8=")
    set added to append_list(inputs and "foo")
    set added to append_list(outputs and "Zm9v")
    set added to append_list(inputs and "foob")
    set added to append_list(outputs and "Zm9vYg==")
    set added to append_list(inputs and "fooba")
    set added to append_list(outputs and "Zm9vYmE=")
    set added to append_list(inputs and "foobar")
    set added to append_list(outputs and "Zm9vYmFy")
    set index to 0
    repeat while index is less than length_list(inputs):
        set text to ptr_to_str(get_list(inputs and index))
        if write_file(path and text) is not equal to 1:
            return 1
        set batch to 1
        repeat while batch is less than 9:
            set result to file_base64_verified(path and ep_sha256(text) and string_length(text) and batch)
            if not (ptr_to_str(get_list(result and 0)) equals "verified") or else not (ptr_to_str(get_list(result and 1)) equals ptr_to_str(get_list(outputs and index))):
                return 1
            set batch to batch + 1
        set index to index + 1
    set batch to 1
    repeat while batch is less than 10:
        set result to file_base64_verified(get_argument(2) and "b3bdf9421b66360aeaf64533a1ab16be8f50e2c68d5a5376589d1abd106b6955" and 8 and batch)
        if not (ptr_to_str(get_list(result and 0)) equals "verified") or else not (ptr_to_str(get_list(result and 1)) equals "AAH/AGFiYwo="):
            return 1
        set batch to batch + 1
    set result to file_base64_verified(path and "wrong" and 6 and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "integrity-failed") or else string_length(ptr_to_str(get_list(result and 1))) is not equal to 0:
        return 1
    set result to file_base64_verified(path and ep_sha256("foobar") and 5 and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "integrity-failed") or else string_length(ptr_to_str(get_list(result and 1))) is not equal to 0:
        return 1
    display "PASS: base64 reference vectors, empty input, binary NUL/high bytes, all chunk/padding boundaries and withheld output on hash/size mismatch."
    return 0
