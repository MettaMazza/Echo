import "../../app/archive/file_digest"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set first to file_digest(get_argument(1) and 1)
    set second to file_digest(get_argument(1) and 65536)
    set invalid to file_digest(get_argument(1) and 0)
    set missing to file_digest(concat(get_argument(1) and ".missing") and 4096)
    if not (ptr_to_str(get_list(invalid and 0)) equals "invalid-batch") or else not (ptr_to_str(get_list(missing and 0)) equals "open-failed"):
        return 1
    if not (ptr_to_str(get_list(first and 0)) equals "verified") or else not (ptr_to_str(get_list(second and 0)) equals "verified") or else not (ptr_to_str(get_list(first and 1)) equals get_argument(2)) or else not (ptr_to_str(get_list(second and 1)) equals get_argument(2)) or else get_list(first and 2) is not equal to get_list(second and 2):
        display ptr_to_str(get_list(first and 0))
        display ptr_to_str(get_list(first and 1))
        return 1
    display concat("PASS: binary SHA-256 matches independent digest with one-byte and larger reads; bytes=" and int_to_string(get_list(first and 2)))
    return 0
