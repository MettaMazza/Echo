import "../../app/archive/attachment_snapshot"
import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Back up this file.")
    set session to ptr_to_str(get_list(submitted and 1))
    if web_attachment_register(database and "owner" and session and "../../opaque-id" and get_argument(2) and "../café.bin" and "application/octet-stream") is not equal to 0:
        return 1
    if archive_snapshot(database and get_argument(3)) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to sql_open(get_argument(3))
    if attachment_snapshot_verify(database and get_argument(4)) equals 0:
        return 1
    if attachment_snapshot_copy(database and concat(get_argument(4) and "/missing-parent")) equals 0 or else attachment_snapshot_verify(database and get_argument(4)) equals 0:
        return 1
    if attachment_snapshot_copy(database and get_argument(4)) is not equal to 0 or else attachment_snapshot_verify(database and get_argument(4)) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to sql_open(get_argument(3))
    if attachment_snapshot_verify(database and get_argument(4)) is not equal to 0 or else attachment_snapshot_copy(database and get_argument(4)) equals 0:
        return 1
    if write_file(attachment_snapshot_path(get_argument(4) and "../../opaque-id") and "damaged") is not equal to 1:
        return 1
    if attachment_snapshot_verify(database and get_argument(4)) equals 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: unsealed backup rejected, binary attachment copy verified after reopen, unsafe IDs mapped to digest names, repeat rejected and damaged backup detected."
    return 0
