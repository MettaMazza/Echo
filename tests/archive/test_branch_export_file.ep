import "../../app/archive/export_restore"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set text to ptr_to_str(read_file(get_argument(2)))
    if archive_export_verify(text and "") is not equal to 0:
        return 1
    set tokens to provider_json_tokens(text)
    set chains to provider_items(tokens and provider_member(tokens and 0 and "chains"))
    if chains equals 0 or else length_list(chains) is less than 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else archive_export_restore(database and text and "") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set index to 0
    set count to 0
    repeat while index is less than length_list(chains):
        set chain to get_list(chains and index)
        set events to provider_items(tokens and provider_member(tokens and chain and "events"))
        set position to 0
        repeat while position is less than length_list(events):
            set item to get_list(events and position)
            set event to provider_value(tokens and provider_member(tokens and item and "event"))
            set row to archive_read_event(database and event)
            if row equals 0 or else not (ptr_to_str(get_list(row and 0)) equals provider_value(tokens and provider_member(tokens and item and "session"))) or else not (ptr_to_str(get_list(row and 3)) equals provider_value(tokens and provider_member(tokens and item and "payload"))) or else not (ptr_to_str(get_list(row and 6)) equals provider_value(tokens and provider_member(tokens and item and "digest"))) or else not (ptr_to_str(get_list(row and 7)) equals provider_value(tokens and provider_member(tokens and item and "sequence"))):
                return 1
            set position to position + 1
            set count to count + 1
        if archive_verify(database and provider_value(tokens and provider_member(tokens and chain and "session"))) is not equal to 0:
            return 1
        set index to index + 1
    if sql_close(database) is not equal to 0:
        return 1
    display concat("PASS: restored and reread original branch events: " and int_to_string(count))
    return 0
