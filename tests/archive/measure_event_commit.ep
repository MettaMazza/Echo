import "../../app/archive/event_store"
import "os"

# Diagnostic workload only: measure existing phases without changing durability.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 1
    set begin_time to 0
    set append_time to 0
    set commit_time to 0
    set index to 0
    repeat while index is less than 200:
        set identity to concat("measure:" and int_to_string(index))
        set started to ep_time_now_ms()
        if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
            return 1
        set begun to ep_time_now_ms()
        if archive_append_pending(database and "measurement" and identity and "provider_event" and "{\"request_event\":\"measure\",\"event_type\":\"message\",\"event_id\":\"\",\"data\":\"A representative small provider event for commit timing, not an inference result.\"}" and "diagnostic") is not equal to 0:
            return 1
        set appended to ep_time_now_ms()
        if sql_execute(database and "COMMIT;") is not equal to 0:
            return 1
        set committed to ep_time_now_ms()
        set begin_time to begin_time + begun - started
        set append_time to append_time + appended - begun
        set commit_time to commit_time + committed - appended
        set index to index + 1
    display concat("200 events, BEGIN milliseconds: " and int_to_string(begin_time))
    display concat("Insert/readback/hash milliseconds: " and int_to_string(append_time))
    display concat("COMMIT milliseconds: " and int_to_string(commit_time))
    if archive_verify(database and "measurement") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    return 0
