import "../../app/archive/attachment_restore"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else attachment_snapshot_verify(database and get_argument(2)) is not equal to 0:
        return 1
    set row to web_attachment_owned(database and "a" and get_argument(3))
    if not (ptr_to_str(get_list(row and 0)) equals "found") or else not (ptr_to_str(get_list(row and 1)) equals attachment_snapshot_path(get_argument(2) and get_argument(3))):
        return 1
    set foreign to web_attachment_owned(database and "b" and get_argument(3))
    if not (ptr_to_str(get_list(foreign and 0)) equals "end"):
        return 1
    set upload to web_upload_owned(database and "a" and get_argument(3))
    if not (ptr_to_str(get_list(upload and 5)) equals "complete"):
        return 1
    if attachment_restore_start_allowed(database) is not equal to 0:
        return 1
    if sql_execute(database and "UPDATE echo_attachments SET path='/invalid';") equals 0 or else sql_execute(database and "UPDATE echo_uploads SET path='/invalid';") equals 0:
        return 1
    if archive_verify_all(database) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: relocated owned file verified, foreign access excluded, completed upload preserved, immutable paths restored and startup held for reconciliation."
    return 0
