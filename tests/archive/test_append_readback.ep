import "../../app/archive/event_store"
import "fs"

# Fault injection applies only to a new disposable database supplied here.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 1
    if archive_append(database and "session" and "before" and "user" and "Original café." and "before") is not equal to 0:
        return 1
    if sql_execute(database and "DROP TRIGGER echo_events_no_update; CREATE TRIGGER injected_digest_fault AFTER INSERT ON echo_events WHEN NEW.event='fault' BEGIN UPDATE echo_events SET digest='invalid' WHERE event=NEW.event; END;") is not equal to 0:
        return 1
    if archive_append(database and "session" and "fault" and "user" and "Must roll back." and "fault") equals 0:
        display "FAIL: corrupted inserted digest committed."
        return 1
    set statement to archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE event='fault';")
    if statement equals 0 or else ep_sqlite3_step(statement) is not equal to 100:
        return 1
    set count to ptr_to_str(ep_sqlite3_column_text(statement and 0))
    if not (count equals "0") or else ep_sqlite3_finalize(statement) is not equal to 0:
        return 1
    if sql_execute(database and "DROP TRIGGER injected_digest_fault;") is not equal to 0:
        return 1
    if archive_append(database and "session" and "after" and "user" and "Continues from the original head." and "after") is not equal to 0 or else archive_verify(database and "session") is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: inserted digest corruption rejected before commit; rollback preserves the chain across reopen."
    return 0
