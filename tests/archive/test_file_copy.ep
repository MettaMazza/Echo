import "../../app/archive/file_copy"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set source to get_argument(1)
    set destination to get_argument(2)
    set digest to "b3bdf9421b66360aeaf64533a1ab16be8f50e2c68d5a5376589d1abd106b6955"
    if file_copy_verified(source and destination and digest and 8 and 1) is not equal to 0:
        return 1
    if file_copy_verified(source and destination and digest and 8 and 1) equals 0:
        return 1
    if file_copy_verified(source and concat(destination and ".wrong-hash") and "wrong" and 8 and 65536) equals 0:
        return 1
    if file_copy_verified(source and concat(destination and ".short") and digest and 7 and 65536) equals 0:
        return 1
    if file_copy_verified(source and concat(destination and ".long") and digest and 9 and 65536) equals 0:
        return 1
    set checked to file_digest(destination and 1)
    if not (ptr_to_str(get_list(checked and 1)) equals digest) or else get_list(checked and 2) is not equal to 8:
        return 1
    display "PASS: exact binary copy with one-byte reads, exclusive destination, digest mismatch and both size mismatches."
    return 0
