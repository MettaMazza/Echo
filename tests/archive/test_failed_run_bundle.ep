import "../../app/archive/restore_bundle"
import "../../app/workspace/process_journal"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set profile to ptr_to_str(read_file(get_argument(1)))
    set tokens to provider_json_tokens(profile)
    if backup_bundle_valid(tokens) equals 0:
        return 2
    set path to provider_value(tokens and provider_member(tokens and 0 and "database"))
    set bundle to provider_value(tokens and provider_member(tokens and 0 and "bundle"))
    if file_exists(path) or else file_exists(bundle) or else file_exists(get_argument(2)):
        return 3
    set database to archive_open(path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_upload_schema(database) is not equal to 0 or else workspace_process_schema(database) is not equal to 0:
        return 4
    if archive_append(database and "home" and "objective" and "user" and "Preserve this failed conversation." and "fixture") is not equal to 0 or else agent_run_create(database and "run-a" and "home" and "objective") is not equal to 0:
        return 5
    if backup_bundle_run(profile) equals 0 or else file_exists(bundle):
        display "FAIL: ready work accepted as quiescent."
        return 6
    if archive_append(database and "home" and "failure" and "agent_failure" and "{\"run_id\":\"run-a\",\"parent_event\":\"objective\",\"cause\":\"fixture failure\"}" and "fixture") is not equal to 0 or else agent_run_transition(database and "run-a" and "ready" and "objective" and "failed" and "failure") is not equal to 0:
        return 7
    if sql_close(database) is not equal to 0 or else backup_bundle_run(profile) is not equal to 0:
        return 8
    set digest to file_digest(concat(bundle and "/manifest.json") and 65536)
    if not (archive_list_text(digest and 0) equals "verified") or else restore_bundle_run(bundle and archive_list_text(digest and 1) and get_argument(2)) is not equal to 0:
        return 9
    set restored to sql_open(concat(get_argument(2) and "/archive.sqlite"))
    if restored equals 0 or else attachment_restore_start_allowed(restored) is not equal to 0 or else archive_verify_all(restored) is not equal to 0:
        return 10
    set run to agent_run_read(restored and "run-a")
    if run equals 0 or else not (archive_list_text(run and 2) equals "failed") or else not (archive_list_text(run and 3) equals "failure"):
        return 11
    set event to archive_read_event(restored and "objective")
    if event equals 0 or else not (archive_list_text(event and 3) equals "Preserve this failed conversation."):
        return 12
    if sql_close(restored) is not equal to 0:
        return 13
    display "PASS: active run rejected, failed run preserved through full bundle and independent restore, original evidence verified and execution held."
    return 0
