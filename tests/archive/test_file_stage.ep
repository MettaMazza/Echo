import "../../app/archive/file_stage"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 1
    set descriptor to file_stage_open(library and get_argument(1))
    if descriptor is less than 0:
        return 1
    # Packed native bytes: 00 01 ff 00 61 62 63 0a (NUL/high-byte fixture).
    set bytes to create_list()
    set added to append_list(bytes and 748550131841696000)
    if file_stage_write(library and descriptor and get_list_data_ptr(bytes) and 3) is not equal to 0 or else file_stage_write(library and descriptor and get_list_data_ptr(bytes) + 3 and 5) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    if file_stage_open(library and get_argument(1)) >= 0:
        display "FAIL: staging overwrote an existing file."
        return 1
    if file_stage_write(library and -1 and get_list_data_ptr(bytes) and 8) equals 0:
        return 1
    set checked to file_digest(get_argument(1) and 3)
    if not (ptr_to_str(get_list(checked and 0)) equals "verified") or else get_list(checked and 2) is not equal to 8 or else not (ptr_to_str(get_list(checked and 1)) equals "b3bdf9421b66360aeaf64533a1ab16be8f50e2c68d5a5376589d1abd106b6955"):
        display ptr_to_str(get_list(checked and 1))
        return 1
    if ep_dlclose(library) is not equal to 0:
        return 1
    display "PASS: binary fragments staged, flushed and hash-verified; existing destination and invalid descriptor rejected."
    return 0
