import "../../app/archive/file_text"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set result to file_text_window(get_argument(1) and get_argument(2) and string_to_int(get_argument(3)) and 65536 and 100 and 16)
    if not (ptr_to_str(get_list(result and 0)) equals "verified") or else not (ptr_to_str(get_list(result and 1)) equals "aaaaaaaaaaaaaaaa") or else get_list(result and 2) is not equal to 16:
        return 1
    display "PASS: verified full input, retained exact 16-character window."
    return 0
