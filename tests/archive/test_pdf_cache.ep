import "../../app/archive/pdf_cache"
import "../../app/web/attachments"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set session to web_create_session(database and "owner" and "cache")
    if web_attachment_register(database and "owner" and "draft:cache" and "pdf" and get_argument(2) and "fixture.pdf" and "application/pdf") is not equal to 0:
        return 1
    set original to file_digest(get_argument(2) and 65536)
    set digest to ptr_to_str(get_list(original and 1))
    set bytes to get_list(original and 2)
    set first to pdf_cached_page(database and "pdf:attachment" and get_argument(2) and digest and bytes and 0)
    if not (ptr_to_str(get_list(first and 0)) equals "extracted") or else get_list(first and 4) is not equal to 0 or else string_length(ptr_to_str(get_list(first and 3))) equals 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    set second to pdf_cached_page(database and "pdf:attachment" and get_argument(2) and digest and bytes and 0)
    if not (ptr_to_str(get_list(second and 0)) equals "extracted") or else get_list(second and 4) is not equal to 1 or else not (ptr_to_str(get_list(second and 1)) equals ptr_to_str(get_list(first and 1))):
        return 1
    set page to pdf_cached_page(database and "pdf:attachment" and get_argument(2) and digest and bytes and 1)
    if not (ptr_to_str(get_list(page and 0)) equals "extracted") or else get_list(page and 4) is not equal to 0:
        return 1
    if sql_execute(database and "UPDATE echo_pdf_text_cache SET payload='changed' WHERE page=0;") equals 0:
        return 1
    if sql_execute(database and "DROP TRIGGER echo_pdf_cache_no_update; UPDATE echo_pdf_text_cache SET payload='changed' WHERE page=0;") is not equal to 0:
        return 1
    set corrupt to pdf_cached_page(database and "pdf:attachment" and get_argument(2) and digest and bytes and 0)
    if not (ptr_to_str(get_list(corrupt and 0)) equals "cache-integrity-failed") or else string_length(ptr_to_str(get_list(corrupt and 1))) is not equal to 0:
        return 1
    if write_file(get_argument(2) and "changed original") is not equal to 1:
        return 1
    set corrupt to pdf_cached_page(database and "pdf:attachment" and get_argument(2) and digest and bytes and 1)
    if not (ptr_to_str(get_list(corrupt and 0)) equals "integrity-failed") or else string_length(ptr_to_str(get_list(corrupt and 1))) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: page cache survives reopen, avoids repeated extraction, separates pages, blocks updates and rejects derived/original corruption."
    return 0
