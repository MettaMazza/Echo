import "../../app/archive/location"
import "os"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set original to archive_main_path(database)
    if string_length(original) equals 0:
        return 3
    if sql_execute(database and "CREATE TEMP TABLE location_fixture(value TEXT); INSERT INTO location_fixture VALUES('temporary');") is not equal to 0:
        return 4
    set attach to archive_prepare(database and "ATTACH DATABASE ? AS location_auxiliary;")
    if attach equals 0 or else archive_bind(attach and 1 and get_argument(2)) is not equal to 0 or else archive_finish(attach and 101) is not equal to 0:
        return 5
    if sql_execute(database and "CREATE TABLE location_auxiliary.fixture(value TEXT);") is not equal to 0:
        return 6
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM pragma_database_list;"))
    if not (archive_list_text(count and 1) equals "3") or else not (archive_main_path(database) equals original):
        return 7
    if sql_close(database) is not equal to 0:
        return 8
    set memory to archive_open(":memory:")
    if memory equals 0 or else not (archive_main_path(memory) equals "") or else sql_close(memory) is not equal to 0:
        return 9
    display "PASS: main archive path survives temp and attached schemas; in-memory archives correctly have no reopenable path."
    return 0
