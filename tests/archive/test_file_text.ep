import "../../app/archive/file_text"
import "fs"
import "../../app/archive/file_stage"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set path to get_argument(1)
    set original to "café ☕\nSecond line."
    if write_file(path and original) is not equal to 1:
        return 1
    set read to file_text_read(path and ep_sha256(original) and string_length(original) and 1)
    if not (ptr_to_str(get_list(read and 0)) equals "verified") or else not (ptr_to_str(get_list(read and 1)) equals original):
        return 1
    set batch to 1
    repeat while batch is less than 9:
        set read to file_text_window(path and ep_sha256(original) and string_length(original) and batch and 3 and 3)
        if not (ptr_to_str(get_list(read and 0)) equals "verified") or else not (ptr_to_str(get_list(read and 1)) equals "é ☕") or else get_list(read and 2) is not equal to 3:
            return 1
        set read to file_text_window(path and ep_sha256(original) and string_length(original) and batch and 999 and 3)
        if not (ptr_to_str(get_list(read and 0)) equals "verified") or else string_length(ptr_to_str(get_list(read and 1))) is not equal to 0 or else get_list(read and 2) is not equal to 0:
            return 1
        set batch to batch + 1
    set read to file_text_read(path and "wrong" and string_length(original) and 65536)
    if not (ptr_to_str(get_list(read and 0)) equals "integrity-failed") or else string_length(ptr_to_str(get_list(read and 1))) is not equal to 0:
        return 1
    set read to file_text_read(path and ep_sha256(original) and 1 and 65536)
    if not (ptr_to_str(get_list(read and 0)) equals "integrity-failed"):
        return 1
    set read to file_text_read(path and ep_sha256(original) and string_length(original) + 1 and 65536)
    if not (ptr_to_str(get_list(read and 0)) equals "integrity-failed"):
        return 1
    if write_file(path and "") is not equal to 1:
        return 1
    set read to file_text_read(path and ep_sha256("") and 0 and 1)
    if not (ptr_to_str(get_list(read and 0)) equals "verified"):
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set invalid_path to concat(path and ".invalid")
    set descriptor to file_stage_open(library and invalid_path)
    set bytes to create_list()
    set added to append_list(bytes and 255)
    if descriptor is less than 0 or else file_stage_write(library and descriptor and get_list_data_ptr(bytes) and 1) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    set digest to file_digest(invalid_path and 1)
    set read to file_text_window(invalid_path and ptr_to_str(get_list(digest and 1)) and 1 and 1 and 999 and 1)
    if not (ptr_to_str(get_list(read and 0)) equals "unsupported-text") or else string_length(ptr_to_str(get_list(read and 1))) is not equal to 0:
        return 1
    set null_path to concat(path and ".null")
    set descriptor to file_stage_open(library and null_path)
    set cleared to set_list(bytes and 0 and 0)
    if descriptor is less than 0 or else file_stage_write(library and descriptor and get_list_data_ptr(bytes) and 1) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    set digest to file_digest(null_path and 1)
    set read to file_text_read(null_path and ptr_to_str(get_list(digest and 1)) and 1 and 1)
    if not (ptr_to_str(get_list(read and 0)) equals "unsupported-text") or else string_length(ptr_to_str(get_list(read and 1))) is not equal to 0 or else ep_dlclose(library) is not equal to 0:
        return 1
    display "PASS: exact UTF-8 text, one-byte reads, range boundaries across batches 1–8, end cursor, hash mismatch, length mismatch, no unverified text empty file, malformed UTF-8 and binary NUL rejection."
    return 0
