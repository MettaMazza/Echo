import "../../app/archive/attachment_restore"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set destination to get_argument(3)
    set root to get_argument(4)
    set before to file_digest(destination and 65536)
    if not (ptr_to_str(get_list(before and 0)) equals "verified"):
        return 1
    set database to sql_open(destination)
    if database equals 0:
        return 1
    if archive_verify_all(database) is not equal to 0 or else attachment_snapshot_verify(database and root) is not equal to 0 or else attachment_restore_start_allowed(database) is not equal to 0:
        display "FAIL: restored archive, attachment bytes or historical execution gate"
        return 1
    set closed to sql_close(database)
    if closed is not equal to 0:
        return 1
    if attachment_restore(get_argument(1) and get_argument(2) and destination and root) equals 0:
        display "FAIL: duplicate restore accepted"
        return 1
    set after to file_digest(destination and 65536)
    if not (ptr_to_str(get_list(after and 0)) equals "verified") or else not (ptr_to_str(get_list(before and 1)) equals ptr_to_str(get_list(after and 1))):
        display "FAIL: duplicate restore changed published database"
        return 1
    display "PASS: restored archive chains, SQLite integrity, every registered attachment digest and length, historical execution hold; duplicate restore rejected with database bytes unchanged."
    return 0
