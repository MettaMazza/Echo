import "../../app/network/media_type"
import "../../app/workspace/workbook_read"
import "../../app/discord/gateway_owner"

define main returning Int:
    if not (network_media_type("Text/HTML; charset=utf-8") equals "text/html") or else not (network_media_type("application/json; charset=\"utf-8\"") equals "application/json"):
        return 1
    if not (network_media_type("text//html; ignored") equals "application/octet-stream") or else not (network_media_type(";charset=utf-8") equals "application/octet-stream"):
        return 2
    if not (workbook_target("xl/workbook.xml" and "../sheets/a.xml") equals "sheets/a.xml") or else not (workbook_target("" and "../../escape.xml") equals ""):
        return 3
    if not (workbook_target("xl/workbook.xml" and "worksheets/../worksheets/sheet1.xml") equals "xl/worksheets/sheet1.xml") or else not (workbook_target("xl/workbook.xml" and "https://example.com/file.xml") equals ""):
        return 4
    if not (workbook_relationships_path("xl/workbook.xml") equals "xl/_rels/workbook.xml.rels"):
        return 5
    set parts to workspace_path_parts("café/世界.txt")
    if parts equals 0 or else length_list(parts) is not equal to 2 or else not (archive_list_text(parts and 1) equals "世界.txt"):
        return 6
    if workspace_path_parts("safe//file") is not equal to 0 or else workspace_path_parts("../file") is not equal to 0 or else workspace_path_parts("safe/./file") is not equal to 0:
        return 7
    if discord_retry_seconds("0.001") is not equal to 1 or else discord_retry_seconds("61.25") is not equal to 62 or else discord_retry_seconds("1..2") is not equal to -1:
        return 8
    display "PASS: MIME parsing, workbook relative relationships, Unicode paths, traversal rejection and Discord retry decimals retain their behavior."
    return 0
