import "../../app/agent/run_state"
import "../../app/archive/history"
import "../../app/archive/snapshot"
import "../../app/context/budget"
import "../../app/transport/http_stream"
import "../../app/transport/socket_write"

define main returning Int:
    if context_remaining(100 and 20) is not equal to 80:
        return 1
    if http_decimal("123") is not equal to 123:
        return 1
    if not (agent_transition_kind("ready" and "generating") equals "model_request"):
        return 1
    display "PASS: agent, history, snapshots, context and transport compile together through shared relative imports."
    return 0
