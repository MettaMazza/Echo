import "../../app/agent/checked_generation"
import "../../app/interaction/autonomy"
import "os"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "user" and "user" and "fixture" and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "user") is not equal to 0:
        return 2
    set body to "{\"messages\":[],\"tools\":[{}],\"tool_choice\":\"auto\"}"
    set profile to "{\"adapter\":\"llama.cpp\"}"
    if not (agent_closing_report_body(database and "run" and profile and body) equals body):
        return 3
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0 or else autonomy_record_pending(database and "run" and "enabled" and 1 and "fixture") is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0 or else autonomy_off(database and "run" and "disabled" and "finished") is not equal to 0:
        return 4
    set closing to provider_json_tokens(agent_closing_report_body(database and "run" and profile and body))
    set options to provider_member(closing and 0 and "chat_template_kwargs")
    if provider_member(closing and 0 and "tools") >= 0 or else not (provider_kind(closing and provider_member(closing and options and "enable_thinking")) equals "false") or else not (provider_kind(closing and provider_member(closing and 0 and "echo_background")) equals "false"):
        return 5
    if archive_append(database and "session" and "guidance" and "user_guidance" and "{\"run_id\":\"run\",\"content\":\"New work\"}" and "fixture") is not equal to 0 or else not (agent_closing_report_body(database and "run" and profile and body) equals body):
        return 6
    if not (provider_scheduled_body("session" and "compaction:fixture" and "{}") equals "{}"):
        return 7
    display "PASS: ordinary turns unchanged; stopped reporting has no tools or reasoning stream; new guidance restores normal mode; blocking compaction stays foreground."
    return sql_close(database)
