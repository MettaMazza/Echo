import "../../app/agent/runner"
import "../fixtures/runner_provider"

define main returning Int:
    if get_argument_count() is less than 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "objective" and "user" and "Remember café." and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "objective") is not equal to 0:
        return 1
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set completed to channel
    spawn runner_fixture(listener and "objective" and completed)
    set status to agent_loop(database and "run" and "fixture" and get_list(listener and 2) and 20 and -1 and 65536)
    set fixture_result to receive from completed
    if not (status equals "completed") or else fixture_result is not equal to 0:
        display "FAIL: automatic runner."
        display status
        return 1
    if archive_verify(database and "session") is not equal to 0:
        return 1
    # A cancellation pending before execution changes durable state without a
    # provider request; a restart does not continue the cancelled run.
    if archive_append(database and "cancel-session" and "cancel-user" and "user" and "cancel fixture" and "fixture") is not equal to 0 or else agent_run_create(database and "cancel-run" and "cancel-session" and "cancel-user") is not equal to 0:
        return 1
    set cancellation to socket_cancellation_create(get_list(listener and 0))
    if cancellation equals 0 or else socket_cancel(cancellation) is not equal to 0:
        return 1
    if not (agent_loop(database and "cancel-run" and "fixture" and get_list(listener and 2) and 20 and get_list(cancellation and 0) and 65536) equals "cancelled"):
        return 1
    if socket_cancellation_close(cancellation) is not equal to 0 or else local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if not (agent_loop(database and "cancel-run" and "fixture" and 1 and 20 and -1 and 65536) equals "cancelled") or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: automatic checked model/tool/observation loop, exact preflight body, real history retrieval, matching next-turn observations, durable completion and cancellation across reopen."
    return 0
