import "../../app/agent/provider_profile"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 2
    if archive_append(database and "session" and "user" and "user" and "Keep my provider stable." and "test") is not equal to 0 or else agent_run_create(database and "run" and "session" and "user") is not equal to 0:
        return 3
    set first to provider_llama_profile("first-model" and 8080)
    set second to provider_llama_profile("second-model" and 8081)
    set invalid to ["{}", "[]", "{\"adapter\":\"unknown\",\"model\":\"m\",\"port\":8080}", "{\"adapter\":\"mlx-lm\",\"model\":\"m\",\"port\":8080}", "{\"adapter\":\"llama.cpp\",\"model\":123,\"port\":8080}", "{\"adapter\":\"llama.cpp\",\"model\":\"m\",\"port\":\"8080\"}", "{\"adapter\":\"llama.cpp\",\"model\":\"m\",\"port\":8080.5}"]
    set index to 0
    repeat while index is less than length_list(invalid):
        if agent_provider_bind(database and "run" and ptr_to_str(get_list(invalid and index))) is not equal to 1:
            display "FAIL: invalid profile permanently bound a run."
            return 10
        set index to index + 1
    if agent_provider_bind(database and "run" and first) is not equal to 0 or else agent_provider_bind(database and "run" and first) is not equal to 0:
        return 4
    if agent_provider_bind(database and "run" and second) is not equal to 2 or else not (agent_provider_read(database and "run") equals first):
        return 5
    if sql_close(database) is not equal to 0:
        return 6
    set database to archive_open(get_argument(1))
    if not (agent_provider_read(database and "run") equals first) or else agent_provider_bind(database and "run" and second) is not equal to 2:
        return 7
    if agent_provider_bind(database and "absent-run" and first) is not equal to 1:
        return 8
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 9
    display "PASS: immutable per-run provider profile, exact retry, conflicting selection rejection, reopen persistence and missing-run rejection."
    return 0
