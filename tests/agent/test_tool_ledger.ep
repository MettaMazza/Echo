import "os"
import "../../app/archive/history"
import "../../app/agent/tool_ledger"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set path to get_argument(1)
    if file_exists(path):
        return 1
    set database to archive_open(path)
    if database equals 0 or else tool_ledger_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "home" and "request" and "tool_call" and "{\"run_id\":\"run-a\",\"call_id\":\"call-a\",\"name\":\"session.read\",\"arguments\":{\"event\":\"source\"}}" and "now") is not equal to 0:
        return 1
    if tool_ledger_queue(database and "run-a" and "wrong-call" and "home" and "request") equals 0:
        return 1
    if tool_ledger_queue(database and "run-a" and "call-a" and "home" and "request") is not equal to 0:
        return 1
    if tool_ledger_claim(database and "run-a" and "call-a") is not equal to 0:
        return 1
    if tool_ledger_claim(database and "run-a" and "call-a") equals 0:
        display "FAIL: two workers claimed one tool call."
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(path)
    if database equals 0:
        return 1
    if tool_ledger_interrupt(database and "run-a" and "call-a") is not equal to 0:
        return 1
    if tool_ledger_claim(database and "run-a" and "call-a") equals 0:
        display "FAIL: uncertain work was blindly retried."
        return 1
    if tool_ledger_confirm_not_executed(database and "run-a" and "call-a" and "request") equals 0:
        return 1
    if archive_append(database and "home" and "reconciliation" and "tool_reconciliation" and "{\"run_id\":\"run-a\",\"call_id\":\"call-a\",\"outcome\":\"verified_not_executed\",\"evidence\":\"Disposable fixture did not dispatch its read.\"}" and "later") is not equal to 0:
        return 1
    if tool_ledger_confirm_not_executed(database and "run-a" and "call-a" and "reconciliation") is not equal to 0:
        return 1
    if tool_ledger_claim(database and "run-a" and "call-a") is not equal to 0:
        return 1
    if archive_append(database and "other" and "wrong-result" and "tool_result" and "{\"run_id\":\"run-a\",\"call_id\":\"call-a\",\"content\":\"Other session\"}" and "later") is not equal to 0:
        return 1
    if tool_ledger_observe(database and "run-a" and "call-a" and "wrong-result") equals 0:
        return 1
    if archive_append(database and "home" and "result" and "tool_result" and "{\"run_id\":\"run-a\",\"call_id\":\"call-a\",\"content\":\"Exact original source.\"}" and "later") is not equal to 0:
        return 1
    if tool_ledger_observe(database and "run-a" and "call-a" and "result") is not equal to 0:
        return 1
    if tool_ledger_claim(database and "run-a" and "call-a") equals 0:
        return 1
    set row to tool_ledger_read(database and "run-a" and "call-a")
    if not (ptr_to_str(get_list(row and 0)) equals "found") or else not (ptr_to_str(get_list(row and 1)) equals "observed") or else not (ptr_to_str(get_list(row and 4)) equals "result"):
        return 1
    if archive_verify(database and "home") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: durable tool claims, duplicate-worker rejection, restart uncertainty, evidence-bound reconciliation and correctly correlated observations."
    return 0
