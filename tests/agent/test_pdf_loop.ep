import "../../app/web/attachments"
import "fs"
import "../../app/agent/run_messages"
import "../../app/archive/history"
import "../fixtures/generation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set database to archive_open(path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Read page two of the attached PDF and cite its source.")
    set session to ptr_to_str(get_list(submitted and 1))
    set run to ptr_to_str(get_list(submitted and 2))
    if web_attachment_register(database and "owner" and session and "note" and get_argument(2) and "source.pdf" and "application/pdf") is not equal to 0:
        return 1
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"read-original\",\"function\":{\"name\":\"attachment_read_text\",\"arguments\":\"{\\\"attachment\\\":\\\"note\\\",\\\"page\\\":1,\\\"offset\\\":0,\\\"characters\\\":100}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set messages to agent_run_messages(database and run)
    set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and concat(",\"tools\":" and concat(session_tool_schemas() and "}"))))
    set generated to agent_generate_local(database and run and "first-request" and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 1
    if agent_tool_step(database and run) is not equal to 0:
        return 1
    if sql_execute(database and "CREATE TRIGGER reject_ready BEFORE UPDATE OF state ON echo_runs WHEN NEW.state='ready' BEGIN SELECT RAISE(ABORT,'fixture transition failure'); END;") is not equal to 0 or else agent_tool_step(database and run) equals 0:
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='agent_observation';"))
    if not (ptr_to_str(get_list(count and 1)) equals "0") or else sql_execute(database and "DROP TRIGGER reject_ready;") is not equal to 0:
        display "FAIL: failed transition left an orphan observation."
        return 1
    repeat while 1 equals 1:
        set row to agent_run_read(database and run)
        if row equals 0:
            return 1
        if ptr_to_str(get_list(row and 2)) equals "ready":
            break
        if agent_tool_step(database and run) is not equal to 0:
            return 1
    # Restart the database connection before constructing the next request.
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(path)
    set messages to agent_run_messages(database and run)
    set tokens to provider_json_tokens(messages)
    if tokens equals 0:
        return 1
    set items to provider_items(tokens and 0)
    if length_list(items) is not equal to 4:
        return 1
    set observation to provider_value(tokens and provider_member(tokens and get_list(items and 3) and "content"))
    set envelope_tokens to provider_json_tokens(observation)
    if provider_member(envelope_tokens and 0 and "source_boundary") < 0:
        return 1
    set observation to agent_json_source(observation and envelope_tokens and provider_member(envelope_tokens and 0 and "observation"))
    set observation_tokens to provider_json_tokens(observation)
    if observation_tokens equals 0:
        return 1
    if not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "text")) equals "Second page: the archive keeps the original."):
        return 1
    set original to file_digest(get_argument(2) and 65536)
    if not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "pages")) equals "2") or else not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "page")) equals "1") or else not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "representation")) equals "pdfkit-page-text") or else string_length(provider_value(observation_tokens and provider_member(observation_tokens and 0 and "extractor"))) equals 0:
        return 1
    if not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "event")) equals "note:attachment") or else not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "sha256")) equals ptr_to_str(get_list(original and 1))):
        return 1
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Page two says the archive keeps the original. Source: note:attachment, page 2.\"},\"finish_reason\":\"stop\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and concat(",\"tools\":" and concat(session_tool_schemas() and "}"))))
    set generated to agent_generate_local(database and run and "second-request" and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 1
    set row to agent_run_read(database and run)
    if not (ptr_to_str(get_list(row and 2)) equals "completed"):
        return 1
    set request to archive_read_event(database and "second-request")
    set tokens to provider_json_tokens(ptr_to_str(get_list(request and 3)))
    if not (provider_value(tokens and provider_member(tokens and 0 and "request_body")) equals body):
        return 1
    set sources to web_run_source_reads(database and session and run)
    set source_tokens to provider_json_tokens(sources)
    set source_items to provider_items(source_tokens and 0)
    if length_list(source_items) is not equal to 1 or else string_contains(sources and "pdfkit-page-text") equals 0 or else string_contains(sources and "source.pdf") equals 0:
        display sources
        return 1
    if not (web_run_source_reads(database and "foreign" and run) equals "[]") or else string_contains(web_session_transcript(database and session) and "source_reads") equals 0:
        return 1
    if archive_verify(database and session) is not equal to 0 or else local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: two live HTTP generation turns around a verified PDF page tool; observations reconstructed after reopen and sent in the saved next request; same run completes with verified history."
    return 0
