import "../../app/rights/quarantine"
import "../../app/web/run_store"
import "../../app/agent/runner"
import "../fixtures/generation_fixture"

define execution_interrupt_fixture with path as Str and mode as Str and charter as Str and writer as Int and completed as Int returning Int:
    set database to archive_open(path)
    set status to 1
    set started to ep_time_now_ms()
    if database is not equal to 0:
        repeat while ep_time_now_ms() - started is less than 5000:
            set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='process_started';"))
            if ptr_to_str(get_list(row and 0)) equals "found" and ptr_to_str(get_list(row and 1)) equals "1":
                set status to 0
                break
            set slept to sleep_ms(10)
        if mode equals "revoke" and status equals 0:
            set status to web_device_revoke(database and "owner")
        if mode equals "crash" and status equals 0:
            set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
            set killed to ep_dlcall2(ep_dlsym(library and "kill") and ep_dlcall0(ep_dlsym(library and "getpid")) and 9)
        if mode equals "quarantine" and status equals 0:
            set decision to protected_emergency_begin(database and charter and "fixture-secret" and "process-emergency" and "fixture-node" and "quarantine" and "Stop the launched fixture process")
            if not (decision equals "recorded"):
                set status to 1
        set closed to sql_close(database)
    if mode equals "stop" or else status is not equal to 0:
        set closed to net_close(writer)
    send status to completed
    return 0

define main returning Int:
    if not (get_argument_count() equals 5 or else get_argument_count() equals 6) or else file_exists(get_argument(1)):
        return 1
    set configured to set_env("ECHO_WORKSPACE_ROOT" and get_argument(2))
    set configured to set_env("ECHO_EXECUTION_RUNTIME" and get_argument(3))
    set mode to get_argument(4)
    set host_mode to mode equals "host-revoke" or else mode equals "host-stop"
    if mode equals "host-revoke":
        set mode to "revoke"
    if mode equals "host-stop":
        set mode to "stop"
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Control fixture" and "fixture-secret") is not equal to 0:
        return 1
    if host_mode:
        if not (tool_authority_schema(database) equals "applied") or else not (principal_host_role(database and "host-grant" and "device:owner" and "admin" and "Host execution fixture") equals "recorded"):
            return 7
    set charter to ""
    if mode equals "quarantine":
        if get_argument_count() is not equal to 6:
            return 2
        set charter to get_argument(5)
        if not (protected_quarantine_schema(database) equals "applied") or else not (principal_host_role(database and "fixture-steward" and "device:owner" and "steward" and "Disposable fixture") equals "recorded"):
            return 3
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Run a waiting command, then stop it.")
    set session to ptr_to_str(get_list(submitted and 1))
    set run to ptr_to_str(get_list(submitted and 2))
    set listener to local_socket_listen(0)
    set arguments to "{\"program\":\"/bin/sleep\",\"arguments\":[\"60\"]}"
    set data to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"execute\",\"function\":{\"name\":\"workspace_execute\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    if host_mode:
        set data to ptr_to_str(string_replace(data and "workspace_execute" and "host_execute"))
    set generated_done to channel
    spawn generation_fixture(listener and data and generated_done)
    set generated to agent_generate_local(database and run and "generation" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from generated_done
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    set cancellation to socket_cancellation_create(get_list(listener and 0))
    set interrupted to channel
    set monitor_mode to concat(mode and "")
    spawn execution_interrupt_fixture(get_argument(1) and monitor_mode and charter and get_list(cancellation and 1) and interrupted)
    set dispatched to agent_tool_step_cancellable(database and run and get_list(cancellation and 0))
    set checked to receive from interrupted
    if mode equals "stop" or else checked is not equal to 0:
        set changed to set_list(cancellation and 1 and -1)
    if dispatched is not equal to 0 or else checked is not equal to 0:
        display "FAIL: controlled execution dispatch"
        return 1
    set row to agent_run_read(database and run)
    if not (ptr_to_str(get_list(row and 2)) equals "cancelled"):
        return 1
    if not (agent_loop(database and run and "fixture" and 1 and 1 and -1 and 65536) equals "cancelled"):
        return 1
    set receipt to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='process_finished' AND json_extract(payload,'$.wait_status')='9';"))
    if not (ptr_to_str(get_list(receipt and 0)) equals "found") or else not (ptr_to_str(get_list(receipt and 1)) equals "1"):
        return 1
    if mode equals "quarantine":
        set evidence to history_collect_one(archive_prepare(database and "SELECT payload FROM echo_events WHERE kind='tool_result' AND json_extract(payload,'$.call_id')='execute';"))
        if not (archive_list_text(evidence and 0) equals "found") or else string_contains(archive_list_text(evidence and 1) and "exit_event") equals 0 or else string_contains(archive_list_text(evidence and 1) and "command-may-have-executed") equals 0:
            return 4
        if not (protected_emergency_disclose(database and charter and "fixture-secret" and "process-emergency" and "Fixture interruption" and "Only fixture process stopped" and "Process reaped; node quarantined" and "No hidden changes") equals "recorded") or else not (protected_quarantine_release(database and charter and "fixture-secret" and "process-emergency" and "Fixture recovery verified") equals "recorded"):
            return 5
        set continued to web_submit_owned(database and "owner" and "after-emergency" and session and "Continue after verified process termination")
        if not (archive_list_text(continued and 0) equals "accepted"):
            return 6
    set closed to socket_cancellation_close(cancellation)
    set closed to local_socket_close(listener)
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display concat("PASS: " and concat(mode and " after actual launch stopped/reaped command and cancelled run before another model turn."))
    return 0
