import "../../app/agent/media_route"

define main returning Int:
    set primary to "{\"modalities\":{\"vision\":true,\"audio\":false,\"video\":true}}"
    set omni to "{\"modalities\":{\"vision\":true,\"audio\":true,\"video\":true}}"
    set text to "[{\"role\":\"user\",\"content\":\"hello\"}]"
    set image to "[{\"role\":\"user\",\"content\":[{\"type\":\"image_url\",\"image_url\":{\"url\":\"fixture\"}}]}]"
    set audio to "[{\"role\":\"user\",\"content\":[{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"fixture\",\"format\":\"wav\"}}]}]"
    set video to "[{\"role\":\"user\",\"content\":[{\"type\":\"input_video\"},{\"type\":\"input_audio\"}]}]"
    if not (agent_media_route_required(text and primary) equals "none"):
        return 1
    if not (agent_media_route_required(image and primary) equals "none"):
        return 2
    if not (agent_media_route_required(audio and primary) equals "unsupported-input-audio"):
        return 3
    if not (agent_media_route_required(video and primary) equals "unsupported-input-audio"):
        return 4
    if not (agent_media_route_required(audio and omni) equals "none"):
        return 5
    if not (agent_media_route_required(audio and "{}") equals "modality-metadata-required"):
        return 6
    if not (agent_media_route_required("[{\"role\":\"user\",\"content\":[{\"type\":\"other\"}]}]" and omni) equals "unsupported-content-part"):
        return 7
    display "PASS: supported images stay on primary; audio and combined video require audio capability; missing metadata and unknown parts fail closed."
    return 0
