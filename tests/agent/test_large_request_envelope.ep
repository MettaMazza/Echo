import "../../app/agent/generation"

define main returning Int:
    set builder to create_builder()
    set count to 0
    repeat while count is less than 200000:
        set added to builder_append(builder and "image-data-")
        set count to count + 1
    set body to ptr_to_str(builder_to_string(builder))
    set index to 0
    repeat while index is less than 256:
        set payload to agent_request_envelope("run" and "parent" and body)
        set tokens to provider_json_tokens(payload)
        if tokens equals 0:
            display "FAIL: large request envelope is malformed"
            return 1
        if not (provider_value(tokens and provider_member(tokens and 0 and "run_id")) equals "run") or else not (provider_value(tokens and provider_member(tokens and 0 and "parent_event")) equals "parent") or else not (provider_value(tokens and provider_member(tokens and 0 and "request_body")) equals body):
            display "FAIL: request envelope lost fields"
            return 2
        set index to index + 1
    display "PASS: repeated large request envelopes retain run, parent and complete body."
    return 0
