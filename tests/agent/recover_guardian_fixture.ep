import "../../app/agent/tool_recovery"
import "../../app/web/run_store"

# Run only after the test driver has observed the original worker's SIGKILL.
define main returning Int:
    if get_argument_count() is not equal to 2 or else string_contains(get_argument(1) and "guardian-crash-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set started to ep_time_now_ms()
    repeat while agent_recover_tools_owned(database and "request") is not equal to 0:
        if ep_time_now_ms() - started > 5000:
            return 3
        set slept to sleep_ms(10)
    set row to agent_run_read(database and "request")
    if not (archive_list_text(row and 2) equals "cancelled"):
        return 4
    set result to workspace_guardian_receipt(database and "request" and "execute")
    if string_contains(result and "cancelled") equals 0:
        return 5
    set call to tool_ledger_read(database and "request" and "execute")
    if not (archive_list_text(call and 1) equals "observed") or else agent_recover_tools_owned(database and "request") is not equal to 0:
        return 6
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='process_started';"))
    if not (archive_list_text(count and 1) equals "1"):
        return 7
    set continued to web_submit_owned(database and "owner" and "after-worker-crash" and archive_list_text(row and 0) and "Continue after recovered cancellation")
    if not (archive_list_text(continued and 0) equals "accepted") or else archive_verify(database and archive_list_text(row and 0)) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 8
    display "PASS: guardian survived worker SIGKILL, saved real termination, recovery observed original result and cancelled run without replay, then accepted same-session continuation."
    return 0
