import "../../app/maintenance/protocol_repair"
import "../../app/web/run_store"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0 or else web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture") is not equal to 0:
        return 2
    set submitted to web_submit_owned(database and "owner" and "run" and "" and "Report the work.")
    set session to archive_list_text(submitted and 1)
    if web_worker_claim(database and "run" and "previous-worker") is not equal to 0:
        return 3
    set payload to concat(agent_event_envelope("run" and "run:user") and ",\"content\":\"<tool_call><function=delegation_status></function></tool_call>\",\"tool_calls\":[]}")
    if archive_append(database and session and "bad-final" and "assistant_final" and payload and "fixture") is not equal to 0 or else sql_execute(database and "UPDATE echo_runs SET state='completed',last_event='bad-final' WHERE run='run'; UPDATE echo_web_workers SET status='completed' WHERE run='run';") is not equal to 0:
        return 4
    set original to archive_read_event(database and "bad-final")
    if recover_legacy_protocol(database and "run" and "bad-final" and "repair" and "fresh-worker") is not equal to 0:
        return 5
    if not (archive_list_text(agent_run_read(database and "run") and 2) equals "ready") or else not (archive_list_text(archive_read_event(database and "bad-final") and 6) equals archive_list_text(original and 6)):
        return 6
    set claimed to history_collect_one(archive_prepare(database and "SELECT worker,status FROM echo_web_workers WHERE run='run';"))
    if not (archive_list_text(claimed and 1) equals "fresh-worker") or else not (archive_list_text(claimed and 2) equals "running"):
        return 7
    if recover_legacy_protocol(database and "run" and "bad-final" and "duplicate" and "another-worker") equals 0:
        return 8
    if archive_verify(database and session) is not equal to 0:
        return 9
    display "PASS: exact malformed legacy final reopened once, original digest retained, fresh worker claimed, repeated repair refused, full archive chain verified."
    return sql_close(database)
