import "../../app/web/attachments"
import "fs"
import "../../app/agent/run_messages"
import "../../app/archive/history"
import "../fixtures/generation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set database to archive_open(path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "List this session workspace.")
    set session to ptr_to_str(get_list(submitted and 1))
    set run to ptr_to_str(get_list(submitted and 2))
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "owner" and session and get_argument(2))
    if root is less than 0:
        return 1
    set original_text to "Workspace source: café survives restart."
    set descriptor to workspace_file_open(library and root and "source.txt" and 1)
    if descriptor is less than 0 or else file_stage_write(library and descriptor and str_to_ptr(original_text) and string_length(original_text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"list-original\",\"function\":{\"name\":\"workspace_list\",\"arguments\":\"{\\\"path\\\":\\\".\\\",\\\"offset\\\":0,\\\"entries\\\":10}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set messages to agent_run_messages(database and run)
    set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and concat(",\"tools\":" and concat(session_tool_schemas() and "}"))))
    set generated to agent_generate_local(database and run and "first-request" and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 1
    if agent_tool_step(database and run) is not equal to 0:
        return 1
    if agent_tool_step(database and run) is not equal to 0:
        return 2
    set row to history_collect_one(archive_prepare(database and "SELECT e.payload FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='list-original' AND t.state='observed';"))
    if not (archive_list_text(row and 0) equals "found") or else string_contains(archive_list_text(row and 1) and "source.txt") equals 0:
        display archive_list_text(row and 1)
        return 3
    if archive_verify(database and session) is not equal to 0:
        return 4
    display "PASS: streamed workspace_list call executes through the normal dispatcher and archives scoped filenames with intact event digests."
    return sql_close(database)
