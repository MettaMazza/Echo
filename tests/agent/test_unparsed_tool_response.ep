import "../../app/agent/run_messages"

define publish_fixture with database as Int and request as Str and content as Str returning Int:
    set row to agent_run_read(database and "run")
    set envelope to agent_request_envelope("run" and archive_list_text(row and 3) and "{}")
    if archive_append(database and "session" and request and "model_request" and envelope and "fixture") is not equal to 0 or else agent_run_transition(database and "run" and "ready" and archive_list_text(row and 3) and "generating" and request) is not equal to 0:
        return 1
    set state to chat_stream_create()
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"content\":" and concat(provider_quote(content) and "},\"finish_reason\":\"stop\"}]}"))
    if chat_stream_accept(state and delta) is not equal to 0 or else chat_stream_accept(state and "[DONE]") is not equal to 0 or else chat_stream_finish(state and "eof") is not equal to 0:
        return 2
    return agent_generation_publish(database and "run" and "session" and request and state and "0")

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if agent_run_schema(database) is not equal to 0 or else archive_append(database and "session" and "user" and "user" and "Complete the assigned work." and "fixture") is not equal to 0 or else agent_run_create(database and "run" and "session" and "user") is not equal to 0:
        return 2
    set protocol to "<tool_call>\n<function=delegation_status>\n<parameter=run>child</parameter>\n</function>\n</tool_call>"
    if publish_fixture(database and "request-one" and protocol) is not equal to 0:
        return 3
    set row to agent_run_read(database and "run")
    set event to archive_read_event(database and "request-one:response")
    if not (archive_list_text(row and 2) equals "ready") or else not (archive_list_text(event and 2) equals "agent_recovered") or else string_contains(archive_list_text(event and 3) and "unparsed-tool-response") equals 0:
        return 4
    if string_contains(agent_run_messages(database and "run") and "That text was not executed") equals 0:
        return 5
    set calls to history_collect_one(archive_prepare(database and "SELECT count(*) FROM echo_events WHERE kind='tool_call';"))
    if not (archive_list_text(calls and 1) equals "0"):
        return 6
    if publish_fixture(database and "request-two" and protocol) is not equal to 0 or else not (archive_list_text(agent_run_read(database and "run") and 2) equals "failed"):
        return 7
    if archive_verify(database and "session") is not equal to 0:
        return 8
    display "PASS: raw protocol is retained as recovery evidence, never executed or finalized; a repeated malformed reply stops with an explicit failure instead of looping."
    return sql_close(database)
