import "../../app/web/attachments"
import "fs"
import "../../app/agent/run_messages"
import "../../app/archive/history"
import "../fixtures/generation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set database to archive_open(path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Read source.txt in this session workspace.")
    set session to ptr_to_str(get_list(submitted and 1))
    set run to ptr_to_str(get_list(submitted and 2))
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "owner" and session and get_argument(2))
    if root is less than 0:
        return 1
    set original_text to "Workspace source: café survives restart."
    set descriptor to workspace_file_open(library and root and "source.txt" and 1)
    if descriptor is less than 0 or else file_stage_write(library and descriptor and str_to_ptr(original_text) and string_length(original_text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"read-original\",\"function\":{\"name\":\"workspace_read_text\",\"arguments\":\"{\\\"path\\\":\\\"source.txt\\\",\\\"offset\\\":0,\\\"characters\\\":100}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set messages to agent_run_messages(database and run)
    set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and concat(",\"tools\":" and concat(session_tool_schemas() and "}"))))
    set generated to agent_generate_local(database and run and "first-request" and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 1
    if agent_tool_step(database and run) is not equal to 0:
        return 1
    if sql_execute(database and "CREATE TRIGGER reject_ready BEFORE UPDATE OF state ON echo_runs WHEN NEW.state='ready' BEGIN SELECT RAISE(ABORT,'fixture transition failure'); END;") is not equal to 0 or else agent_tool_step(database and run) equals 0:
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='agent_observation';"))
    if not (ptr_to_str(get_list(count and 1)) equals "0") or else sql_execute(database and "DROP TRIGGER reject_ready;") is not equal to 0:
        display "FAIL: failed transition left an orphan observation."
        return 1
    repeat while 1 equals 1:
        set row to agent_run_read(database and run)
        if row equals 0:
            return 1
        if ptr_to_str(get_list(row and 2)) equals "ready":
            break
        if agent_tool_step(database and run) is not equal to 0:
            return 1
    # Change the source after observation. Reconstructed messages must use the
    # archived observation, not silently reread today's workspace contents.
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "owner" and session and get_argument(2))
    set remove_file to ep_dlsym(library and "unlinkat")
    if root is less than 0 or else remove_file equals 0 or else ep_dlcall3(remove_file and root and str_to_ptr("source.txt") and 0) is not equal to 0:
        return 1
    set descriptor to workspace_file_open(library and root and "source.txt" and 1)
    set changed_text to "Changed after the tool observation."
    if descriptor is less than 0 or else file_stage_write(library and descriptor and str_to_ptr(changed_text) and string_length(changed_text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    # Restart the database connection before constructing the next request.
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(path)
    set messages to agent_run_messages(database and run)
    set tokens to provider_json_tokens(messages)
    if tokens equals 0:
        return 1
    set items to provider_items(tokens and 0)
    if length_list(items) is not equal to 3:
        return 1
    set observation to provider_value(tokens and provider_member(tokens and get_list(items and 2) and "content"))
    set observation_tokens to provider_json_tokens(observation)
    if observation_tokens equals 0:
        return 1
    if not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "text")) equals original_text):
        return 1
    if not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "path")) equals "source.txt") or else not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "sha256")) equals ep_sha256(original_text)) or else not (provider_value(observation_tokens and provider_member(observation_tokens and 0 and "bytes")) equals int_to_string(string_length(original_text))):
        return 1
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"The workspace source says café survives restart.\"},\"finish_reason\":\"stop\"}]}"
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set body to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and concat(messages and concat(",\"tools\":" and concat(session_tool_schemas() and "}"))))
    set generated to agent_generate_local(database and run and "second-request" and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 1
    set row to agent_run_read(database and run)
    if not (ptr_to_str(get_list(row and 2)) equals "completed"):
        return 1
    set request to archive_read_event(database and "second-request")
    set tokens to provider_json_tokens(ptr_to_str(get_list(request and 3)))
    if not (provider_value(tokens and provider_member(tokens and 0 and "request_body")) equals body):
        return 1
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls WHERE state='observed';"))
    if not (ptr_to_str(get_list(count and 1)) equals "1"):
        return 1
    if archive_verify(database and session) is not equal to 0 or else local_socket_close(listener) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: two scripted live HTTP generation turns around a workspace file tool; original observations reconstructed after file replacement and reopen and sent in the saved next request; same run completes with verified history."
    return 0
