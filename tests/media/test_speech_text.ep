import "../../app/media/speech_text"

define main returning Int:
    set sample to "# Hello **Maria**\n- Read *this* and [the page](https://example.com/a).\n> Use `Echo` now.\n```python\nprint(1)\n```\nGoodbye."
    set result to speech_plain_text(sample)
    if string_contains(result and "*") or else string_contains(result and "https:") or else string_contains(result and "print(1)") or else string_contains(result and "`"):
        display result
        return 1
    if string_contains(result and "Hello Maria") equals 0 or else string_contains(result and "Read this and the page.") equals 0 or else string_contains(result and "Use Echo now.") equals 0 or else string_contains(result and "Goodbye.") equals 0:
        display result
        return 2
    if not (speech_plain_text("A normal sentence, with punctuation!") equals "A normal sentence, with punctuation!"):
        return 3
    display "PASS: speech keeps prose and link labels, removes Markdown and fenced code, preserves ordinary punctuation."
    return 0
