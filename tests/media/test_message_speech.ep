import "../../app/web/message_speech"

# Real Kokoro process, isolated archive; no model invocation is needed.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set configured to set_env("ECHO_VOICE_PROFILE" and get_argument(2))
    set configured to set_env("ECHO_SPEECH_ROOT" and get_argument(3))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Speech test" and "fixture-secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Fixture question")
    set session to ptr_to_str(get_list(submitted and 1))
    if archive_append(database and session and "answer" and "assistant_final" and "{\"content\":\"The **silver lighthouse** has *nine windows*.\"}" and "fixture") is not equal to 0:
        return 4
    if not (web_message_speak(database and "foreign" and "answer") equals "{\"status\":\"not-found\"}"):
        return 5
    set first to web_message_speak(database and "owner" and "answer")
    set tokens to provider_json_tokens(first)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "complete"):
        display first
        return 6
    if not (first equals web_message_speak(database and "owner" and "answer")):
        return 7
    set audio to web_message_audio(database and session and "unused-run" and "answer")
    if string_contains(audio and "audio/wav") equals 0:
        return 8
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='provider_helper_dispatch';"))
    if not (ptr_to_str(get_list(count and 1)) equals "1") or else archive_verify(database and session) is not equal to 0:
        return 9
    set closed to sql_close(database)
    display "PASS: direct saved-message Kokoro speech, foreign device rejected, repeated request reuses exact result, one synthesis dispatch, durable audio association and verified archive."
    return closed
