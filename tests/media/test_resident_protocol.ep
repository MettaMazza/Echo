import "../../app/media/resident_protocol"
import "../../app/media/voice_request"

define main returning Int:
    set profile to "{\"engine\":\"qwen3-tts-resident\",\"executable\":\"/host/client\",\"voice\":\"warm\",\"engine_revision\":\"resident-test\",\"resident_config\":\"/private/client.json\"}"
    set arguments to voice_request_arguments(profile)
    if arguments equals 0 or else length_list(arguments) is not equal to 1 or else not (archive_list_text(arguments and 0) equals "/private/client.json"):
        return 8
    set roots to ["discord-speech", "host-speech"]
    if not (resident_job_relative("/private" and roots and "/private/discord-speech/job-1") equals "discord-speech/job-1"):
        return 1
    for each bad in ["/private/discord-speech/../secret", "/private/discord-speech/nested/job", "/private/other/job", "/private2/discord-speech/job", "/private/discord-speech", "/private/host-speech//job"]:
        if string_length(resident_job_relative("/private" and roots and ptr_to_str(bad))) > 0:
            return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set pair to resident_pair(library)
    if pair equals 0:
        return 3
    set bytes to "Dependency log\ntts_job_status=0\n"
    set sent to socket_write_all(library and get_list(pair and 0) and -1 and str_to_ptr(bytes) and string_length(bytes))
    if not (archive_list_text(sent and 0) equals "sent"):
        return 4
    if resident_wait_marker(library and get_list(pair and 1) and -1 and "tts_job_status=0") is not equal to 0:
        return 5
    set bytes to "tts_job_status=5\n"
    set sent to socket_write_all(library and get_list(pair and 0) and -1 and str_to_ptr(bytes) and string_length(bytes))
    if resident_wait_marker(library and get_list(pair and 1) and -1 and "tts_job_status=0") equals 0:
        return 6
    set stop to socket_cancellation_create(library)
    set stopped to socket_cancel(stop)
    if resident_wait_marker(library and get_list(pair and 1) and get_list(stop and 0) and "tts_job_status=0") equals 0:
        return 7
    set closed to socket_cancellation_close(stop)
    set closed to net_close(get_list(pair and 0))
    set closed to net_close(get_list(pair and 1))
    display "PASS: resident root restrictions, worker framing and cancelled waits."
    return 0
