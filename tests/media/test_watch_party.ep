import "../../app/web/routes"

define watch_test_status with value as Str and expected as Str returning Int:
    set tokens to provider_json_tokens(value)
    return provider_value(tokens and provider_member(tokens and 0 and "status")) equals expected

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    for each name in ["owner","stranger"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
        set submitted to web_submit_owned(database and device and device and "" and "Watch fixture")
        if not (archive_list_text(submitted and 0) equals "accepted"):
            return 4
    set session to "session:owner"
    if web_attachment_register(database and "owner" and session and "movie" and get_argument(2) and "synthetic.mp4" and "video/mp4") is not equal to 0:
        return 5
    set start to "{\"action\":\"start\",\"revision\":\"\",\"attachment\":\"movie\",\"duration_ms\":6000,\"mode\":\"continuous\"}"
    if not watch_test_status(watch_party_request(database and "stranger" and session and start and "user" and "unauthorised") and "not-authorized"):
        return 6
    if not watch_test_status(watch_party_request(database and "owner" and session and start and "echo" and "echo-start") and "not-authorized"):
        return 7
    set result to watch_party_request(database and "owner" and session and start and "user" and "start")
    if not watch_test_status(result and "active"):
        display result
        return 8
    set play to "{\"action\":\"play\",\"revision\":\"watch:session:owner:start\",\"position_ms\":1200}"
    if not watch_test_status(watch_party_request(database and "owner" and session and play and "user" and "play") and "active"):
        return 9
    if video_watch_allowed(database and session and video_request("{\"attachment\":\"movie\",\"action\":\"segment\",\"timestamp_ms\":0,\"duration_ms\":1200}")) is not equal to 1:
        return 18
    if video_watch_allowed(database and session and video_request("{\"attachment\":\"movie\",\"action\":\"segment\",\"timestamp_ms\":1000,\"duration_ms\":1000}")) is not equal to 0:
        return 19
    if video_watch_allowed(database and session and video_request("{\"attachment\":\"movie\",\"action\":\"audiovisual\",\"timestamp_ms\":0}")) is not equal to 0:
        return 20
    if sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='owner';") is not equal to 0:
        return 33
    set scheduled to web_watch_schedule(database and "owner" and session)
    if not (archive_list_text(scheduled and 0) equals "accepted"):
        display archive_list_text(scheduled and 0)
        return 34
    set segment_run to archive_list_text(scheduled and 2)
    if not (archive_list_text(web_watch_schedule(database and "owner" and session) and 0) equals "watch-busy"):
        return 35
    if not (archive_list_text(web_watch_schedule(database and "stranger" and session) and 0) equals "not-authorized"):
        return 36
    set pause to "{\"action\":\"pause\",\"revision\":\"watch:session:owner:play\",\"reason\":\"I want to discuss this scene.\"}"
    set result to watch_party_request(database and "owner" and session and pause and "echo" and "pause")
    if not watch_test_status(result and "active") or else string_contains(result and "\"first_speaker\":\"echo\"") equals 0 or else string_contains(result and "\"playing\":false") equals 0:
        display result
        return 10
    if not watch_test_status(watch_party_request(database and "owner" and session and play and "user" and "stale-play") and "watch-conflict"):
        return 11
    set human to "{\"action\":\"pause\",\"revision\":\"watch:session:owner:pause\",\"position_ms\":1300}"
    set result to watch_party_request(database and "owner" and session and human and "user" and "human-pause")
    if string_contains(result and "\"first_speaker\":\"user\"") equals 0:
        return 12
    set stopped to history_collect_one(checkpoint_prepare(database and "SELECT run FROM echo_cancel_requests WHERE run=?;" and [segment_run]))
    if not (archive_list_text(stopped and 0) equals "found"):
        return 37
    if not (archive_list_text(web_watch_schedule(database and "owner" and session) and 0) equals "watch-paused"):
        return 38
    set backwards to "{\"action\":\"seek\",\"revision\":\"watch:session:owner:human-pause\",\"position_ms\":500}"
    if not watch_test_status(watch_party_request(database and "owner" and session and backwards and "user" and "seek-back") and "active"):
        return 22
    if video_watch_allowed(database and session and video_request("{\"attachment\":\"movie\",\"action\":\"segment\",\"timestamp_ms\":0,\"duration_ms\":1000}")) is not equal to 0:
        return 23
    if archive_list_text(video_request("{\"attachment\":\"movie\",\"action\":\"segment\",\"timestamp_ms\":0,\"duration_ms\":10001}") and 0) equals "ready":
        return 24
    if archive_list_text(video_request("{\"attachment\":\"movie\",\"action\":\"segment\",\"timestamp_ms\":0,\"duration_ms\":0}") and 0) equals "ready":
        return 25
    # Coverage cannot jump over an unseen gap or cross media identities.
    if watch_analysis_position(database and session and "movie" and 6000) is not equal to 0:
        return 26
    if archive_append(database and session and "coverage-later" and "watch_segment_observed" and "{\"attachment\":\"movie\",\"start_ms\":1000,\"end_ms\":2000}" and "test") is not equal to 0:
        return 27
    if watch_analysis_position(database and session and "movie" and 6000) is not equal to 0:
        return 28
    if archive_append(database and session and "coverage-first" and "watch_segment_observed" and "{\"attachment\":\"movie\",\"start_ms\":0,\"end_ms\":1000}" and "test") is not equal to 0:
        return 29
    if watch_analysis_position(database and session and "movie" and 6000) is not equal to 2000:
        return 30
    if watch_analysis_position(database and session and "movie" and 500) is not equal to 500:
        return 31
    if watch_analysis_position(database and session and "different-movie" and 6000) is not equal to 0:
        return 32
    set finish to "{\"action\":\"end\",\"revision\":\"watch:session:owner:seek-back\",\"reason\":\"I do not want to keep watching.\"}"
    if not watch_test_status(watch_party_request(database and "owner" and session and finish and "echo" and "end") and "ended"):
        return 13
    if video_watch_allowed(database and session and video_request("{\"attachment\":\"movie\",\"action\":\"segment\",\"timestamp_ms\":0,\"duration_ms\":1000}")) is not equal to 0:
        return 21
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not watch_test_status(watch_party_latest(database and session) and "ended"):
        return 14
    set resume to "{\"action\":\"play\",\"revision\":\"watch:session:owner:end\",\"position_ms\":1300}"
    if not watch_test_status(watch_party_request(database and "owner" and session and resume and "user" and "resume") and "watch-ended"):
        return 15
    if not watch_test_status(watch_party_request(database and "owner" and session and finish and "echo" and "end") and "ended"):
        return 16
    if not (archive_list_text(web_attachment_owned(database and "owner" and "movie") and 0) equals "found"):
        return 17
    set alias to "{\"attachment\":\"current\",\"action\":\"segment\",\"timestamp_ms\":0,\"duration_ms\":1200}"
    if not (archive_list_text(video_request(video_bound_arguments(database and segment_run and alias)) and 1) equals "movie"):
        return 39
    if not (video_bound_arguments(database and "ordinary-run" and alias) equals alias):
        return 40
    if sql_execute(database and "UPDATE echo_runs SET state='completed';") is not equal to 0:
        return 41
    set checkpoint_start to "{\"action\":\"start\",\"revision\":\"watch:session:owner:end\",\"attachment\":\"movie\",\"duration_ms\":600000,\"mode\":\"checkpoints\"}"
    if not watch_test_status(watch_party_request(database and "owner" and session and checkpoint_start and "user" and "checkpoint-start") and "active"):
        return 42
    set checkpoint_play to "{\"action\":\"play\",\"revision\":\"watch:session:owner:checkpoint-start\",\"position_ms\":300000}"
    if not watch_test_status(watch_party_request(database and "owner" and session and checkpoint_play and "user" and "checkpoint-play") and "active"):
        return 43
    if archive_append(database and session and "coverage-checkpoint" and "watch_segment_observed" and "{\"attachment\":\"movie\",\"start_ms\":2000,\"end_ms\":300000}" and "test-fixture-only") is not equal to 0:
        return 44
    # Simulate a host interruption after its checkpoint pause but before admission.
    set interrupted_pause to "{\"action\":\"pause\",\"revision\":\"watch:session:owner:checkpoint-play\",\"reason\":\"We reached the agreed checkpoint; I will start the discussion.\"}"
    if not watch_test_status(watch_party_request(database and "owner" and session and interrupted_pause and "echo" and "watch-checkpoint:watch:session:owner:checkpoint-start:300000") and "active"):
        return 48
    set discussion to web_watch_schedule(database and "owner" and session)
    if not (archive_list_text(discussion and 0) equals "accepted"):
        display archive_list_text(discussion and 0)
        return 45
    set checkpoint_state to watch_party_latest(database and session)
    if string_contains(checkpoint_state and "\"playing\":false") equals 0 or else string_contains(checkpoint_state and "\"first_speaker\":\"echo\"") equals 0:
        return 46
    if not (archive_list_text(web_watch_schedule(database and "owner" and session) and 0) equals "watch-busy"):
        return 47
    display "PASS: watch ownership, turn-taking, end, stale controls, segment budget, no lookahead, seek-back invalidation, restart persistence and original preservation"
    return sql_close(database)
