import "../../app/security/group_speech"
import "../../app/web/message_speech"

# Actual local synthesis from a member other than the source message sender.
define main returning Int:
    if (get_argument_count() is not equal to 4 and get_argument_count() is not equal to 5) or else file_exists(get_argument(1)):
        return 1
    set configured to set_env("ECHO_VOICE_PROFILE" and get_argument(2))
    set configured to set_env("ECHO_SPEECH_ROOT" and get_argument(3))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if not (group_speech_schema(database) equals "applied"):
        return 20
    for each name in ["a","owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite-owner" and "g" and "device:owner" and "invited" and 1) equals "recorded") or else not (group_change(database and "owner" and "join-owner" and "g" and "device:owner" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 21
    set session to "shared"

    if archive_append(database and session and "answer" and "assistant_final" and "{\"content\":\"The **shared lighthouse** has *nine windows*.\"}" and "fixture") is not equal to 0:
        return 25
    if get_argument_count() equals 5:
        return sql_close(database)
    if not (web_message_speak(database and "foreign" and "answer") equals "{\"status\":\"not-found\"}"):
        return 26
    set first to web_message_speak(database and "owner" and "answer")
    set tokens to provider_json_tokens(first)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "complete"):
        display first
        return 27
    if not (web_message_speak(database and "owner" and "answer") equals first):
        return 28
    set attachment to provider_value(tokens and provider_member(tokens and 0 and "attachment"))
    if not (archive_list_text(web_attachment_owned(database and "a" and attachment) and 0) equals "found") or else not (archive_list_text(web_attachment_owned(database and "foreign" and attachment) and 0) equals "end"):
        return 29
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='provider_helper_dispatch';"))
    if not (archive_list_text(count and 1) equals "1"):
        return 30
    set origin to history_collect_one(archive_prepare(database and "SELECT j.device,a.device FROM echo_group_speech_jobs j JOIN echo_tool_authority a ON a.run=j.job;"))
    if not (archive_list_text(origin and 1) equals "owner") or else not (archive_list_text(origin and 2) equals "owner"):
        return 31
    if not (group_change(database and "a" and "remove-owner" and "g" and "device:owner" and "removed" and 3) equals "recorded") or else not (web_message_speak(database and "owner" and "answer") equals "{\"status\":\"not-found\"}") or else not (archive_list_text(web_attachment_owned(database and "owner" and attachment) and 0) equals "end"):
        return 32
    if archive_verify(database and session) is not equal to 0:
        return 33
    display "PASS: direct shared Speak produced real audio once, exact clicking member frozen, both-member delivery, outsider/departure denial and archive integrity."
    return sql_close(database)
