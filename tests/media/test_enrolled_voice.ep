import "../../app/web/routes"

define main returning Int:
    set profile to "{\"engine\":\"qwen3-tts-enrolled\",\"executable\":\"/host/echo_speak\",\"voice\":\"echo-rounded-08-pitch-up\",\"engine_revision\":\"test\",\"python_library\":\"/host/python.dylib\",\"python_executable\":\"/host/python\",\"model\":\"/host/model\",\"conditioning\":\"/private/conditioning\",\"reference\":\"/private/reference.wav\",\"ffmpeg\":\"/host/ffmpeg\"}"
    set args to voice_request_arguments(profile)
    if args equals 0 or else length_list(args) is not equal to 6:
        return 1
    if not (archive_list_text(args and 3) equals "/private/conditioning"):
        return 2
    if voice_request_arguments("{\"engine\":\"qwen3-tts-enrolled\",\"executable\":\"/host/helper\",\"voice\":\"echo\",\"engine_revision\":\"test\"}") is not equal to 0:
        return 3
    if string_length(voice_request_text("{\"text\":\"hello\",\"conditioning\":\"/attacker/vector\"}")) is not equal to 0:
        return 4
    if not (voice_request_text("{\"text\":\"$(touch /tmp/not-a-command)\"}") equals "$(touch /tmp/not-a-command)"):
        return 5
    display "PASS: enrolled host profile, fixed argument order, missing asset rejection and no model-selected conditioning or shell interpretation"
    return 0
