import "../../app/providers/python_scope"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set library to native_python_open(get_argument(1) and get_argument(2))
    if library equals 0:
        return 2
    set scope to create_list()
    set module to python_scope_import(scope and library and "subprocess")
    set run to python_scope_attribute(scope and library and module and "run")
    set args to python_scope_json(scope and library and "[\"/bin/sleep\",\"30\"]")
    set options to python_scope_json(scope and library and "{\"check\":true,\"timeout\":1}")
    set started to ep_time_now_ms()
    set result to python_scope_call(scope and library and run and [args] and options)
    set elapsed to ep_time_now_ms() - started
    if result is not equal to 0 or else elapsed < 900 or else elapsed > 5000:
        return 3
    set clear to ep_dlsym(library and "PyErr_Clear")
    set cleared to ep_dlcall0(clear)
    set next_args to python_scope_json(scope and library and "[\"/usr/bin/true\"]")
    set next_result to python_scope_call(scope and library and run and [next_args] and options)
    if next_result equals 0:
        return 4
    set closed to python_scope_close(scope and library)
    display "Speech subprocess timeout and subsequent call passed."
    return 0
