import "../../app/media/image_request"

define main returning Int:
    set profile to "{\"executable\":\"/host/sd-cli\",\"arguments\":[\"--prompt\",\"{prompt}\",\"--width\",\"{width}\",\"--height\",\"{height}\",\"--steps\",\"{steps}\",\"--seed\",\"{seed}\",\"--output\",\"generated.png\"]}"
    set request to "{\"prompt\":\"Echo café; $(touch /tmp/no) --output /private/no\",\"width\":4096,\"height\":2048,\"steps\":120,\"seed\":0}"
    set result to image_request_arguments(profile and request)
    if result equals 0 or else length_list(result) is not equal to 12:
        return 1
    if not (ptr_to_str(get_list(result and 1)) equals "Echo café; $(touch /tmp/no) --output /private/no") or else not (ptr_to_str(get_list(result and 3)) equals "4096") or else not (ptr_to_str(get_list(result and 7)) equals "120") or else not (ptr_to_str(get_list(result and 11)) equals "generated.png"):
        return 2
    set invalid to ["{\"prompt\":\"x\",\"width\":1,\"height\":1,\"steps\":1,\"seed\":0,\"path\":\"/tmp/a\"}", "{\"prompt\":\"x\",\"width\":1,\"height\":1,\"steps\":0,\"seed\":0}", "{\"prompt\":\"x\",\"width\":1.5,\"height\":1,\"steps\":1,\"seed\":0}", "{\"prompt\":\"x\",\"width\":1,\"height\":1,\"steps\":1,\"seed\":0,\"seed\":2}"]
    set index to 0
    repeat while index is less than length_list(invalid):
        if image_request_arguments(profile and ptr_to_str(get_list(invalid and index))) is not equal to 0:
            return 3
        set index to index + 1
    if image_request_arguments("{\"executable\":\"/host/tool\",\"arguments\":[\"{prompt}\"]}" and request) is not equal to 0:
        return 4
    display "PASS: exact native argv values, Unicode and shell-like prompt preserved as one argument, host output fixed, no geometry/step ceiling, invalid and silently ignored controls rejected. No process launched."
    return 0
