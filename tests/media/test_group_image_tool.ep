import "../../app/agent/runner"
import "../../app/security/group_output_policy"
import "../fixtures/generation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set configured to set_env("ECHO_IMAGE_PROFILE" and get_argument(2))
    set configured to set_env("ECHO_IMAGE_ROOT" and get_argument(3))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if not (group_output_schema(database) equals "applied"):
        return 20
    for each name in ["a","owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite-owner" and "g" and "device:owner" and "invited" and 1) equals "recorded") or else not (group_change(database and "owner" and "join-owner" and "g" and "device:owner" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 21
    set session to "shared"
    set run to "voice-request"
    if not (group_run_submit(database and "owner" and run and session and "browser" and "local" and "g" and "Create a spoken reply and check it using local recognition.") equals "accepted"):
        return 22
    set listener to local_socket_listen(0)
    set arguments to "{\"prompt\":\"A clean illustration of a purple teapot on a pale yellow background. Large black heading ECHO TOOL. No other text.\",\"width\":1024,\"height\":1024,\"steps\":8,\"seed\":57}"
    set data to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"generate\",\"function\":{\"name\":\"image_generate\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set completed to channel
    spawn generation_fixture(listener and data and completed)
    set generated to agent_generate_local(database and run and "generation" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    if generated is not equal to 0 or else served is not equal to 0:
        return 4
    set authority to image_tool_authority(database and run and "generate")
    if archive_list_text(authority and 0) equals "found" or else archive_list_text(speech_tool_authority(database and run and "generate") and 0) equals "found" or else archive_list_text(image_tool_authority(database and run and "missing-call") and 0) equals "found":
        return 24
    if agent_tool_step(database and run) is not equal to 0:
        display "FAIL: dispatch"
        return 5
    set row to history_collect_one(archive_prepare(database and "SELECT json_extract(payload,'$.result.status'),json_extract(payload,'$.result.attachment') FROM echo_events WHERE kind='tool_result';"))
    if not (ptr_to_str(get_list(row and 0)) equals "found") or else not (ptr_to_str(get_list(row and 1)) equals "complete"):
        if ptr_to_str(get_list(row and 0)) equals "found":
            display ptr_to_str(get_list(row and 1))
        return 6
    set attachment to ptr_to_str(get_list(row and 2))
    set own to web_attachment_owned(database and "owner" and attachment)
    set foreign to web_attachment_owned(database and "foreign" and attachment)
    if not (ptr_to_str(get_list(own and 0)) equals "found") or else not (ptr_to_str(get_list(foreign and 0)) equals "end"):
        return 7
    if not (archive_list_text(web_attachment_owned(database and "a" and attachment) and 0) equals "found"):
        return 23
    display ptr_to_str(get_list(own and 1))
    if agent_tool_step(database and run) is not equal to 0:
        return 8
    set row to agent_run_read(database and run)
    if not (ptr_to_str(get_list(row and 2)) equals "ready"):
        return 9
    if not (image_tool_execute(database and run and "generate" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 10
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='provider_helper_dispatch';"))
    if not (ptr_to_str(get_list(counts and 1)) equals "1") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 11
    set closed to local_socket_close(listener)
    display "PASS: shared scripted model tool call dispatched actual host image runtime, published owned attachment, rejected foreign reads and redispatch, returned run to ready, archive verified. Image quality requires independent inspection."
    return 0
