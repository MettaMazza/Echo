import "../../app/media/video_request"

# Arguments stay argv, exact timestamps remain uncapped, and the local helper
# sandbox denies network and unrelated local files. Live decoding is separate.
define main returning Int:
    set request to video_request("{\"attachment\":\"source\",\"action\":\"frame\",\"timestamp_ms\":123456789}")
    if not (archive_list_text(request and 0) equals "ready"):
        return 1
    set arguments to video_request_arguments(request)
    if string_contains(archive_list_text(arguments and 10) and "123456.789") equals 0:
        display "FAIL: exact millisecond conversion."
        return 2
    for each invalid in ["{}","{\"attachment\":\"source\",\"action\":\"frame\",\"timestamp_ms\":-1}","{\"attachment\":\"source\",\"action\":\"inspect\",\"timestamp_ms\":1}","{\"attachment\":\"source\",\"action\":\"frame\",\"timestamp_ms\":0,\"program\":\"other\"}","{\"attachment\":\"source\",\"action\":\"frame\",\"timestamp_ms\":0.5}"]:
        if archive_list_text(video_request(ptr_to_str(invalid)) and 0) equals "ready":
            display "FAIL: malformed request accepted."
            return 3
    set inspect to video_request_arguments(video_request("{\"attachment\":\"source\",\"action\":\"inspect\",\"timestamp_ms\":0}"))
    if not (archive_list_text(inspect and length_list(inspect) - 1) equals "input.media") or else string_contains(video_sandbox_profile() and "allow network"):
        return 4
    display "PASS: exact uncapped sampling timestamp, closed arguments, local file input and no network grant."
    return 0
