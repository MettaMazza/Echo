import "../../app/media/speech_chunks"
import "fs"
import "../../app/providers/archived_stream"

define main returning Int:
    set input to ptr_to_str(read_file(get_argument(1)))
    set start to 0
    repeat while start < string_length(input):
        set end to speech_chunk_end(input and start)
        if end <= start or else end - start > 240:
            return 1
        display provider_quote(ptr_to_str(substring(input and start and end - start)))
        set start to end
    return 0
