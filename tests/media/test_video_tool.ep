import "../../app/web/attachment_visibility"
import "../../app/agent/runner"
import "../../app/security/group_output_policy"
import "../fixtures/generation_fixture"

# Script only the model request. Both synthesis and recognition are real.
define video_fixture_call with database as Int and run as Str and request as Str and call_id as Str and name as Str and arguments as Str returning Int:
    set listener to local_socket_listen(0)
    set data to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and provider_quote(call_id))
    set data to concat(data and concat(",\"function\":{\"name\":" and provider_quote(name)))
    set data to concat(data and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}")))
    set completed to channel
    spawn generation_fixture(listener and data and completed)
    set generated to agent_generate_local(database and run and request and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    if agent_tool_step(database and run) is not equal to 0 or else agent_tool_step(database and run) is not equal to 0:
        return 1
    return 0

define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set configured to set_env("ECHO_VIDEO_PROFILE" and get_argument(2))
    set configured to set_env("ECHO_VIDEO_ROOT" and get_argument(3))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if not (group_output_schema(database) equals "applied"):
        return 3
    for each name in ["a","owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 4
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite-owner" and "g" and "device:owner" and "invited" and 1) equals "recorded") or else not (group_change(database and "owner" and "join-owner" and "g" and "device:owner" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 5
    set session to "shared"
    set run to "video-request"
    if not (group_run_submit(database and "owner" and run and session and "browser" and "local" and "g" and "Inspect the video and sample the requested frame.") equals "accepted"):
        return 6
    if web_attachment_register(database and "owner" and session and "video-source" and get_argument(4) and "test-video.mp4" and "video/mp4") is not equal to 0:
        return 7
    set checklist to "{\"items\":[{\"id\":\"video\",\"requirement\":\"Inspect video and sample frame\",\"status\":\"pending\",\"evidence\":\"\"}]}"
    if string_contains(task_checklist_save(database and run and "start" and checklist) and "saved") equals 0:
        return 8
    for each operation in ["inspect","frame","audiovisual","segment"]:
        set action to ptr_to_str(operation)
        set timestamp to "0"
        if action equals "frame":
            set timestamp to "1250"
        set arguments to concat("{\"attachment\":\"video-source\",\"action\":" and concat(provider_quote(action) and concat(",\"timestamp_ms\":" and concat(timestamp and "}"))))
        if action equals "segment":
            set arguments to "{\"attachment\":\"video-source\",\"action\":\"segment\",\"timestamp_ms\":2000,\"duration_ms\":1500}"
        if video_fixture_call(database and run and concat("generation-" and action) and action and "attachment_video" and arguments) is not equal to 0:
            display concat("FAIL: dispatch " and action)
            return 9
        set row to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(payload,'$.result.status'),json_extract(payload,'$.result.attachment'),json_extract(payload,'$.result.source_event') FROM echo_events WHERE kind='tool_result' AND json_extract(payload,'$.call_id')=?;" and [action]))
        if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 1) equals "complete") or else not (archive_list_text(row and 3) equals "video-source:attachment"):
            display concat("FAIL: result " and archive_list_text(row and 1))
            return 10
        set identity to archive_list_text(row and 2)
        set own to web_attachment_owned(database and "owner" and identity)
        if not (archive_list_text(own and 0) equals "found") or else not (archive_list_text(web_attachment_owned(database and "a" and identity) and 0) equals "found") or else not (archive_list_text(web_attachment_owned(database and "foreign" and identity) and 0) equals "end"):
            return 11
        if action equals "inspect":
            set metadata to provider_json_tokens(ptr_to_str(read_file(archive_list_text(own and 1))))
            if metadata equals 0 or else provider_member(metadata and 0 and "streams") < 0:
                return 12
        else if action equals "audiovisual" or else action equals "segment":
            if not (archive_list_text(own and 3) equals "video/mp4") or else not (archive_list_text(attachment_media_original_part(database and session and identity and "video") and 0) equals "ready"):
                return 24
            set sound to concat(identity and ":audio")
            if not (archive_list_text(attachment_audio_original_part(database and session and sound) and 0) equals "ready") or else not (archive_list_text(web_attachment_owned(database and "foreign" and sound) and 0) equals "end"):
                return 25
            if attachment_context_included(database and sound) is not equal to 0:
                return 26
        else:
            if not (archive_list_text(own and 3) equals "image/png") or else string_contains(attachment_image_execute(database and session and concat("{\"attachment\":" and concat(provider_quote(identity) and "}"))) and "ready") equals 0:
                return 13
        set excluded to web_attachment_visibility(database and "owner" and provider_json_tokens(concat("{\"action\":\"exclude\",\"attachment\":\"video-source\",\"identity\":" and concat(provider_quote(action) and ",\"previous\":\"\"}"))))
        if action equals "inspect":
            if not (excluded equals "recorded"):
                return 16
        # The next explicit sample is still allowed while the original is
        # excluded, but all automatic image/context reuse inherits exclusion.
        if attachment_context_included(database and identity) is not equal to 0:
            return 17
        if action equals "frame" and string_contains(attachment_image_execute(database and session and concat("{\"attachment\":" and concat(provider_quote(identity) and "}"))) and "ready") equals 0:
            return 18
        display concat(action and concat(": " and archive_list_text(own and 1)))
    if string_contains(web_message_audio(database and session and run and "") and "Video frame at requested 1250 ms.png") equals 0:
        return 23
    set restored to web_attachment_visibility(database and "owner" and provider_json_tokens("{\"action\":\"restore\",\"attachment\":\"video-source\",\"identity\":\"restore\",\"previous\":\"attachment-visibility:owner:inspect\"}"))
    if not (restored equals "recorded"):
        return 19
    set derived to history_collect_one(archive_prepare(database and "SELECT attachment FROM echo_attachment_derivations ORDER BY attachment LIMIT 1;"))
    if not (archive_list_text(derived and 0) equals "found") or else attachment_context_included(database and archive_list_text(derived and 1)) is not equal to 1:
        return 20
    if not (video_tool_execute(database and run and "frame" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 14
    if archive_verify(database and session) is not equal to 0:
        return 15
    display "PASS: real local video metadata and PNG sampling through scripted model tool calls, original provenance, shared audience access, foreign denial, inherited forgetting/restoration with explicit reread, and no completed-call replay."
    return sql_close(database)
