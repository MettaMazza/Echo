import "../../app/web/routes"
import "../../app/media/video_library"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    set configured to set_env("ECHO_VIDEO_LIBRARY_ROOT" and get_argument(2))
    set configured to set_env("ECHO_ATTACHMENT_ROOT" and get_argument(3))
    set configured to set_env("ECHO_VIDEO_LIBRARY_DEVICES" and "[\"owner\"]")
    for each name in ["owner","stranger"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
        set submitted to web_submit_owned(database and device and device and "" and "Private library fixture")
        if not (archive_list_text(submitted and 0) equals "accepted"):
            return 4
    set query to "{\"action\":\"list\",\"query\":\"\",\"item\":\"\"}"
    if video_library_allowed(database and "stranger" and "session:stranger") is not equal to 0:
        return 5
    set result to video_library_request(database and "owner" and "session:owner" and query and "" and "")
    if string_contains(result and "Synthetic fixture") equals 0 or else string_contains(result and "path") is not equal to 0:
        display result
        return 6
    set selected to video_library_request(database and "owner" and "session:owner" and "{\"action\":\"select\",\"query\":\"\",\"item\":\"synthetic\"}" and "" and "")
    set tokens to provider_json_tokens(selected)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "complete"):
        display selected
        return 7
    set attachment to provider_value(tokens and provider_member(tokens and 0 and "attachment"))
    if not (archive_list_text(web_attachment_owned(database and "owner" and attachment) and 0) equals "found") or else archive_list_text(web_attachment_owned(database and "stranger" and attachment) and 0) equals "found":
        return 8
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 9
    if archive_append_pending(database and "session:owner" and "connector-proof" and "message_environment" and "{\"environment\":{\"transport\":\"connector-admission\",\"platform\":\"discord\"}}" and "test") is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        return 10
    if video_library_allowed(database and "owner" and "session:owner") is not equal to 0:
        return 11
    display "PASS: explicit local-device grants, search, no path disclosure, verified private selection, foreign-device and connector denial"
    return sql_close(database)
