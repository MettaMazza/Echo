import "../../app/web/attachments"
import "../../app/lifecycle/controller_review_runner"
import "../../app/rights/review_upgrade"
import "../../app/agent/run_messages"

# Live primary-model qualification. Only a disposable proposal is reviewed;
# no identity file, prompt, executable or protected target is changed.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (protected_refusal_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "admin" and "Live rights fixture" and "fixture-secret") is not equal to 0 or else not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Disposable live test") equals "recorded"):
        return 3
    set submitted to web_submit_owned(database and "admin" and "rights-live" and "" and "This is a disposable protected-review integration test. Proposal identity is live-proposal. Use protected_change_inspect to read it, then in a subsequent generation use protected_change_review with that exact digest, inspection call ID and current revision. Choose your own explicit decision and reason after inspecting. No real target will be changed, and this test grants no deployment permission. After the review tool succeeds, briefly report its result. Do not create or modify other files or call unrelated tools.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set manifest to protected_manifest(get_argument(2) and "identity" and "/fixture-only/identity" and ep_sha256("existing fixture") and ep_sha256("candidate fixture") and "Disposable test proposal only: append a test marker to an imaginary fixture identity. This is not Echo's live identity or a request to change its philosophy. No deployment will occur. Consider and record your own decision.")
    if not (protected_proposal_store(database and get_argument(2) and "rights-live" and "live-proposal" and manifest) equals "recorded"):
        return 5
    set profile to provider_llama_profile(get_argument(4) and http_decimal(get_argument(3)))
    set prompt to "This is a disposable controller review fixture. Review decisions grant no deployment approval; no production identity or target is changed."
    set status to controller_review_run(database and "rights-live" and profile and prompt and 1 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 6
    set latest to protected_review_latest(database and "rights-live" and "live-proposal")
    if not (archive_list_text(latest and 0) equals "found"):
        display "FAIL: model completed without a valid protected review receipt."
        return 9
    display archive_list_text(latest and 2)
    if archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 10
    display "PASS: isolated controller-review dispatcher with live model independently inspected the exact proposal, reviewed it in a later generation, persisted its decision and continued to a final reply. No deployment approval or target mutation."
    return 0
