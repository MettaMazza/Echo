import "../../app/lifecycle/startup"
import "select"

define startup_wait_fixture with path as Str and completed as Int returning Int:
    set result to startup_archive_compatible(path and 1)
    send result to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set path to get_argument(1)
    set database to sql_open(path)
    if database equals 0 or else not (migration_apply(database and 1 and "lock-fixture" and "CREATE TABLE preserved(value TEXT);") equals "applied"):
        return 2
    if sql_execute(database and "BEGIN EXCLUSIVE;") is not equal to 0:
        return 3
    set completed to channel
    spawn startup_wait_fixture(path and completed)
    set waits to create_list()
    set added to append_list(waits and completed)
    set waited to select(waits and 250)
    if sql_execute(database and "COMMIT;") is not equal to 0:
        return 4
    set result to receive from completed
    if result is not equal to 1:
        display "FAIL: transient archive lock was reported as incompatible."
        return 5
    # A writer exceeding the bounded SQLite wait must be retryable, not an
    # incompatible-schema verdict that permanently stops the supervisor.
    if sql_execute(database and "BEGIN EXCLUSIVE;") is not equal to 0:
        return 7
    if startup_archive_status(get_argument(1) and 1) is not equal to -1:
        return 8
    if sql_execute(database and "COMMIT;") is not equal to 0 or else startup_archive_status(get_argument(1) and 1) is not equal to 1:
        return 9
    if sql_close(database) is not equal to 0:
        return 6
    display "PASS: startup waits through a transient archive writer lock before checking schema compatibility; an exhausted busy wait is retryable and later succeeds."
    return 0
