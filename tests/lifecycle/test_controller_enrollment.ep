import "../../app/lifecycle/controller_enrollment"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    if not (controller_enrollment_host("/missing" and "enroll" and "change" and "device" and "Host" and "/missing-secret" and "Fixture") equals "root-controller-required"):
        return 2
    set database to archive_open(get_argument(1))
    set pin to ep_sha256("enrollment fixture")
    if not (controller_schema_initialize(database and pin) equals "initialized"):
        return 3
    set secret to ep_sha256("Synthetic enrollment secret")
    # Fail the last write and require every preceding write to roll back.
    if sql_execute(database and "CREATE TRIGGER fixture_refuse_enrollment BEFORE INSERT ON echo_events WHEN NEW.kind='controller_enrollment' BEGIN SELECT RAISE(ABORT,'fixture rejection'); END;") is not equal to 0:
        return 4
    if not (controller_enrollment_record(database and "enroll" and "first" and "host" and "Fixture host" and secret and "Fixture authorization") equals "enrollment-receipt-failed"):
        return 5
    set counts to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_devices)+(SELECT COUNT(*) FROM echo_principals)+(SELECT COUNT(*) FROM echo_authority_events);"))
    if not (archive_list_text(counts and 1) equals "0") or else sql_execute(database and "DROP TRIGGER fixture_refuse_enrollment;") is not equal to 0:
        return 6
    if not (controller_enrollment_record(database and "enroll" and "first" and "host" and "Fixture host" and secret and "Fixture authorization") equals "recorded"):
        return 7
    if not (archive_list_text(protected_steward_actor(database and secret) and 0) equals "found"):
        return 8
    if not (controller_enrollment_record(database and "enroll" and "first" and "host" and "Fixture host" and secret and "Fixture authorization") equals "already-recorded"):
        return 9
    if not (controller_enrollment_record(database and "enroll" and "first" and "other" and "Fixture host" and secret and "Fixture authorization") equals "enrollment-identity-conflict"):
        return 10
    if not (controller_enrollment_record(database and "enroll" and "duplicate" and "host" and "Fixture host" and secret and "Fixture authorization") equals "enrollment-device-conflict"):
        return 11
    set receipt to archive_read_event(database and "controller-enrollment:first")
    if string_contains(archive_list_text(receipt and 3) and secret) is not equal to 0:
        return 12
    if not (controller_enrollment_record(database and "revoke" and "removed" and "host" and "" and "" and "Fixture revocation") equals "recorded"):
        return 13
    if archive_list_text(protected_steward_actor(database and secret) and 0) equals "found":
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    if not (controller_enrollment_record(database and "enroll" and "first" and "host" and "Fixture host" and secret and "Fixture authorization") equals "already-recorded") or else string_length(web_device_authenticate(database and secret)) > 0:
        return 16
    if not (controller_enrollment_record(database and "revoke" and "removed" and "host" and "" and "" and "Fixture revocation") equals "already-recorded") or else archive_verify(database and "controller-enrollment") is not equal to 0:
        return 17
    display "PASS: atomic controller enrollment and revocation, rollback on receipt failure, credential hashing, exact retry, identity conflict and reopen without reactivation. Host entry denies unprivileged access."
    return sql_close(database)
