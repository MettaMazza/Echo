import "../../app/lifecycle/controller_launch"

define main returning Int:
    set digest to ep_sha256("fixture")
    set executable to concat("{\"name\":\"controller\",\"source\":\"/untrusted-build/controller\",\"sha256\":" and concat(provider_quote(digest) and ",\"kind\":\"executable\"}"))
    set configuration to concat("{\"name\":\"settings.json\",\"source\":\"/untrusted-build/settings.json\",\"sha256\":" and concat(provider_quote(digest) and ",\"kind\":\"data\"}"))
    set manifest to concat("{\"version\":1,\"files\":[" and concat(executable and concat("," and concat(configuration and "]}"))))
    set expected to ep_sha256(manifest)
    set profile to controller_bundle_profile(manifest and expected and "/private/var/root" and "controller" and "settings.json")
    set tokens to provider_json_tokens(profile)
    if service_profile_valid(tokens) equals 0 or else string_contains(profile and "/untrusted-build") is not equal to 0:
        return 1
    set root to concat("/private/var/root/" and expected)
    if not (provider_value(tokens and provider_member(tokens and 0 and "executable")) equals concat(root and "/controller")) or else not (provider_value(tokens and provider_member(tokens and 0 and "directory")) equals root):
        return 2
    set arguments to service_profile_vector(tokens and "arguments")
    if length_list(arguments) is not equal to 3 or else not (archive_list_text(arguments and 1) equals concat(root and "/settings.json")):
        return 3
    set environment to service_profile_vector(tokens and "environment")
    if length_list(environment) is not equal to 2 or else not (archive_list_text(environment and 0) equals "PATH=/usr/bin:/bin"):
        return 4
    for each name in ["missing","../controller","settings.json","/bin/sh"]:
        if string_length(controller_bundle_profile(manifest and expected and "/private/var/root" and ptr_to_str(name) and "settings.json")) is not equal to 0:
            return 5
    if string_length(controller_bundle_profile(manifest and expected and "/private/var/root" and "controller" and "controller")) is not equal to 0 or else string_length(controller_bundle_profile(manifest and ep_sha256("wrong") and "/private/var/root" and "controller" and "settings.json")) is not equal to 0:
        return 6
    for each parent in ["relative","/private/../tmp","/", ""]:
        if string_length(controller_bundle_profile(manifest and expected and ptr_to_str(parent) and "controller" and "settings.json")) is not equal to 0:
            return 7
    if controller_bundle_launch(manifest and expected and "/private/var/root" and "controller" and "settings.json" and 2) equals 0 or else controller_bundle_launch(manifest and expected and "/private/var/root" and "controller" and "settings.json" and 1) equals 0:
        return 8
    display "PASS: installed executable/configuration binding, exact manifest digest, clean environment, path/kind rejection and non-root launch denial. No root execution tested."
    return 0
