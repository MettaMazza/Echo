import "../../app/lifecycle/controller_credential"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set path to get_argument(1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set first to controller_credential_random(library)
    set second to controller_credential_random(library)
    if protected_digest_valid(first) is not equal to 1 or else protected_digest_valid(second) is not equal to 1 or else first equals second:
        return 2
    if ep_dlcall2(ep_dlsym(library and "mkdir") and str_to_ptr(path) and 448) is not equal to 0:
        return 3
    set directory to workspace_root_open(library and path)
    if directory < 0:
        return 4
    if not (controller_credential_write(library and directory and "credential" and first) equals "credential-created"):
        return 5
    if not (controller_credential_write(library and directory and "credential" and second) equals "credential-exists-or-unavailable") or else not (file_read(concat(path and "/credential")) equals first):
        return 6
    if not (controller_credential_write(library and directory and "../escape" and first) equals "credential-input-invalid") or else not (controller_credential_write(library and directory and "bad" and "short") equals "credential-input-invalid"):
        return 7
    set closed to net_close(directory)
    set unloaded to ep_dlclose(library)
    if not (controller_credential_host(path and "root-only") equals "root-controller-required"):
        return 8
    display "PASS: OS-random full credentials, exclusive durable creation, no overwrite, invalid input rejection and root-only host denial. No enrollment and no credential output."
    return 0
