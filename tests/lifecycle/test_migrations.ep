import "../../app/lifecycle/migrations"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        display "Supply a new disposable database path."
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else migration_compatible(database and 0) is not equal to 1:
        return 2
    # A failing second statement must undo both earlier DDL and the receipt table.
    set failed to migration_apply(database and 1 and "broken" and "CREATE TABLE migration_partial(value TEXT); INSERT INTO missing_fixture_table VALUES(1);")
    if not (failed equals "migration-statements-failed"):
        display failed
        return 3
    set row to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM sqlite_master WHERE name IN ('migration_partial','echo_schema_migrations');"))
    if not (archive_list_text(row and 1) equals "0"):
        return 4
    set first to "CREATE TABLE migration_fixture(value TEXT NOT NULL); INSERT INTO migration_fixture VALUES('original');"
    if not (migration_apply(database and 1 and "first" and first) equals "applied"):
        return 5
    if not (migration_apply(database and 1 and "first" and first) equals "already-applied"):
        return 6
    if not (migration_apply(database and 1 and "first" and "DELETE FROM migration_fixture;") equals "migration-identity-mismatch"):
        return 7
    if not (migration_apply(database and 3 and "third" and "DELETE FROM migration_fixture;") equals "migration-out-of-order"):
        return 8
    if migration_compatible(database and 0) is not equal to 0 or else migration_compatible(database and 1) is not equal to 1:
        return 9
    if not (migration_apply(database and 2 and "second" and "ALTER TABLE migration_fixture ADD COLUMN label TEXT NOT NULL DEFAULT 'preserved';") equals "applied"):
        return 10
    if sql_close(database) is not equal to 0:
        return 11
    set database to archive_open(get_argument(1))
    if database equals 0 or else migration_compatible(database and 1) is not equal to 0 or else migration_compatible(database and 2) is not equal to 1:
        return 12
    set row to history_collect_one(archive_prepare(database and "SELECT value,label,CAST((SELECT COUNT(*) FROM migration_fixture) AS TEXT) FROM migration_fixture;"))
    if not (archive_list_text(row and 1) equals "original") or else not (archive_list_text(row and 2) equals "preserved") or else not (archive_list_text(row and 3) equals "1"):
        return 13
    if sql_execute(database and "DELETE FROM echo_schema_migrations;") equals 0:
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    display "PASS: atomic DDL rollback, exact replay, changed migration rejection, ordering, immutable receipts and downgrade refusal survive reopen."
    return 0
