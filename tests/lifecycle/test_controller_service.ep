import "../../app/lifecycle/controller_service"

# This test never impersonates root or installs a service. Root qualification
# remains separate; the probe checks the actual native child launch machinery.
define main returning Int:
    if get_argument_count() equals 3 and get_argument(1) equals "--probe":
        if string_length(ptr_to_str(get_env("ECHO_CONTROLLER_PROBE_SECRET"))) > 0 or else not (ptr_to_str(get_env("PATH")) equals "/usr/bin:/bin"):
            return 20
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set function to ep_dlsym(library and "fcntl")
        if socket_signed_result(ep_dlcall2(function and 3 and 1)) < 0:
            return 21
        if write_file(get_argument(2) and "isolated-probe-passed") is not equal to 1:
            return 22
        return 0
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)) or else file_exists(get_argument(2)):
        return 1
    if not (archive_list_text(controller_configuration_load("/missing") and 0) equals "root-controller-required") or else controller_service_run("/missing" and "") is not equal to 1:
        return 2
    set database to archive_open(get_argument(1))
    set pin to ep_sha256("service fixture configuration")
    if controller_service_ready(database and pin) is not equal to 0:
        return 3
    if not (controller_schema_initialize(database and pin) equals "initialized") or else controller_service_ready(database and pin) is not equal to 1 or else controller_service_ready(database and ep_sha256("changed")) is not equal to 0:
        return 4
    if sql_close(database) is not equal to 0:
        return 5
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set function to ep_dlsym(library and "open")
    set descriptor to socket_signed_result(ep_dlcall2(function and str_to_ptr("/dev/null") and 0))
    if descriptor < 0:
        return 6
    set arguments to create_list()
    set added to append_list(arguments and "--probe")
    set added to append_list(arguments and get_argument(2))
    set process to controller_process_start(arguments and descriptor)
    set closed to net_close(descriptor)
    if process < 0:
        return 7
    set status to create_list()
    set added to append_list(status and 0)
    set wait_function to ep_dlsym(library and "waitpid")
    if ep_dlcall3(wait_function and process and get_list_data_ptr(status) and 0) is not equal to process or else get_list(status and 0) is not equal to 0:
        return 8
    if not (file_read(get_argument(2)) equals "isolated-probe-passed"):
        return 9
    display "PASS: service denies unprivileged startup, requires matching completed bootstrap, and launches an isolated child with selected descriptor and clean environment."
    return 0
