import "../../app/lifecycle/controller_autonomous"
import "../../app/agent/tool_recovery"
import "../../app/agent/run_messages"
import "../fixtures/generation_fixture"

define protected_fixture_call with database as Int and run as Str and request as Str and call_id as Str and name as Str and arguments as Str returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and provider_quote(call_id))
    set delta to concat(delta and concat(",\"function\":{\"name\":" and provider_quote(name)))
    set delta to concat(delta and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}")))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set body to session_request_body_owned(database and run and "fixture" and agent_run_messages(database and run))
    if provider_json_tokens(body) equals 0:
        return 2
    set generated to agent_generate_local(database and run and request and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 3
    if agent_tool_step(database and run) is not equal to 0 or else agent_tool_step(database and run) is not equal to 0:
        return 4
    return 0

# Disposable native fixture, with a synthetic model review, never production.
define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set root to get_argument(1)
    set charter to get_argument(2)
    set plan_path to get_argument(3)
    set target to concat(root and "/runtime.bin")
    set candidate to concat(root and "/candidate.bin")
    set recovery to concat(root and "/recovery.bin")
    set original to "original"
    set replacement to "expected behavior"
    set database to archive_open(concat(root and "/ledger.sqlite"))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    set schema to protected_operation_schema(database)
    if not (schema equals "applied" or else schema equals "already-applied"):
        return 3
    if web_pairing_invite(database and "admin") is not equal to 0 or else web_device_pair(database and "admin" and "admin" and "Synthetic fixture" and "admin-secret") is not equal to 0 or else not (principal_host_role(database and "grant-admin" and "device:admin" and "admin" and "Fixture") equals "recorded"):
        return 4
    set submitted to web_submit_owned(database and "admin" and "admin-run" and "" and "Review inert candidate")
    set inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(target) and ",\"category\":\"agency\"}]}"))
    set manifest to protected_inventory_manifest(charter and inventory and ep_sha256(inventory) and target and ep_sha256(original) and ep_sha256(replacement) and "Synthetic fixture only")
    if write_file(target and original) is not equal to 1 or else write_file(candidate and replacement) is not equal to 1 or else write_file(recovery and original) is not equal to 1:
        return 5
    if not (protected_proposal_store(database and charter and "admin-run" and "proposal" and manifest) equals "recorded"):
        return 6
    if protected_fixture_call(database and "admin-run" and "inspect-generation" and "inspect" and "protected_change_inspect" and "{\"proposal\":\"proposal\"}") is not equal to 0:
        return 7
    set arguments to concat("{\"proposal\":\"proposal\",\"inspection_call\":\"inspect\",\"manifest_digest\":" and provider_quote(ep_sha256(manifest)))
    set arguments to concat(arguments and ",\"previous_revision\":0,\"decision\":\"consent\",\"risk\":\"low\",\"reason\":\"Synthetic exact fixture review.\"}")
    if protected_fixture_call(database and "admin-run" and "review-generation" and "review" and "protected_change_review" and arguments) is not equal to 0:
        return 8
    set plan to file_read(plan_path)
    set pin to ep_sha256(plan)
    set configured to set_env("ECHO_CONTROLLER_QUALIFICATION_PLAN" and plan_path)
    set configured to set_env("ECHO_CONTROLLER_QUALIFICATION_SHA256" and pin)
    set pending to protected_execution_authorization(database and "admin-run" and "proposal")
    if archive_list_text(pending and 0) equals "found":
        return 9
    set report to qualification_execute(plan and pin and candidate and ep_sha256(replacement) and concat(root and "/workspace") and root and concat(root and "/qualification"))
    set recorded to protected_qualification_record(database and "admin-run" and "proposal" and plan and pin and report)
    if not (recorded equals "qualified"):
        display recorded
        display report
        return 10
    set prepared to protected_operation_prepare(database and charter and "admin-run" and "proposal" and "operation" and inventory and ep_sha256(inventory) and root and "runtime.bin" and "candidate.bin" and recovery and "" and "" and "")
    if not (prepared equals "prepared"):
        display prepared
        return 11
    set applied to protected_operation_apply(database and charter and "operation" and inventory and ep_sha256(inventory) and "")
    if not (applied equals "applied") or else not (file_read(target) equals replacement):
        display applied
        return 12
    set reverted to protected_operation_rollback(database and charter and "operation")
    if not (reverted equals "rolled-back") or else not (file_read(target) equals original):
        display reverted
        return 13
    set humans to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_protected_steward;"))
    if not (archive_list_text(humans and 1) equals "0"):
        return 14
    display "PASS: synthetic Echo consent, real sandboxed evaluator, no human approval, exact candidate qualification, transactional activation and verified rollback."
    return sql_close(database)
