import "../../app/lifecycle/protected_path"

# Read-only qualification against the host's actual trusted OS paths and the
# current user-owned checkout. This test never grants privileges or changes ACLs.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 2
    set trusted to protected_path_open(library and "/Library/LaunchDaemons" and 1)
    if trusted < 0:
        display "FAIL: actual root-owned launch directory rejected."
        return 3
    set closed to net_close(trusted)
    set trusted to protected_path_open(library and "/usr/bin/true" and 0)
    if trusted < 0:
        display "FAIL: actual root-owned regular executable rejected."
        return 4
    set closed to net_close(trusted)
    for each path in [get_argument(1), "/Library/../Library/LaunchDaemons", "/Library//LaunchDaemons", "/tmp", "/dev/null", "/Library/LaunchDaemons/missing-echo-test-file"]:
        set rejected to protected_path_open(library and path and 0)
        if rejected >= 0:
            set closed to net_close(rejected)
            display concat("FAIL: untrusted file accepted: " and path)
            return 5
    if protected_path_open(library and "/tmp" and 1) >= 0 or else protected_path_open(library and get_argument(1) and 1) >= 0:
        return 6
    if ep_dlclose(library) is not equal to 0:
        return 7
    display "PASS: real root-owned directories/files pass; user-owned ancestry, symlink ancestors, traversal, special files, wrong type and missing files fail. No controller installed."
    return 0
