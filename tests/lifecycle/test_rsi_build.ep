import "../../app/lifecycle/rsi_build"
import "../../app/lifecycle/rsi_source_manifest"

define main returning Int:
    if get_argument_count() is not equal to 7:
        return 1
    set manifest to file_read(get_argument(1))
    set request to file_read(get_argument(2))
    set plan to file_read(get_argument(3))
    set staged to rsi_source_stage(manifest and ep_sha256(manifest) and request and get_argument(4) and get_argument(5))
    display staged
    if not (staged equals "source-staged"):
        return 2
    set report to rsi_build_candidate(plan and ep_sha256(plan) and get_argument(5) and get_argument(6))
    display report
    if string_length(report) equals 0:
        return 3
    set next_manifest to rsi_source_manifest(manifest and request and get_argument(5))
    if string_length(next_manifest) equals 0:
        return 4
    display next_manifest
    set request_fields to provider_json_tokens(request)
    set changes to provider_items(request_fields and provider_member(request_fields and 0 and "changes"))
    set first_change to get_list(changes and 0)
    set changed_path to provider_value(request_fields and provider_member(request_fields and first_change and "path"))
    set tampered_path to concat(get_argument(5) and "/")
    set tampered_path to concat(tampered_path and changed_path)
    if write_file(tampered_path and "tampered after compile") is not equal to 1:
        return 5
    if string_length(rsi_source_manifest(manifest and request and get_argument(5))) > 0:
        return 6
    return 0
