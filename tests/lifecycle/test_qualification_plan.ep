import "../../app/lifecycle/qualification_plan"

define main returning Int:
    set pin to ep_sha256("trusted-check")
    set candidate to ep_sha256("candidate")
    set plan to concat("{\"version\":1,\"checks\":[{\"name\":\"regression\",\"executable\":\"/installed/check\",\"sha256\":" and concat(provider_quote(pin) and ",\"arguments\":[]}]}"))
    set digest to ep_sha256(plan)
    if qualification_plan_valid(plan and digest) is not equal to 1 or else qualification_plan_valid(plan and ep_sha256("changed")) is not equal to 0:
        return 1
    set report to concat("{\"plan_sha256\":" and provider_quote(digest))
    set report to concat(report and concat(",\"candidate_sha256\":" and provider_quote(candidate)))
    set report to concat(report and concat(",\"checks\":[{\"name\":\"regression\",\"sha256\":" and provider_quote(pin)))
    set report to concat(report and concat(",\"wait_status\":0,\"output_sha256\":" and concat(provider_quote(ep_sha256("actual captured output")) and "}]}")))
    if qualification_results_valid(plan and digest and report and candidate) is not equal to 1:
        display report
        return 2
    if qualification_results_valid(plan and digest and report and ep_sha256("different candidate")) is not equal to 0:
        return 3
    set missing to concat("{\"plan_sha256\":" and concat(provider_quote(digest) and concat(",\"candidate_sha256\":" and concat(provider_quote(candidate) and ",\"checks\":[]}"))))
    if qualification_results_valid(plan and digest and missing and candidate) is not equal to 0:
        return 4
    if qualification_results_valid(plan and digest and "{\"checks\":[],\"checks\":[]}" and candidate) is not equal to 0:
        return 5
    display "PASS: frozen plan, exact candidate binding, required check set, captured output and duplicate rejection."
    return 0
