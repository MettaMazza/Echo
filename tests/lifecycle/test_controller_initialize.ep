import "../../app/lifecycle/controller_initialize"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    set pin to ep_sha256("isolated controller configuration")
    # Fail after migration to test completion recovery without replacing intent.
    if sql_execute(database and "CREATE TRIGGER fail_bootstrap BEFORE INSERT ON echo_events WHEN NEW.kind='controller_bootstrap_complete' BEGIN SELECT RAISE(ABORT,'fixture interruption'); END;") is not equal to 0:
        return 2
    set initial to controller_schema_initialize(database and pin)
    if not (initial equals "bootstrap-completion-failed"):
        display initial
        return 3
    if sql_close(database) is not equal to 0:
        return 4
    set database to archive_open(get_argument(1))
    if not (controller_schema_initialize(database and ep_sha256("changed")) equals "bootstrap-configuration-conflict") or else sql_execute(database and "DROP TRIGGER fail_bootstrap;") is not equal to 0:
        return 5
    if not (controller_schema_initialize(database and pin) equals "initialized") or else not (controller_schema_initialize(database and pin) equals "already-initialized"):
        return 6
    set empty to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_principals)+(SELECT COUNT(*) FROM echo_protected_proposals)+(SELECT COUNT(*) FROM echo_protected_reviews)+(SELECT COUNT(*) FROM echo_protected_steward);"))
    if not (archive_list_text(empty and 1) equals "0") or else archive_verify(database and "controller-bootstrap") is not equal to 0:
        return 7
    set foreign_path to concat(get_argument(1) and ".foreign")
    if file_exists(foreign_path):
        return 8
    set foreign to archive_open(foreign_path)
    if archive_append(foreign and "runtime" and "runtime:event" and "user" and "Never import this as controller state" and "fixture") is not equal to 0 or else not (controller_schema_initialize(foreign and pin) equals "existing-archive-not-controller-bootstrap"):
        return 9
    set closed to sql_close(foreign)
    if sql_close(database) is not equal to 0:
        return 10
    display "PASS: rights schema bootstrap, interrupted completion/reopen, exact configuration retry/conflict, no invented principals or approvals, non-controller archive rejected. Root opener tested separately."
    return 0
