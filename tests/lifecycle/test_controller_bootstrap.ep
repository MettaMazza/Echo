import "../../app/lifecycle/controller_bootstrap"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set root to get_argument(1)
    set inputs to file_read(concat(root and "/inputs-manifest.json"))
    set service to file_read(concat(root and "/service-manifest.json"))
    set inputs_pin to ep_sha256(inputs)
    set service_pin to ep_sha256(service)
    if not (controller_bootstrap_plan(inputs and inputs_pin and service and service_pin and "/private/var/root") equals "ready"):
        return 2
    if not (controller_bootstrap_plan(inputs and ep_sha256("wrong") and service and service_pin and "/private/var/root") equals "bootstrap-package-invalid"):
        return 3
    if not (controller_bootstrap_plan(inputs and inputs_pin and service and service_pin and "/private/var/root/other") equals "bootstrap-input-path-mismatch"):
        return 4
    set changed to ptr_to_str(string_replace(service and "controller.json" and "other.json"))
    set checked to controller_bootstrap_plan(inputs and inputs_pin and changed and ep_sha256(changed) and "/private/var/root")
    if not (checked equals "bootstrap-package-invalid" or else checked equals "bootstrap-service-entry-missing"):
        return 5
    if not (controller_bootstrap_host(inputs and inputs_pin and service and service_pin and "/private/var/root" and "fixture" and "Fixture" and "Fixture only") equals "root-controller-required"):
        return 6
    display "PASS: actual paired packages bind configuration to pinned inputs; changed pins, destination and service entry rejected; unprivileged installer refused before writes."
    return 0
