import "../../app/lifecycle/startup"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set path to get_argument(1)
    if startup_archive_compatible(path and 2) is not equal to 1 or else file_exists(path):
        return 2
    set database to sql_open(path)
    if database equals 0:
        return 3
    if not (migration_apply(database and 1 and "future-fixture" and "CREATE TABLE future_data(value TEXT); INSERT INTO future_data VALUES('preserved');") equals "applied"):
        return 4
    set closed to sql_close(database)
    if startup_archive_compatible(path and 0) is not equal to 0 or else startup_archive_compatible(path and 1) is not equal to 1:
        return 5
    set database to sql_open(path)
    set row to history_collect_one(archive_prepare(database and "SELECT value FROM future_data;"))
    if not (archive_list_text(row and 1) equals "preserved"):
        return 6
    set row to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM sqlite_master WHERE name='echo_events';"))
    if not (archive_list_text(row and 1) equals "0"):
        return 7
    set closed to sql_close(database)
    display "PASS: startup rejects newer schemas without creating archive tables or changing preserved data; an absent database remains absent."
    return 0
