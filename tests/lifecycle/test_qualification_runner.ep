import "../../app/lifecycle/qualification_runner"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set plan to file_read(get_argument(1))
    set candidate to get_argument(2)
    set original to file_digest_durable(candidate and 65536)
    set report to qualification_execute(plan and ep_sha256(plan) and candidate and archive_list_text(original and 1) and get_argument(3) and get_argument(3) and get_argument(4))
    if string_length(report) equals 0:
        return 2
    display report
    return qualification_results_valid(plan and ep_sha256(plan) and report and archive_list_text(original and 1))
