import "../../app/lifecycle/controller_operations"

# Configuration is not authorization; these checks exercise parsing and the
# actual unprivileged command boundary without claiming a privileged deployment.
define main returning Int:
    set digest to ep_sha256("fixture")
    set content to concat("{\"ledger_directory\":\"/private/var/root/echo-controller\",\"ledger_name\":\"ledger.sqlite\",\"charter\":\"/private/var/root/charter.json\",\"inventory\":\"/private/var/root/inventory.json\",\"policy\":\"/private/var/root/policy.txt\",\"inventory_sha256\":" and provider_quote(digest))
    set content to concat(content and concat(",\"policy_sha256\":" and concat(provider_quote(digest) and "}")))
    if controller_configuration_valid(content) is not equal to 1:
        return 1
    for each replacement in ["../ledger.sqlite","/ledger.sqlite","nested/ledger.sqlite",""]:
        set invalid to ptr_to_str(string_replace(content and "ledger.sqlite" and ptr_to_str(replacement)))
        if controller_configuration_valid(invalid) is not equal to 0:
            return 2
    if controller_configuration_valid("{}") is not equal to 0 or else controller_configuration_valid(ptr_to_str(string_replace(content and "inventory_sha256" and "unknown"))) is not equal to 0 or else controller_configuration_valid(ptr_to_str(string_replace(content and digest and "bad"))) is not equal to 0:
        return 3
    set configured to ptr_to_str(string_replace(content and "ledger_directory" and "listen_port\":\"49676\",\"ledger_directory"))
    if controller_configuration_valid(configured) is not equal to 1:
        return 8
    for each invalid_port in ["0","65536","-1","text",""]:
        set invalid to ptr_to_str(string_replace(configured and "49676" and ptr_to_str(invalid_port)))
        if controller_configuration_valid(invalid) is not equal to 0:
            return 9
    set review_fields to concat("\"review_profile\":\"/private/var/root/review.json\",\"review_prompt\":\"/private/var/root/prompt.txt\",\"review_profile_sha256\":" and provider_quote(digest))
    set review_fields to concat(review_fields and ",\"review_prompt_sha256\":")
    set review_fields to concat(review_fields and provider_quote(digest))
    set review_fields to concat(review_fields and ",")
    set with_review to concat("{" and review_fields)
    set with_review to concat(with_review and ptr_to_str(substring(content and 1 and string_length(content) - 1)))
    if controller_configuration_valid(with_review) is not equal to 1:
        return 10
    set partial to ptr_to_str(string_replace(with_review and "review_prompt_sha256" and "unknown"))
    set traversal to ptr_to_str(string_replace(with_review and "/private/var/root/review.json" and "/private/var/root/../review.json"))
    if controller_configuration_valid(partial) is not equal to 0 or else controller_configuration_valid(traversal) is not equal to 0:
        return 11
    set with_console to ptr_to_str(string_replace(content and "ledger_directory" and "console_script\":\"/private/var/root/controller.js\",\"console_script_sha256\":\"PIN\",\"ledger_directory"))
    set with_console to ptr_to_str(string_replace(with_console and "PIN" and digest))
    if controller_configuration_valid(with_console) is not equal to 1:
        return 12
    set missing_pin to ptr_to_str(string_replace(with_console and "console_script_sha256" and "unknown_script_pin"))
    set bad_path to ptr_to_str(string_replace(with_console and "/private/var/root/controller.js" and "/private/var/root/../controller.js"))
    if controller_configuration_valid(missing_pin) is not equal to 0 or else controller_configuration_valid(bad_path) is not equal to 0:
        return 13
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 4
    set user_function to ep_dlsym(library and "geteuid")
    if user_function equals 0 or else ep_dlcall0(user_function) equals 0:
        return 5
    set closed to ep_dlclose(library)
    for each action in ["initialize","inspect","apply","reconcile","rollback","rollback-reconcile"]:
        if not (controller_operation_host("/missing-configuration" and ptr_to_str(action) and "operation") equals "root-controller-required"):
            return 6
    if not (controller_operation_host("/missing-configuration" and "shell" and "operation") equals "invalid-operation-request"):
        return 7
    display "PASS: exact controller configuration, invalid path/pin/field rejection, all operation routes deny unprivileged access before ledger reads."
    return 0
