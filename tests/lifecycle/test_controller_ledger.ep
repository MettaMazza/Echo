import "../../app/lifecycle/controller_ledger"

# This process is intentionally unprivileged. It must not create a database,
# even inside an otherwise writable directory supplied by its caller.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        return 2
    set effective_user to ep_dlsym(library and "geteuid")
    if ep_dlcall0(effective_user) equals 0:
        return 3
    set directory to protected_path_open(library and "/Library/LaunchDaemons" and 1)
    if directory < 0 or else controller_private_inode(library and directory and 1) is not equal to 0:
        return 4
    set closed to net_close(directory)
    for each name in ["ledger.sqlite", "../ledger.sqlite", "/ledger.sqlite", "", "nested/ledger.sqlite"]:
        if controller_ledger_open(get_argument(1) and ptr_to_str(name)) is not equal to 0:
            return 5
    set released to ep_dlclose(library)
    display "PASS: public root directory rejected as private state; unprivileged callers and invalid ledger names cannot open controller state. Privileged creation is a separate test."
    return 0
