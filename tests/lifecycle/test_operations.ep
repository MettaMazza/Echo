import "../../app/lifecycle/operations"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else not (operation_schema(database) equals "applied"):
        return 2
    if not (operation_reserve(database and "alice" and "send-1" and "alice" and "mail-send" and "fixture request") equals "reserved"):
        return 3
    if not (operation_reserve(database and "alice" and "send-1" and "alice" and "mail-send" and "fixture request") equals "already-reserved"):
        return 4
    if not (operation_reserve(database and "alice" and "send-1" and "alice" and "mail-send" and "changed request") equals "operation-conflict"):
        return 5
    if not (operation_reserve(database and "bob" and "send-1" and "bob" and "mail-send" and "fixture request") equals "operation-unavailable"):
        return 6
    if not (operation_transition(database and "alice" and "send-1" and 0 and "running" and "dispatch" and "" and "unknown" and "" and "reconcile-if-interrupted" and "") equals "recorded"):
        return 7
    if not (operation_transition(database and "alice" and "send-1" and 0 and "running" and "dispatch" and "" and "unknown" and "" and "" and "") equals "stale-revision-read-status"):
        return 8
    if sql_close(database) is not equal to 0:
        return 9
    set database to archive_open(get_argument(1))
    set row to operation_read(database and "alice" and "send-1")
    if not (archive_list_text(row and 5) equals "running"):
        return 10
    set row to operation_read(database and "bob" and "send-1")
    if not (archive_list_text(row and 0) equals "end"):
        return 11
    if not (operation_transition(database and "alice" and "send-1" and 1 and "uncertain" and "recovery" and "owner-died" and "unknown" and "fixture:incident" and "reconcile-remote-result" and "") equals "recorded"):
        return 12
    if not (operation_transition(database and "alice" and "send-1" and 2 and "running" and "retry" and "" and "unknown" and "" and "" and "") equals "transition-not-permitted"):
        return 13
    # A failure to persist an outcome cannot consume the current revision.
    if sql_execute(database and "CREATE TRIGGER fixture_reject BEFORE INSERT ON echo_operations WHEN NEW.state='succeeded' BEGIN SELECT RAISE(ABORT,'fixture outcome failure'); END;") is not equal to 0:
        return 14
    if not (operation_transition(database and "alice" and "send-1" and 2 and "succeeded" and "reconciled" and "" and "confirmed" and "" and "none" and "fixture:remote-message") equals "operation-write-failed"):
        return 15
    set row to operation_read(database and "alice" and "send-1")
    if not (archive_list_text(row and 4) equals "2") or else not (archive_list_text(row and 5) equals "uncertain"):
        return 16
    if sql_execute(database and "DROP TRIGGER fixture_reject;") is not equal to 0:
        return 17
    if not (operation_transition(database and "alice" and "send-1" and 2 and "succeeded" and "reconciled" and "" and "confirmed" and "" and "none" and "fixture:remote-message") equals "recorded"):
        return 18
    if not (operation_transition(database and "alice" and "send-1" and 3 and "running" and "retry" and "" and "unknown" and "" and "" and "") equals "transition-not-permitted"):
        return 19
    if sql_execute(database and "UPDATE echo_operations SET state='queued';") equals 0:
        return 20
    if sql_close(database) is not equal to 0:
        return 21
    display "PASS: durable scoped operation identity, replay conflict, single claim, reopen, uncertain-effect reconciliation, failed receipt rollback and immutable history."
    return 0
