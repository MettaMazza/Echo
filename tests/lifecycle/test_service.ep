import "../../app/lifecycle/service_profile"
import "../../app/workspace/native_process"
import "../../app/providers/archived_stream"
import "fs"

define main returning Int:
    if get_argument_count() equals 3 and get_argument(1) equals "child":
        if not (get_argument(2) equals "literal $(touch injected) ; a b"):
            return 21
        if not (ptr_to_str(get_env("ECHO_SERVICE_VALUE")) equals "kept = exactly") or else string_length(ptr_to_str(get_env("ECHO_SERVICE_SECRET"))) is not equal to 0:
            return 22
        if write_file("cwd-proof.txt" and "Correct service working directory.") is not equal to 1:
            return 23
        display "Service child verified literal arguments and explicit environment."
        return 7
    if get_argument_count() is not equal to 3:
        display "Supply absolute launcher path and fresh test directory."
        return 1
    set root to get_argument(2)
    set profile to concat("{\"executable\":" and provider_quote(get_argument(0)))
    set profile to concat(profile and concat(",\"directory\":" and provider_quote(root)))
    set profile to concat(profile and ",\"arguments\":[\"child\",\"literal $(touch injected) ; a b\"],\"environment\":[\"ECHO_SERVICE_VALUE=kept = exactly\"]}")
    if service_profile_valid(provider_json_tokens(profile)) is not equal to 1 or else service_profile_run(profile and 1) is not equal to 0:
        return 2
    if file_exists(concat(root and "/cwd-proof.txt")):
        return 3
    set invalid to string_replace(profile and "kept = exactly" and "bad\u0000suffix")
    if service_profile_valid(provider_json_tokens(invalid)) is not equal to 0:
        return 4
    set invalid to string_replace(profile and "\"ECHO_SERVICE_VALUE=kept = exactly\"" and "\"SAME=1\",\"SAME=2\"")
    if service_profile_valid(provider_json_tokens(invalid)) is not equal to 0:
        return 5
    set invalid to string_replace(profile and "\"arguments\":" and "\"ignored_setting\":true,\"arguments\":")
    if service_profile_valid(provider_json_tokens(invalid)) is not equal to 0:
        return 6
    set profile_path to concat(root and "/service profile.json")
    if write_file(profile_path and profile) is not equal to 1:
        return 8
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and root)
    set output to workspace_file_open(library and directory and "stdout.txt" and 1)
    set errors to workspace_file_open(library and directory and "stderr.txt" and 1)
    set handle to workspace_process_start(get_argument(1) and [profile_path] and ["ECHO_SERVICE_SECRET=must disappear"] and directory and output and errors)
    if handle equals 0:
        return 9
    set state to 0
    repeat while state equals 0:
        set state to workspace_process_poll(handle)
        set slept to sleep_ms(10)
    if state is not equal to 1 or else get_list(handle and 3) is not equal to 1792:
        display "FAIL: service did not preserve the child exit status."
        return 10
    set closed to workspace_process_close(handle)
    set closed to net_close(output)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    if file_exists(concat(root and "/injected")) or else not (ptr_to_str(read_file(concat(root and "/cwd-proof.txt"))) equals "Correct service working directory."):
        return 11
    display "PASS: actual service exec preserves literal argv, exact explicit environment, working directory and exit status; check does not execute; NUL, duplicate environment and unknown fields rejected."
    return 0
