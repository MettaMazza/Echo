import "../../app/lifecycle/controller_launch"
import "../../app/workspace/native_process"
import "fs"

# The installed copy is an inert probe. It never starts a service or opens
# Echo's real archive. Its only write is inside the dedicated staged bundle.
define main returning Int:
    if get_argument_count() equals 2:
        if string_contains(get_argument(0) and "/private/var/root/") is not equal to 1 or else not (file_read(get_argument(1)) equals "Echo inert launch fixture."):
            return 21
        if string_length(ptr_to_str(get_env("ECHO_LAUNCH_SECRET"))) is not equal to 0 or else not (ptr_to_str(get_env("PATH")) equals "/usr/bin:/bin"):
            return 22
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set effective_user to ep_dlsym(library and "geteuid")
        if effective_user equals 0 or else ep_dlcall0(effective_user) is not equal to 0:
            return 23
        set closed to ep_dlclose(library)
        if write_file("cwd-proof.txt" and "Inert installed probe ran here.") is not equal to 1:
            return 24
        display "Installed inert probe verified configuration and clean environment."
        return 7
    if get_argument_count() is not equal to 3 or else string_contains(get_argument(1) and "/echo-controller-launch-fixture-") equals 0:
        return 1
    set manifest to file_read(get_argument(1))
    set expected to get_argument(2)
    if controller_bundle_valid(manifest and expected) equals 0 or else controller_bundle_entry(manifest and "probe" and "executable") equals 0 or else controller_bundle_entry(manifest and "launcher" and "executable") equals 0 or else controller_bundle_entry(manifest and "settings.json" and "data") equals 0:
        return 2
    set tokens to provider_json_tokens(manifest)
    if length_list(provider_items(tokens and provider_member(tokens and 0 and "files"))) is not equal to 3:
        return 3
    if not (controller_bundle_stage(manifest and expected and "/private/var/root") equals "staged-not-activated") or else not (controller_bundle_verify(manifest and expected and "/private/var/root") equals "verified-not-authorized-for-activation"):
        return 4
    if controller_bundle_launch(manifest and expected and "/private/var/root" and "probe" and "settings.json" and 1) is not equal to 0:
        return 5
    set root to concat("/private/var/root/" and expected)
    if file_exists(concat(root and "/cwd-proof.txt")):
        return 6
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to protected_path_open(library and root and 1)
    set output to workspace_file_open(library and directory and "stdout.txt" and 1)
    set errors to workspace_file_open(library and directory and "stderr.txt" and 1)
    if output < 0 or else errors < 0:
        return 8
    set arguments to ["run",concat(root and "/bundle.json"),expected,"/private/var/root","probe","settings.json"]
    set process to workspace_process_start(concat(root and "/launcher") and arguments and ["ECHO_LAUNCH_SECRET=must disappear"] and directory and output and errors)
    if process equals 0:
        return 9
    set state to 0
    repeat while state equals 0:
        set state to workspace_process_poll(process)
        set slept to sleep_ms(10)
    if state is not equal to 1 or else get_list(process and 3) is not equal to 1792:
        display "FAIL: installed probe or exit propagation failed. Inspect retained stdout.txt/stderr.txt."
        return 10
    set closed to workspace_process_close(process)
    set closed to net_close(output)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    if not (file_read(concat(root and "/cwd-proof.txt")) equals "Inert installed probe ran here.") or else not (controller_bundle_verify(manifest and expected and "/private/var/root") equals "verified-not-authorized-for-activation"):
        return 11
    display "PASS: root-owned package check did not execute; verified installed launcher ran inert probe with exact configuration, clean environment, correct directory and preserved exit status. No service activated."
    return 0
