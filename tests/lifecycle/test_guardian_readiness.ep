import "../../app/providers/archived_stream"
import "../../app/lifecycle/service_profile"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set root to get_argument(1)
    set runtime to get_argument(2)
    set base to concat("{\"executable\":\"/bin/echo\",\"directory\":" and provider_quote(root))
    set base to concat(base and ",\"arguments\":[\"must-not-execute\"],\"environment\":[")
    set missing to concat(base and concat(provider_quote(concat("ECHO_EXECUTION_RUNTIME=" and root)) and "]}"))
    if service_profile_run(missing and 1) equals 0:
        return 2
    set relative to concat(base and "\"ECHO_EXECUTION_RUNTIME=relative\"]}")
    if service_profile_run(relative and 1) equals 0:
        return 3
    set valid to concat(base and concat(provider_quote(concat("ECHO_EXECUTION_RUNTIME=" and runtime)) and "]}"))
    if service_profile_run(valid and 1) is not equal to 0:
        return 4
    set guardian_path to concat(root and "/execute_guardian")
    if write_file(guardian_path and "Not an executable guardian") is not equal to 1 or else service_profile_run(missing and 1) equals 0:
        return 5
    display "PASS: command-enabled service preflight rejects missing, relative and non-executable guardians; installed guardian passes without starting a service."
    return 0
