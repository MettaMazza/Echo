import "../../app/lifecycle/controller_console"
import "../../app/lifecycle/controller_http"

# Disposable visual fixture. No ledger, credential, model or mutation endpoint.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set script to file_read(get_argument(1))
    set listener to local_socket_listen(0)
    if listener equals 0 or else string_length(script) equals 0:
        return 2
    set library to get_list(listener and 0)
    set port to get_list(listener and 2)
    if write_file(get_argument(2) and int_to_string(port)) is not equal to 1:
        return 3
    repeat while 1 equals 1:
        set descriptor to local_socket_accept(listener)
        if descriptor < 0:
            return 4
        set reader to http_stream_create(library and descriptor and -1)
        set request to http_stream_head(reader)
        set method to archive_list_text(request and 1)
        set path to archive_list_text(request and 2)
        if archive_list_text(request and 0) equals "ready" and web_origin_allowed(request and port and 0 and "") equals 1 and method equals "GET" and path equals "/":
            set sent to controller_console_reply(library and descriptor and "text/html" and controller_console_html())
        else if archive_list_text(request and 0) equals "ready" and web_origin_allowed(request and port and 0 and "") equals 1 and method equals "GET" and path equals "/console.js":
            set sent to controller_console_reply(library and descriptor and "text/javascript" and script)
        else:
            set sent to controller_http_reply(library and descriptor and "403 Forbidden" and "visual-fixture-no-authority")
        set released to http_stream_release(reader)
        set closed to net_close(descriptor)
    return 0
