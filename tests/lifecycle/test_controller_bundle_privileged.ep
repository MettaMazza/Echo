import "../../app/lifecycle/controller_bundle"
import "fs"

# Deliberately limited root qualification: one known inert payload and two
# receipts under a digest-named directory in /private/var/root. No service starts,
# no production archive is opened, and no existing installation is overwritten.
define main returning Int:
    if get_argument_count() is not equal to 3 or else string_contains(get_argument(1) and "/echo-controller-bundle-fixture-") equals 0:
        return 1
    set manifest to file_read(get_argument(1))
    set expected to get_argument(2)
    if controller_bundle_valid(manifest and expected) equals 0:
        return 2
    set tokens to provider_json_tokens(manifest)
    set entries to provider_items(tokens and provider_member(tokens and 0 and "files"))
    if length_list(entries) is not equal to 1:
        return 3
    set entry to get_list(entries and 0)
    if not (provider_value(tokens and provider_member(tokens and entry and "name")) equals "payload") or else not (provider_value(tokens and provider_member(tokens and entry and "kind")) equals "data") or else not (provider_value(tokens and provider_member(tokens and entry and "sha256")) equals ep_sha256("Exact fixture bytes.")):
        return 4
    set parent to "/private/var/root"
    set root to concat(parent and concat("/" and expected))
    if not (controller_bundle_stage(manifest and expected and parent) equals "staged-not-activated") or else not (controller_bundle_verify(manifest and expected and parent) equals "verified-not-authorized-for-activation"):
        return 5
    if not (controller_bundle_stage(manifest and expected and parent) equals "staged-not-activated"):
        return 6
    if write_file(concat(root and "/payload") and "Deliberate fixture corruption.") is not equal to 1:
        return 7
    if not (controller_bundle_verify(manifest and expected and parent) equals "staged-file-bytes-changed") or else not (controller_bundle_stage(manifest and expected and parent) equals "stage-copy:stage-exists-or-unavailable"):
        return 8
    if not (file_read(concat(root and "/payload")) equals "Deliberate fixture corruption."):
        return 9
    if write_file(concat(root and "/payload") and "Exact fixture bytes.") is not equal to 1 or else not (controller_bundle_verify(manifest and expected and parent) equals "verified-not-authorized-for-activation"):
        return 10
    display "PASS: privileged root-owned staging, exact retry, full installed verification, retained corruption rejection and restored verification. No service activated."
    return 0
