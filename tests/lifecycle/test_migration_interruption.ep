import "../../app/lifecycle/migrations"
import "../../app/archive/snapshot"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set mode to get_argument(2)
    if mode equals "prepare":
        if file_exists(path):
            return 2
        set database to archive_open(path)
        if database equals 0 or else archive_append(database and "fixture" and "original" and "fixture" and "Preserve original" and "fixture-time") is not equal to 0:
            return 3
        return sql_close(database)
    if not file_exists(path):
        return 4
    set database to archive_open(path)
    if database equals 0:
        return 5
    if mode equals "migrate":
        # Deliberately long disposable SQL, so the driver kills a live native
        # migration after observing its on-disk rollback journal.
        set outcome to migration_apply(database and 1 and "interrupted-fixture" and "CREATE TABLE interrupted_payload(value INTEGER); WITH RECURSIVE numbers(n) AS (VALUES(1) UNION ALL SELECT n+1 FROM numbers WHERE n<100000000) INSERT INTO interrupted_payload SELECT n FROM numbers;")
        display outcome
        return 6
    if not (mode equals "verify"):
        return 7
    set row to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM sqlite_master WHERE name IN ('interrupted_payload','echo_schema_migrations');"))
    if not (archive_list_text(row and 1) equals "0"):
        return 8
    if archive_verify_all(database) is not equal to 0:
        return 9
    set row to history_collect_one(archive_prepare(database and "SELECT payload FROM echo_events WHERE event='original';"))
    if not (archive_list_text(row and 1) equals "Preserve original"):
        return 10
    if not (migration_apply(database and 1 and "recovered-fixture" and "CREATE TABLE recovered_payload(value TEXT);") equals "applied"):
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    display "PASS: SIGKILL during native migration rolled back DDL/data/receipt, preserved original archive, and allowed a clean later migration."
    return 0
