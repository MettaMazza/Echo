import "../../app/lifecycle/controller_ledger"

# This fixture changes only its newly created directory. It neither installs a
# controller nor opens the production archive. A pre-existing directory aborts.
define main returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if library equals 0:
        display "FAIL: controller ledger check 1."
        return 1
    set effective_user to ep_dlsym(library and "geteuid")
    if ep_dlcall0(effective_user) is not equal to 0:
        display "Root fixture requires explicit host authentication."
        display "FAIL: controller ledger check 2."
        return 2
    set root to "/private/var/root/echo-controller-ledger-fixture-20261016-r2"
    set make_directory to ep_dlsym(library and "mkdir")
    set change_mode to ep_dlsym(library and "chmod")
    set link_file to ep_dlsym(library and "link")
    set symbolic_link to ep_dlsym(library and "symlink")
    set remove_file to ep_dlsym(library and "unlink")
    if make_directory equals 0 or else change_mode equals 0 or else link_file equals 0 or else symbolic_link equals 0 or else remove_file equals 0:
        display "FAIL: controller ledger check 3."
        return 3
    if ep_dlcall2(make_directory and str_to_ptr(root) and 448) is not equal to 0:
        display "Fresh fixture directory required; existing files were not changed."
        display "FAIL: controller ledger check 4."
        return 4
    set database to controller_ledger_open(root and "ledger.sqlite")
    if database equals 0:
        display "FAIL: controller ledger check 5."
        return 5
    if archive_append(database and "probe" and "first" and "probe" and "Exact isolated ledger bytes." and "fixture") is not equal to 0 or else archive_verify(database and "probe") is not equal to 0 or else sql_close(database) is not equal to 0:
        display "FAIL: controller ledger check 6."
        return 6
    set database to controller_ledger_open(root and "ledger.sqlite")
    if database equals 0 or else archive_verify(database and "probe") is not equal to 0 or else sql_close(database) is not equal to 0:
        display "FAIL: controller ledger check 7."
        return 7
    set path to concat(root and "/ledger.sqlite")
    # A public ledger file and a public state directory must both be refused.
    if ep_dlcall2(change_mode and str_to_ptr(path) and 420) is not equal to 0 or else controller_ledger_open(root and "ledger.sqlite") is not equal to 0:
        display "FAIL: controller ledger check 8."
        return 8
    if ep_dlcall2(change_mode and str_to_ptr(path) and 384) is not equal to 0 or else ep_dlcall2(change_mode and str_to_ptr(root) and 493) is not equal to 0 or else controller_ledger_open(root and "ledger.sqlite") is not equal to 0:
        display "FAIL: controller ledger check 9."
        return 9
    if ep_dlcall2(change_mode and str_to_ptr(root) and 448) is not equal to 0:
        display "FAIL: controller ledger check 10."
        return 10
    set linked to concat(root and "/alias.sqlite")
    if ep_dlcall2(link_file and str_to_ptr(path) and str_to_ptr(linked)) is not equal to 0 or else controller_ledger_open(root and "ledger.sqlite") is not equal to 0 or else ep_dlcall1(remove_file and str_to_ptr(linked)) is not equal to 0:
        display "FAIL: controller ledger check 11."
        return 11
    if ep_dlcall2(symbolic_link and str_to_ptr(path) and str_to_ptr(linked)) is not equal to 0 or else controller_ledger_open(root and "alias.sqlite") is not equal to 0 or else ep_dlcall1(remove_file and str_to_ptr(linked)) is not equal to 0:
        display "FAIL: controller ledger check 12."
        return 12
    for each suffix in ["-journal", "-wal", "-shm"]:
        set sidecar to concat(path and ptr_to_str(suffix))
        if ep_dlcall2(symbolic_link and str_to_ptr(path) and str_to_ptr(sidecar)) is not equal to 0 or else controller_ledger_open(root and "ledger.sqlite") is not equal to 0 or else ep_dlcall1(remove_file and str_to_ptr(sidecar)) is not equal to 0:
            display "FAIL: controller ledger check 13."
            return 13
    set database to controller_ledger_open(root and "ledger.sqlite")
    if database equals 0 or else archive_verify(database and "probe") is not equal to 0 or else sql_close(database) is not equal to 0:
        display "FAIL: controller ledger check 14."
        return 14
    set released to ep_dlclose(library)
    display "PASS: isolated root ledger creation, durable reopen, public-mode rejection, hard-link and symlink rejection, SQLite sidecar rejection and intact recovery. No service activated."
    return 0
