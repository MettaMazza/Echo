import "../../app/lifecycle/controller_operations"
import "../../app/lifecycle/controller_bundle"
import "../../app/rights/inventory"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set root to get_argument(1)
    set configuration to file_read(concat(root and "/controller.json"))
    if controller_configuration_valid(configuration) is not equal to 1:
        return 2
    set charter to concat(root and "/charter.json")
    if string_length(charter_verified_text(charter)) equals 0:
        return 3
    set inventory to file_read(concat(root and "/inventory.json"))
    set tokens to provider_json_tokens(inventory)
    set entries to provider_items(tokens and provider_member(tokens and 0 and "targets"))
    if entries equals 0 or else length_list(entries) equals 0:
        return 4
    # One lookup validates every entry and duplicate before returning. Repeating
    # that complete scan once per target adds no coverage.
    set entry to get_list(entries and length_list(entries) - 1)
    set path to provider_value(tokens and provider_member(tokens and entry and "path"))
    set expected to provider_value(tokens and provider_member(tokens and entry and "category"))
    if not (protected_inventory_category(charter and inventory and ep_sha256(inventory) and path) equals expected):
        return 5
    set names to ["inputs-manifest.json","service-manifest.json"]
    for each name in names:
        set suffix to concat("/" and ptr_to_str(name))
        set manifest to file_read(concat(root and suffix))
        if not (controller_bundle_preflight(manifest and ep_sha256(manifest)) equals "bytes-verified"):
            return 6
    display "PASS: actual release configuration, unchanged charter, every inventory category and both complete bundle manifests verified. No installation or authority granted."
    return 0
