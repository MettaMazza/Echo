import "../../app/lifecycle/controller_bundle"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else string_contains(get_argument(1) and "bundle-fixture") equals 0:
        return 1
    set root to get_argument(1)
    set source to concat(root and "/payload.txt")
    if file_exists(source) or else write_file(source and "Exact fixture bytes.") is not equal to 1:
        return 2
    set entry to concat("{\"name\":\"payload\",\"source\":" and provider_quote(source))
    set entry to concat(entry and concat(",\"sha256\":" and provider_quote(ep_sha256("Exact fixture bytes."))))
    set entry to concat(entry and ",\"kind\":\"data\"}")
    set manifest to concat("{\"version\":1,\"files\":[" and concat(entry and "]}"))
    if not (controller_bundle_preflight(manifest and ep_sha256(manifest)) equals "bytes-verified") or else controller_bundle_valid(manifest and ep_sha256("other")) is not equal to 0:
        return 3
    set duplicate to concat("{\"version\":1,\"files\":[" and concat(entry and concat("," and concat(entry and "]}"))))
    if controller_bundle_valid(duplicate and ep_sha256(duplicate)) is not equal to 0:
        return 4
    for each name in ["../payload", "sub/payload", ".", "bundle.json", "complete", ""]:
        set invalid to string_replace(manifest and "\"name\":\"payload\"" and concat("\"name\":" and provider_quote(name)))
        if controller_bundle_valid(invalid and ep_sha256(invalid)) is not equal to 0:
            return 5
    set invalid to string_replace(manifest and "\"kind\":\"data\"" and "\"kind\":\"root-command\"")
    if controller_bundle_valid(invalid and ep_sha256(invalid)) is not equal to 0:
        return 6
    set invalid to string_replace(manifest and "\"version\":1" and "\"version\":1,\"activate\":true")
    if controller_bundle_valid(invalid and ep_sha256(invalid)) is not equal to 0:
        return 7
    set invalid to string_replace(manifest and "\"name\":\"payload\"" and "\"name\":\"payload\\u0000hidden\"")
    if controller_bundle_valid(invalid and ep_sha256(invalid)) is not equal to 0:
        return 8
    if not (controller_bundle_stage(manifest and ep_sha256(manifest) and "/Library/LaunchDaemons") equals "root-installation-required"):
        return 9
    if write_file(concat(root and "/manifest.json") and manifest) is not equal to 1:
        return 10
    if write_file(source and "Changed source bytes.") is not equal to 1 or else not (controller_bundle_preflight(manifest and ep_sha256(manifest)) equals "source-unreadable-or-changed"):
        return 11
    if write_file(source and "Exact fixture bytes.") is not equal to 1:
        return 12
    display "PASS: exact package/source digests, duplicate/traversal/reserved/NUL names, unknown fields/kinds, changed bytes and unprivileged staging denial. No privileged staging or activation tested."
    return 0
