import "../../app/lifecycle/startup"

# Orchestrated transport fixture. Lock only an explicitly named test archive;
# the release file controls duration without changing application timeouts.
define main returning Int:
    if get_argument_count() is not equal to 4 or else string_index_of(get_argument(1) and "busy-http-fixture") < 0:
        return 1
    set database to sql_open(get_argument(1))
    if database equals 0 or else sql_execute(database and "BEGIN EXCLUSIVE;") is not equal to 0:
        return 2
    set ready to write_file(get_argument(2) and "locked")
    repeat while not file_exists(get_argument(3)):
        set waited to sleep_ms(100)
    if sql_execute(database and "COMMIT;") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 3
    return 0
