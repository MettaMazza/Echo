import "../../app/lifecycle/controller_review_inputs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    if not (archive_list_text(controller_review_inputs_load("/missing") and 0) equals "root-controller-required"):
        return 2
    set database to archive_open(get_argument(1))
    if not (controller_schema_initialize(database and ep_sha256("fixture")) equals "initialized"):
        return 3
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "owner" and "Fixture" and "fixture-secret") is not equal to 0:
        return 4
    set submitted to web_submit_owned(database and "owner" and "review" and "" and "Review the fixture proposal.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 5
    set profile to provider_llama_profile("fixture-model" and 8080)
    set prompt to "Exact fixture identity: café, Ω, quoted \"text\".\nNo rewrite. FINAL-MARKER"
    if sql_execute(database and "CREATE TRIGGER fixture_prompt_failure BEFORE INSERT ON echo_events WHEN NEW.kind='controller_review_prompt' BEGIN SELECT RAISE(ABORT,'fixture prompt interruption'); END;") is not equal to 0:
        return 6
    if not (controller_review_inputs_bind(database and "review" and profile and prompt) equals "controller-review-prompt-write-failed") or else sql_execute(database and "DROP TRIGGER fixture_prompt_failure;") is not equal to 0:
        return 7
    if not (controller_review_inputs_bind(database and "review" and profile and prompt) equals "bound") or else sql_close(database) is not equal to 0:
        return 8
    set database to archive_open(get_argument(1))
    if not (controller_review_inputs_bind(database and "review" and profile and prompt) equals "bound"):
        return 9
    set changed to concat(prompt and " altered")
    if not (controller_review_inputs_bind(database and "review" and profile and changed) equals "controller-review-prompt-conflict"):
        return 10
    set alternate to provider_llama_profile("other-model" and 8080)
    if not (controller_review_inputs_bind(database and "review" and alternate and prompt) equals "controller-review-profile-conflict"):
        return 11
    set messages to controller_review_bound_messages(database and "review")
    set tokens to provider_json_tokens(messages)
    set items to provider_items(tokens and 0)
    if length_list(items) < 2:
        return 12
    set first to get_list(items and 0)
    if not (provider_value(tokens and provider_member(tokens and first and "role")) equals "system") or else not (provider_value(tokens and provider_member(tokens and first and "content")) equals prompt):
        return 13
    set last to get_list(items and length_list(items) - 1)
    if not (provider_value(tokens and provider_member(tokens and last and "content")) equals "Review the fixture proposal."):
        return 15
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set set_environment to ep_dlsym(library and "setenv")
    if ep_dlcall3(set_environment and str_to_ptr("ECHO_CONTROLLER_REVIEW_RUN") and str_to_ptr("review") and 1) is not equal to 0:
        return 16
    if not (echo_system_prompt(database and "review") equals prompt):
        return 17
    set restored to ep_dlcall3(set_environment and str_to_ptr("ECHO_CONTROLLER_REVIEW_RUN") and str_to_ptr("") and 1)
    if archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0:
        return 14
    display "PASS: protected input loader denies unprivileged access; exact prompt/profile binding survives interruption, reopen and retry, rejects replacements and preserves complete system text."
    return sql_close(database)
