import "../fixtures/tool_call_fixture"

define research_test_status with text as Str returning Str:
    set tokens to provider_json_tokens(text)
    return provider_value(tokens and provider_member(tokens and 0 and "status"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    if not (network_query_encode("café & +?") equals "caf%C3%A9%20%26%20%2B%3F"):
        return 2
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 3
    for each name in ["owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 4
    set fetched to tool_fixture_call(database and "owner" and "page" and "web_fetch" and "{\"url\":\"https://httpbin.org/links/2/0\"}")
    if not (research_test_status(fetched) equals "complete"):
        display fetched
        return 5
    set tokens to provider_json_tokens(fetched)
    set sources to provider_member(tokens and 0 and "sources")
    set attachment to provider_value(tokens and provider_member(tokens and sources + 1 and "document"))
    set saved to web_attachment_owned(database and "owner" and attachment)
    if not (archive_list_text(saved and 0) equals "found"):
        return 6
    set target to web_navigation_resolve(database and archive_list_text(saved and 6) and attachment and 0)
    if not (archive_list_text(target and 0) equals "found") or else string_contains(archive_list_text(target and 1) and "httpbin.org/links/2/1") equals 0:
        display archive_list_text(target and 0)
        return 7
    set hidden to tool_fixture_call(database and "foreign" and "foreign" and "web_follow" and concat("{\"document\":" and concat(provider_quote(attachment) and ",\"link\":0}")))
    if not (research_test_status(hidden) equals "source-unavailable"):
        display hidden
        return 8
    if agent_cancel_run(database and "page") is not equal to 0:
        return 9
    set submitted to web_submit_owned(database and "owner" and "follow" and archive_list_text(saved and 6) and "Follow the first saved link")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        display archive_list_text(submitted and 0)
        return 10
    set followed to tool_fixture_call(database and "owner" and "follow" and "web_follow" and concat("{\"document\":" and concat(provider_quote(attachment) and ",\"link\":0}")))
    if not (research_test_status(followed) equals "complete"):
        display followed
        return 11
    set origin to archive_read_event(database and "follow:navigation:jobs")
    if origin equals 0 or else string_contains(archive_list_text(origin and 3) and archive_list_text(saved and 4)) equals 0:
        return 12
    set searched to tool_fixture_call(database and "owner" and "search" and "web_search" and "{\"query\":\"ErnosPlain programming language\"}")
    if not (research_test_status(searched) equals "complete") or else string_contains(searched and "document") equals 0:
        display searched
        return 13
    set tokens to provider_json_tokens(searched)
    set sources to provider_member(tokens and 0 and "sources")
    set attachment to provider_value(tokens and provider_member(tokens and sources + 1 and "document"))
    set saved to web_attachment_owned(database and "owner" and attachment)
    set document to file_text_read(archive_list_text(saved and 1) and archive_list_text(saved and 4) and string_to_int(archive_list_text(saved and 5)) and 65536)
    if not (archive_list_text(document and 0) equals "verified") or else string_contains(archive_list_text(document and 1) and "result__a") equals 0:
        return 14
    display "PASS: real search source, complete extracted document, UTF-8 query encoding, source-scoped link navigation, foreign denial and exact navigation digest provenance through streamed dispatch."
    return sql_close(database)
