import "../../app/tools/web_fetch"

define main returning Int:
    set sample to "{\"title\":\"Evidence café\",\"text\":\"A source with a verified fact.\",\"links\":[{\"index\":0,\"url\":\"https://example.com/source\",\"text\":\"Source\"}]}"
    set preview to web_fetch_document_preview(sample)
    set tokens to provider_json_tokens(preview)
    if not (provider_value(tokens and provider_member(tokens and 0 and "title")) equals "Evidence café") or else not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "A source with a verified fact.") or else not (provider_kind(tokens and provider_member(tokens and 0 and "complete_text")) equals "true"):
        display preview
        return 1
    set builder to create_builder()
    set index to 0
    repeat while index < 12001:
        set added to builder_append(builder and "é")
        set index to index + 1
    set long_text to ptr_to_str(builder_to_string(builder))
    set sample to concat("{\"title\":\"Long\",\"text\":" and concat(provider_quote(long_text) and ",\"links\":[]}"))
    set preview to web_fetch_document_preview(sample)
    set tokens to provider_json_tokens(preview)
    if string_length(provider_value(tokens and provider_member(tokens and 0 and "text"))) is not equal to 24000 or else not (provider_kind(tokens and provider_member(tokens and 0 and "complete_text")) equals "false") or else string_length(long_text) is not equal to 24002:
        return 2
    if not (web_fetch_document_preview("not json") equals "null"):
        return 3
    set sample to "{\"title\":\"Article\",\"text\":\"Nav Evidence Footer\",\"reading_text\":\"Evidence\",\"reading_scope\":\"publisher-main-content\",\"links\":[{\"index\":0,\"url\":\"https://example.com/source\",\"href\":\"/source\",\"class\":\"long-layout-data\",\"text\":\"Source\"}]}"
    set preview to web_fetch_document_preview(sample)
    set tokens to provider_json_tokens(preview)
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "Evidence") or else string_contains(preview and "long-layout-data") > 0 or else string_contains(sample and "Footer") equals 0:
        return 4
    set sample to "{\"representation\":\"brave-search-api\",\"text\":\"[0] Source https://example.com\",\"links\":[{\"index\":0,\"url\":\"https://example.com\",\"text\":\"Source\"}]}"
    set preview to web_fetch_document_preview(sample)
    if string_contains(preview and "\"links\":[]") equals 0 or else string_contains(preview and "https://example.com") equals 0:
        return 5
    display "PASS: inline source content and links, Unicode paging, explicit incompleteness, preserved original and malformed-document refusal."
    return 0
