import "../fixtures/tool_call_fixture"
import "../../app/network/media_type"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    if not (network_media_type(" Application/PDF ; charset=binary") equals "application/pdf") or else not (network_media_type("text/htmlx") equals "text/htmlx") or else not (network_media_type("text/html\r\nInjected: x") equals "application/octet-stream") or else not (network_media_type("") equals "application/octet-stream"):
        return 2
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 3
    for each item in ["owner","foreign"]:
        set device to ptr_to_str(item)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 4
    set fetched to tool_fixture_call(database and "owner" and "pdf-source" and "web_fetch" and "{\"url\":\"https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\"}")
    set tokens to provider_json_tokens(fetched)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "complete"):
        display fetched
        return 5
    set items to provider_items(tokens and provider_member(tokens and 0 and "sources"))
    set last to get_list(items and length_list(items) - 1)
    set attachment to provider_value(tokens and provider_member(tokens and last and "body"))
    if not (provider_value(tokens and provider_member(tokens and last and "body_media_type")) equals "application/pdf"):
        return 6
    set saved to web_attachment_owned(database and "owner" and attachment)
    if not (archive_list_text(saved and 3) equals "application/pdf") or else not (archive_list_text(web_attachment_owned(database and "foreign" and attachment) and 0) equals "end"):
        return 7
    set arguments to concat("{\"attachment\":" and concat(provider_quote(attachment) and ",\"page\":0,\"offset\":0,\"characters\":1000}"))
    set read to attachment_text_execute(database and archive_list_text(saved and 6) and arguments)
    if string_contains(read and "pdfkit-page-text") equals 0 or else string_contains(read and "Dummy PDF file") equals 0:
        display read
        return 8
    if sql_close(database) is not equal to 0:
        return 9
    set database to archive_open(get_argument(1))
    set reread to attachment_text_execute(database and archive_list_text(saved and 6) and arguments)
    if string_contains(reread and "Dummy PDF file") equals 0:
        return 10
    display "PASS: real public PDF fetch retains declared MIME, original digest and scope; normal attachment tool extracts its page text and reopens it durably."
    return sql_close(database)
