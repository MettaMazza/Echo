import "../fixtures/tool_call_fixture"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    for each item in ["web_fetch","web_search","web_follow"]:
        set name to ptr_to_str(item)
        # Missing arguments must reach validation, not become an access denial.
        # This exercises real streamed intake and dispatch without network I/O.
        set result to tool_fixture_call(database and "owner" and name and name and "{}")
        set tokens to provider_json_tokens(result)
        if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "invalid-arguments"):
            display name
            display result
            return 4
        # A separate runner step observes completed tools and returns to ready.
        if agent_tool_step(database and name) is not equal to 0:
            return 6
        set state to history_collect_one(checkpoint_prepare(database and "SELECT state FROM echo_runs WHERE run=?1;" and [name]))
        if not (archive_list_text(state and 1) equals "ready"):
            return 5
    display "PASS: fetch, search and follow retain their exact bound authority through shared dispatch; invalid arguments do not cancel the run."
    return sql_close(database)
