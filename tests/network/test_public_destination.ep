import "../../app/network/public_url"

define main returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    for each pair in [["127.0.0.1","0"],["10.2.3.4","0"],["172.31.1.2","0"],["192.168.1.1","0"],["100.64.0.1","0"],["169.254.169.254","0"],["192.0.2.1","0"],["224.0.0.1","0"],["8.8.8.8","1"],["1.1.1.1","1"],["192.0.0.9","1"]]:
        set bytes to research_native_words(2)
        if ep_dlcall3(ep_dlsym(library and "inet_pton") and 2 and str_to_ptr(archive_list_text(pair and 0)) and get_list_data_ptr(bytes)) is not equal to 1 or else network_address_public(library and 2 and get_list_data_ptr(bytes)) is not equal to string_to_int(archive_list_text(pair and 1)):
            display archive_list_text(pair and 0)
            return 1
    for each pair in [["::1","0"],["::ffff:127.0.0.1","0"],["fc00::1","0"],["fe80::1","0"],["2001:db8::1","0"],["2002:7f00:1::","0"],["2606:4700:4700::1111","1"],["2001:4860:4860::8888","1"]]:
        set bytes to research_native_words(2)
        if ep_dlcall3(ep_dlsym(library and "inet_pton") and 30 and str_to_ptr(archive_list_text(pair and 0)) and get_list_data_ptr(bytes)) is not equal to 1 or else network_address_public(library and 30 and get_list_data_ptr(bytes)) is not equal to string_to_int(archive_list_text(pair and 1)):
            display archive_list_text(pair and 0)
            return 2
    for each raw in ["file:///etc/passwd","ftp://example.com/file","http://user:pass@example.com/","http://@example.com/","http://[fe80::1%25en0]/","http://example.com/\r\nheader:value"]:
        if archive_list_text(network_url_parse(ptr_to_str(raw) and "") and 0) equals "parsed":
            display ptr_to_str(raw)
            return 3
    set relative to network_url_parse("../new?q=1#anchor" and "https://example.com/old/path")
    if not (archive_list_text(relative and 0) equals "parsed") or else not (archive_list_text(relative and 1) equals "https://example.com/new?q=1") or else not (archive_list_text(relative and 3) equals "443"):
        display archive_list_text(relative and 1)
        return 4
    for each raw in ["http://127.1/","http://2130706433/","http://0x7f000001/","http://[::ffff:127.0.0.1]/","http://localhost/"]:
        set parsed to network_url_parse(ptr_to_str(raw) and "")
        if not (archive_list_text(parsed and 0) equals "parsed"):
            return 5
        set resolved to network_resolve_public(archive_list_text(parsed and 2) and archive_list_text(parsed and 3))
        if not (archive_list_text(resolved and 0) equals "non-public-destination"):
            display archive_list_text(resolved and 0)
            return 6
    set public to network_resolve_public("example.com" and "443")
    if not (archive_list_text(public and 0) equals "public-addresses") or else length_list(get_list(public and 1)) equals 0:
        display archive_list_text(public and 0)
        return 7
    display "PASS: native curl URL parsing, relative URLs, credentials/protocol/zone rejection, numeric local aliases, IPv4/IPv6 special ranges and real DNS public-address selection. No fetch/redirect worker claimed."
    return ep_dlclose(library)
