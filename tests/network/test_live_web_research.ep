import "../../app/agent/runner"
import "../../app/jobs/schedule_store"
import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set message to "Isolated research acceptance. Use web_search for ErnosPlain programming language. Read the returned extracted document attachment with attachment_read_text to inspect its text and numbered links. Then use web_follow with that document attachment and the index of an actual relevant search-result link. Inspect the fetched source or extracted document. Only claim facts supported by those sources and cite the final URL. When search, reading and navigation have succeeded, finish with research-links-cedar."
    set submitted to web_submit_owned(database and "owner" and "live-web-research" and "" and message)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "live-web-research" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set fetched to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='live-web-research' AND json_extract(q.payload,'$.name')='web_search' AND json_extract(e.payload,'$.result.status')='complete';"))
    set inspected to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='live-web-research' AND json_extract(q.payload,'$.name')='attachment_read_text' AND json_extract(e.payload,'$.result.status')='found';"))
    set navigated to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='live-web-research' AND json_extract(q.payload,'$.name')='web_follow' AND json_extract(e.payload,'$.result.status')='complete';"))
    if string_to_int(archive_list_text(fetched and 1)) < 1 or else string_to_int(archive_list_text(inspected and 1)) < 1 or else string_to_int(archive_list_text(navigated and 1)) < 1:
        return 6
    set final to agent_run_read(database and "live-web-research")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if reply equals 0 or else string_contains(archive_list_text(reply and 3) and "research-links-cedar") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual local model searched the web, read the saved document, followed a result link through the normal ReAct tools, and completed with the requested marker."
    return sql_close(database)
