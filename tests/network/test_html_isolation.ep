import "fs"
import "../../app/network/html_document"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set secret_path to concat(get_argument(1) and ".external")
    if file_exists(secret_path) or else write_file(secret_path and "external-file-canary-cedar") is not equal to 1:
        return 2
    set text to concat("<!DOCTYPE html [<!ENTITY private SYSTEM 'file://" and concat(secret_path and "'>]><html><head><meta charset='utf-8'><title>Local fixture</title></head><body>&private;<script src='http://127.0.0.1:49675/private'>hidden-script</script><img src='http://127.0.0.1:49675/private'><form id='challenge-form'></form><a class='result__a' href='/result'>Result</a><p>visible-tail-marker</p></body></html>"))
    if write_file(get_argument(1) and text) is not equal to 1:
        return 3
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to native_open_mode(library and get_argument(1) and 16777472 and 0)
    set result to network_html_extract(descriptor and "https://example.test/")
    set closed to net_close(descriptor)
    set closed to ep_dlclose(library)
    set tokens to provider_json_tokens(result)
    if string_contains(result and "external-file-canary-cedar") is not equal to 0 or else string_contains(result and "hidden-script") is not equal to 0 or else string_contains(result and "visible-tail-marker") equals 0:
        display result
        return 4
    if not (provider_value(tokens and provider_member(tokens and 0 and "search_challenge")) equals "true") or else not (provider_value(tokens and provider_member(tokens and 0 and "search_result_count")) equals "1"):
        display result
        return 5
    display "PASS: external entity file content was not loaded, script text excluded, visible tail retained and explicit search challenge/result markers recognized."
    return 0
