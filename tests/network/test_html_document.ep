import "fs"
import "../../app/network/html_document"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set fixture to "<!doctype html><html><head><meta charset='utf-8'><title>Echo &amp; café</title><base href='https://example.com/docs/'></head><body><h1>Résumé</h1><p>First &lt;second&gt; &#x1F642;</p><script>secret-script-content</script><style>secret-style-content</style><a href='../next?q=1&amp;x=2'>Next &amp; page</a><a href='javascript:alert(1)'>Unsafe link</a><p>tail-marker-cedar</p></body></html>"
    if write_file(get_argument(1) and fixture) is not equal to 1:
        return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to native_open_mode(library and get_argument(1) and 16777472 and 0)
    if descriptor < 0:
        return 3
    set result to network_html_extract(descriptor and "https://example.com/start")
    set closed to net_close(descriptor)
    set closed to ep_dlclose(library)
    set tokens to provider_json_tokens(result)
    set text to provider_value(tokens and provider_member(tokens and 0 and "text"))
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "extracted") or else string_contains(text and "tail-marker-cedar") equals 0 or else string_contains(text and "secret-script-content") is not equal to 0 or else string_contains(text and "secret-style-content") is not equal to 0:
        display result
        return 4
    if not (provider_value(tokens and provider_member(tokens and 0 and "title")) equals "Echo & café") or else string_contains(result and "https://example.com/next?q=1&x=2") equals 0:
        display result
        return 5
    set links to provider_member(tokens and 0 and "links")
    set second to provider_after(tokens and links + 1) + 1
    if not (provider_value(tokens and provider_member(tokens and second and "url")) equals ""):
        return 6
    display "PASS: native HTML title/text/link extraction, entities, declared base, relative navigation, script/style exclusion, unsupported link refusal and retained final text."
    return 0
