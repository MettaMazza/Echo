import "../../app/network/fetch"
import "../../app/providers/helper_process"

define fetch_cancel_when_started with path as Str and pipe as List and done as Int returning Int:
    repeat while not (file_exists(concat(path and "/hop-0.request.json"))):
        if file_exists(concat(path and "/result.json")):
            send 1 to done
            return 0
        set slept to sleep_ms(10)
    set slept to sleep_ms(100)
    set closed to socket_cancel(pipe)
    send closed to done
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and get_argument(3))
    set output to workspace_file_open(library and directory and "stdout" and 1)
    set errors to workspace_file_open(library and directory and "stderr" and 1)
    set pipe to socket_cancellation_create(library)
    if directory < 0 or else output < 0 or else errors < 0 or else pipe equals 0:
        return 3
    set done to channel
    spawn fetch_cancel_when_started(get_argument(3) and pipe and done)
    set arguments to ["https://httpbingo.org/delay/10",get_argument(3)]
    set environment to ["LC_ALL=C","PATH=/usr/bin:/bin"]
    set result to provider_helper_run(database and "fetch-cancel" and "cancelled-fetch" and get_argument(2) and arguments and environment and directory and output and errors and get_list(pipe and 0))
    set cancelled to receive from done
    if not (archive_list_text(result and 0) equals "cancelled") or else get_list(result and 1) < 0 or else cancelled is not equal to 0 or else file_exists(concat(get_argument(3) and "/result.json")):
        display archive_list_text(result and 0)
        return 4
    set closed to socket_cancellation_close(pipe)
    set closed to file_stage_finish(library and output)
    set closed to file_stage_finish(library and errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    display "PASS: public fetch cancelled after its durable request; child reaped, dispatch/result retained, no false completed receipt."
    return sql_close(database)
