import "fs"
import "../../app/network/html_document"
define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to native_open_mode(library and get_argument(1) and 16777472 and 0)
    if descriptor < 0:
        return 2
    set result to network_html_extract(descriptor and get_argument(2))
    set closed to net_close(descriptor)
    set closed to ep_dlclose(library)
    if write_file(get_argument(3) and result) is not equal to 1:
        return 3
    return 0
