import "../../app/agent/runner"
import "../../app/jobs/schedule_store"
import "../../app/web/worker"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set message to "Isolated public web research acceptance: use web_fetch to get https://example.com/. Then use attachment_read_text on the returned body attachment, offset 0, characters 10000, to read the source. Quote the page title and cite its URL. Do not use shell commands. When both tool calls have succeeded, reply with web-source-cedar."
    set submitted to web_submit_owned(database and "owner" and "live-web-fetch" and "" and message)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "live-web-fetch" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set fetched to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='live-web-fetch' AND json_extract(q.payload,'$.name')='web_fetch' AND json_extract(e.payload,'$.result.status')='complete';"))
    set inspected to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='live-web-fetch' AND json_extract(q.payload,'$.name')='attachment_read_text' AND json_extract(e.payload,'$.result.status')='found' AND instr(e.payload,'Example Domain')>0;"))
    if string_to_int(archive_list_text(fetched and 1)) < 1 or else string_to_int(archive_list_text(inspected and 1)) < 1:
        return 6
    set final to agent_run_read(database and "live-web-fetch")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if reply equals 0 or else string_contains(archive_list_text(reply and 3) and "web-source-cedar") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual local model fetched a public HTTPS source, read its retained original through attachment_read_text, and completed the normal ReAct loop with the requested marker."
    return sql_close(database)
