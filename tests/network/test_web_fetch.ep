import "../fixtures/tool_call_fixture"

define fetch_test_status with text as Str returning Str:
    set tokens to provider_json_tokens(text)
    return provider_value(tokens and provider_member(tokens and 0 and "status"))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (schedule_schema(database) equals "applied") or else web_worker_schema(database) is not equal to 0:
        return 2
    for each name in ["owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set denied to tool_fixture_call(database and "owner" and "local" and "web_fetch" and "{\"url\":\"http://127.0.0.1:49675/\"}")
    if not (fetch_test_status(denied) equals "non-public-destination"):
        display denied
        return 4
    set forged to tool_fixture_call(database and "owner" and "forged" and "web_fetch" and "{\"url\":\"https://example.com/\",\"headers\":{\"Authorization\":\"forged\"}}")
    if not (fetch_test_status(forged) equals "invalid-arguments"):
        display forged
        return 5
    set fetched to tool_fixture_call(database and "owner" and "public" and "web_fetch" and "{\"url\":\"https://example.com/\"}")
    if not (fetch_test_status(fetched) equals "complete") or else string_contains(fetched and "body_sha256") equals 0:
        display fetched
        return 6
    set tokens to provider_json_tokens(fetched)
    set sources to provider_member(tokens and 0 and "sources")
    set attachment to provider_value(tokens and provider_member(tokens and sources + 1 and "body"))
    set saved to web_attachment_owned(database and "owner" and attachment)
    if not (archive_list_text(saved and 0) equals "found") or else not (archive_list_text(web_attachment_owned(database and "foreign" and attachment) and 0) equals "end"):
        return 7
    set original to file_text_read(archive_list_text(saved and 1) and archive_list_text(saved and 4) and string_to_int(archive_list_text(saved and 5)) and 65536)
    if not (archive_list_text(original and 0) equals "verified") or else string_contains(archive_list_text(original and 1) and "Example Domain") equals 0:
        return 8
    set read_arguments to concat("{\"attachment\":" and concat(provider_quote(attachment) and ",\"offset\":0,\"characters\":10000}"))
    set passage to attachment_text_execute(database and archive_list_text(saved and 6) and read_arguments)
    if not (fetch_test_status(passage) equals "found") or else string_contains(passage and "Example Domain") equals 0:
        display passage
        return 12
    if not (group_create(database and "owner" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "owner" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "owner" and "shared-fetch" and "shared" and "discord" and "server" and "room" and "Read a public source") equals "accepted"):
        return 13
    set shared to tool_fixture_call(database and "owner" and "shared-fetch" and "web_fetch" and "{\"url\":\"https://example.com/\"}")
    if not (fetch_test_status(shared) equals "complete"):
        display shared
        return 14
    set discovery to tool_discovery_execute(database and "public" and "{\"query\":\"web_fetch\",\"after\":0,\"catalog_digest\":\"\"}")
    if string_contains(discovery and "network.public-read") equals 0:
        display discovery
        return 9
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (archive_list_text(web_attachment_owned(database and "owner" and attachment) and 0) equals "found"):
        return 10
    if not (principal_host_revocation(database and "revoke" and "device:owner" and 1 and "fixture") equals "recorded") or else not (fetch_test_status(web_fetch_execute(database and "public" and "jobs" and -1)) equals "not-authorized"):
        return 11
    display "PASS: actual streamed web_fetch dispatch, public TLS transfer, full source/digest readback, local destination denial, forged option rejection, foreign source isolation, discovery, durable reopen and revocation."
    return sql_close(database)
