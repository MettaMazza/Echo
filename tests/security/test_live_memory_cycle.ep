import "../../app/web/attachments"
import "../../app/agent/runner"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "rowan" and "Memory cycle fixture" and "fixture-secret") is not equal to 0:
        return 3
    set earlier to web_submit_owned(database and "rowan" and "earlier" and "" and "My name is Rowan. I prefer brief replies. Mirroring and empathy are welcome. Before editing a file, read it.")
    set episode to web_submit_owned(database and "rowan" and "episode" and "" and "Today we fixed the garden sensor together. Remember that shared milestone.")
    set current to web_submit_owned(database and "rowan" and "current" and "" and "What is my name and what did we fix together? Also remember how I want you to handle files. Reply briefly.")
    if not (archive_list_text(current and 0) equals "accepted"):
        return 4
    set result to agent_loop_provider(database and "current" and ptr_to_str(read_file(ptr_to_str(get_env("ECHO_PROVIDER_PROFILE")))) and 2048 and -1 and 65536)
    if not (result equals "completed"):
        display result
        return 5
    set row to agent_run_read(database and "current")
    set final to archive_read_event(database and archive_list_text(row and 3))
    set text to memory_source_text(final)
    if string_contains(text and "Rowan") equals 0 or else string_contains(text and "sensor") equals 0 or else string_contains(text and "read") equals 0:
        display text
        return 6
    if length_list(memory_pending(database and "current")) is not equal to 0:
        return 7
    display "PASS: local model automatically extracts prior-session identity, preference, workflow and shared experience, then recalls them in a new conversation."
    return sql_close(database)
