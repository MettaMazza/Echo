import "../../app/security/group_runs"
import "../../app/web/run_store"
import "../../app/tools/workspace_tools"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set text to ptr_to_str(name)
        if web_pairing_invite(database and text) is not equal to 0 or else web_device_pair(database and text and text and text and concat(text and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "local" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "s" and "g" and "local" and "server" and "room" and 3) equals "created"):
        return 4
    set created to workspace_tool_execute_device(database and "a" and "s" and "{\"path\":\"shared.ep\",\"text\":\"display 42\"}" and "create")
    set tokens to provider_json_tokens(created)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "created"):
        display created
        return 5
    set arguments to "{\"path\":\"shared.ep\",\"offset\":0,\"characters\":100}"
    set read to workspace_tool_execute_device(database and "b" and "s" and arguments and "read")
    set tokens to provider_json_tokens(read)
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "display 42"):
        display read
        return 6
    if workspace_session_allowed(database and "c" and "s") is not equal to 0 or else workspace_session_allowed(database and "a" and "s") is not equal to 1:
        return 7
    set denied to workspace_tool_execute_device(database and "c" and "s" and arguments and "read")
    set tokens to provider_json_tokens(denied)
    if provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found":
        return 8
    set private to web_submit_owned(database and "a" and "private" and "" and "Private fixture")
    if not (archive_list_text(private and 0) equals "accepted"):
        return 9
    set created to workspace_tool_execute(database and archive_list_text(private and 1) and "{\"path\":\"private.ep\",\"text\":\"private-canary\"}" and "create")
    set tokens to provider_json_tokens(created)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "created"):
        return 16
    set denied to workspace_tool_execute_device(database and "b" and archive_list_text(private and 1) and "{\"path\":\"private.ep\",\"offset\":0,\"characters\":100}" and "read")
    set tokens to provider_json_tokens(denied)
    if provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found":
        return 10
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "Fixture") equals "recorded") or else workspace_session_allowed(database and "a" and "s") is not equal to 0 or else workspace_session_allowed(database and "b" and "s") is not equal to 1:
        return 11
    set read to workspace_tool_execute_device(database and "b" and "s" and arguments and "read")
    set tokens to provider_json_tokens(read)
    if not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "display 42"):
        return 12
    if not (group_change(database and "b" and "leave" and "g" and "device:b" and "left" and 3) equals "recorded") or else workspace_session_allowed(database and "b" and "s") is not equal to 0:
        return 13
    if sql_close(database) is not equal to 0:
        return 14
    set database to archive_open(get_argument(1))
    if workspace_session_allowed(database and "b" and "s") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 15
    display "PASS: two members share one workspace; outsider/private-scope denial, creator revocation does not borrow or remove another member's authority, leave and restart denial."
    return 0
