import "../../app/agent/tool_recovery"
import "../../app/tools/continuity_tools"

# Read-only replay of an existing owned tool request; never print trace content.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    set arguments to concat("{\"event\":" and concat(provider_quote(get_argument(3)) and ",\"offset\":0,\"characters\":400}"))
    set result to continuity_execute(database and get_argument(2) and "reasoning_read" and arguments)
    set tokens to provider_json_tokens(result)
    set status to provider_value(tokens and provider_member(tokens and 0 and "status"))
    set source to provider_value(tokens and provider_member(tokens and 0 and "event"))
    if not (status equals "found") or else not (source equals get_argument(4)) or else string_length(provider_value(tokens and provider_member(tokens and 0 and "reasoning_text"))) equals 0:
        display concat("FAIL: " and status)
        return 2
    display concat("PASS: captured reasoning resolved to " and source)
    return sql_close(database)
