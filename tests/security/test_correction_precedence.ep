import "../../app/web/attachments"
import "../../app/memory/context_snapshot"
import "../../app/memory/knowledge_lifecycle"
import "../../app/memory/corrections"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    if web_pairing_invite(database and "foreign") is not equal to 0 or else web_device_pair(database and "foreign" and "outsider" and "Other" and "other-secret") is not equal to 0:
        return 4
    set original to web_submit_owned(database and "owner" and "original" and "" and "The sample weighs 73 grams.")
    set source to archive_read_event(database and "original:user")
    set digest to archive_list_text(source and 6)
    set claim to knowledge_record(database and "original" and "semantic" and "sample" and "mass" and "73 grams" and "source-account" and "original:user" and digest and "" and "" and "")
    if string_index_of(claim and "recorded:") is not equal to 0:
        return 5
    set identity to substring(claim and 9 and string_length(claim) - 9)
    set duplicate to knowledge_record(database and "original" and "episodic" and "sample" and "experience" and "Sample mass was 73 grams" and "source-account" and "original:user" and digest and "" and "" and "")
    set revised to web_submit_owned(database and "owner" and "revised" and "" and "Correction: the sample weighs 31 grams, not 73 grams.")
    set correction to archive_read_event(database and "revised:user")
    set recorded to knowledge_record(database and "revised" and "semantic" and "sample" and "mass" and "31 grams" and "source-account" and "revised:user" and archive_list_text(correction and 6) and "" and "" and identity)
    if string_index_of(recorded and "recorded:") is not equal to 0:
        display recorded
        return 6
    set next to web_submit_owned(database and "owner" and "next" and "" and "What is the mass?")
    set claims to memory_recall_claims(database and "next")
    if string_contains(claims and "73 grams") > 0 or else string_contains(claims and "31 grams") equals 0:
        display claims
        return 7
    set relearned to knowledge_record(database and "next" and "semantic" and "sample" and "relearned-mass" and "73 grams" and "source-account" and "original:user" and digest and "" and "" and "")
    if string_index_of(relearned and "corrected-source:") is not equal to 0:
        return 14
    set wrapped to memory_correction_wrap(database and "next" and "original:user" and "{}")
    if string_contains(wrapped and "corrected-history") equals 0 or else string_contains(wrapped and "31 grams") equals 0:
        display wrapped
        return 8
    set foreign to web_submit_owned(database and "outsider" and "foreign" and "" and "Hello")
    if not (memory_corrections(database and "foreign" and "original:user") equals "[]"):
        return 9
    set reread to archive_read_event(database and "original:user")
    if not (archive_list_text(reread and 3) equals "The sample weighs 73 grams." and archive_list_text(reread and 6) equals digest):
        return 10
    if memory_correction_record(database and "foreign" and "original:user" and "revised:user") equals 0:
        return 11
    if memory_correction_record(database and "next" and "original:user" and "revised:user") is not equal to 0:
        return 12
    if archive_verify(database and archive_list_text(source and 0)) is not equal to 0 or else archive_verify(database and archive_list_text(correction and 0)) is not equal to 0:
        return 13
    set latest to web_submit_owned(database and "owner" and "latest" and "" and "Final correction: the sample weighs 42 grams.")
    set latest_source to archive_read_event(database and "latest:user")
    set prior_identity to substring(recorded and 9 and string_length(recorded) - 9)
    set final_claim to knowledge_record(database and "latest" and "semantic" and "sample" and "mass" and "42 grams" and "source-account" and "latest:user" and archive_list_text(latest_source and 6) and "" and "" and prior_identity)
    if string_index_of(final_claim and "recorded:") is not equal to 0:
        return 15
    set chain to memory_corrections(database and "next" and "original:user")
    if string_contains(chain and "42 grams") equals 0:
        return 16
    display "PASS: supersession excludes duplicate derivatives; original bytes/digest unchanged; historical reads carry correction; foreign scope denied; explicit correction link verifies."
    return sql_close(database)
