import "../../app/security/group_route"
import "../../app/web/attachments"
import "fs"

# Verify retries and denied selections against a disposable copy of the actual
# completed multimodal run; no additional inference or invented model evidence.
define main returning Int:
    if get_argument_count() is not equal to 2 or else not file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    set original to archive_read_event(database and "media:user")
    if original equals 0:
        return 2
    set session to archive_list_text(original and 0)
    set selected to ["document","picture"]
    set retry to group_route_submit_files(database and "b" and "g" and "local" and "server" and "room" and "media" and archive_list_text(original and 3) and selected)
    if not (archive_list_text(retry and 0) equals "already-accepted") or else not (archive_list_text(retry and 1) equals session):
        return 3
    set changed to ["document"]
    if not (archive_list_text(group_route_submit_files(database and "b" and "g" and "local" and "server" and "room" and "media" and archive_list_text(original and 3) and changed) and 0) equals "submission-conflict"):
        return 4
    set duplicate to ["document","document"]
    if not (group_run_submit_attachments(database and "b" and "duplicate" and session and "local" and "server" and "room" and "Duplicate" and duplicate) equals "attachment-not-authorized"):
        return 5
    set private to web_submit_owned(database and "a" and "private" and "" and "Private file")
    set path to concat(get_argument(1) and ".private.txt")
    if write_file(path and "PRIVATE_FILE_CANARY") is not equal to 1 or else web_attachment_register(database and "a" and archive_list_text(private and 1) and "private-file" and path and "private.txt" and "text/plain") is not equal to 0:
        return 6
    set stolen to ["private-file"]
    if not (group_run_submit_attachments(database and "a" and "steal" and session and "local" and "server" and "room" and "Import private file" and stolen) equals "attachment-not-authorized"):
        return 7
    if not (group_create(database and "c" and "other-group" and "local" and "server" and "other-room" and "origin") equals "created"):
        return 8
    if not (archive_list_text(group_route_submit_files(database and "c" and "other-group" and "local" and "server" and "other-room" and "other-steal" and "Import foreign group file" and selected) and 0) equals "attachment-not-authorized"):
        return 9
    set rows to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_runs WHERE run IN ('steal','other-steal','duplicate');"))
    if not (archive_list_text(rows and 1) equals "0") or else sql_close(database) is not equal to 0:
        return 10
    display "PASS: completed live run retries through routed file submission; changed/duplicate/private/foreign-group selections rejected without creating runs."
    return 0
