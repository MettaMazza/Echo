import "../../app/security/tool_policy"
import "../../app/web/run_store"
import "../../app/feedback"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0 or else not (tool_authority_schema(database) equals "applied"):
        return 3
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Host access requested by an ordinary user.")
    set run to archive_list_text(submitted and 2)
    if run_authority_allows(database and run and "user") is not equal to 1 or else run_authority_allows(database and run and "admin") is not equal to 0:
        return 4
    set denied to tool_policy_denial(database and run and "host_execute")
    set enriched to feedback_enrich(denied and "host_execute" and "fixture")
    set tokens to provider_json_tokens(enriched)
    if not (provider_value(tokens and provider_member(tokens and 0 and "cause")) equals "requester-role-required") or else not (provider_value(tokens and provider_member(tokens and 0 and "required_role")) equals "admin") or else not (provider_value(tokens and provider_member(tokens and 0 and "requester_role")) equals "user") or else not (provider_value(tokens and provider_member(tokens and 0 and "effects")) equals "none") or else not (provider_value(tokens and provider_member(tokens and 0 and "system_failure")) equals "false"):
        return 5
    set feedback to provider_member(tokens and 0 and "feedback")
    if string_index_of(provider_value(tokens and provider_member(tokens and feedback and "message")) and "not an admin") < 0:
        return 6
    set unknown to provider_json_tokens(tool_policy_denial(database and run and "missing_tool"))
    if not (provider_value(unknown and provider_member(unknown and 0 and "status")) equals "tool-unavailable"):
        return 7
    display "PASS: ordinary requester admin denial survives feedback enrichment; no effects; unknown tool stays distinct."
    return 0
