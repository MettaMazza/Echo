import "../../app/rights/observer_audit"

# Disposable copy of the passed live model inspection/review archive only.
define main returning Int:
    if get_argument_count() is not equal to 2 or else string_contains(get_argument(1) and "observer-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set input to protected_observer_input(database and "rights-live" and "live-proposal")
    set tokens to provider_json_tokens(input)
    if tokens equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "review_revision")) equals "1"):
        return 2
    if string_length(protected_observer_input(database and "foreign-run" and "live-proposal")) is not equal to 0 or else string_length(protected_observer_input(database and "rights-live" and "missing")) is not equal to 0:
        return 3
    set policy to "Fixture audit policy: return explicit JSON verdict and reason."
    set body to provider_json_tokens(protected_observer_body("fixture-model" and policy and input))
    set messages to provider_items(body and provider_member(body and 0 and "messages"))
    if length_list(messages) is not equal to 2 or else provider_member(body and 0 and "tools") >= 0 or else provider_member(body and 0 and "max_tokens") >= 0:
        return 4
    if not (provider_value(body and provider_member(body and get_list(messages and 0) and "content")) equals policy) or else not (provider_value(body and provider_member(body and get_list(messages and 1) and "content")) equals input):
        return 5
    if not (protected_observer_generate(database and "rights-live" and "live-proposal" and "invalid-policy-attempt" and policy and ep_sha256("different") and "{}" and 0 and -1 and 65536) equals "invalid-policy"):
        return 6
    if archive_read_event(database and "invalid-policy-attempt") is not equal to 0:
        return 7
    if sql_close(database) is not equal to 0:
        return 8
    display "PASS: actual live review input binding, foreign/missing scope denial, exact policy and evidence serialization, no tools or output cap, invalid policy rejected before dispatch. Inference not exercised."
    return 0
