import "../../app/web/run_store"
import "../../app/security/tool_authority"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (tool_authority_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture-a") is not equal to 0 or else web_device_pair(database and "fixture-a" and "a" and "HTTP fixture A" and "fixture-secret-a") is not equal to 0:
        return 3
    if web_pairing_invite(database and "fixture-b") is not equal to 0 or else web_device_pair(database and "fixture-b" and "b" and "HTTP fixture B" and "fixture-secret-b") is not equal to 0:
        return 4
    return sql_close(database)
