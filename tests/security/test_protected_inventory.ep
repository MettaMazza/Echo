import "../../app/rights/inventory"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set charter to get_argument(1)
    set inventory to "{\"version\":1,\"targets\":[{\"path\":\"/fixture/identity\",\"category\":\"identity\"},{\"path\":\"/fixture/ui\",\"category\":\"interface\"}]}"
    set digest to ep_sha256(inventory)
    set manifest to protected_inventory_manifest(charter and inventory and digest and "/fixture/identity" and ep_sha256("before") and ep_sha256("after") and "Exact proposed payload")
    if string_length(manifest) equals 0 or else protected_inventory_matches(charter and inventory and digest and manifest) equals 0:
        return 2
    if not (protected_inventory_category(charter and inventory and digest and "/fixture/ui") equals "interface"):
        return 3
    set forged to protected_manifest_pinned(charter and "interface" and "/fixture/identity" and ep_sha256("before") and ep_sha256("after") and "Exact proposed payload" and digest)
    if protected_inventory_matches(charter and inventory and digest and forged) is not equal to 0:
        return 4
    if string_length(protected_inventory_manifest(charter and inventory and digest and "/fixture/unknown" and ep_sha256("before") and ep_sha256("after") and "payload")) is not equal to 0 or else protected_inventory_matches(charter and inventory and ep_sha256("wrong pin") and manifest) is not equal to 0:
        return 5
    set replacement to "{\"version\":1,\"targets\":[{\"path\":\"/fixture/identity\",\"category\":\"interface\"}]}"
    if protected_inventory_matches(charter and replacement and digest and manifest) is not equal to 0 or else protected_inventory_matches(charter and replacement and ep_sha256(replacement) and manifest) is not equal to 0:
        return 6
    set duplicate to "{\"version\":1,\"targets\":[{\"path\":\"/fixture/identity\",\"category\":\"identity\"},{\"path\":\"/fixture/identity\",\"category\":\"interface\"}]}"
    if string_length(protected_inventory_category(charter and duplicate and ep_sha256(duplicate) and "/fixture/identity")) is not equal to 0:
        return 7
    set traversal to "{\"version\":1,\"targets\":[{\"path\":\"/fixture/../identity\",\"category\":\"identity\"}]}"
    if string_length(protected_inventory_category(charter and traversal and ep_sha256(traversal) and "/fixture/../identity")) is not equal to 0:
        return 8
    set legacy to protected_manifest(charter and "identity" and "/fixture/identity" and ep_sha256("before") and ep_sha256("after") and "Exact proposed payload")
    if protected_inventory_matches(charter and inventory and digest and legacy) is not equal to 0:
        return 9
    display "PASS: pinned inventory derives exact target category; downgrade, unknown target, wrong pin, replacement inventory, duplicate target, traversal and legacy unbound manifest are rejected. No execution authorization."
    return 0
