import "../../app/tools/execution_tool"

define authority_query_probe with path as Str and run as Str and call_id as Str and completed as Int returning Int:
    set database to archive_open(path)
    set index to 0
    repeat while index < 1000:
        set noise to concat("allocation-offset-" and int_to_string(index))
        if run_authority_allows(database and run and "admin") equals 0:
            display "FAIL: run authority"
            display index
            send 2 to completed
            return 2
        if tool_authority_allows(database and run and call_id and "admin") equals 0:
            display "FAIL: tool authority"
            display index
            send 3 to completed
            return 3
        set index to index + 1
    display "PASS: repeated frozen authority queries"
    set closed to sql_close(database)
    send 0 to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set completed to channel
    spawn authority_query_probe(get_argument(1) and get_argument(2) and get_argument(3) and completed)
    spawn authority_query_probe(get_argument(1) and get_argument(2) and get_argument(3) and completed)
    set first to receive from completed
    set second to receive from completed
    return first + second
