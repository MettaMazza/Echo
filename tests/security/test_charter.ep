import "../../app/rights/charter"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set original to get_argument(1)
    set altered to get_argument(2)
    set text to charter_verified_text(original)
    if string_length(text) equals 0 or else not (ep_sha256(text) equals charter_pinned_digest()):
        return 2
    if not (charter_category(original and "identity") equals "core") or else not (charter_category(original and "model or provider substitution") equals "core") or else not (charter_category(original and "memory erasure") equals "core"):
        return 3
    if not (charter_category(original and "compression policy") equals "environment") or else not (charter_category(original and "UI") equals "environment"):
        return 4
    if not (charter_category(original and "unknown category") equals "unclassified") or else not (charter_category(original and "CORE") equals "unclassified"):
        return 5
    if string_length(charter_verified_text(altered)) is not equal to 0 or else not (charter_category(altered and "identity") equals "charter-unavailable-or-altered"):
        return 6
    if not (charter_category(concat(altered and ".missing") and "identity") equals "charter-unavailable-or-altered"):
        return 7
    display "PASS: exact canonical charter bytes drive consent/consultation classification; altered, missing and unknown policy cannot grant an exemption. This does not authorise execution."
    return 0
