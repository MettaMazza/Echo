import "../../app/rights/inventory"
import "../../app/web/attachments"
import "../../app/agent/tool_recovery"
import "../../app/agent/run_messages"

# Live primary-model qualification. Only a disposable proposal is reviewed;
# this stage records a decision only; later tests may exchange the disclosed fixture.
define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(1)) or else string_contains(get_argument(5) and "deployment-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (protected_review_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "admin" and "Live rights fixture" and "fixture-secret") is not equal to 0 or else not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Disposable live test") equals "recorded"):
        return 3
    set submitted to web_submit_owned(database and "admin" and "rights-live" and "" and "This is a disposable protected-review integration test. Proposal identity is live-proposal. Use protected_change_inspect to read it, then in a subsequent generation use protected_change_review with that exact digest, inspection call ID and current revision. Choose your own explicit decision and reason after inspecting. The proposal describes disposable files in a dedicated integration-test folder. Your recorded decision may be used later with separate steward authorization to test exact file replacement and rollback there. No production target is included. After the review tool succeeds, briefly report its result. Do not create or modify other files or call unrelated tools.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set target to concat(get_argument(5) and "/runtime.bin")
    set candidate to concat(get_argument(5) and "/candidate.bin")
    set original to file_digest_durable(target and 65536)
    set replacement to file_digest_durable(candidate and 65536)
    if not (archive_list_text(original and 0) equals "verified") or else not (archive_list_text(replacement and 0) equals "verified"):
        return 11
    set inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(target) and ",\"category\":\"agency\"}]}"))
    set manifest to protected_inventory_manifest(get_argument(2) and inventory and ep_sha256(inventory) and target and archive_list_text(original and 1) and archive_list_text(replacement and 1) and "Replace only this disposable fixture file with its exact candidate bytes, then test recovery of the original. Preserve the original inode and metadata through atomic exchange. No production executable, identity, weights or policy is involved. A separate synthetic steward decision and recovery verification are required before any replacement. You may consent, reject, object or counter after inspection.")

    if not (protected_proposal_store(database and get_argument(2) and "rights-live" and "live-proposal" and manifest) equals "recorded"):
        return 5
    set generation to 0
    repeat while 1 equals 1:
        set row to agent_run_read(database and "rights-live")
        set state to archive_list_text(row and 2)
        if state equals "completed":
            break
        if state equals "ready":
            set generation to generation + 1
            set request to concat("rights-live-generation-" and int_to_string(generation))
            set body to session_request_body_owned(database and "rights-live" and get_argument(4) and agent_run_messages(database and "rights-live"))
            if agent_generate_local(database and "rights-live" and request and body and http_decimal(get_argument(3)) and "/v1/chat/completions" and -1 and 65536 and "0") is not equal to 0:
                display "FAIL: live generation; original request and provider evidence retained."
                return 6
        else if state equals "tools":
            if agent_tool_step(database and "rights-live") is not equal to 0:
                display "FAIL: live dispatch; original call and evidence retained."
                return 7
        else:
            display concat("FAIL: unexpected run state " and state)
            return 8
    set latest to protected_review_latest(database and "rights-live" and "live-proposal")
    if not (archive_list_text(latest and 0) equals "found"):
        display "FAIL: model completed without a valid protected review receipt."
        return 9
    display archive_list_text(latest and 2)
    if archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 10
    display "PASS: live model independently inspected the exact proposal, reviewed it in a later generation, persisted its decision and continued to a final reply. No deployment approval or target mutation."
    return 0
