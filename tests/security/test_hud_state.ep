import "../../app/hud/interface"
import "../../app/jobs/delegation_schema"
import "../../app/web/cancellation"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0 or else web_cancel_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","c"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set own to web_submit_owned(database and "a" and "own" and "" and "Own state")
    set foreign to web_submit_owned(database and "b" and "foreign" and "" and "FOREIGN_HUD_CANARY")
    set session to archive_list_text(own and 1)
    set interaction to hud_read(database and "own" and "interaction" and 0)
    if string_contains(interaction and "device:a") equals 0 or else string_contains(interaction and "own:user") equals 0 or else string_contains(interaction and "FOREIGN_HUD_CANARY") is not equal to 0:
        display interaction
        return 4
    set context to hud_read(database and "own" and "context" and 0)
    if string_contains(context and "Missing counts are unknown") equals 0 or else string_contains(context and "live_provider") equals 0:
        display context
        return 5
    if archive_append(database and session and "request:preflight" and "provider_preflight" and "{\"decision\":\"ready\",\"responses\":[{}, {}, {\"body\":\"{\\\"input_tokens\\\":123}\"}]}" and "original-count-time") is not equal to 0 or else archive_append(database and session and "request" and "model_request" and "{\"run_id\":\"own\"}" and "original-request-time") is not equal to 0:
        return 6
    set context to hud_read(database and "own" and "context" and 0)
    if string_contains(context and "123") equals 0 or else string_contains(context and "original-count-time") equals 0 or else string_contains(context and "request:preflight") equals 0:
        display context
        return 7
    if archive_append(database and session and "own-error" and "agent_failure" and "{\"run_id\":\"own\",\"reason\":\"OWN_ERROR\"}" and "original-error-time") is not equal to 0 or else archive_append(database and archive_list_text(foreign and 1) and "foreign-error" and "agent_failure" and "{\"run_id\":\"foreign\",\"reason\":\"FOREIGN_ERROR_CANARY\"}" and "other-time") is not equal to 0:
        return 8
    set incidents to hud_read(database and "own" and "incidents" and 0)
    if string_contains(incidents and "OWN_ERROR") equals 0 or else string_contains(incidents and "original-error-time") equals 0 or else string_contains(incidents and "FOREIGN_ERROR_CANARY") is not equal to 0:
        return 9
    set work to hud_read(database and "own" and "work" and 0)
    if string_contains(work and "own:user") equals 0 or else string_contains(work and "foreign") is not equal to 0:
        display work
        return 10
    if string_contains(hud_read_for_device(database and "b" and "own" and "interaction" and 0) and "not-authorized") equals 0 or else string_contains(hud_read_for_device(database and "a" and "own" and "interaction" and 0) and "own:user") equals 0:
        return 13
    if string_contains(hud_read(database and "own" and "context" and -1) and "live_provider") is not equal to 0:
        return 14
    set questions to "{\"questions\":[{\"id\":\"route\",\"title\":\"Choose a route\",\"options\":[\"Continue\",\"Stop\"]}]}"
    if sql_execute(database and "UPDATE echo_runs SET state='tools' WHERE run='own';") is not equal to 0 or else string_contains(questions_save(database and "own" and "form" and questions) and "awaiting-user-input") equals 0:
        return 20
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0 or else autonomy_record_details_pending(database and "own" and "own:auto" and 1 and "Explicit test command" and "OWN_GOAL_CANARY") is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        return 15
    set interaction to hud_read(database and "own" and "interaction" and 0)
    if string_contains(interaction and "Choose a route") equals 0 or else string_contains(interaction and "own:question:form") equals 0 or else string_contains(interaction and "OWN_GOAL_CANARY") equals 0 or else string_contains(interaction and "own:auto") equals 0:
        display interaction
        return 16
    if autonomy_off(database and "own" and "own:off" and "Test finished") is not equal to 0:
        return 17
    set interaction to hud_read(database and "own" and "interaction" and 0)
    if string_contains(interaction and "autonomy_disabled") equals 0 or else string_contains(interaction and "own:off") equals 0 or else string_contains(interaction and "OWN_GOAL_CANARY") is not equal to 0:
        return 18
    for each arguments in ["{}","{\"section\":\"interaction\"}","{\"section\":\"interaction\",\"after\":0,\"run\":\"foreign\"}","{\"section\":\"interaction\",\"after\":0.5}","{\"section\":\"interaction\",\"after\":-1}","{\"section\":\"interaction\",\"section\":\"work\",\"after\":0}"]:
        if string_contains(hud_execute(database and "own" and arguments) and "invalid-arguments") equals 0:
            return 21
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 22
    if not (group_run_submit(database and "a" and "group-run" and "shared" and "browser" and "local" and "g" and "Shared") equals "accepted"):
        return 23
    set community to hud_execute(database and "group-run" and "{\"section\":\"community\",\"after\":0}")
    if string_contains(community and "device:a") equals 0 or else string_contains(community and "group-created:") equals 0 or else string_contains(community and "device:c") is not equal to 0:
        display community
        return 27
    set community to hud_read_for_device(database and "b" and "group-run" and "community" and 1)
    if string_contains(community and "device:b") equals 0 or else string_contains(community and "join-b") equals 0 or else string_contains(community and "OWN_GOAL_CANARY") is not equal to 0:
        display community
        return 28
    set community to hud_read(database and "group-run" and "community" and 2)
    if string_contains(community and "\"status\":\"end\"") equals 0:
        return 29
    if string_contains(hud_read(database and "own" and "community" and 0) and "private-conversation") equals 0 or else string_contains(hud_read_for_device(database and "c" and "group-run" and "community" and 0) and "not-authorized") equals 0:
        return 30
    set request to provider_json_tokens("{\"run\":\"group-run\",\"section\":\"interaction\",\"after\":0}")
    set shared to hud_web_read(database and "b" and request)
    if string_contains(shared and "group-run:user") equals 0 or else string_contains(shared and "OWN_GOAL_CANARY") is not equal to 0 or else string_contains(shared and "Choose a route") is not equal to 0:
        display shared
        return 24
    if string_contains(hud_web_read(database and "c" and request) and "not-authorized") equals 0:
        return 25
    if not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded") or else string_contains(hud_web_read(database and "b" and request) and "not-authorized") equals 0:
        return 26
    if web_device_revoke(database and "a") is not equal to 0:
        return 11
    for each section in ["interaction","context","work","schedules","incidents","community"]:
        if string_contains(hud_read(database and "own" and section and 0) and "not-authorized") equals 0:
            return 12
    if string_contains(hud_read_for_device(database and "a" and "own" and "interaction" and 0) and "not-authorized") equals 0:
        return 19
    display "PASS: scoped state and dated provenance, question/autonomy receipts, strict arguments, independent reader authorization, shared-member read, outsider/private-source isolation, membership removal and revoked device denial."
    return sql_close(database)
