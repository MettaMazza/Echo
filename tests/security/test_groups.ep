import "../../app/security/groups"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set text to ptr_to_str(name)
        if web_pairing_invite(database and text) is not equal to 0 or else web_device_pair(database and text and text and text and concat(text and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture creator") equals "recorded") or else not (principal_host_role(database and "admin-c" and "device:c" and "admin" and "Fixture outsider") equals "recorded"):
        return 4
    set private to web_submit_owned(database and "a" and "private-run" and "" and "Private history must not enter the group.")
    if not (archive_list_text(private and 0) equals "accepted"):
        return 5
    if not (group_create(database and "a" and "g" and "discord" and "server-1" and "channel-1" and "origin-1") equals "created") or else not (group_create(database and "a" and "g" and "discord" and "server-1" and "channel-1" and "origin-1") equals "already-created"):
        return 6
    if group_audience_allows(database and "a" and "g" and "discord" and "server-1" and "channel-1" and 1 and 1) is not equal to 1 or else group_audience_allows(database and "c" and "g" and "discord" and "server-1" and "channel-1" and 1 and 1) is not equal to 0:
        return 7
    if not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 2 and 1) is not equal to 0:
        return 8
    if not (group_change(database and "a" and "force-b" and "g" and "device:b" and "joined" and 2) equals "membership-not-authorized"):
        return 9
    if not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "already-recorded"):
        return 10
    if group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 3 and 1) is not equal to 1 or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 1 and 0) is not equal to 0:
        return 11
    if web_device_session_allowed(database and "b" and archive_list_text(private and 1)) is not equal to 0 or else not (principal_role(database and "device:b") equals "user"):
        return 12
    if group_audience_allows(database and "b" and "g" and "discord" and "server-2" and "channel-1" and 3 and 1) is not equal to 0 or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-2" and 3 and 1) is not equal to 0 or else group_audience_allows(database and "b" and "g" and "local" and "server-1" and "channel-1" and 3 and 1) is not equal to 0:
        return 13
    if not (group_change(database and "c" and "outsider-remove" and "g" and "device:b" and "removed" and 3) equals "membership-not-authorized") or else not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded"):
        return 14
    if group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 3 and 0) is not equal to 0 or else not (group_change(database and "b" and "self-restore" and "g" and "device:b" and "joined" and 4) equals "membership-not-authorized"):
        return 15
    if not (group_change(database and "a" and "reinvite-b" and "g" and "device:b" and "invited" and 4) equals "recorded") or else not (group_change(database and "b" and "rejoin-b" and "g" and "device:b" and "joined" and 5) equals "recorded"):
        return 16
    if group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 3 and 1) is not equal to 0 or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 6 and 1) is not equal to 1:
        return 17
    if not (group_change(database and "a" and "stale-change" and "g" and "device:c" and "invited" and 3) equals "membership-revision-conflict") or else not (group_create(database and "a" and "g" and "discord" and "server-2" and "channel-1" and "origin-1") equals "group-identity-conflict"):
        return 18
    if not (group_create(database and "a" and "duplicate-origin" and "discord" and "server-1" and "channel-1" and "origin-1") equals "group-origin-conflict"):
        return 27
    if sql_execute(database and "UPDATE echo_group_membership SET state='joined' WHERE identity='remove-b';") equals 0 or else sql_execute(database and "DELETE FROM echo_group_audiences;") equals 0:
        return 19
    if sql_close(database) is not equal to 0:
        return 20
    set database to archive_open(get_argument(1))
    if not (group_schema(database) equals "already-applied") or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 6 and 1) is not equal to 1:
        return 21
    if not (principal_host_revocation(database and "revoke-b" and "device:b" and 1 and "Fixture revocation") equals "recorded") or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 6 and 1) is not equal to 0:
        return 24
    if not (group_change(database and "a" and "remove-revoked" and "g" and "device:b" and "removed" and 6) equals "recorded") or else not (principal_host_revocation(database and "restore-b" and "device:b" and 0 and "Fixture restore") equals "recorded") or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 6 and 0) is not equal to 0:
        return 25
    if not (group_change(database and "a" and "third-invite" and "g" and "device:b" and "invited" and 7) equals "recorded") or else not (group_change(database and "b" and "third-join" and "g" and "device:b" and "joined" and 8) equals "recorded"):
        return 26
    if web_device_revoke(database and "b") is not equal to 0 or else group_audience_allows(database and "b" and "g" and "discord" and "server-1" and "channel-1" and 9 and 1) is not equal to 0:
        return 22
    if sql_close(database) is not equal to 0:
        return 23
    display "PASS: explicit invitation/acceptance, immutable audiences, exact namespace, creator removal, revocation/rejoin epochs, stale-change rejection and restart; no private-session access or borrowed admin role. Group chat routing is not exercised."
    return 0
