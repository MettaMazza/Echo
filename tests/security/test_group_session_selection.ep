import "../../app/security/group_session_selection"
import "../../app/web/run_store"
import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set original to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "old-run" and "OLD_CONVERSATION_CANARY")
    if not (archive_list_text(original and 0) equals "accepted"):
        return 5
    if not (group_session_selection_schema(database) equals "applied") or else not (group_session_selection_schema(database) equals "already-applied"):
        return 6
    set route to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(route and 1) equals archive_list_text(original and 1)):
        return 7
    set revision to string_to_int(archive_list_text(route and 2))
    set first to group_session_restart(database and "a" and "interaction:first" and "g" and "discord" and "server" and "room" and revision)
    if not (archive_list_text(first and 0) equals "created") or else archive_list_text(first and 1) equals archive_list_text(original and 1):
        return 8
    set next to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "next-run" and "NEW_CONVERSATION_MARKER")
    if not (archive_list_text(next and 0) equals "accepted") or else not (archive_list_text(next and 1) equals archive_list_text(first and 1)):
        return 9
    set context to session_messages(database and archive_list_text(next and 1) and "next-run")
    if string_index_of(context and "OLD_CONVERSATION_CANARY") >= 0 or else string_index_of(context and "NEW_CONVERSATION_MARKER") < 0:
        return 10
    set retry to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "old-run" and "OLD_CONVERSATION_CANARY")
    if not (archive_list_text(retry and 0) equals "already-accepted") or else not (archive_list_text(retry and 1) equals archive_list_text(original and 1)):
        return 11
    set second to group_session_restart(database and "a" and "interaction:second" and "g" and "discord" and "server" and "room" and revision)
    set replay to group_session_restart(database and "a" and "interaction:first" and "g" and "discord" and "server" and "room" and revision)
    if not (archive_list_text(second and 0) equals "created") or else not (archive_list_text(replay and 0) equals "already-created") or else not (archive_list_text(replay and 1) equals archive_list_text(first and 1)):
        return 12
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set reopened to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(reopened and 1) equals archive_list_text(second and 1)):
        return 13
    if not (archive_list_text(group_session_restart(database and "b" and "foreign" and "g" and "discord" and "server" and "room" and revision) and 0) equals "audience-not-authorized") or else not (archive_list_text(group_session_restart(database and "a" and "wrong-room" and "g" and "discord" and "server" and "other" and revision) and 0) equals "audience-not-authorized") or else not (archive_list_text(group_session_restart(database and "a" and "stale" and "g" and "discord" and "server" and "room" and revision + 1) and 0) equals "audience-not-authorized"):
        return 14
    set counts to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_group_session_choices),(SELECT COUNT(*) FROM echo_group_sessions),(SELECT COUNT(*) FROM echo_group_run_origins),(SELECT COUNT(*) FROM pragma_foreign_key_check);"))
    if not (archive_list_text(counts and 1) equals "2") or else not (archive_list_text(counts and 2) equals "3") or else not (archive_list_text(counts and 3) equals "2") or else not (archive_list_text(counts and 4) equals "0"):
        return 15
    set retained to history_next(database and archive_list_text(original and 1) and 0 and 9223372036854775807 and "OLD_CONVERSATION_CANARY")
    if not (archive_list_text(retained and 0) equals "found"):
        return 16
    # A second writer cannot acknowledge a change that never committed.
    set contender to sql_open(get_argument(1))
    if contender equals 0 or else sql_execute(contender and "PRAGMA busy_timeout=0;") is not equal to 0 or else sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 17
    set locked to group_session_restart(contender and "a" and "contended" and "g" and "discord" and "server" and "room" and revision)
    if not (archive_list_text(locked and 0) equals "writer-lock-unavailable") or else sql_execute(database and "ROLLBACK;") is not equal to 0:
        return 18
    set closed to sql_close(contender)
    set reopened to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(reopened and 1) equals archive_list_text(second and 1)):
        return 19
    set resumed to group_session_resume(database and "a" and "resume:original" and "g" and "discord" and "server" and "room" and revision and archive_list_text(original and 1))
    set selected to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (resumed equals "session-selected") or else not (archive_list_text(selected and 1) equals archive_list_text(original and 1)):
        return 20
    if not (group_session_resume(database and "b" and "resume:foreign" and "g" and "discord" and "server" and "room" and revision and archive_list_text(original and 1)) equals "audience-not-authorized"):
        return 21
    if not (group_session_resume(database and "a" and "resume:missing" and "g" and "discord" and "server" and "room" and revision and "not-this-audience") equals "session-not-authorized"):
        return 22
    if not (group_session_resume(database and "a" and "resume:original" and "g" and "discord" and "server" and "room" and revision and archive_list_text(first and 1)) equals "selection-identity-conflict"):
        return 23
    set third to group_session_restart(database and "a" and "interaction:third" and "g" and "discord" and "server" and "room" and revision)
    set resumed to group_session_resume(database and "a" and "resume:original" and "g" and "discord" and "server" and "room" and revision and archive_list_text(original and 1))
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set selected to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(third and 0) equals "created") or else not (resumed equals "session-selected") or else not (archive_list_text(selected and 1) equals archive_list_text(third and 1)):
        return 24
    set listed to group_session_history(database and "a" and "g" and "discord" and "server" and "room" and revision and "")
    if not (archive_list_text(listed and 0) equals "found") or else string_index_of(archive_list_text(listed and 1) and archive_list_text(original and 1)) < 0:
        return 25
    set denied to group_session_history(database and "b" and "g" and "discord" and "server" and "room" and revision and "")
    if not (archive_list_text(denied and 0) equals "audience-not-authorized"):
        return 26
    set found to group_session_search(database and "a" and "g" and "discord" and "server" and "room" and revision and "old_conversation")
    if not (archive_list_text(found and 0) equals "found") or else string_index_of(archive_list_text(found and 1) and archive_list_text(original and 1)) < 0 or else string_index_of(archive_list_text(found and 1) and archive_list_text(first and 1)) >= 0:
        return 27
    if not (archive_list_text(group_session_search(database and "b" and "g" and "discord" and "server" and "room" and revision and "OLD") and 0) equals "audience-not-authorized") or else not (archive_list_text(group_session_search(database and "a" and "g" and "discord" and "server" and "other" and revision and "OLD") and 0) equals "audience-not-authorized"):
        return 28
    set literal to group_session_search(database and "a" and "g" and "discord" and "server" and "room" and revision and "%'")
    if not (archive_list_text(literal and 1) equals "[]"):
        return 29
    if not (archive_list_text(group_session_search(database and "a" and "g" and "discord" and "server" and "room" and revision and "   ") and 0) equals "invalid-command-options"):
        return 30
    if archive_append(database and archive_list_text(original and 1) and "search-reply" and "assistant_final" and "{\"content\":\"SPOKEN_ANSWER\",\"metadata\":\"HIDDEN_METADATA\"}" and "fixture") is not equal to 0 or else archive_append(database and archive_list_text(original and 1) and "search-trace" and "tool_result" and "TOOL_SECRET" and "fixture") is not equal to 0:
        return 31
    for each word in ["HIDDEN_METADATA","TOOL_SECRET","' OR 1=1 --"]:
        set result to group_session_search(database and "a" and "g" and "discord" and "server" and "room" and revision and ptr_to_str(word))
        if not (archive_list_text(result and 0) equals "found") or else not (archive_list_text(result and 1) equals "[]"):
            return 32
    set answer to group_session_search(database and "a" and "g" and "discord" and "server" and "room" and revision and "spoken_answer")
    if string_index_of(archive_list_text(answer and 1) and archive_list_text(original and 1)) < 0:
        return 33
    display "PASS: search excludes trace and metadata, searches actual final content, rejects SQL injection text"
    display "PASS: resume existing audience, foreign target denial, operation collision, replay does not override newer choice, restart persistence"
    display "PASS: legacy migration, retained original history, fresh context, original run retry, command replay without resetting newer selection, reopen, foreign actor/room/revision denial, writer contention and foreign-key integrity"
    return 0
