import "../../app/web/attachments"
import "../../app/memory/automatic"
import "../../app/context/session_messages"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    if web_pairing_invite(database and "foreign") is not equal to 0 or else web_device_pair(database and "foreign" and "outsider" and "Foreign" and "other-secret") is not equal to 0:
        return 4
    set original to web_submit_owned(database and "owner" and "original" and "" and "I am Maria. Mirroring is not a defect. Read the existing file before editing it.")
    set foreign to web_submit_owned(database and "outsider" and "foreign" and "" and "private-canary-must-stay-private")
    set current to web_submit_owned(database and "owner" and "current" and "" and "Remember me?")
    set sources to memory_pending(database and "current")
    if sources equals 0 or else length_list(sources) is not equal to 1:
        return 5
    set pending_context to memory_context(database and "current")
    if string_contains(pending_context and "Read the existing file before editing it.") equals 0 or else string_contains(pending_context and "private-canary") equals 1:
        return 24
    if memory_context_capture(database and "current") is not equal to 0:
        return 40
    set frozen to memory_context_stable(database and "current")
    set extraction_body to memory_extract_body(database and "fixture-model" and sources and 0 and 1)
    set request_fields to provider_json_tokens(extraction_body)
    if provider_member(request_fields and 0 and "response_format") < 0:
        return 50
    if not (memory_extract_save(database and "current" and sources and 0 and 1 and "I cannot fulfill this request.") equals "memory-invalid-json") or else length_list(memory_pending(database and "current")) is not equal to 1:
        return 51
    set response to "{\"memories\":[{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"fact\",\"quote\":\"I am Maria.\"},{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"correction\",\"quote\":\"Mirroring is not a defect.\"},{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"workflow\",\"quote\":\"Read the existing file before editing it.\"}]}"
    # Model output can name the procedural category as its kind. Grounding
    # must retain the quoted workflow instead of rejecting the entire batch.
    for each alias in ["workflow", "procedural"]:
        set raw to concat("{\"memories\":[{\"source_event\":\"original:user\",\"kind\":" and provider_quote(alias))
        set raw to concat(raw and ",\"category\":\"workflow\",\"quote\":\"Read the existing file before editing it.\"}]}")
        set grounded_alias to memory_ground_extraction(database and "current" and sources and 0 and 1 and raw)
        if not (memory_extract_save(database and "current" and sources and 0 and 1 and grounded_alias) equals "ready"):
            return 18
    if not (memory_extract_save(database and "current" and sources and 0 and 1 and response) equals "ready"):
        return 6
    if not (memory_extract_save(database and "current" and sources and 0 and 1 and response) equals "ready"):
        return 7
    if length_list(memory_pending(database and "current")) is not equal to 0:
        return 8
    if not (memory_context_stable(database and "current") equals frozen):
        return 41
    if memory_context_capture(database and "current") is not equal to 0 or else not (memory_context_stable(database and "current") equals frozen):
        return 42
    if sql_close(database) is not equal to 0:
        return 43
    set database to archive_open(get_argument(1))
    if not (memory_context_stable(database and "current") equals frozen):
        return 44
    set next to web_submit_owned(database and "owner" and "next-turn" and "" and "Next turn")
    if memory_context_capture(database and "next-turn") is not equal to 0 or else string_contains(memory_context_stable(database and "next-turn") and "Awaiting") equals 1:
        return 45
    if memory_context_stable(database and "next-turn") equals frozen:
        return 46
    if string_contains(memory_context_stable(database and "next-turn") and "Source \"original:user\" digest") > 0:
        return 52
    if string_contains(memory_context_stable(database and "next-turn") and "Lossless quotation index") equals 0 or else string_contains(memory_context_stable(database and "next-turn") and "private-canary") > 0:
        return 53
    set refreshed to memory_context_stable(database and "next-turn")
    if not (memory_context_after(database and "next-turn" and refreshed) equals refreshed):
        return 54
    set messages to session_messages(database and archive_list_text(current and 1) and "current")
    if string_contains(messages and "I am Maria.") equals 0 or else string_contains(messages and "Mirroring is not a defect.") equals 0 or else string_contains(messages and "Read the existing file") equals 0 or else string_contains(messages and "private-canary") equals 1:
        return 9
    if string_contains(memory_context(database and "foreign") and "Maria") equals 1:
        return 10
    set before to session_messages(database and archive_list_text(current and 1) and "current")
    set recall_before to memory_context(database and "current")
    if archive_append(database and archive_list_text(current and 1) and "failure-receipt" and "memory_failure" and "{\"run_id\":\"current\",\"status\":\"memory-generation:connect-error\"}" and "fixture") is not equal to 0:
        return 30
    set after to session_messages(database and archive_list_text(current and 1) and "current")
    if not (memory_context(database and "current") equals recall_before):
        return 31
    # The ordinary-turn routing footer follows extraction status. Removing only
    # that status record must leave every original message byte unchanged.
    set comparison to history_collect_one(checkpoint_prepare(database and "SELECT 'same' WHERE (SELECT json_group_array(json(value)) FROM json_each(?1))=(SELECT json_group_array(json(value)) FROM json_each(?2) WHERE instr(COALESCE(json_extract(value,'$.content'),''),'This turn''s automatic extraction did not finish:')=0);" and [before,after]))
    if not (archive_list_text(comparison and 0) equals "found"):
        return 32
    if string_contains(after and "memory-generation:connect-error") equals 0:
        return 33
    display "PASS: memory failure preserves the entire prior prompt prefix and remains visible after history; recall and authority checks preserved."
    set claim to history_collect_one(archive_prepare(database and "SELECT identity FROM echo_memory_claims WHERE predicate='fact' LIMIT 1;"))
    if not (knowledge_visibility_set(database and "current" and "forget-fact" and archive_list_text(claim and 1) and 0 and "forgotten" and "test") equals "recorded"):
        return 47
    if memory_context_capture(database and "current") is not equal to 0 or else string_contains(memory_context_stable(database and "current") and "I am Maria.") equals 1:
        return 48
    set before_compaction to memory_context_revision(database and "current")
    if sql_execute(database and "INSERT INTO echo_checkpoints SELECT 'recall-rebase-fixture',session,event,digest,'','Fixture recap','{}','{}' FROM echo_events WHERE event='original:user'; INSERT INTO echo_active_context SELECT session,identity FROM echo_checkpoints WHERE identity='recall-rebase-fixture';") is not equal to 0:
        return 55
    if memory_context_revision(database and "current") equals before_compaction:
        return 56
    if memory_context_capture(database and "current") is not equal to 0 or else not (memory_context_stable(database and "current") equals memory_context(database and "current")):
        return 57
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='owner';") is not equal to 0 or else string_length(memory_context_stable(database and "current")) > 0:
        return 49
    display "PASS: recall bytes survive extraction and reopen; next turn refreshes; forgetting and revocation invalidate immediately."
    return sql_close(database)
