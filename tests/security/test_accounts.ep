import "../../app/web/run_store"
import "../../app/security/accounts"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    if not (principal_account_schema(database) equals "applied"):
        return 4
    if not (principal_host_account(database and "link-a" and "discord" and "fixture-user" and "device:a" and 0 and "fixture") equals "recorded") or else not (principal_for_account(database and "discord" and "fixture-user") equals "device:a"):
        return 5
    if not (principal_host_account(database and "link-a" and "discord" and "fixture-user" and "device:a" and 0 and "fixture") equals "already-recorded") or else not (principal_host_account(database and "link-a" and "discord" and "other-user" and "device:a" and 0 and "fixture") equals "account-link-identity-conflict"):
        return 6
    if not (principal_host_account(database and "steal" and "discord" and "fixture-user" and "device:b" and 0 and "fixture") equals "account-already-linked"):
        return 7
    if not (principal_host_account(database and "unlink-a" and "discord" and "fixture-user" and "device:a" and 1 and "fixture") equals "recorded") or else not (principal_for_account(database and "discord" and "fixture-user") equals ""):
        return 8
    if sql_execute(database and "CREATE TRIGGER reject_link BEFORE UPDATE ON echo_principal_accounts BEGIN SELECT RAISE(ABORT,'fixture failure'); END;") is not equal to 0:
        return 9
    if not (principal_host_account(database and "link-b" and "discord" and "fixture-user" and "device:b" and 0 and "fixture") equals "account-link-write-failed"):
        return 10
    set receipt to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM echo_account_link_events WHERE identity='link-b';"))
    if not (archive_list_text(receipt and 1) equals "0") or else not (principal_for_account(database and "discord" and "fixture-user") equals ""):
        return 11
    if sql_execute(database and "DROP TRIGGER reject_link;") is not equal to 0 or else not (principal_host_account(database and "link-b" and "discord" and "fixture-user" and "device:b" and 0 and "fixture") equals "recorded"):
        return 12
    if not (principal_host_account(database and "stale-unlink" and "discord" and "fixture-user" and "device:a" and 1 and "fixture") equals "account-binding-changed"):
        return 13
    if not (principal_host_account(database and "link-a" and "discord" and "fixture-user" and "device:a" and 0 and "fixture") equals "already-recorded") or else not (principal_for_account(database and "discord" and "fixture-user") equals "device:b"):
        return 14
    if not (principal_for_account(database and "different-platform" and "fixture-user") equals ""):
        return 15
    if not (principal_host_revocation(database and "revoke-b" and "device:b" and 1 and "fixture") equals "recorded") or else not (principal_for_account(database and "discord" and "fixture-user") equals ""):
        return 16
    if not (principal_host_account(database and "revoked-link" and "discord" and "other-user" and "device:b" and 0 and "fixture") equals "principal-unavailable"):
        return 17
    if not (principal_host_account(database and "unlink-revoked" and "discord" and "fixture-user" and "device:b" and 1 and "fixture") equals "recorded"):
        return 18
    if not (principal_host_revocation(database and "restore-b" and "device:b" and 0 and "fixture") equals "recorded") or else not (principal_for_account(database and "discord" and "fixture-user") equals ""):
        return 19
    if sql_close(database) is not equal to 0:
        return 20
    set database to archive_open(get_argument(1))
    if not (principal_account_schema(database) equals "already-applied") or else not (principal_for_device(database and "a") equals "device:a") or else not (principal_for_device(database and "b") equals "device:b"):
        return 21
    set enrolled to principal_account_enroll(database and "discord" and "new-fixture")
    if string_length(enrolled) equals 0 or else not (principal_role(database and enrolled) equals "user") or else not (principal_account_enroll(database and "discord" and "new-fixture") equals enrolled):
        return 24
    set other to principal_account_enroll(database and "different-platform" and "new-fixture")
    if string_length(other) equals 0 or else other equals enrolled:
        return 25
    if not (principal_host_revocation(database and "revoke-enrolled" and enrolled and 1 and "fixture") equals "recorded") or else not (principal_account_enroll(database and "discord" and "new-fixture") equals ""):
        return 26
    if sql_execute(database and "CREATE TRIGGER reject_enrol BEFORE INSERT ON echo_account_link_events BEGIN SELECT RAISE(ABORT,'fixture receipt failure'); END;") is not equal to 0:
        return 27
    if not (principal_account_enroll(database and "discord" and "failed-enrol") equals ""):
        return 28
    set absent to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM echo_principal_accounts WHERE subject='failed-enrol';"))
    if not (archive_list_text(absent and 1) equals "0") or else sql_execute(database and "DROP TRIGGER reject_enrol;") is not equal to 0:
        return 29
    if string_length(principal_account_enroll(database and "discord" and "failed-enrol")) equals 0:
        return 30
    if sql_execute(database and "DELETE FROM echo_account_link_events;") equals 0:
        return 22
    if sql_close(database) is not equal to 0:
        return 23
    display "PASS: audited account linking, explicit unlink before reassignment, stale replay isolation, rollback, principal revocation and independent unlink survive reopen."
    return 0
