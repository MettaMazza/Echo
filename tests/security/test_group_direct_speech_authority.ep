import "../../app/security/group_speech"
import "../../app/web/message_speech"

define queue_saved_speech with database as Int and session as Str and job as Str returning Int:
    set payload to concat("{\"run_id\":" and provider_quote(job))
    set payload to concat(payload and ",\"call_id\":\"speak\",\"name\":\"speech_synthesize\",\"speech_source\":\"answer\",\"arguments\":\"{\\\"text\\\":\\\"Hello Echo\\\"}\"}")
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_group_speech_jobs(job,session,device,source) VALUES(?1,?2,'owner','answer');" and [job,session]) and 101) is not equal to 0:
        return archive_rollback(database)
    if archive_append_pending(database and session and concat(job and ":request") and "tool_call" and payload and "fixture") is not equal to 0 or else tool_ledger_queue(database and job and "speak" and session and concat(job and ":request")) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        set rolled to archive_rollback(database)
        return 1
    return tool_ledger_claim(database and job and "speak")

define queue_forged_speech with database as Int and session as Str and job as Str returning Int:
    set payload to concat("{\"run_id\":" and provider_quote(job))
    set payload to concat(payload and ",\"call_id\":\"speak\",\"name\":\"speech_synthesize\",\"speech_source\":\"answer\",\"arguments\":\"{\\\"text\\\":\\\"Unrelated fabricated text\\\"}\"}")
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_group_speech_jobs(job,session,device,source) VALUES(?1,?2,'owner','answer');" and [job,session]) and 101) is not equal to 0:
        return archive_rollback(database)
    if archive_append_pending(database and session and concat(job and ":request") and "tool_call" and payload and "fixture") is not equal to 0 or else tool_ledger_queue(database and job and "speak" and session and concat(job and ":request")) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        set rolled to archive_rollback(database)
        return 1
    return tool_ledger_claim(database and job and "speak")

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if not (group_speech_schema(database) equals "applied"):
        return 20
    for each name in ["a","owner","foreign"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite-owner" and "g" and "device:owner" and "invited" and 1) equals "recorded") or else not (group_change(database and "owner" and "join-owner" and "g" and "device:owner" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 21
    set session to "shared"


    if archive_append(database and session and "answer" and "assistant_final" and "{\"content\":\"Hello Echo\"}" and "fixture") is not equal to 0 or else queue_saved_speech(database and session and "speech-one") is not equal to 0:
        return 4
    if not (archive_list_text(speech_tool_authority(database and "speech-one" and "speak") and 0) equals "found") or else tool_policy_allows(database and "speech-one" and "speak" and "host_read_text") is not equal to 0 or else tool_policy_allows(database and "speech-one" and "speak" and "image_generate") is not equal to 0:
        return 5
    if queue_forged_speech(database and session and "forged-source") is not equal to 0 or else not (speech_tool_execute(database and "forged-source" and "speak" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 10
    if not (principal_host_role(database and "grant" and "device:owner" and "admin" and "fixture") equals "recorded") or else not (speech_tool_execute(database and "speech-one" and "speak" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 6
    if queue_saved_speech(database and session and "speech-two") is not equal to 0 or else not (archive_list_text(speech_tool_authority(database and "speech-two" and "speak") and 0) equals "found"):
        return 7
    if not (group_change(database and "a" and "remove-owner" and "g" and "device:owner" and "removed" and 3) equals "recorded") or else not (speech_tool_execute(database and "speech-two" and "speak" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 8
    set count to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='provider_helper_dispatch';"))
    if not (archive_list_text(count and 1) equals "0") or else archive_verify(database and session) is not equal to 0:
        return 9
    display "PASS: direct shared speech preserves exact caller, cannot become a model/image/admin run, role changes invalidate queued work, fresh request valid, membership removal prevents helper launch."
    return sql_close(database)
