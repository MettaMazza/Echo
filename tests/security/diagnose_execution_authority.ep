import "../../app/tools/execution_tool"

define authority_probe with path as Str and run as Str and call_id as Str and completed as Int returning Int:
    set database to archive_open(path)
    set index to 0
    repeat while index < 30:
        set authority to workspace_execution_request(database and run and call_id)
        if not (archive_list_text(authority and 0) equals "authorized"):
            set library to ep_dlopen("/usr/lib/libsqlite3.dylib")
            display concat("FAILED: " and archive_list_text(authority and 0))
            display ptr_to_str(ep_dlcall1(ep_dlsym(library and "sqlite3_errmsg") and database))
            set closed to ep_dlclose(library)
            send 1 to completed
            return 1
        set index to index + 1
    set closed to sql_close(database)
    send 0 to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    if ptr_to_str(get_env("ECHO_DIAGNOSE_EXECUTE")) equals "1":
        set database to archive_open(get_argument(1))
        display execution_tool_execute_local(database and get_argument(2) and get_argument(3) and -1)
        return sql_close(database)
    set completed to channel
    spawn authority_probe(get_argument(1) and get_argument(2) and get_argument(3) and completed)
    spawn authority_probe(get_argument(1) and get_argument(2) and get_argument(3) and completed)
    set first to receive from completed
    set second to receive from completed
    if first + second > 0:
        return 2
    set database to archive_open(get_argument(1))
    set authority to workspace_execution_request(database and get_argument(2) and get_argument(3))
    set code to sqlite3_extended_errcode(database)
    set library to ep_dlopen("/usr/lib/libsqlite3.dylib")
    set diagnostic to concat(ptr_to_str(ep_dlcall1(ep_dlsym(library and "sqlite3_errmsg") and database)) and "")
    display archive_list_text(authority and 0)
    display int_to_string(code)
    display diagnostic
    set closed to ep_dlclose(library)
    return sql_close(database)
