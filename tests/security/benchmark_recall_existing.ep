import "../../app/web/attachments"
import "../../app/memory/context_snapshot"
import "fs"

# Run only against a disposable archive copy. Outputs aggregate timing and
# selected records to a caller-controlled private evidence directory.
define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set started to ep_time_now_ms()
    set principal to memory_archive_principal(database and get_argument(2))
    display concat("principal_ms=" and int_to_string(ep_time_now_ms() - started))
    set started to ep_time_now_ms()
    set binding to echo_runtime_binding(database and get_argument(2))
    display concat("binding_ms=" and int_to_string(ep_time_now_ms() - started))
    set started to ep_time_now_ms()
    set corrections to memory_corrections(database and get_argument(2) and "")
    display concat("corrections_ms=" and int_to_string(ep_time_now_ms() - started))
    set started to ep_time_now_ms()
    set prepared to memory_semantic_prepare(database and get_argument(2))
    display concat("prepare_ms=" and int_to_string(ep_time_now_ms() - started))
    if prepared is not equal to 0:
        return 3
    set started to ep_time_now_ms()
    set claims to memory_recall_claims(database and get_argument(2))
    display concat("claims_ms=" and int_to_string(ep_time_now_ms() - started))
    set saved to write_file(concat(get_argument(3) and ".claims.json") and claims)
    set started to ep_time_now_ms()
    set selected to memory_semantic_select(database and get_argument(2) and claims)
    display concat("select_ms=" and int_to_string(ep_time_now_ms() - started))
    set saved to write_file(concat(get_argument(3) and ".selected.json") and selected)
    set started to ep_time_now_ms()
    set content to memory_context_selected(database and get_argument(2) and selected)
    set records to memory_compact_records(database and selected)
    display concat("render_ms=" and int_to_string(ep_time_now_ms() - started))
    display concat("context_characters=" and int_to_string(string_length(content)))
    return sql_close(database)
