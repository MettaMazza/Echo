import "../../app/security/group_runs"
import "../../app/web/run_store"
import "../../app/memory/archive_recall"

define group_fixture_call with database as Int and run as Str and session as Str and call_id as Str returning Int:
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"call_id\":" and concat(provider_quote(call_id) and "}")))
    set event to concat(run and concat(":" and call_id))
    if archive_append(database and session and event and "tool_call" and payload and "fixture") is not equal to 0:
        return 1
    return tool_ledger_queue(database and run and call_id and session and event)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set text to ptr_to_str(name)
        if web_pairing_invite(database and text) is not equal to 0 or else web_device_pair(database and text and text and text and concat(text and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    if not (group_session_create(database and "a" and "s3" and "g" and "discord" and "server" and "room" and 3) equals "created"):
        return 5
    if not (group_run_submit(database and "b" and "guest-run" and "s3" and "discord" and "server" and "room" and "Guest request") equals "accepted") or else not (group_run_submit(database and "b" and "guest-run" and "s3" and "discord" and "server" and "room" and "Guest request") equals "already-accepted"):
        return 6
    if not (group_run_submit(database and "a" and "guest-run" and "s3" and "discord" and "server" and "room" and "Guest request") equals "submission-conflict") or else not (group_run_submit(database and "a" and "parallel-run" and "s3" and "discord" and "server" and "room" and "Concurrent") equals "session-active"):
        return 7
    if run_authority_allows(database and "guest-run" and "user") is not equal to 1 or else run_authority_allows(database and "guest-run" and "admin") is not equal to 0 or else group_fixture_call(database and "guest-run" and "s3" and "guest-call") is not equal to 0:
        return 8
    if tool_authority_allows(database and "guest-run" and "guest-call" and "user") is not equal to 1 or else tool_authority_allows(database and "guest-run" and "guest-call" and "admin") is not equal to 0:
        return 9
    if not (principal_host_role(database and "grant-b" and "device:b" and "admin" and "Fixture") equals "recorded") or else group_fixture_call(database and "guest-run" and "s3" and "after-grant") is not equal to 0 or else tool_authority_allows(database and "guest-run" and "after-grant" and "admin") is not equal to 0 or else run_authority_allows(database and "guest-run" and "user") is not equal to 0:
        return 10
    if not (group_change(database and "a" and "invite-c" and "g" and "device:c" and "invited" and 3) equals "recorded") or else not (group_session_create(database and "a" and "s4" and "g" and "discord" and "server" and "room" and 4) equals "created"):
        return 11
    if not (group_run_submit(database and "a" and "admin-run" and "s4" and "discord" and "server" and "room" and "Admin request") equals "accepted") or else group_fixture_call(database and "admin-run" and "s4" and "admin-call") is not equal to 0 or else run_authority_allows(database and "admin-run" and "admin") is not equal to 1 or else tool_authority_allows(database and "admin-run" and "admin-call" and "admin") is not equal to 1 or else tool_authority_allows(database and "admin-run" and "admin-call" and "steward") is not equal to 0:
        return 12
    if not (group_change(database and "c" and "join-c" and "g" and "device:c" and "joined" and 4) equals "recorded") or else run_authority_allows(database and "admin-run" and "user") is not equal to 0 or else tool_authority_allows(database and "admin-run" and "admin-call" and "user") is not equal to 0:
        return 13
    if group_fixture_call(database and "admin-run" and "s3" and "wrong-session") equals 0 or else group_fixture_call(database and "missing-run" and "s4" and "no-origin") equals 0:
        return 14
    if sql_execute(database and "UPDATE echo_group_run_origins SET device='a' WHERE run='guest-run';") equals 0 or else sql_execute(database and "DELETE FROM echo_group_run_origins;") equals 0:
        return 15
    set private to web_submit_owned(database and "a" and "private-run" and "" and "Private admin")
    if not (archive_list_text(private and 0) equals "accepted") or else run_authority_allows(database and "private-run" and "admin") is not equal to 1 or else group_fixture_call(database and "private-run" and archive_list_text(private and 1) and "private-call") is not equal to 0 or else tool_authority_allows(database and "private-run" and "private-call" and "admin") is not equal to 1:
        return 16
    if string_length(memory_archive_principal(database and "guest-run")) is not equal to 0 or else string_length(memory_archive_principal(database and "admin-run")) is not equal to 0 or else not (memory_archive_principal(database and "private-run") equals "device:a"):
        return 20
    if not (group_session_create(database and "a" and "s5" and "g" and "discord" and "server" and "room" and 5) equals "created") or else not (group_run_submit(database and "a" and "revocation-run" and "s5" and "discord" and "server" and "room" and "Before revocation") equals "accepted") or else group_fixture_call(database and "revocation-run" and "s5" and "revoke-call") is not equal to 0:
        return 21
    if string_length(memory_archive_principal(database and "revocation-run")) is not equal to 0 or else run_authority_allows(database and "revocation-run" and "admin") is not equal to 1:
        return 22
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "Fixture") equals "recorded") or else run_authority_allows(database and "revocation-run" and "user") is not equal to 0 or else tool_authority_allows(database and "revocation-run" and "revoke-call" and "user") is not equal to 0:
        return 23
    if not (principal_host_revocation(database and "restore-a" and "device:a" and 0 and "Fixture") equals "recorded") or else run_authority_allows(database and "revocation-run" and "user") is not equal to 0 or else tool_authority_allows(database and "revocation-run" and "revoke-call" and "user") is not equal to 0:
        return 24
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0 or else sql_execute(database and "INSERT INTO echo_group_run_origins VALUES('orphan','s5','a');") is not equal to 0 or else sql_execute(database and "COMMIT;") equals 0:
        return 25
    set rolled to sql_execute(database and "ROLLBACK;")
    if sql_close(database) is not equal to 0:
        return 17
    set database to archive_open(get_argument(1))
    if not (group_run_schema(database) equals "already-applied") or else run_authority_allows(database and "admin-run" and "user") is not equal to 0 or else run_authority_allows(database and "private-run" and "admin") is not equal to 0:
        return 18
    if sql_close(database) is not equal to 0:
        return 19
    display "PASS: actual shared sender, frozen tool role, no borrowed admin or queued promotion, audience-change invalidation, session binding, private regression and restart. Connector routing is not installed."
    return 0
