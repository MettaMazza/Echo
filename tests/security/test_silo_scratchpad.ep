import "../../app/security/channel_silo"
import "../../app/web/run_store"
import "../../app/context/session_messages"
import "../../app/tools/scratchpad"
import "../../app/agent/tool_recovery"
import "../fixtures/generation_fixture"

define recall_fixture_call with database as Int and run as Str and request as Str and call_id as Str and name as Str and arguments as Str returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"Fixture reasoning: select the requested operation.\",\"tool_calls\":[{\"index\":0,\"id\":" and provider_quote(call_id))
    set delta to concat(delta and concat(",\"function\":{\"name\":" and provider_quote(name)))
    set delta to concat(delta and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}")))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set body to session_request_body_owned(database and run and "fixture" and agent_run_messages(database and run))
    if string_contains(body and "scratchpad") equals 0 or else provider_json_tokens(body) equals 0:
        return 2
    set generated to agent_generate_local(database and run and request and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 3
    if agent_tool_step(database and run) is not equal to 0 or else agent_tool_step(database and run) is not equal to 0:
        return 4
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","outsider"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set private to web_submit_owned(database and "a" and "private" and "" and "Private notes")
    if string_contains(scratchpad_execute(database and "private" and "{\"operation\":\"write\",\"name\":\"work\",\"text\":\"PRIVATE_CANARY\",\"previous_revision\":\"\"}") and "saved") equals 0:
        return 4
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 5
    set first to group_route_submit(database and "a" and "g" and "browser" and "local" and "g" and "first" and "Shared notes")
    if not (archive_list_text(first and 0) equals "accepted"):
        return 6
    if string_contains(session_tool_schemas_owned(database and "first") and "scratchpad") equals 0:
        return 7
    if not (scratchpad_execute(database and "first" and "{\"operation\":\"read\",\"name\":\"work\"}") equals "{\"status\":\"end\"}"):
        return 8
    if recall_fixture_call(database and "first" and "write-request" and "write" and "scratchpad" and "{\"operation\":\"write\",\"name\":\"work\",\"text\":\"SHARED_CANARY\",\"previous_revision\":\"\"}") is not equal to 0:
        return 9
    if agent_cancel_run(database and "first") is not equal to 0:
        return 17
    set second to group_route_submit(database and "b" and "g" and "browser" and "local" and "g" and "second" and "Read shared notes")
    if not (archive_list_text(second and 0) equals "accepted"):
        return 18
    if string_contains(scratchpad_execute(database and "second" and "{\"operation\":\"read\",\"name\":\"work\"}") and "SHARED_CANARY") equals 0:
        return 10
    set channel_result to channel_silo_submit(database and "a" and "discord" and "server" and "room" and "channel" and "Independent notes" and create_list())
    if not (scratchpad_execute(database and "channel" and "{\"operation\":\"read\",\"name\":\"work\"}") equals "{\"status\":\"end\"}"):
        return 11
    if string_contains(scratchpad_execute(database and "private" and "{\"operation\":\"read\",\"name\":\"work\"}") and "PRIVATE_CANARY") equals 0:
        return 12
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if string_contains(scratchpad_execute(database and "second" and "{\"operation\":\"read\",\"name\":\"work\"}") and "SHARED_CANARY") equals 0:
        return 13
    if not (group_change(database and "a" and "remove" and "g" and "device:b" and "removed" and 3) equals "recorded"):
        return 14
    if not (scratchpad_execute(database and "second" and "{\"operation\":\"read\",\"name\":\"work\"}") equals "{\"status\":\"not-authorized\"}"):
        return 15
    set next to group_route_submit(database and "a" and "g" and "browser" and "local" and "g" and "next" and "New audience")
    if not (archive_list_text(next and 0) equals "accepted") or else not (scratchpad_execute(database and "next" and "{\"operation\":\"read\",\"name\":\"work\"}") equals "{\"status\":\"end\"}"):
        return 16
    display "PASS: shared scratchpad advertised and dispatched, member read, private/channel isolation, reopen, removal and new-audience separation."
    return sql_close(database)
