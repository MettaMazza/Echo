import "../../app/security/group_route"
import "../../app/web/routes"

define group_attachment_route with config as List and target as Str and body as Str and credential as Str returning List:
    set listener to local_socket_listen(0)
    set client to net_connect("127.0.0.1" and get_list(listener and 2))
    set accepted to local_socket_accept(listener)
    set wire to concat("POST " and concat(target and " HTTP/1.1\r\nHost: 127.0.0.1:8123\r\nOrigin: http://127.0.0.1:8123\r\nX-Echo-Token: "))
    set wire to concat(wire and concat(credential and "\r\nContent-Type: application/json\r\nContent-Length: "))
    set wire to concat(wire and concat(int_to_string(string_length(body)) and concat("\r\n\r\n" and body)))
    set sent to socket_write_all(get_list(listener and 0) and client and -1 and str_to_ptr(wire) and string_length(wire))
    set reader to http_stream_create(get_list(listener and 0) and accepted and -1)
    set request to http_stream_head(reader)
    set reply to web_route(reader and request and 8123 and config)
    set closed to http_stream_release(reader)
    set closed to net_close(accepted)
    set closed to net_close(client)
    set closed to local_socket_close(listener)
    return reply

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_upload_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "local" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set route to group_route(database and "a" and "g" and "local" and "server" and "room")
    set session to archive_list_text(route and 1)
    set upload to web_upload_prepare(database and "a" and session and get_argument(2) and "shared.txt" and "text/plain")
    if string_length(upload) equals 0 or else web_upload_claim(database and "b" and upload) equals 0 or else web_upload_claim(database and "a" and upload) is not equal to 0 or else web_upload_claim(database and "a" and upload) equals 0:
        return 5
    set staging to web_upload_owned(database and "a" and upload)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to file_stage_open(library and archive_list_text(staging and 2))
    set text to "Shared attachment café"
    if descriptor < 0 or else file_stage_write(library and descriptor and str_to_ptr(text) and string_length(text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0 or else ep_dlclose(library) is not equal to 0 or else web_upload_register(database and "a" and upload) is not equal to 0:
        return 6
    set config to create_list()
    set added to append_list(config and get_argument(1))
    set added to append_list(config and "fixture")
    set added to append_list(config and 8080)
    set added to append_list(config and 2048)
    set added to append_list(config and 65536)
    set added to append_list(config and "")
    set added to append_list(config and get_argument(2))
    set body to concat("{\"attachment\":" and concat(provider_quote(upload) and "}"))
    set download to group_attachment_route(config and "/api/attachment-download" and body and "b-secret")
    set denied to group_attachment_route(config and "/api/attachment-download" and body and "c-secret")
    if not (archive_list_text(download and 0) equals "200 OK") or else not (archive_list_text(download and 2) equals archive_list_text(staging and 2)) or else not (archive_list_text(denied and 0) equals "404 Not Found"):
        return 15
    set owned to web_attachment_owned(database and "b" and upload)
    if not (archive_list_text(owned and 0) equals "found") or else not (archive_list_text(owned and 4) equals ep_sha256(text)) or else not (archive_list_text(web_attachment_owned(database and "c" and upload) and 0) equals "end"):
        return 7
    set listed to provider_json_tokens(web_attachment_list(database and "b" and session))
    if length_list(provider_items(listed and provider_member(listed and 0 and "attachments"))) is not equal to 1:
        return 8
    set pending to web_upload_prepare(database and "a" and session and get_argument(2) and "stale.txt" and "text/plain")
    set inflight to web_upload_prepare(database and "a" and session and get_argument(2) and "inflight.txt" and "text/plain")
    if string_length(inflight) equals 0 or else web_upload_claim(database and "a" and inflight) is not equal to 0:
        return 16
    set inflight_row to web_upload_owned(database and "a" and inflight)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to file_stage_open(library and archive_list_text(inflight_row and 2))
    if descriptor < 0 or else file_stage_write(library and descriptor and str_to_ptr(text) and string_length(text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0 or else ep_dlclose(library) is not equal to 0:
        return 17
    if string_length(pending) equals 0 or else not (group_change(database and "a" and "invite-c" and "g" and "device:c" and "invited" and 3) equals "recorded") or else not (group_change(database and "c" and "join-c" and "g" and "device:c" and "joined" and 4) equals "recorded"):
        return 9
    if web_upload_claim(database and "a" and pending) equals 0 or else not (archive_list_text(web_attachment_owned(database and "c" and upload) and 0) equals "end") or else not (archive_list_text(web_attachment_owned(database and "b" and upload) and 0) equals "found"):
        return 10
    if web_upload_register(database and "a" and inflight) equals 0 or else not (archive_list_text(web_attachment_owned(database and "a" and inflight) and 0) equals "end"):
        return 18
    set new_route to group_route(database and "c" and "g" and "local" and "server" and "room")
    set new_list to provider_json_tokens(web_attachment_list(database and "c" and archive_list_text(new_route and 1)))
    if length_list(provider_items(new_list and provider_member(new_list and 0 and "attachments"))) is not equal to 0:
        return 11
    if not (group_change(database and "b" and "leave-b" and "g" and "device:b" and "left" and 5) equals "recorded") or else not (archive_list_text(web_attachment_owned(database and "b" and upload) and 0) equals "end"):
        return 12
    if sql_close(database) is not equal to 0:
        return 13
    set database to archive_open(get_argument(1))
    if not (archive_list_text(web_attachment_owned(database and "a" and upload) and 0) equals "found") or else not (archive_list_text(web_attachment_owned(database and "b" and upload) and 0) equals "end") or else sql_close(database) is not equal to 0:
        return 14
    display "PASS: real shared upload publication and digest, member listing/download lookup, uploader-only claim, outsider/new member denial, old-member retained read, stale upload rejection, departure and restart."
    return 0
