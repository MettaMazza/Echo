import "../fixtures/protected_reviews"
import "../../app/rights/review_upgrade"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    set charter to get_argument(2)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (protected_review_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "admin" and "Refusal fixture" and "secret") is not equal to 0 or else not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Fixture") equals "recorded"):
        return 3
    set submitted to web_submit_owned(database and "admin" and "admin-run" and "" and "Review fixture")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    set manifest to protected_manifest(charter and "identity" and "/fixture/identity.txt" and ep_sha256("before") and ep_sha256("after") and "Disposable proposal")
    if not (protected_proposal_store(database and charter and "admin-run" and "attempt" and manifest) equals "recorded") or else inspection_fixture(database and session and "inspect" and "protected_change_inspect" and manifest and ep_sha256(manifest) and 1) is not equal to 0:
        return 5
    if review_fixture(database and session and "consent" and "consent" and ep_sha256(manifest) and 1 and 0) is not equal to 0 or else not (fixture_review_store(database and "admin-run" and "consent") equals "recorded"):
        return 6
    set old to protected_review_evidence(database and "admin-run" and "consent")
    if review_fixture(database and session and "reject" and "reject" and "" and 2 and 1) is not equal to 0 or else not (fixture_review_store(database and "admin-run" and "reject") equals "refusal-schema-required"):
        return 7
    if not (protected_refusal_schema(database) equals "applied") or else not (protected_refusal_schema(database) equals "already-applied"):
        return 8
    set preserved to history_collect_one(archive_prepare(database and "SELECT evidence FROM echo_protected_reviews_pre16 WHERE call_id='consent';"))
    if not (archive_list_text(preserved and 1) equals old) or else not (protected_review_evidence(database and "admin-run" and "consent") equals old):
        return 9
    if not (fixture_review_store(database and "admin-run" and "reject") equals "recorded") or else not (fixture_review_store(database and "admin-run" and "reject") equals "already-recorded"):
        return 10
    set receipt to history_collect_one(archive_prepare(database and "SELECT inspection_event IS NULL,json_extract(evidence,'$.manifest_digest') FROM echo_protected_reviews WHERE call_id='reject';"))
    if not (archive_list_text(receipt and 1) equals "1") or else not (archive_list_text(receipt and 2) equals ep_sha256(manifest)):
        return 11
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 12
    set gate to protected_decision_check(database and charter and "admin-run" and "attempt" and "" and "" and "")
    set rolled to sql_execute(database and "ROLLBACK;")
    if not (gate equals "echo-rejected"):
        return 13
    if review_fixture(database and session and "unseen-consent" and "consent" and "" and 2 and 2) is not equal to 0 or else not (fixture_review_store(database and "admin-run" and "unseen-consent") equals "review-evidence-invalid"):
        return 14
    if review_fixture(database and session and "wrong-digest" and "reject" and ep_sha256("different") and 3 and 2) is not equal to 0 or else not (fixture_review_store(database and "admin-run" and "wrong-digest") equals "review-evidence-invalid"):
        return 15
    if review_fixture(database and session and "counter" and "counter" and "" and 2 and 2) is not equal to 0 or else not (fixture_review_store(database and "admin-run" and "counter") equals "recorded"):
        return 16
    if review_fixture(database and session and "object" and "object" and "" and 2 and 3) is not equal to 0 or else not (fixture_review_store(database and "admin-run" and "object") equals "recorded"):
        return 17
    if sql_execute(database and "UPDATE echo_protected_reviews SET evidence='changed';") equals 0 or else sql_execute(database and "DELETE FROM echo_protected_reviews;") equals 0 or else sql_execute(database and "UPDATE echo_protected_reviews_pre16 SET evidence='changed';") equals 0:
        return 18
    if sql_close(database) is not equal to 0:
        return 19
    set database to archive_open(get_argument(1))
    set latest to protected_review_latest(database and "admin-run" and "attempt")
    set tokens to provider_json_tokens(archive_list_text(latest and 2))
    if not (archive_list_text(latest and 0) equals "found") or else not (archive_list_text(latest and 1) equals "4") or else not (provider_value(tokens and provider_member(tokens and 0 and "decision")) equals "reject") or else string_length(provider_value(tokens and provider_member(tokens and 0 and "inspection_event"))) is not equal to 0:
        return 20
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 21
    display "PASS: migration preserves consent; uninspected rejection/counter/core objection persist with no invented inspection; refusal blocks the decision gate; consent without disclosure and wrong digests fail; immutable receipts survive reopening."
    return 0
