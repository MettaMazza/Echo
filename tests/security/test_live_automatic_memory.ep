import "../../app/web/attachments"
import "../../app/agent/runner"

# The supplied database must be an isolated copy, never the running archive.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    set submitted to web_submit_owned(database and get_argument(2) and "automatic-memory-acceptance" and "" and "What do you remember about me and the corrections I made in our earlier conversations about mirroring and how we talk? Answer naturally and briefly, using the memories available to you.")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        display archive_list_text(submitted and 0)
        return 2
    set status to agent_loop_provider(database and "automatic-memory-acceptance" and agent_provider_read(database and "automatic-memory-acceptance") and 2048 and -1 and 65536)
    display status
    if not (status equals "completed"):
        return 3
    return sql_close(database)
