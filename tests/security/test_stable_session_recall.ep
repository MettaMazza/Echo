import "../../app/context/session_messages"
import "../../app/web/attachments"
import "../../app/agent/tool_dispatch"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set original to web_submit_owned(database and "owner" and "original" and "" and "I prefer clear wording. I prefer tea.")
    set source to archive_read_event(database and "original:user")
    set saved to knowledge_record(database and "original" and "semantic" and "owner" and "preference" and "I prefer clear wording." and "source-account" and "original:user" and archive_list_text(source and 6) and "" and "" and "")
    set claim to substring(saved and 9 and string_length(saved) - 9)
    set first to web_submit_owned(database and "owner" and "first" and "" and "Hello")
    if memory_context_capture(database and "first") is not equal to 0:
        return 4
    set base to memory_context_stable(database and "first")
    if string_contains(base and "I prefer clear wording.") equals 0:
        return 5
    set first_messages to session_messages_snapshot(database and archive_list_text(first and 1) and "first")
    set first_objective to string_index_of(first_messages and "Hello")
    if first_objective < 0:
        return 24
    set finished to sql_execute(database and "UPDATE echo_runs SET state='completed' WHERE run='first';")
    set saved to knowledge_record(database and "original" and "semantic" and "owner" and "preference" and "I prefer tea." and "source-account" and "original:user" and archive_list_text(source and 6) and "" and "" and "")
    set second to web_submit_owned(database and "owner" and "second" and archive_list_text(first and 1) and "Anything else?")
    if memory_context_capture(database and "second") is not equal to 0:
        return 6
    if not (memory_context_stable(database and "second") equals base):
        return 7
    set revision to memory_context_revision(database and "second")
    set delta to memory_context_delta(database and "second" and "second" and revision)
    if string_contains(delta and "I prefer tea.") equals 0:
        return 8
    if not agent_direct_lookup(database and "second" and "memory_search" and "{}") or else agent_direct_lookup(database and "second" and "scratchpad" and "{\"operation\":\"write\"}"):
        return 9
    if not agent_direct_lookup(database and "second" and "scratchpad" and "{\"operation\":\"read\"}"):
        return 10
    set before_forget to session_messages_snapshot(database and archive_list_text(first and 1) and "second")
    if not (substring(first_messages and 0 and first_objective + 5) equals substring(before_forget and 0 and first_objective + 5)):
        return 25
    set recall_position to string_index_of(before_forget and "I prefer clear wording.")
    set objective_position to string_index_of(before_forget and "Anything else?")
    if objective_position < 0 or else recall_position < 0 or else recall_position >= objective_position:
        return 17
    # Appending accepted user guidance must not move the recall behind it.
    if archive_append(database and archive_list_text(first and 1) and "second:guided" and "user_guidance" and "{\"run_id\":\"second\",\"parent_event\":\"second:user\",\"content\":\"Compare tea and coffee instead.\"}" and "fixture") is not equal to 0:
        return 20
    if agent_run_transition(database and "second" and "ready" and "second:user" and "ready" and "second:guided") is not equal to 0:
        return 21
    set extended to session_messages_snapshot(database and archive_list_text(first and 1) and "second")
    if not (substring(before_forget and 0 and objective_position + 14) equals substring(extended and 0 and objective_position + 14)):
        return 22
    if string_contains(extended and "Compare tea and coffee instead.") equals 0:
        return 23
    if not (knowledge_visibility_set(database and "second" and "forget" and claim and 0 and "forgotten" and "fixture") equals "recorded"):
        return 11
    if memory_context_capture(database and "second") is not equal to 0:
        return 12
    if string_contains(memory_context_stable(database and "second") and "I prefer clear wording.") > 0:
        return 13
    if string_contains(memory_context_delta(database and "second" and "first" and memory_context_revision(database and "second")) and "I prefer clear wording.") > 0:
        return 14
    set after_forget to session_messages_snapshot(database and archive_list_text(first and 1) and "second")
    # Revocation must invalidate cached recall while preserving the actual objective.
    if string_contains(after_forget and "Anything else?") equals 0:
        return 18
    if string_contains(after_forget and "I prefer clear wording.") > 0:
        return 19
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    if string_contains(memory_context_stable(database and "second") and "I prefer clear wording.") > 0:
        return 16
    display "PASS: stable cross-turn recall base, new exact quotations added, forgetting invalidates base and old additions, reopen durable, direct read lookup allowed while writes remain gated."
    return sql_close(database)
