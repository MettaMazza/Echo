import "../../app/rights/operation_rollback"

define main returning Int:
    if get_argument_count() is not equal to 4 or else string_contains(get_argument(1) and "rollback-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set operation to protected_operation_read(database and "fixture-operation")
    set payload to archive_list_text(operation and 1)
    set tokens to provider_json_tokens(payload)
    set directory to provider_value(tokens and provider_member(tokens and 0 and "directory"))
    if string_contains(directory and "deployment-fixture") equals 0:
        return 2
    set mode to get_argument(3)
    if mode equals "crash-before" or else mode equals "crash-after":
        if not (archive_list_text(operation and 0) equals "applied") or else sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
            return 3
        if protected_rollback_binding(database and get_argument(2) and payload) equals 0 or else not (protected_operation_observe(payload) equals "after"):
            return 4
        if protected_operation_record(database and "fixture-operation" and payload and "rolling-back" and "Deliberate rollback SIGKILL fixture") is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
            return 5
        if mode equals "crash-after":
            if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
                return 6
            if not (protected_exchange(directory and "runtime.bin" and "candidate.bin" and provider_value(tokens and provider_member(tokens and 0 and "after_sha256")) and provider_value(tokens and provider_member(tokens and 0 and "before_sha256"))) equals "exchanged"):
                return 7
            # Deliberately leave the completion row uncommitted, as a crash
            # can occur after successful exchange and before SQLite COMMIT.
            if protected_operation_record(database and "fixture-operation" and payload and "rolled-back" and "Uncommitted fixture completion") is not equal to 0:
                return 8
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set killed to ep_dlcall2(ep_dlsym(library and "kill") and ep_dlcall0(ep_dlsym(library and "getpid")) and 9)
        return 9
    else if mode equals "reapply-fixture":
        if not (protected_operation_observe(payload) equals "before") or else not (protected_exchange(directory and "runtime.bin" and "candidate.bin" and provider_value(tokens and provider_member(tokens and 0 and "before_sha256")) and provider_value(tokens and provider_member(tokens and 0 and "after_sha256"))) equals "exchanged"):
            return 10
        display "Independent fixture reset; not an authorized redeployment receipt."
    else if mode equals "reconcile-before":
        if not (protected_rollback_reconcile(database and get_argument(2) and "fixture-operation") equals "rollback-not-applied") or else not (protected_operation_observe(payload) equals "after"):
            return 11
        if not (protected_operation_rollback(database and get_argument(2) and "fixture-operation") equals "rolled-back"):
            return 12
    else if mode equals "reconcile-after":
        if not (protected_rollback_reconcile(database and get_argument(2) and "fixture-operation") equals "rolled-back") or else not (protected_operation_rollback(database and get_argument(2) and "fixture-operation") equals "already-rolled-back"):
            return 13
    else if mode equals "rollback":
        if not (protected_operation_rollback(database and "/missing-charter" and "fixture-operation") equals "rollback-binding-invalid") or else not (protected_operation_observe(payload) equals "after"):
            return 14
        if not (protected_operation_rollback(database and get_argument(2) and "fixture-operation") equals "rolled-back") or else not (protected_operation_observe(payload) equals "before") or else not (protected_operation_rollback(database and get_argument(2) and "fixture-operation") equals "already-rolled-back"):
            return 15
    else:
        return 16
    if sql_close(database) is not equal to 0:
        return 17
    if not (mode equals "reapply-fixture"):
        set database to archive_open(get_argument(1))
        if not (protected_rollback_reconcile(database and get_argument(2) and "fixture-operation") equals "rolled-back") or else archive_verify(database and protected_operation_session("fixture-operation")) is not equal to 0 or else sql_close(database) is not equal to 0:
            return 18
    display "PASS: requested recorded rollback/restart test."
    return 0
