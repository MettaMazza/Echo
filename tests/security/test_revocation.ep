import "../../app/web/run_store"
import "../../app/security/revocation"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "a" and "fixture" and "secret") is not equal to 0:
        return 3
    if not (principal_revocation_schema(database) equals "applied"):
        return 4
    # A fixture account binding models a trusted platform adapter. This is not
    # evidence that a live Discord account has been linked or authenticated.
    if sql_execute(database and "INSERT INTO echo_principal_accounts(platform,subject,principal) VALUES('discord','fixture-user','device:a');") is not equal to 0:
        return 5
    if not (principal_host_role(database and "grant" and "device:a" and "admin" and "fixture grant") equals "recorded"):
        return 6
    if not (principal_for_account(database and "discord" and "fixture-user") equals "device:a") or else not (principal_for_account(database and "other" and "fixture-user") equals ""):
        return 7
    if sql_execute(database and "CREATE TRIGGER reject_revocation BEFORE UPDATE ON echo_principals BEGIN SELECT RAISE(ABORT,'fixture failure'); END;") is not equal to 0:
        return 8
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture revoke") equals "revocation-write-failed"):
        return 9
    set row to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM echo_principal_revocations;"))
    if not (archive_list_text(row and 1) equals "0") or else not (principal_role(database and "device:a") equals "admin"):
        return 10
    if sql_execute(database and "DROP TRIGGER reject_revocation;") is not equal to 0:
        return 11
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture revoke") equals "recorded"):
        return 12
    if not (principal_for_device(database and "a") equals "") or else not (principal_for_account(database and "discord" and "fixture-user") equals "") or else not (principal_role(database and "device:a") equals ""):
        return 13
    if not (principal_host_role(database and "bad-grant" and "device:a" and "admin" and "revoked") equals "principal-unavailable"):
        return 14
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture revoke") equals "already-recorded") or else not (principal_host_revocation(database and "revoke" and "device:a" and 0 and "fixture revoke") equals "revocation-identity-conflict"):
        return 15
    if sql_close(database) is not equal to 0:
        return 16
    set database to archive_open(get_argument(1))
    if not (principal_revocation_schema(database) equals "already-applied") or else not (principal_for_device(database and "a") equals ""):
        return 17
    if not (principal_host_revocation(database and "restore" and "device:a" and 0 and "fixture restore") equals "recorded") or else not (principal_role(database and "device:a") equals "user"):
        return 18
    if not (principal_for_device(database and "a") equals "device:a") or else not (principal_for_account(database and "discord" and "fixture-user") equals "device:a"):
        return 19
    # A delayed replay of an old revoke is only a receipt lookup, never a new
    # state change that could undo a newer explicit restoration.
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture revoke") equals "already-recorded") or else not (principal_role(database and "device:a") equals "user"):
        return 20
    if web_device_revoke(database and "a") is not equal to 0 or else not (principal_host_revocation(database and "restore-again" and "device:a" and 0 and "fixture") equals "recorded") or else not (principal_for_device(database and "a") equals ""):
        return 21
    if sql_execute(database and "UPDATE echo_principal_accounts SET revoked=1;") is not equal to 0 or else not (principal_for_account(database and "discord" and "fixture-user") equals ""):
        return 22
    if sql_execute(database and "DELETE FROM echo_principal_revocations;") equals 0:
        return 23
    if sql_close(database) is not equal to 0:
        return 24
    display "PASS: atomic audited revocation, device/account denial, reopen, safe restoration, delayed replay, independent credential revocation and immutable receipts."
    return 0
