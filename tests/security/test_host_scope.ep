import "../../app/web/run_store"
import "../../app/archive/snapshot"
import "../../app/agent/control"
import "../../app/security/group_output_policy"
import "../../app/security/host_scope"

# Same person on browser and connector does not imply the same resource scope.
# Scope is frozen to audience revision and checked against live authority.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_output_schema(database) equals "applied"):
        return 2
    for each name in ["a","b"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "fixture") equals "recorded"):
        return 4
    set browser to web_submit_owned(database and "a" and "browser-run" and "" and "Inspect an authorised resource.")
    set private to host_resource_scope(database and "browser-run")
    if not (archive_list_text(private and 0) equals "private") or else not (archive_list_text(private and 1) equals "first-party") or else not (archive_list_text(private and 2) equals "private:device:a"):
        return 5
    if not (group_create(database and "a" and "discord-group" and "discord" and "fixture-server" and "fixture-room" and "fixture") equals "created"):
        return 6
    if not (group_session_create(database and "a" and "discord-one" and "discord-group" and "discord" and "fixture-server" and "fixture-room" and 1) equals "created") or else not (group_run_submit(database and "a" and "discord-run" and "discord-one" and "discord" and "fixture-server" and "fixture-room" and "Inspect an authorised resource.") equals "accepted"):
        return 7
    set connector to host_resource_scope(database and "discord-run")
    if not (archive_list_text(connector and 0) equals "audience") or else not (archive_list_text(connector and 1) equals "discord") or else not (archive_list_text(connector and 2) equals "audience:[\"discord-group\",1]") or else archive_list_text(connector and 2) equals archive_list_text(private and 2):
        return 8
    if host_resource_scope(database and "unknown-run") is not equal to 0:
        return 9
    if not (group_change(database and "a" and "invite-b" and "discord-group" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "discord-group" and "device:b" and "joined" and 2) equals "recorded"):
        return 10
    if host_resource_scope(database and "discord-run") is not equal to 0:
        return 11
    if not (group_session_create(database and "a" and "discord-three" and "discord-group" and "discord" and "fixture-server" and "fixture-room" and 3) equals "created") or else not (group_run_submit(database and "a" and "mixed-run" and "discord-three" and "discord" and "fixture-server" and "fixture-room" and "Read with mixed audience.") equals "accepted"):
        return 12
    if host_resource_scope(database and "mixed-run") is not equal to 0:
        return 13
    if not (principal_host_role(database and "admin-b" and "device:b" and "admin" and "fixture") equals "recorded"):
        return 14
    # A later promotion does not rewrite frozen initiating/audience authority.
    if host_resource_scope(database and "mixed-run") is not equal to 0:
        return 15
    if agent_cancel_run(database and "mixed-run") is not equal to 0:
        return 21
    if not (group_run_submit(database and "a" and "admins-run" and "discord-three" and "discord" and "fixture-server" and "fixture-room" and "Read with current admin audience.") equals "accepted"):
        return 16
    set current to host_resource_scope(database and "admins-run")
    if not (archive_list_text(current and 2) equals "audience:[\"discord-group\",3]") or else archive_list_text(current and 2) equals archive_list_text(connector and 2):
        return 17
    if not (principal_host_revocation(database and "revoke-b" and "device:b" and 1 and "fixture") equals "recorded") or else host_resource_scope(database and "admins-run") is not equal to 0:
        return 18
    if not (archive_list_text(host_resource_scope(database and "browser-run") and 2) equals archive_list_text(private and 2)):
        return 19
    if archive_verify_all(database) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 20
    display "PASS: private and connector resource scopes remain distinct; unknown, changed audience, mixed roles, late promotion and recipient revocation cannot grant host resources."
    return 0
