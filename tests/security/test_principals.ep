import "../../app/web/run_store"
import "../../app/security/principals"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "fixture-a") is not equal to 0 or else web_device_pair(database and "fixture-a" and "a" and "Admin localhost" and "fixture-token-a") is not equal to 0:
        return 3
    if not (principal_schema(database) equals "applied"):
        return 4
    if not (principal_for_device(database and "a") equals "device:a") or else not (principal_role(database and "device:a") equals "user"):
        return 5
    if web_pairing_invite(database and "fixture-b") is not equal to 0 or else web_device_pair(database and "fixture-b" and "b" and "Admin localhost" and "fixture-token-b") is not equal to 0:
        return 6
    if not (principal_for_device(database and "b") equals "device:b") or else not (principal_role(database and "device:b") equals "user"):
        return 7
    if not (principal_host_role(database and "grant-a" and "device:a" and "admin" and "Host enrolled fixture") equals "recorded"):
        return 8
    if not (principal_host_role(database and "grant-a" and "device:a" and "admin" and "Host enrolled fixture") equals "already-recorded"):
        return 9
    if not (principal_host_role(database and "grant-a" and "device:b" and "steward" and "Host enrolled fixture") equals "authority-identity-conflict"):
        return 10
    if not (principal_role(database and "device:a") equals "admin") or else not (principal_role(database and "device:b") equals "user"):
        return 11
    # Failing the role update must also roll back the authority receipt.
    if sql_execute(database and "CREATE TRIGGER reject_role BEFORE UPDATE ON echo_principals BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 12
    if not (principal_host_role(database and "demote-a" and "device:a" and "user" and "Revoke fixture authority") equals "authority-write-failed"):
        return 13
    if sql_execute(database and "DROP TRIGGER reject_role;") is not equal to 0:
        return 14
    if not (principal_host_role(database and "demote-a" and "device:a" and "user" and "Revoke fixture authority") equals "recorded"):
        return 15
    if not (principal_role(database and "device:a") equals "user"):
        return 16
    if web_device_revoke(database and "a") is not equal to 0 or else not (principal_for_device(database and "a") equals ""):
        return 17
    if sql_close(database) is not equal to 0:
        return 18
    set database to archive_open(get_argument(1))
    if not (principal_schema(database) equals "already-applied") or else not (principal_for_device(database and "b") equals "device:b"):
        return 19
    if sql_close(database) is not equal to 0:
        return 20
    display "PASS: legacy and new devices remain separate users; names do not grant admin; exact host grants, conflicting replay, atomic audit rollback and revocation survive reopen."
    return 0
