import "../../app/security/group_route"
import "../../app/web/run_store"
import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set first to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "one" and "OLD_AUDIENCE_CANARY")
    if not (archive_list_text(first and 0) equals "accepted"):
        return 5
    set old_session to archive_list_text(first and 1)
    set retry to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "one" and "OLD_AUDIENCE_CANARY")
    if not (archive_list_text(retry and 0) equals "already-accepted") or else not (archive_list_text(retry and 1) equals old_session):
        return 6
    if not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (archive_list_text(group_route(database and "b" and "g" and "discord" and "server" and "room") and 0) equals "audience-not-authorized") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 7
    set second to group_route_submit(database and "b" and "g" and "discord" and "server" and "room" and "two" and "NEW_AUDIENCE_MARKER")
    if not (archive_list_text(second and 0) equals "accepted") or else archive_list_text(second and 1) equals old_session:
        return 8
    set new_session to archive_list_text(second and 1)
    set context to session_messages(database and new_session and "two")
    if string_length(context) equals 0:
        return 17
    set context_values to [context]
    set contains to history_collect_one(checkpoint_prepare(database and "SELECT instr(?1,'OLD_AUDIENCE_CANARY'),instr(?1,'NEW_AUDIENCE_MARKER');" and context_values))
    if not (archive_list_text(contains and 1) equals "0") or else string_to_int(archive_list_text(contains and 2)) < 1:
        return 18
    set source to history_next(database and new_session and 0 and 9223372036854775807 and "OLD_AUDIENCE_CANARY")
    if not (archive_list_text(source and 0) equals "end") or else group_session_allows(database and "b" and old_session and "discord" and "server" and "room" and 0) is not equal to 0:
        return 9
    if not (archive_list_text(group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "one" and "OLD_AUDIENCE_CANARY") and 0) equals "audience-not-authorized"):
        return 10
    if not (archive_list_text(group_route(database and "b" and "g" and "discord" and "wrong" and "room") and 0) equals "audience-not-authorized") or else not (archive_list_text(group_route(database and "c" and "g" and "discord" and "server" and "room") and 0) equals "audience-not-authorized"):
        return 11
    set stale to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded") or else not (group_run_submit(database and "a" and "stale" and archive_list_text(stale and 1) and "discord" and "server" and "room" and "Stale route") equals "audience-not-authorized"):
        return 12
    set third to group_route_submit(database and "a" and "g" and "discord" and "server" and "room" and "three" and "After removal")
    if not (archive_list_text(third and 0) equals "accepted") or else archive_list_text(third and 1) equals new_session or else not (archive_list_text(group_route(database and "b" and "g" and "discord" and "server" and "room") and 0) equals "audience-not-authorized"):
        return 13
    if sql_close(database) is not equal to 0:
        return 14
    set database to archive_open(get_argument(1))
    set reopened to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(reopened and 0) equals "routed") or else not (archive_list_text(reopened and 1) equals archive_list_text(third and 1)):
        return 15
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*),(SELECT COUNT(*) FROM echo_group_run_origins),(SELECT COUNT(*) FROM echo_events WHERE kind='session_branch') FROM echo_group_sessions;"))
    if not (archive_list_text(counts and 1) equals "3") or else not (archive_list_text(counts and 2) equals "3") or else not (archive_list_text(counts and 3) equals "0") or else sql_close(database) is not equal to 0:
        return 16
    display "PASS: current-audience routing, exact retry, new-member context isolation, departed member denial, stale route rejection, namespace isolation and restart without duplicate sessions or private history copying."
    return 0
