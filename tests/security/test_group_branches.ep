import "../../app/security/group_branches"
import "../../app/web/attachments"
import "../../app/web/branches"
import "../../app/context/session_messages"

define group_branch_fixture_finish with database as Int and session as Str and run as Str and user_event as Str and request as Str and final as Str returning Int:
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set request_payload to concat(payload and concat(",\"parent_event\":" and concat(provider_quote(user_event) and "}")))
    if archive_append(database and session and request and "model_request" and request_payload and "fixture") is not equal to 0 or else agent_run_transition(database and run and "ready" and user_event and "generating" and request) is not equal to 0:
        return 1
    set final_payload to concat(payload and concat(",\"parent_event\":" and provider_quote(request)))
    set final_payload to concat(final_payload and ",\"content\":\"Saved original answer\",\"reasoning_content\":\"\",\"tool_calls\":[]}")
    if archive_append(database and session and final and "assistant_final" and final_payload and "fixture") is not equal to 0:
        return 1
    return agent_run_transition(database and run and "generating" and request and "completed" and final)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_session_selection_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","c"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set route to group_route(database and "a" and "g" and "discord" and "server" and "room")
    set file_path to concat(get_argument(1) and ".txt")
    if web_attachment_schema(database) is not equal to 0 or else write_file(file_path and "SHARED_ORIGINAL_BYTES") is not equal to 1 or else web_attachment_register(database and "a" and archive_list_text(route and 1) and "original-file" and file_path and "test.txt" and "text/plain") is not equal to 0:
        return 25
    set files to create_list()
    set added to append_list(files and "original-file")
    set original to group_route_submit_files(database and "a" and "g" and "discord" and "server" and "room" and "original" and "ORIGINAL_BOUNDARY_QUESTION" and files)
    set source to archive_list_text(original and 1)
    if not (archive_list_text(original and 0) equals "accepted") or else group_branch_fixture_finish(database and source and "original" and "original:user" and "request" and "answer") is not equal to 0:
        return 5
    set branch to group_session_branch(database and "a" and "fork" and source and "answer" and "discord" and "server" and "room" and "continue" and "")
    if not (archive_list_text(branch and 0) equals "created"):
        display archive_list_text(branch and 0)
        return 6
    if not (group_run_submit(database and "a" and "later" and source and "discord" and "server" and "room" and "FUTURE_PARENT_SECRET") equals "accepted") or else not (group_run_submit(database and "a" and "next" and archive_list_text(branch and 1) and "discord" and "server" and "room" and "BRANCH_CONTINUATION") equals "accepted"):
        return 7
    set messages to session_messages(database and archive_list_text(branch and 1) and "next")
    if string_contains(messages and "ORIGINAL_BOUNDARY_QUESTION") equals 0 or else string_contains(messages and "Saved original answer") equals 0 or else string_contains(messages and "BRANCH_CONTINUATION") equals 0 or else string_contains(messages and "FUTURE_PARENT_SECRET") > 0:
        return 8
    set later_path to concat(get_argument(1) and ".later.txt")
    if write_file(later_path and "FUTURE_FILE_SECRET") is not equal to 1 or else web_attachment_register(database and "a" and source and "future-file" and later_path and "future.txt" and "text/plain") is not equal to 0:
        return 26
    set listed to web_attachment_list(database and "a" and archive_list_text(branch and 1))
    if string_contains(listed and "original-file") equals 0 or else string_contains(listed and "future-file") > 0:
        return 27
    set read to attachment_text_execute(database and archive_list_text(branch and 1) and "{\"attachment\":\"original-file\",\"offset\":0,\"characters\":100}")
    set denied to attachment_text_execute(database and archive_list_text(branch and 1) and "{\"attachment\":\"future-file\",\"offset\":0,\"characters\":100}")
    if string_contains(read and "SHARED_ORIGINAL_BYTES") equals 0 or else string_contains(denied and "FUTURE_FILE_SECRET") > 0:
        return 28
    set second to group_session_branch(database and "b" and "second" and source and "answer" and "discord" and "server" and "room" and "continue" and "")
    set replay to group_session_branch(database and "a" and "fork" and source and "answer" and "discord" and "server" and "room" and "continue" and "")
    set selected to group_route(database and "a" and "g" and "discord" and "server" and "room")
    if not (archive_list_text(second and 0) equals "created") or else not (archive_list_text(replay and 0) equals "already-created") or else not (archive_list_text(selected and 1) equals archive_list_text(second and 1)):
        return 9
    set denied to group_session_branch(database and "b" and "foreign-edit" and source and "original:user" and "discord" and "server" and "room" and "edit" and "REWRITE")
    if not (archive_list_text(denied and 0) equals "invalid-boundary"):
        return 10
    for each target in ["request","later:user","missing"]:
        set invalid to group_session_branch(database and "a" and concat("invalid:" and target) and source and target and "discord" and "server" and "room" and "continue" and "")
        if not (archive_list_text(invalid and 0) equals "invalid-boundary"):
            return 11
    set foreign to group_session_branch(database and "c" and "foreign" and source and "answer" and "discord" and "server" and "room" and "continue" and "")
    set other_room to group_session_branch(database and "a" and "other-room" and source and "answer" and "discord" and "server" and "other" and "continue" and "")
    if not (archive_list_text(foreign and 0) equals "audience-not-authorized") or else not (archive_list_text(other_room and 0) equals "audience-not-authorized"):
        return 12
    set regenerated to group_session_branch(database and "a" and "regenerate" and source and "original:user" and "discord" and "server" and "room" and "regenerate" and "")
    if not (archive_list_text(regenerated and 0) equals "created"):
        return 13
    set original_read to history_read_piece(database and archive_list_text(regenerated and 1) and "original:user" and 0 and 100)
    # Omitted from replayed conversation, but still retrievable as an original.
    if not (archive_list_text(original_read and 0) equals "found") or else not (archive_list_text(original_read and 7) equals "ORIGINAL_BOUNDARY_QUESTION"):
        return 14
    set edit to group_session_branch(database and "a" and "edit" and source and "original:user" and "discord" and "server" and "room" and "edit" and "Replacement question")
    set conflict to group_session_branch(database and "a" and "edit" and source and "original:user" and "discord" and "server" and "room" and "edit" and "Different question")
    if not (archive_list_text(edit and 0) equals "created") or else not (archive_list_text(conflict and 0) equals "operation-identity-conflict"):
        return 15
    set revised to group_revision_submit(database and "a" and "regenerate" and source and "original:user" and "discord" and "server" and "room" and "regenerate" and "" and "")
    set retry to group_revision_submit(database and "a" and "regenerate" and source and "original:user" and "discord" and "server" and "room" and "regenerate" and "" and "")
    if not (archive_list_text(revised and 0) equals "accepted") or else not (archive_list_text(retry and 0) equals "already-accepted"):
        display archive_list_text(revised and 0)
        return 29
    set user_event to concat(archive_list_text(revised and 2) and ":user")
    set original_copy to archive_read_event(database and user_event)
    set binding to turn_attachment_read(database and archive_list_text(revised and 1) and user_event)
    if not (archive_list_text(original_copy and 3) equals "ORIGINAL_BOUNDARY_QUESTION") or else string_contains(archive_list_text(binding and 1) and "original-file") equals 0:
        return 30
    set revised to group_revision_submit(database and "a" and "edit" and source and "original:user" and "discord" and "server" and "room" and "edit" and "Replacement question" and "")
    if not (archive_list_text(revised and 0) equals "accepted"):
        return 31
    set private to web_submit_owned(database and "a" and "private" and "" and "HOST_PRIVATE_SECRET")
    set denied to group_session_branch(database and "a" and "host-crossing" and archive_list_text(private and 1) and "private:user" and "discord" and "server" and "room" and "regenerate" and "")
    if not (archive_list_text(denied and 0) equals "audience-not-authorized") or else archive_verify_all(database) is not equal to 0:
        return 16
    # Private browser branching remains a separate owner-bound operation.
    set private_session to archive_list_text(private and 1)
    if group_branch_fixture_finish(database and private_session and "private" and "private:user" and "private-request" and "private-answer") is not equal to 0:
        return 32
    set private_branch to web_branch_session(database and "a" and private_session and "private-answer" and "private-fork")
    if not (archive_list_text(private_branch and 0) equals "accepted"):
        return 33
    set later_private to web_submit_owned(database and "a" and "private-later" and private_session and "LATER_PRIVATE_SECRET")
    set next_private to web_submit_owned(database and "a" and "private-next" and archive_list_text(private_branch and 1) and "PRIVATE_CONTINUATION")
    set messages to session_messages(database and archive_list_text(private_branch and 1) and "private-next")
    if string_contains(messages and "HOST_PRIVATE_SECRET") equals 0 or else string_contains(messages and "PRIVATE_CONTINUATION") equals 0 or else string_contains(messages and "LATER_PRIVATE_SECRET") > 0 or else string_contains(messages and "ORIGINAL_BOUNDARY_QUESTION") > 0:
        return 34
    set counts to history_collect_one(archive_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_session_owners o JOIN echo_group_sessions s ON s.session=o.session),(SELECT COUNT(*) FROM pragma_foreign_key_check);"))
    if not (archive_list_text(counts and 1) equals "0") or else not (archive_list_text(counts and 2) equals "0"):
        return 17
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set replay to group_session_branch(database and "a" and "edit" and source and "original:user" and "discord" and "server" and "room" and "edit" and "Replacement question")
    if not (archive_list_text(replay and 0) equals "already-created"):
        return 18
    if not (group_change(database and "b" and "leave" and "g" and "device:b" and "left" and 3) equals "recorded"):
        return 19
    set stale to group_session_branch(database and "a" and "fork" and source and "answer" and "discord" and "server" and "room" and "continue" and "")
    if not (archive_list_text(stale and 0) equals "audience-not-authorized"):
        return 20
    display "PASS: exact shared branch ancestry, future exclusion, speaker-only revisions, immutable retries, audience/channel/Host isolation, reopen and original integrity."
    return sql_close(database)
