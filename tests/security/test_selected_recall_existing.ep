import "../../app/web/attachments"
import "../../app/memory/context_snapshot"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set prepared to memory_semantic_prepare(database and get_argument(2))
    display concat("Semantic preparation status: " and int_to_string(prepared))
    set context to memory_context(database and get_argument(2))
    if string_length(context) equals 0:
        return 3
    set saved to write_file(get_argument(3) and context)
    display concat("Selected recall characters: " and int_to_string(string_length(context)))
    return sql_close(database)
