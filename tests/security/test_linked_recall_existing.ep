import "../../app/web/routes"
import "fs"

# Read-only regression against an existing linked account. Never print private text.
define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set database to archive_open(get_argument(1))
    set run to get_argument(2)
    set session to get_argument(3)
    set source_session to get_argument(4)
    set attachment to get_argument(5)
    set arguments to concat("{\"session\":" and concat(provider_quote(source_session) and ",\"after\":0}"))
    if string_contains(continuity_execute(database and run and "memory_messages" and arguments) and "found") equals 0:
        return 2
    set arguments to concat("{\"attachment\":" and concat(provider_quote(attachment) and ",\"offset\":0,\"characters\":200}"))
    set text to attachment_text_execute(database and session and arguments)
    if string_contains(text and "found") equals 0 or else string_contains(text and "sha256") equals 0:
        display "FAIL: source file was not readable."
        return 3
    set context to memory_context(database and run)
    if string_contains(context and source_session) equals 0:
        return 4
    display "PASS: current run can retrieve linked-device messages, verified original handover text, and linked session in automatic memory context."
    return sql_close(database)
