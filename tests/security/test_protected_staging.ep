import "../../app/rights/staging"

define main returning Int:
    if not (get_argument_count() equals 5 or else (get_argument_count() equals 6 and get_argument(5) equals "copy-only")):
        return 1
    set charter to get_argument(1)
    set root to get_argument(2)
    set target to concat(root and "/before.bin")
    set candidate to concat(root and "/candidate.bin")
    set original_stage to concat(root and "/original-stage.bin")
    set candidate_stage to concat(root and "/candidate-stage.bin")
    set inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(target) and ",\"category\":\"agency\"}]}"))
    set digest to ep_sha256(inventory)
    set manifest to protected_inventory_manifest(charter and inventory and digest and target and get_argument(3) and get_argument(4) and "Disposable binary staging test only")
    if not (protected_stage_pair(charter and inventory and digest and manifest and candidate and original_stage and candidate_stage) equals "copies-staged"):
        return 2
    if not (protected_stage_pair(charter and inventory and digest and manifest and candidate and original_stage and candidate_stage) equals "copies-staged"):
        return 3
    if get_argument_count() equals 6:
        set first to file_digest_durable(original_stage and 65536)
        set second to file_digest_durable(candidate_stage and 65536)
        set unchanged to file_digest_durable(target and 65536)
        if not (archive_list_text(first and 1) equals get_argument(3)) or else not (archive_list_text(second and 1) equals get_argument(4)) or else not (archive_list_text(unchanged and 1) equals get_argument(3)):
            return 10
        display "PASS: filesystem copy qualification: recovery/candidate bytes, file and directory flush, exact retry, original unchanged. Special-file denial is tested separately."
        return 0
    if not (protected_stage_copy(target and concat(root and "/wrong.bin") and get_argument(3)) equals "stage-exists-or-unavailable") or else not (protected_stage_copy(target and concat(root and "/candidate-link") and get_argument(3)) equals "stage-exists-or-unavailable"):
        return 4
    if not (protected_stage_copy(concat(root and "/pipe") and concat(root and "/fifo-stage.bin") and get_argument(3)) equals "source-unreadable"):
        return 5
    if not (protected_stage_copy(candidate and concat(root and "/failed-stage.bin") and get_argument(3)) equals "stage-digest-mismatch") or else not (protected_stage_copy(candidate and concat(root and "/failed-stage.bin") and get_argument(3)) equals "stage-exists-or-unavailable"):
        return 6
    if not (protected_stage_pair(charter and inventory and digest and manifest and candidate and target and candidate_stage) equals "invalid-stage-path"):
        return 7
    if not (protected_stage_pair(charter and inventory and digest and manifest and candidate and original_stage and concat(root and "/wrong.bin")) equals "candidate:stage-exists-or-unavailable"):
        return 8
    set original to file_digest_durable(original_stage and 1)
    set proposed to file_digest_durable(candidate_stage and 65536)
    set unchanged to file_digest_durable(target and 65536)
    if not (archive_list_text(original and 1) equals get_argument(3)) or else not (archive_list_text(proposed and 1) equals get_argument(4)) or else not (archive_list_text(unchanged and 1) equals get_argument(3)):
        return 9
    display "PASS: exclusive binary recovery/candidate copies, file and parent flush, exact retry, conflict and symlink/FIFO denial, retained failed copy, partial pair failure preserves recovery, original unchanged. No target publication."
    return 0
