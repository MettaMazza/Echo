import "../../app/rights/emergency"

# Only disposable copies of the live tool fixture are accepted.
define main returning Int:
    if get_argument_count() is not equal to 3 or else string_contains(get_argument(1) and "emergency-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set charter to get_argument(2)
    if database equals 0 or else not (protected_steward_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "emergency-invite") is not equal to 0 or else web_device_pair(database and "emergency-invite" and "emergency-steward" and "Emergency fixture" and "emergency-secret") is not equal to 0 or else not (principal_host_role(database and "emergency-enrol" and "device:emergency-steward" and "steward" and "Disposable test") equals "recorded"):
        return 3
    if not (protected_emergency_begin_at(database and charter and "fixture-secret" and "unauthorized" and "fixture-node" and "stop" and "Test" and 1000) equals "not-authorized"):
        return 4
    if not (protected_emergency_begin_at(database and charter and "emergency-secret" and "invalid" and "fixture-node" and "rewrite-identity" and "Test" and 1000) equals "invalid-emergency"):
        return 5
    if not (protected_emergency_begin_at(database and charter and "emergency-secret" and "incident" and "fixture-node" and "quarantine" and "Fixture stability incident" and 1000) equals "recorded"):
        return 6
    if not (protected_emergency_begin_at(database and charter and "emergency-secret" and "incident" and "fixture-node" and "quarantine" and "Fixture stability incident" and 99999) equals "already-recorded"):
        return 7
    set session to protected_emergency_session("incident")
    set original to archive_read_event(database and concat(session and ":started"))
    set tokens to provider_json_tokens(archive_list_text(original and 3))
    if not (provider_value(tokens and provider_member(tokens and 0 and "reconciliation_due")) equals "87400"):
        return 8
    if not (protected_emergency_begin_at(database and charter and "emergency-secret" and "incident" and "fixture-node" and "stop" and "Changed request" and 1000) equals "emergency-identity-conflict"):
        return 9
    if not (protected_emergency_disclose(database and charter and "emergency-secret" and "incident" and "Cause" and "" and "Quarantined" and "No hidden changes") equals "incomplete-disclosure"):
        return 10
    if not (protected_emergency_disclose(database and charter and "fixture-secret" and "incident" and "Cause" and "No code changes" and "Quarantined" and "No hidden changes") equals "not-authorized"):
        return 11
    if not (protected_emergency_status_at(database and charter and "emergency-secret" and "incident" and 87400) equals "pending") or else not (protected_emergency_status_at(database and charter and "emergency-secret" and "incident" and 87401) equals "overdue") or else not (protected_emergency_status_at(database and charter and "emergency-secret" and "incident" and 999) equals "clock-before-start"):
        return 19
    if not (protected_emergency_status_at(database and charter and "fixture-secret" and "incident" and 87401) equals "not-authorized"):
        return 20
    if not (protected_emergency_disclose_at(database and charter and "emergency-secret" and "incident" and "Cause" and "No code changes" and "Quarantined" and "No hidden changes" and 87401) equals "recorded"):
        return 12
    if not (protected_emergency_disclose(database and charter and "emergency-secret" and "incident" and "Cause" and "No code changes" and "Quarantined" and "No hidden changes") equals "already-recorded"):
        return 13
    if not (protected_emergency_disclose(database and charter and "emergency-secret" and "incident" and "Changed cause" and "No code changes" and "Quarantined" and "No hidden changes") equals "disclosure-identity-conflict"):
        return 14
    if not (protected_emergency_status_at(database and charter and "emergency-secret" and "incident" and 90000) equals "disclosed-late"):
        return 21
    if not (protected_emergency_begin_at(database and charter and "emergency-secret" and "on-time" and "fixture-node" and "stop" and "Test" and 1000) equals "recorded") or else not (protected_emergency_disclose_at(database and charter and "emergency-secret" and "on-time" and "Cause" and "No edits" and "Stopped" and "No stealth edits" and 87400) equals "recorded") or else not (protected_emergency_status_at(database and charter and "emergency-secret" and "on-time" and 99999) equals "disclosed-on-time"):
        return 22
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    if not (protected_emergency_status_at(database and charter and "emergency-secret" and "incident" and 99999) equals "disclosed-late") or else archive_verify(database and session) is not equal to 0:
        return 16
    if not (principal_host_role(database and "emergency-demote" and "device:emergency-steward" and "admin" and "Remove stewardship") equals "recorded") or else not (protected_emergency_begin_at(database and charter and "emergency-secret" and "second-incident" and "fixture-node" and "stop" and "Test" and 1000) equals "not-authorized"):
        return 17
    if not (protected_emergency_status_at(database and charter and "emergency-secret" and "incident" and 99999) equals "not-authorized"):
        return 23
    if sql_close(database) is not equal to 0:
        return 18
    display "PASS: emergency records require a current steward, constrain actions, preserve the original 24-hour deadline on retry, reject conflicting identities and incomplete disclosures, survive reopening, distinguish pending/overdue/on-time/late disclosure at the exact deadline, and reject demoted credentials for both reads and writes. No stop/quarantine actuator is exercised."
    return 0
