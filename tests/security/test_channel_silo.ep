import "../../app/security/channel_silo"
import "../../app/web/run_store"
import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set private to web_submit_owned(database and "a" and "private" and "" and "PRIVATE_ONLY_CANARY")
    set first to channel_silo_submit(database and "a" and "discord" and "server" and "room" and "one" and "CHANNEL_A_CANARY" and create_list())
    set other to channel_silo_submit(database and "b" and "discord" and "server" and "room" and "two" and "CHANNEL_B_CANARY" and create_list())
    set room to channel_silo_submit(database and "a" and "discord" and "server" and "room-two" and "three" and "OTHER_ROOM_CANARY" and create_list())
    if not (archive_list_text(first and 0) equals "accepted") or else not (archive_list_text(other and 0) equals "accepted") or else not (archive_list_text(room and 0) equals "accepted"):
        return 4
    if archive_list_text(first and 1) equals archive_list_text(other and 1) or else archive_list_text(first and 1) equals archive_list_text(room and 1):
        return 5
    set messages to session_messages(database and archive_list_text(first and 1) and "one")
    if string_length(messages) equals 0 or else string_contains(messages and "CHANNEL_A_CANARY") equals 0 or else string_contains(messages and "PRIVATE_ONLY_CANARY") is not equal to 0 or else string_contains(messages and "CHANNEL_B_CANARY") is not equal to 0 or else string_contains(messages and "OTHER_ROOM_CANARY") is not equal to 0:
        return 6
    set identity to channel_silo_identity("discord" and "server" and "room" and "device:a")
    if not (group_change(database and "a" and "invite" and identity and "device:b" and "invited" and 1) equals "fixed-channel-audience"):
        return 7
    if group_session_allows(database and "b" and archive_list_text(first and 1) and "discord" and "server" and "room" and 0) is not equal to 0 or else group_session_allows(database and "a" and archive_list_text(first and 1) and "discord" and "server" and "room-two" and 0) is not equal to 0:
        return 8
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set retry to channel_silo_submit(database and "a" and "discord" and "server" and "room" and "one" and "CHANNEL_A_CANARY" and create_list())
    if not (archive_list_text(retry and 0) equals "already-accepted") or else not (archive_list_text(retry and 1) equals archive_list_text(first and 1)):
        return 9
    display "PASS: persisted user/channel routing, exact retry after reopen, private/other-user/other-channel context isolation and fixed audience."
    return sql_close(database)
