import "../../app/rights/operation_execute"

define main returning Int:
    if get_argument_count() is not equal to 4 or else string_contains(get_argument(1) and "operation-execute-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set schema to protected_operation_schema(database)
    if not (schema equals "applied" or else schema equals "already-applied"):
        return 2
    set identity to "fixture-operation"
    set operation to protected_operation_read(database and identity)
    set payload to archive_list_text(operation and 1)
    set tokens to provider_json_tokens(payload)
    if tokens equals 0:
        return 3
    set directory to provider_value(tokens and provider_member(tokens and 0 and "directory"))
    if string_contains(directory and "deployment-fixture") equals 0:
        return 4
    set target to concat(directory and "/runtime.bin")
    set inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(target) and ",\"category\":\"agency\"}]}"))
    set mode to get_argument(3)
    if mode equals "crash-before" or else mode equals "crash-after":
        if not (archive_list_text(operation and 0) equals "prepared") or else sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
            return 5
        if not (protected_operation_bindings(database and get_argument(2) and payload and inventory and ep_sha256(inventory) and "") equals "bindings-current") or else not (protected_operation_observe(payload) equals "before"):
            return 6
        if protected_operation_record(database and identity and payload and "applying" and "Native deliberate SIGKILL fixture after durable intent") is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
            return 7
        if mode equals "crash-after":
            if not (protected_exchange(directory and "runtime.bin" and "candidate.bin" and provider_value(tokens and provider_member(tokens and 0 and "before_sha256")) and provider_value(tokens and provider_member(tokens and 0 and "after_sha256"))) equals "exchanged"):
                return 8
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set killed to ep_dlcall2(ep_dlsym(library and "kill") and ep_dlcall0(ep_dlsym(library and "getpid")) and 9)
        return 9
    if mode equals "reset-fixture":
        if not (protected_operation_observe(payload) equals "after"):
            return 10
        if not (protected_exchange(directory and "runtime.bin" and "candidate.bin" and provider_value(tokens and provider_member(tokens and 0 and "after_sha256")) and provider_value(tokens and provider_member(tokens and 0 and "before_sha256"))) equals "exchanged"):
            return 11
        display "Fixture files reset for independent test; this is not a controller rollback receipt."
    else if mode equals "reconcile-before" or else mode equals "reconcile-after":
        set expected to "not-applied"
        if mode equals "reconcile-after":
            set expected to "applied"
        set reconciled to protected_operation_reconcile(database and identity)
        display reconciled
        if not (reconciled equals expected) or else not (protected_operation_reconcile(database and identity) equals expected):
            return 12
        if not (protected_operation_apply(database and get_argument(2) and identity and inventory and ep_sha256(inventory) and "") equals concat("operation-state:" and expected)):
            return 13
    else if mode equals "apply":
        set duplicate_session to protected_operation_session("duplicate-authorization-fixture")
        if archive_append(database and duplicate_session and concat(duplicate_session and ":prepared") and "protected_operation_prepared" and payload and "fixture") equals 0:
            return 19
        if not (archive_list_text(protected_operation_read(database and identity) and 0) equals "prepared"):
            return 20
        if not (protected_operation_apply(database and get_argument(2) and identity and inventory and ep_sha256("wrong") and "") equals "operation-inventory-changed"):
            return 14
        if not (protected_operation_observe(payload) equals "before"):
            return 15
        set applied to protected_operation_apply(database and get_argument(2) and identity and inventory and ep_sha256(inventory) and "")
        display applied
        if not (applied equals "applied") or else not (protected_operation_observe(payload) equals "after") or else not (protected_operation_reconcile(database and identity) equals "applied"):
            return 16
    else:
        return 17
    if sql_close(database) is not equal to 0:
        return 18
    display "PASS: requested operation execution/reconciliation test."
    return 0
