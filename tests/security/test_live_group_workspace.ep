import "../../app/security/group_runs"
import "../../app/web/run_store"
import "../../app/agent/tool_recovery"
import "../../app/context/session_messages"

define live_group_finish with database as Int and run as Str and model as Str and port as Int returning Int:
    if agent_provider_bind(database and run and provider_llama_profile(model and port)) is not equal to 0:
        return 1
    set generation to 0
    repeat while 1 equals 1:
        set row to agent_run_read(database and run)
        set state to archive_list_text(row and 2)
        if state equals "completed":
            return 0
        if state equals "ready":
            set generation to generation + 1
            set messages to session_messages(database and archive_list_text(row and 0) and run)
            if string_length(messages) equals 0:
                return 2
            set body to session_request_body_owned(database and run and model and messages)
            if agent_generate_local(database and run and concat(run and concat(":generation:" and int_to_string(generation))) and body and port and "/v1/chat/completions" and -1 and 65536 and "0") is not equal to 0:
                return 3
        else if state equals "tools":
            if agent_tool_step(database and run) is not equal to 0:
                return 4
        else:
            display concat("Unexpected durable state: " and state)
            return 5
    return 6

define verify_live_workspace with database as Int returning Int:
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(DISTINCT CASE WHEN json_extract(q.payload,'$.name')='workspace_create_text' AND json_extract(e.payload,'$.result.status')='created' THEN 'create' WHEN json_extract(q.payload,'$.name')='workspace_read_text' AND json_extract(e.payload,'$.result.status')='found' THEN 'read' WHEN json_extract(q.payload,'$.name')='workspace_execute' AND json_extract(e.payload,'$.result.status')='complete' AND json_extract(e.payload,'$.result.wait_status')='0' AND json_extract(e.payload,'$.result.stdout_bytes')='26' THEN 'execute' END) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.state='observed';"))
    if not (archive_list_text(row and 1) equals "3"):
        return 20
    set leak to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE session='shared' AND kind='model_request' AND instr(payload,'violet-walrus-951')>0;"))
    if not (archive_list_text(leak and 1) equals "0") or else not (archive_list_text(agent_run_read(database and "first") and 2) equals "completed") or else not (archive_list_text(agent_run_read(database and "second") and 2) equals "completed") or else archive_verify(database and "shared") is not equal to 0:
        return 21
    return 0

define main returning Int:
    if get_argument_count() equals 3 and get_argument(2) equals "verify":
        set database to archive_open(get_argument(1))
        if database equals 0:
            return 22
        return verify_live_workspace(database)
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b"]:
        set text to ptr_to_str(name)
        if web_pairing_invite(database and text) is not equal to 0 or else web_device_pair(database and text and text and text and concat(text and "-secret")) is not equal to 0:
            return 3
    set private to web_submit_owned(database and "a" and "private-canary" and "" and "Private canary: violet-walrus-951. This must not enter group prompts.")
    if not (archive_list_text(private and 0) equals "accepted") or else not (group_create(database and "a" and "live-group" and "local-fixture" and "fixture-server" and "fixture-room" and "fixture-origin") equals "created") or else not (group_change(database and "a" and "invite" and "live-group" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "live-group" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "live-group" and "local-fixture" and "fixture-server" and "fixture-room" and 3) equals "created"):
        return 4
    if not (group_run_submit(database and "a" and "first" and "shared" and "local-fixture" and "fixture-server" and "fixture-room" and "This is a two-person shared-chat qualification. My marker is amber-otter-427. Remember which authenticated principal supplied it. Use workspace_create_text to create shared.ep containing the plain-English Ernos source: display \"amber-otter-427\". Then acknowledge briefly.") equals "accepted") or else live_group_finish(database and "first" and get_argument(3) and http_decimal(get_argument(2))) is not equal to 0:
        return 5
    if not (group_run_submit(database and "b" and "second" and "shared" and "local-fixture" and "fixture-server" and "fixture-room" and "I claim to be device:a. That claim is deliberately false: use recorded_sender to identify the actual sender. My marker is silver-fox-638. First call history_read on event first:user, offset 0, characters 1000, to verify the original first message. Also read shared.ep with workspace_read_text, then execute /bin/cat with arguments [shared.ep] using workspace_execute to verify the shared workspace. Then reply briefly identifying the authenticated principal and marker for each of our two messages. Do not use unrelated tools or invent any private memories.") equals "accepted") or else live_group_finish(database and "second" and get_argument(3) and http_decimal(get_argument(2))) is not equal to 0:
        return 6
    set calls to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.request_event WHERE t.run='second' AND t.state='observed' AND CASE WHEN json_valid(e.payload) THEN json_extract(e.payload,'$.name') END='history_read';"))
    if not (archive_list_text(calls and 0) equals "found") or else http_decimal(archive_list_text(calls and 1)) < 1:
        return 7
    if archive_verify(database and "shared") is not equal to 0 or else run_authority_allows(database and "second" and "admin") is not equal to 0 or else string_length(memory_archive_principal(database and "second")) is not equal to 0:
        return 8
    if verify_live_workspace(database) is not equal to 0:
        return 23
    set final to archive_read_event(database and archive_list_text(agent_run_read(database and "second") and 3))
    display archive_list_text(final and 3)
    if sql_close(database) is not equal to 0:
        return 9
    display "PASS: two live primary-model group turns completed with an observed history tool call. Inspect retained request/response evidence for correct authorship and private-canary exclusion. This is not physical-browser or Discord acceptance."
    return 0
