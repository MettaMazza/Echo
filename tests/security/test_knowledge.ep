import "../../app/web/run_store"
import "../../app/memory/knowledge"

define knowledge_fixture_digest with database as Int and event as Str returning Str:
    set values to create_list()
    set added to append_list(values and event)
    set row to history_collect_one(checkpoint_prepare(database and "SELECT digest FROM echo_events WHERE event=?;" and values))
    return archive_list_text(row and 1)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    set a to web_submit_owned(database and "a" and "tea" and "" and "I prefer tea. We celebrated our launch on 2026-10-15.")
    set b to web_submit_owned(database and "b" and "private-b" and "" and "Private account B")
    set digest to knowledge_fixture_digest(database and "tea:user")
    set first to knowledge_record(database and "tea" and "semantic" and "user" and "prefers" and "tea" and "source-account" and "tea:user" and digest and "2026-10-15" and "" and "")
    if string_contains(first and "recorded:") is not equal to 1:
        display first
        return 4
    set repeated to knowledge_record(database and "tea" and "semantic" and "user" and "prefers" and "tea" and "source-account" and "tea:user" and digest and "2026-10-15" and "" and "")
    if not (repeated equals concat("already-" and first)):
        return 5
    set claim to knowledge_next(database and "tea" and "user" and 0)
    if not (archive_list_text(claim and 0) equals "found") or else not (archive_list_text(claim and 6) equals "tea") or else not (archive_list_text(claim and 9) equals digest):
        return 6
    set identity to archive_list_text(claim and 1)
    set corrected to web_submit_owned(database and "a" and "coffee" and "" and "Correction: I now prefer coffee.")
    set coffee_digest to knowledge_fixture_digest(database and "coffee:user")
    set second to knowledge_record(database and "coffee" and "semantic" and "user" and "prefers" and "coffee" and "source-account" and "coffee:user" and coffee_digest and "2026-10-16" and "" and identity)
    if string_contains(second and "recorded:") is not equal to 1:
        display second
        return 7
    set old to knowledge_next(database and "coffee" and "tea" and 0)
    if string_length(archive_list_text(old and 14)) equals 0:
        return 8
    if not (knowledge_record(database and "coffee" and "semantic" and "user" and "prefers" and "water" and "source-account" and "coffee:user" and coffee_digest and "" and "" and identity) equals "correction-conflict"):
        return 9
    # A separate contradictory claim is retained; it is not silently merged.
    set conflict to knowledge_record(database and "coffee" and "semantic" and "user" and "prefers" and "water" and "inference" and "coffee:user" and coffee_digest and "" and "" and "")
    if string_contains(conflict and "recorded:") is not equal to 1:
        return 10
    if not (knowledge_record(database and "coffee" and "semantic" and "user" and "prefers" and "tea" and "tool-observation" and "tea:user" and digest and "" and "" and "") equals "evidence-kind-mismatch"):
        return 11
    if not (knowledge_record(database and "private-b" and "semantic" and "user" and "prefers" and "tea" and "source-account" and "tea:user" and digest and "" and "" and "") equals "source-not-found") or else not (archive_list_text(knowledge_next(database and "private-b" and "user" and 0) and 0) equals "end"):
        return 12
    if not (knowledge_record(database and "coffee" and "episodic" and "user" and "celebrated" and "launch" and "source-account" and "tea:user" and "wrong-digest" and "2026-10-15" and "" and "") equals "source-not-found"):
        return 13
    if not (knowledge_record(database and "coffee" and "episodic" and "user" and "celebrated" and "launch" and "source-account" and "tea:user" and digest and "2026-10-16" and "2026-10-15" and "") equals "invalid-date-range"):
        return 14
    if not (knowledge_record(database and "coffee" and "episodic" and "user" and "celebrated" and "launch" and "source-account" and "tea:user" and digest and "now" and "" and "") equals "invalid-date-range"):
        return 21
    if not (knowledge_record(database and "coffee" and "episodic" and "user" and "celebrated" and "launch" and "source-account" and "tea:user" and digest and "2026-02-30" and "" and "") equals "invalid-date-range"):
        return 22
    set episode to knowledge_record(database and "coffee" and "episodic" and "user" and "celebrated" and "launch" and "source-account" and "tea:user" and digest and "2026-10-15" and "" and "")
    if string_contains(episode and "recorded:") is not equal to 1:
        return 15
    if sql_execute(database and "UPDATE echo_memory_claims SET evidence='tool-observation';") equals 0 or else sql_execute(database and "DELETE FROM echo_memory_nodes;") equals 0:
        return 16
    if sql_close(database) is not equal to 0:
        return 17
    set database to archive_open(get_argument(1))
    if not (knowledge_schema(database) equals "already-applied") or else not (archive_list_text(knowledge_next(database and "coffee" and "launch" and 0) and 10) equals "2026-10-15"):
        return 18
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "fixture") equals "recorded") or else not (archive_list_text(knowledge_next(database and "coffee" and "user" and 0) and 0) equals "not-authorized"):
        return 19
    if sql_close(database) is not equal to 0:
        return 20
    display "PASS: private evidence graph preserves original digests, idempotence, corrections, contradictions, dated episodes, restart and revocation; foreign sources and false observation classes are denied."
    return 0
