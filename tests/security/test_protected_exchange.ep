import "../../app/rights/exchange"

# Files and metadata are independently prepared by the host fixture. Preserve
# them at both paths so host inspection can verify the exact round trip.
define exchange_fixture_identity with path as Str returning Str:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to native_open_mode(library and path and 553648132 and 0)
    set information to create_list()
    set index to 0
    repeat while index < 18:
        set added to append_list(information and 0)
        set index to index + 1
    if descriptor < 0 or else ep_dlcall2(ep_dlsym(library and "fstat") and descriptor and get_list_data_ptr(information)) is not equal to 0:
        return ""
    # Installed Darwin stat layout: mode/links, inode, uid/gid, mtime and flags.
    set selected to [0, 1, 2, 6, 7, 14]
    set result to ""
    set index to 0
    repeat while index < length_list(selected):
        set result to concat(result and concat(int_to_string(get_list(information and get_list(selected and index))) and ":"))
        set index to index + 1
    set closed to net_close(descriptor)
    set closed to ep_dlclose(library)
    return result

define main returning Int:
    if not (get_argument_count() equals 4 or else (get_argument_count() equals 5 and get_argument(4) equals "filesystem-only")) or else string_contains(get_argument(1) and "exchange-fixture") equals 0:
        return 1
    set directory to get_argument(1)
    set before_hash to get_argument(2)
    set after_hash to get_argument(3)
    if get_argument_count() equals 5:
        set result to protected_exchange(directory and "before.bin" and "candidate.bin" and before_hash and after_hash)
        display result
        if result equals "exchanged":
            if not (protected_exchange(directory and "before.bin" and "candidate.bin" and after_hash and before_hash) equals "exchanged"):
                return 15
        else if not (result equals "exchange-unsupported-filesystem"):
            return 16
        set original to file_digest_durable(concat(directory and "/before.bin") and 65536)
        set candidate to file_digest_durable(concat(directory and "/candidate.bin") and 65536)
        if not (archive_list_text(original and 1) equals before_hash) or else not (archive_list_text(candidate and 1) equals after_hash):
            return 17
        display "PASS: filesystem exchange qualification; successful rollback or unsupported refusal leaves exact original and candidate bytes."
        return 0
    if not (protected_exchange(directory and "before.bin" and "candidate.bin" and ep_sha256("wrong") and after_hash) equals "exchange-preimage-mismatch"):
        return 2
    if not (protected_exchange(directory and "before.bin" and "../candidate.bin" and before_hash and after_hash) equals "invalid-exchange"):
        return 3
    if not (protected_exchange(directory and "before.bin" and "candidate-link" and before_hash and after_hash) equals "exchange-files-invalid"):
        return 4
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set parent to workspace_root_open(library and directory)
    if parent < 0 or else ep_dlcall2(ep_dlsym(library and "flock") and parent and 6) is not equal to 0:
        return 5
    if not (protected_exchange(directory and "before.bin" and "candidate.bin" and before_hash and after_hash) equals "exchange-busy"):
        return 6
    if net_close(parent) is not equal to 0 or else ep_dlclose(library) is not equal to 0:
        return 7
    set original_identity to exchange_fixture_identity(concat(directory and "/before.bin"))
    set candidate_identity to exchange_fixture_identity(concat(directory and "/candidate.bin"))
    if string_length(original_identity) equals 0 or else string_length(candidate_identity) equals 0 or else original_identity equals candidate_identity:
        return 12
    set status to protected_exchange(directory and "before.bin" and "candidate.bin" and before_hash and after_hash)
    display status
    if not (status equals "exchanged"):
        return 8
    if not (exchange_fixture_identity(concat(directory and "/before.bin")) equals candidate_identity) or else not (exchange_fixture_identity(concat(directory and "/candidate.bin")) equals original_identity):
        return 13
    if not (protected_exchange(directory and "before.bin" and "candidate.bin" and before_hash and after_hash) equals "already-exchanged"):
        return 9
    if not (protected_exchange(directory and "before.bin" and "candidate.bin" and after_hash and before_hash) equals "exchanged"):
        return 10
    if not (protected_exchange(directory and "before.bin" and "candidate.bin" and after_hash and before_hash) equals "already-exchanged"):
        return 11
    if not (exchange_fixture_identity(concat(directory and "/before.bin")) equals original_identity) or else not (exchange_fixture_identity(concat(directory and "/candidate.bin")) equals candidate_identity):
        return 14
    display "PASS: atomic exchange, exact retry, verified original retained, reverse exchange rollback, stale preimage/path/symlink denial and concurrent exchange exclusion. No protected deployment authorization claimed."
    return 0
