import "../../app/security/group_route"
import "../../app/web/attachments"
import "../../app/agent/tool_recovery"
import "../../app/context/session_messages"

define live_group_finish with database as Int and run as Str and model as Str and port as Int returning Int:
    if agent_provider_bind(database and run and provider_llama_profile(model and port)) is not equal to 0:
        return 1
    set generation to 0
    repeat while 1 equals 1:
        set row to agent_run_read(database and run)
        set state to archive_list_text(row and 2)
        if state equals "completed":
            return 0
        if state equals "ready":
            set generation to generation + 1
            set messages to session_messages(database and archive_list_text(row and 0) and run)
            if string_length(messages) equals 0:
                return 2
            set body to session_request_body_owned(database and run and model and messages)
            if agent_generate_local(database and run and concat(run and concat(":generation:" and int_to_string(generation))) and body and port and "/v1/chat/completions" and -1 and 65536 and "0") is not equal to 0:
                return 3
        else if state equals "tools":
            if agent_tool_step(database and run) is not equal to 0:
                return 4
        else:
            display concat("Unexpected durable state: " and state)
            return 5
    return 6

define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "local" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 4
    set route to group_route(database and "a" and "g" and "local" and "server" and "room")
    set session to archive_list_text(route and 1)
    if web_attachment_register(database and "a" and session and "document" and get_argument(2) and "shared.txt" and "text/plain") is not equal to 0 or else web_attachment_register(database and "a" and session and "picture" and get_argument(3) and "shared.png" and "image/png") is not equal to 0:
        return 5
    set selected to ["document","picture"]
    set prompt to "Describe the left and right colours in the attached image. Also call attachment_read_text on attachment document, offset 0, characters 200, and include its exact marker in your answer. Keep the answer brief."
    if not (group_run_submit_attachments(database and "b" and "media" and session and "local" and "server" and "room" and prompt and selected) equals "accepted") or else not (group_run_submit_attachments(database and "b" and "media" and session and "local" and "server" and "room" and prompt and selected) equals "already-accepted"):
        return 6
    if not (group_run_submit(database and "b" and "media" and session and "local" and "server" and "room" and prompt) equals "submission-conflict") or else string_length(turn_attachment_manifest(database and "c" and session and "foreign" and selected)) is not equal to 0:
        return 7
    set messages to session_messages(database and session and "media")
    if string_contains(messages and "data:image/png;base64,") equals 0 or else string_contains(messages and "document:attachment") equals 0 or else string_contains(messages and "device:b") equals 0:
        return 8
    set listed to provider_json_tokens(attachment_tool_execute(database and session and "{\"after\":0}"))
    if not (provider_value(listed and provider_member(listed and 0 and "status")) equals "found"):
        return 9
    if live_group_finish(database and "media" and get_argument(5) and string_to_int(get_argument(4))) is not equal to 0:
        return 10
    set calls to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='media' AND json_extract(q.payload,'$.name')='attachment_read_text' AND json_extract(e.payload,'$.result.status')='found';"))
    if string_to_int(archive_list_text(calls and 1)) < 1:
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if string_contains(session_messages(database and session and "media") and "data:image/png;base64,") equals 0 or else not (archive_list_text(attachment_image_part(database and "foreign-session" and "picture") and 0) equals "not-found") or else sql_close(database) is not equal to 0:
        return 13
    display "PASS: shared text/image selection, immutable retry binding, outsider denial, multimodal context and actual local model text-tool completion; reopen retains original image. Inspect final colours and marker against the fixture."
    return 0
