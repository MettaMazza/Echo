import "../../app/hud/interface"
import "../../app/jobs/delegation_schema"

# Real immutable proposal storage; no protected deployment is performed.
define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["admin","guest"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Fixture") equals "recorded"):
        return 4
    set own to web_submit_owned(database and "admin" and "own" and "" and "Own rights")
    set other to web_submit_owned(database and "admin" and "other" and "" and "Separate rights")
    set guest to web_submit_owned(database and "guest" and "guest" and "" and "Guest")
    set view to hud_execute(database and "own" and "{\"section\":\"machine\",\"after\":0}")
    set tokens to provider_json_tokens(view)
    set data to provider_member(tokens and 0 and "data")
    set measurements to provider_member(tokens and data and "measurements")
    set memory to provider_member(tokens and measurements and "hw.memsize")
    if not (provider_value(tokens and provider_member(tokens and memory and "status")) equals "measured") or else string_to_int(provider_value(tokens and provider_member(tokens and memory and "value"))) < 1:
        display view
        return 5
    set activity to provider_member(tokens and data and "host_activity")
    set cpu to provider_member(tokens and activity and "cpu")
    set vm to provider_member(tokens and activity and "virtual_memory")
    set busy to string_to_int(provider_value(tokens and provider_member(tokens and cpu and "busy_basis_points")))
    if not (provider_value(tokens and provider_member(tokens and cpu and "status")) equals "measured") or else busy < 0 or else busy > 10000 or else not (provider_value(tokens and provider_member(tokens and vm and "status")) equals "measured"):
        display view
        return 13
    set disk to provider_member(tokens and data and "archive_filesystem")
    if not (provider_value(tokens and provider_member(tokens and disk and "status")) equals "measured") or else not (provider_value(tokens and provider_member(tokens and disk and "archive_path")) equals get_argument(1)):
        display view
        return 6
    set total to string_to_int(provider_value(tokens and provider_member(tokens and disk and "total_blocks")))
    set free to string_to_int(provider_value(tokens and provider_member(tokens and disk and "free_blocks")))
    set available to string_to_int(provider_value(tokens and provider_member(tokens and disk and "available_blocks")))
    if total < 1 or else free < 0 or else free > total or else available < 0 or else available > free:
        display view
        return 12
    if string_contains(hud_read(database and "own" and "machine" and 1) and "invalid-cursor") equals 0 or else string_contains(hud_read_for_device(database and "guest" and "own" and "machine" and 0) and "not-authorized") equals 0 or else string_contains(hud_read(database and "guest" and "machine" and 0) and "not-authorized") equals 0:
        return 7
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if string_contains(hud_machine_integer(library and "echo.fixture.nonexistent") and "unavailable") equals 0 or else string_contains(hud_machine_volume(library and "/echo-fixture-absent/volume") and "unavailable") equals 0:
        return 8
    display hud_machine_volume(library and "/Volumes/One Touch/Echo")
    set closed to ep_dlclose(library)
    display view
    if not (group_create(database and "admin" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "admin" and "invite" and "g" and "device:guest" and "invited" and 1) equals "recorded") or else not (group_change(database and "guest" and "join" and "g" and "device:guest" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "admin" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created") or else not (group_run_submit(database and "admin" and "shared-run" and "shared" and "browser" and "local" and "g" and "Mixed audience") equals "accepted"):
        return 9
    if string_contains(hud_read(database and "shared-run" and "machine" and 0) and "not-authorized") equals 0:
        return 10
    if not (principal_host_role(database and "demote" and "device:admin" and "user" and "Fixture demotion") equals "recorded") or else string_contains(hud_read_for_device(database and "admin" and "own" and "machine" and 0) and "not-authorized") equals 0:
        return 11
    display "PASS: real native memory and archive volume, unavailable failures, cursor rejection, guest/mixed-audience/demotion denial."
    return sql_close(database)
