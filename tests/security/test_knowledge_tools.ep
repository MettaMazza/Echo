import "../../app/web/attachments"
import "../../app/agent/tool_recovery"
import "../../app/agent/run_messages"
import "../fixtures/generation_fixture"

# Exercise the real streaming parser, durable queued request and dispatcher.
define knowledge_fixture_call with database as Int and run as Str and request as Str and call_id as Str and name as Str and arguments as Str returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and provider_quote(call_id))
    set delta to concat(delta and concat(",\"function\":{\"name\":" and provider_quote(name)))
    set delta to concat(delta and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}")))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set body to session_request_body_owned(database and run and "fixture" and agent_run_messages(database and run))
    if string_contains(body and "memory_record") equals 0 or else provider_json_tokens(body) equals 0:
        return 2
    set generated to agent_generate_local(database and run and request and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 3
    if agent_tool_step(database and run) is not equal to 0 or else agent_tool_step(database and run) is not equal to 0:
        return 4
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (knowledge_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set original to web_submit_owned(database and "owner" and "original" and "" and "I prefer tea.")
    set later to web_submit_owned(database and "owner" and "knowledge-run" and "" and "Retain my preference with its evidence")
    set source to history_collect_one(archive_prepare(database and "SELECT digest FROM echo_events WHERE event='original:user';"))
    set arguments to concat("{\"kind\":\"semantic\",\"subject\":\"user\",\"predicate\":\"prefers\",\"object\":\"tea\",\"evidence\":\"source-account\",\"source_event\":\"original:user\",\"source_digest\":" and provider_quote(archive_list_text(source and 1)))
    set arguments to concat(arguments and ",\"event_time\":\"\",\"valid_until\":\"\",\"supersedes\":\"\"}")
    if knowledge_fixture_call(database and "knowledge-run" and "record-request" and "record" and "memory_record" and arguments) is not equal to 0:
        return 4
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.identity') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='record' AND t.state='observed';"))
    if not (archive_list_text(result and 1) equals "recorded") or else string_length(archive_list_text(result and 2)) is not equal to 64:
        display archive_list_text(result and 1)
        return 5
    if knowledge_fixture_call(database and "knowledge-run" and "repeat-request" and "repeat" and "memory_record" and arguments) is not equal to 0:
        return 6
    set repeated to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.identity') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='repeat' AND t.state='observed';"))
    if not (archive_list_text(repeated and 1) equals "already-recorded") or else not (archive_list_text(repeated and 2) equals archive_list_text(result and 2)):
        return 7
    if knowledge_fixture_call(database and "knowledge-run" and "graph-request" and "graph" and "memory_graph" and "{\"node\":\"tea\",\"after\":0}") is not equal to 0:
        return 8
    set read to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.identity'),json_extract(e.payload,'$.result.object'),json_extract(e.payload,'$.result.source_event') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='graph' AND t.state='observed';"))
    if not (archive_list_text(read and 1) equals archive_list_text(result and 2)) or else not (archive_list_text(read and 2) equals "tea") or else not (archive_list_text(read and 3) equals "original:user"):
        return 9
    if knowledge_fixture_call(database and "knowledge-run" and "forged-request" and "forged" and "memory_graph" and "{\"node\":\"tea\",\"after\":0,\"principal\":\"another\"}") is not equal to 0:
        return 10
    set denied to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='forged';"))
    if not (archive_list_text(denied and 1) equals "invalid-arguments"):
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    display "PASS: streamed record, idempotent repeat and graph traversal archive exact provenance; caller-supplied principal is rejected."
    return 0
