import "../../app/rights/quarantine"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 3 or else string_contains(get_argument(1) and "quarantine-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set charter to get_argument(2)
    if database equals 0 or else not (protected_quarantine_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "q-invite") is not equal to 0 or else web_device_pair(database and "q-invite" and "q-steward" and "Quarantine fixture" and "q-secret") is not equal to 0 or else not (principal_host_role(database and "q-enrol" and "device:q-steward" and "steward" and "Disposable test") equals "recorded"):
        return 3
    set submitted to web_submit_owned(database and "q-steward" and "q-before" and "" and "Before quarantine")
    if not (archive_list_text(submitted and 0) equals "accepted") or else run_authority_allows(database and "q-before" and "steward") is not equal to 1:
        return 4
    set session to archive_list_text(submitted and 1)
    set payload to "{\"run_id\":\"direct-before\",\"call_id\":\"speak\",\"name\":\"speech_synthesize\",\"arguments\":\"{}\"}"
    if archive_append(database and session and "q-tool-request" and "tool_call" and payload and "fixture") is not equal to 0 or else tool_ledger_queue(database and "direct-before" and "speak" and session and "q-tool-request") is not equal to 0 or else tool_authority_allows(database and "direct-before" and "speak" and "user") is not equal to 1:
        return 5
    if not (protected_emergency_begin(database and charter and "q-secret" and "q-incident" and "local-node" and "quarantine" and "Fixture incident") equals "recorded"):
        return 6
    if node_admission_allows(database) is not equal to 0 or else run_authority_allows(database and "q-before" and "user") is not equal to 0 or else tool_authority_allows(database and "direct-before" and "speak" and "user") is not equal to 0:
        return 7
    set rejected to web_submit_owned(database and "q-steward" and "q-during" and "" and "During quarantine")
    if not (archive_list_text(rejected and 0) equals "node-quarantined") or else archive_read_event(database and "q-during:user") is not equal to 0:
        return 8
    set retried to web_submit_owned(database and "q-steward" and "q-before" and "" and "Before quarantine")
    if not (archive_list_text(retried and 0) equals "accepted") or else get_list(retried and 3) is not equal to 0:
        return 9
    if not (protected_quarantine_release(database and charter and "q-secret" and "q-incident" and "Recovered") equals "disclosure-required"):
        return 10
    if not (protected_emergency_disclose(database and charter and "q-secret" and "q-incident" and "Fixture incident" and "Admission disabled; no code changes" and "Quarantined" and "No stealth changes") equals "recorded") or else node_admission_allows(database) is not equal to 0:
        return 11
    if not (protected_quarantine_release(database and charter and "fixture-secret" and "q-incident" and "Recovered") equals "not-authorized") or else not (protected_quarantine_release(database and charter and "q-secret" and "q-incident" and "Recovered") equals "recorded"):
        return 12
    if node_admission_allows(database) is not equal to 1 or else run_authority_allows(database and "q-before" and "user") is not equal to 0 or else tool_authority_allows(database and "direct-before" and "speak" and "user") is not equal to 0:
        return 13
    set fresh to web_submit_owned(database and "q-steward" and "q-after" and "" and "After recovery")
    if not (archive_list_text(fresh and 0) equals "accepted") or else run_authority_allows(database and "q-after" and "steward") is not equal to 1:
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    if node_admission_allows(database) is not equal to 1 or else run_authority_allows(database and "q-before" and "user") is not equal to 0 or else not (protected_quarantine_release(database and charter and "q-secret" and "q-incident" and "Recovered") equals "already-recorded"):
        return 16
    if sql_close(database) is not equal to 0:
        return 17
    display "PASS: quarantine blocks new admission and existing run/direct-tool authority, preserves exact submission retries, requires authenticated disclosure before release, admits fresh work after release and never revives old authority across restart."
    return 0
