import "../../app/web/run_store"
import "../../app/security/device_links"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "Browser A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "Browser B" and "secret-b") is not equal to 0:
        return 3
    if not (principal_device_link_schema(database) equals "applied"):
        return 4
    set submitted to web_submit_owned(database and "a" and "source-a" and "" and "A private source")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 5
    if not (principal_host_role(database and "admin-a" and "device:a" and "admin" and "fixture") equals "recorded"):
        return 6
    if not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:a" and "fixture") equals "recorded") or else not (principal_role(database and principal_for_device(database and "b")) equals "admin"):
        return 7
    if web_device_session_allowed(database and "b" and "session:source-a") is not equal to 0 or else web_device_session_allowed(database and "a" and "session:source-a") is not equal to 1:
        return 8
    if not (principal_host_device_link(database and "stale" and "b" and "device:b" and "device:b" and "fixture") equals "device-binding-changed"):
        return 9
    if not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:a" and "fixture") equals "already-recorded") or else not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:b" and "fixture") equals "device-link-identity-conflict"):
        return 10
    if sql_execute(database and "CREATE TRIGGER reject_device_link BEFORE UPDATE ON echo_principal_devices BEGIN SELECT RAISE(ABORT,'fixture failure'); END;") is not equal to 0:
        return 11
    if not (principal_host_device_link(database and "unlink-b" and "b" and "device:a" and "device:b" and "fixture") equals "device-link-write-failed") or else not (principal_for_device(database and "b") equals "device:a"):
        return 12
    set row to history_collect_one(archive_prepare(database and "SELECT CAST(COUNT(*) AS TEXT) FROM echo_device_link_events WHERE identity='unlink-b';"))
    if not (archive_list_text(row and 1) equals "0") or else sql_execute(database and "DROP TRIGGER reject_device_link;") is not equal to 0:
        return 13
    if not (principal_host_device_link(database and "unlink-b" and "b" and "device:a" and "device:b" and "fixture") equals "recorded") or else not (principal_role(database and principal_for_device(database and "b")) equals "user"):
        return 14
    if not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:a" and "fixture") equals "already-recorded") or else not (principal_for_device(database and "b") equals "device:b"):
        return 15
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "fixture") equals "recorded") or else not (principal_host_device_link(database and "bad-link" and "b" and "device:b" and "device:a" and "fixture") equals "principal-unavailable"):
        return 16
    if web_device_revoke(database and "b") is not equal to 0 or else not (principal_host_device_link(database and "same-link" and "b" and "device:b" and "device:b" and "fixture") equals "recorded") or else not (web_device_authenticate(database and "secret-b") equals ""):
        return 17
    if sql_close(database) is not equal to 0:
        return 18
    set database to archive_open(get_argument(1))
    if not (principal_device_link_schema(database) equals "already-applied"):
        return 19
    set owner to history_collect_one(archive_prepare(database and "SELECT device FROM echo_session_owners WHERE session='session:source-a';"))
    if not (archive_list_text(owner and 1) equals "a") or else archive_verify(database and "session:source-a") is not equal to 0:
        return 20
    if sql_execute(database and "DELETE FROM echo_device_link_events;") equals 0:
        return 21
    if sql_close(database) is not equal to 0:
        return 22
    display "PASS: explicit device authority linking and unlinking preserve session ownership, reject stale changes, roll back failed writes and retain credential revocation."
    return 0
