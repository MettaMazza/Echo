import "../../app/tools/trace_tools"
import "../../app/web/run_store"

define trace_fixture with database as Int and session as Str and event as Str and reasoning as Str returning Int:
    set payload to concat("{\"run_id\":\"original\",\"parent_event\":\"request\",\"reasoning_content\":" and concat(provider_quote(reasoning) and "}"))
    return archive_append(database and session and event and "assistant_final" and payload and "fixture-time")

define trace_read_fixture with database as Int and run as Str and event as Str returning Str:
    return trace_execute(database and run and "trace_read" and concat("{\"view\":\"reasoning\",\"event\":" and concat(provider_quote(event) and ",\"offset\":0,\"characters\":200}")))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set first to web_submit_owned(database and "a" and "first" and "" and "First")
    set second to web_submit_owned(database and "a" and "second" and "" and "Second")
    set foreign to web_submit_owned(database and "b" and "foreign" and "" and "Foreign")
    if trace_fixture(database and archive_list_text(first and 1) and "reason-one" and "A🌍éZ TRACE_CANARY") is not equal to 0 or else trace_fixture(database and archive_list_text(first and 1) and "empty" and "") is not equal to 0:
        return 4
    set search to trace_execute(database and "second" and "trace_search" and "{\"view\":\"reasoning\",\"query\":\"TRACE_CANARY\",\"after\":0}")
    if string_contains(search and "reason-one") equals 0 or else string_contains(search and "TRACE_CANARY") is not equal to 0:
        display search
        return 5
    set found to provider_json_tokens(search)
    set through to provider_index(found and provider_member(found and 0 and "through"))
    set after to provider_value(found and provider_member(found and 0 and "next_after"))
    if trace_fixture(database and archive_list_text(first and 1) and "later" and "TRACE_CANARY later") is not equal to 0:
        return 6
    set continuation to concat("{\"view\":\"reasoning\",\"query\":\"TRACE_CANARY\",\"after\":" and concat(after and concat(",\"through\":" and concat(through and "}"))))
    if string_contains(trace_execute(database and "second" and "trace_search" and continuation) and "\"status\":\"end\"") equals 0:
        return 7
    set piece to trace_execute(database and "second" and "trace_read" and "{\"view\":\"reasoning\",\"event\":\"reason-one\",\"offset\":1,\"characters\":2}")
    if string_contains(piece and "🌍é") equals 0 or else string_contains(piece and "\"next_offset\":3") equals 0 or else string_contains(piece and "model-emitted-reasoning") equals 0:
        display piece
        return 8
    if string_contains(trace_read_fixture(database and "second" and "empty") and "no-reasoning-emitted-or-retained") equals 0:
        return 9
    if string_contains(trace_read_fixture(database and "foreign" and "reason-one") and "not-found") equals 0:
        return 10
    if string_contains(trace_execute(database and "foreign" and "trace_search" and "{\"view\":\"reasoning\",\"query\":\"TRACE_CANARY\",\"after\":0}") and "\"status\":\"end\"") equals 0:
        return 11
    if not (group_create(database and "a" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "a" and "invite-b" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created"):
        return 12
    if not (group_run_submit(database and "b" and "group-run" and "shared" and "browser" and "local" and "g" and "Shared") equals "accepted"):
        return 13
    if trace_fixture(database and "shared" and "group-reason" and "SHARED_CANARY") is not equal to 0:
        return 14
    if string_contains(trace_read_fixture(database and "group-run" and "group-reason") and "SHARED_CANARY") equals 0 or else string_contains(trace_read_fixture(database and "group-run" and "reason-one") and "not-found") equals 0 or else string_contains(trace_read_fixture(database and "second" and "group-reason") and "not-found") equals 0:
        return 15
    if not (group_change(database and "a" and "remove-b" and "g" and "device:b" and "removed" and 3) equals "recorded") or else string_contains(trace_read_fixture(database and "group-run" and "group-reason") and "not-authorized") equals 0:
        return 16
    if web_device_revoke(database and "a") is not equal to 0 or else string_contains(trace_read_fixture(database and "second" and "reason-one") and "not-authorized") equals 0:
        return 17
    display "PASS: chronological bounded trace search, exact Unicode reasoning, explicit empty capture, private cross-session reads, foreign/group isolation and revoked membership/device denial."
    return sql_close(database)
