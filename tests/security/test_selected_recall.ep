import "../../app/web/attachments"
import "../../app/memory/context_snapshot"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    if web_pairing_invite(database and "foreign") is not equal to 0 or else web_device_pair(database and "foreign" and "outsider" and "Foreign" and "other-secret") is not equal to 0:
        return 4
    set original to web_submit_owned(database and "owner" and "original" and "" and "I prefer direct language. Quartz experiment: the blue sample weighed 73 grams.")
    set foreign to web_submit_owned(database and "outsider" and "foreign" and "" and "Quartz private-canary-must-stay-private")
    set source to archive_read_event(database and "original:user")
    if string_index_of(knowledge_record(database and "original" and "semantic" and "owner" and "preference" and "I prefer direct language." and "source-account" and "original:user" and archive_list_text(source and 6) and "" and "" and "") and "recorded:") is not equal to 0:
        return 5
    if string_index_of(knowledge_record(database and "original" and "episodic" and "owner" and "experience" and "Quartz experiment: the blue sample weighed 73 grams." and "source-account" and "original:user" and archive_list_text(source and 6) and "" and "" and "") and "recorded:") is not equal to 0:
        return 6
    set greeting to web_submit_owned(database and "owner" and "greeting" and "" and "Good evening Echo, how are you?")
    set prepared to memory_semantic_prepare(database and "greeting")
    if prepared is not equal to 0:
        return 13
    set context to memory_context(database and "greeting")
    if string_contains(context and "I prefer direct language.") equals 0 or else string_contains(context and "73 grams") equals 1 or else string_contains(context and "private-canary") equals 1:
        return 7
    # A warm indexing pass must preserve exactly the same selected source text.
    set indexed_before to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_recall_indexed;"))
    if memory_semantic_prepare(database and "greeting") is not equal to 0 or else not (memory_context(database and "greeting") equals context):
        return 14
    set indexed_after to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_recall_indexed;"))
    if not (archive_list_text(indexed_before and 1) equals archive_list_text(indexed_after and 1)):
        return 15
    set topic to web_submit_owned(database and "owner" and "topic" and "" and "How heavy was the mineral specimen?")
    set prepared to memory_semantic_prepare(database and "topic")
    set context to memory_context(database and "topic")
    if string_contains(context and "73 grams") equals 0 or else string_contains(context and "private-canary") equals 1:
        return 9
    set original_read to memory_archive_read(database and "greeting" and "original:user" and 0 and 1000)
    if not (archive_list_text(original_read and 0) equals "found"):
        return 10
    if memory_context_capture(database and "greeting") is not equal to 0 or else not (memory_context_stable(database and "greeting") equals memory_context(database and "greeting")):
        return 11
    if archive_verify(database and archive_list_text(original and 1)) is not equal to 0:
        return 12
    display "PASS: greeting retains preferences without unrelated episodes or pending originals; topic retrieves exact episode; foreign records excluded; omitted original remains readable; snapshot stable and archive intact."
    return sql_close(database)
