import "../../app/web/groups"
import "../../app/security/group_output_policy"
import "../../app/web/run_store"
import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_output_schema(database) equals "applied"):
        return 2
    for each device in ["a","b","guest"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (admin_silo_create(database and "guest" and "forged" and "browser" and "local" and "admin-room") equals "admin-scope-not-authorized"):
        return 4
    for each device in ["a","b"]:
        if not (principal_host_role(database and concat("grant-" and device) and concat("device:" and device) and "admin" and "fixture") equals "recorded"):
            return 5
    if not (web_group_manage(database and "a" and "create" and provider_json_tokens("{\"group\":\"admin-room\",\"access\":\"admin\"}")) equals "{\"status\":\"created\"}"):
        return 6
    if not (group_change(database and "a" and "invite-guest" and "admin-room" and "device:guest" and "invited" and 1) equals "admin-scope-not-authorized"):
        return 7
    if not (group_change(database and "a" and "invite-b" and "admin-room" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join-b" and "admin-room" and "device:b" and "joined" and 2) equals "recorded"):
        return 8
    set submitted to group_route_submit(database and "a" and "admin-room" and "browser" and "local" and "admin-room" and "one" and "ADMIN_CONTEXT_CANARY")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 9
    set session to archive_list_text(submitted and 1)
    if group_session_allows(database and "b" and session and "browser" and "local" and "admin-room" and 0) is not equal to 1 or else string_contains(session_messages(database and session and "one") and "ADMIN_CONTEXT_CANARY") equals 0:
        return 10
    if not (principal_host_role(database and "demote" and "device:a" and "user" and "fixture") equals "recorded"):
        return 11
    if group_session_allows(database and "a" and session and "browser" and "local" and "admin-room" and 0) is not equal to 0 or else group_run_session_allows(database and "one" and session) is not equal to 0:
        return 12
    set values to [session,"a"]
    set query to concat("SELECT 1 WHERE " and group_device_session_sql(database and "?1" and "?2"))
    if not (archive_list_text(history_collect_one(checkpoint_prepare(database and query and values)) and 0) equals "end"):
        return 13
    if group_session_allows(database and "b" and session and "browser" and "local" and "admin-room" and 0) is not equal to 1:
        return 14
    if string_contains(web_group_list(database and "a") and "admin-room") is not equal to 0 or else string_contains(web_group_list(database and "b") and "admin-room") equals 0:
        return 16
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if group_session_allows(database and "a" and session and "browser" and "local" and "admin-room" and 0) is not equal to 0:
        return 15
    display "PASS: explicit admin audience, guest creation/invitation denial, shared admin context, demotion blocks history/run/workspace scope, remaining admin and restart."
    return sql_close(database)
