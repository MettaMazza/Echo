import "../../app/rights/files"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set charter to get_argument(1)
    set root to get_argument(2)
    set target to concat(root and "/before.bin")
    set candidate to concat(root and "/candidate.bin")
    set inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(target) and ",\"category\":\"agency\"}]}"))
    set inventory_digest to ep_sha256(inventory)
    set manifest to protected_inventory_manifest(charter and inventory and inventory_digest and target and get_argument(3) and get_argument(4) and "Replace binary fixture only; preserve exact original for recovery.")
    if not (protected_file_check(charter and inventory and inventory_digest and manifest and candidate) equals "bytes-match"):
        return 2
    if not (protected_file_check(charter and inventory and inventory_digest and manifest and concat(root and "/wrong.bin")) equals "candidate-mismatch"):
        return 3
    if not (protected_file_check(charter and inventory and inventory_digest and manifest and target) equals "invalid-candidate-path") or else not (protected_file_check(charter and inventory and inventory_digest and manifest and concat(root and "/../candidate.bin")) equals "invalid-candidate-path"):
        return 4
    if not (protected_file_check(charter and inventory and inventory_digest and manifest and concat(root and "/candidate-link")) equals "candidate-unreadable") or else not (protected_file_check(charter and inventory and inventory_digest and manifest and concat(root and "/pipe")) equals "candidate-unreadable") or else not (protected_file_check(charter and inventory and inventory_digest and manifest and concat(root and "/directory")) equals "candidate-unreadable"):
        return 5
    set changed to protected_inventory_manifest(charter and inventory and inventory_digest and target and ep_sha256("other original") and get_argument(4) and "Incorrect original hash")
    if not (protected_file_check(charter and inventory and inventory_digest and changed and candidate) equals "target-changed"):
        return 6
    if not (protected_file_check(charter and inventory and ep_sha256("wrong inventory") and manifest and candidate) equals "inventory-or-manifest-mismatch"):
        return 7
    set linked_target to concat(root and "/candidate-link")
    set linked_inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(linked_target) and ",\"category\":\"agency\"}]}"))
    set linked_manifest to protected_inventory_manifest(charter and linked_inventory and ep_sha256(linked_inventory) and linked_target and get_argument(4) and get_argument(3) and "A symlink is not a valid deployment target")
    if not (protected_file_check(charter and linked_inventory and ep_sha256(linked_inventory) and linked_manifest and target) equals "target-unreadable"):
        return 9
    # Existing original remains unchanged after all positive and rejected checks.
    set final_digest to file_digest_durable(target and 1)
    if not (archive_list_text(final_digest and 1) equals get_argument(3)):
        return 8
    display "PASS: complete binary target/candidate hashes, changed original, wrong candidate, inventory mismatch, same target/candidate path, traversal, target/candidate symlink, FIFO and directory checks. Original preserved; read-only preflight grants no deployment authority."
    return 0
