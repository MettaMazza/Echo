import "../../app/rights/operation_prepare"

# Run on a consistent copy containing the completed live review decision only.
define main returning Int:
    if get_argument_count() is not equal to 4 or else string_contains(get_argument(1) and "deployment-review-fixture") equals 0 or else string_contains(get_argument(3) and "deployment-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    set review to protected_review_latest(database and "rights-live" and "live-proposal")
    if not (archive_list_text(review and 0) equals "found"):
        return 2
    set decision to provider_json_tokens(archive_list_text(review and 2))
    if not (provider_value(decision and provider_member(decision and 0 and "decision")) equals "consent"):
        display "Live model did not consent; no authorization or preparation performed."
        return 3
    if not (protected_steward_schema(database) equals "applied"):
        return 4
    set target to concat(get_argument(3) and "/runtime.bin")
    set recovery to concat(get_argument(3) and "/recovery.bin")
    set inventory to concat("{\"version\":1,\"targets\":[{\"path\":" and concat(provider_quote(target) and ",\"category\":\"agency\"}]}"))
    set before to file_digest_durable(target and 65536)
    if not (protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-operation" and inventory and ep_sha256(inventory) and get_argument(3) and "runtime.bin" and "candidate.bin" and recovery and "" and "" and "") equals "steward-decision-missing"):
        return 5
    if web_pairing_invite(database and "operation-invite") is not equal to 0 or else web_device_pair(database and "operation-invite" and "steward" and "Operation test steward" and "steward-secret") is not equal to 0 or else not (principal_host_role(database and "operation-enrol" and "device:steward" and "steward" and "Disposable test enrolment") equals "recorded"):
        return 6
    set proposal to protected_proposal_read(database and "rights-live" and "live-proposal")
    if not (protected_steward_decide(database and "steward-secret" and "operation-approval" and "live-proposal" and archive_list_text(proposal and 2) and 1 and 0 and "authorize" and "Approve only the exact disposable test change") equals "recorded"):
        return 7
    if not (protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-operation" and inventory and ep_sha256(inventory) and get_argument(3) and "runtime.bin" and "candidate.bin" and concat(get_argument(3) and "/missing-recovery.bin") and "" and "" and "") equals "operation-files-invalid"):
        return 8
    set copied to protected_stage_copy(target and recovery and archive_list_text(before and 1))
    if not (copied equals "staged" or else copied equals "already-staged"):
        return 9
    set first to protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-operation" and inventory and ep_sha256(inventory) and get_argument(3) and "runtime.bin" and "candidate.bin" and recovery and "" and "" and "")
    display first
    if not (first equals "prepared"):
        return 10
    if not (protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-operation" and inventory and ep_sha256(inventory) and get_argument(3) and "runtime.bin" and "candidate.bin" and recovery and "" and "" and "") equals "already-prepared"):
        return 11
    if not (protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-operation" and inventory and ep_sha256("wrong") and get_argument(3) and "runtime.bin" and "candidate.bin" and recovery and "" and "" and "") equals "inventory-or-manifest-mismatch"):
        return 12
    set other to concat(get_argument(3) and "/other-recovery.bin")
    set copied to protected_stage_copy(target and other and archive_list_text(before and 1))
    if not (copied equals "staged" or else copied equals "already-staged") or else not (protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-operation" and inventory and ep_sha256(inventory) and get_argument(3) and "runtime.bin" and "candidate.bin" and other and "" and "" and "") equals "operation-identity-conflict"):
        return 13
    set corrupt to concat(get_argument(3) and "/corrupt-recovery.bin")
    set written to write_file(corrupt and "Wrong recovery bytes")
    if not (protected_operation_prepare(database and get_argument(2) and "rights-live" and "live-proposal" and "fixture-corrupt-recovery" and inventory and ep_sha256(inventory) and get_argument(3) and "runtime.bin" and "candidate.bin" and corrupt and "" and "" and "") equals "recovery-unverified"):
        return 16
    set stored to archive_read_event(database and concat(protected_operation_session("fixture-operation") and ":prepared"))
    if stored equals 0 or else archive_verify(database and protected_operation_session("fixture-operation")) is not equal to 0:
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    set reopened to archive_read_event(database and concat(protected_operation_session("fixture-operation") and ":prepared"))
    if reopened equals 0 or else not (archive_list_text(reopened and 3) equals archive_list_text(stored and 3)) or else archive_verify(database and protected_operation_session("fixture-operation")) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 17
    display "PASS: actual model consent plus synthetic steward, exact inventory/manifest, verified independent recovery, durable prepared record, retry and identity conflict. Targets remain unchanged; publication not invoked."
    return 0
