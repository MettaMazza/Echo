import "../../app/web/run_store"
import "../../app/memory/session_ownership"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (tool_authority_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    set a to web_submit_owned(database and "a" and "old-a" and "" and "Private A history")
    set b to web_submit_owned(database and "b" and "old-b" and "" and "Private B history")
    if not (archive_list_text(a and 0) equals "accepted") or else not (archive_list_text(b and 0) equals "accepted"):
        return 4
    if not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:a" and "fixture") equals "recorded") or else not (session_principal_schema(database) equals "applied"):
        return 5
    if session_principal_allows(database and "a" and archive_list_text(a and 1)) is not equal to 1 or else session_principal_allows(database and "a" and archive_list_text(b and 1)) is not equal to 0 or else session_principal_allows(database and "b" and archive_list_text(b and 1)) is not equal to 0:
        return 6
    set fresh to web_submit_owned(database and "b" and "new-linked-b" and "" and "New conversation by linked principal A")
    if not (archive_list_text(fresh and 0) equals "accepted") or else session_principal_allows(database and "a" and archive_list_text(fresh and 1)) is not equal to 1:
        return 7
    if not (principal_host_device_link(database and "unlink-b" and "b" and "device:a" and "device:b" and "fixture") equals "recorded") or else session_principal_allows(database and "b" and archive_list_text(b and 1)) is not equal to 1 or else session_principal_allows(database and "b" and archive_list_text(fresh and 1)) is not equal to 0:
        return 8
    if not (principal_host_role(database and "grant-admin-b" and "device:b" and "admin" and "fixture") equals "recorded") or else session_principal_allows(database and "b" and archive_list_text(a and 1)) is not equal to 0:
        return 9
    if sql_execute(database and "UPDATE echo_session_principals SET principal='device:b';") equals 0 or else sql_execute(database and "DELETE FROM echo_session_principals;") equals 0:
        return 10
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "fixture") equals "recorded") or else session_principal_allows(database and "a" and archive_list_text(a and 1)) is not equal to 0:
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if not (session_principal_schema(database) equals "already-applied") or else session_principal_allows(database and "b" and archive_list_text(b and 1)) is not equal to 1 or else session_principal_allows(database and "b" and archive_list_text(fresh and 1)) is not equal to 0:
        return 13
    if sql_close(database) is not equal to 0:
        return 14
    display "PASS: private session principals survive account relinking, migration, admin grants, revocation and reopen without transferring original history."
    return 0
