import "../../app/hud/interface"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["admin","guest"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Fixture") equals "recorded"):
        return 4
    set own to web_submit_owned(database and "admin" and "own" and "" and "Inspect owned research")
    set guest to web_submit_owned(database and "guest" and "guest" and "" and "Guest")
    set configured to set_env("ECHO_RESEARCH_CATALOG" and get_argument(2))
    set original to file_read(get_argument(2))
    set configured to set_env("ECHO_RESEARCH_CATALOG_SHA256" and ep_sha256(original))
    set view to hud_execute(database and "own" and "{\"section\":\"research\",\"after\":0}")
    if string_contains(view and "owned-experiment") equals 0 or else string_contains(view and "foreign-experiment") is not equal to 0 or else string_contains(view and "retained experiment evidence") equals 0:
        display view
        return 5
    set next to hud_read(database and "own" and "research" and 1)
    if string_contains(next and "second-owned-experiment") equals 0 or else string_contains(hud_read(database and "own" and "research" and 2) and "\"status\":\"end\"") equals 0:
        return 6
    if string_contains(hud_read(database and "guest" and "research" and 0) and "not-authorized") equals 0 or else string_contains(hud_read_for_device(database and "guest" and "own" and "research" and 0) and "not-authorized") equals 0:
        return 7
    if not (principal_host_role(database and "grant-other" and "device:guest" and "admin" and "Foreign admin fixture") equals "recorded"):
        return 8
    set foreign to web_submit_owned(database and "guest" and "foreign" and "" and "Other owner's research")
    set view to hud_read(database and "foreign" and "research" and 0)
    if string_contains(view and "foreign-experiment") equals 0 or else string_contains(view and "owned-experiment") is not equal to 0:
        return 9
    if not (group_create(database and "admin" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "admin" and "invite" and "g" and "device:guest" and "invited" and 1) equals "recorded") or else not (group_change(database and "guest" and "join" and "g" and "device:guest" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "admin" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created") or else not (group_run_submit(database and "admin" and "shared-run" and "shared" and "browser" and "local" and "g" and "Two administrators") equals "accepted"):
        return 10
    if string_contains(hud_read(database and "shared-run" and "research" and 0) and "not-authorized") equals 0:
        return 11
    set changed to ptr_to_str(string_replace(original and "owned-experiment" and "tampered-experiment"))
    if string_contains(hud_research_catalog(changed and "device:admin" and 0) and "research-record-integrity-failed") equals 0:
        return 12
    set configured to set_env("ECHO_RESEARCH_CATALOG_SHA256" and ep_sha256("wrong hash"))
    if string_contains(hud_read(database and "own" and "research" and 0) and "research-catalog-changed") equals 0:
        return 13
    set configured to set_env("ECHO_RESEARCH_CATALOG_SHA256" and ep_sha256(original))
    if not (principal_host_revocation(database and "revoke" and "device:admin" and 1 and "Fixture revocation") equals "recorded") or else string_contains(hud_read(database and "own" and "research" and 0) and "not-authorized") equals 0:
        return 14
    display "PASS: real pinned catalogue read, owner pagination, foreign-admin separation, guest/shared-admin/revoked denial, changed-record and changed-catalogue rejection."
    return sql_close(database)
