import "../../app/web/uploads"
import "../../app/web/cancellation"
import "../../app/web/message_speech"
import "../../app/memory/session_ownership"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_upload_schema(database) is not equal to 0 or else web_cancel_schema(database) is not equal to 0 or else not (session_principal_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    set original to web_submit_owned(database and "b" and "private-b" and "" and "Private B history")
    set session to archive_list_text(original and 1)
    set upload to web_upload_prepare(database and "b" and session and "/tmp" and "private.txt" and "text/plain")
    if string_length(upload) equals 0:
        return 4
    # Metadata fixture; no host file is opened by these ownership queries.
    if sql_execute(database and "INSERT INTO echo_attachments VALUES('private-file','session:private-b','/tmp/nonexistent-private-scope-fixture','private.txt','text/plain','fixture-digest',0,'private-b:user');") is not equal to 0:
        return 5
    if archive_append(database and session and "private-final" and "assistant_final" and "{\"content\":\"Private reply\"}" and "fixture") is not equal to 0:
        return 6
    if web_device_session_allowed(database and "b" and session) is not equal to 1 or else web_device_run_allowed(database and "b" and "private-b") is not equal to 1 or else not (archive_list_text(web_attachment_owned(database and "b" and "private-file") and 0) equals "found") or else not (archive_list_text(web_upload_owned(database and "b" and upload) and 0) equals "found"):
        return 7
    if string_contains(web_device_sessions(database and "b") and session) equals 0 or else string_contains(web_attachment_list(database and "b" and session) and "private-file") equals 0:
        return 8
    if not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:a" and "fixture") equals "recorded"):
        return 9
    if web_device_session_allowed(database and "b" and session) is not equal to 0 or else web_device_run_allowed(database and "b" and "private-b") is not equal to 0 or else principal_session_active(database and session) is not equal to 0:
        return 10
    if not (archive_list_text(web_attachment_owned(database and "b" and "private-file") and 0) equals "end") or else not (archive_list_text(web_upload_owned(database and "b" and upload) and 0) equals "end"):
        return 11
    if string_contains(web_device_sessions(database and "b") and session) is not equal to 0 or else string_contains(web_attachment_list(database and "b" and session) and "private-file") is not equal to 0:
        return 12
    if workspace_session_allowed(database and "b" and session) is not equal to 0:
        return 18
    if string_contains(attachment_tool_execute(database and session and "{\"after\":0}") and "private-file") is not equal to 0:
        return 19
    if not (archive_list_text(attachment_image_part(database and session and "private-file") and 0) equals "not-found"):
        return 20
    if web_upload_claim(database and "b" and upload) equals 0 or else web_cancel_request(database and "b" and "private-b") equals 0:
        return 13
    if not (web_message_speak(database and "b" and "private-final") equals "{\"status\":\"not-found\"}"):
        return 14
    if not (principal_host_device_link(database and "unlink-b" and "b" and "device:a" and "device:b" and "fixture") equals "recorded"):
        return 15
    if web_device_session_allowed(database and "b" and session) is not equal to 1 or else web_upload_claim(database and "b" and upload) is not equal to 0 or else web_cancel_request(database and "b" and "private-b") is not equal to 0:
        return 16
    if sql_close(database) is not equal to 0:
        return 17
    display "PASS: relinking cannot expose original sessions, runs, attachment metadata, uploads or speech, or claim uploads and cancel another principal's run; unlink restores original source ownership."
    return 0
