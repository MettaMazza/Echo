import "../../app/web/run_store"
import "../../app/memory/knowledge_lifecycle"
import "../../app/archive/snapshot"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    set a to web_submit_owned(database and "a" and "a-run" and "" and "My preferred drink is tea.")
    set b to web_submit_owned(database and "b" and "b-run" and "" and "Separate user")
    set source to history_collect_one(archive_prepare(database and "SELECT digest FROM echo_events WHERE event='a-run:user';"))
    set recorded to knowledge_record(database and "a-run" and "semantic" and "user" and "prefers" and "tea" and "source-account" and "a-run:user" and archive_list_text(source and 1) and "" and "" and "")
    set found to knowledge_next(database and "a-run" and "tea" and 0)
    if not (archive_list_text(found and 0) equals "found"):
        return 4
    set identity to archive_list_text(found and 1)
    if not (knowledge_visibility_set(database and "b-run" and "foreign" and identity and 0 and "forgotten" and "foreign") equals "source-not-found"):
        return 5
    if not (knowledge_visibility_set(database and "a-run" and "forget-1" and identity and 0 and "forgotten" and "User requested withdrawal") equals "recorded"):
        return 6
    if not (archive_list_text(knowledge_next(database and "a-run" and "tea" and 0) and 0) equals "end"):
        return 7
    # Original evidence remains explicitly retrievable; derived recall excludes it.
    if not (archive_list_text(memory_archive_read(database and "a-run" and "a-run:user" and 0 and 100) and 0) equals "found"):
        return 8
    set repeated to knowledge_record(database and "a-run" and "semantic" and "user" and "prefers" and "tea" and "source-account" and "a-run:user" and archive_list_text(source and 1) and "" and "" and "")
    if not (repeated equals concat("already-" and recorded)) or else not (archive_list_text(knowledge_next(database and "a-run" and "tea" and 0) and 0) equals "end"):
        return 9
    set state to knowledge_visibility_read(database and "a-run" and identity)
    set revision to string_to_int(archive_list_text(state and 2))
    if not (archive_list_text(state and 1) equals "forgotten") or else revision < 1:
        return 10
    if not (knowledge_visibility_set(database and "a-run" and "restore-stale" and identity and 0 and "visible" and "Stale decision") equals "revision-conflict"):
        return 11
    if not (knowledge_visibility_set(database and "a-run" and "restore-1" and identity and revision and "visible" and "User restored this assertion") equals "recorded"):
        return 12
    if not (knowledge_visibility_set(database and "a-run" and "forget-1" and identity and 0 and "forgotten" and "User requested withdrawal") equals "already-recorded") or else not (archive_list_text(knowledge_next(database and "a-run" and "tea" and 0) and 0) equals "found"):
        return 13
    if sql_execute(database and "UPDATE echo_memory_visibility SET state='forgotten';") equals 0:
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    set state to knowledge_visibility_read(database and "a-run" and identity)
    if not (archive_list_text(state and 1) equals "visible"):
        return 16
    set revision to string_to_int(archive_list_text(state and 2))
    if not (knowledge_visibility_set(database and "a-run" and "forget-2" and identity and revision and "forgotten" and "Withdraw again") equals "recorded"):
        return 17
    set backup to concat(get_argument(1) and ".backup")
    set restored_path to concat(get_argument(1) and ".restored")
    if archive_snapshot(database and backup) is not equal to 0 or else archive_restore(backup and restored_path) is not equal to 0:
        return 20
    set restored to archive_open(restored_path)
    if restored equals 0 or else not (archive_list_text(knowledge_next(restored and "a-run" and "tea" and 0) and 0) equals "end"):
        return 21
    set restored_state to knowledge_visibility_read(restored and "a-run" and identity)
    if not (archive_list_text(restored_state and 1) equals "forgotten") or else not (archive_list_text(memory_archive_read(restored and "a-run" and "a-run:user" and 0 and 100) and 0) equals "found"):
        return 22
    set fresh to web_submit_owned(restored and "a" and "restored-chat" and "" and "Inspect my restored memory")
    if not (knowledge_visibility_set(restored and "restored-chat" and "restored-visible" and identity and string_to_int(archive_list_text(restored_state and 2)) and "visible" and "Explicit restoration after backup recovery") equals "recorded") or else not (archive_list_text(knowledge_next(restored and "restored-chat" and "tea" and 0) and 0) equals "found"):
        return 23
    if not (archive_list_text(knowledge_next(restored and "b-run" and "tea" and 0) and 0) equals "end") or else sql_close(restored) is not equal to 0:
        return 24
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture") equals "recorded") or else not (knowledge_visibility_set(database and "a-run" and "denied" and identity and revision and "visible" and "Revoked") equals "not-authorized"):
        return 18
    if sql_close(database) is not equal to 0:
        return 19
    display "PASS: derived forgetting/restoration preserve sources, resist foreign writes and stale decisions, survive restart and independent database restore, and do not revive through exact re-extraction or replay."
    return 0
