import "../../app/web/export"
import "../../app/security/group_output_policy"
import "../../app/web/attachments"
import "../../app/agent/tool_recovery"
import "../../app/agent/run_messages"
import "../../app/context/recap_sources"
import "../fixtures/generation_fixture"

define audience_fixture_run with database as Int and identity as Str and path as Str returning Int:
    if not (group_create(database and "a" and identity and "discord" and "server" and "room" and identity) equals "created") or else not (group_change(database and "a" and concat(identity and ":invite") and identity and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and concat(identity and ":join") and identity and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and identity and identity and "discord" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "a" and identity and identity and "discord" and "server" and "room" and "Read the fixture host file for this group.") equals "accepted"):
        return 1
    set listener to local_socket_listen(0)
    set arguments to concat("{\"program\":\"/bin/cat\",\"arguments\":[" and concat(provider_quote(path) and "]}"))
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"read-host\",\"function\":{\"name\":\"host_execute\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and identity and concat(identity and ":generation") and session_request_body_owned(database and identity and "fixture" and agent_run_messages(database and identity)) and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    if generated is not equal to 0 or else served is not equal to 0:
        return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_output_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else audience_fixture_run(database and "public-source" and get_argument(2)) is not equal to 0:
        return 4
    if group_privileged_audience_allows(database and "public-source") is not equal to 0 or else tool_policy_allows(database and "public-source" and "read-host" and "host_execute") is not equal to 1:
        return 5
    if agent_tool_step(database and "public-source") is not equal to 0:
        return 6
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.wait_status'),json_extract(e.payload,'$.result.audience') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='public-source';"))
    if not (archive_list_text(result and 1) equals "complete") or else not (archive_list_text(result and 2) equals "0") or else not (archive_list_text(result and 3) equals "public-system"):
        return 7
    if group_history_allows(database and "public-source") is not equal to 1 or else string_length(session_messages_snapshot(database and "public-source" and "public-source")) equals 0:
        return 8
    set root to ptr_to_str(get_env("ECHO_PUBLIC_SOURCE_ROOT"))
    for each path in [concat(root and "/private.txt"),concat(root and "/app/../secret.ep"),concat(root and "/app/config.json"),concat(root and "/app/.env"),concat(root and "-other/app/source.ep")]:
        if host_public_source_path(path) is not equal to 0:
            return 9
    if audience_fixture_run(database and "revoked" and get_argument(2)) is not equal to 0 or else not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "Fixture") equals "recorded"):
        return 10
    if tool_policy_allows(database and "revoked" and "read-host" and "host_execute") is not equal to 0:
        return 11
    display "PASS: public Discord admin executes system command through scoped sandbox, result stays readable, revoked admin remains denied."
    return sql_close(database)
