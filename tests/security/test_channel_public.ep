import "../../app/security/channel_public"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["echo","a","b"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    set scope to channel_public_register(database and "echo" and "discord" and "server" and "room")
    set other to channel_public_register(database and "echo" and "discord" and "other-server" and "room")
    if string_length(scope) equals 0 or else scope equals other or else not (channel_public_observe(database and "a" and scope and "forged" and "a" and "forged" and "now") equals "connector-not-authorized"):
        return 4
    if not (channel_public_observe(database and "echo" and scope and "old" and "external:a" and "OLDER_PUBLIC" and "t1") equals "recorded") or else not (channel_public_access(database and "echo" and scope and "a" and "view-a" and 1 and 0) equals "recorded"):
        return 5
    if not (archive_list_text(channel_public_next(database and "a" and scope and 0) and 0) equals "end"):
        return 6
    if not (channel_public_observe(database and "echo" and scope and "new" and "external:b" and "NEW_PUBLIC" and "t2") equals "recorded"):
        return 7
    set row to channel_public_next(database and "a" and scope and 0)
    if not (archive_list_text(row and 0) equals "found") or else not (archive_list_text(row and 4) equals "NEW_PUBLIC"):
        return 8
    if not (channel_public_access(database and "echo" and scope and "a" and "refresh-a" and 1 and 0) equals "recorded") or else not (archive_list_text(channel_public_next(database and "a" and scope and 0) and 4) equals "NEW_PUBLIC"):
        return 9
    if not (archive_list_text(channel_public_next(database and "b" and scope and 0) and 0) equals "end") or else not (archive_list_text(channel_public_next(database and "a" and other and 0) and 0) equals "end"):
        return 10
    if not (channel_public_access(database and "echo" and scope and "b" and "history-b" and 1 and 1) equals "recorded") or else not (archive_list_text(channel_public_next(database and "b" and scope and 0) and 4) equals "OLDER_PUBLIC"):
        return 11
    if not (channel_public_access(database and "echo" and scope and "b" and "revoke-b" and 0 and 0) equals "recorded") or else not (archive_list_text(channel_public_next(database and "b" and scope and 0) and 0) equals "end"):
        return 12
    if not (channel_public_access(database and "echo" and scope and "b" and "rejoin-b" and 1 and 0) equals "recorded") or else not (archive_list_text(channel_public_next(database and "b" and scope and 0) and 0) equals "end"):
        return 13
    if not (channel_public_observe(database and "echo" and scope and "new" and "external:b" and "NEW_PUBLIC" and "t2") equals "already-recorded") or else not (channel_public_observe(database and "echo" and scope and "new" and "external:b" and "changed" and "t2") equals "source-identity-conflict"):
        return 14
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    if not (channel_public_access(database and "echo" and scope and "b" and "history-b" and 1 and 1) equals "already-recorded") or else not (archive_list_text(channel_public_next(database and "b" and scope and 0) and 0) equals "end"):
        return 15
    if web_device_revoke(database and "a") is not equal to 0 or else not (archive_list_text(channel_public_next(database and "a" and scope and 0) and 0) equals "not-authorized"):
        return 16
    display "PASS: source provenance/replay, verified-connector boundary, channel/server isolation, live-only versus historical permissions, continuous-access floor, revocation/rejoin, stale grant retry and restart."
    return sql_close(database)
