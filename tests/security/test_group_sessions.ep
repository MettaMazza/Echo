import "../../app/security/group_sessions"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_session_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b", "c"]:
        set text to ptr_to_str(name)
        if web_pairing_invite(database and text) is not equal to 0 or else web_device_pair(database and text and text and text and concat(text and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "discord" and "server" and "room" and "origin") equals "created"):
        return 4
    set private to web_submit_owned(database and "a" and "private-run" and "" and "Private original")
    if not (archive_list_text(private and 0) equals "accepted"):
        return 5
    if not (group_session_create(database and "a" and archive_list_text(private and 1) and "g" and "discord" and "server" and "room" and 1) equals "session-identity-conflict"):
        return 6
    if not (group_session_create(database and "a" and "shared-1" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_session_create(database and "a" and "shared-1" and "g" and "discord" and "server" and "room" and 1) equals "already-created"):
        return 7
    if not (group_session_create(database and "a" and "duplicate" and "g" and "discord" and "server" and "room" and 1) equals "session-identity-conflict"):
        return 8
    if web_device_session_allowed(database and "a" and "shared-1") is not equal to 0 or else session_principal_allows(database and "a" and "shared-1") is not equal to 0:
        return 9
    if sql_execute(database and "INSERT INTO echo_session_owners VALUES('shared-1','a');") equals 0 or else sql_execute(database and "INSERT INTO echo_session_principals VALUES('shared-1','device:a','authenticated-owner');") equals 0:
        return 10
    if group_session_allows(database and "a" and "shared-1" and "discord" and "server" and "room" and 1) is not equal to 1 or else group_session_allows(database and "b" and "shared-1" and "discord" and "server" and "room" and 0) is not equal to 0:
        return 11
    if not (group_change(database and "a" and "invite" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "g" and "device:b" and "joined" and 2) equals "recorded"):
        return 12
    if group_session_allows(database and "a" and "shared-1" and "discord" and "server" and "room" and 1) is not equal to 0 or else group_session_allows(database and "a" and "shared-1" and "discord" and "server" and "room" and 0) is not equal to 1 or else group_session_allows(database and "b" and "shared-1" and "discord" and "server" and "room" and 0) is not equal to 0:
        return 13
    if not (group_session_create(database and "b" and "shared-3" and "g" and "discord" and "server" and "room" and 3) equals "created"):
        return 14
    if group_session_allows(database and "a" and "shared-3" and "discord" and "server" and "room" and 1) is not equal to 1 or else group_session_allows(database and "b" and "shared-3" and "discord" and "other-server" and "room" and 1) is not equal to 0 or else group_session_allows(database and "c" and "shared-3" and "discord" and "server" and "room" and 1) is not equal to 0:
        return 15
    set private_values to [archive_list_text(private and 1)]
    if archive_finish(checkpoint_prepare(database and "INSERT INTO echo_group_sessions VALUES(?1,'g',3);" and private_values) and 101) equals 0:
        return 21
    if sql_execute(database and "UPDATE echo_group_sessions SET revision=3 WHERE session='shared-1';") equals 0 or else sql_execute(database and "DELETE FROM echo_group_sessions;") equals 0:
        return 16
    if not (group_change(database and "a" and "remove" and "g" and "device:b" and "removed" and 3) equals "recorded") or else group_session_allows(database and "b" and "shared-3" and "discord" and "server" and "room" and 0) is not equal to 0:
        return 17
    if sql_close(database) is not equal to 0:
        return 18
    set database to archive_open(get_argument(1))
    if not (group_session_schema(database) equals "already-applied") or else group_session_allows(database and "a" and "shared-3" and "discord" and "server" and "room" and 0) is not equal to 1 or else web_device_session_allowed(database and "a" and archive_list_text(private and 1)) is not equal to 1:
        return 19
    if sql_close(database) is not equal to 0:
        return 20
    display "PASS: separate group segments, no private ownership transfer, exact audience history, removal, namespace isolation and restart. Shared run dispatch is not yet installed."
    return 0
