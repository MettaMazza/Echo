import "../../app/hud/interface"
import "../../app/jobs/delegation_schema"

# Real immutable proposal storage; no protected deployment is performed.
define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    for each device in ["admin","guest"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant" and "device:admin" and "admin" and "Fixture") equals "recorded"):
        return 4
    set own to web_submit_owned(database and "admin" and "own" and "" and "Own rights")
    set other to web_submit_owned(database and "admin" and "other" and "" and "Separate rights")
    set guest to web_submit_owned(database and "guest" and "guest" and "" and "Guest")
    set manifest to protected_manifest(get_argument(2) and "identity" and "/fixture/identity" and ep_sha256("before") and ep_sha256("after") and "OWN_RIGHTS_EVIDENCE")
    set foreign to protected_manifest(get_argument(2) and "identity" and "/fixture/other" and ep_sha256("before") and ep_sha256("other") and "OTHER_RIGHTS_CANARY")
    if not (protected_proposal_store(database and get_argument(2) and "own" and "own-proposal" and manifest) equals "recorded") or else not (protected_proposal_store(database and get_argument(2) and "other" and "other-proposal" and foreign) equals "recorded"):
        return 5
    set view to hud_execute(database and "own" and "{\"section\":\"rights\",\"after\":0}")
    if string_contains(view and "OWN_RIGHTS_EVIDENCE") equals 0 or else string_contains(view and ep_sha256(manifest)) equals 0 or else string_contains(view and "OTHER_RIGHTS_CANARY") is not equal to 0 or else string_contains(view and "live controller charter not inspected") equals 0:
        display view
        return 6
    set tokens to provider_json_tokens(view)
    set data to provider_member(tokens and 0 and "data")
    set cursor to string_to_int(provider_value(tokens and provider_member(tokens and data and "next_after")))
    if cursor < 1 or else string_contains(hud_read(database and "own" and "rights" and cursor) and "\"status\":\"end\"") equals 0:
        return 7
    if string_contains(hud_read_for_device(database and "guest" and "own" and "rights" and 0) and "not-authorized") equals 0 or else string_contains(hud_read(database and "guest" and "rights" and 0) and "not-authorized") equals 0:
        return 8
    if not (group_create(database and "admin" and "g" and "browser" and "local" and "g" and "g") equals "created") or else not (group_change(database and "admin" and "invite" and "g" and "device:guest" and "invited" and 1) equals "recorded") or else not (group_change(database and "guest" and "join" and "g" and "device:guest" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "admin" and "shared" and "g" and "browser" and "local" and "g" and 3) equals "created") or else not (group_run_submit(database and "admin" and "shared-run" and "shared" and "browser" and "local" and "g" and "Mixed audience") equals "accepted"):
        return 9
    if string_contains(hud_read(database and "shared-run" and "rights" and 0) and "not-authorized") equals 0:
        return 10
    if not (principal_host_role(database and "demote" and "device:admin" and "user" and "Fixture demotion") equals "recorded") or else string_contains(hud_read_for_device(database and "admin" and "own" and "rights" and 0) and "not-authorized") equals 0:
        return 11
    display "PASS: exact proposal evidence, same-owner cross-conversation exclusion, cursor/end, guest and mixed-audience denial, demotion denial; no deployment authority granted."
    return sql_close(database)
