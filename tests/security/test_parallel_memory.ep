import "../../app/web/attachments"
import "../../app/memory/knowledge_lifecycle"
import "../../app/agent/runner"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set original to web_submit_owned(database and "owner" and "past" and "" and "My favourite colour is turquoise. I prefer short replies and all measurements in metric units.")
    set current to web_submit_owned(database and "owner" and "current" and "" and "What is my favourite colour? Reply with only the colour.")
    set profile to provider_llama_profile(get_argument(2) and string_to_int(get_argument(3)))
    set result to agent_loop_provider(database and "current" and profile and 2048 and -1 and 65536)
    display result
    if not (result equals "completed"):
        return 4
    if length_list(memory_pending(database and "current")) is not equal to 0:
        return 5
    return sql_close(database)
