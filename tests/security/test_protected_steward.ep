import "../../app/rights/steward"

# Use a disposable backup of test_live_protected_tools, never the live archive.
define main returning Int:
    if get_argument_count() is not equal to 2 or else string_contains(get_argument(1) and "steward-fixture") equals 0:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else not (protected_steward_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "steward-invite") is not equal to 0 or else web_device_pair(database and "steward-invite" and "steward" and "Steward fixture" and "steward-secret") is not equal to 0 or else not (principal_host_role(database and "enrol-steward" and "device:steward" and "steward" and "Explicit fixture enrolment") equals "recorded"):
        return 3
    set original to protected_proposal_read(database and "rights-live" and "live-proposal")
    set digest to archive_list_text(original and 2)
    if not (protected_steward_decide(database and "fixture-secret" and "admin-forgery" and "live-proposal" and digest and 1 and 0 and "authorize" and "Ordinary admin cannot impersonate steward") equals "not-authorized") or else not (protected_steward_decide(database and "wrong-secret" and "wrong-credential" and "live-proposal" and digest and 1 and 0 and "authorize" and "Wrong credential") equals "not-authorized"):
        return 4
    if not (protected_steward_decide(database and "steward-secret" and "wrong-manifest" and "live-proposal" and ep_sha256("wrong") and 1 and 0 and "authorize" and "Wrong manifest") equals "proposal-mismatch") or else not (protected_steward_decide(database and "steward-secret" and "wrong-review" and "live-proposal" and digest and 0 and 0 and "authorize" and "Stale model review") equals "review-mismatch"):
        return 5
    if not (protected_steward_decide(database and "steward-secret" and "approval" and "live-proposal" and digest and 1 and 0 and "authorize" and "Approve this exact disposable fixture") equals "recorded") or else not (protected_steward_decide(database and "steward-secret" and "approval" and "live-proposal" and digest and 1 and 0 and "authorize" and "Approve this exact disposable fixture") equals "already-recorded"):
        return 6
    if not (protected_steward_gate(database and "live-proposal") equals "steward-authorized"):
        return 7
    if not (protected_steward_decide(database and "steward-secret" and "approval" and "live-proposal" and digest and 1 and 0 and "reject" and "Changed request identity") equals "decision-identity-conflict") or else not (protected_steward_decide(database and "steward-secret" and "stale-withdraw" and "live-proposal" and digest and 1 and 0 and "withdraw" and "Stale revision") equals "revision-conflict"):
        return 8
    if sql_execute(database and "UPDATE echo_protected_steward SET decision='reject';") equals 0 or else sql_execute(database and "DELETE FROM echo_protected_steward;") equals 0:
        return 9
    if not (protected_steward_decide(database and "steward-secret" and "withdraw" and "live-proposal" and digest and 1 and 1 and "withdraw" and "Withdraw before any execution") equals "recorded") or else not (protected_steward_gate(database and "live-proposal") equals "steward-withdraw"):
        return 10
    if not (protected_steward_decide(database and "steward-secret" and "reapprove" and "live-proposal" and digest and 1 and 2 and "authorize" and "New explicit fixture decision") equals "recorded"):
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if not (protected_steward_gate(database and "live-proposal") equals "steward-authorized"):
        return 13
    if not (principal_host_role(database and "demote-steward" and "device:steward" and "admin" and "Remove stewardship") equals "recorded") or else not (protected_steward_gate(database and "live-proposal") equals "steward-authority-changed"):
        return 14
    if not (principal_host_role(database and "restore-steward" and "device:steward" and "steward" and "New enrolment cannot revive prior receipt") equals "recorded") or else not (protected_steward_gate(database and "live-proposal") equals "steward-authority-changed"):
        return 15
    if sql_execute(database and "DROP TRIGGER echo_protected_steward_no_update; UPDATE echo_protected_steward SET reason='damaged earlier receipt' WHERE identity='approval';") is not equal to 0:
        return 17
    if not (protected_steward_gate(database and "live-proposal") equals "steward-receipt-invalid") or else not (protected_steward_decide(database and "steward-secret" and "after-damage" and "live-proposal" and digest and 1 and 3 and "authorize" and "Must not overwrite damaged history") equals "steward-history-invalid"):
        return 18
    if sql_close(database) is not equal to 0:
        return 16
    display "PASS: authenticated steward distinct from admin, exact manifest/review/revision, retry/conflict, immutable receipt, withdrawal/reapproval, reopen and demote/restore invalidation and damaged-history refusal. No model tool, UI route or deployment enabled."
    return 0
