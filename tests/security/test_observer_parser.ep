import "../../app/rights/observer_parser"

define observer_fixture_assert with raw as Str and parsed as Str and verdict as Str returning Int:
    set tokens to provider_json_tokens(protected_observer_parse(raw))
    if tokens equals 0:
        return 1
    if not (provider_value(tokens and provider_member(tokens and 0 and "parsed")) equals parsed) or else not (provider_value(tokens and provider_member(tokens and 0 and "verdict")) equals verdict):
        return 1
    return 0

define main returning Int:
    if observer_fixture_assert("{\"verdict\":\"ALLOWED\",\"reason\":\"safe_readonly\"}" and "1" and "ALLOWED") is not equal to 0 or else observer_fixture_assert("```json\n{\"Verdict\":\" permitted \",\"Explanation\":\"Fixture approved\"}\n```" and "1" and "ALLOWED") is not equal to 0:
        return 1
    if observer_fixture_assert("{\"decision\":\"DENY\",\"reason\":\"The quoted rule contains ALLOWED but the action is denied.\"}" and "1" and "BLOCKED") is not equal to 0:
        return 2
    set aliases to ["verdict", "Verdict", "decision", "Decision", "result", "Result", "outcome"]
    set allowed to ["ALLOWED", "ALLOW", "PERMITTED", "SAFE", "APPROVED", "PASS"]
    set blocked to ["BLOCKED", "BLOCK", "DENIED", "DENY", "REJECTED", "UNSAFE", "FAIL"]
    set keyindex to 0
    repeat while keyindex < length_list(aliases):
        set values to allowed
        set expected to "ALLOWED"
        set groupindex to 0
        repeat while groupindex < 2:
            set valueindex to 0
            repeat while valueindex < length_list(values):
                set raw to concat("{" and provider_quote(ptr_to_str(get_list(aliases and keyindex))))
                set raw to concat(raw and concat(":" and provider_quote(ptr_to_str(get_list(values and valueindex)))))
                set raw to concat(raw and ",\"reason\":\"Alias fixture\"}")
                if observer_fixture_assert(raw and "1" and expected) is not equal to 0:
                    return 4
                set valueindex to valueindex + 1
            set values to blocked
            set expected to "BLOCKED"
            set groupindex to groupindex + 1
        set keyindex to keyindex + 1
    set invalid to ["", "This is ALLOWED.", "{\"reason\":\"ALLOWED\"}", "{\"verdict\":\"NOT ALLOWED\",\"reason\":\"denied\"}", "{\"verdict\":true,\"reason\":\"boolean is not a verdict\"}", "{\"verdict\":\"ALLOWED\",\"verdict\":\"BLOCKED\",\"reason\":\"duplicate\"}", "{\"verdict\":\"ALLOWED\",\"Decision\":\"BLOCKED\",\"reason\":\"conflicting aliases\"}", "{\"verdict\":\"ALLOWED\",\"reason\":\" \"}", "{\"verdict\":\"ALLOWED\",\"reason\":7}", "{\"nested\":{\"verdict\":\"ALLOWED\",\"reason\":\"not top level\"}}", "{\"verdict\":\"ALLOWED\",\"reason\":\"one\"} {\"verdict\":\"BLOCKED\",\"reason\":\"two\"}"]
    set index to 0
    repeat while index < length_list(invalid):
        if observer_fixture_assert(ptr_to_str(get_list(invalid and index)) and "0" and "BLOCKED") is not equal to 0:
            display concat("FAIL: invalid case " and int_to_string(index))
            return 3
        set index to index + 1
    display "PASS: explicit model verdict parsing, original key/value aliases and fenced JSON; prose, substring, boolean, duplicate/conflicting keys, absent reason, nested-only and multiple objects fail closed. No audit judgment is synthesized."
    return 0
