import "../../app/agent/tool_recovery"
import "../../app/agent/run_messages"
import "../fixtures/generation_fixture"

define trace_dispatch_call with database as Int and run as Str and request as Str and call_id as Str and name as Str and arguments as Str returning Int:
    if string_length(task_checklist_read(database and run)) equals 0:
        set checklist to task_checklist_save(database and run and "fixture-task" and "{\"items\":[{\"id\":\"continuity\",\"requirement\":\"Verify continuity tools\",\"status\":\"pending\",\"evidence\":\"\"}]}")
        if string_contains(checklist and "saved") equals 0:
            return 25
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"reasoning_content\":\"Fixture reasoning: select the requested operation.\",\"tool_calls\":[{\"index\":0,\"id\":" and provider_quote(call_id))
    set delta to concat(delta and concat(",\"function\":{\"name\":" and provider_quote(name)))
    set delta to concat(delta and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}")))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set body to session_request_body_owned(database and run and "fixture" and agent_run_messages(database and run))
    if string_contains(body and "trace_search") equals 0 or else provider_json_tokens(body) equals 0:
        return 2
    set generated to agent_generate_local(database and run and request and body and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set fixture_result to receive from completed
    if generated is not equal to 0 or else fixture_result is not equal to 0:
        return 3
    if agent_tool_step(database and run) is not equal to 0 or else agent_tool_step(database and run) is not equal to 0:
        return 4
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (session_principal_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "run" and "" and "Find and read my trace")
    if trace_dispatch_call(database and "run" and "search-request" and "search" and "trace_search" and "{\"view\":\"reasoning\",\"query\":\"Fixture reasoning\",\"after\":0}") is not equal to 0:
        return 4
    set saved to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.event') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='search';"))
    if not (archive_list_text(saved and 1) equals "search-request:response"):
        return 5
    if trace_dispatch_call(database and "run" and "read-request" and "read" and "trace_read" and "{\"view\":\"reasoning\",\"event\":\"search-request:response\",\"offset\":0,\"characters\":200}") is not equal to 0:
        return 6
    set saved to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.text') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='read';"))
    if not (archive_list_text(saved and 1) equals "Fixture reasoning: select the requested operation."):
        return 7
    set original to trace_execute(database and "run" and "trace_read" and "{\"view\":\"record\",\"event\":\"search-request\",\"offset\":0,\"characters\":1000}")
    if string_contains(original and "request_body") equals 0:
        return 8
    if string_contains(session_tool_schemas_owned(database and "run") and "state_inspect") equals 0 or else trace_dispatch_call(database and "run" and "state-request" and "state" and "state_inspect" and "{\"section\":\"interaction\",\"after\":0}") is not equal to 0:
        return 9
    set saved to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.section'),json_extract(e.payload,'$.result.data.objective_event') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.call_id='state';"))
    if not (archive_list_text(saved and 1) equals "interaction") or else not (archive_list_text(saved and 2) equals "run:user"):
        return 10
    display "PASS: advertised trace/state schemas, real streaming parser, durable tool dispatch, exact reasoning search/read and scoped interaction state."
    return sql_close(database)
