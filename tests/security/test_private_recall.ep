import "../../app/web/run_store"
import "../../app/memory/archive_recall"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (session_principal_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    set a to web_submit_owned(database and "a" and "a-first" and "" and "shared-marker Café 🌍")
    set b to web_submit_owned(database and "b" and "b-first" and "" and "shared-marker private B")
    set later to web_submit_owned(database and "a" and "a-later" and "" and "Recall a past conversation")
    set boundary to memory_archive_boundary(database and "a-later")
    if not (archive_list_text(boundary and 0) equals "found"):
        return 4
    set through to string_to_int(archive_list_text(boundary and 1))
    set found to memory_archive_next(database and "a-later" and "shared-marker" and 0 and through)
    if not (archive_list_text(found and 0) equals "found") or else not (archive_list_text(found and 1) equals "a-first:user") or else not (archive_list_text(found and 2) equals archive_list_text(a and 1)):
        return 5
    set exhausted to memory_archive_next(database and "a-later" and "shared-marker" and string_to_int(archive_list_text(found and 3)) and through)
    if not (archive_list_text(exhausted and 0) equals "end"):
        return 6
    set text to memory_archive_read(database and "a-later" and "a-first:user" and 14 and 6)
    if not (archive_list_text(text and 0) equals "found") or else not (archive_list_text(text and 7) equals "Café 🌍") or else not (archive_list_text(text and 5) equals archive_list_text(found and 6)):
        return 7
    if not (archive_list_text(memory_archive_read(database and "a-later" and "b-first:user" and 0 and 100) and 0) equals "end"):
        return 8
    set newer to web_submit_owned(database and "a" and "a-newer" and "" and "shared-marker later arrival")
    if not (archive_list_text(memory_archive_next(database and "a-later" and "later arrival" and 0 and through) and 0) equals "end"):
        return 9
    if not (principal_host_role(database and "grant-admin" and "device:a" and "admin" and "fixture") equals "recorded"):
        return 10
    if not (archive_list_text(memory_archive_read(database and "a-later" and "a-first:user" and 0 and 100) and 0) equals "not-authorized"):
        return 11
    set admin to web_submit_owned(database and "a" and "admin-recall" and "" and "Recall after explicit new admin run")
    if not (archive_list_text(memory_archive_read(database and "admin-recall" and "b-first:user" and 0 and 100) and 0) equals "end"):
        return 12
    if not (principal_host_device_link(database and "link-b" and "b" and "device:b" and "device:a" and "fixture") equals "recorded"):
        return 13
    set linked to web_submit_owned(database and "b" and "linked-recall" and "" and "Same principal from linked device")
    if not (archive_list_text(memory_archive_read(database and "linked-recall" and "a-first:user" and 0 and 100) and 0) equals "found") or else not (archive_list_text(memory_archive_read(database and "linked-recall" and "b-first:user" and 0 and 100) and 0) equals "end"):
        return 14
    if sql_close(database) is not equal to 0:
        return 15
    set database to archive_open(get_argument(1))
    if not (archive_list_text(memory_archive_read(database and "linked-recall" and "a-first:user" and 0 and 100) and 0) equals "found"):
        return 16
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "fixture") equals "recorded") or else not (archive_list_text(memory_archive_read(database and "linked-recall" and "a-first:user" and 0 and 100) and 0) equals "not-authorized"):
        return 17
    if sql_close(database) is not equal to 0:
        return 18
    display "PASS: cross-session chronological search and Unicode source recall preserve provenance, cursor bounds, private ownership, linked-device identity and revocation."
    return 0
