import "../../app/web/message_speech"

define queue_saved_speech with database as Int and session as Str and job as Str returning Int:
    set payload to concat("{\"run_id\":" and provider_quote(job))
    set payload to concat(payload and ",\"call_id\":\"speak\",\"name\":\"speech_synthesize\",\"speech_source\":\"answer\",\"arguments\":\"{\\\"text\\\":\\\"Hello Echo\\\"}\"}")
    if sql_execute(database and "BEGIN IMMEDIATE;") is not equal to 0:
        return 1
    if archive_append_pending(database and session and concat(job and ":request") and "tool_call" and payload and "fixture") is not equal to 0 or else tool_ledger_queue(database and job and "speak" and session and concat(job and ":request")) is not equal to 0 or else sql_execute(database and "COMMIT;") is not equal to 0:
        set rolled to archive_rollback(database)
        return 1
    return tool_ledger_claim(database and job and "speak")

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (tool_authority_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "a" and "question" and "" and "Hello")
    set session to archive_list_text(submitted and 1)
    if archive_append(database and session and "answer" and "assistant_final" and "{\"content\":\"Hello Echo\"}" and "fixture") is not equal to 0 or else queue_saved_speech(database and session and "speech-one") is not equal to 0:
        return 4
    if not (archive_list_text(speech_tool_authority(database and "speech-one" and "speak") and 0) equals "found") or else tool_authority_allows(database and "speech-one" and "speak" and "admin") is not equal to 0:
        return 5
    if not (principal_host_role(database and "grant" and "device:a" and "admin" and "fixture") equals "recorded") or else tool_authority_allows(database and "speech-one" and "speak" and "admin") is not equal to 0:
        return 6
    if not (speech_tool_execute(database and "speech-one" and "speak" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 7
    if queue_saved_speech(database and session and "speech-two") is not equal to 0 or else not (archive_list_text(speech_tool_authority(database and "speech-two" and "speak") and 0) equals "found"):
        return 8
    if not (principal_host_revocation(database and "revoke" and "device:a" and 1 and "fixture") equals "recorded") or else not (principal_host_revocation(database and "restore" and "device:a" and 0 and "fixture") equals "recorded") or else not (principal_host_role(database and "regrant" and "device:a" and "admin" and "fixture") equals "recorded"):
        return 9
    if not (speech_tool_execute(database and "speech-two" and "speak" and -1) equals "{\"status\":\"not-authorized\"}"):
        return 10
    if queue_saved_speech(database and session and "speech-three") is not equal to 0 or else not (archive_list_text(speech_tool_authority(database and "speech-three" and "speak") and 0) equals "found"):
        return 11
    if sql_execute(database and "UPDATE echo_tool_authority SET role='steward';") equals 0 or else sql_execute(database and "DELETE FROM echo_tool_authority;") equals 0:
        return 12
    if sql_close(database) is not equal to 0:
        return 13
    set database to archive_open(get_argument(1))
    if not (tool_authority_schema(database) equals "already-applied") or else tool_authority_allows(database and "speech-two" and "speak" and "user") is not equal to 0 or else tool_authority_allows(database and "speech-three" and "speak" and "admin") is not equal to 1:
        return 14
    set effects to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='provider_helper_dispatch';"))
    if not (archive_list_text(effects and 1) equals "0") or else archive_verify(database and session) is not equal to 0:
        return 15
    if sql_close(database) is not equal to 0:
        return 16
    display "PASS: direct Speak authority frozen at queue time, no promotion or revoke/restore revival, fresh requests allowed, no denied helper launch, immutable durable receipts."
    return 0
