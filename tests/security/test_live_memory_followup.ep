import "../../app/web/attachments"
import "../../app/agent/runner"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    set submitted to web_submit_owned(database and get_argument(2) and "automatic-memory-followup" and "session:automatic-memory-acceptance" and "Thanks. In one sentence, what should you do differently when I share our history?")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 2
    if length_list(memory_pending(database and "automatic-memory-followup")) is not equal to 0:
        return 3
    set status to agent_loop_provider(database and "automatic-memory-followup" and agent_provider_read(database and "automatic-memory-followup") and 2048 and -1 and 65536)
    display status
    if not (status equals "completed"):
        return 4
    return sql_close(database)
