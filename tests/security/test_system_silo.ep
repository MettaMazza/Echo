import "../../app/security/system_silo"
import "../../app/web/run_store"
import "../../app/context/session_messages"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each device in ["echo","human"]:
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and "Echo" and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "human-admin" and "device:human" and "admin" and "fixture") equals "recorded"):
        return 4
    set private to web_submit_owned(database and "human" and "private" and "" and "HUMAN_PRIVATE_CANARY")
    if not (archive_list_text(system_silo_submit(database and "human" and "continuity" and "forged" and "Human admin is not Echo" and create_list()) and 0) equals "system-scope-not-authorized"):
        return 5
    set first to system_silo_submit(database and "echo" and "continuity" and "one" and "ECHO_SYSTEM_CANARY" and create_list())
    set second to system_silo_submit(database and "echo" and "maintenance" and "two" and "MAINTENANCE_CANARY" and create_list())
    if not (archive_list_text(first and 0) equals "accepted") or else not (archive_list_text(second and 0) equals "accepted") or else archive_list_text(first and 1) equals archive_list_text(second and 1):
        return 6
    set messages to session_messages(database and archive_list_text(first and 1) and "one")
    if string_length(messages) equals 0 or else string_contains(messages and "ECHO_SYSTEM_CANARY") equals 0 or else string_contains(messages and "HUMAN_PRIVATE_CANARY") is not equal to 0 or else string_contains(messages and "MAINTENANCE_CANARY") is not equal to 0:
        return 7
    if group_session_allows(database and "human" and archive_list_text(first and 1) and "echo-system" and "local" and "continuity" and 0) is not equal to 0:
        return 8
    set values to [archive_list_text(first and 1)]
    set group to history_collect_one(checkpoint_prepare(database and "SELECT group_id FROM echo_group_sessions WHERE session=?;" and values))
    if not (group_change(database and "echo" and "invite-human" and archive_list_text(group and 1) and "device:human" and "invited" and 1) equals "fixed-system-audience"):
        return 9
    set closed to sql_close(database)
    set database to archive_open(get_argument(1))
    set retry to system_silo_submit(database and "echo" and "continuity" and "one" and "ECHO_SYSTEM_CANARY" and create_list())
    if not (archive_list_text(retry and 0) equals "already-accepted") or else not (archive_list_text(retry and 1) equals archive_list_text(first and 1)):
        return 10
    if web_device_revoke(database and "echo") is not equal to 0 or else not (archive_list_text(system_silo_submit(database and "echo" and "continuity" and "three" and "Revoked service" and create_list()) and 0) equals "system-scope-not-authorized"):
        return 11
    display "PASS: configured Echo identity, human-admin impersonation denial, independent contexts, private-history isolation, fixed audience, restart/retry and revoked service denial."
    return sql_close(database)
