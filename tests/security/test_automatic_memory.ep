import "../../app/web/attachments"
import "../../app/memory/automatic"
import "../../app/context/session_messages"
import "../../app/memory/knowledge_lifecycle"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (knowledge_lifecycle_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 3
    if web_pairing_invite(database and "foreign") is not equal to 0 or else web_device_pair(database and "foreign" and "outsider" and "Foreign" and "other-secret") is not equal to 0:
        return 4
    set original to web_submit_owned(database and "owner" and "original" and "" and "I am Maria. Mirroring is not a defect. Read the existing file before editing it.")
    set foreign to web_submit_owned(database and "outsider" and "foreign" and "" and "private-canary-must-stay-private")
    set current to web_submit_owned(database and "owner" and "current" and "" and "Remember me?")
    set sources to memory_pending(database and "current")
    if sources equals 0 or else length_list(sources) is not equal to 1:
        return 5
    set response to "{\"memories\":[{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"fact\",\"quote\":\"I am Maria.\"},{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"correction\",\"quote\":\"Mirroring is not a defect.\"},{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"workflow\",\"quote\":\"Read the existing file before editing it.\"}]}"
    if not (memory_extract_save(database and "current" and sources and 0 and 1 and response) equals "ready"):
        return 6
    if not (memory_extract_save(database and "current" and sources and 0 and 1 and response) equals "ready"):
        return 7
    if length_list(memory_pending(database and "current")) is not equal to 0:
        return 8
    set messages to session_messages(database and archive_list_text(current and 1) and "current")
    if string_contains(messages and "I am Maria.") equals 0 or else string_contains(messages and "Mirroring is not a defect.") equals 0 or else string_contains(messages and "Read the existing file") equals 0 or else string_contains(messages and "private-canary") equals 1:
        return 9
    if string_contains(memory_context(database and "foreign") and "Maria") equals 1:
        return 10
    if not (memory_extract_save(database and "current" and sources and 0 and 1 and "{\"memories\":[{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"fact\",\"quote\":\"invented motive\"}]}") equals "memory-quote-mismatch"):
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if length_list(memory_pending(database and "current")) is not equal to 0 or else string_contains(memory_context(database and "current") and "Maria") equals 0:
        return 13
    set workflow to history_collect_one(archive_prepare(database and "SELECT identity FROM echo_memory_claims WHERE predicate='workflow';"))
    if not (knowledge_visibility_set(database and "current" and "forget-workflow" and archive_list_text(workflow and 1) and 0 and "forgotten" and "User withdrew workflow") equals "recorded"):
        return 14
    if string_contains(memory_context(database and "current") and "Read the existing file") equals 1 or else length_list(memory_pending(database and "current")) is not equal to 0:
        return 15
    set forged to create_list()
    set added to append_list(forged and "foreign:user")
    if not (memory_extract_save(database and "current" and forged and 0 and 1 and "{\"memories\":[]}") equals "memory-source-not-authorized"):
        return 16
    set grounded to memory_ground_extraction(database and "current" and sources and 0 and 1 and "{\"memories\":[{\"source_event\":\"missing-source\",\"kind\":\"semantic\",\"category\":\"fact\",\"quote\":\"invented\"},{\"source_event\":\"original:user\",\"kind\":\"semantic\",\"category\":\"fact\",\"quote\":\"I am Maria...defect\"}]}")
    set tokens to provider_json_tokens(grounded)
    set items to provider_items(tokens and provider_member(tokens and 0 and "memories"))
    if length_list(items) is not equal to 1 or else not (provider_value(tokens and provider_member(tokens and get_list(items and 0) and "quote")) equals "I am Maria. Mirroring is not a defect. Read the existing file before editing it."):
        return 17
    display "PASS: automatic recall restores identity, correction and workflow across sessions and restart; ingestion is idempotent, foreign memory stays private and invented quotations are rejected."
    return sql_close(database)
