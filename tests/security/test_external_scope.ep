import "os"
import "../../app/security/external_scope"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else sql_execute(database and "CREATE TABLE echo_sessions(session TEXT PRIMARY KEY); CREATE TABLE echo_principals(identity TEXT PRIMARY KEY,revoked INTEGER); CREATE TABLE echo_devices(device TEXT PRIMARY KEY,revoked INTEGER); CREATE TABLE echo_principal_devices(device TEXT PRIMARY KEY,principal TEXT); CREATE TABLE echo_session_owners(session TEXT PRIMARY KEY,device TEXT); CREATE TABLE echo_runs(run TEXT PRIMARY KEY,session TEXT); CREATE TABLE echo_run_authority(run TEXT PRIMARY KEY,principal TEXT,device TEXT); INSERT INTO echo_principals VALUES('alice',0),('bob',0); INSERT INTO echo_devices VALUES('a',0),('b',0); INSERT INTO echo_principal_devices VALUES('a','alice'),('b','bob'); INSERT INTO echo_sessions VALUES('fresh'),('local-history'),('rollback'); INSERT INTO echo_session_owners VALUES('fresh','a'),('local-history','a'),('rollback','a'); INSERT INTO echo_runs VALUES('old','local-history');") is not equal to 0:
        return 2
    if not (external_scope_session_status(database and "fresh") equals "local") or else external_scope_schema(database) is not equal to 0:
        return 3
    set digest to ep_sha256("fixture-profile")
    set disclosure to "Fixture owner permits this fresh session to the named provider."
    if not (external_scope_grant(database and "b" and "fresh" and digest and disclosure) equals "not-authorized"):
        return 4
    if not (external_scope_grant(database and "a" and "local-history" and digest and disclosure) equals "fresh-external-session-required"):
        return 5
    if not (external_scope_grant(database and "a" and "fresh" and digest and disclosure) equals "granted"):
        return 6
    if not (external_scope_grant(database and "a" and "fresh" and digest and disclosure) equals "already-granted") or else not (external_scope_session_status(database and "fresh") equals "external"):
        return 7
    if not (external_scope_grant(database and "a" and "fresh" and ep_sha256("other-profile") and disclosure) equals "external-consent-conflict"):
        return 8
    if sql_execute(database and "INSERT INTO echo_runs VALUES('allowed','fresh'),('foreign','fresh'); INSERT INTO echo_run_authority VALUES('allowed','alice','a'),('foreign','bob','b');") is not equal to 0:
        return 9
    if external_scope_run_allows(database and "allowed" and digest) is not equal to 1 or else external_scope_run_allows(database and "foreign" and digest) is not equal to 0 or else external_scope_run_allows(database and "allowed" and ep_sha256("changed")) is not equal to 0:
        return 10
    if external_scope_run_is_local(database and "old") is not equal to 1 or else external_scope_run_is_local(database and "allowed") is not equal to 0 or else external_scope_run_is_local(database and "missing") is not equal to 0:
        return 20
    if sql_execute(database and "UPDATE echo_devices SET revoked=1 WHERE device='a';") is not equal to 0 or else external_scope_run_allows(database and "allowed" and digest) is not equal to 0:
        return 21
    if sql_execute(database and "UPDATE echo_devices SET revoked=0 WHERE device='a';") is not equal to 0:
        return 22
    if not (external_scope_revoke(database and "b" and "fresh") equals "not-authorized") or else not (external_scope_revoke(database and "a" and "fresh") equals "revoked") or else not (external_scope_revoke(database and "a" and "fresh") equals "revoked"):
        return 11
    if external_scope_run_allows(database and "allowed" and digest) is not equal to 0 or else not (external_scope_session_status(database and "fresh") equals "external-revoked"):
        return 12
    if not (external_scope_grant(database and "a" and "fresh" and digest and disclosure) equals "external-consent-revoked"):
        return 13
    if sql_execute(database and "DELETE FROM echo_external_scopes;") equals 0 or else sql_execute(database and "DELETE FROM echo_external_revocations;") equals 0:
        return 14
    if sql_execute(database and "CREATE TRIGGER fixture_reject_scope BEFORE INSERT ON echo_external_scopes BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 15
    if not (external_scope_grant(database and "a" and "rollback" and digest and disclosure) equals "database-error") or else not (external_scope_session_status(database and "rollback") equals "local"):
        return 16
    if sql_close(database) is not equal to 0:
        return 17
    set database to archive_open(get_argument(1))
    if database equals 0 or else not (external_scope_session_status(database and "fresh") equals "external-revoked") or else external_scope_run_allows(database and "allowed" and digest) is not equal to 0:
        return 18
    if sql_close(database) is not equal to 0:
        return 19
    display "PASS: owner-only fresh-session consent, exact profile binding, conflict, foreign principal denial, revocation, immutable external origin, failed grant rollback and reopen."
    return 0
