import "os"
import "../../app/web/branches"
import "../../app/security/tool_policy"

define external_fixture_call with database as Int and session as Str and run as Str and name as Str returning Int:
    set event to concat(run and concat(":" and name))
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"call_id\":" and provider_quote(name)))
    set payload to concat(payload and concat(",\"name\":" and provider_quote(name)))
    set payload to concat(payload and ",\"arguments\":\"{}\"}")
    if archive_append(database and session and event and "tool_call" and payload and "fixture") is not equal to 0:
        return 1
    return tool_ledger_queue(database and run and name and session and event)

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (tool_authority_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    if not (principal_host_role(database and "admin" and "device:owner" and "admin" and "fixture") equals "recorded"):
        return 4
    set local to web_submit_owned(database and "owner" and "local-run" and "" and "Local request")
    if not (archive_list_text(local and 0) equals "accepted"):
        return 5
    if external_fixture_call(database and archive_list_text(local and 1) and "local-run" and "host_read_text") is not equal to 0 or else tool_policy_allows(database and "local-run" and "host_read_text" and "host_read_text") is not equal to 1:
        return 6
    if external_scope_schema(database) is not equal to 0:
        return 7
    set fresh to web_create_session(database and "owner" and "cloud")
    set session to archive_list_text(fresh and 1)
    if not (archive_list_text(fresh and 0) equals "accepted") or else not (external_scope_grant(database and "owner" and session and ep_sha256("fixture-profile") and "This fresh session is shared with the selected external provider.") equals "granted"):
        return 8
    set submitted to web_submit_owned(database and "owner" and "cloud-run" and session and "External fixture request")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 9
    set denied_provider to provider_prepare(database and session and "must-not-dispatch" and provider_llama_profile("fixture" and 1) and "{}" and 100 and -1 and 65536)
    if not (archive_list_text(denied_provider and 0) equals "external-context-requires-external-provider"):
        return 22
    for each name in ["host_read_text","host_execute","self_improve","discord_post","memory_read","delegate_task","schedule","workspace_read_text","history_read","web_search","task_checklist"]:
        if external_fixture_call(database and session and "cloud-run" and name) is not equal to 0:
            return 10
        set expected to name equals "workspace_read_text" or else name equals "history_read" or else name equals "web_search" or else name equals "task_checklist"
        if tool_policy_allows(database and "cloud-run" and name and name) is not equal to expected:
            display name
            return 11
    if tool_policy_allows(database and "local-run" and "host_read_text" and "host_read_text") is not equal to 1 or else tool_policy_allows(database and "cloud-run" and "host_read_text" and "workspace_read_text") is not equal to 0:
        return 12
    set denial to provider_json_tokens(tool_policy_denial(database and "cloud-run" and "host_read_text"))
    if not (provider_value(denial and provider_member(denial and 0 and "status")) equals "external-context-restricted"):
        return 13
    if archive_append(database and session and "cloud-final" and "assistant_final" and "{\"content\":\"Fixture complete\"}" and "fixture") is not equal to 0 or else sql_execute(database and "UPDATE echo_runs SET state='completed',last_event='cloud-final' WHERE run='cloud-run';") is not equal to 0:
        return 14
    set branch to web_branch_session(database and "owner" and session and "cloud-final" and "cloud-child")
    if not (archive_list_text(branch and 0) equals "accepted") or else not (external_scope_session_status(database and archive_list_text(branch and 1)) equals "external"):
        display archive_list_text(branch and 0)
        return 15
    if not (external_scope_revoke(database and "owner" and session) equals "revoked") or else not (external_scope_session_status(database and archive_list_text(branch and 1)) equals "external-revoked"):
        return 16
    if tool_policy_allows(database and "cloud-run" and "workspace_read_text" and "workspace_read_text") is not equal to 0 or else tool_policy_allows(database and "local-run" and "host_read_text" and "host_read_text") is not equal to 1:
        return 17
    set after to web_branch_session(database and "owner" and session and "cloud-final" and "after-revoke")
    if not (archive_list_text(after and 0) equals "accepted") or else not (external_scope_session_status(database and archive_list_text(after and 1)) equals "external-revoked"):
        return 18
    if sql_close(database) is not equal to 0:
        return 19
    set database to archive_open(get_argument(1))
    if not (external_scope_session_status(database and "branch:cloud-child") equals "external-revoked") or else external_scope_run_is_local(database and "cloud-run") is not equal to 0:
        return 20
    if sql_close(database) is not equal to 0:
        return 21
    display "PASS: frozen tool authority denies external admin host/private/community/job access, allows session workspace/history/public search/checklist, preserves local admin and rejects name substitution; real branches inherit external provenance and parent revocation before/after creation and reopen."
    return 0
