import "../../app/security/group_output_policy"
import "../../app/web/attachments"
import "../../app/agent/tool_recovery"
import "../../app/agent/run_messages"
import "../fixtures/generation_fixture"

define audience_fixture_run with database as Int and identity as Str and path as Str returning Int:
    if not (group_create(database and "a" and identity and "local" and "server" and "room" and identity) equals "created") or else not (group_change(database and "a" and concat(identity and ":invite") and identity and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and concat(identity and ":join") and identity and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and identity and identity and "local" and "server" and "room" and 3) equals "created") or else not (group_run_submit(database and "a" and identity and identity and "local" and "server" and "room" and "Read the fixture host file for this group.") equals "accepted"):
        return 1
    set listener to local_socket_listen(0)
    set arguments to concat("{\"path\":" and concat(provider_quote(path) and ",\"offset\":0,\"characters\":100}"))
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"read-host\",\"function\":{\"name\":\"host_read_text\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and identity and concat(identity and ":generation") and session_request_body_owned(database and identity and "fixture" and agent_run_messages(database and identity)) and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    if generated is not equal to 0 or else served is not equal to 0:
        return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_output_schema(database) equals "applied"):
        return 2
    for each name in ["a", "b"]:
        set text to ptr_to_str(name)
        if web_pairing_invite(database and text) is not equal to 0 or else web_device_pair(database and text and text and text and concat(text and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant-a" and "device:a" and "admin" and "Fixture") equals "recorded") or else audience_fixture_run(database and "mixed" and get_argument(2)) is not equal to 0:
        return 4
    if group_privileged_audience_allows(database and "mixed") is not equal to 0 or else tool_policy_allows(database and "mixed" and "read-host" and "host_read_text") is not equal to 0 or else run_authority_allows(database and "mixed" and "admin") is not equal to 1:
        return 5
    if not (principal_host_role(database and "grant-b" and "device:b" and "admin" and "Fixture") equals "recorded") or else group_privileged_audience_allows(database and "mixed") is not equal to 0 or else agent_tool_step(database and "mixed") is not equal to 0:
        return 6
    set denial to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.effects') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='mixed';"))
    if not (archive_list_text(denial and 1) equals "tool-unavailable") or else not (archive_list_text(denial and 2) equals "none"):
        return 7
    if audience_fixture_run(database and "admins" and get_argument(2)) is not equal to 0 or else group_privileged_audience_allows(database and "admins") is not equal to 1 or else agent_tool_step(database and "admins") is not equal to 0:
        return 8
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.text') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='admins';"))
    if not (archive_list_text(result and 1) equals "found") or else not (archive_list_text(result and 2) equals "audience-private-fixture"):
        return 9
    if not (principal_host_revocation(database and "revoke-b" and "device:b" and 1 and "Fixture") equals "recorded") or else group_privileged_audience_allows(database and "admins") is not equal to 0 or else not (principal_host_revocation(database and "restore-b" and "device:b" and 0 and "Fixture") equals "recorded") or else group_privileged_audience_allows(database and "admins") is not equal to 0:
        return 10
    if sql_execute(database and "UPDATE echo_group_run_recipients SET role='admin';") equals 0 or else sql_execute(database and "DELETE FROM echo_group_run_recipients;") equals 0:
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if not (group_output_schema(database) equals "already-applied") or else group_privileged_audience_allows(database and "mixed") is not equal to 0 or else group_privileged_audience_allows(database and "admins") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 13
    display "PASS: privileged output denied to mixed audience despite admin sender or later recipient promotion; real host read succeeds for frozen all-admin audience; revoke/restore, immutable records and restart deny stale sharing."
    return 0
