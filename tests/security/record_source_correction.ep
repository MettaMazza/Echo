import "../../app/web/attachments"
import "../../app/memory/corrections"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    set result to memory_correction_record(database and get_argument(2) and get_argument(3) and get_argument(4))
    set closed to sql_close(database)
    return result + closed
