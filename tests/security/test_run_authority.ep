import "../../app/web/run_store"
import "../../app/security/run_authority"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (run_authority_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "a") is not equal to 0 or else web_device_pair(database and "a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "b") is not equal to 0 or else web_device_pair(database and "b" and "b" and "B" and "secret-b") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "a" and "user-run" and "" and "Ordinary user request")
    if not (archive_list_text(submitted and 0) equals "accepted") or else run_authority_allows(database and "user-run" and "user") is not equal to 1 or else run_authority_allows(database and "user-run" and "admin") is not equal to 0:
        return 4
    if not (principal_host_role(database and "grant-a" and "device:a" and "admin" and "fixture") equals "recorded") or else run_authority_allows(database and "user-run" and "admin") is not equal to 0 or else run_authority_allows(database and "user-run" and "user") is not equal to 0:
        return 5
    set submitted to web_submit_owned(database and "a" and "admin-run" and "" and "Explicit new admin request")
    if not (archive_list_text(submitted and 0) equals "accepted") or else run_authority_allows(database and "admin-run" and "admin") is not equal to 1 or else run_authority_allows(database and "admin-run" and "steward") is not equal to 0:
        return 6
    if not (principal_host_revocation(database and "revoke-a" and "device:a" and 1 and "fixture") equals "recorded") or else run_authority_allows(database and "admin-run" and "admin") is not equal to 0:
        return 7
    set denied to web_submit_owned(database and "a" and "revoked-run" and "" and "Must not be accepted")
    if archive_list_text(denied and 0) equals "accepted":
        return 8
    set leftovers to history_collect_one(archive_prepare(database and "SELECT CAST((SELECT COUNT(*) FROM echo_sessions WHERE session='session:revoked-run')+(SELECT COUNT(*) FROM echo_events WHERE session='session:revoked-run')+(SELECT COUNT(*) FROM echo_runs WHERE run='revoked-run') AS TEXT);"))
    if not (archive_list_text(leftovers and 1) equals "0"):
        return 9
    if not (principal_host_revocation(database and "restore-a" and "device:a" and 0 and "fixture") equals "recorded") or else not (principal_host_role(database and "regrant-a" and "device:a" and "admin" and "fixture") equals "recorded") or else run_authority_allows(database and "admin-run" and "admin") is not equal to 0:
        return 10
    set submitted to web_submit_owned(database and "a" and "before-link-run" and "" and "A new request")
    if not (archive_list_text(submitted and 0) equals "accepted") or else run_authority_allows(database and "before-link-run" and "admin") is not equal to 1:
        return 11
    if not (principal_host_device_link(database and "link-a-b" and "a" and "device:a" and "device:b" and "fixture") equals "recorded") or else run_authority_allows(database and "before-link-run" and "user") is not equal to 0:
        return 12
    if not (principal_host_device_link(database and "link-a-back" and "a" and "device:b" and "device:a" and "fixture") equals "recorded") or else run_authority_allows(database and "before-link-run" and "admin") is not equal to 0:
        return 13
    if sql_close(database) is not equal to 0:
        return 14
    set database to archive_open(get_argument(1))
    if not (run_authority_schema(database) equals "already-applied") or else run_authority_allows(database and "admin-run" and "admin") is not equal to 0:
        return 15
    if sql_execute(database and "UPDATE echo_run_authority SET role='steward';") equals 0:
        return 16
    if sql_execute(database and "DELETE FROM echo_run_authority;") equals 0:
        return 17
    if run_authority_allows(database and "missing" and "admin") is not equal to 0 or else run_authority_allows(database and "user-run" and "invented") is not equal to 0:
        return 18
    if sql_close(database) is not equal to 0:
        return 19
    display "PASS: atomic initiating authority, no queued promotion, no revoke/restore or relink revival, no admin-to-steward escalation, rollback and immutable receipts."
    return 0
