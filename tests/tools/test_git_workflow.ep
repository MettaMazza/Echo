import "../../app/tools/tool_candidate_files"
import "../../app/agent/tool_dispatch"
import "../fixtures/generation_fixture"

# Scripted requests exercise the real parser, authority checks, guardian,
# compiler, sandbox and archive. No actual-model authoring is claimed here.
define build_mode_step with database as Int and step as Int and name as Str and arguments as Str returning Int:
    set identity to concat("step-" and int_to_string(step))
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "candidate-run" and identity and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    repeat while archive_list_text(agent_run_read(database and "candidate-run") and 2) equals "tools":
        if agent_tool_step(database and "candidate-run") is not equal to 0:
            return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (tool_authority_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "author" and "Git fixture" and "fixture-secret") is not equal to 0 or else not (principal_host_role(database and "grant" and "device:author" and "admin" and "Git workflow fixture") equals "recorded"):
        return 3
    set submitted to web_submit_owned(database and "author" and "candidate-run" and "" and "Exercise Git in the disposable fixture repository.")
    if build_mode_step(database and 0 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"status\",\"arguments\":[\"--porcelain=v1\"]}"))) is not equal to 0:
        return 10
    if build_mode_step(database and 1 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"switch\",\"arguments\":[\"-c\",\"echo-fixture\"]}"))) is not equal to 0:
        return 11
    if build_mode_step(database and 2 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"apply\",\"arguments\":[\"change.patch\"]}"))) is not equal to 0:
        return 12
    if build_mode_step(database and 3 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"diff\",\"arguments\":[\"--check\"]}"))) is not equal to 0:
        return 13
    if build_mode_step(database and 4 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"diff\",\"arguments\":[\"--\",\"source.ep\"]}"))) is not equal to 0:
        return 14
    if build_mode_step(database and 5 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"add\",\"arguments\":[\"source.ep\"]}"))) is not equal to 0:
        return 15
    if build_mode_step(database and 6 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"commit\",\"arguments\":[\"-m\",\"echo-git-workflow-verified\"]}"))) is not equal to 0:
        return 16
    if build_mode_step(database and 7 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"log\",\"arguments\":[\"-1\",\"--format=%s\"]}"))) is not equal to 0:
        return 17
    if build_mode_step(database and 8 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"show\",\"arguments\":[\"HEAD:source.ep\"]}"))) is not equal to 0:
        return 18
    if build_mode_step(database and 9 and "host_git" and ptr_to_str(string_replace(concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"remote\",\"arguments\":[\"add\",\"origin\",\"__REMOTE__\"]}")) and "__REMOTE__" and get_argument(3)))) is not equal to 0:
        return 19
    if build_mode_step(database and 10 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"push\",\"arguments\":[\"-u\",\"origin\",\"echo-fixture\"]}"))) is not equal to 0:
        return 20
    if build_mode_step(database and 11 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"fetch\",\"arguments\":[\"origin\"]}"))) is not equal to 0:
        return 21
    if build_mode_step(database and 12 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"branch\",\"arguments\":[\"--list\"]}"))) is not equal to 0:
        return 22
    if build_mode_step(database and 13 and "host_git" and concat("{\"repository\":" and concat(provider_quote(get_argument(2)) and ",\"operation\":\"reset\",\"arguments\":[\"--hard\",\"HEAD~1\"]}"))) is not equal to 0:
        return 23
    set completed to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='candidate-run' AND json_extract(e.payload,'$.result.status')='complete' AND json_extract(e.payload,'$.result.wait_status')='0';"))
    if not (archive_list_text(completed and 1) equals "14") or else archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0:
        return 30
    display "PASS: admin Git status, branch, patch, diff, add, commit, history, show, local remote push/fetch and reset ran with durable successful process receipts."
    return sql_close(database)
