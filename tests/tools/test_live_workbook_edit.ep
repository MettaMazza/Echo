import "../../app/security/group_speech"
import "../../app/agent/runner"
import "../../app/archive/file_copy"

# All decisions and calls in this fixture come from the installed primary model.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_speech_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "fixture" and "Fixture" and "fixture-secret") is not equal to 0:
        return 3
    set message to "Edit book.xlsx into a new file edited.xlsx. Change cell A1 on sheet Proof from original marker to edited café marker. Inspect the original worksheet XML using archive list, extraction and read_text before supplying its complete replacement to workspace_edit_workbook. Keep all other XML and binary entries unchanged. Read the edited workbook to verify the new text before answering."
    set submitted to web_submit_owned(database and "fixture" and "archive-run" and "" and message)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set session to archive_list_text(submitted and 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "fixture" and session and get_env("ECHO_WORKSPACE_ROOT"))
    if root < 0:
        return 10
    set source to get_env("ECHO_WORKBOOK_TEST_SOURCE")
    set digest to file_digest(source and 65536)
    set directory to history_collect_one(archive_prepare(database and "SELECT directory FROM echo_workspaces LIMIT 1;"))
    set destination to concat(get_env("ECHO_WORKSPACE_ROOT") and concat("/" and concat(archive_list_text(directory and 1) and "/book.xlsx")))
    if file_copy_verified(source and destination and archive_list_text(digest and 1) and get_list(digest and 2) and 65536) is not equal to 0:
        return 11
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    set status to agent_loop(database and "archive-run" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    display concat("Actual primary-model tool reuse status: " and status)
    if not (status equals "completed"):
        return 5
    for each name in ["workspace_edit_workbook", "workspace_read_workbook"]:
        set values to create_list()
        set added to append_list(values and name)
        set reused to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='archive-run' AND json_extract(q.payload,'$.name')=?1 AND json_extract(e.payload,'$.result.status') IN ('found','created');" and values))
        if string_to_int(archive_list_text(reused and 1)) < 1:
            return 6
    set finished to agent_run_read(database and "archive-run")
    set reply to archive_read_event(database and archive_list_text(finished and 3))
    if reply equals 0 or else string_contains(archive_list_text(reply and 3) and "edited café marker") equals 0 or else archive_verify(database and session) is not equal to 0:
        return 7
    set retained to file_digest(destination and 65536)
    if not (archive_list_text(retained and 1) equals archive_list_text(digest and 1)):
        return 12
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "fixture" and session and get_env("ECHO_WORKSPACE_ROOT"))
    set edited to workspace_read_workbook(library and root and "edited.xlsx" and "Proof" and 0 and 10)
    if string_contains(edited and "edited café marker") equals 0:
        return 13
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    if sql_close(database) is not equal to 0:
        return 8
    set database to archive_open(get_argument(1))
    if not (agent_loop(database and "archive-run" and get_argument(2) and 1 and 2048 and -1 and 65536) equals "completed"):
        return 9
    display "PASS: actual primary model inspected, edited and verified an XLSX while preserving its source, verified archive and reopened without repeating inference."
    return sql_close(database)
