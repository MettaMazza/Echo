import "../../app/lifecycle/tool_behavior"

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set fixture to provider_json_tokens(file_read(get_argument(1)))
    set candidate to get_argument(2)
    set workspace to get_argument(3)
    set runtime to get_argument(4)
    set logs to get_argument(5)
    set valid to provider_value(fixture and provider_member(fixture and 0 and "valid"))
    set wrong to provider_value(fixture and provider_member(fixture and 0 and "wrong"))
    set stalled to provider_value(fixture and provider_member(fixture and 0 and "stalled"))
    set invalid to provider_value(fixture and provider_member(fixture and 0 and "invalid"))
    if tool_behavior_cases_valid(valid) is not equal to 1 or else tool_behavior_cases_valid(invalid) is not equal to 0:
        return 2
    set pin to file_digest_durable(candidate and 65536)
    if not (archive_list_text(pin and 0) equals "verified"):
        return 3
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and logs)
    if root < 0:
        return 4
    for each name in ["valid","wrong","stalled","changed"]:
        set created to workspace_directory_open(library and root and ptr_to_str(name) and 1)
        if created < 0:
            return 5
        set closed to net_close(created)
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    set report to tool_behavior_execute(valid and candidate and archive_list_text(pin and 1) and workspace and runtime and concat(logs and "/valid") and 10000)
    if string_length(report) equals 0:
        return 6
    set result to provider_json_tokens(report)
    if result equals 0 or else length_list(provider_items(result and provider_member(result and 0 and "cases"))) is not equal to 2:
        return 7
    if string_length(tool_behavior_execute(wrong and candidate and archive_list_text(pin and 1) and workspace and runtime and concat(logs and "/wrong") and 10000)) > 0:
        return 8
    if string_length(tool_behavior_execute(stalled and candidate and archive_list_text(pin and 1) and workspace and runtime and concat(logs and "/stalled") and 100)) > 0:
        return 9
    if string_length(tool_behavior_execute(valid and candidate and ep_sha256("wrong artifact") and workspace and runtime and concat(logs and "/changed") and 10000)) > 0:
        return 10
    if string_length(tool_behavior_execute(valid and candidate and archive_list_text(pin and 1) and workspace and runtime and workspace and 10000)) > 0:
        return 11
    display "PASS: independent isolated candidate execution matches two JSON/Unicode cases; wrong output, stalled execution, changed binary and writable-workspace logs cannot qualify."
    return 0
