import "../../app/agent/run_messages"

define main returning Int:
    if get_argument_count() is less than 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else agent_run_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "session" and "original" and "user" and "Find this original: café 🌍" and "fixture") is not equal to 0 or else archive_append(database and "other" and "private" and "user" and "Separate session" and "fixture") is not equal to 0:
        return 1
    if agent_run_create(database and "run" and "session" and "original") is not equal to 0:
        return 1
    if archive_append(database and "session" and "request" and "model_request" and "{\"run_id\":\"run\",\"parent_event\":\"original\"}" and "fixture") is not equal to 0 or else agent_run_transition(database and "run" and "ready" and "original" and "generating" and "request") is not equal to 0:
        return 1
    set state to chat_stream_create()
    set delta to "{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"search\",\"function\":{\"name\":\"history_search\",\"arguments\":\"{\\\"query\\\":\\\"café\\\",\\\"after\\\":0}\"}},{\"index\":1,\"id\":\"read\",\"function\":{\"name\":\"history_read\",\"arguments\":\"{\\\"event\\\":\\\"original\\\",\\\"offset\\\":20,\\\"characters\\\":5}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    if chat_stream_accept(state and delta) is not equal to 0 or else chat_stream_accept(state and "[DONE]") is not equal to 0 or else chat_stream_finish(state and "eof") is not equal to 0 or else agent_generation_publish(database and "run" and "session" and "request" and state and "0") is not equal to 0:
        return 1
    if agent_tool_step(database and "run") is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0 or else agent_tool_step(database and "run") is not equal to 0:
        display "FAIL: dispatch."
        return 1
    set row to agent_run_read(database and "run")
    if not (ptr_to_str(get_list(row and 2)) equals "ready"):
        return 1
    set messages to agent_run_messages(database and "run")
    set response_row to archive_read_event(database and "request:response")
    if response_row equals 0:
        return 1
    set suffix to agent_run_messages_after(database and "run" and http_decimal(ptr_to_str(get_list(response_row and 7))))
    set suffix_tokens to provider_json_tokens(suffix)
    if suffix_tokens equals 0:
        return 1
    set suffix_items to provider_items(suffix_tokens and 0)
    if suffix_items equals 0 or else length_list(suffix_items) is not equal to 3:
        display "FAIL: compaction split a tool exchange."
        return 1
    set message_tokens to provider_json_tokens(messages)
    if message_tokens equals 0:
        display "FAIL: request reconstruction."
        return 1
    set items to provider_items(message_tokens and 0)
    if items equals 0 or else length_list(items) is not equal to 4:
        return 1
    set tool_message to get_list(items and 3)
    if not (provider_value(message_tokens and provider_member(message_tokens and tool_message and "role")) equals "tool") or else not (provider_value(message_tokens and provider_member(message_tokens and tool_message and "tool_call_id")) equals "read"):
        return 1
    set searched to archive_read_event(database and "request:call:0:result")
    set read to archive_read_event(database and "request:call:1:result")
    if searched equals 0 or else read equals 0:
        return 1
    set tokens to provider_json_tokens(ptr_to_str(get_list(searched and 3)))
    set result to provider_member(tokens and 0 and "result")
    if not (provider_value(tokens and provider_member(tokens and result and "event")) equals "original"):
        return 1
    set tokens to provider_json_tokens(ptr_to_str(get_list(read and 3)))
    set result to provider_member(tokens and 0 and "result")
    if not (provider_value(tokens and provider_member(tokens and result and "text")) equals "café "):
        display "FAIL: exact Unicode excerpt."
        return 1
    if not (provider_value(tokens and provider_member(tokens and result and "characters")) equals "5") or else not (provider_value(tokens and provider_member(tokens and result and "total_characters")) equals "26") or else not (provider_value(tokens and provider_member(tokens and result and "next_offset")) equals "25"):
        display "FAIL: excerpt cursor must count returned Unicode characters."
        return 1
    set tail to provider_json_tokens(history_tool_execute(database and "session" and "history_read" and "{\"event\":\"original\",\"offset\":25,\"characters\":100}"))
    if not (provider_value(tail and provider_member(tail and 0 and "text")) equals "🌍") or else not (provider_value(tail and provider_member(tail and 0 and "characters")) equals "1") or else not (provider_value(tail and provider_member(tail and 0 and "next_offset")) equals "26"):
        return 1
    set ended to provider_json_tokens(history_tool_execute(database and "session" and "history_read" and "{\"event\":\"original\",\"offset\":26,\"characters\":100}"))
    if not (provider_value(ended and provider_member(ended and 0 and "characters")) equals "0") or else not (provider_value(ended and provider_member(ended and 0 and "next_offset")) equals "26"):
        return 1
    set isolated to provider_json_tokens(history_tool_execute(database and "session" and "history_read" and "{\"event\":\"private\",\"offset\":0,\"characters\":100}"))
    if not (provider_value(isolated and provider_member(isolated and 0 and "status")) equals "end"):
        return 1
    set invalid to provider_json_tokens(history_tool_execute(database and "session" and "history_read" and "{\"event\":\"private\",\"offset\":0,\"characters\":100,\"session\":\"other\"}"))
    if not (provider_value(invalid and provider_member(invalid and 0 and "status")) equals "invalid-arguments"):
        return 1
    if agent_tool_step(database and "run") equals 0 or else agent_run_claim_tool(database and "run" and "search") equals 0:
        return 1
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 1
    if not (agent_run_messages(database and "run") equals messages) or else sql_close(database) is not equal to 0:
        display "FAIL: transcript changed after reopening."
        return 1
    display "PASS: archive tools execute through durable claims, isolate sessions, resume ready, reject re-execution and reconstruct identical correlated model messages after reopening."
    return 0
