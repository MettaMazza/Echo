import "../../app/lifecycle/tool_registration_archive"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set entry to file_read(get_argument(1))
    set root_path to get_argument(2)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and root_path)
    if root < 0:
        return 2
    for each name in ["good","damaged"]:
        set child to workspace_directory_open(library and root and ptr_to_str(name) and 1)
        if child < 0:
            return 3
        set closed to net_close(child)
    set closed to net_close(root)
    set released to ep_dlclose(library)
    set good to concat(root_path and "/good")
    set damaged to concat(root_path and "/damaged")
    if not (tool_registration_archive(entry and good) equals "archived-data-not-execution-authority") or else not (tool_registration_archive(entry and good) equals "archived-data-not-execution-authority"):
        return 4
    if not (tool_registration_archive(entry and damaged) equals "archived-data-not-execution-authority"):
        return 5
    set path to concat(damaged and concat("/" and concat(ep_sha256(entry) and "/tool.ep")))
    set changed to file_write(path and "damaged archival fixture")
    if not (tool_registration_archive(entry and damaged) equals "archive-copy-failed") or else not (file_read(path) equals "damaged archival fixture"):
        return 6
    set fields to provider_json_tokens(entry)
    set manifest to provider_json_tokens(provider_value(fields and provider_member(fields and 0 and "manifest_text")))
    set source to provider_value(fields and provider_member(fields and 0 and "source_path"))
    if not (ep_sha256(file_read(source)) equals provider_value(manifest and provider_member(manifest and 0 and "source_sha256"))):
        return 7
    display "PASS: versioned archive preserves exact source/binary/manifest/receipt, retries identically, rejects changed retained bytes without overwriting them, and leaves working source intact. Archive bytes confer no execution authority."
    return 0
