import "../../app/tools/tool_candidate_files"
import "../../app/agent/tool_dispatch"
import "../fixtures/generation_fixture"

# Scripted requests exercise the real parser, authority checks, guardian,
# compiler, sandbox and archive. No actual-model authoring is claimed here.
define build_mode_step with database as Int and step as Int and name as Str and arguments as Str returning Int:
    set identity to concat("step-" and int_to_string(step))
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "candidate-run" and identity and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    repeat while archive_list_text(agent_run_read(database and "candidate-run") and 2) equals "tools":
        if agent_tool_step(database and "candidate-run") is not equal to 0:
            return 2
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_run_schema(database) equals "applied"):
        return 2
    for each name in ["a","b"]:
        if web_pairing_invite(database and name) is not equal to 0 or else web_device_pair(database and name and name and name and concat(name and "-secret")) is not equal to 0:
            return 3
    if not (group_create(database and "a" and "g" and "local" and "server" and "room" and "origin") equals "created") or else not (group_change(database and "a" and "invite" and "g" and "device:b" and "invited" and 1) equals "recorded") or else not (group_change(database and "b" and "join" and "g" and "device:b" and "joined" and 2) equals "recorded") or else not (group_session_create(database and "a" and "shared" and "g" and "local" and "server" and "room" and 3) equals "created"):
        return 4
    if not (group_run_submit(database and "b" and "candidate-run" and "shared" and "local" and "server" and "room" and "Create a shared plot and workbook.") equals "accepted"):
        return 5
    if build_mode_step(database and 0 and "workspace_plot" and "{\"path\":\"shared.svg\",\"plot\":{\"title\":\"Shared plot\",\"x_label\":\"X\",\"y_label\":\"Y\",\"series\":[{\"name\":\"A\",\"kind\":\"scatter\",\"points\":[[1,2],[2,3]]}]}}") is not equal to 0:
        return 10
    if build_mode_step(database and 1 and "workspace_create_workbook" and "{\"path\":\"shared.xlsx\",\"sheets\":[{\"name\":\"Data\",\"rows\":[[\"name\",\"value\"],[\"sample\",42]]}]}") is not equal to 0:
        return 11
    if build_mode_step(database and 2 and "workspace_read_workbook" and "{\"path\":\"shared.xlsx\",\"sheet\":\"Data\",\"offset\":0,\"cells\":10}") is not equal to 0:
        return 12
    set observed to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='candidate-run' AND json_extract(e.payload,'$.result.status') IN ('created','found');"))
    if not (archive_list_text(observed and 1) equals "3") or else archive_verify(database and "shared") is not equal to 0:
        return 20
    display "PASS: authenticated shared dispatcher created a plot, created a workbook and read its cells with intact provenance."
    return sql_close(database)
