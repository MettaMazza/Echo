import "../../app/tools/tool_candidate_files"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set root_path to get_argument(1)
    set manifest to file_read(get_argument(2))
    if not (tool_candidate_files_check(root_path and manifest) equals "candidate-bytes-verified-not-evaluated"):
        return 2
    set tokens to provider_json_tokens(manifest)
    set artifact_digest to provider_value(tokens and provider_member(tokens and 0 and "artifact_sha256"))
    set changed to ptr_to_str(string_replace(manifest and artifact_digest and ep_sha256("wrong artifact")))
    if not (tool_candidate_files_check(root_path and changed) equals "artifact:bytes-changed"):
        return 3
    set changed to ptr_to_str(string_replace(manifest and "fixture.ep" and "fixture.py"))
    if not (tool_candidate_files_check(root_path and changed) equals "ernos-source-required"):
        return 4
    for each path in ["../fixture.ep", "/fixture.ep", "nested/../fixture.ep", "", "alias.ep", "hard.ep", "pipe.ep", "directory", "linked/fixture.ep", "missing.ep"]:
        set checked to tool_candidate_file_digest(root_path and ptr_to_str(path))
        if archive_list_text(checked and 0) equals "verified":
            return 5
    set source to concat(root_path and "/fixture.ep")
    set original to file_read(source)
    if write_file(source and "Changed source.") is not equal to 1 or else not (tool_candidate_files_check(root_path and manifest) equals "source:bytes-changed"):
        return 6
    if write_file(source and original) is not equal to 1 or else not (tool_candidate_files_check(root_path and manifest) equals "candidate-bytes-verified-not-evaluated"):
        return 7
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and root_path)
    set descriptor to workspace_file_open(library and root and "descriptor.ep" and 0)
    set closed to net_close(root)
    set move to ep_dlsym(library and "rename")
    if descriptor < 0 or else move equals 0:
        return 8
    if ep_dlcall2(move and str_to_ptr(concat(root_path and "/descriptor.ep")) and str_to_ptr(concat(root_path and "/retained.ep"))) is not equal to 0 or else ep_dlcall2(move and str_to_ptr(concat(root_path and "/replacement.ep")) and str_to_ptr(concat(root_path and "/descriptor.ep"))) is not equal to 0:
        return 9
    set retained to file_digest_owned_descriptor(library and descriptor and 65536 and 1)
    if not (archive_list_text(retained and 0) equals "verified") or else not (archive_list_text(retained and 1) equals ep_sha256(original)):
        return 10
    display "PASS: exact source/artifact bytes, changed-byte rejection, Ernos source requirement, traversal/link/special-file denial, restoration and opened-inode hashing after pathname replacement. No candidate executed."
    return 0
