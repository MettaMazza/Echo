import "../../app/tools/tool_candidate_files"
import "../../app/agent/tool_dispatch"
import "../fixtures/generation_fixture"

# Scripted requests exercise the real parser, authority checks, guardian,
# compiler, sandbox and archive. No actual-model authoring is claimed here.
define build_mode_step with database as Int and step as Int and name as Str and arguments as Str returning Int:
    set identity to concat("step-" and int_to_string(step))
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and concat(provider_quote(identity) and concat(",\"function\":{\"name\":" and concat(provider_quote(name) and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))))))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "candidate-run" and identity and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0:
        return 1
    repeat while archive_list_text(agent_run_read(database and "candidate-run") and 2) equals "tools":
        if agent_tool_step(database and "candidate-run") is not equal to 0:
            return 2
    return 0

define database_fixture_output with database as Int and step as Int returning Str:
    set values to [concat("step-" and int_to_string(step))]
    set output to history_collect_one(checkpoint_prepare(database and "SELECT group_concat(data,'') FROM (SELECT json_extract(payload,'$.data') AS data FROM echo_events WHERE kind='process_output' AND json_extract(payload,'$.call_id')=?1 AND json_extract(payload,'$.stream')='stdout' ORDER BY sequence);" and values))
    return execution_decode_hex(database and archive_list_text(output and 1))

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "author" and "Database fixture" and "fixture-secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "author" and "candidate-run" and "" and "Exercise local database workflow.")
    if build_mode_step(database and 0 and "workspace_database" and "{\"path\":\"sample.sqlite\",\"sql\":\"CREATE TABLE sample(label TEXT,n INTEGER,b BLOB,empty TEXT); INSERT INTO sample VALUES('café',9223372036854775807,x'0001ff',NULL); SELECT * FROM sample;\"}") is not equal to 0:
        return 10
    if build_mode_step(database and 1 and "workspace_database" and "{\"path\":\"sample.sqlite\",\"sql\":\"BEGIN; INSERT INTO sample(label) VALUES('rolled-back');\"}") is not equal to 0:
        return 11
    if build_mode_step(database and 2 and "workspace_database" and "{\"path\":\"sample.sqlite\",\"sql\":\"SELECT count(*) AS rows FROM sample;\"}") is not equal to 0:
        return 12
    if build_mode_step(database and 3 and "workspace_database" and "{\"path\":\"sample.sqlite\",\"sql\":\"SELECT 1; SELECT * FROM nonexistent;\"}") is not equal to 0:
        return 13
    if build_mode_step(database and 4 and "workspace_database" and "{\"path\":\"sample.sqlite\",\"sql\":\"ATTACH DATABASE '/private/tmp/echo-database-outside-qualification.sqlite' AS outside;\"}") is not equal to 0:
        return 14
    if build_mode_step(database and 5 and "workspace_database" and "{\"path\":\"sample.sqlite\",\"sql\":\"SELECT CAST(x'610062' AS TEXT) AS binary_text;\"}") is not equal to 0:
        return 15
    set successful to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='candidate-run' AND t.call_id IN ('step-0','step-2','step-5') AND json_extract(e.payload,'$.result.wait_status')='0';"))
    set failed to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='candidate-run' AND t.call_id IN ('step-1','step-3','step-4') AND json_extract(e.payload,'$.result.wait_status')='256';"))
    if not (archive_list_text(successful and 1) equals "3") or else not (archive_list_text(failed and 1) equals "3"):
        return 20
    set output to database_fixture_output(database and 0)
    for each expected in ["café","9223372036854775807","0001ff","\"type\":\"null\"","\"kind\":\"complete\""]:
        if string_contains(output and expected) equals 0:
            display output
            return 21
    if string_contains(database_fixture_output(database and 1) and "transaction-rolled-back") equals 0 or else string_contains(database_fixture_output(database and 2) and "\"value\":\"1\"") equals 0 or else string_contains(database_fixture_output(database and 3) and "nonexistent") equals 0 or else string_contains(database_fixture_output(database and 5) and "610062") equals 0:
        return 22
    if archive_verify(database and archive_list_text(submitted and 1)) is not equal to 0:
        return 23
    display "PASS: scoped SQL create/query persistence, exact integers/UTF-8/blob/null/binary text, explicit rollback, partial script error and outside attachment denial."
    return sql_close(database)
