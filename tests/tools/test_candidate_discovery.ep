import "../fixtures/tool_call_fixture"
import "../../app/tools/candidate_discovery"

# Receives a disposable archive produced by the actual registry save regression.
define main returning Int:
    if get_argument_count() is not equal to 2 or else not file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else not (principal_host_revocation(database and "restore-catalog-admin" and "device:admin" and 0 and "fixture") equals "recorded"):
        return 2
    if not (principal_host_role(database and "restore-catalog-role" and "device:admin" and "admin" and "fixture") equals "recorded"):
        return 17
    set found to tool_fixture_call(database and "admin" and "candidate-query" and "tool_candidates" and "{\"query\":\"FIXTURE_TOOL\",\"after\":0}")
    set tokens to provider_json_tokens(found)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found") or else not (provider_value(tokens and provider_member(tokens and 0 and "catalog")) equals "saved-candidates-not-activated") or else not (provider_kind(tokens and provider_member(tokens and 0 and "runnable")) equals "false"):
        display found
        return 3
    set manifest to provider_value(tokens and provider_member(tokens and 0 and "manifest_text"))
    if not (ep_sha256(manifest) equals provider_value(tokens and provider_member(tokens and 0 and "digest"))):
        return 4
    set after to history_tool_integer(tokens and "next_after")
    set arguments to concat("{\"query\":\"\",\"after\":" and concat(int_to_string(after) and "}"))
    set next to candidate_discovery_execute(database and "candidate-query" and arguments)
    set next_tokens to provider_json_tokens(next)
    if not (provider_value(next_tokens and provider_member(next_tokens and 0 and "status")) equals "found") or else history_tool_integer(next_tokens and "next_after") <= after:
        return 5
    if not (candidate_discovery_execute(database and "candidate-query" and "{\"query\":\"\",\"after\":0,\"principal\":\"device:guest\"}") equals "{\"status\":\"invalid-arguments\"}"):
        return 6
    if web_pairing_invite(database and "outsider") is not equal to 0 or else web_device_pair(database and "outsider" and "outsider" and "Outsider" and "fixture-secret") is not equal to 0 or else not (principal_host_role(database and "outsider-admin" and "device:outsider" and "admin" and "fixture") equals "recorded"):
        return 7
    set hidden to tool_fixture_call(database and "outsider" and "outside-query" and "tool_candidates" and "{\"query\":\"\",\"after\":0}")
    set hidden_tokens to provider_json_tokens(hidden)
    if not (provider_value(hidden_tokens and provider_member(hidden_tokens and 0 and "status")) equals "end"):
        return 8
    if not (group_create(database and "admin" and "g" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "admin" and "shared" and "g" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "admin" and "shared-query" and "shared" and "discord" and "server" and "room" and "Search shared candidates") equals "accepted"):
        return 9
    set shared to tool_fixture_call(database and "admin" and "shared-query" and "tool_candidates" and "{\"query\":\"\",\"after\":0}")
    set shared_tokens to provider_json_tokens(shared)
    if not (provider_value(shared_tokens and provider_member(shared_tokens and 0 and "status")) equals "end"):
        return 10
    if sql_close(database) is not equal to 0:
        return 11
    set database to archive_open(get_argument(1))
    if not (candidate_discovery_execute(database and "candidate-query" and "{\"query\":\"FIXTURE_TOOL\",\"after\":0}") equals found):
        # The fixture's JSON extraction may normalize structured manifest spacing;
        # compare the canonical manifest text instead of formatting the envelope.
        set again to provider_json_tokens(candidate_discovery_execute(database and "candidate-query" and "{\"query\":\"FIXTURE_TOOL\",\"after\":0}"))
        if not (provider_value(again and provider_member(again and 0 and "manifest_text")) equals manifest):
            return 12
    if sql_execute(database and "DROP TRIGGER echo_tool_candidates_no_update; UPDATE echo_tool_candidates SET manifest=manifest||' ' WHERE sequence=1;") is not equal to 0:
        return 13
    if not (candidate_discovery_execute(database and "candidate-query" and "{\"query\":\"\",\"after\":0}") equals "{\"status\":\"candidate-integrity-error\"}"):
        return 14
    if sql_execute(database and "UPDATE echo_tool_candidates SET manifest=substr(manifest,1,length(manifest)-1) WHERE sequence=1; CREATE TRIGGER echo_tool_candidates_no_update BEFORE UPDATE ON echo_tool_candidates BEGIN SELECT RAISE(ABORT,'Tool candidate versions are immutable'); END;") is not equal to 0:
        return 16
    if not (principal_host_revocation(database and "revoke-catalog-admin" and "device:admin" and 1 and "fixture") equals "recorded") or else not (candidate_discovery_execute(database and "candidate-query" and "{\"query\":\"\",\"after\":0}") equals "{\"status\":\"not-authorized\"}"):
        return 15
    display "PASS: actual candidate discovery dispatch, exact manifest bytes/digest, version paging, case-insensitive search, foreign and shared-scope isolation, restart, corruption rejection and revocation. Candidates remain explicitly not runnable."
    return sql_close(database)
