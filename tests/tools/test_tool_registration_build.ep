import "../../app/lifecycle/tool_registration_build"

define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set fixture to provider_json_tokens(file_read(get_argument(1)))
    set manifest to provider_value(fixture and provider_member(fixture and 0 and "manifest"))
    set source to provider_value(fixture and provider_member(fixture and 0 and "source"))
    set plan to provider_value(fixture and provider_member(fixture and 0 and "build_plan"))
    set stage to get_argument(2)
    set work to get_argument(3)
    set report_path to get_argument(4)
    set admitted to ["authorized",manifest,"device:fixture","","save-call"]
    set denied to tool_registration_build(admitted and concat(source and "changed") and plan and ep_sha256(plan) and stage and work and 10000)
    if not (archive_list_text(denied and 0) equals "candidate-source-changed"):
        return 2
    set built to tool_registration_build(admitted and source and plan and ep_sha256(plan) and stage and work and 10000)
    if not (archive_list_text(built and 0) equals "qualified-build"):
        display archive_list_text(built and 0)
        return 3
    set proof to archive_list_text(built and 4)
    set tokens to provider_json_tokens(proof)
    if tokens equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "qualified") or else not (provider_value(tokens and provider_member(tokens and 0 and "artifact_sha256")) equals archive_list_text(built and 3)) or else not (provider_value(tokens and provider_member(tokens and 0 and "principal")) equals "device:fixture"):
        return 4
    set wrote to file_write(report_path and proof)
    display "PASS: exact Ernos source independently compiled by the pinned runtime, isolated JSON/Unicode cases executed, source substitution denied, qualification bound to owner/manifest/source/artifact. Publication and rights approval are separate."
    return 0
