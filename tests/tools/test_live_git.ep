import "../../app/agent/runner"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (tool_authority_schema(database) equals "applied") or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    if not (principal_host_role(database and "grant" and "device:owner" and "admin" and "Git model fixture") equals "recorded"):
        return 10
    set instruction to concat("Use host_git on the disposable repository " and concat(get_argument(4) and ". Inspect its latest commit subject and source.ep from HEAD, reading actual stdout with workspace_output_next. Create branch echo-model-review from HEAD and verify that it exists. Do not change files, commit, push or use another repository. Finally report the exact source marker you read, followed by git-workflow-complete."))
    set submitted to web_submit_owned(database and "owner" and "git-run" and "" and instruction)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "git-run" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set executions to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='git-run' AND json_extract(q.payload,'$.name')='host_git' AND json_extract(e.payload,'$.result.status')='complete' AND json_extract(e.payload,'$.result.wait_status')='0';"))
    if string_to_int(archive_list_text(executions and 1)) < 3:
        return 6
    set final to agent_run_read(database and "git-run")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if string_contains(archive_list_text(reply and 3) and "git-workflow-complete") equals 0 or else string_contains(archive_list_text(reply and 3) and "git-canary-cobalt-418") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual admin model inspected Git history/source, created a branch and reported file-only evidence with an intact event chain."
    return sql_close(database)
