import "../../app/agent/runner"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set instruction to "Use workspace_create_text to create calculate.ep with exactly this plain-English Ernos code:\nimport \"math\"\ndefine main returning Int:\n    display int_to_string(power(2 and 10))\n    display \"ernos-calculation-cedar\"\n    return 0\n\nThen use workspace_build with path calculate.ep and mode compile to compile it. Read its stdout/stderr with workspace_output_next and confirm Self-hosted compilation successful!, not just process exit. Then run the produced program using workspace_execute with program calculate and arguments []. Read its stdout with workspace_output_next. Only after observing 1024 and ernos-calculation-cedar in actual process output, reply ernos-build-and-run-complete. Do not use a shell or another programming language."
    set submitted to web_submit_owned(database and "owner" and "ernos-program" and "" and instruction)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "ernos-program" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set executions to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='ernos-program' AND (json_extract(q.payload,'$.name')='workspace_build' OR (json_extract(q.payload,'$.name')='workspace_execute' AND json_extract(json_extract(q.payload,'$.arguments'),'$.program') IN ('calculate','./calculate'))) AND json_extract(e.payload,'$.result.status')='complete' AND json_extract(e.payload,'$.result.wait_status')='0';"))
    set output to history_collect_one(archive_prepare(database and "SELECT group_concat(data,'') FROM (SELECT json_extract(payload,'$.data') AS data FROM echo_events WHERE kind='process_output' AND json_extract(payload,'$.stream')='stdout' ORDER BY sequence);"))
    if string_to_int(archive_list_text(executions and 1)) < 2 or else string_contains(archive_list_text(output and 1) and "313032340a65726e6f732d63616c63756c6174696f6e2d63656461720a") equals 0 or else string_contains(archive_list_text(output and 1) and "53656c662d686f7374656420636f6d70696c6174696f6e207375636365737366756c21") equals 0:
        return 6
    set final to agent_run_read(database and "ernos-program")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if string_contains(archive_list_text(reply and 3) and "ernos-build-and-run-complete") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual model wrote Ernos source, compiled through the isolated guardian with math standard library, ran its binary, read the computed result and archived exact stdout/exit evidence."
    return sql_close(database)
