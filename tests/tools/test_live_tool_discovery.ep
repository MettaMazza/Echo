import "../../app/security/group_speech"
import "../../app/agent/runner"

# All decisions and calls in this fixture come from the installed primary model.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_speech_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "fixture") is not equal to 0 or else web_device_pair(database and "fixture" and "fixture" and "Fixture" and "fixture-secret") is not equal to 0:
        return 3
    set message to "This is an isolated tool-reuse acceptance test. First use tool_search to discover history_read. Then use the existing history_read tool to reread this original message (event discovery-run:user). Do not create another tool. In your final reply report the discovered tool name and its capability, and quote the exact marker from the reread result: café-lighthouse-7319."
    set submitted to web_submit_owned(database and "fixture" and "discovery-run" and "" and message)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "discovery-run" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    display concat("Actual primary-model tool reuse status: " and status)
    if not (status equals "completed"):
        return 5
    set discovery to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='discovery-run' AND json_extract(q.payload,'$.name')='tool_search' AND json_extract(e.payload,'$.result.status')='found' AND json_extract(e.payload,'$.result.schema.function.name')='history_read';"))
    set reused to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='discovery-run' AND json_extract(q.payload,'$.name')='history_read' AND json_extract(e.payload,'$.result.status')='found' AND instr(e.payload,'café-lighthouse-7319')>0;"))
    if string_to_int(archive_list_text(discovery and 1)) < 1 or else string_to_int(archive_list_text(reused and 1)) < 1:
        return 6
    set session to archive_list_text(submitted and 1)
    set finished to agent_run_read(database and "discovery-run")
    set reply to archive_read_event(database and archive_list_text(finished and 3))
    if reply equals 0 or else string_contains(archive_list_text(reply and 3) and "café-lighthouse-7319") equals 0 or else archive_verify(database and session) is not equal to 0:
        return 7
    if sql_close(database) is not equal to 0:
        return 8
    set database to archive_open(get_argument(1))
    if not (agent_loop(database and "discovery-run" and get_argument(2) and 1 and 2048 and -1 and 65536) equals "completed"):
        return 9
    display "PASS: actual primary model discovered history_read, reused it to reread the original marker, completed the same run and reopened without repeating inference. No scripted model decisions."
    return sql_close(database)
