import "../../app/tools/tool_registry"
import "../../app/web/run_store"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set manifest to file_read(get_argument(2))
    if tool_candidate_manifest_valid(manifest) is not equal to 1:
        return 2
    for each name in ["history_read", "../escape", "UPPER", "1first", "", "a-b"]:
        if tool_candidate_name_valid(ptr_to_str(name)) is not equal to 0:
            return 3
    for each invalid in ["{}", "[]", "{\"name\":\"a\",\"name\":\"b\"}"]:
        if tool_candidate_manifest_valid(ptr_to_str(invalid)) is not equal to 0:
            return 4
    for each replacement in ["unknown.capability", "", "host.superuser"]:
        set malformed to ptr_to_str(string_replace(manifest and "workspace.read" and ptr_to_str(replacement)))
        if tool_candidate_manifest_valid(malformed) is not equal to 0:
            return 16
    set malformed to ptr_to_str(string_replace(manifest and "fixture_tool" and "history_read"))
    if tool_candidate_manifest_valid(malformed) is not equal to 0:
        return 17
    set malformed to concat(ptr_to_str(substring(manifest and 0 and string_length(manifest) - 1)) and ",\"approved\":true}")
    if tool_candidate_manifest_valid(malformed) is not equal to 0:
        return 18
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (ptr_to_str(tool_registry_schema(database)) equals "applied"):
        return 5
    for each name in ["admin", "guest"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 6
    if not (principal_host_role(database and "grant" and "device:admin" and "admin" and "fixture") equals "recorded"):
        return 7
    set admin to web_submit_owned(database and "admin" and "admin-run" and "" and "Author tool.")
    set guest to web_submit_owned(database and "guest" and "guest-run" and "" and "Author tool.")
    if not (tool_candidate_save(database and "guest-run" and manifest) equals "not-authorized") or else not (tool_candidate_save(database and "missing" and manifest) equals "not-authorized"):
        return 8
    if not (tool_candidate_save(database and "admin-run" and manifest) equals "candidate-saved-not-activated") or else not (tool_candidate_save(database and "admin-run" and manifest) equals "candidate-already-saved-not-activated"):
        return 9
    if not (tool_candidate_save(database and "admin-run" and concat(manifest and " ")) equals "version-conflict"):
        return 10
    set next_version to ptr_to_str(string_replace(manifest and "\"version\": 1" and "\"version\": 2"))
    if not (tool_candidate_save(database and "admin-run" and next_version) equals "candidate-saved-not-activated"):
        return 19
    if sql_execute(database and "UPDATE echo_tool_candidates SET name='changed';") equals 0 or else sql_execute(database and "DELETE FROM echo_tool_candidates;") equals 0:
        return 11
    if sql_close(database) is not equal to 0:
        return 12
    set database to archive_open(get_argument(1))
    if not (ptr_to_str(tool_registry_schema(database)) equals "already-applied") or else not (tool_candidate_save(database and "admin-run" and manifest) equals "candidate-already-saved-not-activated"):
        return 13
    set saved to history_collect_one(archive_prepare(database and "SELECT manifest,digest,(SELECT COUNT(*) FROM echo_tool_candidates) FROM echo_tool_candidates WHERE version=1;"))
    if not (archive_list_text(saved and 1) equals manifest) or else not (archive_list_text(saved and 2) equals ep_sha256(manifest)) or else not (archive_list_text(saved and 3) equals "2"):
        return 14
    if not (principal_host_revocation(database and "revoke" and "device:admin" and 1 and "fixture") equals "recorded") or else not (tool_candidate_save(database and "admin-run" and manifest) equals "not-authorized"):
        return 15
    display "PASS: candidate manifests persist exact bytes and hashes, reject builtin shadowing, enforce author authority, retain immutable versions, survive reopen and deny revocation. Candidates are not activated tools."
    return sql_close(database)
