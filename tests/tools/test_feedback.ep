import "../../app/feedback"

# Preserve actual effects and error codes, including unknown outcomes. This
# contract is shared by tool receipts, HTTP failures and worker diagnostics.
define main returning Int:
    set original to "{\"status\":\"write-failed\",\"effects\":\"partial-file-created\",\"recovery\":\"Inspect partial.csv before retry.\",\"receipt\":\"test-reference\"}\n"
    set result to feedback_enrich(original and "Save file" and "test-call")
    set tokens to provider_json_tokens(result)
    if tokens equals 0:
        return 1
    set feedback to provider_member(tokens and 0 and "feedback")
    if not (provider_value(tokens and provider_member(tokens and feedback and "effects")) equals "partial-file-created") or else not (provider_value(tokens and provider_member(tokens and feedback and "recovery")) equals "Inspect partial.csv before retry."):
        return 2
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "write-failed") or else not (provider_value(tokens and provider_member(tokens and feedback and "reference")) equals "test-call"):
        return 3
    if not (feedback_enrich(result and "Again" and "other") equals result):
        return 4
    set success to "{\"status\":\"complete\",\"wait_status\":\"0\"}"
    if not (feedback_enrich(success and "Execute" and "success") equals success):
        return 5
    for each status in ["materialized","already-materialized","applied"]:
        set admitted to concat("{\"status\":" and concat(provider_quote(status) and ",\"execution\":\"Admission is not completion.\"}"))
        if not (feedback_enrich(admitted and "delegate_task" and "accepted") equals admitted):
            return 12
    set failed to feedback_enrich("{\"status\":\"complete\",\"wait_status\":\"256\",\"stdout_event\":\"original-output\"}" and "Execute" and "exit")
    if string_contains(failed and "process-exit-nonzero") equals 0 or else string_contains(failed and "workspace_output_next") equals 0 or else string_contains(failed and "original-output") equals 0:
        return 6
    set unknown to feedback_enrich("{\"status\":\"unexpected-failure\"}" and "Operation" and "unknown")
    if string_contains(unknown and "Not established") equals 0 or else string_contains(unknown and "Inspect the retained diagnostic") equals 0:
        return 7
    set remote to feedback_enrich("{\"status\":\"complete\",\"transfer\":{\"hops\":[{\"transfer\":{\"http_status\":\"403\",\"curl_code\":\"0\"}}]}}" and "Fetch" and "remote")
    if string_contains(remote and "remote-request-failed") equals 0 or else provider_json_tokens(remote) equals 0:
        return 8
    set challenge to feedback_enrich("{\"status\":\"search-challenge\",\"receipt\":\"retained-challenge\"}" and "web_search" and "search")
    if string_contains(challenge and "no search results were obtained") equals 0 or else string_contains(challenge and "official site/API") equals 0 or else string_contains(challenge and "Not established") or else string_contains(challenge and "retained-challenge") equals 0:
        return 13
    set missing to feedback_enrich("{\"status\":\"not-found\",\"effects\":\"none\",\"explanation\":\"No note has this exact name.\",\"recovery\":\"List notes then read the returned name.\"}" and "scratchpad" and "note")
    if string_contains(missing and "No note has this exact name.") equals 0 or else string_contains(missing and "List notes then read") equals 0:
        return 9
    display "PASS: failures preserve codes, original evidence, effects and recovery; nonzero exits are not success; unknown effects remain explicit; enrichment is valid and idempotent."
    return 0
