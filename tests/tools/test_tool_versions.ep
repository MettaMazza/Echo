import "../../app/tools/tool_versions"

define version_test_state with document as Str and principal as Str and digest as Str returning Str:
    set tokens to provider_json_tokens(document)
    set entries to provider_items(tokens and provider_member(tokens and 0 and "entries"))
    for each entry in entries:
        if provider_value(tokens and provider_member(tokens and entry and "principal")) equals principal and provider_value(tokens and provider_member(tokens and entry and "manifest_sha256")) equals digest:
            return provider_value(tokens and provider_member(tokens and entry and "state"))
    return ""

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set fixture_text to file_read(get_argument(1))
    set fixture to provider_json_tokens(fixture_text)
    set one to agent_json_source(fixture_text and fixture and provider_member(fixture and 0 and "one"))
    set two to agent_json_source(fixture_text and fixture and provider_member(fixture and 0 and "two"))
    set other to agent_json_source(fixture_text and fixture and provider_member(fixture and 0 and "other"))
    set one_tokens to provider_json_tokens(one)
    set two_tokens to provider_json_tokens(two)
    set first_digest to provider_value(one_tokens and provider_member(one_tokens and 0 and "manifest_sha256"))
    set second_digest to provider_value(two_tokens and provider_member(two_tokens and 0 and "manifest_sha256"))
    set empty to "{\"format\":1,\"revision\":0,\"entries\":[]}"
    if tool_versions_valid(empty) is not equal to 1:
        return 2
    set first to tool_versions_append(empty and ep_sha256(empty) and one)
    if tool_versions_valid(first) is not equal to 1 or else not (version_test_state(first and "owner" and first_digest) equals "dormant"):
        return 3
    if string_length(tool_versions_append(first and ep_sha256(first) and one)) > 0 or else string_length(tool_versions_append(first and ep_sha256(empty) and two)) > 0:
        return 4
    set active to tool_versions_select(first and ep_sha256(first) and "owner" and "" and first_digest and "active")
    if not (version_test_state(active and "owner" and first_digest) equals "active"):
        return 5
    set next to tool_versions_append(active and ep_sha256(active) and two)
    set selected to tool_versions_select(next and ep_sha256(next) and "owner" and "" and second_digest and "active")
    if not (version_test_state(selected and "owner" and first_digest) equals "dormant") or else not (version_test_state(selected and "owner" and second_digest) equals "active"):
        return 6
    set retained to tool_versions_append(selected and ep_sha256(selected) and other)
    set restored to tool_versions_select(retained and ep_sha256(retained) and "owner" and "" and first_digest and "active")
    if not (version_test_state(restored and "owner" and first_digest) equals "active") or else not (version_test_state(restored and "owner" and second_digest) equals "dormant") or else not (version_test_state(restored and "other" and first_digest) equals "dormant"):
        return 7
    if string_length(tool_versions_select(restored and ep_sha256(retained) and "owner" and "" and first_digest and "active")) > 0 or else string_length(tool_versions_select(restored and ep_sha256(restored) and "foreign" and "" and first_digest and "active")) > 0 or else string_length(tool_versions_select(restored and ep_sha256(restored) and "owner" and "shared-session" and first_digest and "active")) > 0:
        return 8
    set quarantined to tool_versions_select(restored and ep_sha256(restored) and "owner" and "" and first_digest and "quarantined")
    if not (version_test_state(quarantined and "owner" and first_digest) equals "quarantined") or else not (version_test_state(quarantined and "owner" and second_digest) equals "dormant"):
        return 9
    set retired to tool_versions_select(quarantined and ep_sha256(quarantined) and "owner" and "" and first_digest and "retired")
    if not (version_test_state(retired and "owner" and first_digest) equals "retired"):
        return 10
    set invalid to ptr_to_str(string_replace(retired and "\"state\":\"dormant\"" and "\"state\":\"approved-by-model\""))
    if tool_versions_valid(invalid) is not equal to 0:
        return 11
    set invalid to ptr_to_str(string_replace(retired and first_digest and ep_sha256("changed manifest")))
    if tool_versions_valid(invalid) is not equal to 0:
        return 12
    set records to provider_json_tokens(retired)
    set entries to provider_items(records and provider_member(records and 0 and "entries"))
    if length_list(entries) is not equal to 3 or else not (provider_value(records and provider_member(records and get_list(entries and 0) and "manifest_text")) equals provider_value(one_tokens and provider_member(one_tokens and 0 and "manifest_text"))):
        return 13
    display "PASS: registry document version insertion, duplicate/preimage rejection, scoped selection, rollback, quarantine, retirement, retained manifest bytes and corruption rejection. Pure document preparation only; no qualification, publication or executable loading is claimed."
    return 0
