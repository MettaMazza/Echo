import "../../app/security/group_speech"
import "../../app/tools/tool_discovery"
import "../../app/agent/tool_dispatch"
import "../fixtures/generation_fixture"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (group_speech_schema(database) equals "applied"):
        return 2
    for each name in ["user","admin"]:
        set device to ptr_to_str(name)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat(device and "-secret")) is not equal to 0:
            return 3
    if not (principal_host_role(database and "grant-admin" and "device:admin" and "admin" and "fixture") equals "recorded"):
        return 4
    set user_run to web_submit_owned(database and "user" and "user-run" and "" and "Discover available tools.")
    set admin_run to web_submit_owned(database and "admin" and "admin-run" and "" and "Discover available tools.")
    set query to "{\"query\":\"host_read_text\",\"after\":0,\"catalog_digest\":\"\"}"
    if not (tool_discovery_execute(database and "missing-run" and query) equals "{\"status\":\"not-authorized\"}"):
        return 15
    set ordinary to tool_discovery_execute(database and "user-run" and query)
    set elevated to tool_discovery_execute(database and "admin-run" and query)
    if not (provider_value(provider_json_tokens(ordinary) and provider_member(provider_json_tokens(ordinary) and 0 and "status")) equals "end") or else string_contains(ordinary and "host_read_text") is not equal to 0 or else string_contains(elevated and "host_read_text") equals 0:
        return 5
    set upper to ptr_to_str(string_replace(query and "host_read_text" and "HOST_READ_TEXT"))
    if not (tool_discovery_execute(database and "admin-run" and upper) equals elevated):
        return 17
    set admin_tokens to provider_json_tokens(elevated)
    set contract to provider_member(admin_tokens and 0 and "contract")
    if not (provider_value(admin_tokens and provider_member(admin_tokens and contract and "minimum_role")) equals "admin"):
        return 18
    set cursor to 0
    set digest to ""
    set count to 0
    repeat while 1 equals 1:
        set request to concat("{\"query\":\"\",\"after\":" and concat(int_to_string(cursor) and concat(",\"catalog_digest\":" and concat(provider_quote(digest) and "}"))))
        set found to tool_discovery_execute(database and "user-run" and request)
        set tokens to provider_json_tokens(found)
        set status to provider_value(tokens and provider_member(tokens and 0 and "status"))
        if status equals "end":
            break
        if not (status equals "found") or else string_contains(found and "host_read_text") is not equal to 0:
            return 6
        set contract to provider_member(tokens and 0 and "contract")
        set schema_index to provider_member(tokens and 0 and "schema")
        set exact_schema to agent_json_source(found and tokens and schema_index)
        set function_index to provider_member(tokens and schema_index and "function")
        set exact_name to provider_value(tokens and provider_member(tokens and function_index and "name"))
        set exact_request to concat("{\"query\":" and concat(provider_quote(exact_name) and ",\"after\":0,\"catalog_digest\":\"\"}"))
        set exact_result to tool_discovery_execute(database and "user-run" and exact_request)
        set exact_tokens to provider_json_tokens(exact_result)
        set exact_entry to provider_member(exact_tokens and 0 and "schema")
        set exact_function to provider_member(exact_tokens and exact_entry and "function")
        set returned_name to provider_value(exact_tokens and provider_member(exact_tokens and exact_function and "name"))
        if not (returned_name equals exact_name):
            display exact_result
            return 19
        if not (provider_value(tokens and provider_member(tokens and contract and "schema_sha256")) equals ep_sha256(exact_schema)) or else not (provider_value(tokens and provider_member(tokens and contract and "minimum_role")) equals "user") or else string_length(provider_value(tokens and provider_member(tokens and contract and "recovery"))) equals 0:
            return 16
        set next to history_tool_integer(tokens and "next_after")
        if next <= cursor:
            return 7
        set cursor to next
        set digest to provider_value(tokens and provider_member(tokens and 0 and "catalog_digest"))
        set count to count + 1
    set schemas to provider_json_tokens(session_tool_schemas_owned(database and "user-run"))
    if count is not equal to length_list(provider_items(schemas and 0)):
        return 8
    if not (tool_discovery_execute(database and "user-run" and "{\"query\":\"\",\"after\":1,\"catalog_digest\":\"wrong\"}") equals "{\"status\":\"catalog-changed\",\"recovery\":\"Restart discovery at after=0 with an empty catalog_digest.\"}") or else not (tool_discovery_execute(database and "user-run" and "{\"query\":\"\",\"after\":0,\"catalog_digest\":\"\",\"role\":\"admin\"}") equals "{\"status\":\"invalid-arguments\"}"):
        return 9
    for each name in ["workspace_read_workbook", "workspace_create_workbook", "workspace_edit_workbook"]:
        set found to tool_discovery_execute(database and "user-run" and concat("{\"query\":" and concat(provider_quote(ptr_to_str(name)) and ",\"after\":0,\"catalog_digest\":\"\"}")))
        if string_length(get_env("ECHO_WORKSPACE_ROOT")) equals 0:
            if not (provider_value(provider_json_tokens(found) and provider_member(provider_json_tokens(found) and 0 and "status")) equals "end"):
                return 17
        else if string_contains(found and "libarchive") equals 0 or else string_contains(found and "libxml2") equals 0 or else string_contains(found and "native file hashing") equals 0:
            display found
            return 17
    set contract to tool_contract("workspace_edit_workbook" and "{}")
    if string_contains(contract and "source-changed") equals 0 or else string_contains(contract and "unselected entry payloads") equals 0:
        return 18
    set listener to local_socket_listen(0)
    set arguments to "{\"query\":\"history_read\",\"after\":0,\"catalog_digest\":\"\"}"
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"discover\",\"function\":{\"name\":\"tool_search\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and "user-run" and "request" and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    if generated is not equal to 0 or else served is not equal to 0 or else agent_tool_step(database and "user-run") is not equal to 0:
        return 10
    set result to history_collect_one(archive_prepare(database and "SELECT json_extract(e.payload,'$.result.status'),json_extract(e.payload,'$.result.schema.function.name') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run='user-run' AND t.call_id='discover';"))
    if not (archive_list_text(result and 1) equals "found") or else not (archive_list_text(result and 2) equals "history_read"):
        return 11
    if not (principal_host_revocation(database and "revoke-admin" and "device:admin" and 1 and "fixture") equals "recorded") or else not (tool_discovery_execute(database and "admin-run" and query) equals "{\"status\":\"not-authorized\"}"):
        return 12
    set closed to local_socket_close(listener)
    if sql_close(database) is not equal to 0:
        return 13
    set database to archive_open(get_argument(1))
    if not (tool_discovery_execute(database and "admin-run" and query) equals "{\"status\":\"not-authorized\"}"):
        return 14
    display "PASS: loaded-tool discovery matches authority-filtered inference schemas, pages every entry, binds cursor digest, rejects forged authority, dispatches with an archived result, and preserves revocation after reopen."
    return sql_close(database)
