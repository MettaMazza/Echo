import "../../app/agent/runner"
import "../../app/jobs/delegation_schema"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 3
    set instruction to "Use workspace_plot to create trend.svg: title Measured trend, x_label Time, y_label Value, one line series named Sample with points [[0,1],[1,3],[2,2],[3,5]]. Then use attach_file with path trend.svg and media_type image/svg+xml so I can see it in chat. Only after both tools succeed, reply plot-attached-complete."
    set submitted to web_submit_owned(database and "owner" and "plot-run" and "" and instruction)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 4
    set status to agent_loop(database and "plot-run" and get_argument(2) and string_to_int(get_argument(3)) and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return 5
    set plots to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events e ON e.event=t.result_event WHERE t.run='plot-run' AND json_extract(q.payload,'$.name')='workspace_plot' AND json_extract(e.payload,'$.result.status')='created';"))
    set files to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_attachments WHERE media_type='image/svg+xml' AND bytes>0;"))
    if not (archive_list_text(plots and 1) equals "1") or else not (archive_list_text(files and 1) equals "1"):
        return 6
    set final to agent_run_read(database and "plot-run")
    set reply to archive_read_event(database and archive_list_text(final and 3))
    if string_contains(archive_list_text(reply and 3) and "plot-attached-complete") equals 0 or else archive_verify(database and archive_list_text(final and 0)) is not equal to 0:
        return 7
    display "PASS: actual primary model generated a plot, published its SVG attachment and completed with an intact event chain."
    return sql_close(database)
