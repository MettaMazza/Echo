import "../fixtures/tool_call_fixture"
import "../../app/tools/registered_tools"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set text to file_read(get_argument(2))
    if tool_versions_valid(text) equals 0:
        return 2
    set registry to provider_json_tokens(text)
    set entries to provider_items(registry and provider_member(registry and 0 and "entries"))
    set entry to get_list(entries and 0)
    set digest to provider_value(registry and provider_member(registry and entry and "manifest_sha256"))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else not (ptr_to_str(tool_registry_schema(database)) equals "applied"):
        return 3
    for each value in ["admin", "guest"]:
        set device to ptr_to_str(value)
        if web_pairing_invite(database and device) is not equal to 0 or else web_device_pair(database and device and device and device and concat("fixture-secret:" and device)) is not equal to 0:
            return 4
    if not (principal_host_role(database and "admin-role" and "device:admin" and "admin" and "fixture") equals "recorded"):
        return 5
    set submitted to web_submit_owned(database and "admin" and "owner-run" and "" and "Inspect installed tools.")
    set submitted to web_submit_owned(database and "guest" and "foreign-run" and "" and "Inspect installed tools.")
    if registered_scope_allows(database and "owner-run" and registry and entry) is not equal to 1 or else registered_scope_allows(database and "foreign-run" and registry and entry) is not equal to 0:
        return 6
    if not (registered_entry_role(registry and entry) equals "user") or else registered_entry_find(database and "owner-run" and registry and digest) is not equal to entry or else registered_entry_find(database and "foreign-run" and registry and digest) >= 0:
        return 7
    if not (principal_host_role(database and "foreign-admin-role" and "device:guest" and "admin" and "fixture") equals "recorded"):
        return 8
    set submitted to web_submit_owned(database and "guest" and "foreign-admin-run" and "" and "Inspect installed tools.")
    if registered_scope_allows(database and "foreign-admin-run" and registry and entry) is not equal to 0:
        return 9
    if not (group_create(database and "admin" and "group" and "discord" and "server" and "room" and "fixture") equals "created") or else not (group_session_create(database and "admin" and "shared" and "group" and "discord" and "server" and "room" and 1) equals "created") or else not (group_run_submit(database and "admin" and "shared-run" and "shared" and "discord" and "server" and "room" and "Inspect installed tools") equals "accepted"):
        return 10
    if registered_scope_allows(database and "shared-run" and registry and entry) is not equal to 0:
        return 11
    # A model-written registry/receipt is not a qualified installed registry.
    set configured to set_env("ECHO_TOOL_REGISTRY_PATH" and get_argument(2))
    if not (archive_list_text(tool_versions_installed_read(get_argument(2)) and 0) equals "store-not-protected"):
        return 12
    set arguments to concat("{\"action\":\"load\",\"digest\":" and concat(provider_quote(digest) and "}"))
    set result to tool_fixture_call(database and "admin" and "owner-run" and "tool_load" and arguments)
    set result_tokens to provider_json_tokens(result)
    if not (provider_value(result_tokens and provider_member(result_tokens and 0 and "status")) equals "store-not-protected"):
        display result
        return 13
    if registered_tool_allows(database and "owner-run" and "jobs" and "fixture_tool") is not equal to 0 or else string_length(registered_loaded_schemas(database and "owner-run")) > 0:
        return 14
    set selected to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind IN ('tool_version_selection','process_started');"))
    if not (archive_list_text(selected and 1) equals "0"):
        return 15
    # Lifecycle metadata remains owner-scoped even after quarantine. The real
    # dispatcher must reject an unprotected registry and a non-admin caller.
    set quarantined to tool_versions_select(text and ep_sha256(text) and "device:admin" and "" and digest and "quarantined")
    set quarantine_tokens to provider_json_tokens(quarantined)
    if registered_entry_find(database and "owner-run" and quarantine_tokens and digest) >= 0 or else registered_managed_entry_find(database and "owner-run" and quarantine_tokens and digest) < 0 or else registered_managed_entry_find(database and "foreign-admin-run" and quarantine_tokens and digest) >= 0 or else registered_managed_entry_find(database and "shared-run" and quarantine_tokens and digest) >= 0:
        return 16
    set management to concat("{\"digest\":" and provider_quote(digest))
    set management to concat(management and concat(",\"registry_sha256\":" and provider_quote(ep_sha256(text))))
    set management to concat(management and ",\"action\":\"quarantined\",\"reason\":\"Controlled lifecycle test\"}")
    if registered_manage_arguments_valid(management) equals 0 or else registered_manage_arguments_valid("{}") is not equal to 0 or else registered_manage_arguments_valid(ptr_to_str(string_replace(management and "quarantined" and "execute"))) is not equal to 0:
        return 17
    set result to tool_fixture_call(database and "admin" and "manage-owner-run" and "tool_version_manage" and management)
    set result_tokens to provider_json_tokens(result)
    if not (provider_value(result_tokens and provider_member(result_tokens and 0 and "status")) equals "store-not-protected"):
        display result
        return 18
    if web_pairing_invite(database and "ordinary") is not equal to 0 or else web_device_pair(database and "ordinary" and "ordinary" and "ordinary" and "fixture-secret:ordinary") is not equal to 0:
        return 19
    set result to tool_fixture_call(database and "ordinary" and "manage-guest-run" and "tool_version_manage" and management)
    set result_tokens to provider_json_tokens(result)
    if not (provider_value(result_tokens and provider_member(result_tokens and 0 and "status")) equals "admin-required"):
        display result
        return 20
    if not (file_read(get_argument(2)) equals text):
        return 21
    set configured to set_env("ECHO_TOOL_REGISTRY_PATH" and "")
    display "PASS: registered metadata private-owner scope, foreign/foreign-admin/public denial, explicit execution capability, actual load dispatcher rejection of a caller-writable registry, no schema exposure or process launch. Installed positive qualification/load/execute requires the protected fixture."
    return sql_close(database)
