import "fs"
import "os"
import "../../app/providers/external_discovery_store"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(2))
    if sql_execute(database and "CREATE TABLE echo_principals(identity TEXT PRIMARY KEY,role TEXT,revoked INTEGER); CREATE TABLE echo_devices(device TEXT PRIMARY KEY,revoked INTEGER); CREATE TABLE echo_principal_devices(device TEXT PRIMARY KEY,principal TEXT); INSERT INTO echo_principals VALUES('alice','user',0),('bob','admin',0); INSERT INTO echo_devices VALUES('a',0),('linked',0),('b',0); INSERT INTO echo_principal_devices VALUES('a','alice'),('linked','alice'),('b','bob');") is not equal to 0 or else external_discovery_schema(database) is not equal to 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and get_argument(3))
    set errors to native_open_mode(system and "/dev/null" and 1 and 0)
    if directory < 0 or else errors < 0:
        return 3
    if not (external_account_connect(database and "a" and "account" and "anthropic-messages" and "Fixture" and system and directory and "fixture-secret") equals "connected"):
        return 4
    if not (external_discovery_endpoint("anthropic-messages" and "" and "cursor&next") equals "https://api.anthropic.com/v1/models?after_id=cursor%26next") or else string_length(external_discovery_endpoint("openai-chat" and ".." and "")) > 0 or else string_length(external_discovery_endpoint("openai-chat" and "model" and "cursor")) > 0:
        return 5
    set result to external_account_discover_program(get_argument(1) and database and "linked" and "account" and "list" and "" and "" and system and directory and errors and -1 and 7)
    set original to archive_list_text(result and 0)
    if string_contains(original and "fixture-native") equals 0 or else string_contains(original and "cursor&next") equals 0 or else get_list(result and 1) is not equal to 0:
        display original
        return 6
    set cached to external_account_discover_program("/does-not-exist" and database and "a" and "account" and "list" and "" and "" and system and directory and errors and -1 and 7)
    if not (archive_list_text(cached and 0) equals original):
        return 7
    set denied to external_account_discover_program("/does-not-exist" and database and "b" and "account" and "foreign" and "" and "" and system and directory and errors and -1 and 7)
    if not (archive_list_text(denied and 0) equals "{\"status\":\"not-authorized\"}"):
        return 8
    set conflict to external_account_discover_program("/does-not-exist" and database and "a" and "account" and "list" and "different-model" and "" and system and directory and errors and -1 and 7)
    if string_contains(archive_list_text(conflict and 0) and "discovery-conflict") equals 0:
        return 9
    set page to external_account_discover_program(get_argument(1) and database and "a" and "account" and "page" and "" and "cursor&next" and system and directory and errors and -1 and 7)
    if not (archive_list_text(page and 0) equals "{\"status\":\"found\",\"models\":[],\"next_cursor\":\"\"}"):
        display archive_list_text(page and 0)
        return 10
    for each model in ["rate-limited","failed-child","truncated"]:
        set failed to external_account_discover_program(get_argument(1) and database and "a" and "account" and model and model and "" and system and directory and errors and -1 and 7)
        if string_contains(archive_list_text(failed and 0) and "found") > 0 or else get_list(failed and 1) is not equal to 0:
            return 11
    if not (external_account_connect(database and "a" and "openai-account" and "openai-chat" and "OpenAI fixture" and system and directory and "fixture-secret") equals "connected"):
        return 16
    set openai to external_account_discover_program(get_argument(1) and database and "a" and "openai-account" and "openai-list" and "" and "" and system and directory and errors and -1 and 7)
    if string_contains(archive_list_text(openai and 0) and "accounting-unresolved") equals 0 or else string_contains(archive_list_text(openai and 0) and "fixture-native") equals 0:
        return 17
    set raw to history_collect_one(checkpoint_prepare(database and "SELECT body,digest FROM echo_external_discovery_results WHERE identity=?1;" and ["list"]))
    if not (archive_list_text(raw and 0) equals "found") or else not (ep_sha256(archive_list_text(raw and 1)) equals archive_list_text(raw and 2)):
        return 12
    if not (external_account_revoke(database and "a" and "account") equals "revoked"):
        return 13
    set denied to external_account_discover_program("/does-not-exist" and database and "linked" and "account" and "list" and "" and "" and system and directory and errors and -1 and 7)
    if string_contains(archive_list_text(denied and 0) and "not-authorized") equals 0:
        return 14
    set closed to sql_close(database)
    set database to archive_open(get_argument(2))
    set retained to history_collect_one(checkpoint_prepare(database and "SELECT view FROM echo_external_discovery_results WHERE identity=?1;" and ["list"]))
    if not (archive_list_text(retained and 1) equals original):
        return 15
    set closed to sql_close(database)
    set closed to net_close(directory)
    set closed to net_close(errors)
    set closed to ep_dlclose(system)
    display "PASS: private account discovery, linked owner, foreign admin denial, pagination, durable exact retry, conflict/revocation, raw metadata digest/reopen, HTTP error, nonzero child and truncated response rejection."
    return 0
