import "../../app/providers/registry"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else provider_registry_schema(database) is not equal to 0:
        return 2
    set first to provider_llama_profile("first" and 8080)
    set second to provider_llama_profile("second" and 8081)
    if provider_registry_register(database and "bad" and "Invalid" and "{}") is not equal to 1:
        return 3
    if provider_registry_register(database and "one" and "First" and first) is not equal to 0 or else provider_registry_register(database and "one" and "First" and first) is not equal to 0:
        return 4
    if provider_registry_register(database and "one" and "Changed" and second) is not equal to 2:
        return 5
    if provider_registry_select(database and "missing") is not equal to 1 or else provider_registry_select(database and "one") is not equal to 0:
        return 6
    if provider_registry_register(database and "two" and "Second" and second) is not equal to 0 or else provider_registry_select(database and "two") is not equal to 0 or else provider_registry_select(database and "missing") is not equal to 1:
        return 7
    if sql_close(database) is not equal to 0:
        return 8
    set database to archive_open(get_argument(1))
    set selected to provider_registry_default(database)
    if not (ptr_to_str(get_list(selected and 0)) equals "found"):
        return 9
    if not (ptr_to_str(get_list(selected and 1)) equals "two") or else not (ptr_to_str(get_list(selected and 3)) equals second):
        return 10
    if sql_execute(database and "UPDATE echo_provider_profiles SET label='Changed';") equals 0 or else sql_execute(database and "DELETE FROM echo_provider_profiles;") equals 0:
        return 11
    set original to provider_registry_read(database and "one")
    if not (ptr_to_str(get_list(original and 2)) equals first) or else sql_close(database) is not equal to 0:
        return 12
    display "PASS: immutable provider versions, conflicting retry rejection, validated default selection, failed selection preserves default, reopen persistence and SQL mutation rejection."
    return 0
