import "../../app/providers/archived_stream"

define main returning Int:
    if not (provider_quote("") equals "\"\"") or else not (provider_quote("café 🌍") equals "\"café 🌍\""):
        return 1
    set controls to create_list()
    set index to 0
    repeat while index is less than 4:
        set added to append_list(controls and 0)
        set index to index + 1
    set pointer to get_list_data_ptr(controls)
    set index to 1
    repeat while index is less than 32:
        set written to poke_byte(pointer and index - 1 and index)
        set index to index + 1
    set original to ptr_to_str(pointer)
    set tokens to provider_json_tokens(provider_quote(original))
    if tokens equals 0 or else not (provider_value(tokens and 0) equals original):
        display "FAIL: control-byte round trip"
        return 1
    set source to create_builder()
    set expected to create_builder()
    set added to builder_append(expected and "\"")
    set index to 0
    repeat while index is less than 131072:
        set added to builder_append(source and "café\n\"\\ ")
        set added to builder_append(expected and "café\\u000a\\\"\\\\ ")
        set index to index + 1
    set original to ptr_to_str(builder_to_string(source))
    set added to builder_append(expected and "\"")
    set wanted to ptr_to_str(builder_to_string(expected))
    set started to ep_time_now_ms()
    set actual to provider_quote(original)
    display concat("Quote milliseconds: " and int_to_string(ep_time_now_ms() - started))
    if not (actual equals wanted):
        display "FAIL: large escaped UTF-8 content"
        return 1
    set started to ep_time_now_ms()
    set parsed to provider_json_tokens(actual)
    display concat("Parse milliseconds: " and int_to_string(ep_time_now_ms() - started))
    if parsed equals 0 or else not (provider_value(parsed and 0) equals original):
        display "FAIL: large round trip"
        return 1
    display concat("Source bytes: " and int_to_string(string_length(original)))
    display "PASS: empty and Unicode content, all non-NUL controls, and large mixed escaping exactly preserved."
    return 0
