import "../../app/providers/anthropic_stream"

define main returning Int:
    set state to anthropic_stream_create()
    set status to 0
    set status to status + anthropic_stream_accept(state and "{\"type\": \"message_start\", \"message\": {\"id\": \"msg_fixture\", \"role\": \"assistant\", \"content\": []}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Hello \\ud83c\\udf31\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_stop\",\"index\":0}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\"},\"usage\":{\"output_tokens\":3}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_stop\"}")
    if status is not equal to 0:
        return 10
    set finished to anthropic_stream_finish(state and "eof")
    if finished is not equal to 0:
        return 30
    if not (archive_list_text(anthropic_stream_choice(state) and 1) equals "Hello 🌱"):
        return 50
    set state to anthropic_stream_create()
    set status to 0
    set status to status + anthropic_stream_accept(state and "{\"type\": \"message_start\", \"message\": {\"id\": \"msg_fixture\", \"role\": \"assistant\", \"content\": []}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"call_fixture\",\"name\":\"tool_search\",\"input\":{}}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"query\\\":\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\"read\\\"}\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_stop\",\"index\":0}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_stop\"}")
    if status is not equal to 0:
        return 11
    set finished to anthropic_stream_finish(state and "eof")
    if finished is not equal to 0:
        return 31
    set call to get_list(get_list(anthropic_stream_choice(state) and 3) and 0)
    if not (archive_list_text(call and 3) equals "{\"query\":\"read\"}"):
        return 51
    set state to anthropic_stream_create()
    set status to 0
    set status to status + anthropic_stream_accept(state and "{\"type\": \"message_start\", \"message\": {\"id\": \"msg_fixture\", \"role\": \"assistant\", \"content\": []}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"call_empty\",\"name\":\"list\",\"input\":{}}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_stop\",\"index\":0}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_stop\"}")
    if status is not equal to 0:
        return 12
    set finished to anthropic_stream_finish(state and "eof")
    if finished is not equal to 0:
        return 32
    set call to get_list(get_list(anthropic_stream_choice(state) and 3) and 0)
    if not (archive_list_text(call and 3) equals "{}"):
        return 51
    set state to anthropic_stream_create()
    set status to 0
    set status to status + anthropic_stream_accept(state and "{\"type\": \"message_start\", \"message\": {\"id\": \"msg_fixture\", \"role\": \"assistant\", \"content\": []}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"partial\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_stop\",\"index\":0}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"max_tokens\"}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"message_stop\"}")
    if status is not equal to 0:
        return 13
    set finished to anthropic_stream_finish(state and "eof")
    if finished equals 0:
        return 33
    set state to anthropic_stream_create()
    set status to 0
    set status to status + anthropic_stream_accept(state and "{\"type\": \"message_start\", \"message\": {\"id\": \"msg_fixture\", \"role\": \"assistant\", \"content\": []}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"bad\"}}")
    if status equals 0:
        return 14
    set state to anthropic_stream_create()
    set status to 0
    set status to status + anthropic_stream_accept(state and "{\"type\": \"message_start\", \"message\": {\"id\": \"msg_fixture\", \"role\": \"assistant\", \"content\": []}}")
    set status to status + anthropic_stream_accept(state and "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"fixture\"}}")
    if status equals 0:
        return 15
    set state to anthropic_stream_create()
    set accepted to anthropic_stream_accept(state and "{\"type\":\"message_start\",\"message\":{\"role\":\"assistant\",\"content\":[]}}")
    set accepted to anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}")
    set accepted to anthropic_stream_accept(state and "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\"}}")
    if accepted equals 0:
        return 60
    set state to anthropic_stream_create()
    set accepted to anthropic_stream_accept(state and "{\"type\":\"message_start\",\"message\":{\"role\":\"assistant\",\"content\":[]}}")
    set accepted to anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}")
    if accepted equals 0:
        return 61
    set state to anthropic_stream_create()
    set accepted to anthropic_stream_accept(state and "{\"type\":\"message_start\",\"message\":{\"role\":\"assistant\",\"content\":[]}}")
    set accepted to anthropic_stream_accept(state and "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"x\",\"name\":\"f\",\"input\":{\"keep\":\"me\"}}}")
    set accepted to anthropic_stream_accept(state and "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{}\"}}")
    if accepted equals 0:
        return 62
    set state to anthropic_stream_create()
    set accepted to anthropic_stream_accept(state and "{\"type\":\"message_start\",\"message\":{\"role\":\"assistant\",\"content\":[]}}")
    if anthropic_stream_finish(state and "eof") equals 0:
        return 70
    display "PASS: Messages text, fragmented and empty tool inputs, limited completion, ordering and provider error."
    return 0
