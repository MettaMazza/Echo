import "../../app/providers/llama_preflight"
import "fs"

# Recount a real archived request without generation or a synthetic tokenizer.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(3)):
        return 1
    set source to archive_open(get_argument(1))
    set event to archive_read_event(source and get_argument(2))
    if event equals 0 or else archive_verify(source and ptr_to_str(get_list(event and 0))) is not equal to 0:
        return 2
    set envelope to provider_json_tokens(ptr_to_str(get_list(event and 3)))
    set body to provider_value(envelope and provider_member(envelope and 0 and "request_body"))
    if sql_close(source) is not equal to 0:
        return 3
    set database to archive_open(get_argument(3))
    if database equals 0:
        return 4
    set decision to llama_preflight(database and "admission" and "live-preflight" and http_decimal(get_argument(4)) and body and 1 and -1 and 65536)
    if not (ptr_to_str(get_list(decision and 0)) equals "ready"):
        display ptr_to_str(get_list(decision and 0))
        return 5
    set capacity to get_list(decision and 1)
    set input to get_list(decision and 3)
    set available to get_list(decision and 4)
    if available is not equal to capacity - input or else available is less than 1:
        return 6
    display concat("Provider context: " and int_to_string(capacity))
    display concat("Exact input tokens: " and int_to_string(input))
    display concat("Available output: " and int_to_string(available))
    if archive_verify(database and "admission") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 7
    display "PASS: live provider discovery, exact recount and durable evidence through shared context admission."
    return 0
