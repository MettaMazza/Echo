import "../../app/providers/openai_responses_stream"

define main returning Int:
    set start to "{\"type\":\"response.created\",\"sequence_number\":0,\"response\":{\"id\":\"resp_fixture\",\"status\":\"in_progress\",\"output\":[]}}"
    set done to "{\"type\":\"response.completed\",\"sequence_number\":3,\"response\":{\"id\":\"resp_fixture\",\"status\":\"completed\",\"usage\":{\"input_tokens\":23,\"output_tokens\":9},\"output\":[{\"type\":\"reasoning\",\"id\":\"rs_fixture\",\"encrypted_content\":\"opaque+/==\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"Reviewed\"}]},{\"type\":\"message\",\"id\":\"msg_fixture\",\"status\":\"completed\",\"role\":\"assistant\",\"phase\":\"commentary\",\"content\":[{\"type\":\"output_text\",\"text\":\"hé🌍\",\"annotations\":[]}]},{\"type\":\"function_call\",\"id\":\"fc_fixture\",\"call_id\":\"call-fixture\",\"name\":\"measure\",\"status\":\"completed\",\"arguments\":\"{\\\"n\\\":1.2300}\"}]}}"
    set state to openai_responses_stream_create()
    if openai_responses_stream_accept(state and start) is not equal to 0 or else openai_responses_stream_accept(state and "{\"type\":\"response.function_call_arguments.delta\",\"sequence_number\":1,\"delta\":\"partial\"}") is not equal to 0:
        return 1
    if length_list(get_list(get_list(state and 0) and 0)) is not equal to 0 or else openai_responses_stream_finish(state and "eof") equals 0:
        return 2
    if openai_responses_stream_accept(state and done) is not equal to 0 or else openai_responses_stream_finish(state and "eof") is not equal to 0:
        return 3
    set choice to get_list(get_list(get_list(state and 0) and 0) and 0)
    if not (archive_list_text(choice and 1) equals "hé🌍") or else not (archive_list_text(choice and 2) equals "Reviewed") or else not (archive_list_text(choice and 4) equals "tool_calls"):
        return 4
    set call to get_list(get_list(choice and 3) and 0)
    if not (archive_list_text(call and 1) equals "call-fixture") or else not (archive_list_text(call and 3) equals "{\"n\":1.2300}") or else not (archive_list_text(get_list(state and 3) and 2) equals done):
        return 5
    for each bad in [start,"{\"type\":\"response.failed\",\"sequence_number\":1}","{\"type\":\"response.incomplete\",\"sequence_number\":1}","{\"type\":\"response.completed\",\"sequence_number\":1,\"response\":{\"id\":\"other\",\"status\":\"completed\",\"output\":[]}}"]:
        set failed to openai_responses_stream_create()
        set accepted to openai_responses_stream_accept(failed and start)
        if openai_responses_stream_accept(failed and bad) equals 0 or else openai_responses_stream_finish(failed and "eof") equals 0:
            return 6
    set truncated to openai_responses_stream_create()
    set accepted to openai_responses_stream_accept(truncated and start)
    set accepted to openai_responses_stream_accept(truncated and done)
    if openai_responses_stream_finish(truncated and "cancelled") equals 0:
        return 7
    display "PASS: completed Responses text/tool normalization, exact encrypted/phase/usage originals, no executable partial calls, sequence/identity/failure/incomplete/cancelled rejection."
    return 0
