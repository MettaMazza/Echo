import "../../app/providers/llama_preflight"
import "../../app/providers/local_chat"
import "fs"
import "../../app/discord/turn_guard"
import "../../app/discord/cancel_control"

# Intentional new qualification attempt using an exact previously saved body.
# A new destination archive and request identity keep this separate from crash
# recovery. Used to compare cached context with the first fresh-context run.
define main returning Int:
    if get_argument_count() is not equal to 6:
        display "Supply source archive, source request event, new destination archive, local port and workload reserve."
        return 1
    if not file_exists(get_argument(1)) or else file_exists(get_argument(3)):
        return 1
    set port to http_decimal(get_argument(4))
    set reserve to http_decimal(get_argument(5))
    if port is less than 1 or else port is greater than 65535 or else reserve is less than 1:
        return 1
    set source to archive_open(get_argument(1))
    if source equals 0:
        return 1
    set event to archive_read_event(source and get_argument(2))
    if event equals 0 or else not (ptr_to_str(get_list(event and 2)) equals "model_request") or else archive_verify(source and ptr_to_str(get_list(event and 0))) is not equal to 0:
        return 1
    set tokens to provider_json_tokens(ptr_to_str(get_list(event and 3)))
    set field to provider_member(tokens and 0 and "request_body")
    if tokens equals 0 or else not (provider_kind(tokens and field) equals "string"):
        return 1
    set body to provider_value(tokens and field)
    if sql_close(source) is not equal to 0:
        return 1
    set database to archive_open(get_argument(3))
    if database equals 0:
        return 1
    set decision to llama_preflight(database and "qualification-replay" and "preflight" and port and body and reserve and -1 and 65536)
    if not (ptr_to_str(get_list(decision and 0)) equals "ready"):
        display ptr_to_str(get_list(decision and 0))
        return 1
    set payload to concat("{\"run_id\":\"qualification-replay\",\"request_body\":" and concat(provider_quote(body) and "}"))
    if archive_append(database and "qualification-replay" and "request" and "model_request" and payload and "live") is not equal to 0:
        return 1
    display concat("Input tokens: " and int_to_string(get_list(decision and 3)))
    set journal_path to concat(get_argument(3) and ".journal")
    set journal to discord_store_open(journal_path and "900")
    if journal equals 0 or else discord_worker_schema(journal) is not equal to 0:
        return 2
    set closed to sql_close(journal)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set cancellation to socket_cancellation_create(library)
    set stop to socket_cancellation_create(library)
    set completed to channel
    set monitor_path to concat(journal_path and "")
    set stop_path to concat(journal_path and ".stop")
    spawn discord_turn_monitor(monitor_path and "900" and 0 and "100" and "300" and "200" and stop_path and get_list(stop and 0) and get_list(cancellation and 1) and completed)
    set started to ep_time_now_ms()
    set result to local_chat_generate(database and "qualification-replay" and "request" and port and "/v1/chat/completions" and body and get_list(cancellation and 0) and 65536)
    set closed to net_close(get_list(stop and 1))
    set monitor_result to receive from completed
    set closed to net_close(get_list(cancellation and 0))
    if monitor_result is not equal to 0:
        return 3
    display concat("Status: " and ptr_to_str(get_list(result and 0)))
    display concat("Elapsed milliseconds: " and int_to_string(ep_time_now_ms() - started))
    if not (ptr_to_str(get_list(result and 0)) equals "complete") or else archive_verify(database and "qualification-replay") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    return 0
