import "../../app/providers/external_model_info"

define main returning Int:
    set body to "{\"id\":\"native-canonical\",\"type\":\"model\",\"max_input_tokens\":123456,\"max_tokens\":7890,\"capabilities\":{\"effort\":{\"max\":{\"supported\":true}},\"image_input\":{\"supported\":false},\"extension\":{\"original\":1.2300}},\"future_field\":\"retained\"}"
    set result to external_model_info("anthropic-messages" and body)
    if not (archive_list_text(result and 0) equals "discovered") or else not (archive_list_text(result and 1) equals "native-canonical") or else get_list(result and 2) is not equal to 123456 or else get_list(result and 3) is not equal to 7890 or else not (archive_list_text(result and 5) equals body):
        return 1
    set capabilities to archive_list_text(result and 4)
    if not (external_model_capability(capabilities and ["effort","max"]) equals "supported") or else not (external_model_capability(capabilities and ["image_input"]) equals "unsupported") or else not (external_model_capability(capabilities and ["pdf_input"]) equals "unreported") or else string_contains(capabilities and "1.2300") equals 0:
        return 2
    set result to external_model_info("openai-chat" and "{\"id\":\"native-openai\",\"object\":\"model\",\"created\":1,\"owned_by\":\"provider\"}")
    if not (archive_list_text(result and 0) equals "accounting-unresolved") or else get_list(result and 2) is not equal to -1 or else get_list(result and 3) is not equal to -1:
        return 3
    for each invalid in ["{\"id\":\"a\",\"id\":\"b\",\"type\":\"model\"}","{\"id\":3,\"type\":\"model\"}","[]"]:
        if not (archive_list_text(external_model_info("anthropic-messages" and invalid) and 0) equals "invalid-model-metadata"):
            return 4
    for each unresolved in ["{\"id\":\"a\",\"type\":\"model\"}","{\"id\":\"a\",\"type\":\"model\",\"max_input_tokens\":0,\"max_tokens\":2,\"capabilities\":{}}","{\"id\":\"a\",\"type\":\"model\",\"max_input_tokens\":123.5,\"max_tokens\":2,\"capabilities\":{}}"]:
        if not (archive_list_text(external_model_info("anthropic-messages" and unresolved) and 0) equals "accounting-unresolved"):
            return 5
    display "PASS: native model identity and limits, exact metadata preservation, supported/unsupported/unreported capabilities, absent accounting never guessed."
    return 0
