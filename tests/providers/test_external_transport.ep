import "fs"
import "os"
import "../../app/providers/external_transport"
import "../../app/transport/native_open"
import "../../app/transport/http_body"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    if string_length(external_transport_headers("anthropic-messages" and "bad\nheader")) > 0 or else string_length(external_transport_headers("unknown" and "key")) > 0 or else external_transport_arguments("openai-chat" and "relative") is not equal to 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to native_open_mode(system and get_argument(2) and 0 and 0)
    set errors to native_open_mode(system and "/dev/null" and 1 and 0)
    set database to archive_open(get_argument(3))
    if directory < 3 or else errors < 3 or else database equals 0:
        return 3
    set path to concat(get_argument(2) and "/transport-body.fixture")
    if write_file(path and "{}") is not equal to 1:
        return 4
    for each family in ["openai-chat","anthropic-messages"]:
        set transfer to external_transport_start_program(get_argument(1) and family and "fixture-private-key" and path and directory and errors and -1)
        if not (archive_list_text(transfer and 0) equals "streaming"):
            return 5
        set reader to get_list(transfer and 2)
        set head to http_response_head(reader and "POST")
        if not (archive_list_text(head and 0) equals "ready") or else get_list(head and 1) is not equal to 200:
            return 6
        set framed to http_body_create(archive_list_text(head and 2) and get_list(head and 3))
        set received to 0
        repeat while 1 equals 1:
            set piece to http_body_next(reader and framed and 65536)
            if archive_list_text(piece and 0) equals "done":
                break
            if not (archive_list_text(piece and 0) equals "data"):
                return 7
            set received to received + get_list(piece and 2)
        if received is not equal to 14 or else not (external_transport_finish(database and "fixture" and family and transfer and 1) equals "complete"):
            return 8
    if write_file(path and "FAIL") is not equal to 1:
        return 14
    set transfer to external_transport_start_program(get_argument(1) and "openai-chat" and "fixture-private-key" and path and directory and errors and -1)
    if not (archive_list_text(transfer and 0) equals "streaming"):
        return 15
    set reader to get_list(transfer and 2)
    set head to http_response_head(reader and "POST")
    if not (archive_list_text(head and 0) equals "ready"):
        return 16
    set framed to http_body_create(archive_list_text(head and 2) and get_list(head and 3))
    repeat while 1 equals 1:
        set piece to http_body_next(reader and framed and 65536)
        if archive_list_text(piece and 0) equals "done":
            break
        if not (archive_list_text(piece and 0) equals "data"):
            return 17
    if not (external_transport_finish(database and "fixture" and "failed-transfer" and transfer and 1) equals "helper-failed"):
        return 18
    set cancellation to socket_cancellation_create(system)
    set cancelled to socket_cancel(cancellation)
    set denied to external_transport_start_program(get_argument(1) and "openai-chat" and "fixture-private-key" and path and directory and errors and get_list(cancellation and 0))
    if not (archive_list_text(denied and 0) equals "cancelled-before-launch"):
        return 9
    set closed to socket_cancellation_close(cancellation)
    set cancellation to socket_cancellation_create(system)
    if write_file(path and "STALL") is not equal to 1:
        return 10
    set transfer to external_transport_start_program(get_argument(1) and "openai-chat" and "fixture-private-key" and path and directory and errors and get_list(cancellation and 0))
    if not (archive_list_text(transfer and 0) equals "streaming"):
        return 11
    set head to http_response_head(get_list(transfer and 2) and "POST")
    if not (archive_list_text(head and 0) equals "ready"):
        return 12
    set cancelled to socket_cancel(cancellation)
    if not (external_transport_finish(database and "fixture" and "cancelled-transfer" and transfer and 1) equals "cancelled"):
        return 13
    set closed to socket_cancellation_close(cancellation)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    set closed to sql_close(database)
    display "PASS: both upstream header families, private stdin credentials, raw HTTP stream, zero-exit join, prelaunch cancellation and stalled-child cancellation/reaping."
    return 0
