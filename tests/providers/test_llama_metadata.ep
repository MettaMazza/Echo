import "../../app/providers/llama_metadata"

define main returning Int:
    set models to "{\"data\":[{\"id\":\"fixture\",\"meta\":{\"n_ctx\":262144,\"n_ctx_train\":262144}}]}"
    set props to "{\"default_generation_settings\":{\"n_ctx\":262144,\"params\":{\"n_predict\":-1}}}"
    set metadata to llama_metadata_parse(models and props and "fixture")
    if not (ptr_to_str(get_list(metadata and 0)) equals "ready") or else get_list(metadata and 2) is not equal to 262144 or else get_list(metadata and 4) is not equal to -1:
        return 1
    if context_loaded_at_maximum(get_list(metadata and 3) and get_list(metadata and 2)) is not equal to 1:
        return 1
    set mismatch to llama_metadata_parse(models and "{\"default_generation_settings\":{\"n_ctx\":4096,\"params\":{\"n_predict\":-1}}}" and "fixture")
    if not (ptr_to_str(get_list(mismatch and 0)) equals "invalid-metadata"):
        return 1
    set reduced to llama_metadata_parse("{\"data\":[{\"id\":\"fixture\",\"meta\":{\"n_ctx\":4096,\"n_ctx_train\":262144}}]}" and "{\"default_generation_settings\":{\"n_ctx\":4096,\"params\":{\"n_predict\":100}}}" and "fixture")
    if not (ptr_to_str(get_list(reduced and 0)) equals "ready") or else context_loaded_at_maximum(get_list(reduced and 3) and get_list(reduced and 2)) is not equal to 0 or else get_list(reduced and 4) is not equal to 100:
        return 1
    set missing to llama_metadata_parse(models and "{}" and "fixture")
    if not (ptr_to_str(get_list(missing and 0)) equals "invalid-metadata"):
        return 1
    if llama_input_count("{\"input_tokens\":12345,\"object\":\"response.input_tokens\"}") is not equal to 12345 or else llama_input_count("{\"input_tokens\":1.5}") is not equal to -1 or else llama_input_count("{\"input_tokens\":1,\"input_tokens\":2}") is not equal to -1:
        return 1
    if context_request_fits(262144 and 262140 and 0 and 0 and 5) is not equal to 0:
        return 1
    display "PASS: discovered loaded/training context, configured output limit, mismatch/missing rejection, maximum-context comparison and exact native input-token counts."
    return 0
