import "../../app/providers/mlx_discovery"

define main returning Int:
    set health to "{\"status\":\"ok\"}"
    set models to "{\"data\":[{\"id\":\"/local/model\"}]}"
    if not (mlx_discovery_check(health and models and "/local/model") equals "ready"):
        return 1
    if not (mlx_discovery_check(health and models and "/different/model") equals "model-unavailable"):
        return 2
    if not (mlx_discovery_check("{\"status\":\"unavailable\"}" and models and "/local/model") equals "provider-unavailable"):
        return 3
    if not (mlx_discovery_check(health and "{\"data\":[{\"id\":\"x\"},{\"id\":\"x\"}]}" and "x") equals "ambiguous-model-identity"):
        return 4
    if not (mlx_discovery_check(health and "{\"data\":[{\"id\":\"x\",\"id\":\"y\"}]}" and "x") equals "invalid-provider-metadata"):
        return 5
    if not (mlx_discovery_check(health and "{}" and "x") equals "invalid-provider-metadata"):
        return 6
    display "PASS: available model identity, unavailable service/model and ambiguous or malformed discovery rejection."
    return 0
