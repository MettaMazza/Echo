import "fs"
import "../../app/providers/attachment_image"
import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Inspect attached image")
    set session to ptr_to_str(get_list(submitted and 1))
    if web_attachment_register(database and "owner" and session and "image" and get_argument(2) and "fixture.png" and "image/png") is not equal to 0:
        return 1
    if agent_cancel_run(database and "request") is not equal to 0:
        return 1
    set selected to create_list()
    set added to append_list(selected and "image")
    set turn to web_submit_owned_files(database and "owner" and "image-turn" and session and "Inspect this image" and selected)
    if not (ptr_to_str(get_list(turn and 0)) equals "accepted"):
        return 1
    set messages to agent_run_messages(database and "image-turn")
    if string_contains(messages and "data:image/png;base64,") equals 0 or else string_contains(messages and "image:attachment") equals 0:
        return 1
    set objective to archive_read_event(database and "image-turn:user")
    set checkpoint to create_list()
    set added to append_list(checkpoint and "preview")
    set added to append_list(checkpoint and "image-turn:user")
    set added to append_list(checkpoint and get_list(objective and 6))
    set added to append_list(checkpoint and "")
    set added to append_list(checkpoint and "Detailed fixture recap")
    set added to append_list(checkpoint and "{}")
    set rebuilt to session_messages_checkpoint(database and session and "image-turn" and checkpoint)
    if string_contains(rebuilt and "data:image/png;base64,") equals 0 or else string_contains(rebuilt and "Inspect this image") equals 0:
        display "FAIL: active image objective lost across checkpoint boundary"
        return 1
    set part to attachment_image_part(database and session and "image")
    if not (ptr_to_str(get_list(part and 0)) equals "ready") or else not (ptr_to_str(get_list(part and 2)) equals "image:attachment"):
        return 1
    set tokens to provider_json_tokens(ptr_to_str(get_list(part and 1)))
    set uri to provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "image_url") and "url"))
    if not (provider_value(tokens and provider_member(tokens and 0 and "type")) equals "image_url") or else not (ptr_to_str(substring(uri and 0 and 22)) equals "data:image/png;base64,"):
        return 1
    if write_file(concat(get_argument(1) and ".uri") and uri) is not equal to 1:
        return 1
    set foreign to attachment_image_part(database and "foreign" and "image")
    if not (ptr_to_str(get_list(foreign and 0)) equals "not-found") or else string_length(ptr_to_str(get_list(foreign and 1))) is not equal to 0:
        return 1
    set receipt to attachment_image_execute(database and session and "{\"attachment\":\"image\"}")
    if string_contains(receipt and "\"status\":\"ready\"") equals 0 or else string_contains(receipt and "data:image") is not equal to 0 or else string_contains(receipt and get_argument(2)) is not equal to 0:
        return 1
    if not (attachment_image_execute(database and "foreign" and "{\"attachment\":\"image\"}") equals "{\"status\":\"not-found\"}"):
        return 1
    if not (attachment_image_execute(database and session and "{\"attachment\":\"image\",\"path\":\"/private\"}") equals "{\"status\":\"invalid-arguments\"}") or else not (attachment_image_execute(database and session and "{\"attachment\":\"image\",\"attachment\":\"image\"}") equals "{\"status\":\"invalid-arguments\"}"):
        return 1
    if web_device_revoke(database and "owner") is not equal to 0:
        return 1
    set revoked to attachment_image_part(database and session and "image")
    if not (attachment_image_execute(database and session and "{\"attachment\":\"image\"}") equals "{\"status\":\"not-found\"}"):
        return 1
    if not (ptr_to_str(get_list(revoked and 0)) equals "not-found") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: owned inline image part with source receipt, foreign/revoked exclusion and no host path in provider content."
    return 0
