import "os"
import "../../app/web/external_accounts"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else sql_execute(database and "CREATE TABLE echo_sessions(session TEXT PRIMARY KEY); CREATE TABLE echo_principals(identity TEXT PRIMARY KEY,role TEXT,revoked INTEGER); CREATE TABLE echo_devices(device TEXT PRIMARY KEY,revoked INTEGER); CREATE TABLE echo_principal_devices(device TEXT PRIMARY KEY,principal TEXT); CREATE TABLE echo_session_owners(session TEXT PRIMARY KEY,device TEXT); CREATE TABLE echo_runs(run TEXT PRIMARY KEY,session TEXT); CREATE TABLE echo_run_authority(run TEXT PRIMARY KEY,principal TEXT,device TEXT,role TEXT,role_revision INTEGER,revocation_revision INTEGER,link_revision INTEGER); CREATE TABLE echo_authority_events(principal TEXT); CREATE TABLE echo_principal_revocations(principal TEXT); CREATE TABLE echo_device_link_events(device TEXT); INSERT INTO echo_principals VALUES('alice','user',0),('bob','admin',0); INSERT INTO echo_devices VALUES('a',0),('a-linked',0),('b',0); INSERT INTO echo_principal_devices VALUES('a','alice'),('a-linked','alice'),('b','bob'); INSERT INTO echo_sessions VALUES('fresh'),('foreign'); INSERT INTO echo_session_owners VALUES('fresh','a'),('foreign','b');") is not equal to 0:
        return 2
    if external_scope_schema(database) is not equal to 0 or else external_account_schema(database) is not equal to 0:
        return 3
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and get_argument(2))
    if directory < 0 or else external_vault_inode(system and directory and 1) equals 0:
        return 4
    set secret to "fixture-private-key-not-for-logs"
    if not (external_account_connect(database and "a" and "account-a" and "openai-chat" and "Alice API" and system and directory and secret) equals "connected"):
        return 5
    if not (external_account_connect(database and "a-linked" and "account-a" and "openai-chat" and "Alice API" and system and directory and secret) equals "connected"):
        return 6
    if not (external_account_connect(database and "b" and "account-a" and "openai-chat" and "Alice API" and system and directory and secret) equals "account-conflict-or-revoked"):
        return 7
    if not (external_account_connect(database and "a" and "account-a" and "openai-chat" and "Alice API" and system and directory and "different-key") equals "credential-conflict-or-unavailable"):
        return 8
    set metadata to external_account_read(database and "a-linked" and "account-a")
    if not (archive_list_text(metadata and 0) equals "found") or else length_list(metadata) is not equal to 5:
        return 9
    if archive_list_text(external_account_read(database and "b" and "account-a") and 0) equals "found":
        return 10
    set response to web_external_account(database and "a-linked" and provider_json_tokens("{\"action\":\"read\",\"identity\":\"account-a\"}"))
    if string_index_of(response and "connected") < 0 or else string_index_of(response and secret) >= 0:
        return 40
    set response to web_external_account(database and "b" and provider_json_tokens("{\"action\":\"read\",\"identity\":\"account-a\"}"))
    if not (response equals "{\"status\":\"account-unavailable\"}"):
        return 41
    set response to web_external_account(database and "a" and provider_json_tokens("{\"action\":\"read\",\"identity\":\"account-a\",\"device\":\"b\"}"))
    if not (response equals "{\"status\":\"invalid-arguments\"}"):
        return 42
    set response to web_external_account(database and "a" and provider_json_tokens("{\"action\":\"connect\",\"identity\":\"web-account\",\"family\":\"openai-chat\",\"label\":\"Web fixture\",\"key\":\"fixture-key\"}"))
    if not (response equals "{\"status\":\"connected\"}"):
        display response
        return 43
    set listed to web_external_account(database and "a-linked" and provider_json_tokens("{\"action\":\"list\"}"))
    if string_contains(listed and "account-a") equals 0 or else string_contains(listed and secret) is not equal to 0:
        return 44
    set listed to web_external_account(database and "b" and provider_json_tokens("{\"action\":\"list\"}"))
    if string_contains(listed and "account-a") is not equal to 0:
        return 45
    set profile to "{\"adapter\":\"openai-chat\",\"model\":\"fixture\",\"account\":\"account-a\"}"
    if not (external_scope_grant(database and "a" and "fresh" and ep_sha256(profile) and "Fresh provider-only fixture") equals "granted") or else not (external_scope_grant(database and "b" and "foreign" and ep_sha256(profile) and "Foreign owner fixture") equals "granted"):
        return 11
    if sql_execute(database and "INSERT INTO echo_runs VALUES('allowed','fresh'),('foreign','foreign'); INSERT INTO echo_run_authority VALUES('allowed','alice','a','user',0,0,0),('foreign','bob','b','admin',0,0,0);") is not equal to 0:
        return 12
    set resolved to external_account_resolve(database and "allowed" and profile and system and directory)
    if not (archive_list_text(resolved and 0) equals "ready") or else not (archive_list_text(resolved and 1) equals secret):
        display archive_list_text(resolved and 0)
        return 13
    if archive_list_text(external_account_resolve(database and "foreign" and profile and system and directory) and 0) equals "ready":
        return 14
    if archive_list_text(external_account_resolve(database and "allowed" and concat(profile and " ") and system and directory) and 0) equals "ready":
        return 15
    set reference to external_account_reference("alice" and "account-a")
    set file to workspace_file_open(system and directory and reference and 0)
    if file < 0 or else ep_dlcall2(ep_dlsym(system and "fchmod") and file and 420) is not equal to 0:
        return 16
    if archive_list_text(external_account_resolve(database and "allowed" and profile and system and directory) and 0) equals "ready":
        return 17
    if ep_dlcall2(ep_dlsym(system and "fchmod") and file and 384) is not equal to 0 or else net_close(file) is not equal to 0:
        return 18
    set alternate to ep_sha256("fixture-link")
    if ep_dlcall3(ep_dlsym(system and "symlinkat") and str_to_ptr(reference) and directory and str_to_ptr(alternate)) is not equal to 0:
        return 26
    if archive_list_text(external_vault_read(system and directory and alternate and "openai-chat") and 0) equals "ready":
        return 27
    if ep_dlcall3(ep_dlsym(system and "unlinkat") and directory and str_to_ptr(alternate) and 0) is not equal to 0:
        return 28
    if ep_dlcall5(ep_dlsym(system and "linkat") and directory and str_to_ptr(reference) and directory and str_to_ptr(alternate) and 0) is not equal to 0:
        return 29
    if archive_list_text(external_vault_read(system and directory and reference and "openai-chat") and 0) equals "ready":
        return 30
    if ep_dlcall3(ep_dlsym(system and "unlinkat") and directory and str_to_ptr(alternate) and 0) is not equal to 0:
        return 31
    if not (external_account_connect(database and "a" and "bad-header" and "openai-chat" and "Invalid" and system and directory and "key\nInjected: header") equals "invalid-account"):
        return 32
    if sql_execute(database and "CREATE TRIGGER fixture_reject_account BEFORE INSERT ON echo_external_accounts WHEN NEW.identity='interrupted' BEGIN SELECT RAISE(ABORT,'fixture'); END;") is not equal to 0:
        return 33
    if not (external_account_connect(database and "a" and "interrupted" and "anthropic-messages" and "Second protocol" and system and directory and secret) equals "database-error"):
        return 34
    if sql_execute(database and "DROP TRIGGER fixture_reject_account;") is not equal to 0 or else not (external_account_connect(database and "a" and "interrupted" and "anthropic-messages" and "Second protocol" and system and directory and secret) equals "connected"):
        return 35
    if not (external_account_revoke(database and "b" and "account-a") equals "not-authorized") or else not (external_account_revoke(database and "a-linked" and "account-a") equals "revoked"):
        return 19
    if archive_list_text(external_account_resolve(database and "allowed" and profile and system and directory) and 0) equals "ready":
        return 20
    if not (external_account_connect(database and "a" and "account-a" and "openai-chat" and "Alice API" and system and directory and secret) equals "account-conflict-or-revoked"):
        return 21
    if sql_close(database) is not equal to 0:
        return 22
    set database to archive_open(get_argument(1))
    if not (archive_list_text(external_account_read(database and "a" and "account-a") and 4) equals "revoked") or else archive_list_text(external_account_resolve(database and "allowed" and profile and system and directory) and 0) equals "ready":
        return 23
    set row to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_external_accounts WHERE instr(identity,?1)>0 OR instr(principal,?1)>0 OR instr(family,?1)>0 OR instr(label,?1)>0 OR instr(credential_reference,?1)>0;" and [secret]))
    if not (archive_list_text(row and 1) equals "0"):
        return 24
    if sql_close(database) is not equal to 0 or else net_close(directory) is not equal to 0 or else ep_dlclose(system) is not equal to 0:
        return 25
    display "PASS: private durable credential file, owner/linked-device registration and metadata, admin isolation, exact retry, key-change conflict, consent/profile/frozen authority binding, shared-mode/symlink/hard-link denial, header-injection rejection, failed-registration retry, owner-only revocation and reopen; database has no key."
    return 0
