import "../../app/context/clock"

define main returning Int:
    set utc to echo_clock_format(0 and 1)
    if not (utc equals "Thursday, 1970-01-01 00:00:00 GMT (UTC+0000)") and not (utc equals "Thursday, 1970-01-01 00:00:00 UTC (UTC+0000)"):
        display utc
        return 1
    set now to echo_clock_observation(ep_time_now_ms())
    if string_index_of(now and "clock-format-unavailable") >= 0:
        return 1
    display now
    display "PASS: UTC epoch and current host date/time with timezone."
    return 0
