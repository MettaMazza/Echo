import "../../app/providers/llama_preflight"

define admission_status with loaded as Int and supported as Int and input as Int and ceiling as Int and reserve as Int returning Str:
    set result to provider_context_admission(loaded and supported and input and ceiling and reserve)
    return ptr_to_str(get_list(result and 0))

define main returning Int:
    set result to provider_context_admission(262144 and 262144 and 260328 and -1 and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "ready") or else get_list(result and 4) is not equal to 1816:
        return 1
    set finite to provider_context_admission(900000 and 900000 and 100 and 12345 and 12345)
    if not (ptr_to_str(get_list(finite and 0)) equals "ready") or else get_list(finite and 4) is not equal to 12345:
        return 2
    if not (admission_status(900000 and 900000 and 100 and 12345 and 12346) equals "output-capacity-exceeded"):
        return 3
    if not (admission_status(900000 and 900000 and 899999 and 12345 and 2) equals "compaction-required"):
        return 4
    if not (admission_status(900000 and 900000 and 900001 and -1 and 1) equals "compaction-required"):
        return 5
    if not (admission_status(4096 and 900000 and 100 and -1 and 1) equals "context-configuration-required"):
        return 6
    if not (admission_status(900000 and 900000 and 100 and 0 and 1) equals "invalid-metadata"):
        return 7
    if not (admission_status(900000 and 900000 and -1 and -1 and 1) equals "invalid-metadata"):
        return 8
    if not (admission_status(900000 and 900000 and 900000 and -1 and 1) equals "compaction-required"):
        return 9
    set models to "{\"data\":[{\"id\":\"fixture\",\"meta\":{\"n_ctx\":262144,\"n_ctx_train\":262144}}]}"
    set props to "{\"default_generation_settings\":{\"n_ctx\":262144,\"params\":{\"n_predict\":-1}}}"
    set ready to llama_preflight_evaluate(models and props and "{\"input_tokens\":260328}" and "fixture" and 1)
    if not (ptr_to_str(get_list(ready and 0)) equals "ready") or else get_list(ready and 4) is not equal to 1816:
        return 10
    set capped to llama_preflight_evaluate(models and "{\"default_generation_settings\":{\"n_ctx\":262144,\"params\":{\"n_predict\":128}}}" and "{\"input_tokens\":100}" and "fixture" and 1)
    if not (ptr_to_str(get_list(capped and 0)) equals "output-configuration-required"):
        return 11
    display "PASS: exact context room, genuine output ceilings, impossible reserve, compaction boundaries, unknown metadata and configurable-default rejection."
    return 0
