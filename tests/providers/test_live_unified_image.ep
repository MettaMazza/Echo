import "../../app/agent/runner"
import "../../app/web/attachments"
import "fs"

# Live regression: one selected multimodal model answers actual image pixels
# without recording or switching to another provider.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Image retry fixture" and "secret") is not equal to 0:
        return 3
    set initial to web_submit_owned(database and "owner" and "setup" and "" and "Image retry fixture")
    set session to archive_list_text(initial and 1)
    if agent_cancel_run(database and "setup") is not equal to 0 or else web_attachment_register(database and "owner" and session and "image" and get_argument(2) and "two-colours.png" and "image/png") is not equal to 0:
        return 4
    set attachments to ["image"]
    set submitted to web_submit_owned_files(database and "owner" and "image-run" and session and "Name the left half colour and the right half colour. Answer briefly." and attachments)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 5
    set profile to ptr_to_str(read_file(get_argument(3)))
    set second to agent_loop_provider(database and "image-run" and profile and 2048 and -1 and 65536)
    if not (second equals "completed"):
        display second
        return 8
    set row to agent_run_read(database and "image-run")
    set response to archive_read_event(database and archive_list_text(row and 3))
    set fields to provider_json_tokens(archive_list_text(response and 3))
    set answer to provider_value(fields and provider_member(fields and 0 and "content"))
    display answer
    if string_contains(answer and "red") equals 0 or else string_contains(answer and "blue") equals 0:
        return 9
    if not (agent_provider_read(database and "image-run") equals profile) or else archive_read_event(database and "image-run:vision-profile") is not equal to 0 or else archive_verify(database and session) is not equal to 0:
        return 10
    display "PASS: same selected model answered actual pixels without a provider switch; archive verified."
    return sql_close(database)
