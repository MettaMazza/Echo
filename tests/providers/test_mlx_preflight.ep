import "../../app/providers/mlx_preflight"

define main returning Int:
    if get_argument_count() is not equal to 8:
        return 1
    set database to archive_open(get_argument(1))
    set body to ptr_to_str(read_file(get_argument(7)))
    set result to mlx_preflight_local(database and "session" and "preflight" and body and get_argument(3) and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(2) and 1 and -1)
    if not (ptr_to_str(get_list(result and 0)) equals "ready"):
        display ptr_to_str(get_list(result and 0))
        return 2
    if get_list(result and 4) is not equal to get_list(result and 2) - get_list(result and 3):
        return 3
    set decision to archive_read_event(database and "preflight:decision")
    if decision equals 0:
        return 4
    set tokens to provider_json_tokens(ptr_to_str(get_list(decision and 3)))
    if not (provider_value(tokens and provider_member(tokens and 0 and "wire_body")) equals ptr_to_str(get_list(result and 1))):
        return 5
    set repeated to mlx_preflight_local(database and "session" and "preflight" and body and get_argument(3) and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(2) and 1 and -1)
    if not (ptr_to_str(get_list(repeated and 0)) equals "spool-failed"):
        return 6
    set missing to concat(get_argument(3) and ".missing")
    set failed to mlx_preflight_local(database and "session" and "missing-helper" and body and missing and get_argument(4) and get_argument(5) and get_argument(6) and get_argument(2) and 1 and -1)
    if not (ptr_to_str(get_list(failed and 0)) equals "launch-failed") or else get_list(failed and 5) is not equal to 0:
        return 8
    if archive_read_event(database and "missing-helper:decision") equals 0:
        return 9
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 7
    display concat("Exact input tokens: " and int_to_string(get_list(result and 3)))
    display "PASS: full offline MLX preflight, exclusive request spool, exact tokenizer, receipt validation, archived wire decision and duplicate-attempt refusal."
    return 0
