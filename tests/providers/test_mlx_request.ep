import "../../app/providers/mlx_request"
import "fs"

define mlx_test_receipt with body as Str and config as Str and input as Int returning Str:
    set receipt to concat("{\"input_tokens\":" and int_to_string(input))
    set receipt to concat(receipt and concat(",\"request_sha256\":" and provider_quote(ep_sha256(body))))
    set receipt to concat(receipt and concat(",\"configuration_sha256\":" and provider_quote(ep_sha256(config))))
    return concat(receipt and ",\"model_directory\":\"local\"}")

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set config to read_file(get_argument(1))
    set body to "{\"model\":\"local\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Keep exact Unicode: café 🌿\"}]}  "
    set counted to mlx_test_receipt(body and config and 19)
    set result to mlx_prepare_request(body and config and counted and "local" and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "ready"):
        return 2
    set capacity to mlx_context_capacity(config)
    if get_list(result and 4) is not equal to capacity - 19:
        return 3
    set wire to ptr_to_str(get_list(result and 1))
    set expected to ptr_to_str(substring(body and 0 and string_length(body) - 3))
    set expected to concat(expected and ",\"max_completion_tokens\":")
    set expected to concat(expected and int_to_string(capacity - 19))
    set expected to concat(expected and "}  ")
    if not (wire equals expected):
        return 4
    set full to mlx_test_receipt(body and config and capacity)
    set result to mlx_prepare_request(body and config and full and "local" and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "compaction-required"):
        return 5
    set result to mlx_prepare_request(wire and config and "{\"input_tokens\":19}" and "local" and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "explicit-output-policy-required"):
        return 6
    if mlx_context_capacity("{\"max_position_embeddings\":4000,\"text_config\":{\"max_position_embeddings\":8000}}") is not equal to -1:
        return 7
    if mlx_context_capacity("{}") is not equal to -1:
        return 8
    set image to "{\"model\":\"local\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,fixture\"}}]}]}"
    set result to mlx_prepare_request(image and config and "{\"input_tokens\":19}" and "local" and 1)
    if not (ptr_to_str(get_list(result and 0)) equals "unsupported-input-modality"):
        return 9
    set altered to concat(body and " ")
    set stale to mlx_prepare_request(altered and config and counted and "local" and 1)
    if not (ptr_to_str(get_list(stale and 0)) equals "stale-token-receipt"):
        return 10
    set stale to mlx_prepare_request(body and concat(config and " ") and counted and "local" and 1)
    if not (ptr_to_str(get_list(stale and 0)) equals "stale-token-receipt"):
        return 11
    display concat("Configuration context: " and int_to_string(capacity))
    display "PASS: provider-derived output capacity, exact original request bytes, full-context rejection, conflicting caps, ambiguous/missing metadata and unsupported media."
    return 0
