import "../../app/providers/display_delta"

define main returning Int:
    for each event in ["{\"type\":\"response.output_text.delta\",\"delta\":\"hé🌍\"}","{\"type\":\"content_block_start\",\"content_block\":{\"type\":\"text\",\"text\":\"hé🌍\"}}","{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"hé🌍\"}}"]:
        set tokens to provider_json_tokens(event)
        if not (provider_display_delta(tokens and 0) equals "hé🌍") or else string_length(provider_display_delta(tokens and 1)) > 0:
            return 1
    for each event in ["{\"type\":\"response.reasoning_summary_text.delta\",\"delta\":\"summary\"}","{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"thinking_delta\",\"thinking\":\"summary\"}}"]:
        set tokens to provider_json_tokens(event)
        if not (provider_display_delta(tokens and 1) equals "summary") or else string_length(provider_display_delta(tokens and 0)) > 0:
            return 2
    for each event in ["{\"type\":\"response.output_text.done\",\"text\":\"terminal copy\"}","{\"type\":\"response.function_call_arguments.delta\",\"delta\":\"arguments\"}","{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"signature_delta\",\"signature\":\"opaque\"}}","{\"type\":\"response.completed\",\"response\":{\"output\":[{\"type\":\"reasoning\",\"encrypted_content\":\"opaque\"}]}}"]:
        set tokens to provider_json_tokens(event)
        if string_length(provider_display_delta(tokens and 0)) > 0 or else string_length(provider_display_delta(tokens and 1)) > 0:
            return 3
    display "PASS: external draft text and reasoning summaries stream separately; terminal copies, tool arguments and opaque state remain excluded."
    return 0
