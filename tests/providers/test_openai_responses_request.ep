import "../../app/providers/external_native"
import "../../app/providers/openai_responses_count"

define main returning Int:
    set messages to "[{\"role\":\"system\",\"content\":\"system\"},{\"role\":\"developer\",\"content\":\"developer\"},{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"hé🌍\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"https://example.com/image.png\",\"detail\":\"high\"}}]},{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[{\"id\":\"call1\",\"type\":\"function\",\"function\":{\"name\":\"measure\",\"arguments\":\"{\\\"n\\\":1.2300}\"}}]},{\"role\":\"tool\",\"tool_call_id\":\"call1\",\"content\":\"result\"}]"
    set tools to "[{\"type\":\"function\",\"function\":{\"name\":\"measure\",\"parameters\":{\"type\":\"object\",\"minimum\":1.2300}}}]"
    set options to "{\"max_output_tokens\":20000,\"reasoning\":{\"effort\":\"xhigh\"}}"
    set translated to responses_request_create("fixture" and messages and tools and options and create_list())
    if not (archive_list_text(translated and 0) equals "ready"):
        display archive_list_text(translated and 0)
        return 1
    set body to archive_list_text(translated and 1)
    set tokens to provider_json_tokens(body)
    set input to provider_items(tokens and provider_member(tokens and 0 and "input"))
    if length_list(input) is not equal to 5 or else string_length(openai_responses_count_request(body)) equals 0:
        return 2
    set call to get_list(input and 3)
    if not (provider_value(tokens and provider_member(tokens and call and "arguments")) equals "{\"n\":1.2300}"):
        return 3
    set native_tools to provider_items(tokens and provider_member(tokens and 0 and "tools"))
    set tool to get_list(native_tools and 0)
    if not (provider_kind(tokens and provider_member(tokens and tool and "strict")) equals "false") or else not (anthropic_json_source(body and tokens and provider_member(tokens and tool and "parameters")) equals "{\"type\":\"object\",\"minimum\":1.2300}"):
        return 4
    set profile to concat("{\"adapter\":\"openai-responses\",\"model\":\"fixture\",\"options\":" and concat(options and "}"))
    set canonical to concat("{\"model\":\"fixture\",\"stream\":true,\"messages\":" and messages)
    set canonical to concat(canonical and concat(",\"tools\":" and concat(tools and "}")))
    set integrated to external_native_request(0 and "session" and profile and canonical)
    if not (archive_list_text(integrated and 0) equals "ready") or else not (archive_list_text(integrated and 1) equals body):
        return 5
    for each invalid in ["[{\"role\":\"tool\",\"tool_call_id\":\"unknown\",\"content\":\"x\"}]","[{\"role\":\"assistant\",\"content\":\"text\",\"reasoning_content\":\"invented\"}]","[{\"role\":\"user\",\"content\":[{\"type\":\"input_audio\",\"data\":\"abc\"}]}]"]:
        set rejected to responses_request_create("fixture" and invalid and tools and options and create_list())
        if archive_list_text(rejected and 0) equals "ready":
            return 6
    display "PASS: canonical Responses request integration, roles/image/tool results, exact arguments/schema, explicit non-strict default, highest supplied reasoning and native counting; orphan results, unbound reasoning and unsupported media rejected."
    return 0
