import "../../app/agent/media_route"
import "../../app/web/attachments"
import "../../app/web/run_store"

# Transport/capability test only: no model inference and no perception claim.
# Actual generation and browser follow-ups are separate acceptance checks.
define main returning Int:
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(1)):
        return 1
    set primary to ptr_to_str(read_file(get_argument(2)))
    set media to ptr_to_str(read_file(get_argument(3)))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else provider_registry_schema(database) is not equal to 0:
        return 2
    if provider_registry_register(database and "media-test" and "Media acceptance endpoint" and media) is not equal to 0:
        return 3
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Route test" and "test-only-secret") is not equal to 0:
        return 4
    set first to web_submit_owned(database and "owner" and "seed" and "" and "Remember marker MAPLE_631.")
    set session to archive_list_text(first and 1)
    if agent_cancel_run(database and "seed") is not equal to 0:
        return 5
    if web_attachment_register(database and "owner" and session and "clip" and get_argument(4) and "clip.wav" and "audio/wav") is not equal to 0:
        return 6
    set submitted to web_submit_owned_files(database and "owner" and "audio-turn" and session and "Listen to this clip." and ["clip"])
    if not (archive_list_text(submitted and 0) equals "accepted") or else agent_provider_bind(database and "audio-turn" and primary) is not equal to 0:
        return 7
    if not (agent_media_profile(database and "audio-turn" and primary and -1 and 65536) equals media):
        return 8
    if not (agent_provider_read(database and "audio-turn") equals primary):
        return 9
    if not (agent_media_profile(database and "audio-turn" and primary and -1 and 65536) equals media):
        return 10
    if agent_cancel_run(database and "audio-turn") is not equal to 0:
        return 11
    set text to web_submit_owned(database and "owner" and "text-turn" and session and "What is seven plus six?")
    if not (archive_list_text(text and 0) equals "accepted"):
        return 12
    if not (agent_media_profile(database and "text-turn" and primary and -1 and 65536) equals primary):
        return 13
    if archive_verify(database and session) is not equal to 0:
        return 14
    display "PASS: actual endpoint capabilities route current waveform, primary binding remains immutable, retry reuses route, later text returns to primary with archive preserved. No inference tested."
    return 0
