import "../../app/providers/llama_modalities"

define main returning Int:
    set image to "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Inspect\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,fixture\"}}]}]}"
    set text to "{\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"},{\"role\":\"assistant\",\"content\":null},{\"role\":\"tool\",\"content\":\"Observation\"}]}"
    if not (llama_modalities_check(text and "{}") equals "ready"):
        return 1
    if not (llama_modalities_check(image and "{\"modalities\":{\"vision\":true}}") equals "ready") or else not (llama_modalities_check(image and "{\"modalities\":{\"vision\":false}}") equals "unsupported-input-vision") or else not (llama_modalities_check(image and "{}") equals "modality-metadata-required"):
        return 1
    if not (llama_modalities_check(image and "{\"modalities\":{\"vision\":\"true\"}}") equals "modality-metadata-required") or else not (llama_modalities_check(image and "{\"modalities\":{\"vision\":true,\"vision\":false}}") equals "invalid-metadata"):
        return 1
    set audio to "{\"messages\":[{\"content\":[{\"type\":\"input_audio\"}]}]}"
    set video to "{\"messages\":[{\"content\":[{\"type\":\"input_video\"}]}]}"
    if not (llama_modalities_check(audio and "{\"modalities\":{\"audio\":true,\"vision\":false}}") equals "ready") or else not (llama_modalities_check(video and "{\"modalities\":{\"video\":false,\"vision\":true}}") equals "unsupported-input-video"):
        return 1
    if not (llama_modalities_check("{\"messages\":[{\"content\":[{\"type\":\"unknown\"}]}]}" and "{}") equals "unsupported-content-part"):
        return 1
    set projected to llama_modalities_notice(audio and "{\"modalities\":{\"audio\":false}}")
    if string_contains(projected and "unsupported-input-audio") equals 0 or else string_contains(projected and "NOT supplied") equals 0 or else not (llama_modalities_check(projected and "{\"modalities\":{\"audio\":false}}") equals "ready"):
        return 2
    if not (llama_modalities_notice(audio and "{\"modalities\":{\"audio\":true}}") equals audio) or else not (llama_modalities_notice(audio and "{}") equals audio) or else not (llama_modalities_notice(text and "{}") equals text):
        return 3
    set mixed to "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Keep original text\"},{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"PRIVATE_AUDIO\"}},{\"type\":\"image_url\",\"image_url\":{\"url\":\"IMAGE_DATA\"}},{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"SECOND_AUDIO\"}}]}]}"
    set mixed_view to llama_modalities_notice(mixed and "{\"modalities\":{\"audio\":false,\"vision\":true}}")
    if string_contains(mixed_view and "PRIVATE_AUDIO") > 0 or else string_contains(mixed_view and "SECOND_AUDIO") > 0 or else string_contains(mixed_view and "IMAGE_DATA") equals 0 or else string_contains(mixed_view and "Keep original text") equals 0 or else not (llama_modalities_check(mixed_view and "{\"modalities\":{\"audio\":false,\"vision\":true}}") equals "ready"):
        return 4
    set native to "{\"messages\":[{\"role\":\"system\",\"content\":\"Keep identity intact\"},{\"role\":\"user\",\"content\":[{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"WAVEFORM_BYTES\",\"format\":\"wav\"}}]}]}"
    set supported to "{\"modalities\":{\"audio\":true}}"
    set clarified to llama_native_audio_context(native and supported)
    if provider_json_tokens(clarified) equals 0:
        display clarified
        return 9
    if string_contains(clarified and "CURRENT INPUT CAPABILITIES") equals 0 or else string_contains(clarified and "WAVEFORM_BYTES") equals 0 or else string_contains(clarified and "Keep identity intact") equals 0:
        return 5
    if not (llama_native_audio_context(clarified and supported) equals clarified):
        return 6
    if not (llama_native_audio_context(native and "{}") equals native) or else not (llama_native_audio_context(native and "{\"modalities\":{\"audio\":false}}") equals native) or else not (llama_native_audio_context(text and supported) equals text):
        return 7
    set receipt_only to "{\"messages\":[{\"role\":\"system\",\"content\":\"Identity\"},{\"role\":\"user\",\"content\":\"input_audio filename.wav and a ready receipt\"}]}"
    if string_contains(llama_native_audio_context(receipt_only and supported) and "Capability is distinct from attachment presence") equals 0:
        return 8
    # The same system prefix must survive invitation -> attachment -> follow-up.
    # Capability metadata must never fabricate an input_audio content part.
    set invitation to "{\"messages\":[{\"role\":\"system\",\"content\":\"Keep identity intact\"},{\"role\":\"user\",\"content\":\"Would you like to hear it?\"}]}"
    set invitation_view to llama_native_audio_context(invitation and supported)
    set invitation_tokens to provider_json_tokens(invitation_view)
    set native_tokens to provider_json_tokens(clarified)
    set invitation_messages to provider_items(invitation_tokens and provider_member(invitation_tokens and 0 and "messages"))
    set native_messages to provider_items(native_tokens and provider_member(native_tokens and 0 and "messages"))
    set invitation_system to provider_value(invitation_tokens and provider_member(invitation_tokens and get_list(invitation_messages and 0) and "content"))
    set native_system to provider_value(native_tokens and provider_member(native_tokens and get_list(native_messages and 0) and "content"))
    if not (invitation_system equals native_system) or else string_contains(invitation_view and "WAVEFORM_BYTES") > 0:
        return 12
    if not (llama_native_audio_context(invitation_view and supported) equals invitation_view):
        return 13
    set with_receipt to llama_native_audio_receipt(clarified and supported)
    if provider_json_tokens(with_receipt) equals 0 or else string_contains(with_receipt and "1 non-empty native audio") equals 0 or else string_contains(with_receipt and "WAVEFORM_BYTES") equals 0:
        return 14
    if not (llama_native_audio_receipt(with_receipt and supported) equals with_receipt):
        return 15
    set absent to llama_native_audio_receipt(invitation_view and supported)
    if string_contains(absent and "No native audio waveform is supplied") equals 0 or else string_contains(absent and "1 non-empty native audio") > 0:
        return 16
    if not (llama_native_audio_receipt(native and "{}") equals native) or else not (llama_native_audio_receipt(native and "{\"modalities\":{\"audio\":false}}") equals native):
        return 17
    set large_data to "WAVEFORM_BYTES"
    set growth to 0
    repeat while growth < 17:
        set large_data to concat(large_data and large_data)
        set growth to growth + 1
    set large_body to concat("{\"model\":\"fixture\",\"messages\":[{\"role\":\"system\",\"content\":\"Keep identity intact\"},{\"role\":\"user\",\"content\":[{\"type\":\"input_audio\",\"input_audio\":{\"data\":" and provider_quote(large_data))
    set large_body to concat(large_body and "}}]}]}")
    set repeated to 0
    repeat while repeated < 3:
        set large_context to llama_native_audio_context(large_body and supported)
        set large_view to llama_native_audio_receipt(large_context and supported)
        set parsed to provider_json_tokens(large_view)
        if parsed equals 0 or else provider_unique_objects(parsed) equals 0:
            return 10
        if not (provider_value(parsed and provider_member(parsed and 0 and "model")) equals "fixture"):
            return 11
        set repeated to repeated + 1
    display "PASS: text compatibility, explicit vision/audio/video capabilities, missing/ambiguous metadata and unknown typed content rejection."
    return 0
