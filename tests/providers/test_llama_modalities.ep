import "../../app/providers/llama_modalities"

define main returning Int:
    set image to "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Inspect\"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,fixture\"}}]}]}"
    set text to "{\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"},{\"role\":\"assistant\",\"content\":null},{\"role\":\"tool\",\"content\":\"Observation\"}]}"
    if not (llama_modalities_check(text and "{}") equals "ready"):
        return 1
    if not (llama_modalities_check(image and "{\"modalities\":{\"vision\":true}}") equals "ready") or else not (llama_modalities_check(image and "{\"modalities\":{\"vision\":false}}") equals "unsupported-input-vision") or else not (llama_modalities_check(image and "{}") equals "modality-metadata-required"):
        return 1
    if not (llama_modalities_check(image and "{\"modalities\":{\"vision\":\"true\"}}") equals "modality-metadata-required") or else not (llama_modalities_check(image and "{\"modalities\":{\"vision\":true,\"vision\":false}}") equals "invalid-metadata"):
        return 1
    set audio to "{\"messages\":[{\"content\":[{\"type\":\"input_audio\"}]}]}"
    set video to "{\"messages\":[{\"content\":[{\"type\":\"input_video\"}]}]}"
    if not (llama_modalities_check(audio and "{\"modalities\":{\"audio\":true,\"vision\":false}}") equals "ready") or else not (llama_modalities_check(video and "{\"modalities\":{\"video\":false,\"vision\":true}}") equals "unsupported-input-video"):
        return 1
    if not (llama_modalities_check("{\"messages\":[{\"content\":[{\"type\":\"unknown\"}]}]}" and "{}") equals "unsupported-content-part"):
        return 1
    set projected to llama_modalities_notice(audio and "{\"modalities\":{\"audio\":false}}")
    if string_contains(projected and "unsupported-input-audio") equals 0 or else string_contains(projected and "NOT supplied") equals 0 or else not (llama_modalities_check(projected and "{\"modalities\":{\"audio\":false}}") equals "ready"):
        return 2
    if not (llama_modalities_notice(audio and "{\"modalities\":{\"audio\":true}}") equals audio) or else not (llama_modalities_notice(audio and "{}") equals audio) or else not (llama_modalities_notice(text and "{}") equals text):
        return 3
    set mixed to "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"Keep original text\"},{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"PRIVATE_AUDIO\"}},{\"type\":\"image_url\",\"image_url\":{\"url\":\"IMAGE_DATA\"}},{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"SECOND_AUDIO\"}}]}]}"
    set mixed_view to llama_modalities_notice(mixed and "{\"modalities\":{\"audio\":false,\"vision\":true}}")
    if string_contains(mixed_view and "PRIVATE_AUDIO") > 0 or else string_contains(mixed_view and "SECOND_AUDIO") > 0 or else string_contains(mixed_view and "IMAGE_DATA") equals 0 or else string_contains(mixed_view and "Keep original text") equals 0 or else not (llama_modalities_check(mixed_view and "{\"modalities\":{\"audio\":false,\"vision\":true}}") equals "ready"):
        return 4
    display "PASS: text compatibility, explicit vision/audio/video capabilities, missing/ambiguous metadata and unknown typed content rejection."
    return 0
