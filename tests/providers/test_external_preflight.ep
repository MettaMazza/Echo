import "fs"
import "os"
import "../../app/providers/external_preflight"

define count_fixture_body with text as Str returning Str:
    return concat("{\"model\":\"fixture-native\",\"stream\":true,\"system\":[],\"messages\":[{\"role\":\"user\",\"content\":" and concat(provider_quote(text) and "}],\"max_tokens\":7890,\"thinking\":{\"type\":\"adaptive\"},\"output_config\":{\"effort\":\"max\"}}"))

define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(3)):
        return 1
    set original to "{\"model\":\"fixture-native\",\"stream\":true,\"max_tokens\":7890,\"messages\":[{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"preserved\",\"signature\":\"opaque-signed-block\"}]}],\"tools\":[{\"name\":\"measure\",\"input_schema\":{\"type\":\"object\",\"minimum\":1.2300}}],\"thinking\":{\"type\":\"adaptive\"},\"output_config\":{\"effort\":\"max\"}}"
    set counted to anthropic_count_request(original)
    set source_tokens to provider_json_tokens(original)
    set counted_tokens to provider_json_tokens(counted)
    if counted_tokens equals 0 or else provider_member(counted_tokens and 0 and "stream") >= 0 or else provider_member(counted_tokens and 0 and "max_tokens") >= 0:
        return 17
    for each field in ["model","messages","tools","thinking","output_config"]:
        if not (anthropic_json_source(original and source_tokens and provider_member(source_tokens and 0 and field)) equals anthropic_json_source(counted and counted_tokens and provider_member(counted_tokens and 0 and field))):
            return 18
    if not (anthropic_count_request("{\"model\":\"x\",\"messages\":[],\"unknown\":true}") equals "") or else anthropic_count_value("{\"input_tokens\":1.5}") is not equal to -1 or else anthropic_count_value("{\"input_tokens\":-1}") is not equal to -1:
        return 19
    set database to archive_open(get_argument(3))
    if sql_execute(database and "CREATE TABLE echo_sessions(session TEXT PRIMARY KEY); CREATE TABLE echo_principals(identity TEXT PRIMARY KEY,role TEXT,revoked INTEGER); CREATE TABLE echo_devices(device TEXT PRIMARY KEY,revoked INTEGER); CREATE TABLE echo_principal_devices(device TEXT PRIMARY KEY,principal TEXT); CREATE TABLE echo_session_owners(session TEXT PRIMARY KEY,device TEXT); CREATE TABLE echo_runs(run TEXT PRIMARY KEY,session TEXT); CREATE TABLE echo_run_authority(run TEXT PRIMARY KEY,principal TEXT,device TEXT,role TEXT,role_revision INTEGER,revocation_revision INTEGER,link_revision INTEGER); CREATE TABLE echo_authority_events(principal TEXT); CREATE TABLE echo_principal_revocations(principal TEXT); CREATE TABLE echo_device_link_events(device TEXT); INSERT INTO echo_principals VALUES('alice','user',0),('bob','admin',0); INSERT INTO echo_devices VALUES('a',0),('linked',0),('b',0); INSERT INTO echo_principal_devices VALUES('a','alice'),('linked','alice'),('b','bob'); INSERT INTO echo_sessions VALUES('fresh'),('foreign'); INSERT INTO echo_session_owners VALUES('fresh','a'),('foreign','b');") is not equal to 0 or else external_profile_schema(database) is not equal to 0 or else external_scope_schema(database) is not equal to 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set vault to workspace_root_open(system and get_argument(4))
    set spool to workspace_root_open(system and get_argument(5))
    set errors to native_open_mode(system and "/dev/null" and 1 and 0)
    if not (external_account_connect(database and "a" and "account" and "anthropic-messages" and "Fixture" and system and vault and "fixture-secret") equals "connected"):
        return 3
    set discovered to external_account_discover_program(get_argument(1) and database and "a" and "account" and "discovery" and "fixture-native" and "" and system and vault and errors and -1 and 65536)
    if not (external_profile_register(database and "a" and "profile" and "Native" and "account" and "discovery" and "fixture-native" and "") equals "registered"):
        return 4
    set saved to external_profile_read(database and "a" and "profile")
    set profile to archive_list_text(saved and 2)
    if not (external_scope_grant(database and "a" and "fresh" and ep_sha256(profile) and "Fixture external counting consent") equals "granted") or else sql_execute(database and "INSERT INTO echo_runs VALUES('run','fresh'),('foreign-run','foreign'); INSERT INTO echo_run_authority VALUES('run','alice','a','user',0,0,0),('foreign-run','bob','b','admin',0,0,0);") is not equal to 0:
        return 5
    set body to count_fixture_body("normal")
    set wrong_root to external_preflight_program("/does-not-exist" and database and "run" and "wrong-root" and profile and body and get_argument(4) and system and spool and vault and errors and -1 and 7)
    if not (archive_list_text(wrong_root and 0) equals "spool-root-mismatch"):
        return 16
    set decision to external_preflight_program(get_argument(2) and database and "run" and "normal-count" and profile and body and get_argument(5) and system and spool and vault and errors and -1 and 7)
    if not (archive_list_text(decision and 0) equals "ready") or else get_list(decision and 3) is not equal to 101 or else get_list(decision and 4) is not equal to 7890:
        display archive_list_text(decision and 0)
        return 6
    set duplicate to external_preflight_program("/does-not-exist" and database and "run" and "normal-count" and profile and body and get_argument(5) and system and spool and vault and errors and -1 and 7)
    if not (archive_list_text(duplicate and 0) equals "archive-error-or-duplicate-attempt"):
        return 7
    set large to external_preflight_program(get_argument(2) and database and "run" and "large-count" and profile and count_fixture_body("large") and get_argument(5) and system and spool and vault and errors and -1 and 7)
    if not (archive_list_text(large and 0) equals "compaction-required") or else get_list(large and 4) is not equal to 456:
        return 8
    for each failure in ["malformed","failed-child"]:
        set failed to external_preflight_program(get_argument(2) and database and "run" and failure and profile and count_fixture_body(failure) and get_argument(5) and system and spool and vault and errors and -1 and 7)
        if archive_list_text(failed and 0) equals "ready":
            return 9
    set denied to external_preflight_program("/does-not-exist" and database and "foreign-run" and "foreign-count" and profile and body and get_argument(5) and system and spool and vault and errors and -1 and 7)
    if not (archive_list_text(denied and 0) equals "not-authorized"):
        return 10
    set row to archive_read_event(database and "normal-count:count-request")
    set original to provider_json_tokens(archive_list_text(row and 3))
    if not (provider_value(original and provider_member(original and 0 and "generation_body")) equals body):
        return 11
    set receipt to archive_read_event(database and "normal-count")
    if string_contains(archive_list_text(receipt and 3) and "provider-estimate") equals 0 or else string_contains(archive_list_text(receipt and 3) and "fixture-secret") > 0:
        return 12
    set cancelled to socket_cancellation_create(system)
    set signalled to socket_cancel(cancelled)
    set cancelled_result to external_preflight_program(get_argument(2) and database and "run" and "cancelled-count" and profile and body and get_argument(5) and system and spool and vault and errors and get_list(cancelled and 0) and 7)
    if not (archive_list_text(cancelled_result and 0) equals "cancelled-before-launch"):
        return 13
    set closed to socket_cancellation_close(cancelled)
    if not (external_account_revoke(database and "a" and "account") equals "revoked") or else not (archive_list_text(external_preflight_program("/does-not-exist" and database and "run" and "revoked-count" and profile and body and get_argument(5) and system and spool and vault and errors and -1 and 7) and 0) equals "not-authorized"):
        return 14
    if archive_verify(database and "fresh") is not equal to 0:
        return 15
    set closed to sql_close(database)
    set closed to net_close(errors)
    set closed to net_close(vault)
    set closed to net_close(spool)
    set closed to ep_dlclose(system)
    display "PASS: consent-bound native counting, private spool, unchanged output/reasoning, compaction admission, original/estimate receipts, duplicate attempt rejection, malformed/nonzero-child failure, cancellation and revocation."
    return 0
