import "../../app/providers/chat_stream"

define rejected_finish with reason as Str and transport as Str and done as Int returning Int:
    set state to chat_stream_create()
    set chunk to concat("{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"partial\"},\"finish_reason\":\"" and reason)
    set chunk to concat(chunk and "\"}]}")
    if chat_stream_accept(state and chunk) is not equal to 0:
        return 1
    if done equals 1:
        set accepted to chat_stream_accept(state and "[DONE]")
    if chat_stream_finish(state and transport) equals 0:
        return 1
    return 0

define main returning Int:
    set state to chat_stream_create()
    set first to "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"hé\",\"tool_calls\":[{\"index\":9,\"id\":\"call_a\",\"type\":\"function\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"path\\\":\"}},{\"index\":2,\"id\":\"call_b\",\"function\":{\"name\":\"search\",\"arguments\":\"{\\\"query\\\":\\\"\"}}]},\"finish_reason\":null}]}"
    set second to "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"🌍\",\"tool_calls\":[{\"index\":2,\"function\":{\"arguments\":\"hello\\\"}\"}},{\"index\":9,\"function\":{\"arguments\":\"\\\"notes\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}"
    if chat_stream_accept(state and first) is not equal to 0 or else chat_stream_accept(state and second) is not equal to 0 or else chat_stream_accept(state and "{\"choices\":[],\"usage\":{\"total_tokens\":42}}") is not equal to 0 or else chat_stream_accept(state and "[DONE]") is not equal to 0 or else chat_stream_finish(state and "eof") is not equal to 0:
        display "FAIL: assembled tool response."
        return 1
    set choice to get_list(get_list(state and 0) and 0)
    set calls to get_list(choice and 3)
    if not (ptr_to_str(get_list(choice and 1)) equals "hé🌍") or else length_list(calls) is not equal to 2:
        return 1
    set first_call to chat_find(calls and "9")
    set second_call to chat_find(calls and "2")
    if not (ptr_to_str(get_list(first_call and 3)) equals "{\"path\":\"notes\"}") or else not (ptr_to_str(get_list(second_call and 3)) equals "{\"query\":\"hello\"}"):
        return 1
    if chat_stream_finish(state and "eof") equals 0:
        return 1
    if rejected_finish("length" and "eof" and 1) is not equal to 0 or else rejected_finish("stop" and "incomplete" and 1) is not equal to 0 or else rejected_finish("stop" and "eof" and 0) is not equal to 0:
        return 1
    set state to chat_stream_create()
    if chat_stream_accept(state and "{\"choices\":[],\"choices\":[]}") equals 0:
        return 1
    if chat_stream_accept(state and "[DONE]") equals 0:
        return 1
    set state to chat_stream_create()
    if chat_stream_accept(state and first) is not equal to 0:
        return 1
    if chat_stream_accept(state and "{\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"tool_calls\"}]}") is not equal to 0 or else chat_stream_accept(state and "[DONE]") is not equal to 0:
        return 1
    if chat_stream_finish(state and "eof") equals 0:
        display "FAIL: incomplete tool arguments accepted."
        return 1
    set duplicate to provider_json_tokens("{\"nested\":{\"x\":1,\"x\":2}}")
    if duplicate equals 0 or else provider_unique_objects(duplicate) is not equal to 0:
        return 1
    set state to chat_stream_create()
    if chat_stream_accept(state and "{\"choices\":[{\"index\":0,\"delta\":{\"content\":\"answer\"},\"finish_reason\":\"stop\"},{\"index\":99999999999999999999999999999,\"delta\":{\"content\":\"other\"},\"finish_reason\":\"stop\"}]}") is not equal to 0 or else chat_stream_accept(state and "[DONE]") is not equal to 0 or else chat_stream_finish(state and "eof") is not equal to 0:
        return 1
    display "PASS: interleaved tool arguments, Unicode text, sparse exact indexes, usage trailer, multiple choices, duplicate-field rejection, sticky errors, finish-once and incomplete/limited response rejection."
    return 0
