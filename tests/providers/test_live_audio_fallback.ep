import "../../app/agent/runner"
import "../../app/web/run_store"
import "fs"
import "../../app/web/attachments"

# Live model acceptance, never a fixture substitute. Run only on an isolated
# archive and the exact Thinking profile; retain all failures and raw streams.
define thinking_turn with database as Int and session as Str and run as Str and prompt as Str and profile as Str and expected as Str returning Int:
    set submitted to web_submit_owned(database and "thinking-owner" and run and session and prompt)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        display archive_list_text(submitted and 0)
        return 1
    set outcome to agent_loop_provider(database and run and profile and 2048 and -1 and 65536)
    if not (outcome equals "completed"):
        display outcome
        return 2
    set row to agent_run_read(database and run)
    set final to archive_read_event(database and archive_list_text(row and 3))
    set fields to provider_json_tokens(archive_list_text(final and 3))
    set text to provider_value(fields and provider_member(fields and 0 and "content"))
    display concat(run and concat(": " and text))
    if string_contains(text and expected) equals 0 or else string_contains(text and "Thought:") > 0 or else string_contains(text and "Action:") > 0 or else string_contains(text and "<think>") > 0:
        return 3
    if not (agent_provider_read(database and run) equals profile):
        return 4
    return archive_verify(database and archive_list_text(row and 0))

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set profile to ptr_to_str(read_file(get_argument(2)))
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "thinking-invite") is not equal to 0 or else web_device_pair(database and "thinking-invite" and "thinking-owner" and "Audio fallback test" and "fixture-secret") is not equal to 0:
        return 3
    if thinking_turn(database and "" and "fallback-one" and "Remember marker AZURE_481. Reply briefly with that marker." and profile and "AZURE_481") is not equal to 0:
        return 4
    set row to agent_run_read(database and "fallback-one")
    set session to concat(archive_list_text(row and 0) and "")
    if web_attachment_register(database and "thinking-owner" and session and "fallback-audio" and get_argument(3) and "synthetic.wav" and "audio/wav") is not equal to 0:
        return 5
    if thinking_turn(database and session and "fallback-two" and "Call attachment_listen_audio with attachment fallback-audio to try listening. If audio is unavailable, explain that honestly and finish your reply. Include the exact marker AZURE_481. Do not transcribe or synthesise anything." and profile and "AZURE_481") is not equal to 0:
        return 6
    if thinking_turn(database and session and "fallback-three" and "What marker did I ask you to remember? Briefly say whether you actually heard the audio. No tools." and profile and "AZURE_481") is not equal to 0:
        return 7
    set checks to history_collect_one(checkpoint_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='tool_call' AND json_extract(payload,'$.run_id')='fallback-two' AND json_extract(payload,'$.name')='attachment_listen_audio';" and []))
    if http_decimal(archive_list_text(checks and 1)) < 1:
        return 8
    display "PASS: three live turns, actual audio tool, unsupported audio continuation and follow-up."
    return archive_verify(database and session)
