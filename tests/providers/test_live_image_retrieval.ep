import "../../app/agent/runner"
import "../../app/web/attachments"
import "fs"

define image_answer with database as Int and run as Str and profile as Str returning Str:
    set status to agent_loop_provider(database and run and profile and 2048 and -1 and 65536)
    if not (status equals "completed"):
        display status
        return ""
    set row to agent_run_read(database and run)
    set event to archive_read_event(database and ptr_to_str(get_list(row and 3)))
    set tokens to provider_json_tokens(ptr_to_str(get_list(event and 3)))
    set content to string_trim(provider_value(tokens and provider_member(tokens and 0 and "content")))
    display content
    return content

# Actual archived attachment, full agent, provider counting and reopened history.
# The image is a historical UI screenshot, not the current application status.
define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(1)):
        return 1
    set profile to ptr_to_str(read_file(get_argument(3)))
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Image test" and "secret") is not equal to 0:
        return 3
    set initial to web_submit_owned(database and "owner" and "setup" and "" and "We will inspect a historical screenshot.")
    set session to ptr_to_str(get_list(initial and 1))
    if agent_cancel_run(database and "setup") is not equal to 0 or else web_attachment_register(database and "owner" and session and "screenshot" and get_argument(2) and "historical.png" and "image/png") is not equal to 0:
        return 4
    set attachments to create_list()
    set submitted to web_submit_owned_files(database and "owner" and "image-first" and session and "Call attachment_view_image with attachment screenshot to reopen the saved historical screenshot. Then transcribe only its large main heading, exactly as shown, with no quotation marks or commentary." and attachments)
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 5
    set answer to image_answer(database and "image-first" and profile)
    if not (answer equals "Echo, on this Mac."):
        display "FAIL: main heading not read correctly"
        return 6
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 7
    set database to archive_open(get_argument(1))
    set submitted to web_submit_owned(database and "owner" and "image-followup" and session and "Look again at that same historical screenshot. What does the small status badge at the top right say? Reply with only the exact badge text.")
    if not (ptr_to_str(get_list(submitted and 0)) equals "accepted"):
        return 8
    set messages to session_messages(database and session and "image-followup")
    if string_contains(messages and "data:image/png;base64,") equals 0:
        return 9
    set answer to image_answer(database and "image-followup" and profile)
    if not (answer equals "Local service connected"):
        display "FAIL: reopened image badge not read correctly"
        return 10
    set counts to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='provider_preflight' AND json_extract(payload,'$.decision')='ready' AND instr(json_extract(payload,'$.request_body'),'data:image/png;base64,')>0;"))
    if not (ptr_to_str(get_list(counts and 1)) equals "2") or else archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 11
    display "PASS: actual image answers through agent, image-bearing preflight on both turns, reopened original attachment and verified archive. Retrieved image tool path verified. Compaction activation and other modalities not covered."
    return 0
