import "../../app/providers/external_profile_options"

define main returning Int:
    set adaptive to external_model_info("anthropic-messages" and "{\"id\":\"fixture\",\"type\":\"model\",\"max_input_tokens\":100000,\"max_tokens\":10000,\"capabilities\":{\"thinking\":{\"supported\":true,\"types\":{\"adaptive\":{\"supported\":true},\"enabled\":{\"supported\":true}}},\"effort\":{\"supported\":true,\"max\":{\"supported\":true}}}}")
    set options to external_profile_options(adaptive and "")
    if not (archive_list_text(options and 0) equals "ready") or else string_contains(archive_list_text(options and 1) and "10000") equals 0 or else string_contains(archive_list_text(options and 1) and "max") equals 0:
        return 1
    for each invalid in ["{\"max_tokens\":10000,\"thinking\":{\"type\":\"disabled\"}}","{\"max_tokens\":10000,\"thinking\":{\"type\":\"adaptive\",\"display\":\"omitted\"}}","{\"max_tokens\":10000,\"thinking\":{\"type\":\"enabled\",\"budget_tokens\":10000}}","{\"max_tokens\":10000,\"max_tokens\":1}"]:
        if archive_list_text(external_profile_options(adaptive and invalid) and 0) equals "ready":
            return 2
    set unsupported to external_profile_options(adaptive and "{\"max_tokens\":10000,\"thinking\":{\"type\":\"adaptive\"},\"output_config\":{\"effort\":\"max\",\"format\":{\"type\":\"json_schema\",\"schema\":{}}}}")
    if not (archive_list_text(unsupported and 0) equals "unsupported-structured-output"):
        return 3
    set manual to external_model_info("anthropic-messages" and "{\"id\":\"manual\",\"type\":\"model\",\"max_input_tokens\":100000,\"max_tokens\":10000,\"capabilities\":{\"thinking\":{\"supported\":true,\"types\":{\"enabled\":{\"supported\":true}}},\"effort\":{\"supported\":false}}}")
    if not (archive_list_text(external_profile_options(manual and "") and 0) equals "manual-thinking-budget-required"):
        return 4
    set supplied to "{\"max_tokens\":10000,\"thinking\":{\"type\":\"enabled\",\"budget_tokens\":4096}}"
    set chosen to external_profile_options(manual and supplied)
    if not (archive_list_text(chosen and 0) equals "ready") or else not (archive_list_text(chosen and 1) equals supplied):
        return 5
    set unknown to external_model_info("anthropic-messages" and "{\"id\":\"unknown\",\"type\":\"model\",\"max_input_tokens\":100000,\"max_tokens\":10000,\"capabilities\":{}}")
    if archive_list_text(external_profile_options(unknown and "") and 0) equals "ready":
        return 6
    set openai to external_model_info("openai-chat" and "{\"id\":\"openai\",\"object\":\"model\"}")
    if not (archive_list_text(external_profile_options(openai and "") and 0) equals "accounting-unresolved"):
        return 7
    display "PASS: native output ceiling, highest advertised effort, explicit manual thinking budget, unknown accounting/capabilities and unsupported settings rejection; exact configured options retained."
    return 0
