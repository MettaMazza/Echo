import "../../app/providers/native_python"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set library to native_python_open(get_argument(1) and get_argument(2))
    if library equals 0:
        return 2
    set core to native_python_import(library and "mlx.core")
    set server to native_python_import(library and "mlx_lm.server")
    set generator to native_python_attribute(library and server and "ResponseGenerator")
    set tokenize to native_python_attribute(library and generator and "_tokenize")
    set version to native_python_attribute(library and core and "__version__")
    if core equals 0 or else server equals 0 or else tokenize equals 0 or else version equals 0:
        set printer to ep_dlsym(library and "PyErr_Print")
        set ignored to ep_dlcall0(printer)
        return 3
    display concat("MLX native version: " and native_python_text(library and version))
    set released to native_python_release(library and version)
    set released to native_python_release(library and tokenize)
    set released to native_python_release(library and generator)
    set released to native_python_release(library and server)
    set released to native_python_release(library and core)
    display "PASS: Ernos loaded the installed MLX native engine and exact server tokenizer function without authored Python source."
    return 0
