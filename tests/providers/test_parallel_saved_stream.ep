import "../../app/providers/restored_stream"

# Independent read connections exercise native collection during reconstruction.
# Never makes a provider request or dispatches a tool from the saved trace.
define replay_saved_worker with database as Int and session as Str and request as Str and rounds as Int and completed as Int returning Int:
    set count to 0
    set result to 0
    repeat while count < rounds:
        set replay to provider_restore_stream(database and session and request)
        if not (archive_list_text(replay and 0) equals "incomplete-response"):
            set result to 1
            break
        set count to count + 1
    set closed to sql_close(database)
    send result to completed
    return result

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set rounds to string_to_int(get_argument(4))
    set workers to string_to_int(get_argument(5))
    if rounds < 1 or else workers < 1:
        return 2
    set connections to create_list()
    set count to 0
    repeat while count < workers:
        set database to archive_open(get_argument(1))
        if database equals 0:
            return 3
        set added to append_list(connections and database)
        set count to count + 1
    set completed to channel
    set session to get_argument(2)
    set request to get_argument(3)
    set count to 0
    repeat while count < workers:
        set worker_session to concat(session and "")
        set worker_request to concat(request and "")
        spawn replay_saved_worker(get_list(connections and count) and worker_session and worker_request and rounds and completed)
        set count to count + 1
    set count to 0
    set failed to 0
    repeat while count < workers:
        set result to receive from completed
        if result is not equal to 0:
            set failed to 1
        set count to count + 1
    if failed is not equal to 0:
        return 4
    display "PASS: concurrent reconstruction retained incomplete status without inference or tool dispatch."
    return 0
