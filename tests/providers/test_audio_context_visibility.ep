import "fs"
import "../../app/web/attachment_visibility"
import "../../app/jobs/delegation_schema"
import "../../app/providers/attachment_image"
import "../../app/web/attachments"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_attachment_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 1
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Fixture" and "secret") is not equal to 0:
        return 1
    set submitted to web_submit_owned(database and "owner" and "request" and "" and "Inspect attached audio")
    set session to ptr_to_str(get_list(submitted and 1))
    if web_attachment_register(database and "owner" and session and "audio" and get_argument(2) and "fixture.wav" and "audio/wav") is not equal to 0:
        return 1
    if agent_cancel_run(database and "request") is not equal to 0:
        return 1
    set selected to create_list()
    set added to append_list(selected and "audio")
    set turn to web_submit_owned_files(database and "owner" and "audio-turn" and session and "Inspect this audio" and selected)
    if not (ptr_to_str(get_list(turn and 0)) equals "accepted"):
        return 1
    set messages to agent_run_messages(database and "audio-turn")
    if string_contains(messages and "input_audio") equals 0 or else string_contains(messages and "audio:attachment") equals 0:
        return 1
    set objective to archive_read_event(database and "audio-turn:user")
    set checkpoint to create_list()
    set added to append_list(checkpoint and "preview")
    set added to append_list(checkpoint and "audio-turn:user")
    set added to append_list(checkpoint and get_list(objective and 6))
    set added to append_list(checkpoint and "")
    set added to append_list(checkpoint and "Detailed fixture recap")
    set added to append_list(checkpoint and "{}")
    set rebuilt to session_messages_checkpoint(database and session and "audio-turn" and checkpoint)
    if string_contains(rebuilt and "input_audio") equals 0 or else string_contains(rebuilt and "Inspect this audio") equals 0:
        display "FAIL: active audio objective lost across checkpoint boundary"
        return 1
    set part to attachment_audio_part(database and session and "audio")
    if not (ptr_to_str(get_list(part and 0)) equals "ready") or else not (ptr_to_str(get_list(part and 2)) equals "audio:attachment"):
        return 1
    set tokens to provider_json_tokens(ptr_to_str(get_list(part and 1)))
    set uri to provider_value(tokens and provider_member(tokens and provider_member(tokens and 0 and "input_audio") and "data"))
    if not (provider_value(tokens and provider_member(tokens and 0 and "type")) equals "input_audio") or else string_length(uri) equals 0:
        return 1
    if write_file(concat(get_argument(1) and ".uri") and uri) is not equal to 1:
        return 1
    set change to provider_json_tokens("{\"action\":\"exclude\",\"attachment\":\"audio\",\"identity\":\"exclude-image\",\"previous\":\"\"}")
    if not (web_attachment_visibility(database and "owner" and change) equals "recorded"):
        return 30
    set hidden to agent_run_messages(database and "audio-turn")
    set compacted to session_messages_checkpoint(database and session and "audio-turn" and checkpoint)
    if provider_json_tokens(hidden) equals 0 or else string_contains(hidden and "input_audio") is not equal to 0 or else string_contains(hidden and "fixture.wav") is not equal to 0 or else string_contains(hidden and "Inspect this audio") equals 0 or else string_contains(hidden and "Excluded attachment references") equals 0:
        return 31
    if provider_json_tokens(compacted) equals 0 or else string_contains(compacted and "input_audio") is not equal to 0:
        return 32
    set binding to turn_attachment_read(database and session and "audio-turn:user")
    if string_contains(archive_list_text(binding and 1) and "fixture.wav") equals 0:
        return 33
    set change to provider_json_tokens("{\"action\":\"restore\",\"attachment\":\"audio\",\"identity\":\"restore-image\",\"previous\":\"attachment-visibility:owner:exclude-image\"}")
    if not (web_attachment_visibility(database and "owner" and change) equals "recorded") or else not (agent_run_messages(database and "audio-turn") equals messages):
        return 34
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 35
    display "PASS: historical audio exclusion preserves the user message, omits image bytes and receipt metadata from ordinary/checkpoint reconstruction, retains canonical binding and restores identical request messages."
    return 0
