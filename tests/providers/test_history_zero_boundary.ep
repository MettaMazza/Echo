import "../../app/tools/history_tools"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if archive_append(database and "search-test" and "original" and "user" and "MARKER boundary test" and "fixture") is not equal to 0:
        return 2
    set omitted to history_tool_execute_snapshot(database and "search-test" and "history_search" and "{\"query\":\"MARKER\",\"after\":0}")
    set zero to history_tool_execute_snapshot(database and "search-test" and "history_search" and "{\"query\":\"MARKER\",\"after\":0,\"through\":0}")
    if not (omitted equals zero) or else string_contains(zero and "original") equals 0:
        display zero
        return 3
    if archive_append(database and "search-test" and "later" and "user" and "MARKER later" and "fixture") is not equal to 0:
        return 4
    set frozen to history_tool_execute_snapshot(database and "search-test" and "history_search" and "{\"query\":\"MARKER\",\"after\":1,\"through\":1}")
    if string_contains(frozen and "end") equals 0 or else string_contains(frozen and "later") > 0:
        return 5
    display "PASS: initial zero equals omitted boundary; fixed pagination excludes later events."
    return sql_close(database)
