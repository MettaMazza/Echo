import "fs"
import "os"
import "../../app/providers/external_profiles"
import "../../app/web/external_profiles"
import "../../app/web/external_sessions"
import "../../app/providers/external_selection"
import "../../app/providers/external_invocation"
import "../../app/providers/external_auxiliary"

define main returning Int:
    if get_argument_count() is not equal to 6 or else file_exists(get_argument(2)):
        return 1
    set database to archive_open(get_argument(2))
    if sql_execute(database and "CREATE TABLE echo_sessions(session TEXT PRIMARY KEY); CREATE TABLE echo_principals(identity TEXT PRIMARY KEY,role TEXT,revoked INTEGER); CREATE TABLE echo_devices(device TEXT PRIMARY KEY,revoked INTEGER); CREATE TABLE echo_principal_devices(device TEXT PRIMARY KEY,principal TEXT); CREATE TABLE echo_session_owners(session TEXT PRIMARY KEY,device TEXT); CREATE TABLE echo_runs(run TEXT PRIMARY KEY,session TEXT,state TEXT DEFAULT 'ready',last_event TEXT DEFAULT 'accepted-head'); CREATE TABLE echo_run_authority(run TEXT PRIMARY KEY,principal TEXT,device TEXT,role TEXT,role_revision INTEGER,revocation_revision INTEGER,link_revision INTEGER); CREATE TABLE echo_authority_events(principal TEXT); CREATE TABLE echo_principal_revocations(principal TEXT); CREATE TABLE echo_device_link_events(device TEXT); INSERT INTO echo_principals VALUES('alice','user',0),('bob','admin',0); INSERT INTO echo_devices VALUES('a',0),('linked',0),('b',0); INSERT INTO echo_principal_devices VALUES('a','alice'),('linked','alice'),('b','bob'); INSERT INTO echo_sessions VALUES('fresh'),('foreign'); INSERT INTO echo_session_owners VALUES('fresh','a'),('foreign','b');") is not equal to 0 or else external_profile_schema(database) is not equal to 0 or else external_scope_schema(database) is not equal to 0:
        return 2
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(system and get_argument(3))
    set errors to native_open_mode(system and "/dev/null" and 1 and 0)
    if not (external_account_connect(database and "a" and "account" and "anthropic-messages" and "Fixture" and system and directory and "fixture-secret") equals "connected"):
        return 3
    set discovery to external_account_discover_program(get_argument(1) and database and "a" and "account" and "discovery" and "fixture-native" and "" and system and directory and errors and -1 and 65536)
    if string_contains(archive_list_text(discovery and 0) and "found") equals 0:
        return 4
    set web_request to "{\"action\":\"register\",\"identity\":\"profile\",\"label\":\"Native model\",\"account\":\"account\",\"discovery\":\"discovery\",\"model\":\"fixture-native\",\"options\":\"\"}"
    if not (web_external_profile(database and "linked" and provider_json_tokens(web_request)) equals "{\"status\":\"registered\"}"):
        return 20
    set read_request to provider_json_tokens("{\"action\":\"read\",\"identity\":\"profile\"}")
    set web_read to web_external_profile(database and "a" and read_request)
    if string_contains(web_read and "fixture-native") equals 0 or else string_contains(web_read and "fixture-secret") > 0 or else not (web_external_profile(database and "b" and read_request) equals "{\"status\":\"profile-unavailable\"}"):
        return 21
    if not (web_external_profile(database and "a" and provider_json_tokens("{\"action\":\"read\",\"identity\":\"profile\",\"session\":\"foreign\"}")) equals "{\"status\":\"invalid-arguments\"}"):
        return 22
    set registered to external_profile_register(database and "linked" and "profile" and "Native model" and "account" and "discovery" and "fixture-native" and "")
    if not (registered equals "registered"):
        display registered
        return 5
    if not (external_profile_register(database and "a" and "profile" and "Native model" and "account" and "discovery" and "fixture-native" and "") equals "registered") or else not (external_profile_register(database and "a" and "profile" and "Changed label" and "account" and "discovery" and "fixture-native" and "") equals "profile-conflict"):
        return 6
    if not (external_profile_register(database and "b" and "foreign-profile" and "Foreign" and "account" and "discovery" and "fixture-native" and "") equals "not-authorized") or else archive_list_text(external_profile_read(database and "b" and "profile") and 0) equals "found":
        return 7
    if not (external_profile_register(database and "a" and "unknown-model" and "Unknown" and "account" and "discovery" and "invented-name" and "") equals "model-not-discovered"):
        return 8
    if not (external_profile_register(database and "a" and "lower-reasoning" and "Lower" and "account" and "discovery" and "fixture-native" and "{\"max_tokens\":7890,\"thinking\":{\"type\":\"adaptive\"},\"output_config\":{\"effort\":\"high\"}}") equals "highest-reasoning-required"):
        return 9
    if not (external_profile_register(database and "a" and "secret" and "Secret" and "account" and "discovery" and "fixture-native" and "{\"max_tokens\":7890,\"key\":\"fixture-secret\"}") equals "invalid-external-options"):
        return 10
    if not (external_profile_register(database and "a" and "oversized" and "Oversized" and "account" and "discovery" and "fixture-native" and "{\"max_tokens\":7891}") equals "invalid-output-limit"):
        return 11
    set saved to external_profile_read(database and "a" and "profile")
    set profile to archive_list_text(saved and 2)
    set tokens to provider_json_tokens(profile)
    set options to provider_member(tokens and 0 and "options")
    if not (archive_list_text(saved and 0) equals "found") or else not (ep_sha256(profile) equals archive_list_text(saved and 3)) or else not (provider_index(tokens and provider_member(tokens and options and "max_tokens")) equals "7890") or else string_contains(profile and "fixture-secret") > 0:
        return 12
    set preview to web_external_session(database and "linked" and provider_json_tokens("{\"action\":\"preview\",\"profile\":\"profile\"}"))
    set preview_tokens to provider_json_tokens(preview)
    if not (provider_value(preview_tokens and provider_member(preview_tokens and 0 and "status")) equals "preview") or else not (external_scope_session_status(database and "fresh") equals "local"):
        return 23
    set consent to concat("{\"action\":\"grant\",\"profile\":\"profile\",\"session\":\"fresh\",\"disclosure_digest\":" and concat(provider_quote(provider_value(preview_tokens and provider_member(preview_tokens and 0 and "disclosure_digest"))) and "}"))
    if not (web_external_session(database and "b" and provider_json_tokens(consent)) equals "{\"status\":\"profile-unavailable\"}") or else not (web_external_session(database and "a" and provider_json_tokens("{\"action\":\"grant\",\"profile\":\"profile\",\"session\":\"fresh\",\"disclosure_digest\":\"wrong\"}")) equals "{\"status\":\"disclosure-mismatch\"}"):
        return 24
    if not (web_external_session(database and "linked" and provider_json_tokens(consent)) equals "{\"status\":\"granted\"}") or else not (web_external_session(database and "a" and provider_json_tokens(consent)) equals "{\"status\":\"already-granted\"}"):
        return 25
    set selected to external_session_profile(database and "linked" and "fresh" and "")
    if not (archive_list_text(selected and 0) equals "found") or else not (archive_list_text(selected and 2) equals profile) or else not (archive_list_text(external_session_profile(database and "a" and "fresh" and "different-profile") and 0) equals "external-profile-consent-mismatch") or else archive_list_text(external_session_profile(database and "b" and "fresh" and "profile") and 0) equals "found":
        return 26
    if sql_execute(database and "INSERT INTO echo_runs(run,session) VALUES('run','fresh'),('foreign-run','foreign'); INSERT INTO echo_run_authority VALUES('run','alice','a','user',0,0,0),('foreign-run','bob','b','admin',0,0,0);") is not equal to 0:
        return 13
    if external_profile_run_allows(database and "run" and profile) is not equal to 1 or else external_profile_run_allows(database and "foreign-run" and profile) is not equal to 0 or else external_profile_run_allows(database and "run" and concat(profile and " ")) is not equal to 0:
        return 14
    if archive_append(database and "fresh" and "recap-job" and "recap_job" and "{}" and "fixture") is not equal to 0 or else archive_append(database and "fresh" and "recap-job:binding" and "compaction_binding" and "{\"run_id\":\"run\",\"parent_event\":\"accepted-head\",\"job\":\"recap-job\"}" and "fixture") is not equal to 0:
        return 28
    set invocation to external_invocation_create(database and "run" and "recap-job" and profile)
    set bound to external_invocation_read(database and "fresh" and invocation)
    if not (archive_list_text(bound and 0) equals "ready") or else not (archive_list_text(bound and 2) equals profile) or else archive_list_text(external_invocation_read(database and "foreign" and invocation) and 0) equals "ready":
        return 29
    set canonical to "{\"model\":\"fixture-native\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Frozen recap source\"}]}"
    set fitted to external_aux_prepare_program(get_argument(4) and database and "fresh" and "recap-request:fit:0" and invocation and canonical and -1 and 7)
    if not (archive_list_text(fitted and 0) equals "ready"):
        display archive_list_text(fitted and 0)
        return 31
    set native to archive_list_text(fitted and 5)
    set payload to concat("{\"purpose\":\"recap-candidate\",\"request_body\":" and concat(provider_quote(native) and "}"))
    if archive_append(database and "fresh" and "recap-request" and "model_request" and payload and "fixture") is not equal to 0:
        return 32
    set generated to external_aux_generate_program(get_argument(5) and database and "fresh" and "recap-request" and invocation and native and -1 and 7)
    if not (archive_list_text(generated and 0) equals "complete"):
        display archive_list_text(generated and 0)
        return 33
    if sql_execute(database and "UPDATE echo_runs SET last_event='new-head' WHERE run='run';") is not equal to 0 or else not (archive_list_text(external_invocation_read(database and "fresh" and invocation) and 0) equals "stale-external-compaction"):
        return 30
    # Corrupt only this disposable fixture to verify dispatch source integrity.
    if sql_execute(database and "DROP TRIGGER echo_external_discovery_result_no_update; UPDATE echo_external_discovery_results SET body=body||' ' WHERE identity='discovery';") is not equal to 0 or else external_profile_run_allows(database and "run" and profile) is not equal to 0:
        return 17
    if not (archive_list_text(external_session_profile(database and "a" and "fresh" and "profile") and 0) equals "external-profile-integrity-error"):
        return 27
    if not (external_profile_register(database and "a" and "corrupt-source" and "Corrupt" and "account" and "discovery" and "fixture-native" and "") equals "discovery-integrity-error"):
        return 18
    if not (external_account_revoke(database and "linked" and "account") equals "revoked") or else external_profile_run_allows(database and "run" and profile) is not equal to 0 or else archive_list_text(external_profile_read(database and "a" and "profile") and 0) equals "found":
        return 15
    set closed to sql_close(database)
    set database to archive_open(get_argument(2))
    if archive_list_text(external_profile_read(database and "a" and "profile") and 0) equals "found":
        return 16
    set closed to sql_close(database)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    display "PASS: explicit compaction invocation, native fit receipt and streamed recap transport, maximum advertised reasoning, owner/linked profile registration, immutable retries, foreign admin denial, unknown-model/credential-field rejection, frozen consent binding and persistent revocation."
    return 0
