import "os"
import "../../app/providers/anthropic_request"

define main returning Int:
    set messages to "[{\"role\": \"system\", \"content\": \"Echo system — unchanged\"}, {\"role\": \"user\", \"content\": \"hé🌍\"}, {\"role\": \"assistant\", \"content\": \"Checking\", \"tool_calls\": [{\"id\": \"a\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{\\\"n\\\":1.2300e+8}\"}}, {\"id\": \"b\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{}\"}}]}, {\"role\": \"tool\", \"tool_call_id\": \"b\", \"content\": \"second\"}, {\"role\": \"tool\", \"tool_call_id\": \"a\", \"content\": \"first\"}, {\"role\": \"user\", \"content\": [{\"type\": \"image_url\", \"image_url\": {\"url\": \"data:image/png;base64,aGVsbG8=\", \"detail\": \"auto\"}}, {\"type\": \"text\", \"text\": \"Inspect\"}]}]"
    set tools to "[{\"type\":\"function\",\"function\":{\"name\":\"look\",\"description\":\"Read\",\"parameters\":{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"number\",\"maximum\":1.2300e+8}}},\"strict\":true}}]"
    set options to "{\"max_tokens\":64000,\"thinking\":{\"type\":\"adaptive\"},\"output_config\":{\"effort\":\"max\"}}"
    set translated to anthropic_request_create("fixture-model" and messages and tools and options)
    if not (archive_list_text(translated and 0) equals "ready"):
        display archive_list_text(translated and 0)
        return 1
    set body to archive_list_text(translated and 1)
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 2
    set output to provider_items(tokens and provider_member(tokens and 0 and "messages"))
    if output equals 0 or else length_list(output) is not equal to 4:
        return 3
    set result_message to get_list(output and 2)
    set results to provider_items(tokens and provider_member(tokens and result_message and "content"))
    if length_list(results) is not equal to 2 or else not (provider_value(tokens and provider_member(tokens and get_list(results and 0) and "tool_use_id")) equals "b") or else not (provider_value(tokens and provider_member(tokens and get_list(results and 1) and "tool_use_id")) equals "a"):
        return 4
    if string_index_of(body and "1.2300e+8") < 0 or else string_index_of(body and "aGVsbG8=") < 0 or else string_index_of(body and "hé🌍") < 0:
        return 5
    set thinking to provider_member(tokens and 0 and "thinking")
    set config to provider_member(tokens and 0 and "output_config")
    if not (provider_value(tokens and provider_member(tokens and thinking and "type")) equals "adaptive") or else not (provider_value(tokens and provider_member(tokens and config and "effort")) equals "max") or else not (provider_index(tokens and provider_member(tokens and 0 and "max_tokens")) equals "64000"):
        return 6
    set rejected to anthropic_messages_translate("[{\"role\": \"tool\", \"tool_call_id\": \"orphan\", \"content\": \"x\"}]")
    if not (archive_list_text(rejected and 0) equals "unmatched-tool-result"):
        display archive_list_text(rejected and 0)
        return 10
    set rejected to anthropic_messages_translate("[{\"role\": \"system\", \"content\": \"Echo system — unchanged\"}, {\"role\": \"user\", \"content\": \"hé🌍\"}, {\"role\": \"assistant\", \"content\": \"Checking\", \"tool_calls\": [{\"id\": \"a\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{\\\"n\\\":1.2300e+8}\"}}, {\"id\": \"b\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{}\"}}]}]")
    if not (archive_list_text(rejected and 0) equals "incomplete-messages"):
        display archive_list_text(rejected and 0)
        return 11
    set rejected to anthropic_messages_translate("[{\"role\": \"system\", \"content\": \"Echo system — unchanged\"}, {\"role\": \"user\", \"content\": \"hé🌍\"}, {\"role\": \"assistant\", \"content\": \"Checking\", \"tool_calls\": [{\"id\": \"a\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{\\\"n\\\":1.2300e+8}\"}}, {\"id\": \"b\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{}\"}}]}, {\"role\": \"user\", \"content\": \"interrupted\"}]")
    if not (archive_list_text(rejected and 0) equals "missing-tool-result"):
        display archive_list_text(rejected and 0)
        return 12
    set rejected to anthropic_messages_translate("[{\"role\": \"user\", \"content\": \"x\"}, {\"role\": \"system\", \"content\": \"late\"}]")
    if not (archive_list_text(rejected and 0) equals "mid-conversation-system-message"):
        display archive_list_text(rejected and 0)
        return 13
    set rejected to anthropic_messages_translate("[{\"role\": \"assistant\", \"content\": \"x\", \"reasoning_content\": \"unsigned\"}]")
    if not (archive_list_text(rejected and 0) equals "native-thinking-history-required"):
        display archive_list_text(rejected and 0)
        return 14
    set rejected to anthropic_messages_translate("[{\"role\": \"user\", \"content\": [{\"type\": \"input_audio\", \"input_audio\": {\"data\": \"test\"}}]}]")
    if not (archive_list_text(rejected and 0) equals "unsupported-message-content"):
        display archive_list_text(rejected and 0)
        return 15
    set rejected to anthropic_messages_translate("[{\"role\": \"user\", \"content\": \"x\", \"unknown\": true}]")
    if not (archive_list_text(rejected and 0) equals "unsupported-message-field"):
        display archive_list_text(rejected and 0)
        return 16
    set rejected to anthropic_messages_translate("[{\"role\": \"system\", \"content\": \"Echo system — unchanged\"}, {\"role\": \"user\", \"content\": \"hé🌍\"}, {\"role\": \"assistant\", \"content\": \"Checking\", \"tool_calls\": [{\"id\": \"a\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{\\\"n\\\":1.2300e+8}\"}}, {\"id\": \"b\", \"type\": \"function\", \"function\": {\"name\": \"look\", \"arguments\": \"{}\"}}]}, {\"role\": \"tool\", \"tool_call_id\": \"b\", \"content\": \"second\"}, {\"role\": \"tool\", \"tool_call_id\": \"b\", \"content\": \"second\"}]")
    if not (archive_list_text(rejected and 0) equals "unmatched-tool-result"):
        display archive_list_text(rejected and 0)
        return 17
    set rejected to anthropic_messages_translate("[{\"role\": \"user\", \"content\": \"x\", \"tool_calls\": []}]")
    if not (archive_list_text(rejected and 0) equals "invalid-tool-role"):
        display archive_list_text(rejected and 0)
        return 18
    set rejected to anthropic_request_create("fixture" and messages and tools and "{\"max_tokens\":-1}")
    if not (archive_list_text(rejected and 0) equals "invalid-output-budget"):
        return 30
    set rejected to anthropic_request_create("fixture" and messages and tools and "{\"max_tokens\":64000,\"model\":\"override\"}")
    if not (archive_list_text(rejected and 0) equals "invalid-native-options"):
        return 31
    set empty_tool_text to anthropic_messages_translate("[{\"role\":\"user\",\"content\":\"work\"},{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"a\",\"type\":\"function\",\"function\":{\"name\":\"look\",\"arguments\":\"{}\"}}]},{\"role\":\"tool\",\"tool_call_id\":\"a\",\"content\":\"done\"}]")
    if not (archive_list_text(empty_tool_text and 0) equals "ready"):
        return 32
    set replay to provider_json_tokens(archive_list_text(empty_tool_text and 2))
    set turns to provider_items(replay and 0)
    set blocks to provider_items(replay and provider_member(replay and get_list(turns and 1) and "content"))
    if length_list(blocks) is not equal to 1 or else not (provider_value(replay and provider_member(replay and get_list(blocks and 0) and "type")) equals "tool_use"):
        return 33
    display "PASS: system/text/Unicode/images, grouped parallel tool results and IDs, exact numeric/schema preservation, unchanged explicit reasoning/output settings; unsupported content, orphan/duplicate/missing results and unsigned thinking rejected."
    return 0
