import "../../app/providers/json_tokens"

define main returning Int:
    set valid to provider_json_tokens("{\"text\":\"hé\\uD83C\\uDF0D\",\"values\":[true,false,null,-123.456e+789,9999999999999999999999999999999999999999999]}")
    if valid equals 0:
        display "FAIL: valid JSON."
        return 1
    set text to get_list(valid and 3)
    if not (ptr_to_str(get_list(text and 3)) equals "hé🌍"):
        display "FAIL: Unicode string."
        return 1
    set decimal to get_list(valid and 14)
    set large to get_list(valid and 16)
    if not (ptr_to_str(get_list(decimal and 3)) equals "-123.456e+789") or else not (ptr_to_str(get_list(large and 3)) equals "9999999999999999999999999999999999999999999"):
        display "FAIL: exact numeric spelling."
        return 1
    set invalid to create_list()
    set added to append_list(invalid and "{\"x\":")
    set added to append_list(invalid and "[1,]")
    set added to append_list(invalid and "{\"x\":1,}")
    set added to append_list(invalid and "01")
    set added to append_list(invalid and "1.")
    set added to append_list(invalid and "1e+")
    set added to append_list(invalid and "true false")
    set added to append_list(invalid and "\"\\q\"")
    set added to append_list(invalid and "\"\\uD800\"")
    set added to append_list(invalid and "\"\\uDC00\"")
    set added to append_list(invalid and "\"\\u0000\"")
    set added to append_list(invalid and "[}")
    set added to append_list(invalid and "")
    set index to 0
    repeat while index is less than length_list(invalid):
        if provider_json_tokens(ptr_to_str(get_list(invalid and index))) is not equal to 0:
            display "FAIL: invalid JSON accepted."
            display index
            return 1
        set index to index + 1
    set builder to create_builder()
    set index to 0
    repeat while index is less than 2048:
        set added to builder_append(builder and "[")
        set index to index + 1
    set added to builder_append(builder and "null")
    repeat while index is greater than 0:
        set added to builder_append(builder and "]")
        set index to index - 1
    set deep to provider_json_tokens(ptr_to_str(builder_to_string(builder)))
    if deep equals 0 or else length_list(deep) is not equal to 4097:
        display "FAIL: explicit nesting stack."
        return 1
    display "PASS: strict JSON grammar, Unicode escape decoding, malformed/truncated input rejection and 2048 nested arrays without a fixed depth cap."
    return 0
