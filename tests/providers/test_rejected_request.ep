import "../../app/providers/prepare"

define main returning Int:
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 1
    set profile to provider_llama_profile("fixture" and 8080)
    set invalid to provider_prepare(database and "session" and "broken" and profile and "{broken" and 1 and -1 and 65536)
    if not (archive_list_text(invalid and 0) equals "invalid-provider-request-json"):
        return 2
    set duplicate to provider_prepare(database and "session" and "duplicate" and profile and "{\"model\":\"fixture\",\"model\":\"other\"}" and 1 and -1 and 65536)
    if not (archive_list_text(duplicate and 0) equals "duplicate-provider-request-member"):
        return 3
    set bad_profile to provider_prepare(database and "session" and "profile" and "{}" and "{}" and 1 and -1 and 65536)
    if not (archive_list_text(bad_profile and 0) equals "invalid-provider-profile"):
        return 4
    set receipt to archive_read_event(database and "broken:request-rejected")
    if receipt equals 0:
        return 5
    set fields to provider_json_tokens(archive_list_text(receipt and 3))
    if not (provider_value(fields and provider_member(fields and 0 and "request_body")) equals "{broken"):
        return 6
    if archive_verify(database and "session") is not equal to 0:
        return 7
    display "PASS: request errors retain exact evidence and do not masquerade as invalid provider profiles."
    return sql_close(database)
