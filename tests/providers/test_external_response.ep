import "fs"
import "os"
import "../../app/providers/external_response"
import "../../app/transport/native_open"

define main returning Int:
    if get_argument_count() is not equal to 4 or else file_exists(get_argument(3)):
        return 1
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to native_open_mode(system and get_argument(2) and 0 and 0)
    set errors to native_open_mode(system and "/dev/null" and 1 and 0)
    set database to archive_open(get_argument(3))
    if directory < 3 or else errors < 3 or else database equals 0:
        return 2
    set path to concat(get_argument(2) and "/response-body.fixture")
    for each family in ["openai-chat","anthropic-messages"]:
        for each mode in ["J","K","P","Q","U","R"]:
            set request to concat(family and mode)
            if archive_append(database and "session" and request and "model_request" and "{}" and "fixture") is not equal to 0 or else write_file(path and mode) is not equal to 1:
                return 3
            set transfer to external_transport_start_program(get_argument(1) and family and "fixture-private-key" and path and directory and errors and -1)
            set response to external_response_collect(database and "session" and request and family and transfer and 65536)
            set status to archive_list_text(response and 0)
            if mode equals "J":
                if not (status equals "complete"):
                    display status
                    return 4
                set choice to get_list(get_list(get_list(response and 1) and 0) and 0)
                if not (archive_list_text(choice and 1) equals "hé🌍"):
                    return 5
            else if mode equals "K":
                if not (status equals "helper-failed"):
                    display status
                    return 6
            else if mode equals "U" or else mode equals "R":
                if not (status equals "http-error"):
                    display status
                    return 7
            else if status equals "complete":
                return 8
            if get_list(transfer and 1) is not equal to 0 or else get_list(transfer and 2) is not equal to 0:
                display request
                display status
                return 9
            set terminal to archive_read_event(database and concat(request and ":transport-end"))
            if terminal equals 0:
                return 10
            set tokens to provider_json_tokens(archive_list_text(terminal and 3))
            if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals status):
                return 11
            if mode equals "P" or else mode equals "Q" or else mode equals "U" or else mode equals "R":
                if not (provider_value(tokens and provider_member(tokens and 0 and "process_status")) equals "aborted"):
                    return 12
    if archive_verify(database and "session") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 13
    set database to archive_open(get_argument(3))
    if archive_read_event(database and "anthropic-messagesJ:transport-end") equals 0 or else archive_verify(database and "session") is not equal to 0:
        return 14
    set closed to sql_close(database)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(system)
    display "PASS: both protocol families through process, HTTP, archive and assembly; Unicode; post-stream process failure; truncated body; 401/429; single reap; durable terminal evidence and reopen."
    return 0
