import "../../app/providers/restored_stream"

# Read-only reconstruction: no model request or tool execution is performed.
# The caller supplies a preserved archive, session, request and repetition count.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set database to archive_open(get_argument(1))
    set rounds to string_to_int(get_argument(4))
    if database equals 0 or else rounds < 1:
        return 2
    set count to 0
    repeat while count < rounds:
        set replay to provider_restore_stream(database and get_argument(2) and get_argument(3))
        set status to archive_list_text(replay and 0)
        if not (status equals "incomplete-response"):
            display status
            return 3
        set count to count + 1
    display "PASS: preserved incomplete stream remains incomplete across repeated reconstruction; no inference or tool execution."
    return sql_close(database)
