import "../../app/providers/local_json"
import "../fixtures/json_fixture"

define json_case with listener as List and method as Str and path as Str and body as Str and response as Str and expected_status as Str and expected_body as Str returning Int:
    set completed to channel
    set method_copy to concat(method and "")
    set path_copy to concat(path and "")
    set body_copy to concat(body and "")
    spawn json_fixture(listener and method_copy and path_copy and body_copy and response and completed)
    set result to local_json_request(get_list(listener and 2) and method and path and body and -1 and 65536)
    set fixture_result to receive from completed
    if fixture_result is not equal to 0 or else not (ptr_to_str(get_list(result and 0)) equals expected_status) or else not (ptr_to_str(get_list(result and 2)) equals expected_body):
        return 1
    return 0

define main returning Int:
    set listener to local_socket_listen(0)
    if listener equals 0:
        return 1
    if json_case(listener and "GET" and "/props" and "" and "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}" and "ready" and "{}") is not equal to 0:
        return 1
    if json_case(listener and "POST" and "/v1/chat/completions/input_tokens" and "{\"messages\":[]}" and "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\n{}\r\n0\r\n\r\n" and "ready" and "{}") is not equal to 0:
        return 1
    if json_case(listener and "GET" and "/v1/models" and "" and "HTTP/1.1 503 Unavailable\r\nContent-Length: 4\r\n\r\nbusy" and "http-error" and "busy") is not equal to 0:
        return 1
    if json_case(listener and "GET" and "/props" and "" and "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n{}" and "incomplete" and "{}") is not equal to 0:
        return 1
    if json_case(listener and "GET" and "/health" and "" and "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 15\r\n\r\n{\"status\":\"ok\"}" and "ready" and "{\"status\":\"ok\"}") is not equal to 0:
        return 1
    if local_socket_close(listener) is not equal to 0:
        return 1
    display "PASS: live discovery GET, exact token-count POST, chunked JSON, retained HTTP error body and truncated-body rejection."
    return 0
