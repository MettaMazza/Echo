import "../../app/agent/runner"
import "../../app/web/run_store"
import "fs"

# Live model acceptance, never a fixture substitute. Run only on an isolated
# archive and the exact Thinking profile; retain all failures and raw streams.
define thinking_turn with database as Int and session as Str and run as Str and prompt as Str and profile as Str and expected as Str returning Int:
    set submitted to web_submit_owned(database and "thinking-owner" and run and session and prompt)
    if not (archive_list_text(submitted and 0) equals "accepted"):
        display archive_list_text(submitted and 0)
        return 1
    set outcome to agent_loop_provider(database and run and profile and 2048 and -1 and 65536)
    if not (outcome equals "completed"):
        display outcome
        return 2
    set row to agent_run_read(database and run)
    set final to archive_read_event(database and archive_list_text(row and 3))
    set fields to provider_json_tokens(archive_list_text(final and 3))
    set text to provider_value(fields and provider_member(fields and 0 and "content"))
    display concat(run and concat(": " and text))
    if string_contains(text and expected) equals 0 or else string_contains(text and "Thought:") > 0 or else string_contains(text and "Action:") > 0 or else string_contains(text and "<think>") > 0:
        return 3
    if not (agent_provider_read(database and run) equals profile):
        return 4
    return archive_verify(database and archive_list_text(row and 0))

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        display "Supply fresh isolated archive and exact Thinking provider profile."
        return 1
    set profile to ptr_to_str(read_file(get_argument(2)))
    if string_contains(profile and "Thinking") equals 0:
        return 2
    set database to archive_open(get_argument(1))
    if web_run_schema(database) is not equal to 0 or else checkpoint_schema(database) is not equal to 0:
        return 3
    if web_pairing_invite(database and "thinking-invite") is not equal to 0 or else web_device_pair(database and "thinking-invite" and "thinking-owner" and "Isolated Thinking acceptance" and "thinking-fixture-secret") is not equal to 0:
        return 4
    if thinking_turn(database and "" and "thinking-one" and "For this isolated acceptance test, remember the marker ZINC_7319. Acknowledge it briefly. Do not use tools yet." and profile and "ZINC_7319") is not equal to 0:
        return 5
    set row to agent_run_read(database and "thinking-one")
    set session to concat(archive_list_text(row and 0) and "")
    set original to concat(archive_list_text(row and 1) and "")
    if sql_close(database) is not equal to 0:
        return 6
    set database to archive_open(get_argument(1))
    if thinking_turn(database and session and "thinking-two" and "Correction: the current marker is now PERIWINKLE_8426. State the previous marker and the corrected marker, briefly. No tools." and profile and "PERIWINKLE_8426") is not equal to 0:
        return 7
    if thinking_turn(database and session and "thinking-three" and "Use history_search to locate my original user message introducing ZINC_7319, then history_read to read that exact original event. Report its source event ID and the corrected current marker. Do not substitute recollection for those two tools and do no unrelated work." and profile and original) is not equal to 0:
        return 8
    if sql_close(database) is not equal to 0:
        return 9
    set database to archive_open(get_argument(1))
    if thinking_turn(database and session and "thinking-four" and "What is the current marker after my correction, and what is 17 plus 25? Answer in one line without tools." and profile and "PERIWINKLE_8426") is not equal to 0:
        return 10
    set checks to history_collect_one(checkpoint_prepare(database and "SELECT (SELECT COUNT(*) FROM echo_events WHERE session=?1 AND kind IN ('assistant_final','assistant_tool_calls') AND length(COALESCE(json_extract(payload,'$.reasoning_content'),''))>0),(SELECT COUNT(*) FROM echo_events WHERE session=?1 AND kind='assistant_final'),(SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events a ON a.event=t.result_event WHERE t.run='thinking-three' AND t.state='observed' AND json_extract(q.payload,'$.name')='history_search' AND json_extract(a.payload,'$.result.status')='found'),(SELECT COUNT(*) FROM echo_tool_calls t JOIN echo_events q ON q.event=t.request_event JOIN echo_events a ON a.event=t.result_event WHERE t.run='thinking-three' AND t.state='observed' AND json_extract(q.payload,'$.name')='history_read' AND json_extract(a.payload,'$.result.event')=?2),(SELECT COUNT(*) FROM echo_events WHERE kind='assistant_final' AND json_extract(payload,'$.run_id')='thinking-four' AND instr(json_extract(payload,'$.content'),'42')>0);" and [session,original]))
    if not (archive_list_text(checks and 0) equals "found") or else http_decimal(archive_list_text(checks and 1)) < 1 or else not (archive_list_text(checks and 2) equals "4") or else http_decimal(archive_list_text(checks and 3)) < 1 or else http_decimal(archive_list_text(checks and 4)) < 1 or else not (archive_list_text(checks and 5) equals "1"):
        display "FAIL: missing real reasoning, four finals, successful source-bound tools or arithmetic."
        return 11
    if archive_verify(database and session) is not equal to 0 or else sql_close(database) is not equal to 0:
        return 12
    display "PASS: actual Thinking reasoning, four completed turns, corrected recall after archive reopen, successful search/read of original source, arithmetic and immutable provider/archive verification. Browser and media acceptance remain separate."
    return 0
