import "../../app/providers/llama_modalities"
import "fs"

# Private orchestration supplies a retained request; never publish its payload.
define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set body to ptr_to_str(read_file(get_argument(1)))
    set started to ep_time_now_ms()
    set tokens to provider_json_tokens(body)
    display concat("parse_ms=" and int_to_string(ep_time_now_ms() - started))
    if tokens equals 0 or else provider_unique_objects(tokens) equals 0:
        return 2
    display concat("tokens=" and int_to_string(length_list(tokens)))
    # Compare every decoded string with the prior escape-capable decoder,
    # outside the timed parse. This checks the entire retained request, not
    # only selected media fields or aggregate token counts.
    for each token in tokens:
        if archive_list_text(token and 0) equals "string":
            set state to [body,string_length(body),get_list(token and 1),0]
            set reference to provider_decode_string(state)
            if not (archive_list_text(token and 3) equals ptr_to_str(get_json_value(reference))):
                display "FAIL: decoded string differs from reference decoder"
                return 3
    display "all_decoded_strings_match_reference=true"
    set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
    for each message in messages:
        set content to provider_member(tokens and message and "content")
        if provider_kind(tokens and content) equals "[":
            set parts to provider_items(tokens and content)
            for each part in parts:
                if provider_value(tokens and provider_member(tokens and part and "type")) equals "input_audio":
                    set audio to provider_member(tokens and part and "input_audio")
                    set data to provider_value(tokens and provider_member(tokens and audio and "data"))
                    display concat("encoded_audio_sha256=" and ep_sha256(data))
    return 0
