import "../../app/providers/prepare"

define main returning Int:
    set body to "{\"model\":\"test\",\"messages\":[]}"
    if not (provider_scheduled_body("session:user" and "request" and body) equals body):
        return 1
    set delegated to provider_json_tokens(provider_scheduled_body("task:child" and "request" and body))
    if not (provider_kind(delegated and provider_member(delegated and 0 and "echo_background")) equals "true"):
        return 2
    set memory to provider_json_tokens(provider_scheduled_body("session:user" and "memory:extract" and body))
    if not (provider_kind(memory and provider_member(memory and 0 and "echo_background")) equals "true"):
        return 3
    print "PASS: interactive requests unchanged; delegated and memory requests use background admission."
    return 0
