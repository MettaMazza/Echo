import "../../app/providers/openai_responses_count"

define main returning Int:
    set body to "{\"model\":\"fixture-model\",\"input\":[{\"type\":\"reasoning\",\"id\":\"rs_fixture\",\"summary\":[],\"encrypted_content\":\"opaque+/==\"},{\"type\":\"function_call\",\"call_id\":\"call1\",\"name\":\"measure\",\"arguments\":\"{\\\"n\\\":1.2300}\"},{\"type\":\"function_call_output\",\"call_id\":\"call1\",\"output\":\"original result\"}],\"tools\":[{\"type\":\"function\",\"name\":\"measure\",\"parameters\":{\"type\":\"object\",\"minimum\":1.2300}}],\"reasoning\":{\"effort\":\"xhigh\"},\"store\":false,\"truncation\":\"disabled\",\"stream\":true,\"max_output_tokens\":20000}"
    set counted to openai_responses_count_request(body)
    set source to provider_json_tokens(body)
    set result to provider_json_tokens(counted)
    if result equals 0:
        return 1
    for each field in ["model","input","tools","reasoning","truncation"]:
        if not (anthropic_json_source(body and source and provider_member(source and 0 and field)) equals anthropic_json_source(counted and result and provider_member(result and 0 and field))):
            return 2
    for each field in ["store","stream","max_output_tokens"]:
        if provider_member(result and 0 and field) >= 0:
            return 3
    for each invalid in ["{\"model\":\"fixture\",\"messages\":[]}","{\"model\":\"fixture\",\"input\":[],\"store\":false,\"truncation\":\"auto\"}","{\"model\":\"fixture\",\"input\":[],\"store\":true,\"truncation\":\"disabled\"}","{\"model\":\"fixture\",\"input\":[],\"store\":false,\"truncation\":\"disabled\",\"previous_response_id\":\"resp_other\"}"]:
        if string_length(openai_responses_count_request(invalid)) > 0:
            return 4
    if openai_responses_count_value("{\"object\":\"response.input_tokens\",\"input_tokens\":123}") is not equal to 123:
        return 5
    for each invalid in ["{\"input_tokens\":123}","{\"object\":\"response.input_tokens\",\"input_tokens\":1.2}","{\"object\":\"response.input_tokens\",\"input_tokens\":-1}","{\"object\":\"response.input_tokens\",\"input_tokens\":1,\"input_tokens\":2}"]:
        if openai_responses_count_value(invalid) is not equal to -1:
            return 6
    display "PASS: native Responses count preserves replay/tool/reasoning bytes, excludes generation-only fields and rejects Chat format, hidden stored state, truncation and invalid counts."
    return 0
