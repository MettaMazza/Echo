import "../../app/research/native_ffi"

# Real upstream structure-return and structure-argument calls. No model weights
# are loaded. The GGUF read validates named metadata via the engine's parser.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set ffi to research_ffi_open()
    set llama to ep_dlopen(get_argument(1))
    if ffi equals 0 or else llama equals 0:
        return 1
    set pointer to research_ffi_type(ffi and "pointer")
    set integer to research_ffi_type(ffi and "sint32")
    set byte to research_ffi_type(ffi and "uint8")
    set members to [pointer, pointer, integer, integer, integer, integer, integer, pointer, pointer, pointer, pointer, byte, byte, byte, byte, byte, byte]
    set model_type to research_ffi_structure(members)
    set offsets to research_ffi_offsets(ffi and model_type)
    if offsets equals 0 or else get_list(offsets and 2) is not equal to 16 or else get_list(offsets and 11) is not equal to 72:
        display "FAIL: installed model parameter ABI offsets differ"
        return 1
    set parameters to research_ffi_invoke(ffi and ep_dlsym(llama and "llama_model_default_params") and research_ffi_pointer(model_type) and create_list() and create_list())
    if parameters equals 0 or else length_list(parameters) is not equal to 10:
        display "FAIL: native model defaults structure not returned"
        return 1
    set gguf_type to research_ffi_structure([byte, pointer])
    set gguf_offsets to research_ffi_offsets(ffi and gguf_type)
    if gguf_offsets equals 0 or else get_list(gguf_offsets and 1) is not equal to 8:
        return 1
    set path to [str_to_ptr(get_argument(2))]
    set options to [1, 0]
    set opened to research_ffi_invoke(ffi and ep_dlsym(llama and "gguf_init_from_file") and pointer and [pointer, research_ffi_pointer(gguf_type)] and [get_list_data_ptr(path), get_list_data_ptr(options)])
    if opened equals 0 or else get_list(opened and 0) equals 0:
        display "FAIL: native GGUF open"
        return 1
    set context to get_list(opened and 0)
    set key to ep_dlcall2(ep_dlsym(llama and "gguf_find_key") and context and str_to_ptr("general.architecture"))
    if key is less than 0:
        return 1
    set architecture to ptr_to_str(ep_dlcall2(ep_dlsym(llama and "gguf_get_val_str") and context and key))
    display concat("Native GGUF architecture: " and architecture)
    set ignored to ep_dlcall1(ep_dlsym(llama and "gguf_free") and context)
    if not (architecture equals "qwen4exp"):
        return 1
    display "PASS: Ernos libffi binding returned native model defaults and passed a GGUF parameter structure by value to the installed engine."
    return 0
