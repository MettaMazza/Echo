# Verifies the existing compiler's named-function ABI for native research
# callbacks. No compiler changes or generated-code edits.
define research_callback_probe with tensor as Int and ask as Int and user_data as Int returning Int:
    return tensor + ask + user_data

define main returning Int:
    set function to research_callback_probe
    if ep_dlcall3(function and 17 and 1 and 23) is not equal to 41:
        return 1
    display "PASS: named Ernos function invoked through existing native function-pointer call."
    return 0
