import "../../app/research/run_record"

define research_record_writer with path as Str and content as Str and finished as Int returning Int:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set result to research_record_write(system and path and content)
    set closed to ep_dlclose(system)
    send result to finished
    return 0

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set path to get_argument(1)
    set original to "{\"status\":\"requested\",\"prompt\":\"literal \\\"quote\\\" and \\n newline\"}"
    if research_record_write(system and path and original) is not equal to 0:
        display "FAIL: first durable publication"
        return 1
    if not (ptr_to_str(read_file(path)) equals original):
        return 1
    if research_record_write(system and path and "{\"status\":\"overwritten\"}") equals 0 or else not (ptr_to_str(read_file(path)) equals original):
        display "FAIL: existing record overwritten"
        return 1
    if research_record_write(system and concat(path and ".invalid") and "not JSON") equals 0 or else file_exists(concat(path and ".invalid")):
        return 1
    if string_length(research_file_record(path)) equals 0:
        return 1
    set race_path to concat(path and ".race")
    set first_path to concat(race_path and "")
    set second_path to concat(race_path and "")
    set completed to channel
    spawn research_record_writer(first_path and "{\"writer\":1}" and completed)
    spawn research_record_writer(second_path and "{\"writer\":2}" and completed)
    set first to receive from completed
    set second to receive from completed
    set published to ptr_to_str(read_file(race_path))
    if first + second is not equal to 1 or else not (published equals "{\"writer\":1}" or else published equals "{\"writer\":2}"):
        display "FAIL: competing publishers"
        return 1
    display "PASS: exclusive durable JSON publication on One Touch, original bytes preserved on duplicate, invalid JSON rejected, artifact digest available; two simultaneous publishers produced exactly one successful complete record."
    return 0
