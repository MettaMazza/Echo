import "../../app/workspace/directories"
import "select"

define directory_errno_worker with completed as Int returning Int:
    set root_path to get_argument(1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and root_path)
    if root < 0:
        send 1 to completed
        return 1
    set index to 0
    set status to 0
    repeat while index < 10000 and status equals 0:
        set directory to workspace_directory_open(library and root and "existing/nested" and 1)
        if directory < 0:
            set status to 2
        else:
            set closed to net_close(directory)
        set index to index + 1
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    send status to completed
    return status

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set first to channel
    set second to channel
    spawn directory_errno_worker(first)
    spawn directory_errno_worker(second)
    set waits to create_list()
    set added to append_list(waits and first)
    set added to append_list(waits and second)
    set remaining to 2
    repeat while remaining > 0:
        set ready to select(waits and 20)
        if ready >= 0:
            set result to receive from get_list(waits and ready)
            if result is not equal to 0:
                return result
            set remaining to remaining - 1
    display "PASS: existing directories remain valid under concurrent allocation and errno changes."
    return 0
