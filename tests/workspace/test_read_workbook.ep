import "../../app/tools/workspace_tools"
import "../../app/web/run_store"
import "../../app/archive/file_copy"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(system and get_argument(1))
    if root < 0:
        return 2
    set result to workspace_read_workbook(system and root and "book.xlsx" and "" and 0 and 10)
    display result
    if string_contains(result and "Résumé") equals 0 or else string_contains(result and "hidden") equals 0:
        return 3
    set result to workspace_read_workbook(system and root and "book.xlsx" and "Résumé" and 0 and 10)
    display result
    if string_contains(result and "café 世界") equals 0 or else string_contains(result and "900719925474099312345") equals 0 or else string_contains(result and "SUM(B1:B2)") equals 0 or else string_contains(result and "1904") equals 0:
        return 4
    set page to workspace_read_workbook(system and root and "book.xlsx" and "Résumé" and 1 and 1)
    if string_contains(page and "B1") equals 0 or else string_contains(page and "A1") > 0:
        return 5
    if not (workbook_target("xl/workbook.xml" and "../sheets/a.xml") equals "sheets/a.xml") or else not (workbook_target("" and "../../escape.xml") equals ""):
        return 6
    set bad to workbook_parts(system and root and "duplicate.xlsx")
    if not (archive_list_text(bad and 0) equals "duplicate-workbook-part"):
        return 7
    set database to archive_open(get_argument(2))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 8
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 9
    set submitted to web_submit_owned(database and "owner" and "workbook" and "" and "Read workbook.")
    set session to archive_list_text(submitted and 1)
    set directory to workspace_session_open(database and system and "owner" and session and get_env("ECHO_WORKSPACE_ROOT"))
    if directory < 0:
        return 10
    set source to concat(get_argument(1) and "/book.xlsx")
    set digest to file_digest(source and 65536)
    set row to history_collect_one(archive_prepare(database and "SELECT directory FROM echo_workspaces LIMIT 1;"))
    set destination to concat(get_env("ECHO_WORKSPACE_ROOT") and concat("/" and concat(archive_list_text(row and 1) and "/book.xlsx")))
    if file_copy_verified(source and destination and archive_list_text(digest and 1) and get_list(digest and 2) and 65536) is not equal to 0:
        return 11
    set arguments to "{\"path\":\"book.xlsx\",\"sheet\":\"Résumé\",\"offset\":0,\"cells\":10}"
    if not (workspace_tool_execute_device(database and "owner" and session and arguments and "workbook") equals result):
        return 12
    if string_contains(workspace_tool_execute_device(database and "outsider" and session and arguments and "workbook") and "café") > 0:
        return 13
    if web_device_revoke(database and "owner") is not equal to 0 or else string_contains(workspace_tool_execute_device(database and "owner" and session and arguments and "workbook") and "café") > 0:
        return 14
    set closed to net_close(directory)
    set closed to sql_close(database)
    set closed to net_close(root)
    set closed to ep_dlclose(system)
    display "PASS: XLSX sheet catalogue, hidden state, shared rich text, exact numeric spelling, cached formula, date system, paging, relationship resolution and duplicate-part rejection."
    return 0
