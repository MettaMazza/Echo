import "../../app/workspace/ernos_runtime"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 4:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and get_argument(2))
    set conflict to workspace_root_open(library and get_argument(3))
    if directory < 0 or else conflict < 0:
        return 2
    if not (workspace_ernos_prepare(library and directory and get_argument(1)) equals "ready") or else not (workspace_ernos_prepare(library and directory and get_argument(1)) equals "ready"):
        return 3
    set path to concat(get_argument(3) and "/stdlib")
    if write_file(path and "User-owned file remains intact") is not equal to 1:
        return 4
    if not (workspace_ernos_prepare(library and conflict and get_argument(1)) equals "ernos-stdlib-conflict") or else not (ptr_to_str(read_file(path)) equals "User-owned file remains intact"):
        return 5
    if not (workspace_ernos_prepare(library and directory and get_argument(3)) equals "ernos-runtime-incomplete"):
        return 6
    if not (workspace_ernos_arguments(library and directory and ["bad;command.ep"]) equals "ernos-source-name-requires-letters-digits-underscore") or else not (workspace_ernos_arguments(library and directory and ["../outside.ep"]) equals "ernos-invalid-source") or else not (workspace_ernos_arguments(library and directory and ["--arbitrary","file.ep"]) equals "ernos-invalid-arguments"):
        return 7
    set previous to ptr_to_str(get_env("ECHO_ERNOS_COMPILER_SHA256"))
    set changed to set_env("ECHO_ERNOS_COMPILER_SHA256" and "incorrect")
    if not (workspace_ernos_prepare(library and directory and get_argument(1)) equals "ernos-compiler-digest-mismatch"):
        return 8
    set changed to set_env("ECHO_ERNOS_COMPILER_SHA256" and previous)
    set closed to net_close(directory)
    set closed to net_close(conflict)
    set closed to ep_dlclose(library)
    display "PASS: configured compiler/library discovered, repeated link preparation idempotent, conflicting user file preserved, incomplete runtime rejected."
    return 0
