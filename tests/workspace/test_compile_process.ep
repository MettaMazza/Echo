import "../../app/workspace/sandbox_process"
import "../../app/workspace/files"
import "fs"

define compile_probe_run with runtime as Str and workspace as Str and executable as Str and source as Str and phase as Str returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and workspace)
    set output to workspace_file_open(library and directory and concat(phase and "-stdout.txt") and 1)
    set errors to workspace_file_open(library and directory and concat(phase and "-stderr.txt") and 1)
    if directory is less than 3 or else output is less than 3 or else errors is less than 3:
        return 1
    set arguments to create_list()
    if string_length(source) is greater than 0:
        set added to append_list(arguments and source)
    set environment to create_list()
    set added to append_list(environment and "PATH=/Library/Developer/CommandLineTools/usr/bin:/usr/bin:/bin")
    set added to append_list(environment and "SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk")
    set added to append_list(environment and concat("TMPDIR=" and concat(workspace and "/tmp")))
    set handle to workspace_sandbox_start(runtime and workspace and executable and arguments and environment and directory and output and errors)
    if handle equals 0:
        display concat("FAIL: start " and phase)
        return 1
    set state to 0
    repeat while state equals 0:
        set state to workspace_process_poll(handle)
        set slept to sleep_ms(10)
    if state is not equal to 1 or else get_list(handle and 3) is not equal to 0:
        display concat("FAIL: child status for " and phase)
        return 1
    set closed to workspace_process_close(handle)
    set closed to net_close(output)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set runtime to get_argument(1)
    set workspace to get_argument(2)
    if compile_probe_run(runtime and workspace and concat(runtime and "/epc") and concat(workspace and "/hello_sandbox.ep") and "compile") is not equal to 0:
        return 1
    if compile_probe_run(runtime and workspace and concat(workspace and "/hello_sandbox") and "" and "run") is not equal to 0:
        return 1
    if not (ptr_to_str(read_file(concat(workspace and "/run-stdout.txt"))) equals "Hello Echo from compiled Ernos.\n"):
        return 1
    if string_length(ptr_to_str(read_file(concat(workspace and "/run-stderr.txt")))) is not equal to 0 or else string_length(ptr_to_str(read_file(concat(workspace and "/compile-stderr.txt")))) is not equal to 0:
        return 1
    display "PASS: native adapter compiled a complete Ernos program with stdlib, then ran its exact binary inside the sandbox."
    return 0
