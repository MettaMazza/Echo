import "../../app/tools/execution_output"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0:
        return 2
    if archive_append(database and "fixture" and "one" and "process_output" and "{\"run_id\":\"run\",\"call_id\":\"call\",\"stream\":\"stdout\",\"offset\":\"0\",\"bytes\":\"4\",\"eof\":0,\"data\":\"636166c3\"}" and "now") is not equal to 0:
        return 3
    if archive_append(database and "fixture" and "two" and "process_output" and "{\"run_id\":\"run\",\"call_id\":\"call\",\"stream\":\"stdout\",\"offset\":\"4\",\"bytes\":\"1\",\"eof\":0,\"data\":\"a9\"}" and "now") is not equal to 0:
        return 4
    set preview to provider_json_tokens(execution_output_preview(database and "run" and "call" and "stdout"))
    if not (provider_value(preview and provider_member(preview and 0 and "text")) equals "café") or else not (provider_value(preview and provider_member(preview and 0 and "complete")) equals "0"):
        return 5
    if archive_append(database and "fixture" and "end" and "process_output" and "{\"run_id\":\"run\",\"call_id\":\"call\",\"stream\":\"stdout\",\"offset\":\"5\",\"bytes\":\"0\",\"eof\":1,\"data\":\"\"}" and "now") is not equal to 0:
        return 6
    set preview to provider_json_tokens(execution_output_preview(database and "run" and "call" and "stdout"))
    if not (provider_value(preview and provider_member(preview and 0 and "complete")) equals "1"):
        return 7
    set other to provider_json_tokens(execution_output_preview(database and "another-run" and "call" and "stdout"))
    if not (provider_value(other and provider_member(other and 0 and "text")) equals ""):
        return 8
    display "PASS: joined UTF-8 chunks, EOF completeness and exact invocation isolation"
    return sql_close(database)
