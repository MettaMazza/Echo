import "../../app/tools/workspace_tools"
import "../../app/web/run_store"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    set submitted to web_submit_owned(database and "owner" and "text-operations" and "" and "Search and edit my file.")
    set session to archive_list_text(submitted and 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "owner" and session and get_argument(2))
    set builder to create_builder()
    set index to 0
    repeat while index < 65535:
        set added to builder_append(builder and "a")
        set index to index + 1
    set added to builder_append(builder and "café second café final-tail-marker")
    set text to ptr_to_str(builder_to_string(builder))
    if root < 0 or else not (workspace_create_text(library and root and "source.txt" and text) equals "created"):
        return 4
    set complete to workspace_read_text(library and root and "source.txt" and 7 and 0 and -1)
    if not (archive_list_text(complete and 0) equals "read") or else not (archive_list_text(complete and 1) equals text) or else not (archive_list_text(complete and 3) equals ep_sha256(text)):
        return 5
    set found to workspace_tool_execute_device(database and "owner" and session and "{\"path\":\"source.txt\",\"query\":\"café\",\"offset\":0,\"matches\":1}" and "search")
    set tokens to provider_json_tokens(found)
    if string_contains(found and "[65535]") equals 0 or else not (provider_kind(tokens and provider_member(tokens and 0 and "end")) equals "false"):
        display found
        return 6
    set offset to history_tool_integer(tokens and "next_offset")
    set found to workspace_search_text(library and root and "source.txt" and "café" and offset and 10)
    if string_contains(found and "[65548]") equals 0 or else string_contains(found and "\"end\":true") equals 0:
        display found
        return 7
    set replacement to "New café text with final-tail-preserved."
    set stale to workspace_edit_text(library and root and "source.txt" and ep_sha256("stale") and replacement)
    if string_contains(stale and "\"status\":\"conflict\"") equals 0:
        return 8
    set args to concat("{\"path\":\"source.txt\",\"expected_sha256\":" and provider_quote(ep_sha256(text)))
    set args to concat(args and concat(",\"text\":" and concat(provider_quote(replacement) and "}")))
    set edited to workspace_tool_execute_device(database and "owner" and session and args and "edit")
    set tokens to provider_json_tokens(edited)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "edited"):
        display edited
        return 9
    set backup to provider_value(tokens and provider_member(tokens and 0 and "retained_sibling"))
    set prior to workspace_read_text(library and root and backup and 65536 and 0 and -1)
    set current to workspace_read_text(library and root and "source.txt" and 65536 and 0 and -1)
    if not (archive_list_text(prior and 1) equals text) or else not (archive_list_text(current and 1) equals replacement):
        return 10
    set repeated to workspace_tool_execute_device(database and "owner" and session and args and "edit")
    if string_contains(repeated and "content-already-present") equals 0:
        return 11
    if not (workspace_create_text(library and root and "before.txt" and "same\ncafé old\nlast\n") equals "created") or else not (workspace_create_text(library and root and "after.txt" and "same\ncafé new\nlast\n") equals "created"):
        return 14
    set difference to workspace_tool_execute_device(database and "owner" and session and "{\"path\":\"before.txt\",\"other_path\":\"after.txt\"}" and "diff")
    set diff_tokens to provider_json_tokens(difference)
    if not (provider_value(diff_tokens and provider_member(diff_tokens and 0 and "before")) equals "café old\n") or else not (provider_value(diff_tokens and provider_member(diff_tokens and 0 and "after")) equals "café new\n") or else history_tool_integer(diff_tokens and "start_line") is not equal to 2:
        display difference
        return 15
    set same to workspace_diff_text(library and root and "before.txt" and "before.txt")
    if string_contains(same and "\"changed\":false") equals 0:
        return 16
    if web_device_revoke(database and "owner") is not equal to 0:
        return 12
    set denied to workspace_tool_execute_device(database and "owner" and session and args and "edit")
    if string_contains(denied and "\"status\":\"edited\"") > 0:
        return 13
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    display "PASS: complete UTF-8 text across chunk boundaries, paged literal search offsets, stale-edit refusal, atomic replacement with exact original retained, retry and revocation."
    return sql_close(database)
