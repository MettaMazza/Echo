import "../../app/workspace/create_archive"
import "../../app/workspace/list_archive"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(system and get_argument(1))
    if root < 0:
        return 2
    for each format in ["zip", "tar", "tar.gz"]:
        set destination to concat("created." and ptr_to_str(format))
        set made to workspace_create_archive(system and root and ["binary.dat", "plain.txt"] and destination and ptr_to_str(format))
        set tokens to provider_json_tokens(made)
        if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "created"):
            display made
            return 3
        set digest to provider_value(tokens and provider_member(tokens and 0 and "archive_sha256"))
        set result to workspace_archive_operation(system and root and destination and 0 and 1 and concat("restored." and ptr_to_str(format)) and digest)
        set restored to provider_json_tokens(result)
        set original to file_digest(concat(get_argument(1) and "/binary.dat") and 65536)
        if not (provider_value(restored and provider_member(restored and 0 and "extracted_sha256")) equals archive_list_text(original and 1)):
            display result
            return 4
        if string_contains(workspace_create_archive(system and root and ["plain.txt"] and destination and ptr_to_str(format)) and "already-exists") equals 0:
            return 5
        set unchanged to file_digest(concat(get_argument(1) and concat("/" and destination)) and 65536)
        if not (archive_list_text(unchanged and 1) equals digest):
            return 6
    if string_contains(workspace_create_archive(system and root and ["plain.txt", "plain.txt"] and "duplicate.zip" and "zip") and "duplicate-source") equals 0:
        return 7
    if string_contains(workspace_create_archive(system and root and ["../outside"] and "unsafe.zip" and "zip") and "invalid-source-path") equals 0:
        return 8
    if string_contains(workspace_create_archive(system and root and ["missing"] and "missing.zip" and "zip") and "archive-write-failed") equals 0:
        return 9
    set closed to net_close(root)
    set closed to ep_dlclose(system)
    display "PASS: ZIP/TAR/gzip creation and binary extraction digest roundtrip, exclusive existing-file preservation, duplicate/path rejection and missing-source failure."
    return 0
