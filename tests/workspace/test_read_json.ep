import "../../app/tools/workspace_tools"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 7
    set original to " {\"items\":[{\"café/key\":900719925474099312345}],\"empty\":null} "
    set result to workspace_json_select(original and ["items", "0", "café/key"])
    set tokens to provider_json_tokens(result)
    if not (provider_value(tokens and provider_member(tokens and 0 and "json")) equals "900719925474099312345") or else not (provider_value(tokens and provider_member(tokens and 0 and "sha256")) equals ep_sha256(original)):
        display result
        return 1
    if string_contains(workspace_json_select(original and ["items", "00"]) and "not-found") equals 0:
        return 2
    if string_contains(workspace_json_select(original and ["empty", "x"]) and "path-type-mismatch") equals 0:
        return 3
    if string_contains(workspace_json_select("{\"a\":1,\"a\":2}" and []) and "invalid-or-ambiguous-json") equals 0:
        return 4
    if string_contains(workspace_json_select("{\"a\":1} trailing" and ["a"]) and "invalid-or-ambiguous-json") equals 0:
        return 5
    set root to provider_json_tokens(workspace_json_select(original and []))
    if not (provider_value(root and provider_member(root and 0 and "json")) equals substring(original and 1 and string_length(original) - 2)):
        return 6
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 8
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 9
    set submitted to web_submit_owned(database and "owner" and "json" and "" and "Read JSON.")
    set session to archive_list_text(submitted and 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_session_open(database and library and "owner" and session and get_argument(2))
    if directory < 0 or else not (workspace_create_text(library and directory and "source.json" and original) equals "created"):
        return 10
    set args to "{\"path\":\"source.json\",\"segments\":[\"items\",\"0\",\"café/key\"]}"
    if not (workspace_tool_execute_device(database and "owner" and session and args and "json") equals result):
        return 11
    if string_contains(workspace_tool_execute_device(database and "outsider" and session and args and "json") and "900719925474099312345") > 0:
        return 12
    if web_device_revoke(database and "owner") is not equal to 0 or else string_contains(workspace_tool_execute_device(database and "owner" and session and args and "json") and "900719925474099312345") > 0:
        return 13
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    set closed to sql_close(database)
    display "PASS: exact large-number spelling, Unicode/slash keys, canonical indexes, null type mismatch, duplicate/trailing rejection and root selection."
    return 0
