import "../../app/workspace/process_journal"
import "../../app/workspace/files"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set mode to get_argument(2)
    if mode equals "inspect":
        if not file_exists(path):
            return 1
        set database to archive_open(path)
        if database equals 0 or else workspace_process_reserve(database and "run" and "call" and "{}") equals 0:
            return 1
        set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_process_launches WHERE started IS NULL AND finished IS NULL;"))
        if not (ptr_to_str(get_list(row and 0)) equals "found") or else not (ptr_to_str(get_list(row and 1)) equals "1"):
            return 1
        if archive_verify(database and "home") is not equal to 0 or else sql_close(database) is not equal to 0:
            return 1
        display "PASS: interrupted reservation survived; no start/exit invented and duplicate launch refused."
        return 0
    if file_exists(path):
        return 1
    set database to archive_open(path)
    if database equals 0 or else tool_ledger_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "home" and "request" and "tool_call" and "{\"run_id\":\"run\",\"call_id\":\"call\"}" and "fixture") is not equal to 0 or else tool_ledger_queue(database and "run" and "call" and "home" and "request") is not equal to 0 or else tool_ledger_claim(database and "run" and "call") is not equal to 0:
        return 1
    if workspace_process_reserve(database and "run" and "call" and "{\"fixture\":\"launch interruption\"}") is not equal to 0:
        return 1
    if mode equals "wait":
        repeat while 1 equals 1:
            set slept to sleep_ms(100)
    if not (mode equals "spawn-failure"):
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and "/private/tmp")
    set output to socket_cancellation_create(library)
    set errors to socket_cancellation_create(library)
    if directory is less than 3 or else output equals 0 or else errors equals 0:
        return 1
    set arguments to create_list()
    set environment to create_list()
    set handle to workspace_process_start("/echo-missing-executable" and arguments and environment and directory and get_list(output and 1) and get_list(errors and 1))
    if handle is not equal to 0:
        return 1
    if workspace_process_spawn_failed(database and "run" and "call") is not equal to 0 or else workspace_process_spawn_failed(database and "run" and "call") equals 0:
        return 1
    # Rejected terminal-to-start transition, even with a forged test-only handle.
    set fake to create_list()
    set added to append_list(fake and library)
    set added to append_list(fake and 123)
    set added to append_list(fake and 0)
    set added to append_list(fake and 0)
    if workspace_process_receipt(database and "run" and "call" and fake and "") equals 0:
        return 1
    set closed to socket_cancellation_close(output)
    set closed to socket_cancellation_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    if archive_verify(database and "home") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: native missing-executable failure recorded once; later start rejected."
    return 0
