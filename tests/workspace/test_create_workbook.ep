import "../../app/tools/workspace_tools"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(system and get_argument(1))
    if root < 0:
        return 2
    set input to "[{\"name\":\"Résumé\",\"rows\":[[\"café 世界 & <tag>\",\"00042\",900719925474099312345,true,null,{\"formula\":\"=SUM(C1:C2)\",\"cached\":42}],[\"line one\\nline two\"]]},{\"name\":\"Second\",\"rows\":[]}]"
    set result to workspace_create_workbook(system and root and "created.xlsx" and input)
    display result
    set response to provider_json_tokens(result)
    if not (provider_value(response and provider_member(response and 0 and "status")) equals "created"):
        return 3
    set result to workspace_read_workbook(system and root and "created.xlsx" and "Résumé" and 0 and 20)
    display result
    if string_contains(result and "café 世界 & <tag>") equals 0 or else string_contains(result and "00042") equals 0 or else string_contains(result and "900719925474099312345") equals 0 or else string_contains(result and "SUM(C1:C2)") equals 0:
        return 4
    set before to file_digest(concat(get_argument(1) and "/created.xlsx") and 65536)
    if string_contains(workspace_create_workbook(system and root and "created.xlsx" and input) and "already-exists") equals 0:
        return 5
    set after to file_digest(concat(get_argument(1) and "/created.xlsx") and 65536)
    if not (archive_list_text(before and 1) equals archive_list_text(after and 1)):
        return 6
    if workbook_create_parts("[{\"name\":\"A\",\"rows\":[]},{\"name\":\"a\",\"rows\":[]}]") is not equal to 0 or else workbook_create_parts("[{\"name\":\"bad/name\",\"rows\":[]}]") is not equal to 0 or else workbook_create_parts("[{\"name\":\"A\",\"rows\":[[{\"formula\":\"\"}]]}]") is not equal to 0:
        return 7
    if workbook_sheet_name_valid("History") is not equal to 0:
        return 15
    if not (workbook_column(16384) equals "XFD") or else not (workbook_column(27) equals "AA"):
        return 8
    set database to archive_open(concat(get_argument(1) and "/archive.sqlite"))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 9
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 10
    set submitted to web_submit_owned(database and "owner" and "create-book" and "" and "Create workbook.")
    set session to archive_list_text(submitted and 1)
    set arguments to concat("{\"path\":\"scoped.xlsx\",\"sheets\":" and concat(input and "}"))
    set result to workspace_tool_execute_device(database and "owner" and session and arguments and "workbook-create")
    set response to provider_json_tokens(result)
    if not (provider_value(response and provider_member(response and 0 and "status")) equals "created"):
        display result
        return 11
    set read_arguments to "{\"path\":\"scoped.xlsx\",\"sheet\":\"Résumé\",\"offset\":0,\"cells\":20}"
    if string_contains(workspace_tool_execute_device(database and "owner" and session and read_arguments and "workbook") and "00042") equals 0:
        return 12
    if string_contains(workspace_tool_execute_device(database and "outsider" and session and arguments and "workbook-create") and "archive_sha256") > 0:
        return 13
    if web_device_revoke(database and "owner") is not equal to 0 or else string_contains(workspace_tool_execute_device(database and "owner" and session and arguments and "workbook-create") and "archive_sha256") > 0:
        return 14
    set closed to sql_close(database)
    set closed to net_close(root)
    set closed to ep_dlclose(system)
    display "PASS: new XLSX with Unicode/escaped text, exact numeric spelling, typed values, supplied formula cache, multiple sheets, no overwrite, invalid input and format column names."
    return 0
