import "../../app/workspace/plot_svg"
import "fs"
import "../../app/tools/workspace_tools"
import "../../app/web/run_store"

define main returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set specification to "{\"title\":\"Café <plot> & data\",\"x_label\":\"Time\",\"y_label\":\"Result\",\"series\":[{\"name\":\"Measured\",\"kind\":\"line\",\"points\":[[-1.25e2,-2],[0,0],[125,4]]}]}"
    set rendered to workspace_plot_svg(library and specification)
    if not (archive_list_text(rendered and 0) equals "rendered"):
        display archive_list_text(rendered and 0)
        return 1
    set svg to archive_list_text(rendered and 1)
    if string_contains(svg and "Café &lt;plot&gt; &amp; data") equals 0 or else string_contains(svg and "90,520") equals 0 or else string_contains(svg and "950,80") equals 0:
        return 2
    for each bad in ["{\"title\":\"T\",\"x_label\":\"X\",\"y_label\":\"Y\",\"series\":[]}", "{\"title\":\"T\",\"x_label\":\"X\",\"y_label\":\"Y\",\"series\":[{\"name\":\"A\",\"kind\":\"line\",\"points\":[[1e9999,1]]}]}"]:
        if archive_list_text(workspace_plot_svg(library and bad) and 0) equals "rendered":
            return 3
    set constant to workspace_plot_svg(library and "{\"title\":\"Constant\",\"x_label\":\"X\",\"y_label\":\"Y\",\"series\":[{\"name\":\"A\",\"kind\":\"scatter\",\"points\":[[3,4]]}]}")
    if not (archive_list_text(constant and 0) equals "rendered") or else string_contains(archive_list_text(constant and 1) and "cx=\"520\" cy=\"300\"") equals 0:
        return 11
    if get_argument_count() is not equal to 2:
        return 4
    set configured to set_env("ECHO_WORKSPACE_ROOT" and get_argument(1))
    set database to archive_open(concat(get_argument(1) and "/archive.sqlite"))
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "fixture-secret") is not equal to 0:
        return 5
    set submitted to web_submit_owned(database and "owner" and "plot" and "" and "Plot fixture")
    set session to archive_list_text(submitted and 1)
    set arguments to concat("{\"path\":\"plot.svg\",\"plot\":" and concat(specification and "}"))
    set result to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and arguments and "plot"))
    if not (provider_value(result and provider_member(result and 0 and "status")) equals "created") or else not (provider_value(result and provider_member(result and 0 and "sha256")) equals ep_sha256(svg)):
        return 6
    set again to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and arguments and "plot"))
    if provider_value(again and provider_member(again and 0 and "status")) equals "created":
        return 7
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "outsider" and session and arguments and "plot"))
    if not (provider_value(denied and provider_member(denied and 0 and "status")) equals "workspace-unavailable"):
        return 8
    if web_device_revoke(database and "owner") is not equal to 0:
        return 9
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and arguments and "plot"))
    if not (provider_value(denied and provider_member(denied and 0 and "status")) equals "workspace-unavailable"):
        return 10
    set closed to sql_close(database)
    display "PASS: finite decimal/scientific coordinates scale to plot bounds with escaped labels and embedded source data."
    return ep_dlclose(library)
