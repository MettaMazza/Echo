import "../../app/workspace/plot_numbers"

define main returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set value to plot_number(library and "-1.25e2")
    display plot_number_text(value)
    if value is not equal to -125.0 or else plot_finite(value) is not equal to 1:
        return 1
    if plot_finite(plot_number(library and "1e9999")) is not equal to 0:
        return 2
    set closed to ep_dlclose(library)
    return 0
