import "../../app/tools/workspace_tools"
import "../../app/web/run_store"
import "../../app/archive/file_copy"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    if root < 0:
        return 2
    for each path in ["source.zip", "source.tar", "source.tar.gz"]:
        set result to workspace_list_archive(library and root and path and 0 and 10)
        set tokens to provider_json_tokens(result)
        if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found") or else (string_contains(result and "café.txt") equals 0 and string_contains(result and "café.txt") equals 0) or else string_contains(result and "../outside.txt") equals 0:
            display result
            return 3
        set expected to file_digest(concat(get_argument(1) and concat("/" and path)) and 65536)
        if not (provider_value(tokens and provider_member(tokens and 0 and "source_sha256")) equals archive_list_text(expected and 1)):
            return 7
        set page to workspace_list_archive(library and root and path and 1 and 1)
        if string_contains(page and "\"next_offset\":2") equals 0 or else string_contains(page and "\"index\":1") equals 0:
            display page
            return 4
    if string_contains(workspace_list_archive(library and root and "../source.zip" and 0 and 10) and "open-failed") equals 0:
        return 5
    if string_contains(workspace_list_archive(library and root and "bad.zip" and 0 and 10) and "failed") equals 0:
        return 6
    set db_path to concat(get_argument(1) and "/archive.sqlite")
    if file_exists(db_path):
        return 8
    set database to archive_open(db_path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 9
    set submitted to web_submit_owned(database and "owner" and "archive" and "" and "Inspect archive.")
    set session to archive_list_text(submitted and 1)
    set owned to workspace_session_open(database and library and "owner" and session and get_argument(1))
    if owned < 0:
        return 10
    set directory to history_collect_one(archive_prepare(database and "SELECT directory FROM echo_workspaces LIMIT 1;"))
    set source to concat(get_argument(1) and "/source.zip")
    set digest to file_digest(source and 65536)
    set destination to concat(get_argument(1) and concat("/" and concat(archive_list_text(directory and 1) and "/source.zip")))
    if file_copy_verified(source and destination and archive_list_text(digest and 1) and get_list(digest and 2) and 65536) is not equal to 0:
        return 11
    set args to "{\"path\":\"source.zip\",\"offset\":0,\"entries\":10}"
    set observed to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and args and "archive"))
    if not (provider_value(observed and provider_member(observed and 0 and "status")) equals "found"):
        return 12
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "outsider" and session and args and "archive"))
    if provider_value(denied and provider_member(denied and 0 and "status")) equals "found":
        return 13
    set extract_args to concat("{\"path\":\"source.zip\",\"entry\":1,\"destination\":\"selected.txt\",\"source_sha256\":" and concat(provider_quote(archive_list_text(digest and 1)) and "}"))
    set extracted to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and extract_args and "extract"))
    if not (provider_value(extracted and provider_member(extracted and 0 and "status")) equals "created") or else not (provider_value(extracted and provider_member(extracted and 0 and "extracted_sha256")) equals ep_sha256("inert")):
        return 16
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "outsider" and session and extract_args and "extract"))
    if provider_value(denied and provider_member(denied and 0 and "status")) equals "created":
        return 17
    set pack_args to "{\"path\":\"bundle.zip\",\"sources\":[\"selected.txt\"],\"format\":\"zip\"}"
    set packed to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and pack_args and "pack"))
    if not (provider_value(packed and provider_member(packed and 0 and "status")) equals "created"):
        return 19
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "outsider" and session and pack_args and "pack"))
    if provider_value(denied and provider_member(denied and 0 and "status")) equals "created":
        return 20
    if web_device_revoke(database and "owner") is not equal to 0:
        return 14
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and args and "archive"))
    if provider_value(denied and provider_member(denied and 0 and "status")) equals "found":
        return 15
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and extract_args and "extract"))
    if not (provider_value(denied and provider_member(denied and 0 and "status")) equals "workspace-unavailable"):
        return 18
    set denied to provider_json_tokens(workspace_tool_execute_device(database and "owner" and session and pack_args and "pack"))
    if not (provider_value(denied and provider_member(denied and 0 and "status")) equals "workspace-unavailable"):
        return 21
    set closed to net_close(owned)
    set closed to sql_close(database)
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    display "PASS: ZIP, TAR, gzip TAR metadata, UTF-8 and traversal names remain inert, paging, scoped path rejection and malformed archive rejection."
    return 0
