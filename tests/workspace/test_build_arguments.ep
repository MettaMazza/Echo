import "../../app/providers/archived_stream"
import "os"
import "../../app/workspace/build_arguments"
import "../../app/tools/build_schema"
import "../../app/security/tool_policy"

define main returning Int:
    for each example in [["compile",""],["check","check"],["test-harness","test"]]:
        set input to concat("{\"path\":\"nested/calculate.ep\",\"mode\":" and concat(provider_quote(archive_list_text(example and 0)) and "}"))
        set result to workspace_build_arguments(provider_json_tokens(input))
        if result equals 0 or else not (archive_list_text(result and length_list(result) - 1) equals "nested/calculate.ep"):
            return 1
        if length_list(result) is not equal to 1 and not (archive_list_text(result and 0) equals archive_list_text(example and 1)):
            return 2
    for each input in ["{}", "{\"path\":\"a.ep\",\"mode\":\"shell\"}", "{\"path\":3,\"mode\":\"compile\"}", "{\"path\":\"a.ep\",\"mode\":\"compile\",\"program\":\"/bin/sh\"}"]:
        if workspace_build_arguments(provider_json_tokens(input)) is not equal to 0:
            return 3
    if not (tool_capability("workspace_build") equals tool_capability("workspace_execute")) or else provider_json_tokens(workspace_build_schema()) equals 0:
        return 4
    display "PASS: typed compiler modes map to exact argv; missing, mistyped and injected fields fail; schema and scoped capability are present."
    return 0
