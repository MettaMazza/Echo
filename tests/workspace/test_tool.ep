import "../../app/tools/attachment_tools"
import "../../app/web/run_store"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set database to archive_open(get_argument(1))
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if database equals 0 or else library equals 0 or else web_run_schema(database) is not equal to 0:
        return 1
    if web_pairing_invite(database and "invite-a") is not equal to 0 or else web_device_pair(database and "invite-a" and "a" and "A" and "secret-a") is not equal to 0 or else web_pairing_invite(database and "invite-b") is not equal to 0 or else web_device_pair(database and "invite-b" and "b" and "B" and "secret-b") is not equal to 0:
        return 1
    set a to web_create_session(database and "a" and "a")
    set b to web_create_session(database and "b" and "b")
    set first to workspace_session_open(database and library and "a" and "draft:a" and get_argument(2))
    set second to workspace_session_open(database and library and "b" and "draft:b" and get_argument(2))
    if first is less than 0 or else second is less than 0:
        display "FAIL: workspace creation"
        return 1
    set descriptor to workspace_file_open(library and first and "private.txt" and 1)
    if descriptor is less than 0 or else file_stage_write(library and descriptor and str_to_ptr("Private A") and 9) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    if workspace_file_open(library and second and "private.txt" and 0) >= 0 or else workspace_session_open(database and library and "b" and "draft:a" and get_argument(2)) >= 0 or else workspace_session_open(database and library and "a" and "unknown" and get_argument(2)) >= 0:
        return 1
    set arguments to "{\"path\":\"private.txt\",\"offset\":0,\"characters\":9}"
    set result to session_tool_execute(database and "draft:a" and "workspace_read_text" and arguments)
    set tokens to provider_json_tokens(result)
    if tokens equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "text")) equals "Private A") or else not (provider_value(tokens and provider_member(tokens and 0 and "sha256")) equals ep_sha256("Private A")):
        display concat("FAIL: owned tool read " and result)
        return 1
    set result to session_tool_execute(database and "draft:b" and "workspace_read_text" and arguments)
    if not (result equals "{\"status\":\"open-failed\"}"):
        return 1
    set result to session_tool_execute(database and "unknown" and "workspace_read_text" and arguments)
    if not (result equals "{\"status\":\"not-authorized\"}"):
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_read_text" and "{\"path\":\"private.txt\",\"offset\":0,\"characters\":9,\"session\":\"draft:b\"}")
    if not (result equals "{\"status\":\"invalid-arguments\"}"):
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_read_text" and "{\"path\":\"../private.txt\",\"offset\":0,\"characters\":9}")
    if not (result equals "{\"status\":\"invalid-arguments\"}"):
        return 1
    if provider_json_tokens(session_tool_schemas()) equals 0:
        return 1
    set directory_arguments to "{\"path\":\"project/source\"}"
    set result to session_tool_execute(database and "draft:a" and "workspace_make_directory" and directory_arguments)
    if not (result equals "{\"status\":\"available\",\"path\":\"project/source\"}"):
        display concat("FAIL: directory dispatch " and result)
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_make_directory" and directory_arguments)
    if not (result equals "{\"status\":\"available\",\"path\":\"project/source\"}"):
        return 1
    set directory to workspace_directory_open(library and first and "project/source" and 0)
    if directory is less than 0:
        return 1
    set closed to net_close(directory)
    if workspace_directory_open(library and second and "project/source" and 0) >= 0:
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_make_directory" and "{\"path\":\"project/../escape\"}")
    if not (result equals "{\"status\":\"invalid-arguments\"}"):
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_make_directory" and "{\"path\":\"project/unused\",\"offset\":0}")
    if not (result equals "{\"status\":\"invalid-arguments\"}"):
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_create_text" and "{\"path\":\"project/source/new.ep\",\"text\":\"English source café\"}")
    set tokens to provider_json_tokens(result)
    if tokens equals 0 or else not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "created") or else not (provider_value(tokens and provider_member(tokens and 0 and "sha256")) equals ep_sha256("English source café")):
        display result
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_create_text" and "{\"path\":\"project/source/new.ep\",\"text\":\"Replacement\"}")
    if string_contains(result and "already-exists") equals 0:
        return 1
    set read to workspace_read_text(library and first and "project/source/new.ep" and 1 and 0 and 999)
    if not (ptr_to_str(get_list(read and 1)) equals "English source café") or else workspace_file_open(library and second and "project/source/new.ep" and 0) >= 0:
        return 1
    if web_device_revoke(database and "a") is not equal to 0:
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_read_text" and arguments)
    if not (result equals "{\"status\":\"not-authorized\"}"):
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_make_directory" and "{\"path\":\"revoked\"}")
    if not (result equals "{\"status\":\"not-authorized\"}") or else workspace_directory_open(library and first and "revoked" and 0) >= 0:
        return 1
    set result to session_tool_execute(database and "draft:a" and "workspace_create_text" and "{\"path\":\"revoked.txt\",\"text\":\"No\"}")
    if not (result equals "{\"status\":\"not-authorized\"}") or else workspace_file_open(library and first and "revoked.txt" and 0) >= 0:
        return 1
    if sql_execute(database and "CREATE TABLE echo_attachment_restore_receipt(identity INTEGER PRIMARY KEY,state TEXT); INSERT INTO echo_attachment_restore_receipt VALUES(1,'review-required');") is not equal to 0:
        return 1
    set result to session_tool_execute(database and "draft:b" and "workspace_read_text" and arguments)
    if not (result equals "{\"status\":\"review-required\"}"):
        return 1
    set result to session_tool_execute(database and "draft:b" and "workspace_make_directory" and "{\"path\":\"restored\"}")
    if not (result equals "{\"status\":\"review-required\"}") or else workspace_directory_open(library and second and "restored" and 0) >= 0:
        return 1
    set closed to net_close(first)
    set closed to net_close(second)
    set closed to sql_close(database)
    set closed to ep_dlclose(library)
    display "PASS: owned dispatch, digest, separate sessions, unknown and revoked denial, injected ownership and traversal rejection, exclusive text publication, no overwrite, valid schemas, repeated directory creation, directory session separation, revoked no-write and restored no-write gates."
    return 0
