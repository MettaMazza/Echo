import "../../app/transport/socket_read"

# Qualify the path resolver needed by the unmodified Ernos compiler. Run this
# from the fixture workspace through its exact sandbox profile.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set resolve to ep_dlsym(library and "realpath")
    set release to ep_dlsym(library and "free")
    for each path in [get_argument(1), get_argument(2)]:
        set result to ep_dlcall2(resolve and str_to_ptr(ptr_to_str(path)) and 0)
        if result equals 0:
            display concat("realpath errno: " and int_to_string(socket_errno(library)))
            return 2
        display ptr_to_str(result)
        set freed to ep_dlcall1(release and result)
    set closed to ep_dlclose(library)
    return 0
