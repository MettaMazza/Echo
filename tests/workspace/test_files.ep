import "../../app/workspace/files"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    if root is less than 0:
        display "FAIL: open root"
        return 1
    if workspace_root_open(library and concat(get_argument(1) and "/escape")) >= 0:
        display "FAIL: symlink root accepted"
        return 1
    set descriptor to workspace_file_open(library and root and "inside/new.txt" and 1)
    if descriptor is less than 0:
        display "FAIL: create contained file"
        return 1
    set text to "Owned workspace file."
    if file_stage_write(library and descriptor and str_to_ptr(text) and string_length(text)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    if workspace_file_open(library and root and "inside/new.txt" and 1) >= 0:
        return 1
    set descriptor to workspace_file_open(library and root and "inside/new.txt" and 0)
    if descriptor is less than 0 or else net_close(descriptor) is not equal to 0:
        return 1
    set rejected to create_list()
    set added to append_list(rejected and "../outside.txt")
    set added to append_list(rejected and "/etc/passwd")
    set added to append_list(rejected and "inside/../outside.txt")
    set added to append_list(rejected and "inside//new.txt")
    set added to append_list(rejected and "inside/./new.txt")
    set added to append_list(rejected and "escape/outside.txt")
    set added to append_list(rejected and "file-link")
    set added to append_list(rejected and "hard-link")
    set added to append_list(rejected and "pipe")
    set added to append_list(rejected and "inside")
    set index to 0
    repeat while index is less than length_list(rejected):
        if workspace_file_open(library and root and ptr_to_str(get_list(rejected and index)) and 0) >= 0:
            display concat("FAIL: accepted " and ptr_to_str(get_list(rejected and index)))
            return 1
        set index to index + 1
    if net_close(root) is not equal to 0 or else ep_dlclose(library) is not equal to 0:
        return 1
    display "PASS: contained exclusive creation and reopen; traversal, symlink parents/files, hard links, FIFO and directory rejected."
    return 0
