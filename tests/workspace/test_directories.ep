import "../../app/workspace/directories"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    if root is less than 0:
        return 1
    if workspace_directory_open(library and root and "project/source" and 0) >= 0:
        display "FAIL: absent directory opened"
        return 1
    set directory to workspace_directory_open(library and root and "project/source" and 1)
    if directory is less than 0:
        display "FAIL: nested directory creation"
        return 1
    set file to workspace_file_open(library and directory and "hello.txt" and 1)
    if file is less than 0:
        return 1
    set text to "Session-owned project."
    if file_stage_write(library and file and str_to_ptr(text) and string_length(text)) is not equal to 0 or else file_stage_finish(library and file) is not equal to 0:
        return 1
    set closed to net_close(directory)
    set directory to workspace_directory_open(library and root and "project/source" and 1)
    if directory is less than 0:
        return 1
    set closed to net_close(directory)
    set directory to workspace_directory_open(library and root and "project/source" and 0)
    if directory is less than 0:
        return 1
    set file to workspace_file_open(library and directory and "hello.txt" and 0)
    if file is less than 0:
        return 1
    set closed to net_close(file)
    set closed to net_close(directory)
    set rejected to create_list()
    set added to append_list(rejected and "")
    set added to append_list(rejected and "/tmp")
    set added to append_list(rejected and "../outside")
    set added to append_list(rejected and "project/../outside")
    set added to append_list(rejected and "project//other")
    set added to append_list(rejected and "project/./other")
    set added to append_list(rejected and "escape/forbidden")
    set added to append_list(rejected and "escape")
    set added to append_list(rejected and "project/source/hello.txt/child")
    set added to append_list(rejected and "pipe/child")
    set index to 0
    repeat while index is less than length_list(rejected):
        set path to ptr_to_str(get_list(rejected and index))
        if workspace_directory_open(library and root and path and 1) >= 0 or else workspace_directory_open(library and root and path and 0) >= 0:
            display concat("FAIL: accepted directory path " and path)
            return 1
        set index to index + 1
    set closed to net_close(root)
    display "PASS: nested creation, repeat creation, reopen and file access; traversal, symlinks, files and FIFO rejected."
    return 0
