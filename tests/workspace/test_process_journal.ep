import "../../app/workspace/sandbox_process"
import "../../app/workspace/process_output"
import "../../app/workspace/files"
import "fs"
import "../../app/workspace/capture_process"
import "../../app/workspace/process_journal"

external define peek_byte with pointer and offset returning Int
external define poke_byte with pointer and offset and value returning Int

define capture_cancel_after_eof with path as Str and writer as Int and completed as Int returning Int:
    set database to archive_open(path)
    set status to 1
    set started to ep_time_now_ms()
    if database is not equal to 0:
        repeat while ep_time_now_ms() - started is less than 5000:
            set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='process_output' AND json_extract(payload,'$.eof')=1;"))
            if ptr_to_str(get_list(row and 0)) equals "found" and ptr_to_str(get_list(row and 1)) equals "2":
                set status to 0
                break
            set slept to sleep_ms(10)
        set closed to sql_close(database)
    set closed to net_close(writer)
    send status to completed
    return 0

define main returning Int:
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    if get_argument_count() equals 2:
        if get_argument(1) equals "close-and-wait":
            set closed to net_close(1)
            set closed to net_close(2)
            repeat while 1 equals 1:
                set slept to sleep_ms(100)
        set block to create_list()
        set added to append_list(block and 0)
        set added to append_list(block and 0)
        set index to 0
        repeat while index is less than 16:
            set changed to poke_byte(get_list_data_ptr(block) and index and index)
            set index to index + 1
        set index to 0
        repeat while index is less than 12288:
            if file_stage_write(library and 1 and get_list_data_ptr(block) and 16) is not equal to 0 or else file_stage_write(library and 2 and get_list_data_ptr(block) and 16) is not equal to 0:
                return 1
            set index to index + 1
        return 0
    if get_argument_count() is not equal to 5 or else file_exists(get_argument(3)):
        return 1
    set runtime to get_argument(1)
    set workspace to get_argument(2)
    set mode to get_argument(4)
    set database to archive_open(get_argument(3))
    if database equals 0 or else tool_ledger_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "home" and "request" and "tool_call" and "{\"run_id\":\"run-a\",\"call_id\":\"call-a\"}" and "fixture") is not equal to 0 or else tool_ledger_queue(database and "run-a" and "call-a" and "home" and "request") is not equal to 0 or else tool_ledger_claim(database and "run-a" and "call-a") is not equal to 0:
        return 1
    if mode equals "reject":
        if sql_execute(database and "CREATE TRIGGER reject_capture BEFORE INSERT ON echo_events WHEN NEW.kind='process_output' BEGIN SELECT RAISE(ABORT,'Injected capture persistence failure'); END;") is not equal to 0:
            return 1
    set directory to workspace_root_open(library and workspace)
    set output to socket_cancellation_create(library)
    set errors to socket_cancellation_create(library)
    set cancellation to socket_cancellation_create(library)
    set arguments to create_list()
    if mode equals "after-eof":
        set added to append_list(arguments and "close-and-wait")
    else:
        set added to append_list(arguments and "child")
    set environment to create_list()
    if workspace_process_reserve(database and "run-a" and "call-a" and "{\"program\":\"binary fixture\",\"policy\":\"generated sandbox\"}") is not equal to 0:
        return 1
    if workspace_process_reserve(database and "run-a" and "call-a" and "{}") equals 0:
        return 1
    set handle to workspace_sandbox_start(runtime and workspace and get_argument(0) and arguments and environment and directory and get_list(output and 1) and get_list(errors and 1))
    if handle equals 0:
        return 1
    if workspace_process_receipt(database and "run-a" and "call-a" and handle and "") is not equal to 0:
        set stopped to workspace_process_signal(handle and 9)
        return 1
    if workspace_process_receipt(database and "run-a" and "call-a" and handle and "") equals 0 or else workspace_process_receipt(database and "run-a" and "call-a" and handle and "complete") equals 0:
        set stopped to workspace_process_signal(handle and 9)
        return 1
    set closed to socket_cancel(output)
    set closed to socket_cancel(errors)
    if mode equals "cancel":
        set closed to socket_cancel(cancellation)
    set completed to channel
    if mode equals "after-eof":
        spawn capture_cancel_after_eof(get_argument(3) and get_list(cancellation and 1) and completed)
    set result to workspace_process_capture(database and "run-a" and "call-a" and handle and get_list(output and 0) and get_list(errors and 0) and get_list(cancellation and 0))
    if mode equals "after-eof":
        set checked to receive from completed
        set changed to set_list(cancellation and 1 and -1)
        if checked is not equal to 0:
            display "FAIL: EOF did not precede cancellation"
            return 1
    set status to ptr_to_str(get_list(result and 0))
    if mode equals "complete":
        if not (status equals "complete") or else get_list(result and 1) is not equal to 0 or else get_list(result and 2) is not equal to 196608 or else get_list(result and 3) is not equal to 196608:
            display concat("FAIL: completion " and status)
            return 1
    else:
        set expected to "cancelled"
        if mode equals "reject":
            set expected to "persistence-failed"
        if not (status equals expected) or else get_list(result and 1) modulo 128 is not equal to 9:
            display concat("FAIL: failure status " and status)
            return 1
    if workspace_process_receipt(database and "run-a" and "call-a" and handle and status) is not equal to 0 or else workspace_process_receipt(database and "run-a" and "call-a" and handle and status) equals 0:
        return 1
    if get_list(handle and 2) is not equal to 1 or else workspace_process_close(handle) is not equal to 0:
        return 1
    if mode equals "reject":
        set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_events WHERE kind='process_output';"))
        if not (ptr_to_str(get_list(row and 0)) equals "found") or else not (ptr_to_str(get_list(row and 1)) equals "0"):
            return 1
    set closed to socket_cancellation_close(cancellation)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    if archive_verify(database and "home") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(3))
    if workspace_process_reserve(database and "run-a" and "call-a" and "{}") equals 0:
        return 1
    set row to history_collect_one(archive_prepare(database and "SELECT COUNT(*) FROM echo_process_launches WHERE started IS NOT NULL AND finished IS NOT NULL;"))
    if not (ptr_to_str(get_list(row and 0)) equals "found") or else not (ptr_to_str(get_list(row and 1)) equals "1"):
        return 1
    if archive_verify(database and "home") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display concat("PASS: journaled process " and concat(mode and "; reservation, start, proven exit and replay rejection survive reopen."))
    return 0
