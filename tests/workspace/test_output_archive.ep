import "../../app/workspace/output_archive"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 2 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else tool_ledger_schema(database) is not equal to 0:
        return 1
    if archive_append(database and "home" and "request" and "tool_call" and "{\"run_id\":\"run-a\",\"call_id\":\"call-a\"}" and "fixture") is not equal to 0 or else tool_ledger_queue(database and "run-a" and "call-a" and "home" and "request") is not equal to 0:
        return 1
    set buffer to create_list()
    set index to 0
    repeat while index is less than 32:
        set added to append_list(buffer and 0)
        set index to index + 1
    set index to 0
    repeat while index is less than 256:
        set changed to poke_byte(get_list_data_ptr(buffer) and index and index)
        set index to index + 1
    if workspace_output_record(database and "run-a" and "call-a" and "unclaimed" and "stdout" and get_list_data_ptr(buffer) and 256 and 0) equals 0:
        return 1
    if tool_ledger_claim(database and "run-a" and "call-a") is not equal to 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "one" and "stdout" and get_list_data_ptr(buffer) and 256 and 0) is not equal to 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "one" and "stdout" and get_list_data_ptr(buffer) and 256 and 0) equals 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "err-one" and "stderr" and get_list_data_ptr(buffer) and 1 and 0) is not equal to 0:
        return 1
    if sql_close(database) is not equal to 0:
        return 1
    set database to archive_open(get_argument(1))
    if sql_execute(database and "CREATE TRIGGER reject_output BEFORE INSERT ON echo_events WHEN NEW.event='rejected' BEGIN SELECT RAISE(ABORT,'Injected output persistence failure'); END;") is not equal to 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "rejected" and "stdout" and get_list_data_ptr(buffer) and 256 and 0) equals 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "two" and "stdout" and get_list_data_ptr(buffer) and 256 and 0) is not equal to 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "out-eof" and "stdout" and 0 and 0 and 1) is not equal to 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "after-eof" and "stdout" and get_list_data_ptr(buffer) and 256 and 0) equals 0:
        return 1
    if workspace_output_record(database and "run-a" and "wrong-call" and "wrong" and "stderr" and get_list_data_ptr(buffer) and 256 and 0) equals 0:
        return 1
    if workspace_output_record(database and "run-a" and "call-a" and "err-eof" and "stderr" and 0 and 0 and 1) is not equal to 0:
        return 1
    set original to archive_read_event(database and "two")
    set tokens to provider_json_tokens(ptr_to_str(get_list(original and 3)))
    if not (provider_value(tokens and provider_member(tokens and 0 and "offset")) equals "256"):
        return 1
    set encoded to provider_value(tokens and provider_member(tokens and 0 and "data"))
    if string_length(encoded) is not equal to 512:
        return 1
    set index to 0
    repeat while index is less than 256:
        set high to string_index_of("0123456789abcdef" and substring(encoded and index * 2 and 1))
        set low to string_index_of("0123456789abcdef" and substring(encoded and index * 2 + 1 and 1))
        if high * 16 + low is not equal to index:
            return 1
        set index to index + 1
    set original to archive_read_event(database and "out-eof")
    set tokens to provider_json_tokens(ptr_to_str(get_list(original and 3)))
    if not (provider_value(tokens and provider_member(tokens and 0 and "offset")) equals "512"):
        return 1
    if archive_read_event(database and "rejected") is not equal to 0 or else archive_verify(database and "home") is not equal to 0 or else sql_close(database) is not equal to 0:
        return 1
    display "PASS: binary output archive survives reopen; stream offsets, EOF, claim checks, duplicate rejection and injected write rollback verified."
    return 0
