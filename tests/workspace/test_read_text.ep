import "../../app/workspace/read_text"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    if root is less than 0:
        return 1
    set original to "café ☕\nProject source."
    set descriptor to workspace_file_open(library and root and "source.txt" and 1)
    if descriptor is less than 0 or else file_stage_write(library and descriptor and str_to_ptr(original) and string_length(original)) is not equal to 0 or else file_stage_finish(library and descriptor) is not equal to 0:
        return 1
    set batch to 1
    repeat while batch is less than 9:
        set result to workspace_read_text(library and root and "source.txt" and batch and 3 and 3)
        if not (ptr_to_str(get_list(result and 0)) equals "read") or else not (ptr_to_str(get_list(result and 1)) equals "é ☕") or else get_list(result and 2) is not equal to 3 or else not (ptr_to_str(get_list(result and 3)) equals ep_sha256(original)) or else get_list(result and 4) is not equal to string_length(original):
            display "FAIL: observed text and source digest"
            return 1
        set batch to batch + 1
    # Replace the path after validation. The existing descriptor must still
    # read the original inode and never follow the replacement symlink.
    set descriptor to workspace_file_open(library and root and "source.txt" and 0)
    set rename_at to ep_dlsym(library and "renameat")
    set link_at to ep_dlsym(library and "symlinkat")
    if descriptor is less than 0 or else rename_at equals 0 or else link_at equals 0:
        return 1
    if ep_dlcall4(rename_at and root and str_to_ptr("source.txt") and root and str_to_ptr("saved.txt")) is not equal to 0 or else ep_dlcall3(link_at and str_to_ptr("/etc/passwd") and root and str_to_ptr("source.txt")) is not equal to 0:
        return 1
    set result to file_text_descriptor_window(library and descriptor and ep_sha256(original) and string_length(original) and 1 and 0 and 999)
    if not (ptr_to_str(get_list(result and 0)) equals "verified") or else not (ptr_to_str(get_list(result and 1)) equals original):
        display "FAIL: descriptor continuity"
        return 1
    set closed to net_close(descriptor)
    set result to workspace_read_text(library and root and "source.txt" and 8 and 0 and 99)
    if not (ptr_to_str(get_list(result and 0)) equals "open-failed"):
        return 1
    set result to workspace_read_text(library and root and "../outside.txt" and 8 and 0 and 99)
    if not (ptr_to_str(get_list(result and 0)) equals "open-failed"):
        return 1
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    display "PASS: Unicode ranges across batches, observed full-file digest and bytes, descriptor continuity after path replacement, symlink and traversal rejection."
    return 0
