import "../../app/workspace/native_process"
import "../../app/workspace/files"
import "fs"
import "string"

define main returning Int:
    if get_argument_count() is not equal to 6:
        return 1
    set runtime to get_argument(1)
    set workspace to get_argument(2)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and workspace)
    set output to workspace_file_open(library and directory and "sandbox-stdout.txt" and 1)
    set errors to workspace_file_open(library and directory and "sandbox-stderr.txt" and 1)
    if directory is less than 3 or else output is less than 3 or else errors is less than 3:
        return 1
    set arguments to create_list()
    set added to append_list(arguments and "-D")
    set added to append_list(arguments and concat("ECHO_RUNTIME=" and runtime))
    set added to append_list(arguments and "-D")
    set added to append_list(arguments and concat("ECHO_WORKSPACE=" and workspace))
    set added to append_list(arguments and "-D")
    set added to append_list(arguments and concat("ECHO_ERNOS_RUNTIME=" and runtime))
    set added to append_list(arguments and "-f")
    set added to append_list(arguments and get_argument(5))
    set added to append_list(arguments and concat(workspace and "/test_sandbox"))
    set added to append_list(arguments and workspace)
    set added to append_list(arguments and get_argument(3))
    set added to append_list(arguments and get_argument(4))
    set added to append_list(arguments and runtime)
    set environment to create_list()
    # A missing executable must fail before returning a live process handle.
    if workspace_process_start("/echo-nonexistent-executable" and arguments and environment and directory and output and errors) is not equal to 0:
        return 1
    set handle to workspace_process_start("/usr/bin/sandbox-exec" and arguments and environment and directory and output and errors)
    if handle equals 0:
        display "FAIL: sandbox start"
        return 1
    set state to 0
    repeat while state equals 0:
        set state to workspace_process_poll(handle)
        set slept to sleep_ms(10)
    if state is not equal to 1 or else get_list(handle and 3) is not equal to 0:
        display concat("FAIL: sandbox status " and int_to_string(get_list(handle and 3)))
        return 1
    set closed to workspace_process_close(handle)
    set closed to net_close(output)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    set observed to ptr_to_str(read_file(concat(workspace and "/sandbox-stdout.txt")))
    if not (string_contains(observed and "PASS: child process inherited the sandbox restrictions.")):
        return 1
    if string_length(ptr_to_str(read_file(concat(workspace and "/sandbox-stderr.txt")))) is not equal to 0:
        return 1
    display "PASS: native adapter launched sandbox; descendant isolation passed; missing executable failed."
    return 0
