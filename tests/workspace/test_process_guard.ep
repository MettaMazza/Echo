import "../../app/workspace/process_guard"
import "../../app/workspace/files"
import "fs"

# The owner deliberately SIGKILLs itself only after the guardian's real child
# is running. An external test driver checks the guardian's waitpid receipt.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set root to get_argument(2)
    if string_contains(root and "guardian-fixture") equals 0:
        return 2
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and root)
    set output to workspace_file_open(library and directory and concat(get_argument(1) and "-stdout.txt") and 1)
    set errors to workspace_file_open(library and directory and concat(get_argument(1) and "-stderr.txt") and 1)
    if directory < 0 or else output < 0 or else errors < 0:
        return 3
    set environment to create_list()
    if get_argument(1) equals "guardian":
        set arguments to ["60"]
        set child to workspace_process_start("/bin/sleep" and arguments and environment and directory and output and errors)
        if child equals 0:
            return 4
        if write_file(concat(root and "/child-pid.txt") and int_to_string(get_list(child and 1))) is not equal to 1:
            set stopped to workspace_process_abort(child)
            return 5
        set result to workspace_guard_owned(child and 3)
        set receipt to concat(archive_list_text(result and 0) and concat(":" and int_to_string(get_list(result and 2))))
        if write_file(concat(root and "/exit-receipt.txt") and receipt) is not equal to 1 or else workspace_process_close(child) is not equal to 0:
            return 6
        return 0
    if not (get_argument(1) equals "owner"):
        return 7
    set pipe to socket_cancellation_create(library)
    set arguments to ["guardian", root]
    set guardian to workspace_process_start_owned(get_argument(0) and arguments and environment and directory and output and errors and get_list(pipe and 0))
    if guardian equals 0:
        return 8
    set closed to net_close(get_list(pipe and 0))
    if write_file(concat(root and "/guardian-pid.txt") and int_to_string(get_list(guardian and 1))) is not equal to 1:
        return 9
    set started to ep_time_now_ms()
    repeat while not file_exists(concat(root and "/child-pid.txt")):
        if ep_time_now_ms() - started > 5000:
            set closed to net_close(get_list(pipe and 1))
            return 10
        set slept to sleep_ms(10)
    set killed to ep_dlcall2(ep_dlsym(library and "kill") and ep_dlcall0(ep_dlsym(library and "getpid")) and 9)
    return 11
