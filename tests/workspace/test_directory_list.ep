import "../../app/tools/workspace_tools"
import "../../app/web/run_store"
import "fs"

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 2
    if web_pairing_invite(database and "owner") is not equal to 0 or else web_device_pair(database and "owner" and "owner" and "Owner" and "secret") is not equal to 0:
        return 3
    if web_pairing_invite(database and "foreign") is not equal to 0 or else web_device_pair(database and "foreign" and "foreign" and "Foreign" and "foreign-secret") is not equal to 0:
        return 4
    set submitted to web_submit_owned(database and "owner" and "listing" and "" and "List my workspace.")
    set session to archive_list_text(submitted and 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "owner" and session and get_argument(2))
    if root < 0 or else not (workspace_create_text(library and root and "café.txt" and "first") equals "created") or else not (workspace_create_text(library and root and "second.txt" and "second") equals "created"):
        return 5
    set directory to workspace_directory_open(library and root and "nested" and 1)
    if directory < 0:
        return 6
    set closed to net_close(directory)
    set link to ep_dlsym(library and "symlinkat")
    if ep_dlcall3(link and str_to_ptr("/private/tmp") and root and str_to_ptr("outside")) is not equal to 0:
        return 7
    set offset to 0
    set combined to ""
    repeat while offset < 4:
        set args to concat("{\"path\":\".\",\"entries\":1,\"offset\":" and concat(int_to_string(offset) and "}"))
        set result to workspace_tool_execute_device(database and "owner" and session and args and "list")
        set tokens to provider_json_tokens(result)
        if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "found") or else history_tool_integer(tokens and "next_offset") is not equal to offset + 1:
            display result
            return 8
        set combined to concat(combined and result)
        set offset to offset + 1
    if string_contains(combined and "café.txt") equals 0 or else string_contains(combined and "second.txt") equals 0 or else string_contains(combined and "nested") equals 0 or else string_contains(combined and "symlink") equals 0:
        return 9
    set ended to workspace_tool_execute_device(database and "owner" and session and "{\"path\":\".\",\"offset\":4,\"entries\":1}" and "list")
    if string_contains(ended and "\"end\":true") equals 0:
        return 10
    set foreign to workspace_tool_execute_device(database and "foreign" and session and "{\"path\":\".\",\"offset\":0,\"entries\":10}" and "list")
    set escaped to workspace_tool_execute_device(database and "owner" and session and "{\"path\":\"../\",\"offset\":0,\"entries\":10}" and "list")
    set linked to workspace_tool_execute_device(database and "owner" and session and "{\"path\":\"outside\",\"offset\":0,\"entries\":10}" and "list")
    if string_contains(foreign and "café") > 0 or else string_contains(foreign and "\"status\":\"found\"") > 0 or else string_contains(escaped and "invalid-arguments") equals 0 or else string_contains(linked and "directory-unavailable") equals 0:
        return 11
    set whole to workspace_list_directory(library and root and "." and 0 and 10)
    set again to workspace_list_directory(library and root and "." and 0 and 10)
    if not (whole equals again):
        return 12
    if web_device_revoke(database and "owner") is not equal to 0:
        return 13
    set revoked to workspace_tool_execute_device(database and "owner" and session and "{\"path\":\".\",\"offset\":0,\"entries\":10}" and "list")
    if string_contains(revoked and "café") > 0 or else string_contains(revoked and "\"status\":\"found\"") > 0:
        return 14
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    if sql_close(database) is not equal to 0:
        return 12
    display "PASS: paged scoped directory listing, Unicode filenames, end marker, cross-user isolation, traversal rejection and no symlink following."
    return 0
