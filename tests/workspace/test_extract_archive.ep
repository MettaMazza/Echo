import "../../app/workspace/list_archive"
import "../../app/workspace/read_text"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(system and get_argument(1))
    if root < 0:
        return 2
    set source to file_digest(concat(get_argument(1) and "/source.zip") and 65536)
    set digest to archive_list_text(source and 1)
    set result to workspace_archive_operation(system and root and "source.zip" and 1 and 1 and "chosen.txt" and digest)
    set tokens to provider_json_tokens(result)
    if not (provider_value(tokens and provider_member(tokens and 0 and "status")) equals "created") or else not (provider_value(tokens and provider_member(tokens and 0 and "extracted_sha256")) equals ep_sha256("inert")):
        display result
        return 3
    set text to workspace_read_text(system and root and "chosen.txt" and 65536 and 0 and -1)
    if not (archive_list_text(text and 1) equals "inert"):
        return 4
    if string_contains(workspace_archive_operation(system and root and "source.zip" and 0 and 1 and "chosen.txt" and digest) and "already-exists") equals 0:
        return 5
    set text to workspace_read_text(system and root and "chosen.txt" and 65536 and 0 and -1)
    if not (archive_list_text(text and 1) equals "inert"):
        return 6
    if string_contains(workspace_archive_operation(system and root and "source.zip" and 0 and 1 and "stale.txt" and "wrong") and "source-changed") equals 0:
        return 7
    if string_contains(workspace_archive_operation(system and root and "source.zip" and 0 and 1 and "../escape.txt" and digest) and "invalid-destination") equals 0:
        return 8
    set links to file_digest(concat(get_argument(1) and "/links.tar") and 65536)
    if string_contains(workspace_archive_operation(system and root and "links.tar" and 0 and 1 and "link.txt" and archive_list_text(links and 1)) and "not-regular-entry") equals 0:
        return 9
    set closed to net_close(root)
    set closed to ep_dlclose(system)
    display "PASS: selected inert traversal-named entry publishes to explicit destination, full digest, exact bytes, exclusive no-overwrite, changed source, destination traversal and symlink denial."
    return 0
