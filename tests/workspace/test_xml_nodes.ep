import "../../app/workspace/xml_nodes"

define main returning Int:
    set nodes to workbook_xml_nodes("<root xmlns='urn:test'><t label='A &amp; B'>café <b>世界</b> tail</t><empty/></root>")
    if nodes equals 0 or else not (archive_list_text(get_list(nodes and 0) and 3) equals "urn:test"):
        return 1
    if not (workbook_xml_attribute(get_list(nodes and 1) and "label") equals "A & B") or else not (workbook_xml_text(nodes and 1) equals "café 世界 tail"):
        return 2
    if workbook_xml_nodes("<root><a></root>") is not equal to 0 or else workbook_xml_nodes("<!DOCTYPE root [<!ENTITY leak SYSTEM 'file:///etc/passwd'>]><root>&leak;</root>") is not equal to 0:
        return 3
    set nodes to workbook_xml_nodes("<root><t>one</t><t>two</t></root>")
    if nodes equals 0 or else not (workbook_xml_text(nodes and 1) equals "one") or else not (workbook_xml_text(nodes and 4) equals "two"):
        return 4
    display "PASS: native workbook XML namespace, copied strings, attributes, rich text, malformed XML and DTD rejection."
    return 0
