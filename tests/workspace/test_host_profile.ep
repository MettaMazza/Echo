import "../../app/workspace/sandbox_process"
import "../../app/workspace/files"
import "fs"

# The child is real native Ernos running inside the generated admin profile.
define main returning Int:
    if get_argument_count() is not equal to 5:
        return 1
    set directory_path to get_argument(2)
    set protected_path to concat(get_argument(3) and "/accepted.txt")
    set secret_path to concat(get_argument(4) and "/secret.txt")
    if get_argument(1) equals "child":
        set written to write_file(concat(directory_path and "/allowed.txt") and "host-worker-ok")
        set denied to write_file(protected_path and "must-not-replace")
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set link_function to ep_dlsym(library and "link")
        set alias to concat(directory_path and "/protected-alias.txt")
        set linked to ep_dlcall2(link_function and str_to_ptr(protected_path) and str_to_ptr(alias))
        if linked equals 0:
            set bypass to write_file(alias and "must-not-replace")
        set closed to ep_dlclose(library)
        if not (ptr_to_str(read_file(protected_path)) equals "accepted"):
            return 2
        if file_exists(secret_path):
            return 3
        if not (ptr_to_str(read_file(concat(directory_path and "/allowed.txt"))) equals "host-worker-ok"):
            return 4
        return 0
    set profile to host_execution_profile()
    if string_length(profile) equals 0:
        return 5
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set directory to workspace_root_open(library and directory_path)
    set output to workspace_file_open(library and directory and "output.txt" and 1)
    set errors to workspace_file_open(library and directory and "errors.txt" and 1)
    set arguments to ["child",directory_path,get_argument(3),get_argument(4)]
    set handle to workspace_sandbox_start_profile(directory_path and directory_path and get_argument(1) and arguments and ["PATH=/usr/bin:/bin"] and directory and output and errors and profile)
    if handle equals 0:
        return 6
    set state to workspace_process_poll(handle)
    repeat while state equals 0:
        set waited to sleep_ms(10)
        set state to workspace_process_poll(handle)
    if state is not equal to 1 or else get_list(handle and 3) is not equal to 0:
        display concat("FAIL child wait status " and int_to_string(get_list(handle and 3)))
        return 7
    set closed to workspace_process_close(handle)
    set closed to net_close(output)
    set closed to net_close(errors)
    set closed to net_close(directory)
    set closed to ep_dlclose(library)
    display "PASS: admin child writes ordinary host files, cannot alter protected installation, and cannot inspect connector secrets."
    return 0
