import "../../app/workspace/archive_patch"

define main returning Int:
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(system and get_argument(1))
    set library to ep_dlopen("/usr/lib/libarchive.2.dylib")
    set expected to ["[Content_Types].xml", "_rels/.rels", "xl/workbook.xml", "xl/_rels/workbook.xml.rels", "xl/worksheets/sheet1.xml", "xl/styles.xml", "xl/media/café.bin"]
    for each path in ["source.xlsx", "edited.xlsx"]:
        set input to workspace_file_open(system and root and ptr_to_str(path) and 0)
        set reader to ep_dlcall0(ep_dlsym(library and "archive_read_new"))
        set code to ep_dlcall1(ep_dlsym(library and "archive_read_support_format_zip") and reader)
        set code to ep_dlcall3(ep_dlsym(library and "archive_read_open_fd") and reader and input and 65536)
        set pointer to [0]
        set index to 0
        repeat while ep_dlcall2(ep_dlsym(library and "archive_read_next_header") and reader and get_list_data_ptr(pointer)) equals 0:
            if index >= length_list(expected) or else not (workspace_zip_original_name(system and library and reader and input) equals archive_list_text(expected and index)):
                return 1
            set skipped to ep_dlcall1(ep_dlsym(library and "archive_read_data_skip") and reader)
            set index to index + 1
        if index is not equal to length_list(expected):
            return 2
        set freed to ep_dlcall1(ep_dlsym(library and "archive_read_free") and reader)
        set closed to net_close(input)
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    set closed to ep_dlclose(system)
    display "PASS: exact original ZIP entry names, including NFC Unicode, preserved in edited output."
    return 0
