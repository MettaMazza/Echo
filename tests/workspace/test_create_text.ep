import "../../app/workspace/create_text"
import "../../app/workspace/read_text"

define main returning Int:
    if get_argument_count() is not equal to 2:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    if root is less than 0:
        return 1
    set directory to workspace_directory_open(library and root and "project/source" and 1)
    if directory is less than 0:
        return 1
    set closed to net_close(directory)
    set original to "Plain English source: café."
    if not (workspace_create_text(library and root and "project/source/main.ep" and original) equals "created"):
        display "FAIL: publication"
        return 1
    if not (workspace_create_text(library and root and "project/source/main.ep" and "Replacement") equals "already-exists"):
        return 1
    set read to workspace_read_text(library and root and "project/source/main.ep" and 1 and 0 and 999)
    if not (ptr_to_str(get_list(read and 0)) equals "read") or else not (ptr_to_str(get_list(read and 1)) equals original) or else not (ptr_to_str(get_list(read and 3)) equals ep_sha256(original)):
        return 1
    if not (workspace_create_text(library and root and "empty.txt" and "") equals "created"):
        return 1
    if not (workspace_create_text(library and root and "../outside.txt" and original) equals "invalid-arguments") or else not (workspace_create_text(library and root and "missing/file.txt" and original) equals "parent-unavailable"):
        return 1
    set link_at to ep_dlsym(library and "symlinkat")
    if link_at equals 0 or else ep_dlcall3(link_at and str_to_ptr("project/source/main.ep") and root and str_to_ptr("link")) is not equal to 0:
        return 1
    if not (workspace_create_text(library and root and "link" and "Replacement") equals "already-exists"):
        return 1
    if ep_dlcall3(link_at and str_to_ptr("project/source") and root and str_to_ptr("parent-link")) is not equal to 0 or else not (workspace_create_text(library and root and "parent-link/escape.txt" and original) equals "parent-unavailable"):
        return 1
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    display "PASS: flushed exclusive publication, exact Unicode digest, no overwrite, empty file, traversal/missing parent/symlink rejection."
    return 0
