import "../../app/workspace/sandbox_profile"
import "../../app/transport/local_socket"
import "../../app/transport/http_stream"
import "fs"

define main returning Int:
    if get_argument_count() equals 2:
        if get_argument(1) equals "profile":
            display workspace_sandbox_profile()
            return 0
        return 1
    if get_argument_count() is not equal to 4 and get_argument_count() is not equal to 5:
        return 1
    set allowed to concat(get_argument(1) and "/inside.txt")
    set forbidden to concat(get_argument(2) and "/forbidden.txt")
    if write_file(allowed and "Sandbox-owned output") is not equal to 1:
        display "FAIL: allowed write"
        return 1
    if not (ptr_to_str(read_file(allowed)) equals "Sandbox-owned output"):
        return 1
    if file_exists(concat(get_argument(2) and "/private.txt")):
        display "FAIL: outside metadata visible"
        return 1
    if ptr_to_str(read_file(concat(get_argument(2) and "/private.txt"))) equals "Private outside fixture":
        display "FAIL: outside contents readable"
        return 1
    if write_file(forbidden and "Unexpected outside write") equals 1:
        display "FAIL: outside write allowed"
        return 1
    if ptr_to_str(read_file(concat(get_argument(1) and "/escape/private.txt"))) equals "Private outside fixture":
        display "FAIL: symlink escaped for reading"
        return 1
    if write_file(concat(get_argument(1) and "/escape/forbidden.txt") and "Unexpected link write") equals 1:
        display "FAIL: symlink escaped for writing"
        return 1
    set compiler_root to ptr_to_str(get_env("ECHO_ERNOS_RUNTIME"))
    if string_length(compiler_root) > 0:
        if write_file(concat(compiler_root and "/forbidden-write-fixture") and "Unexpected compiler-runtime write") equals 1:
            display "FAIL: compiler runtime is writable"
            return 1
    set socket to net_connect("127.0.0.1" and http_decimal(get_argument(3)))
    if socket >= 0:
        set closed to net_close(socket)
        display "FAIL: loopback network allowed"
        return 1
    if get_argument_count() equals 4:
        set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
        set start_child to ep_dlsym(library and "posix_spawn")
        set wait_child to ep_dlsym(library and "waitpid")
        if library equals 0 or else start_child equals 0 or else wait_child equals 0:
            return 1
        set arguments to create_list()
        set added to append_list(arguments and str_to_ptr(get_argument(0)))
        set added to append_list(arguments and str_to_ptr(get_argument(1)))
        set added to append_list(arguments and str_to_ptr(get_argument(2)))
        set added to append_list(arguments and str_to_ptr(get_argument(3)))
        set added to append_list(arguments and str_to_ptr("child"))
        set added to append_list(arguments and 0)
        set environment to create_list()
        set added to append_list(environment and 0)
        set process to create_list()
        set added to append_list(process and 0)
        if ep_dlcall6(start_child and get_list_data_ptr(process) and str_to_ptr(get_argument(0)) and 0 and 0 and get_list_data_ptr(arguments) and get_list_data_ptr(environment)) is not equal to 0:
            display "FAIL: sandboxed child start"
            return 1
        set status to create_list()
        set added to append_list(status and 0)
        set waited to -1
        repeat while waited is less than 0:
            set waited to socket_signed_result(ep_dlcall3(wait_child and get_list(process and 0) and get_list_data_ptr(status) and 0))
            if waited is less than 0 and socket_errno(library) is not equal to 4:
                return 1
        if waited is not equal to get_list(process and 0) or else get_list(status and 0) is not equal to 0:
            display "FAIL: child restrictions"
            return 1
        set closed to ep_dlclose(library)
        display "PASS: child process inherited the sandbox restrictions."
    display "PASS: workspace read/write allowed; outside contents/metadata/write, symlink escape and loopback connection denied."
    return 0
