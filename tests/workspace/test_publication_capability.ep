import "../../app/workspace/create_text"
import "../../app/workspace/read_text"

define publication_contender with library as Int and root as Int and content as Str and completed as Int returning Int:
    set status to workspace_create_text(library and root and "race.txt" and content)
    send status to completed
    return 0

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_root_open(library and get_argument(1))
    if root is less than 0:
        return 1
    set completed to channel
    spawn publication_contender(library and root and "first complete writer" and completed)
    spawn publication_contender(library and root and "second complete writer" and completed)
    set first to ptr_to_str(receive from completed)
    set second to ptr_to_str(receive from completed)
    if get_argument(2) equals "supported":
        if not ((first equals "created" and second equals "already-exists") or else (second equals "created" and first equals "already-exists")):
            display concat("FAIL: " and concat(first and concat(" / " and second)))
            return 1
        set content to workspace_read_text(library and root and "race.txt" and 1 and 0 and 999)
        set text to ptr_to_str(get_list(content and 1))
        if not (ptr_to_str(get_list(content and 0)) equals "read") or else not (text equals "first complete writer" or else text equals "second complete writer"):
            return 1
        display "PASS: two concurrent writers, exactly one exclusive publication, complete winning bytes."
    else:
        if not (get_argument(2) equals "unsupported") or else not (first equals "publication-unsupported-filesystem") or else not (second equals "publication-unsupported-filesystem"):
            display concat("FAIL: " and concat(first and concat(" / " and second)))
            return 1
        if workspace_file_open(library and root and "race.txt" and 0) >= 0:
            display "FAIL: unsupported publication exposed a destination"
            return 1
        display "PASS: unsupported exclusive publication reported explicitly by both concurrent writers; no destination exposed."
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    return 0
