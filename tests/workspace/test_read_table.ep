import "../../app/tools/workspace_tools"
import "../../app/web/run_store"
import "fs"

define table_status with result as Str returning Str:
    set tokens to provider_json_tokens(result)
    return provider_value(tokens and provider_member(tokens and 0 and "status"))

define main returning Int:
    if get_argument_count() is not equal to 3 or else file_exists(get_argument(1)):
        return 1
    set text to "name,note,value\r\nMaria,\"café, first\nsecond \"\"quoted\"\"\",001\r\nEcho,,=SUM(A1:A2)\r\n"
    set first to workspace_table_parse(text and "," and 1 and 1)
    set tokens to provider_json_tokens(first)
    set rows to provider_items(tokens and provider_member(tokens and 0 and "rows"))
    if not (table_status(first) equals "found") or else length_list(rows) is not equal to 1 or else history_tool_integer(tokens and "total_rows") is not equal to 3 or else history_tool_integer(tokens and "next_offset") is not equal to 2:
        display first
        return 2
    if not (provider_value(tokens and provider_member(tokens and 0 and "sha256")) equals ep_sha256(text)):
        return 14
    set cells to provider_items(tokens and get_list(rows and 0))
    if length_list(cells) is not equal to 3 or else not (provider_value(tokens and get_list(cells and 1)) equals "café, first\nsecond \"quoted\"") or else not (provider_value(tokens and get_list(cells and 2)) equals "001"):
        display first
        return 3
    set last to workspace_table_parse(text and "," and 2 and 10)
    if string_contains(last and "=SUM(A1:A2)") equals 0 or else string_contains(last and "\"end\":true") equals 0:
        return 4
    for each malformed in ["a,\"unfinished", "a,\"closed\"oops", "ab\"cd,x"]:
        if not (table_status(workspace_table_parse(malformed and "," and 0 and 1)) equals "malformed-table"):
            return 5
    if not (table_status(workspace_table_parse("valid\n\"bad" and "," and 0 and 1)) equals "malformed-table"):
        return 6
    set tabular to workspace_table_parse("a\tb\n1\t\n" and "\t" and 0 and 10)
    if string_contains(tabular and "[\"1\",\"\"]") equals 0 or else string_contains(workspace_table_parse("" and "," and 0 and 1) and "\"total_rows\":0") equals 0:
        return 7
    set database to archive_open(get_argument(1))
    if database equals 0 or else web_run_schema(database) is not equal to 0:
        return 8
    if web_pairing_invite(database and "invite") is not equal to 0 or else web_device_pair(database and "invite" and "owner" and "Owner" and "secret") is not equal to 0:
        return 9
    set submitted to web_submit_owned(database and "owner" and "table" and "" and "Read my table.")
    set session to archive_list_text(submitted and 1)
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set root to workspace_session_open(database and library and "owner" and session and get_argument(2))
    if root < 0 or else not (workspace_create_text(library and root and "source.csv" and text) equals "created"):
        return 10
    set args to "{\"path\":\"source.csv\",\"delimiter\":\",\",\"offset\":1,\"rows\":1}"
    set observed to workspace_tool_execute_device(database and "owner" and session and args and "table")
    if not (observed equals first):
        display observed
        return 11
    if table_status(workspace_tool_execute_device(database and "outsider" and session and args and "table")) equals "found":
        return 12
    if web_device_revoke(database and "owner") is not equal to 0 or else table_status(workspace_tool_execute_device(database and "owner" and session and args and "table")) equals "found":
        return 13
    set closed to net_close(root)
    set closed to ep_dlclose(library)
    display "PASS: multiline/escaped/Unicode cells, paging, exact values, malformed-tail detection, TSV, source digest and scoped/revoked access."
    return sql_close(database)
