import "os"
import "../../app/providers/external_transport"

# Native replacement for curl in protocol tests. It never contacts a network.
define main returning Int:
    set endpoint to ""
    set method to ""
    set index to 1
    repeat while index < get_argument_count():
        set argument to get_argument(index)
        if string_contains(argument and "fixture-secret") > 0 or else argument equals "--data-binary":
            return 20
        if argument equals "--url":
            set endpoint to get_argument(index + 1)
        if argument equals "--request":
            set method to get_argument(index + 1)
        set index to index + 1
    if not (method equals "GET") or else not (get_argument(1) equals "--disable"):
        return 21
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set received to 0
    repeat while 1 equals 1:
        set piece to socket_read_chunk(system and 0 and -1)
        set status to archive_list_text(piece and 0)
        if status equals "eof":
            break
        if not (status equals "data"):
            return 22
        set received to received + get_list(piece and 2)
        set released to socket_release_buffer(system and get_list(piece and 1))
    if received equals 0:
        return 23
    set item to "{\"id\":\"fixture-native\",\"object\":\"model\",\"type\":\"model\",\"max_input_tokens\":123456,\"max_tokens\":7890,\"capabilities\":{\"image_input\":{\"supported\":true},\"thinking\":{\"supported\":true,\"types\":{\"adaptive\":{\"supported\":true},\"enabled\":{\"supported\":true}}},\"effort\":{\"supported\":true,\"max\":{\"supported\":true},\"high\":{\"supported\":true}}}}"
    set body to item
    if endpoint equals "https://api.openai.com/v1/models/gpt-5.4-2026-03-05":
        set body to "{\"id\":\"gpt-5.4-2026-03-05\",\"object\":\"model\",\"created\":1772668800,\"owned_by\":\"openai\"}"
    set code to "200 OK"
    if endpoint equals "https://api.openai.com/v1/models":
        set body to concat("{\"object\":\"list\",\"data\":[" and concat(item and "]}"))
    if endpoint equals "https://api.anthropic.com/v1/models":
        set body to concat("{\"has_more\":true,\"last_id\":\"cursor&next\",\"data\":[" and concat(item and "]}"))
    if string_contains(endpoint and "?after_id=") > 0:
        set body to "{\"has_more\":false,\"last_id\":null,\"data\":[]}"
    if string_contains(endpoint and "/rate-limited") > 0:
        set code to "429 Too Many Requests"
        set body to "{\"error\":{\"type\":\"rate_limit_error\"}}"
    set size to string_length(body)
    if string_contains(endpoint and "/truncated") > 0:
        set size to size + 10
    set wire to concat("HTTP/1.1 " and concat(code and "\r\nContent-Type: application/json\r\nContent-Length: "))
    set wire to concat(wire and concat(int_to_string(size) and concat("\r\n\r\n" and body)))
    set sent to socket_write_all(system and 1 and -1 and str_to_ptr(wire) and string_length(wire))
    if not (archive_list_text(sent and 0) equals "sent"):
        return 24
    if string_contains(endpoint and "/failed-child") > 0:
        return 7
    return 0
