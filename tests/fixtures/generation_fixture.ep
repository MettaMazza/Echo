import "../../app/agent/generation"

define generation_fixture with listener as List and data as Str and completed as Int returning Int:
    set descriptor to local_socket_accept(listener)
    if descriptor is less than 0:
        send 1 to completed
        return 1
    set reader to http_stream_create(get_list(listener and 0) and descriptor and -1)
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready"):
        send 1 to completed
        return 1
    set body to http_body_create(ptr_to_str(get_list(head and 3)) and get_list(head and 4))
    repeat while 1 equals 1:
        set piece to http_body_next(reader and body and 65536)
        set status to ptr_to_str(get_list(piece and 0))
        if status equals "done":
            break
        if not (status equals "data"):
            send 1 to completed
            return 1
    set reply to concat("data: " and concat(data and "\n\ndata: [DONE]\n\n"))
    set wire to concat("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: " and int_to_string(string_length(reply)))
    set wire to concat(wire and concat("\r\n\r\n" and reply))
    set written to socket_write_all(get_list(listener and 0) and descriptor and -1 and str_to_ptr(wire) and string_length(wire))
    set failed to 0
    if not (ptr_to_str(get_list(written and 0)) equals "sent"):
        set failed to 1
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    send failed + released + closed to completed
    return 0

