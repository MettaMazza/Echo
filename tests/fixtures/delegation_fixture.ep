import "../../app/jobs/delegation_run"

# Requests are archived exactly as the provider dispatcher would archive them.
define delegation_fixture_call with database as Int and run as Str and session as Str and call_id as Str and name as Str and arguments as Str returning Int:
    set event to concat(run and concat(":call:" and call_id))
    set payload to concat("{\"run_id\":" and provider_quote(run))
    set payload to concat(payload and concat(",\"call_id\":" and provider_quote(call_id)))
    set payload to concat(payload and concat(",\"name\":" and provider_quote(name)))
    set payload to concat(payload and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}")))
    if archive_append(database and session and event and "tool_call" and payload and "fixture") is not equal to 0:
        return 1
    return tool_ledger_queue(database and run and call_id and session and event)


define delegation_fixture_request with database as Int and run as Str and session as Str and call_id as Str and arguments as Str returning Int:
    return delegation_fixture_call(database and run and session and call_id and "delegate_task" and arguments)
