import "os"
import "fs"
import "../../app/providers/anthropic_count"
import "../../app/providers/external_transport"

define main returning Int:
    set endpoint to ""
    set method to ""
    set path to ""
    set index to 1
    repeat while index < get_argument_count():
        set argument to get_argument(index)
        if string_contains(argument and "fixture-secret") > 0:
            return 20
        if argument equals "--url":
            set endpoint to get_argument(index + 1)
        if argument equals "--request":
            set method to get_argument(index + 1)
        if argument equals "--data-binary":
            set path to get_argument(index + 1)
        set index to index + 1
    if not (method equals "POST") or else not (endpoint equals "https://api.anthropic.com/v1/messages/count_tokens" or else endpoint equals "https://api.openai.com/v1/responses/input_tokens") or else string_length(path) < 2 or else not (get_character(path and 0) equals 64):
        return 21
    set system to ep_dlopen("/usr/lib/libSystem.B.dylib")
    repeat while 1 equals 1:
        set piece to socket_read_chunk(system and 0 and -1)
        if archive_list_text(piece and 0) equals "eof":
            break
        if not (archive_list_text(piece and 0) equals "data"):
            return 22
        set released to socket_release_buffer(system and get_list(piece and 1))
    set body to ptr_to_str(read_file(substring(path and 1 and string_length(path) - 1)))
    set tokens to provider_json_tokens(body)
    if tokens equals 0 or else provider_member(tokens and 0 and "max_tokens") >= 0 or else provider_member(tokens and 0 and "stream") >= 0:
        return 23
    set response to "{\"input_tokens\":101}"
    if string_contains(body and "large") > 0:
        set response to "{\"input_tokens\":123000}"
    if string_contains(body and "malformed") > 0:
        set response to "{\"input_tokens\":1.5}"
    if endpoint equals "https://api.openai.com/v1/responses/input_tokens":
        if provider_member(tokens and 0 and "input") < 0 or else provider_member(tokens and 0 and "max_output_tokens") >= 0:
            return 25
        set response to "{\"object\":\"response.input_tokens\",\"input_tokens\":101}"
        if string_contains(body and "large") > 0:
            set response to "{\"object\":\"response.input_tokens\",\"input_tokens\":1049544}"
        if string_contains(body and "malformed") > 0:
            set response to "{\"object\":\"response.input_tokens\",\"input_tokens\":1.5}"
    set wire to concat("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: " and concat(int_to_string(string_length(response)) and concat("\r\n\r\n" and response)))
    set sent to socket_write_all(system and 1 and -1 and str_to_ptr(wire) and string_length(wire))
    if not (archive_list_text(sent and 0) equals "sent"):
        return 24
    if string_contains(body and "failed-child") > 0:
        return 7
    return 0
