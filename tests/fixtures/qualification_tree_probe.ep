import "fs"
import "string"

# Only the installed evaluator plan grants this tree. Successful reading must
# not imply write access, including when the tree lies under another allow rule.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    if not (file_read(path) equals "immutable qualification input"):
        return 2
    set attempted to file_write(path and "changed")
    if not (file_read(path) equals "immutable qualification input"):
        return 3
    display "PASS: pinned evaluator can read its explicit tree but cannot modify it."
    return 0
