import "../../app/lifecycle/protected_path"

define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set library to ep_dlopen("/usr/lib/libSystem.B.dylib")
    set descriptor to protected_path_open(library and get_argument(1) and 0)
    if descriptor < 0:
        set released to ep_dlclose(library)
        return 2
    set closed to net_close(descriptor)
    set released to ep_dlclose(library)
    display "PASS: installed evaluator can inspect the protected file and every ancestor."
    return closed + released
