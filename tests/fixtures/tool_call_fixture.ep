import "../../app/agent/tool_dispatch"
import "generation_fixture"

define tool_fixture_call with database as Int and device as Str and run as Str and name as Str and arguments as Str returning Str:
    if agent_run_read(database and run) equals 0:
        set submitted to web_submit_owned(database and device and run and "" and "Inspect or stop my job.")
        if not (archive_list_text(submitted and 0) equals "accepted"):
            return "submit-failed"
    set listener to local_socket_listen(0)
    set delta to concat("{\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"jobs\",\"function\":{\"name\":\"__FIXTURE_TOOL__\",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}"))
    set delta to ptr_to_str(string_replace(delta and "__FIXTURE_TOOL__" and name))
    set completed to channel
    spawn generation_fixture(listener and delta and completed)
    set generated to agent_generate_local(database and run and concat(run and ":request") and "{\"model\":\"fixture\",\"stream\":true,\"messages\":[]}" and get_list(listener and 2) and "/v1/chat/completions" and -1 and 65536 and "0")
    set served to receive from completed
    set closed to local_socket_close(listener)
    if generated is not equal to 0 or else served is not equal to 0 or else agent_tool_step(database and run) is not equal to 0:
        return "dispatch-failed"
    set values to [run]
    set row to history_collect_one(checkpoint_prepare(database and "SELECT json_extract(e.payload,'$.result') FROM echo_tool_calls t JOIN echo_events e ON e.event=t.result_event WHERE t.run=?1 AND t.call_id='jobs';" and values))
    return archive_list_text(row and 1)
