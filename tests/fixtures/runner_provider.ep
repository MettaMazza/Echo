import "../../app/security/groups"
import "../../app/agent/runner"
import "os"

# Three scripted generations: recap, independent review, resumed final answer.
# Only this fixture's first token count reports full capacity.
define compaction_fixture_content with state as List and tokens as List and messages as List returning Str:
    set generation to get_list(state and 0)
    set filtered to create_list()
    for each message in messages:
        set content to provider_value(tokens and provider_member(tokens and message and "content"))
        if string_index_of(content and "Echo runtime routing:") is not equal to 0 and string_index_of(content and "Current-turn routing record,") is not equal to 0:
            set added to append_list(filtered and message)
    set messages to filtered
    # Normalize the cache-stable three-message recap transport for the scripted
    # provider. The source evidence remains a separate production message.
    if length_list(messages) equals 3:
        set operation to provider_value(tokens and provider_member(tokens and get_list(messages and 2) and "content"))
        set original to provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content"))
        set package_start to string_index_of(operation and "\n{")
        set package to original
        if package_start >= 0:
            set package to substring(operation and package_start + 1 and string_length(operation) - package_start - 1)
            set package to ptr_to_str(string_replace(package and "\"original_sources\":null" and concat("\"original_sources\":" and original)))
            set package_tokens to provider_json_tokens(package)
            if provider_member(package_tokens and 0 and "original_sources") < 0:
                set package to concat(substring(package and 0 and string_length(package) - 1) and concat(",\"original_sources\":" and concat(original and "}")))
        set normalized to concat("{\"messages\":[{\"role\":\"system\",\"content\":\"fixture\"},{\"role\":\"user\",\"content\":" and concat(provider_quote(package) and "}]}") )
        if string_index_of(operation and "Original source count:") equals 0:
            set tokens to provider_json_tokens(normalized)
            set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
    if get_list(state and 4) equals -10:
        set package to provider_json_tokens(provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content")))
        if package equals 0 or else not (provider_value(package and provider_member(package and 0 and "previous_candidate")) equals ptr_to_str(get_list(state and 5))):
            return ""
        set pieces to ["Aé", "🌍B", "XYZ"]
        if generation >= length_list(pieces) or else not (provider_value(package and provider_member(package and 0 and "next_fragment")) equals ptr_to_str(get_list(pieces and generation))):
            return ""
        set candidate to concat("{\"source_end\":\"objective\",\"summary\":" and provider_quote(concat("Cumulative fixture stage " and int_to_string(generation + 1))))
        set candidate to concat(candidate and ",\"summary_sources\":[\"objective\"],\"state\":{\"objectives\":[],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}")
        set candidate to ptr_to_str(string_replace(candidate and "\"objective\"" and provider_quote(ptr_to_str(get_list(state and 3)))))
        set changed to set_list(state and 5 and candidate)
        return candidate
    if generation equals 0:
        if length_list(messages) is not equal to 2:
            return ""
        set sources to provider_json_tokens(provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content")))
        if sources equals 0:
            return ""
        set endpoint to provider_value(sources and provider_member(sources and 0 and "source_end"))
        set candidate to concat("{\"source_end\":" and provider_quote(endpoint))
        set candidate to concat(candidate and ",\"summary\":\"The user asked to remember café.\",\"summary_sources\":[\"objective\"],\"state\":{\"objectives\":[{\"text\":\"Remember café.\",\"sources\":[\"objective\"]}],\"constraints\":[],\"facts\":[],\"relationships\":[],\"decisions\":[],\"corrections\":[],\"pending_work\":[],\"tool_state\":[],\"artifacts\":[],\"uncertainties\":[]}}")
        set candidate to ptr_to_str(string_replace(candidate and "\"objective\"" and provider_quote(ptr_to_str(get_list(state and 3)))))
        set changed to set_list(state and 5 and candidate)
        set changed to set_list(state and 6 and endpoint)
        return candidate
    if generation equals 2 and (get_list(state and 4) equals -2 or else get_list(state and 4) equals -3):
        if length_list(messages) is not equal to 2:
            return ""
        set repair to provider_json_tokens(provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content")))
        if repair equals 0 or else not (provider_value(repair and provider_member(repair and 0 and "previous_candidate")) equals ptr_to_str(get_list(state and 5))):
            return ""
        set feedback to provider_json_tokens(provider_value(repair and provider_member(repair and 0 and "feedback")))
        set originals to provider_member(repair and 0 and "original_sources")
        if feedback equals 0 or else originals is less than 0 or else not (provider_value(repair and provider_member(repair and originals and "source_end")) equals ptr_to_str(get_list(state and 6))):
            return ""
        set candidate to ptr_to_str(get_list(state and 5))
        if get_list(state and 4) equals -3:
            set candidate to ptr_to_str(string_replace(candidate and "The user asked to remember café." and "The active user request is to remember café."))
        set candidate to ptr_to_str(string_replace(candidate and "\"objective\"" and provider_quote(ptr_to_str(get_list(state and 3)))))
        set changed to set_list(state and 5 and candidate)
        return candidate
    if generation equals 1 and (get_list(state and 4) equals -8 or else get_list(state and 4) equals -9):
        set evidence to provider_json_tokens(provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content")))
        set original to provider_member(evidence and 0 and "original_fragment")
        if original is less than 0:
            return ""
        set report to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(ptr_to_str(get_list(state and 5)))))
        set report to concat(report and concat(",\"source_end\":" and provider_quote(ptr_to_str(get_list(state and 6)))))
        set report to concat(report and concat(",\"event\":" and provider_quote(provider_value(evidence and provider_member(evidence and original and "event")))))
        set report to concat(report and concat(",\"source_digest\":" and provider_quote(provider_value(evidence and provider_member(evidence and original and "digest")))))
        set report to concat(report and concat(",\"offset\":" and provider_index(evidence and provider_member(evidence and original and "offset"))))
        set report to concat(report and concat(",\"next_offset\":" and provider_index(evidence and provider_member(evidence and original and "next_offset"))))
        return concat(report and ",\"verdict\":\"covered\",\"explanation\":\"Original fragment preserves the request.\",\"findings\":[]}")
    if generation equals 1 or else (generation equals 3 and get_list(state and 4) equals -3) or else (generation equals 2 and (get_list(state and 4) equals -8 or else get_list(state and 4) equals -9)):
        if get_list(state and 4) equals -4:
            return "{}"
        if length_list(messages) is not equal to 2:
            return ""
        set evidence to provider_json_tokens(provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content")))
        if evidence equals 0 or else not (provider_value(evidence and provider_member(evidence and 0 and "candidate")) equals ptr_to_str(get_list(state and 5))):
            return ""
        set review to concat("{\"candidate_digest\":" and provider_quote(ep_sha256(ptr_to_str(get_list(state and 5)))))
        set review to concat(review and concat(",\"source_end\":" and provider_quote(ptr_to_str(get_list(state and 6)))))
        if get_list(state and 4) equals -12:
            set originals to provider_member(evidence and 0 and "original_sources")
            set records to provider_items(evidence and provider_member(evidence and originals and "records"))
            if records equals 0:
                return ""
            set review to concat(review and ",\"records\":[")
            set index to 0
            repeat while index is less than length_list(records):
                if index is greater than 0:
                    set review to concat(review and ",")
                set identity to provider_value(evidence and provider_member(evidence and get_list(records and index) and "event"))
                set review to concat(review and concat("{\"event\":" and provider_quote(identity)))
                set review to concat(review and ",\"verdict\":\"covered\",\"explanation\":\"Synthetic rebuild fixture review of original event.\"}")
                set index to index + 1
            return concat(review and "],\"findings\":[]}")
        if (get_list(state and 4) equals -2 or else get_list(state and 4) equals -3) and generation equals 1:
            return concat(review and ",\"records\":[{\"event\":\"objective\",\"verdict\":\"uncertain\",\"explanation\":\"Fixture requests a second review.\"}],\"findings\":[]}")
        return concat(review and ",\"records\":[{\"event\":\"objective\",\"verdict\":\"covered\",\"explanation\":\"The request is preserved.\"}],\"findings\":[]}")
    if get_list(state and 4) equals -12 and generation equals 2:
        if length_list(messages) is not equal to 3:
            return ""
        set completion to provider_value(tokens and provider_member(tokens and get_list(messages and 2) and "content"))
        if string_index_of(completion and "Recap rebuild completed and the reviewed checkpoint is active.") is less than 0:
            return ""
        return "Rebuilt and resumed: café."
    if length_list(messages) is not equal to 2:
        return ""
    set recap to provider_value(tokens and provider_member(tokens and get_list(messages and 0) and "content"))
    set objective to provider_value(tokens and provider_member(tokens and get_list(messages and 1) and "content"))
    if string_index_of(recap and "Archived context recap.") is not equal to 0 or else not (objective equals "Remember café."):
        return ""
    return "Resumed after compaction: café."

define runner_fixture_call with name as Str and identity as Str and arguments as Str returning Str:
    set response to concat("data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":" and provider_quote(identity))
    set response to concat(response and concat(",\"function\":{\"name\":" and provider_quote(name)))
    return concat(response and concat(",\"arguments\":" and concat(provider_quote(arguments) and "}}]},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n")))

define runner_fixture_exchange with listener as List and state as List returning Int:
    set descriptor to local_socket_accept(listener)
    if descriptor is less than 0:
        return 1
    set reader to http_stream_create(get_list(listener and 0) and descriptor and -1)
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready"):
        set closed to net_close(descriptor)
        return 1
    set framed to http_body_create(ptr_to_str(get_list(head and 3)) and get_list(head and 4))
    set builder to create_builder()
    set byte to create_list()
    set added to append_list(byte and 0)
    set copy to ep_dlsym(get_list(listener and 0) and "memcpy")
    repeat while 1 equals 1:
        set piece to http_body_next(reader and framed and 1)
        if ptr_to_str(get_list(piece and 0)) equals "done":
            break
        if not (ptr_to_str(get_list(piece and 0)) equals "data"):
            set closed to net_close(descriptor)
            return 1
        set cleared to set_list(byte and 0 and 0)
        set copied to ep_dlcall3(copy and get_list_data_ptr(byte) and get_list(piece and 1) and 1)
        set added to builder_append(builder and ptr_to_str(get_list_data_ptr(byte)))
    set body to ptr_to_str(builder_to_string(builder))
    set path to ptr_to_str(get_list(head and 2))
    set response to ""
    set content_type to "application/json"
    set failed to 0
    if path equals "/v1/models":
        if (get_list(state and 4) equals -6 and get_list(state and 0) equals 2) or else (get_list(state and 4) equals -9 and get_list(state and 0) equals 3):
            # Kill while activation is asking for metadata, after candidate and
            # passing review have committed and while compaction owns its lock.
            set killed to run_command(concat("kill -KILL " and int_to_string(get_pid())))
            return 1
        set response to "{\"data\":[{\"id\":\"fixture\",\"meta\":{\"n_ctx\":262144,\"n_ctx_train\":262144}}]}"
    else if path equals "/props":
        set response to "{\"default_generation_settings\":{\"n_ctx\":262144,\"params\":{\"n_predict\":-1}}}"
    else if path equals "/v1/chat/completions/input_tokens":
        # Optional shared recap race fixture: change membership after the
        # activation request was assembled, before its preflight returns.
        if length_list(state) > 7 and get_list(state and 0) equals 2:
            set changed_database to archive_open(archive_list_text(state and 7))
            if changed_database equals 0:
                set failed to 1
            else:
                if not (group_change(changed_database and "owner" and "remove-during-activation" and "g" and "device:other" and "removed" and 3) equals "recorded"):
                    set failed to 1
                if sql_close(changed_database) is not equal to 0:
                    set failed to 1
        set changed to set_list(state and 1 and body)
        set changed to set_list(state and 2 and get_list(state and 2) + 1)
        set response to "{\"input_tokens\":500}"
        if get_list(state and 4) is less than 0 and get_list(state and 2) equals 1:
            set response to "{\"input_tokens\":262144}"
        if (get_list(state and 4) equals -8 or else get_list(state and 4) equals -9) and get_list(state and 2) equals 3:
            set response to "{\"input_tokens\":262144}"
        if get_list(state and 4) equals -10 and get_list(state and 2) equals 2:
            set response to "{\"input_tokens\":262144}"
    else if path equals "/v1/chat/completions":
        if not (ptr_to_str(get_list(state and 1)) equals body):
            set failed to 1
        set tokens to provider_json_tokens(body)
        if tokens equals 0:
            set closed to net_close(descriptor)
            return 1
        set messages to provider_items(tokens and provider_member(tokens and 0 and "messages"))
        if messages equals 0:
            set closed to net_close(descriptor)
            return 1
        if get_list(state and 4) is less than 0:
            set content to compaction_fixture_content(state and tokens and messages)
            if string_length(content) equals 0:
                set failed to 1
            set response to concat("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":" and provider_quote(content))
            set response to concat(response and "},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
        else if get_list(state and 0) equals 0:
            if length_list(messages) is not equal to 1:
                set failed to 1
            set response to "data: {\"choices\":[{\"index\":0,\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"read-source\",\"function\":{\"name\":\"history_read\",\"arguments\":\"{\\\"event\\\":\\\"objective\\\",\\\"offset\\\":0,\\\"characters\\\":100}\"}}]},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n"
            if get_list(state and 4) equals 3:
                set response to runner_fixture_call("history_search" and "search-source" and "{\"query\":\"café\",\"after\":0}")
        else if get_list(state and 4) equals 3 and get_list(state and 0) equals 1:
            if length_list(messages) is not equal to 3:
                set failed to 1
            else:
                set last to get_list(messages and 2)
                if not (provider_value(tokens and provider_member(tokens and last and "tool_call_id")) equals "search-source"):
                    set failed to 1
                set observation to provider_json_tokens(provider_value(tokens and provider_member(tokens and last and "content")))
                if observation equals 0:
                    set failed to 1
                else:
                    if not (provider_value(observation and provider_member(observation and 0 and "status")) equals "found") or else not (provider_value(observation and provider_member(observation and 0 and "kind")) equals "user"):
                        set failed to 1
                    set source to provider_value(observation and provider_member(observation and 0 and "event"))
                    set arguments to concat("{\"event\":" and concat(provider_quote(source) and ",\"offset\":0,\"characters\":100}"))
                    set response to runner_fixture_call("history_read" and "read-source" and arguments)
        else:
            set expected_messages to 3
            if get_list(state and 4) equals 3:
                set expected_messages to 5
            if length_list(messages) is not equal to expected_messages:
                set failed to 1
            else:
                set last to get_list(messages and expected_messages - 1)
                if not (provider_value(tokens and provider_member(tokens and last and "tool_call_id")) equals "read-source"):
                    set failed to 1
                set observation to provider_json_tokens(provider_value(tokens and provider_member(tokens and last and "content")))
                if observation equals 0:
                    set failed to 1
                else if not (provider_value(observation and provider_member(observation and 0 and "text")) equals "Remember café."):
                    set failed to 1
            set response to "data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":\"I reread café.\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
        set changed to set_list(state and 0 and get_list(state and 0) + 1)
        set content_type to "text/event-stream"
    else:
        set failed to 1
    if get_list(state and 4) >= 0:
        set response to ptr_to_str(string_replace(response and "objective" and ptr_to_str(get_list(state and 3))))
    set wire to concat("HTTP/1.1 200 OK\r\nContent-Type: " and content_type)
    set wire to concat(wire and concat("\r\nContent-Length: " and int_to_string(string_length(response))))
    set wire to concat(wire and concat("\r\n\r\n" and response))
    set written to socket_write_all(get_list(listener and 0) and descriptor and -1 and str_to_ptr(wire) and string_length(wire))
    if not (ptr_to_str(get_list(written and 0)) equals "sent"):
        set failed to 1
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    return failed + released + closed

define runner_fixture with listener as List and objective as Str and completed as Int returning Int:
    set state to create_list()
    set added to append_list(state and 0)
    set added to append_list(state and "")
    set added to append_list(state and 0)
    set added to append_list(state and objective)
    set generations to 2
    if string_length(objective) equals 0:
        set generations to 3
    set added to append_list(state and generations)
    set failures to 0
    # This fixture ends after its scripted final answer; the application runner
    # itself decides when to make requests and contains no turn-count limit.
    repeat while get_list(state and 0) is less than generations:
        set failures to failures + runner_fixture_exchange(listener and state)
    if get_list(state and 2) is not equal to generations:
        set failures to failures + 1
    send failures to completed
    return 0

define compaction_fixture with listener as List and mode as Int and completed as Int returning Int:
    set state to create_list()
    set added to append_list(state and 0)
    set added to append_list(state and "")
    set added to append_list(state and 0)
    set added to append_list(state and "objective")
    set added to append_list(state and mode)
    set added to append_list(state and "")
    set added to append_list(state and "")
    set failures to 0
    set generations to 3
    set counts to 5
    if mode equals -8 or else mode equals -9:
        set generations to 4
        set counts to 7
    if mode equals -2:
        set generations to 3
        set counts to 4
    if mode equals -3:
        set generations to 5
        set counts to 7
    if mode equals -4:
        set generations to 2
        set counts to 3
    repeat while get_list(state and 0) is less than generations:
        set failures to failures + runner_fixture_exchange(listener and state)
    if get_list(state and 2) is not equal to counts:
        set failures to failures + 1
    send failures to completed
    return 0

define compaction_recovery_fixture with listener as List and candidate as Str and endpoint as Str and review_saved as Int and completed as Int returning Int:
    set state to create_list()
    # Start at review: the candidate must come from the durable archive.
    set added to append_list(state and 1)
    set added to append_list(state and "")
    set added to append_list(state and 0)
    set added to append_list(state and "objective")
    set added to append_list(state and -5)
    set added to append_list(state and candidate)
    set added to append_list(state and endpoint)
    set counts to 4
    if review_saved equals 1:
        set changed to set_list(state and 0 and 2)
        set changed to set_list(state and 4 and -7)
        set counts to 3
    set failures to 0
    repeat while get_list(state and 0) is less than 3:
        set failures to failures + runner_fixture_exchange(listener and state)
    if get_list(state and 2) is not equal to counts:
        set failures to failures + 1
    send failures to completed
    return 0

