import "../../app/jobs/schedule_store"

# Native storage acceptance; no provider or production scheduler is started.
define schedule_fixture_origin with database as Int and device as Str and run as Str returning Int:
    set submitted to web_submit_owned(database and device and run and "" and "Schedule fixture")
    if not (archive_list_text(submitted and 0) equals "accepted"):
        return 1
    set session to archive_list_text(submitted and 1)
    set event to concat(run and ":call")
    set payload to concat("{\"run_id\":" and concat(provider_quote(run) and ",\"call_id\":\"schedule\",\"name\":\"schedule_fixture\",\"arguments\":\"{}\"}"))
    if archive_append(database and session and event and "tool_call" and payload and "fixture") is not equal to 0:
        return 1
    return tool_ledger_queue(database and run and "schedule" and session and event)
