import "../../app/jobs/delegation_schema"
import "../../app/security/group_route"
import "../../app/web/worker"
import "../../app/archive/snapshot"

# Disposable fixture for the actual host migration executable. No live data.
define main returning Int:
    if get_argument_count() is not equal to 3:
        return 1
    set path to get_argument(1)
    set mode to get_argument(2)
    if mode equals "verify":
        if not file_exists(path):
            return 2
        set database to sql_open(path)
        if database equals 0 or else archive_verify_all(database) is not equal to 0:
            return 3
        set row to archive_read_event(database and "migration-canary")
        if row equals 0 or else not (ptr_to_str(get_list(row and 3)) equals "Original migration fixture history."):
            return 4
        return sql_close(database)
    if file_exists(path) or else not (mode equals "idle" or else mode equals "active"):
        return 5
    set database to archive_open(path)
    if database equals 0 or else web_run_schema(database) is not equal to 0 or else web_worker_schema(database) is not equal to 0 or else not (delegation_schema(database) equals "applied"):
        return 6
    if archive_append(database and "fixture" and "migration-canary" and "user" and "Original migration fixture history." and "fixture") is not equal to 0:
        return 7
    if mode equals "active":
        if web_pairing_invite(database and "fixture-device") is not equal to 0 or else web_device_pair(database and "fixture-device" and "fixture-device" and "fixture" and "fixture-secret") is not equal to 0:
            return 8
        if not (group_create(database and "fixture-device" and "fixture-group" and "discord" and "fixture-server" and "fixture-room" and "fixture-origin") equals "created"):
            return 9
        set run to group_route_submit(database and "fixture-device" and "fixture-group" and "discord" and "fixture-server" and "fixture-room" and "fixture-active-run" and "Unfinished fixture work.")
        if not (archive_list_text(run and 0) equals "accepted"):
            return 10
    display concat("PASS: schema-26 migration fixture " and mode)
    return sql_close(database)
