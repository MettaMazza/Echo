import "generation_fixture"

# Scripted local provider for transport/visibility tests, not model acceptance.
# Metadata and count requests are answered before one exact candidate response.
define recap_candidate_fixture with listener as List and candidate as Str and forbidden as Str and completed as Int returning Int:
    set counted to ""
    repeat while 1 equals 1:
        set descriptor to local_socket_accept(listener)
        if descriptor < 0:
            send 1 to completed
            return 1
        set reader to http_stream_create(get_list(listener and 0) and descriptor and -1)
        set head to http_stream_head(reader)
        if not (archive_list_text(head and 0) equals "ready"):
            send 2 to completed
            return 2
        set framed to http_body_create(archive_list_text(head and 3) and get_list(head and 4))
        set builder to create_builder()
        set byte to [0]
        repeat while 1 equals 1:
            set piece to http_body_next(reader and framed and 1)
            if archive_list_text(piece and 0) equals "done":
                break
            if not (archive_list_text(piece and 0) equals "data"):
                send 3 to completed
                return 3
            set cleared to set_list(byte and 0 and 0)
            set copied to ep_dlcall3(ep_dlsym(get_list(listener and 0) and "memcpy") and get_list_data_ptr(byte) and get_list(piece and 1) and 1)
            set added to builder_append(builder and ptr_to_str(get_list_data_ptr(byte)))
        set body to ptr_to_str(builder_to_string(builder))
        set path to archive_list_text(head and 2)
        set response to ""
        set media to "application/json"
        set finished to 0
        set failed to 0
        if path equals "/props":
            set response to "{\"default_generation_settings\":{\"n_ctx\":65536,\"params\":{\"n_predict\":-1}}}"
        else if path equals "/v1/models":
            set response to "{\"data\":[{\"id\":\"fixture\",\"meta\":{\"n_ctx\":65536,\"n_ctx_train\":65536}}]}"
        else if path equals "/v1/chat/completions/input_tokens":
            set counted to body
            set response to "{\"input_tokens\":500}"
        else if path equals "/v1/chat/completions":
            set finished to 1
            if string_length(counted) equals 0 or else not (counted equals body) or else (string_length(forbidden) > 0 and also string_contains(body and forbidden)):
                set failed to 4
            set media to "text/event-stream"
            set response to concat("data: {\"choices\":[{\"index\":0,\"delta\":{\"content\":" and concat(provider_quote(candidate) and "},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"))
        else:
            set failed to 5
            set finished to 1
            set response to "{}"
        set wire to concat("HTTP/1.1 200 OK\r\nContent-Type: " and concat(media and concat("\r\nContent-Length: " and int_to_string(string_length(response)))))
        set wire to concat(wire and concat("\r\n\r\n" and response))
        set sent to socket_write_all(get_list(listener and 0) and descriptor and -1 and str_to_ptr(wire) and string_length(wire))
        if not (archive_list_text(sent and 0) equals "sent"):
            set failed to 6
            set finished to 1
        set released to http_stream_release(reader)
        set closed to net_close(descriptor)
        if finished equals 1:
            send failed to completed
            return failed
    return 1
