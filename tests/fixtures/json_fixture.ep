import "../../app/providers/local_json"

define json_fixture with listener as List and expected_method as Str and expected_path as Str and expected_body as Str and response as Str and completed as Int returning Int:
    set descriptor to local_socket_accept(listener)
    if descriptor is less than 0:
        send 1 to completed
        return 1
    set reader to http_stream_create(get_list(listener and 0) and descriptor and -1)
    set head to http_stream_head(reader)
    if not (ptr_to_str(get_list(head and 0)) equals "ready"):
        set released to http_stream_release(reader)
        set closed to net_close(descriptor)
        send 1 to completed
        return 1
    set failed to 0
    if not (ptr_to_str(get_list(head and 1)) equals expected_method) or else not (ptr_to_str(get_list(head and 2)) equals expected_path):
        set failed to 1
    set body to http_body_create(ptr_to_str(get_list(head and 3)) and get_list(head and 4))
    set position to 0
    set compare to ep_dlsym(get_list(listener and 0) and "memcmp")
    repeat while 1 equals 1:
        set piece to http_body_next(reader and body and string_length(expected_body) + 1)
        if ptr_to_str(get_list(piece and 0)) equals "done":
            break
        if not (ptr_to_str(get_list(piece and 0)) equals "data") or else get_list(piece and 2) is greater than string_length(expected_body) - position:
            display "Fixture request body differs from expected size or could not be read."
            set released to http_stream_release(reader)
            set closed to net_close(descriptor)
            send 1 to completed
            return 1
        if ep_dlcall3(compare and get_list(piece and 1) and str_to_ptr(expected_body) + position and get_list(piece and 2)) is not equal to 0:
            set failed to 1
        set position to position + get_list(piece and 2)
    if position is not equal to string_length(expected_body):
        set failed to 1
    set sent to socket_write_all(get_list(listener and 0) and descriptor and -1 and str_to_ptr(response) and string_length(response))
    if not (ptr_to_str(get_list(sent and 0)) equals "sent"):
        set failed to 1
    set released to http_stream_release(reader)
    set closed to net_close(descriptor)
    send failed + released + closed to completed
    return 0

