{
  "executable": "/PATH/TO/echo-runtime/compiler/server",
  "directory": "/PATH/TO/echo-runtime/compiler",
  "arguments": [
    "49675",
    "../ui/modern.js",
    "../data/mlx-browser.port",
    "../data/mlx-browser-001.sqlite",
    "/PATH/TO/Echo/models/Qwen3.5-35B-A3B-MLX-4bit",
    "8081",
    "2048",
    "65536",
    "https://MAC_LAN_ADDRESS:8443"
  ],
  "environment": [
    "PATH=/usr/bin:/bin",
    "LC_ALL=C",
    "ECHO_UI_ASSETS=/PATH/TO/Echo/environments/ui-assets",
    "ECHO_PROVIDER_PROFILE=/PATH/TO/echo-runtime/data/mlx-provider-profile.json",
    "ECHO_ATTACHMENT_ROOT=/PATH/TO/Echo/attachments/browser",
    "ECHO_WORKSPACE_ROOT=/PATH/TO/echo-runtime/data/browser-workspaces",
    "ECHO_EXECUTION_RUNTIME=/PATH/TO/echo-runtime/compiler",
    "ECHO_IMAGE_PROFILE=/PATH/TO/Echo/environments/image-runtime/profile.json",
    "ECHO_IMAGE_ROOT=/PATH/TO/Echo/artifacts/image-jobs",
    "ECHO_SPEECH_PROFILE=/PATH/TO/Echo/environments/speech-runtime/profile.json",
    "ECHO_SPEECH_ROOT=/PATH/TO/Echo/artifacts/speech-jobs",
    "ECHO_VOICE_PROFILE=/PATH/TO/Echo/environments/speech-runtime/voice-profile.json",
    "ECHO_SYSTEM_PROFILE=/PATH/TO/Echo/identity/current-architecture.txt"
  ]
}
